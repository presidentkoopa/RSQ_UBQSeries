// RSQ Score's tab in the series' How To Play (howto.zs, design/HOWTOPLAY_BUILD.md).
// RSQ Score's tab IS its Glossary: its families are the tab's sections and its entries the rows, read at run
// time from glossary_data.zs (RSQSC_GlossaryMenu.Build, Score/tools/gen_glossary.py), so nothing is copied.
// A row: section|colour|label|value|places|demo|paragraph|label~text~label~text...

class RSQSC_HowToData ui
{
	const NAME = "RSQ SCORE";
	const TAB = "SCORE";
	const COLOUR = "RSScore_Gold";
	const RANK = 12;

	static void Rows(out Array<String> r)
	{
		let g = new("RSQSC_GlossaryMenu");
		g.Build();
		for (int i = 0; i < g.eFam.Size(); i++)
		{
			int f = clamp(g.eFam[i], 0, RSQSC_GlossaryMenu.NTABS - 1);
			String pairs = "BONUS:~" .. Bare(g.eBonus[i]) .. "~NEEDS:~" .. Bare(g.eNeeds[i]);
			r.Push(Bare(RSQSC_GlossaryMenu.FAMNAME[f]) .. "|" .. RSQSC_GlossaryMenu.FAMCOLOR[f] .. "|" .. Bare(g.eName[i]) .. "|" .. Bare(g.eShort[i]) .. "|||" .. Bare(g.eText[i]) .. "|" .. pairs);
		}
	}

	// the Glossary's own words, in the page's letters: no field separators, upper case
	static String Bare(String s)
	{
		s.Replace("|", "/");
		s.Replace("~", "-");
		return s.MakeUpper();
	}
}
