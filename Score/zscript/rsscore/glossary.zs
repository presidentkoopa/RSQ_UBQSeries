// RSQ SCORE GLOSSARY (owner's mockup 2026-11-24; "go on the rest of it" 2026-11-24). What each bonus is, in plain words.
//
// Opened from RSQ Score's own options page ("Glossary") and, through MENUDEF, as the help screen (F1 / Read This!):
// a ListMenu descriptor named "ReadThisMenu" wins over the engine's ReadThisMenu class, because the engine looks a
// menu name up as a descriptor before it looks for a class of that name. No engine change.
//
// Layout: title; a row of tabs, one per family and one for the combos, each in its family's colour; the list on the
// left (name in its family colour, value in white); the detail on the right (name, what earns it, Bonus, Needs).
// Up/Down: the list (held, it repeats; Page Up/Down jump a page). Left/Right: the tab. Back: close. A click (mouse,
// or a pointer that sends mouse events) picks a tab or a row.
//
// THE ENTRIES are in glossary_data.zs, GENERATED by Score/tools/gen_glossary.py from README.md and the combo tables
// (combo.zs, combos.zs): every bonus row and every named combo, with its value worked out from its multiplier on a
// familiar monster. Re-run the script after a bonus changes; do not edit the data file by hand.
//
// WORDING (owner): no casino words; "Bonus", "Needs". No counting of how often a bonus was done (owner 2026-11-24:
// "score doesn't need to keep track of how many times").

class RSQSC_GlossaryMenu : ListMenu
{
	const VW = 640;
	const VH = 400;
	const TS = 1.6;          // text scale for VR: Score Small at 1.6 of the 640x400 page (the HUD's own size read small)
	const LS = 1.35;         // the list's text scale (names up to 21 letters beside their value)
	const ROWH = 30;         // list row height (virtual)
	const LISTY = 100;       // list top
	const LISTROWS = 9;      // rows shown at once
	const LISTX = 16;
	const LISTW = 286;
	const DX = 318;          // detail panel left
	const NTABS = 6;

	// the five families in the HUD's order (bonus.zs EScoreFamily), then the named combos (their rows are Style's)
	static const String FAMNAME[]  = { "Efficiency", "Style", "Daring", "Melee", "Counterplay", "Combos" };
	static const String FAMCOLOR[] = { "RSScore_Efficiency", "RSScore_Style", "RSScore_Daring", "RSScore_Melee", "RSScore_Counter", "RSScore_Gold" };

	// one entry per bonus, parallel arrays (filled by Build, glossary_data.zs)
	Array<int>    eFam;
	Array<String> eName;
	Array<String> eShort;    // the list's value, e.g. "+15"
	Array<String> eText;     // what earns it
	Array<String> eBonus;    // the "Bonus:" line
	Array<String> eNeeds;    // the "Needs:" line

	int mTab;
	int mSel;                // index into the current tab's entries
	int mTop;                // first row shown
	Array<int> mShown;       // entry indices in the current tab
	int mSelOf[NTABS];       // each tab keeps its place
	int mTopOf[NTABS];

	Font fBig, fSmall;
	double s, ox, oy;        // virtual -> real

	// ---------------------------------------------------------------------------------------------- content

	// the list's value: the Bonus line's first "+N" ("" when it has none, e.g. Rank)
	static String ShortOf(String bonus)
	{
		int p = bonus.IndexOf("+");
		if (p < 0) return "";
		int e = p + 1;
		while (e < bonus.Length())
		{
			int c = bonus.ByteAt(e);
			if (c < 48 || c > 57) break;
			e++;
		}
		return e > p + 1 ? bonus.Mid(p, e - p) : "";
	}

	void Add(int fam, String name, String text, String bonus, String needs)
	{
		eFam.Push(fam); eName.Push(name); eShort.Push(ShortOf(bonus)); eText.Push(text); eBonus.Push(bonus); eNeeds.Push(needs);
	}

	// ---------------------------------------------------------------------------------------------- state

	override void Init(Menu parent, ListMenuDescriptor desc)
	{
		Super.Init(parent, desc);
		DontDim = false;
		Build();
		fBig = Font.GetFont("RSSCFON");   if (!fBig) fBig = bigfont;
		fSmall = Font.GetFont("RSSCFN2"); if (!fSmall) fSmall = smallfont;
		mTab = 1;   // Style: the original's own family, a short list to start on
		Refill();
	}

	void Refill()
	{
		mShown.Clear();
		for (int i = 0; i < eFam.Size(); i++) if (eFam[i] == mTab) mShown.Push(i);
		mSel = clamp(mSelOf[mTab], 0, max(0, mShown.Size() - 1));
		mTop = mTopOf[mTab];
		Scroll();
	}

	void SetTab(int t)
	{
		mSelOf[mTab] = mSel; mTopOf[mTab] = mTop;
		mTab = (t + NTABS) % NTABS;
		Refill();
		MenuSound("menu/change");
	}

	void Scroll()
	{
		if (mSel < mTop) mTop = mSel;
		if (mSel >= mTop + LISTROWS) mTop = mSel - LISTROWS + 1;
		mTop = clamp(mTop, 0, max(0, mShown.Size() - LISTROWS));
	}

	void Move(int d, bool wrap)
	{
		int n = mShown.Size();
		if (n == 0) return;
		int was = mSel;
		if (wrap) mSel = (mSel + d + n) % n;
		else      mSel = clamp(mSel + d, 0, n - 1);
		Scroll();
		if (mSel != was) MenuSound("menu/cursor");
	}

	override bool MenuEvent(int mkey, bool fromcontroller)
	{
		switch (mkey)
		{
		case MKEY_Up:       Move(-1, true); return true;
		case MKEY_Down:     Move(1, true); return true;
		case MKEY_PageUp:   Move(-LISTROWS, false); return true;
		case MKEY_PageDown: Move(LISTROWS, false); return true;
		case MKEY_Left:     SetTab(mTab - 1); return true;
		case MKEY_Right:    SetTab(mTab + 1); return true;
		case MKEY_Enter:    return true;
		}
		return Super.MenuEvent(mkey, fromcontroller);   // Back: Menu closes it
	}

	// TEST ONLY (the rig cannot send menu keys): rs_score_glosstest 1 up, 2 down, 3 left, 4 right, 5 page down,
	// 6 page up; the open Glossary does it once and sets it back to 0. No menu row.
	override void Ticker()
	{
		Super.Ticker();
		CVar cv = CVar.FindCVar("rs_score_glosstest");
		if (!cv || cv.GetInt() == 0) return;
		static const int KEYS[] = { MKEY_Up, MKEY_Down, MKEY_Left, MKEY_Right, MKEY_PageDown, MKEY_PageUp };
		int k = cv.GetInt();
		cv.SetInt(0);
		if (k >= 1 && k <= 6) MenuEvent(KEYS[k - 1], false);
	}

	// a click on a tab or a row
	override bool MouseEvent(int type, int mx, int my)
	{
		Frame();
		double x = (mx - ox) / s, y = (my - oy) / s;
		if (type == MOUSE_Release)
		{
			if (y >= 52 && y < 86 && x >= LISTX && x < VW - LISTX)
			{
				int t = clamp(int((x - LISTX) / ((VW - 2 * LISTX) / double(NTABS))), 0, NTABS - 1);
				if (t != mTab) SetTab(t);
				return true;
			}
			if (x >= LISTX && x < LISTX + LISTW && y >= LISTY && y < LISTY + LISTROWS * ROWH)
			{
				int r = mTop + int((y - LISTY) / ROWH);
				if (r < mShown.Size() && r != mSel) { mSel = r; MenuSound("menu/cursor"); }
				return true;
			}
		}
		return true;
	}

	// ---------------------------------------------------------------------------------------------- drawing

	void Frame()
	{
		double w = Screen.GetWidth(), h = Screen.GetHeight();
		s = min(w / VW, h / VH);
		ox = (w - VW * s) / 2;
		oy = (h - VH * s) / 2;
	}

	int Col(String name)
	{
		// colour-blind play (cb.zs): the family's _PD/_T/_HC look, as the HUD uses (gold has none)
		if (name == "RSScore_Gold") return Font.FindFontColor(name);
		return Font.FindFontColor(name .. RS_ScoreCB.Suffix());
	}

	void Txt(Font f, int col, double x, double y, String t, double k = 1.0, double alpha = 1.0, double kx = 0)
	{
		if (kx <= 0) kx = k;
		Screen.DrawText(f, col, ox + x * s, oy + y * s, t, DTA_ScaleX, s * kx, DTA_ScaleY, s * k, DTA_Alpha, alpha);
	}

	// solid boxes (Screen.Clear): Screen.Dim read much darker under Brutal Doom on the rig, and a solid page also
	// keeps the game's HUD text from showing through. `a` shades the colour.
	void Box(Color c, double a, double x, double y, double w, double h)
	{
		int x0 = int(ox + x * s), y0 = int(oy + y * s);
		Screen.Clear(x0, y0, x0 + int(w * s), y0 + int(h * s), Color(int(c.r * a), int(c.g * a), int(c.b * a)));
	}

	// wrapped text; returns the y under it
	// "Label: value": the label in its colour, the value after it (wrapped under it when long)
	double Labeled(Font f, int lc, int vc, double x, double y, double w, String label, String val, double k)
	{
		double lw = f.StringWidth(label) * k;
		Txt(f, lc, x, y, label, k);
		BrokenLines bl = f.BreakLines(val, int(max(w - lw, 40) / k));
		double lh = f.GetHeight() * k + 3;
		for (int i = 0; i < bl.Count(); i++) { Txt(f, vc, x + lw, y, bl.StringAt(i), k); y += lh; }
		return y;
	}

	double Para(Font f, int col, double x, double y, double w, String t, double k)
	{
		BrokenLines bl = f.BreakLines(t, int(w / k));
		double lh = f.GetHeight() * k + 3;
		for (int i = 0; i < bl.Count(); i++) { Txt(f, col, x, y, bl.StringAt(i), k); y += lh; }
		return y;
	}

	override void Drawer()
	{
		Frame();
		int white = Font.FindFontColor("RSScore_White");
		int gold  = Font.FindFontColor("RSScore_Gold");

		Screen.Clear(0, 0, Screen.GetWidth(), Screen.GetHeight(), Color(8, 8, 8));

		// title
		double tk = 1.4;
		String title = "RSQ SCORE GLOSSARY";
		Txt(fBig, gold, (VW - fBig.StringWidth(title) * tk) / 2, 12, title, tk);

		// tabs
		double tw = (VW - 2 * LISTX) / double(NTABS);
		for (int t = 0; t < NTABS; t++)
		{
			double tx = LISTX + t * tw;
			bool on = (t == mTab);
			if (on) { Box(0x606060, 0.6, tx + 2, 52, tw - 4, 34); Box(0xFFFFFF, 0.8, tx + 2, 84, tw - 4, 2); }
			else    Box(0x303030, 0.6, tx + 2, 52, tw - 4, 34);
			String nm = FAMNAME[t];
			double k = min(1.25, (tw - 12) / max(1, fSmall.StringWidth(nm)));
			Txt(fSmall, Col(FAMCOLOR[t]), tx + (tw - fSmall.StringWidth(nm) * k) / 2, 69 - fSmall.GetHeight() * k / 2, nm, k, on ? 1.0 : 0.55);
		}

		int fc = Col(FAMCOLOR[mTab]);
		if (mShown.Size() == 0)
		{
			Para(fSmall, white, 30, LISTY + 10, VW - 60, "No " .. FAMNAME[mTab] .. " bonuses.", TS);
		}
		else
		{
			// list
			Box(0x202020, 0.7, LISTX, LISTY - 6, LISTW, LISTROWS * ROWH + 12);
			double lh = fSmall.GetHeight() * LS;
			for (int r = 0; r < LISTROWS && mTop + r < mShown.Size(); r++)
			{
				int i = mShown[mTop + r];
				double ry = LISTY + r * ROWH;
				if (mTop + r == mSel) Box(0x707070, 0.55, LISTX + 2, ry - 2, LISTW - 14, ROWH - 2);
				double ty = ry + (ROWH - 2 - lh) / 2 - 2;
				double vw = fSmall.StringWidth(eShort[i]) * LS;
				double room = LISTW - 30 - vw - 10;
				double nw = fSmall.StringWidth(eName[i]) * LS;
				double kx = nw > room ? LS * room / nw : LS;   // a long name narrows to fit beside its value
				Txt(fSmall, fc, LISTX + 8, ty, eName[i], LS, 1.0, kx);
				Txt(fSmall, white, LISTX + LISTW - 20 - vw, ty, eShort[i], LS);
			}
			// the scroll bar: where the shown rows sit in the whole list
			if (mShown.Size() > LISTROWS)
			{
				double bh = LISTROWS * ROWH;
				double th = max(12.0, bh * LISTROWS / mShown.Size());
				double tyb = LISTY + (bh - th) * mTop / double(mShown.Size() - LISTROWS);
				Box(0x404040, 1.0, LISTX + LISTW - 9, LISTY, 5, bh);
				Box(0xC0C0C0, 1.0, LISTX + LISTW - 9, tyb, 5, th);
			}

			// detail
			int e = mShown[mSel];
			double dx = DX, dw = VW - LISTX - dx;
			Box(0x202020, 0.7, dx - 6, LISTY - 6, dw + 6, LISTROWS * ROWH + 12);
			double y = LISTY + 2;
			double nk = min(1.0, (dw - 12) / max(1, fBig.StringWidth(eName[e])));
			Txt(fBig, fc, dx + 4, y, eName[e], nk);
			y += fBig.GetHeight() * nk + 12;
			y = Para(fSmall, white, dx + 4, y, dw - 12, eText[e], TS) + 12;
			// the label in gold and the value in white, drawn apart (a colour code inside the line drew a stray "?" at its end)
			y = Labeled(fSmall, gold, white, dx + 4, y, dw - 12, "Bonus: ", eBonus[e], TS) + 8;
			y = Labeled(fSmall, gold, white, dx + 4, y, dw - 12, "Needs: ", eNeeds[e], TS);
		}

		// footer
		String hint = "Up/Down: choose     Left/Right: family     Back: close";
		Txt(fSmall, white, (VW - fSmall.StringWidth(hint) * 1.1) / 2, VH - 22, hint, 1.1, 0.75);

		Super.Drawer();
	}
}
