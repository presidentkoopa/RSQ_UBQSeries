		Add(3, "Release", "Kill by letting out the Guard's stored charge.", "+24 on an imp", "RSQ Melee");
		Add(3, "Remote Down", "Knock RSQ Saber's training remote out of the air.", "points from RSQ Saber", "RSQ Saber");
		Add(3, "Ring Out", "The level or another monster finishes off a monster you sent there.", "+30 on an imp", "nothing extra");
		Add(3, "Rip and Tear", "A chainsaw kill of a monster of 400 health or more.", "+500 on a Baron of Hell", "nothing extra");
		Add(3, "Run Through", "Kill with a saber stab.", "+15 on an imp", "RSQ Saber");
		Add(3, "Saberstaff", "Kill with the staff's back blade or its spin.", "+18 on an imp", "RSQ Saber");
		Add(3, "Scorpion", "Gun Bonsai VR's counterpunch on what your hook brought. It takes the place of Counter.", "+18 on an imp", "RSQ Grapple and RSQ Gun Bonsai VR");
		Add(3, "Seeing Stars", "A Heavy Hands punch freezes it; kill it within a second.", "+18 on an imp", "RSQ Melee");
		Add(3, "Seismic", "One Ground Pound kills two or more. It takes the place of Multi-Kill.", "+18 on an imp for each kill past the first, up to +54", "RSQ Melee");
		Add(3, "Shatter", "Shatter a frozen monster.", "+24 on an imp", "RSQ Gun Bonsai VR (Freeze Fist)");
		Add(3, "Shield Dash", "The bash at the end of a Shield Dash.", "+24 on an imp", "RSQ ShieldSaw");
		Add(3, "Shield Work", "Kill with the shield's bash, or its revved grind.", "+18 on an imp for the bash, +12 for the grind", "RSQ ShieldSaw");
		Add(3, "Shoryuken", "Kill with an uppercut.", "+18 on an imp", "RSQ Melee");
		Add(3, "Slammed", "A body flung from your Force grip dies hitting something.", "+30 on an imp", "RSQ Saber");
		Add(3, "Snap Kill", "A marked whip crack from 6 metres or more.", "+18 on an imp", "RSQ Whip");
		Add(3, "Star Punch", "Kill with the gloves' Star Punch.", "+30 on an imp", "RSQ Melee");
		Add(3, "Stun Lock", "A stunning whip crack holds it, another tool kills it.", "+18 on an imp", "RSQ Whip");
		Add(3, "Tarzan", "Swing in on the rope; your arrival kills it. It takes the place of Swinging.", "+30 on an imp", "RSQ Whip or RSQ Grapple");
		Add(3, "Textbook", "Jab, jab, hook, inside one second.", "+21 on an imp", "RSQ Melee");
		Add(3, "Tomahawk", "Kill with a thrown axe.", "+18 on an imp", "Brutal Doom VR's axe");
		Add(3, "Toss", "A monster thrown out of the Headlock dies when it lands.", "+21 on an imp", "RSQ Melee");
		Add(3, "Triple Threat", "Jab, hook, uppercut, inside one second. It takes the place of Shoryuken and Textbook.", "+30 on an imp", "RSQ Melee");
		Add(3, "Twin Blades", "A saber kill with a lit saber in each hand.", "+12 on an imp", "RSQ Saber");
		Add(3, "Unlimited Power", "Kill with Force Lightning.", "+21 on an imp", "RSQ Saber");
		Add(3, "Wall Splat", "Knock it into a wall, and the wall kills it.", "+24 on an imp", "a melee mod");
		Add(3, "Weapon Master", "A run of kills with one melee mod (fists, saber, ShieldSaw, whip), each within 10 seconds.", "+6 on an imp for each kill past two, up to +30", "a melee mod");
		Add(3, "Wrecking Ball", "The monster you swing on your whip smashes into it.", "+24 on an imp", "RSQ Whip");
		Add(3, "Zip Kick", "Arrive by rope at speed and kill it.", "+21 on an imp", "RSQ Grapple");
		// ---- Counterplay
		Add(4, "Back Off", "Your crossed blades turn the shot that kills. It takes the place of Return to Sender.", "+30 on an imp", "RSQ Saber");
		Add(4, "Eyes in the Back", "The shield on your back blocks it, then you kill it.", "+30 on an imp", "RSQ ShieldSaw");
		Add(4, "Full Release", "One Guard release kills two or more.", "+18 on an imp for each kill past the first, up to +54", "RSQ Melee");
		Add(4, "Hold the Line", "Shield Wall against two or more monsters in the last 2 seconds. It takes the place of Shield Wall.", "+15 on an imp, +6 more a monster, up to +33", "RSQ ShieldSaw");
		Add(4, "Justice Shot", "Your gun kills it while it winds up an attack, before the attack leaves it.", "+24 on an imp", "nothing extra");
		Add(4, "Meat Shield", "The monster in your Headlock dies of what another monster threw at you. It takes the place of Ring Out.", "+36 on an imp", "RSQ Melee");
		Add(4, "Misdirection", "A shot you sent back kills a monster that did not fire it.", "+15 on an imp", "a mod that sends shots back: RSQ Saber, RSQ ShieldSaw, RSQ Melee or RSQ Whip");
		Add(4, "Perfect Riposte", "The same as Riposte, after a perfect block. It takes the place of Riposte.", "+42 on an imp", "RSQ ShieldSaw or RSQ Saber");
		Add(4, "Poetic Justice", "A shot you sent back kills the monster that fired it.", "+18 on an imp", "a mod that sends shots back: RSQ Saber, RSQ ShieldSaw, RSQ Melee or RSQ Whip");
		Add(4, "Rally", "Shots you send back kill one after another, each within 3 seconds.", "+12 on an imp for the second, +24 for the third, then +36", "a mod that sends shots back: RSQ Saber, RSQ ShieldSaw, RSQ Melee or RSQ Whip");
		Add(4, "Read It", "Its shot passes close to you and never hurts you, then you kill it within 3 seconds.", "+30 on an imp", "nothing extra");
		Add(4, "Return to Sender", "A shot you sent back kills it.", "+24 on an imp; a Hadouken or Swat Back +36; the Guard +30; the whip +33", "a mod that sends shots back: RSQ Saber, RSQ ShieldSaw, RSQ Melee or RSQ Whip");
		Add(4, "Riposte", "Block its attack with your shield or saber, then kill it within 3 seconds.", "+24 on an imp", "RSQ ShieldSaw or RSQ Saber");
		Add(4, "Rope-a-Dope", "Your Guard soaks its blow and you kill it within 3 seconds. More with your hands or a hand weapon.", "+24 on an imp; +36 with your hands", "RSQ Melee");
		Add(4, "Shield Wall", "Kill while your shield blocked another monster's attack in the last second.", "+15 on an imp", "RSQ ShieldSaw");
		Add(4, "Swatted", "A missile your open palm knocked aside kills something. It takes the place of Return to Sender.", "+30 on an imp", "RSQ Melee");
