// #namespace TFLV;

class TFLV_Debug : Object play {
  static void DebugCommand(TFLV_GunBonsaiService service, int player, string cmd, uint arg) {
    Array<string> argv;
    cmd.split(argv, ",");
    // 0: bonsai-debug, 1: <command>, 2: args...
    if (argv[1] == "info") {
      ShowInfoConsole(players[player].mo);
    } else if (argv[1] == "w-up" && argv.size() >= 3) {
      let upgrade = argv[2];
      if (upgrade.IndexOf(":"..":") == 0) upgrade = "TFLV_Upgrade_" .. upgrade.Mid(2);
      service.GetInt("add-w-upgrade", upgrade, player, arg, null);
    } else if (argv[1] == "p-up" && argv.size() >= 3) {
      let upgrade = argv[2];
      if (upgrade.IndexOf(":"..":") == 0) upgrade = "TFLV_Upgrade_" .. upgrade.Mid(2);
      service.GetInt("add-p-upgrade", upgrade, player, arg);
    } else if (argv[1] == "w-xp") {
      service.GetDouble("add-w-xp", "", player, arg, null);
    } else if (argv[1] == "p-xp") {
      service.GetDouble("add-p-xp", "", player, arg);
    } else if (argv[1] == "hands") {
      ShowHandsConsole(players[player].mo);
    } else if (argv[1] == "allupgrades") {
      AddAllUpgrades(service, player);
    } else if (argv[1] == "reset") {
      console.printf("Fully resetting all weapon info.");
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      stats.weapons.clear();
      stats.weaponinfo_dirty = true;
      stats.XP = 0;
      stats.level = 0;
      stats.upgrades = null;
      stats.Initialize(stats.proxy);
    } else {
      console.printf("Unknown or malformed debug command: %s", argv[1]);
    }
  }

  static void ShowInfoConsole(Actor pawn) {
    TFLV_CurrentStats stats;
    if (!TFLV_PerPlayerStats.GetStatsFor(pawn).GetCurrentStats(stats)) {
      console.printf("Error getting current stats for player.");
      return;
    }
    console.printf("Player:\n    Level %d (%d/%d XP)",
      stats.plvl, stats.pxp, stats.pmax);
    stats.pupgrades.DumpToConsole("    ");
    console.printf("%s (%s):\n    Level %d (%d/%d XP)",
      stats.winfo.wpnClass, stats.wname, stats.wlvl, stats.wxp, stats.wmax);
    stats.wupgrades.DumpToConsole("    ");
    stats.winfo.ld_info.DumpToConsole();
    stats.winfo.DumpTypeInfo();
  }

  // VR PATCH: `netevent bonsai-debug,hands`
  //
  // One line per hand plus the resolver's counters. The counters are the point:
  // if attribution is going wrong we want a number that says so, not a player
  // noticing a week later that their XP went to the wrong gun. A high
  // scored-thin count means the signals are tying and we are effectively
  // guessing; a nonzero dropped count means the provenance ring is too small
  // for the rate of fire it is seeing.
  static void ShowHandsConsole(Actor pawn) {
    let stats = TFLV_PerPlayerStats.GetStatsFor(pawn);
    if (!stats) {
      console.printf("No Gun Bonsai stats for this player.");
      return;
    }
    console.printf("Gun Bonsai VR/offhand state:");
    for (int hand = 0; hand <= 1; ++hand) {
      string label = hand ? "offhand" : "mainhand";
      let wpn = stats.WeaponForHand(hand);
      if (!wpn) {
        console.printf("  %-8s (empty)", label);
        continue;
      }
      let info = stats.GetInfoForHand(hand);
      if (!info) {
        console.printf("  %-8s %s -- NO LIVE INFO (normal for one tic after a switch)",
          label, wpn.GetClassName());
        continue;
      }
      console.printf("  %-8s %s [%s] lv %d (%.0f/%.0f XP) %d upgrades%s",
        label, info.wpnClass, wpn.bOffhandWeapon ? "offhand-flagged" : "mainhand-flagged",
        info.level, info.XP, info.maxXP,
        info.upgrades ? info.upgrades.upgrades.size() : 0,
        info.IsIgnored() ? " IGNORED" : "");
    }
    console.printf("  binding mode %d%s",
      bonsai_upgrade_binding_mode,
      bonsai_upgrade_binding_mode == TFLV_BIND_WEAPON ? "" : "  <-- not per-weapon; see readme");
    console.printf("  infos %d, provenance %d live (dropped %d)",
      stats.weapons.size(), stats.provenance.size(), stats.provDropped);
    console.printf("  resolver: claimed %d, self-claimed %d, inherited %d, scored %d (thin %d), unattributed %d",
      stats.provClaims, stats.provSelfClaims, stats.provInherits, stats.provScored,
      stats.provScoredThin, stats.provFallback);
    // The last-kill credit is what score-to-XP pays. Printed because it is
    // otherwise unobservable: score XP arriving at the wrong gun looks exactly
    // like score XP arriving at the right one until a level comes up.
    string credited = "(no attributed kill yet)";
    if (stats.lastKillInfo) credited = stats.lastKillInfo.wpnClass;
    if (stats.lastKillPooled) credited = "(the player pool: a throw)";
    console.printf("  last kill credited to %s; score-to-XP factor %.2f",
      credited, bonsai_score_to_xp_factor);
    // VR PATCH (suite): XP no gun earned (Distance Grab throws and the blasts
    // they set off), and the player XP / level it has become.
    console.printf("  pooled hits %d, pool %.1f / %d, player xp %d level %d",
      stats.provPooled, stats.poolXP, bonsai_base_level_cost, stats.XP, stats.level);
  }

  static void AddAllUpgrades(TFLV_GunBonsaiService service, int player) {
    let registry = TFLV_Upgrade_Registry.GetRegistry();
    for (uint i = 0; i < registry.upgrades.size(); ++i) {
      service.GetInt("add-w-upgrade", registry.upgrades[i].GetClassName(), player, 1, null);
      service.GetInt("add-p-upgrade", registry.upgrades[i].GetClassName(), player, 1);
    }
  }
}
