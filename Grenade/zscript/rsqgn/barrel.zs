// RSQ Grenade -- THE BARRELS (owner, 2026-11-09: "all the barrels i love. let's get our barrel mod spun up. part of
// grenade? all we need is to randomize barrel explosions with the six we have, ensure we have an option to stand down
// or overwrite BD22 barrels like we do with the grenade, get some sounds from CombatFX").
//
// IT LIVES IN RSQ GRENADE (the owner's no-new-mods rule, WHO_OWNS_WHAT.md line 9): this pack already owns the blast
// code (blast.zs), the Brutal Doom stand-down / replace handshake (hand.zs Active, ReplacesBD) and explosion sounds.
//
// WHAT CHANGES AND WHAT DOES NOT. Only the LOOK and the SOUND of a barrel going off. RSQGN_Barrel SUBCLASSES
// ExplosiveBarrel, so every mod that finds barrels by walking the parent chain to ExplosiveBarrel keeps finding it
// (RSQ Melee gloves.zs:634-642 IsBarrel, RSQ SlowMo clock.zs:1523-1543 BarrelClass, RSQ Distance Grab policy.zs /
// mass.zs). It keeps the stock barrel's health (20), size, flags, obituary and its A_Explode (128 damage over 128,
// +OLDRADIUSDMG) ON THE SAME TIC after death as stock (BEXP A, B, C at 5 tics each: the blast 15 tics after it dies),
// so chain reactions run at the stock pace. The 15 tics are spent as End of Starchild's barrel death spends them (its
// structure only; none of its art ships): the barrel stands 5 tics, then blinks lit / unlit 5 x 2 tics (lit = the
// stock BAR1 sprite, fullbright, through the RSQGN_BarrelHot translation, TRNSLATE.txt; a translation also colours
// RS Monsters' BAR1 voxels), then goes off.
//
// THE BLAST: one of the six sequences (the owner's numbers: #5 Snap, #6 Heavy, #7 Pillar, #8 Groundbreaker, #9 Slag
// Column, #10 Neon Crescent), at random or the one the menu picks. Every sequence is data (barrel_data.zs, GENERATED by
// tools/barrel_export.py from the approved Python sequences); RSQGN_BarrelFX plays it: a conductor that spawns, on
// each layer's own tic, its billboard or floor-flat RSQGN_BarrelLayer (which steps through its per-tic track: sprite
// frame, scale, alpha, offset), the embers (RSQGN_BarrelEmber), the bouncing debris (RSQGN_BarrelDebris), the banded
// floor light and the clatter.
//
// NOTHING HERE TOUCHES GAMEPLAY OR NETPLAY SYNC. The damage is the barrel's own stock A_Explode. Every effect actor is
// play-scope and +NOBLOCKMAP / +THRUACTORS (no blocking, no damage, not shootable); its random numbers come from a
// NAMED generator (random[RSQGNBarrel]) so the game's own RNG sequence is never drawn from; every setting it reads is a
// SERVER cvar, so every machine in a netgame spawns the same effects (a user cvar here would let two machines' play
// simulations differ). +CLIENTSIDEONLY is set as blast.zs sets it (a Zandronum flag; QuestZDoom accepts and ignores it).
// THE CAP: the live effect actors are counted (RSQGN_BarrelBook); past Effects Cap (rsqgn_barrel_cap) a sequence
// spawns only its first-tic layers, so a 20-barrel chain on Quest never floods the thinker list.
//
// BRUTAL DOOM (RSQGN_BarrelSwap.CheckReplacement): see there.

// =====================================================================================================================
// THE BARREL
// =====================================================================================================================
class RSQGN_Barrel : ExplosiveBarrel
{
	TranslationID rsqgnTrans;   // the barrel's own translation before a blink (restored after each lit frame)

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		rsqgnTrans = Translation;
	}

	// the blink: lit = fullbright through RSQGN_BarrelHot; unlit = its own translation back
	action void A_RSQGN_Lit(bool lit)
	{
		if (lit) A_SetTranslation('RSQGN_BarrelHot');
		else invoker.Translation = invoker.rsqgnTrans;
	}

	// the stock blast, on the stock tic; then the look and the sound
	action void A_RSQGN_Blast()
	{
		invoker.Translation = invoker.rsqgnTrans;
		A_Explode();   // ExplosiveBarrel's own call: default damage and radius (128 / 128), XF_HURTSOURCE
		RSQGN_BarrelFX.Go(invoker);
	}

	States
	{
	Death:
		// Barrels switched off while this one stood (the row reads at death): the stock death, frame for frame.
		TNT1 A 0 A_JumpIf(!RSQGN_BarrelSwap.On(), "StockDeath");
		BAR1 A 5;                                // 0-4: it stands (the hit)
		BAR1 A 2 Bright A_RSQGN_Lit(true);       // 5-6:  lit
		BAR1 A 2 A_RSQGN_Lit(false);             // 7-8:  unlit
		BAR1 A 2 Bright A_RSQGN_Lit(true);       // 9-10: lit
		BAR1 A 2 A_RSQGN_Lit(false);             // 11-12: unlit
		BAR1 A 2 Bright A_RSQGN_Lit(true);       // 13-14: lit
		TNT1 A 15 A_RSQGN_Blast();               // 15: GONE -- stock's A_Explode tic (BEXP A+B+C = 15); BEXP D's 5 + E's 10 tics
		TNT1 A 1050 A_BarrelDestroy;             // stock from here (ExplosiveBarrel's Death)
		TNT1 A 5 A_Respawn;
		Wait;
	StockDeath:                                  // ExplosiveBarrel's Death, unchanged
		BEXP A 5 Bright;
		BEXP B 5 Bright A_Scream;
		BEXP C 5 Bright;
		BEXP D 5 Bright A_Explode;
		BEXP E 10 Bright;
		TNT1 A 1050 Bright A_BarrelDestroy;
		TNT1 A 5 A_Respawn;
		Wait;
	}
}

// =====================================================================================================================
// THE SWAP: who gets the map's barrels. A STATIC handler, as RSQ Melee's slappers.zs and RSQ Graveyard's bones.zs do
// their CheckReplacement, so it is in place before any map thing spawns.
// =====================================================================================================================
// BRUTAL DOOM. Brutal Doom (v22, and BD22 VR Reloaded, which carries it) declares `ACTOR ExplosiveBarrel1 Replaces
// ExplosiveBarrel` with NO parent (RSQ Distance Grab policy.zs:136, found in brutal22test6; kinds.zs:261-272 uses
// the same class to know Brutal Doom is there). HOW IT DECIDES BRUTAL DOOM IS LOADED: the grenade's way (hand.zs
// BDVR: a class looked up from a String at run time, because a quoted class name is resolved when the script
// compiles and would break this pack without that mod) -- here the class looked up is BD's barrel itself,
// "ExplosiveBarrel1", since that is the thing we would be taking over (plain Brutal Doom without the VR pack has it too).
//   - default (Replace Brutal Doom's Barrels off): with ExplosiveBarrel1 present we STAND DOWN -- the replacement
//     is left as Brutal Doom made it, and its barrels are its own;
//   - Replace Brutal Doom's Barrels on: CheckReplacement hands back RSQGN_Barrel both for ExplosiveBarrel (the map's
//     barrels, which BD would turn into ExplosiveBarrel1) AND for ExplosiveBarrel1 itself (anything that spawns BD's
//     barrel by name).
// The event handler runs BEFORE the DECORATE replacement chain is followed (GetReplacement asks the handlers first,
// with BD's ExplosiveBarrel1 as the replacement so far): setting ours there is all it takes; nothing on BD's side
// has to read anything (unlike the grenade, whose BD22 VR side reads rsqgn_replace_bd by name).
// LIMITS: only those two class names are taken over. A barrel-like thing BD spawns under another class (its burning
// barrels, map-script spawns of its own actors, a later BD build that renames the class) stays BD's. A replaced barrel
// is a STOCK barrel in every way but its look: BD's own barrel extras (its kick, its spilled fire, its explosion
// damage actor) go with it, and any BD code that tests `is "ExplosiveBarrel1"` no longer matches. The swap happens
// when a thing SPAWNS: flipping the rows mid-map changes the barrels spawned after (a new map, a respawn); barrels
// already standing keep their class (ours fall back to the stock death when Barrels is off, see Death above).
class RSQGN_BarrelSwap : StaticEventHandler
{
	static bool On()          { let c = CVar.FindCVar("rsqgn_barrel_on"); return !c || c.GetBool(); }
	static bool ReplacesBD()  { let c = CVar.FindCVar("rsqgn_barrel_replace_bd"); return c && c.GetBool(); }
	static bool BDBarrel()
	{
		String n = "ExplosiveBarrel1";
		class<Actor> c = n;
		return c != null;
	}
	static int Kind()         { let c = CVar.FindCVar("rsqgn_barrel_kind"); return c ? c.GetInt() : 0; }
	static double Debris()    { let c = CVar.FindCVar("rsqgn_barrel_debris"); return c ? clamp(c.GetFloat(), 0.0, 1.0) : 1.0; }
	static int Cap()          { let c = CVar.FindCVar("rsqgn_barrel_cap"); return c ? clamp(c.GetInt(), 50, 4000) : 600; }

	override void CheckReplacement(ReplaceEvent e)
	{
		if (!e.Replacee || e.IsFinal || !On()) return;
		Name rn = e.Replacee.GetClassName();
		if (rn != 'ExplosiveBarrel' && rn != 'ExplosiveBarrel1') return;
		if (BDBarrel() && !ReplacesBD()) return;   // stand down: Brutal Doom's barrels stay Brutal Doom's
		e.Replacement = "RSQGN_Barrel";
	}
}

// =====================================================================================================================
// THE BOOK: the live effect actors (for the cap) and the sprite numbers (looked up once). A level handler, so the count
// is saved with the level the effect actors are saved in.
// =====================================================================================================================
class RSQGN_BarrelBook : EventHandler
{
	int live;
	transient Array<int> sprIdx;  // SPR(i) -> sprite number (GetSpriteIndex searches every sprite: done once)

	static RSQGN_BarrelBook Get() { return RSQGN_BarrelBook(EventHandler.Find("RSQGN_BarrelBook")); }

	int Spr(int i)
	{
		if (sprIdx.Size() != RSQGN_BarrelData.NSPR)
		{
			sprIdx.Clear();
			for (int k = 0; k < RSQGN_BarrelData.NSPR; k++) sprIdx.Push(Actor.GetSpriteIndex(RSQGN_BarrelData.SPR(k)));
		}
		return sprIdx[i];
	}

	bool Room() { return live < RSQGN_BarrelSwap.Cap(); }
}

// the counted effect actors' base: +1 when the conductor spawns one, -1 when it goes
class RSQGN_BarrelBit : Actor
{
	bool counted;
	Default
	{
		+NOBLOCKMAP
		+NOTELEPORT
		+DONTSPLASH
		+THRUACTORS
		+NOTRIGGER        // the embers and debris MOVE (not NOINTERACTION): never set off an any-cross line special
		+CLIENTSIDEONLY
		+NOTONAUTOMAP
		+FORCEXYBILLBOARD
		+ROLLSPRITE
		Radius 1;
		Height 1;
	}
	void RSQCount(RSQGN_BarrelBook b) { if (b) { b.live++; counted = true; } }
	override void OnDestroy()
	{
		if (counted)
		{
			let b = RSQGN_BarrelBook.Get();
			if (b && b.live > 0) b.live--;
			counted = false;
		}
		Super.OnDestroy();
	}
	States
	{
	Spawn:
		TNT1 A -1;   // the sprite and frame are set each tic from the data (Apply); the state never advances
		Stop;
	}
}

// =====================================================================================================================
// A LAYER: one billboard (Add or Translucent, rolled) or one floor ring (+FLATSPRITE), playing its track
// =====================================================================================================================
class RSQGN_BarrelLayer : RSQGN_BarrelBit
{
	int idx, age;
	Vector3 base;     // the barrel's foot (flats: the floor under it)
	Vector2 axis;     // the sequence's "across": the GIF's x axis, laid along a random direction
	Default
	{
		+NOINTERACTION
		+NOGRAVITY
		RenderStyle "Add";
	}

	void Setup(int i, Vector3 foot, Vector2 ax, double rollDeg, double yaw)
	{
		idx = i; base = foot; axis = ax; age = 0;
		bool add = RSQGN_BarrelData.L_ADD(i) != 0;
		A_SetRenderStyle(1.0, add ? STYLE_Add : STYLE_Translucent);
		bBright = add;                                     // fire is light; smoke is lit by the room
		if (RSQGN_BarrelData.L_FLAT(i) != 0)
		{
			bFlatSprite = true; bForceXYBillboard = false; bRollSprite = false;
			angle = yaw;
		}
		else roll = rollDeg;
		Apply(false);
		ClearInterpolation();
	}

	void Apply(bool moving = true)
	{
		int t = RSQGN_BarrelData.L_TOFS(idx) + age;
		int sp = RSQGN_BarrelData.T_SPR(t);
		if (sp < 0) bInvisible = true;
		else
		{
			let b = RSQGN_BarrelBook.Get();
			if (b) sprite = b.Spr(sp);
			frame = RSQGN_BarrelData.T_FRM(t);
			bInvisible = false;
		}
		scale = (RSQGN_BarrelData.T_SX(t) * 0.001, RSQGN_BarrelData.T_SY(t) * 0.001);
		alpha = RSQGN_BarrelData.T_A(t) * 0.001;
		double x = RSQGN_BarrelData.T_X(t) * 0.01;
		Vector3 p = base + (axis.x * x, axis.y * x, RSQGN_BarrelData.T_Z(t) * 0.01);
		SetOrigin(p, moving);
	}

	override void Tick()
	{
		if (IsFrozen()) return;
		ClearInterpolation();
		age++;
		if (age >= RSQGN_BarrelData.L_TLEN(idx)) { Destroy(); return; }
		Apply();
	}
}

// =====================================================================================================================
// AN EMBER: an RS Combat FX pixel ember (RSS0 A-D) thrown up; it falls with gravity and is gone when it lands
// (EoS BarrelFire: 2 a tic for 7 tics). Set A: anywhere within the spread, a little sideways drift, the frames 3 tics
// each, fading over its last 3 tics. Set B: mirrored pairs, straight up, 2-3 tics a frame, fading from 60% of its life.
// =====================================================================================================================
class RSQGN_BarrelEmber : RSQGN_BarrelBit
{
	int kind, age, life, ftic[4];
	Default
	{
		RenderStyle "Add";
		+BRIGHT
		+DROPOFF
		MaxStepHeight 2;
	}

	override void Tick()
	{
		if (IsFrozen()) return;
		Super.Tick();                       // the engine's gravity and movement (walls stop it)
		if (bDestroyed) return;
		age++;
		if (age >= life || pos.z <= floorz) { Destroy(); return; }
		int f;
		if (kind == 0)
		{
			f = age < 12 ? min(3, (age / 3) % 4) : 3;
			alpha = age < life - 3 ? 1.0 : (life - age) / 4.0;
		}
		else
		{
			int acc = 0; f = 3;
			for (int i = 0; i < 4; i++) { acc += ftic[i]; if (age < acc) { f = i; break; } }
			double k = age / double(max(1, life - 1));
			alpha = k > 0.6 ? max(0.0, 1.0 - (k - 0.6) / 0.4) : 1.0;
		}
		frame = f;
	}
}

// =====================================================================================================================
// A PIECE OF DEBRIS (debris_v3.Debris, and #9's dust): a hard-pixel bit, one colour step a frame, that tumbles in the
// air, bounces, skids, settles, cools down its palette, twinkles (#10), then blinks out. The ENGINE moves it (gravity,
// walls, the real floor); the bounce is the design's own rule, applied here on landing, because the engine's
// BounceType ends a bounce at 3 map units a tic up (AutoOff), which would kill every bounce the design has
// (debris_v3 _sim: bounce while |vz| x bounce > 1.3 x gravity, at most 4 times; else stop and skid, x0.45 a tic).
// =====================================================================================================================
class RSQGN_BarrelDebris : RSQGN_BarrelBit
{
	int age, palLen, cool, hold, cap, twinkle, tw0, ph, bounces, rest, settledAt;
	double bounce, fric, drag, grv;
	bool sliding;
	Default
	{
		RenderStyle "Normal";
		+DROPOFF
		MaxStepHeight 2;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		settledAt = -1;
	}

	override void Tick()
	{
		if (IsFrozen()) return;
		double vz0 = vel.z;
		bool air = pos.z > floorz + 0.1;
		Super.Tick();
		if (bDestroyed) return;
		age++;
		if (settledAt < 0)
		{
			bool onFloor = pos.z <= floorz + 0.1;
			if (air && onFloor)                                   // landed this tic
			{
				double vz = abs(vz0) + grv;
				if (vz * bounce > 1.3 * grv && bounces < 4) { vel.z = vz * bounce; bounces++; }
				else { vel.z = 0; sliding = true; }
				vel.x *= fric; vel.y *= fric;
			}
			else if (!onFloor) { vel.x *= drag; vel.y *= drag; }
			else sliding = true;
			if (sliding && onFloor)
			{
				vel.x *= 0.45; vel.y *= 0.45;
				if (vel.xy.Length() < 0.5) { vel.x = 0; vel.y = 0; if (++rest > 3) settledAt = age; }
			}
		}
		int endAge = cap;
		if (settledAt >= 0) endAge = min(endAge, settledAt + hold);
		if (age >= endAge) { Destroy(); return; }
		int ci = min(palLen - 1, age / max(1, cool));
		if (settledAt >= 0 && twinkle > 0 && (age + tw0) % twinkle == 0) ci = max(0, ci - 3);
		frame = ci;
		int rem = endAge - age;
		bInvisible = rem <= 4 && rem % 2 == 0;                    // blinks out
		if (settledAt < 0)                                        // tumbles while it flies
		{
			if (ph % 2 == 0 && (age / 2) % 2) roll = 90;
			else if ((age / 2 + ph) % 4 >= 2) roll = 180;
			else roll = 0;
		}
		else roll = 0;
	}
}

// =====================================================================================================================
// THE CONDUCTOR: one per barrel blast. Plays sequence `seq` from RSQGN_BarrelData, tic by tic.
// =====================================================================================================================
class RSQGN_BarrelFX : Actor
{
	int seq, age, lightStep, popAng;
	Vector2 axis;
	double yaw, dbAmt;
	bool onFloor, anyDebris, full;
	Default
	{
		+NOINTERACTION
		+NOGRAVITY
		+NOBLOCKMAP
		+NOTELEPORT
		+DONTSPLASH
		+CLIENTSIDEONLY
		+NOTONAUTOMAP
		Radius 1;
		Height 1;
	}
	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}

	// the barrel goes off: sounds on the barrel (it stays 1050 tics), the sequence from a conductor at its foot
	static void Go(Actor barrel)
	{
		// the two layered blasts (EoS layers two: the second low and pitched down) and the distant one on its own channel
		barrel.A_StartSound("rsqgn/barrel/near", CHAN_AUTO);
		barrel.A_StartSound("rsqgn/barrel/near", CHAN_6, CHANF_OVERLAP, 0.6, ATTN_NORM, 0.7);
		barrel.A_StartSound("rsqgn/barrel/far", CHAN_7);
		let fx = RSQGN_BarrelFX(Actor.Spawn("RSQGN_BarrelFX", barrel.pos));
		if (fx) fx.Begin();
	}

	void Begin()
	{
		int k = RSQGN_BarrelSwap.Kind();
		seq = (k >= 5 && k <= 10) ? k - 5 : random[RSQGNBarrel](0, RSQGN_BarrelData.SEQS - 1);
		yaw = frandom[RSQGNBarrel](0, 360);
		axis = (cos(yaw), sin(yaw));
		popAng = random[RSQGNBarrel](0, 359);
		dbAmt = RSQGN_BarrelSwap.Debris();
		onFloor = pos.z - floorz < 4;                 // floor rings only on (or just over) a floor
		let b = RSQGN_BarrelBook.Get();
		full = !b || b.Room();                        // past the cap: only the first tic's layers (the blast itself)
		age = 0; lightStep = 0;
		Step();
	}

	override void Tick()
	{
		if (IsFrozen()) return;
		age++;
		if (age >= RSQGN_BarrelData.Q_LEN(seq)) { A_RemoveLight('RSQGNBarrel'); Destroy(); return; }
		Step();
	}

	void Step()
	{
		let b = RSQGN_BarrelBook.Get();
		// layers starting this tic
		int l0 = RSQGN_BarrelData.Q_L0(seq), ln = RSQGN_BarrelData.Q_LN(seq);
		for (int i = l0; i < l0 + ln; i++)
		{
			if (RSQGN_BarrelData.L_START(i) != age) continue;
			bool flat = RSQGN_BarrelData.L_FLAT(i) != 0;
			if (flat && !onFloor) continue;
			if (age > 0 && (!full || (b && !b.Room()))) continue;
			double r;
			switch (RSQGN_BarrelData.L_RMODE(i))
			{
			case 1:  r = frandom[RSQGNBarrel](0, 360); break;
			case 2:  r = popAng; popAng += random[RSQGNBarrel](90, 130); break;
			case 3:  r = 90 * random[RSQGNBarrel](0, 3); break;
			default: r = RSQGN_BarrelData.L_ROLL(i); break;
			}
			Vector3 foot = pos;
			if (flat) foot = (pos.x, pos.y, floorz + 0.3 + 0.05 * (i - l0));   // stacked a hair apart: no z-fighting
			let ly = RSQGN_BarrelLayer(Spawn("RSQGN_BarrelLayer", foot));
			if (!ly) continue;
			ly.RSQCount(b);
			ly.Setup(i, foot, axis, r, yaw + frandom[RSQGNBarrel](0, 360));
		}
		if (full)
		{
			Embers(b);
			if (dbAmt > 0) Debris(b);
		}
		// the floor light: banded (stepped) strength, re-attached only when the step changes
		if (age < RSQGN_BarrelData.Q_LLEN(seq))
		{
			int v = RSQGN_BarrelData.G_LIGHT(RSQGN_BarrelData.Q_LOFS(seq) + age);
			if (v != lightStep)
			{
				lightStep = v;
				if (v <= 0) A_RemoveLight('RSQGNBarrel');
				else
				{
					int c = RSQGN_BarrelData.Q_LCOL(seq);
					Color col = Color(255, ((c >> 16) & 255) * v / 100, ((c >> 8) & 255) * v / 100, (c & 255) * v / 100);
					A_AttachLight('RSQGNBarrel', DynamicLight.PointLight, col, RSQGN_BarrelData.Q_LRAD(seq), 0, 0, (0, 0, 16));
				}
			}
		}
		else if (lightStep != 0) { lightStep = 0; A_RemoveLight('RSQGNBarrel'); }
		// the clatter: when the first piece of debris lands
		if (anyDebris && age == RSQGN_BarrelData.Q_CLATTER(seq)) A_StartSound("rsqgn/barrel/clatter", CHAN_AUTO, 0, 0.6);
	}

	void Embers(RSQGN_BarrelBook b)
	{
		int e0 = RSQGN_BarrelData.Q_E0(seq), en = RSQGN_BarrelData.Q_EN(seq);
		for (int g = e0; g < e0 + en; g++)
		{
			int st = RSQGN_BarrelData.E_START(g);
			if (age < st || age >= st + RSQGN_BarrelData.E_TICS(g)) continue;
			int kind = RSQGN_BarrelData.E_KIND(g);
			if (kind == 0)
			{
				for (int j = 0; j < RSQGN_BarrelData.E_PER(g); j++)
				{
					double a = frandom[RSQGNBarrel](0, 360);
					double r = abs(frandom[RSQGNBarrel](-1, 1)) * RSQGN_BarrelData.E_R1(g) * 0.001;
					double va = frandom[RSQGNBarrel](0, 360), vx = frandom[RSQGNBarrel](0, RSQGN_BarrelData.E_VX(g) * 0.001);
					Ember(b, g, (cos(a) * r, sin(a) * r), (cos(va) * vx, sin(va) * vx));
				}
			}
			else
			{
				// a mirrored pair: the same distance out on opposite sides of a random direction
				double rr = frandom[RSQGNBarrel](RSQGN_BarrelData.E_R0(g), RSQGN_BarrelData.E_R1(g)) * 0.001;
				double x = frandom[RSQGNBarrel](rr * RSQGN_BarrelData.E_XMIN(g) * 0.001, rr);
				double a = frandom[RSQGNBarrel](0, 360);
				Ember(b, g, (cos(a) * x, sin(a) * x), (0, 0));
				Ember(b, g, (-cos(a) * x, -sin(a) * x), (0, 0));
			}
		}
	}

	void Ember(RSQGN_BarrelBook b, int g, Vector2 off, Vector2 v)
	{
		if (b && !b.Room()) return;
		double z = frandom[RSQGNBarrel](RSQGN_BarrelData.E_Z0(g), RSQGN_BarrelData.E_Z1(g)) * 0.001;
		let e = RSQGN_BarrelEmber(Spawn("RSQGN_BarrelEmber", pos + (off.x, off.y, z)));
		if (!e) return;
		e.RSQCount(b);
		e.kind = RSQGN_BarrelData.E_KIND(g);
		e.Gravity = RSQGN_BarrelData.E_GRAV(g) * 0.001;
		e.vel = (v.x, v.y, frandom[RSQGNBarrel](RSQGN_BarrelData.E_VZ0(g), RSQGN_BarrelData.E_VZ1(g)) * 0.001);
		double s = RSQGN_BarrelData.E_SCALE(g) * 0.001;
		e.scale = (s, s);
		if (b) e.sprite = b.Spr(RSQGN_BarrelData.E_SPR(g));
		e.frame = 0;
		if (e.kind == 0) e.life = random[RSQGNBarrel](RSQGN_BarrelData.E_LIFE0(g), RSQGN_BarrelData.E_LIFE1(g));
		else
		{
			e.life = 0;
			for (int i = 0; i < 4; i++) { e.ftic[i] = random[RSQGNBarrel](2, 3); e.life += e.ftic[i]; }
			e.roll = 90 * random[RSQGNBarrel](0, 3);
		}
	}

	void Debris(RSQGN_BarrelBook b)
	{
		int d0 = RSQGN_BarrelData.Q_D0(seq), dn = RSQGN_BarrelData.Q_DN(seq);
		for (int g = d0; g < d0 + dn; g++)
		{
			int st = RSQGN_BarrelData.D_START(g);
			if (age < st) continue;
			int pairs = int(RSQGN_BarrelData.D_N(g) / 2 * dbAmt + 0.5);
			double every = RSQGN_BarrelData.D_SPAWN(g) * 0.001;
			for (int i = 0; i < pairs; i++)
			{
				if (st + int(i * every) != age) continue;
				Pair(b, g, i, st);
			}
		}
	}

	// debris_v3.Debris: a pair thrown out mirrored about the barrel, the same speed and angle on opposite sides
	void Pair(RSQGN_BarrelBook b, int g, int i, int st)
	{
		double ang = frandom[RSQGNBarrel](RSQGN_BarrelData.D_AN0(g), RSQGN_BarrelData.D_AN1(g)) * 0.001;
		double v = frandom[RSQGNBarrel](RSQGN_BarrelData.D_SP0(g), RSQGN_BarrelData.D_SP1(g)) * 0.001;
		double z = frandom[RSQGNBarrel](RSQGN_BarrelData.D_Z0(g), RSQGN_BarrelData.D_Z1(g)) * 0.001;
		double xo = frandom[RSQGNBarrel](RSQGN_BarrelData.D_X0(g), RSQGN_BarrelData.D_X1(g)) * 0.001;
		double dir = frandom[RSQGNBarrel](0, 360);
		double bb = frandom[RSQGNBarrel](RSQGN_BarrelData.D_B0(g), RSQGN_BarrelData.D_B1(g)) * 0.001;
		int hold = random[RSQGNBarrel](RSQGN_BarrelData.D_HOLD0(g), RSQGN_BarrelData.D_HOLD1(g));
		int cool = random[RSQGNBarrel](RSQGN_BarrelData.D_COOL0(g), RSQGN_BarrelData.D_COOL1(g));
		int ph = random[RSQGNBarrel](0, 3);
		int opt = PickOpt(g);
		bool mirror = RSQGN_BarrelData.D_MIRROR(g) != 0;
		int goneBy = RSQGN_BarrelData.D_UNTIL(g);   // (not `until`: a ZScript keyword)
		int cap = goneBy > 0 ? max(1, goneBy - 6 + i % 7 - (age - st)) : 200;   // all gone by D_UNTIL (debris_v3)
		for (int sgn = -1; sgn <= 1; sgn += 2)
		{
			if (b && !b.Room()) return;
			Vector2 d = (cos(dir) * sgn, sin(dir) * sgn);
			let p = RSQGN_BarrelDebris(Spawn("RSQGN_BarrelDebris", pos + (d.x * xo, d.y * xo, z)));
			if (!p) continue;
			p.RSQCount(b);
			anyDebris = true;
			int o = mirror ? opt : PickOpt(g);
			if (b) p.sprite = b.Spr(RSQGN_BarrelData.O_SPR(o));
			p.frame = 0;
			p.palLen = RSQGN_BarrelData.O_LEN(o);
			p.bBright = RSQGN_BarrelData.O_BRIGHT(o) != 0;
			double c = RSQGN_BarrelData.D_CELL(g) * 0.001;
			double sx = c;
			if (sgn > 0 && (mirror || random[RSQGNBarrel](0, 1) == 1)) sx = -c;   // the right-hand piece mirrored
			p.scale = (sx, c);
			p.vel = (d.x * sin(ang) * v, d.y * sin(ang) * v, cos(ang) * v);
			p.grv = RSQGN_BarrelData.D_GRAV(g) * 0.001;
			p.Gravity = p.grv;
			p.bounce = bb;
			p.fric = RSQGN_BarrelData.D_FRIC(g) * 0.001;
			p.drag = RSQGN_BarrelData.D_DRAG(g) * 0.001;
			p.hold = hold; p.cool = cool; p.ph = ph; p.cap = cap;
			p.twinkle = RSQGN_BarrelData.D_TWINK(g);
			p.tw0 = p.twinkle > 0 ? random[RSQGNBarrel](0, p.twinkle - 1) : 0;
		}
	}

	// a shape in a palette, by the design's weights
	int PickOpt(int g)
	{
		int o0 = RSQGN_BarrelData.D_OFS(g), on = RSQGN_BarrelData.D_NOPT(g);
		int tot = 0;
		for (int o = o0; o < o0 + on; o++) tot += RSQGN_BarrelData.O_W(o);
		int r = random[RSQGNBarrel](0, max(0, tot - 1));
		for (int o = o0; o < o0 + on; o++) { r -= RSQGN_BarrelData.O_W(o); if (r < 0) return o; }
		return o0 + on - 1;
	}
}
