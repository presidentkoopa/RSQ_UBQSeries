[en default]
// Gun Bonsai VR patch -- the melee upgrades.
// (RSQ_GLOVE_TAG / _PICKUP / _OB moved to RSQ Melee's LANGUAGE.txt with the gloves, 2026-11-01.)

RSQ_Upgrade_Haymaker_Name = "Haymaker";
RSQ_Upgrade_Haymaker_Desc = "Glove: the harder you swing, the more it hurts.";
RSQ_Upgrade_Haymaker_TT = "Punch damage @soft for the slowest punch that counts, up to @hard for a full-speed one.";
RSQ_Upgrade_OneTwo_Name = "One-Two";
RSQ_Upgrade_OneTwo_Desc = "Glove: alternate left and right to chain.";
RSQ_Upgrade_OneTwo_TT = "Each hit with the other hand within half a second adds @step, up to @max. A miss or a pause breaks the chain.";
RSQ_Upgrade_StarPunch_Name = "Star Punch";
RSQ_Upgrade_StarPunch_Desc = "Glove: clean hits bank stars; trigger + uppercut spends one.";
RSQ_Upgrade_StarPunch_TT = "Counters and steady landed punches bank stars (up to 3). Throw an uppercut with that hand's trigger held to spend one: @mult damage and the target is launched.";
RSQ_Upgrade_Counterpunch_Name = "Counterpunch";
RSQ_Upgrade_Counterpunch_Desc = "Glove: hit them as they wind up to attack.";
RSQ_Upgrade_Counterpunch_TT = "A punch that lands during an enemy's attack wind-up does @mult and staggers it for @time.";
RSQ_Upgrade_BodyBlow_Name = "Body Blow";
RSQ_Upgrade_BodyBlow_Desc = "Glove: hits below the chest wind them.";
RSQ_Upgrade_BodyBlow_TT = "A punch to the body slows everything the enemy does (about @slow) for @time.";
RSQ_Upgrade_Knockdown_Name = "Knockdown";
RSQ_Upgrade_Knockdown_Desc = "Glove: enough punishment puts them down for a count.";
RSQ_Upgrade_Knockdown_TT = "Punches worth @share of an enemy's health within two seconds put it on the floor for a count of @count.";
RSQ_Upgrade_HeavyHands_Name = "Heavy Hands";
RSQ_Upgrade_HeavyHands_Desc = "Glove: every punch lands like a brick.";
RSQ_Upgrade_HeavyHands_TT = "A landed punch freezes the enemy for @soft (@hard for a punch at half speed or more) and knocks it back @knock as far.";
RSQ_Upgrade_ReturnFire_Name = "Hadouken";
RSQ_Upgrade_ReturnFire_Desc = "Glove: punch a fireball back at whoever threw it.";
RSQ_Upgrade_ReturnFire_TT = "A punch that meets an enemy's missile sends it back at its shooter, @speed as fast, and it hits for @mult.";
RSQ_Upgrade_WallSplat_Name = "Wallflower";
RSQ_Upgrade_WallSplat_Desc = "Glove: punch them into a wall and the wall hits too.";
RSQ_Upgrade_WallSplat_TT = "An enemy your punch knocks into a wall takes @dmg (up to @max for a hard slam), bounces off and reels for @time.";

// THE FISTS TREE, new nodes (GBOVR_TREES.md 4.1; up_fists.zs). A. Power.
RSQ_Upgrade_Uppercut_Name = "Uppercut";
RSQ_Upgrade_Uppercut_Desc = "Glove: a rising punch lifts them off their feet.";
RSQ_Upgrade_Uppercut_TT = "Until this is learned a rising punch lands as a jab. An uppercut lifts what it hits: a half-speed one throws an imp about @high up.";
RSQ_Upgrade_Launcher_Name = "Launcher";
RSQ_Upgrade_Launcher_Desc = "Glove: what you uppercut stays helpless until it lands.";
RSQ_Upgrade_Launcher_TT = "A launched enemy hangs in pain for the whole flight and staggers @time when it lands. Launches go higher: a half-speed one about @high.";
RSQ_Upgrade_Juggle_Name = "Juggle";
RSQ_Upgrade_Juggle_Desc = "Glove: keep them in the air.";
RSQ_Upgrade_Juggle_TT = "Punch an enemy you launched while it is still in the air, within @time: @mult damage, and it goes up again.";
RSQ_Upgrade_Meteor_Name = "Meteor";
RSQ_Upgrade_Meteor_Desc = "Glove: what goes up comes down on someone.";
RSQ_Upgrade_Meteor_TT = "An enemy you launched that falls onto another hurts them both for @dmg, plus how fast it was falling.";
RSQ_Upgrade_GroundPound_Name = "Ground Pound";
RSQ_Upgrade_GroundPound_Desc = "Glove: both fists down together shake the floor.";
RSQ_Upgrade_GroundPound_TT = "Swing both fists down hard together: a shockwave @radius round you hits for @dmg. With Knockdown, enemies in it go down for a count of 2. Needs RSQ Gestures.";
RSQ_Upgrade_ClearOut_Name = "Clear Out";
RSQ_Upgrade_ClearOut_Desc = "Glove: two palms shove everything back.";
RSQ_Upgrade_ClearOut_TT = "Thrust both palms forward together: everything in front of you within @range is shoved back hard, takes @dmg and staggers. Needs RSQ Gestures.";
// B. Elemental (one element per glove)
RSQ_Upgrade_ExplosiveFist_Name = "Explosive Fist";
RSQ_Upgrade_ExplosiveFist_Desc = "Glove: hard punches blow up. One element per glove.";
RSQ_Upgrade_ExplosiveFist_TT = "A punch at half speed or more blasts everything within @radius of the hit for @dmg (never you). Under the Berserk the blast is twice as wide. Learning it closes the other elements on this glove.";
RSQ_Upgrade_FrostFist_Name = "Frost Fist";
RSQ_Upgrade_FrostFist_Desc = "Glove: freeze them, then shatter them. One element per glove.";
RSQ_Upgrade_FrostFist_TT = "A punch freezes the enemy solid for @time. Punch a frozen enemy to shatter the ice: @mult damage. A boss is slowed instead. Learning it closes the other elements on this glove.";
RSQ_Upgrade_ShockFist_Name = "Shock Fist";
RSQ_Upgrade_ShockFist_Desc = "Glove: the hit arcs to their friends. One element per glove.";
RSQ_Upgrade_ShockFist_TT = "A punch arcs to the @n nearest enemies within 3 m of the hit, each taking @share of the punch and a stagger. Learning it closes the other elements on this glove.";
RSQ_Upgrade_FireFist_Name = "Fire Fist";
RSQ_Upgrade_FireFist_Desc = "Glove: set them alight. One element per glove.";
RSQ_Upgrade_FireFist_TT = "A punch sets the enemy burning: @dmg every half second for @time. Punching a burning enemy flares it: @mult damage. Learning it closes the other elements on this glove.";
// C. Combos
RSQ_Upgrade_ThreeHit_Name = "Three-Hit";
RSQ_Upgrade_ThreeHit_Desc = "Glove: jab, jab, hook.";
RSQ_Upgrade_ThreeHit_TT = "Land jab, jab, hook inside a second, with either hand: the hook does @mult damage and staggers.";
RSQ_Upgrade_Dempsey_Name = "Dempsey";
RSQ_Upgrade_Dempsey_Desc = "Glove: weave hook after hook.";
RSQ_Upgrade_Dempsey_TT = "Alternate hooks, left and right, each inside 0.6 s: every hook in the run adds @step damage, and the glove is ready again after @rehit.";
RSQ_Upgrade_Finisher_Name = "Finisher";
RSQ_Upgrade_Finisher_Desc = "Glove: end the combo, end the fight.";
RSQ_Upgrade_Finisher_TT = "The last hit of a chain of three or more on a staggered enemy below @share health kills it, with a moment of slow motion (RSQ SlowMo). Needs Executioner on this glove.";
// D. Counter
RSQ_Upgrade_SwatBack_Name = "Swat Back";
RSQ_Upgrade_SwatBack_Desc = "Glove: the open palm returns to sender.";
RSQ_Upgrade_SwatBack_TT = "An open palm that swats a missile sends it back at whoever fired it, hitting for @mult.";
RSQ_Upgrade_Parry_Name = "Parry";
RSQ_Upgrade_Parry_Desc = "Guard: meet the blow and it does nothing.";
RSQ_Upgrade_Parry_TT = "Drive both guarding hands into a blow within @window of it landing: you take nothing, and the attacker is thrown back and reels for @time.";
RSQ_Upgrade_ReflectGuard_Name = "Reflect Guard";
RSQ_Upgrade_ReflectGuard_Desc = "Guard: what hits the guard goes back.";
RSQ_Upgrade_ReflectGuard_TT = "A missile that meets your raised Guard from in front flies back at its shooter, hitting for @mult. At level 3 a bullet does too.";
RSQ_Upgrade_AbsorbRelease_Name = "Absorb and Release";
RSQ_Upgrade_AbsorbRelease_Desc = "Guard: store the hits, then let them out.";
// F. Berserk
RSQ_Upgrade_Rage_Name = "Rage";
RSQ_Upgrade_Rage_Desc = "Glove: the Berserk makes everything you know stronger.";
RSQ_Upgrade_Rage_TT = "While you hold the Berserk, every other upgrade this glove has counts one level higher. Level 2: the hit-stop doubles. Level 3: knockback half again.";
RSQ_Upgrade_BloodRush_Name = "Blood Rush";
RSQ_Upgrade_BloodRush_Desc = "Glove: berserk kills armour you.";
RSQ_Upgrade_BloodRush_TT = "A fist kill while you hold the Berserk gives @n armour.";
RSQ_Upgrade_BerserkMeter_Name = "Berserk Meter";
RSQ_Upgrade_BerserkMeter_Desc = "Glove: earn a Berserk with your fists.";
RSQ_Upgrade_BerserkMeter_TT = "Every @full points of fist damage (without the Berserk) gives you a Berserk for @time, no pack needed.";
// G. Gun hand
RSQ_Upgrade_PistolWhip_Name = "Pistol Whip";
RSQ_Upgrade_PistolWhip_Desc = "Glove: crack them with the gun, then shoot.";
RSQ_Upgrade_PistolWhip_TT = "A gun-butt shove staggers @time longer, and your next shot on that enemy within 2 s does @mult damage.";
RSQ_Upgrade_RifleButt_Name = "Rifle Butt";
RSQ_Upgrade_RifleButt_Desc = "Glove: a long gun's butt puts them down.";
RSQ_Upgrade_RifleButt_TT = "A hard shove (4 m/s) with a long gun knocks an enemy down for a count of @count.";
// H. Taunt
RSQ_Upgrade_Taunt_Name = "Taunt";
RSQ_Upgrade_Taunt_Desc = "Player: come on, then.";
RSQ_Upgrade_Taunt_TT = "Throw both hands apart, empty or in fists: enemies within 10 m turn on you, and your next punch within @time does double. Level 3: those within 3 m also stagger. Needs RSQ Gestures.";
// I. Critical Hits
RSQ_Upgrade_CriticalHits_Name = "Critical Hits";
RSQ_Upgrade_CriticalHits_Desc = "Player: hit them as they wind up.";
RSQ_Upgrade_CriticalHits_TT = "A hit while an enemy winds up its attack is a critical: @mult damage and it is stunned for a second; hits on a stunned enemy do @stun. At most 3 criticals in under half a second. Level 1: melee only. Level 2: guns too.";
RSQ_Upgrade_Headshot_Name = "Headshot";
RSQ_Upgrade_Headshot_Desc = "Player: aim high.";
RSQ_Upgrade_Headshot_TT = "A hit in the top fifth of an enemy (a punch: where your fist met it) does @mult damage. Later pellets of the same blast count half.";
RSQ_Upgrade_Backstab_Name = "Backstab";
RSQ_Upgrade_Backstab_Desc = "Player: from behind, quietly.";
RSQ_Upgrade_Backstab_TT = "A melee hit from behind does @mult damage, and a kill this way makes no death cry.";
// E. Grappler (the off glove)
RSQ_Upgrade_HumanShield_Name = "Human Shield";
RSQ_Upgrade_HumanShield_Desc = "Off glove: hold them as long as you grip, facing away.";
RSQ_Upgrade_HumanShield_TT = "A Headlock lasts as long as you hold the grip (a minute at most), the monster turned to face away. Level 2: it takes the blows meant for you from its side. Level 3: those hurt it half again.";
RSQ_Upgrade_HeadlockUppercut_Name = "Headlock Uppercut";
RSQ_Upgrade_HeadlockUppercut_Desc = "Off glove: uppercut the one you hold into the air.";
RSQ_Upgrade_HeadlockUppercut_TT = "An uppercut on the monster your off hand holds lets go and launches it half again as high, for @mult damage.";
RSQ_Upgrade_HeavierHeadlock_Name = "Heavier Headlock";
RSQ_Upgrade_HeavierHeadlock_Desc = "Off glove: grab bigger things.";
RSQ_Upgrade_HeavierHeadlock_TT = "The Headlock holds monsters up to @mass in Doom's weight (Distance Grab's Iron Grip adds 100 a level).";
RSQ_Upgrade_Slam_Name = "Slam";
RSQ_Upgrade_Slam_Desc = "Off glove: drive them into the floor.";
RSQ_Upgrade_Slam_TT = "Swing your holding hand down hard: the monster is driven into the floor for @mult of a throw's blow, and everything round it staggers.";
RSQ_Upgrade_ThrowInto_Name = "Throw Into";
RSQ_Upgrade_ThrowInto_Desc = "Off glove: throw them at their friends.";
RSQ_Upgrade_ThrowInto_TT = "A monster you throw out of the Headlock hits what it flies into for @mult. Without Distance Grab the throw bends a little onto a monster ahead.";
RSQ_Upgrade_Chokehold_Name = "Chokehold";
RSQ_Upgrade_Chokehold_Desc = "Off glove: squeeze.";
RSQ_Upgrade_Chokehold_TT = "A monster in your Headlock takes @dmg every second you hold it.";
RSQ_Upgrade_AbsorbRelease_TT = "What your Guard takes builds a charge, up to @cap, draining slowly. Throw both hands apart to release it: everything within @radius takes the charge and is thrown back. Needs RSQ Gestures.";

RSQ_Upgrade_Lunge_Name = "Lunge";
RSQ_Upgrade_Lunge_Desc = "Melee: step into the blow.";
RSQ_Upgrade_Lunge_TT = "Melee damage @per for every metre per second your head is travelling, up to @max.";
RSQ_Upgrade_Executioner_Name = "Executioner";
RSQ_Upgrade_Executioner_Desc = "Melee: a staggered enemy near death dies to one hit.";
RSQ_Upgrade_Executioner_TT = "Any melee hit kills a staggered enemy below @share health.";
RSQ_Upgrade_Adrenaline_Name = "Adrenaline";
RSQ_Upgrade_Adrenaline_Desc = "Melee: big moments slow the world (RSQ SlowMo).";
RSQ_Upgrade_Adrenaline_TT = "Three melee kills in three seconds, a big monster, or an execution fires a @time slow-motion pulse. Needs RSQ SlowMo.";

RSQ_Upgrade_Momentum_Name = "Elegant Weapon";
RSQ_Upgrade_Momentum_Desc = "Saber: keep the blade moving and it cuts harder.";
RSQ_Upgrade_Momentum_TT = "@step damage for every half second the blade keeps moving, up to @max. It resets when the blade stops.";
RSQ_Upgrade_RiposteEdge_Name = "Aggressive Negotiations";
RSQ_Upgrade_RiposteEdge_Desc = "Saber: a block primes the next cut.";
RSQ_Upgrade_RiposteEdge_TT = "After a block or a deflect, the next cut within @time does @mult damage.";
RSQ_Upgrade_PiercingReturn_Name = "Piercing Return";
RSQ_Upgrade_PiercingReturn_Desc = "Saber: returned bolts go through bodies.";
RSQ_Upgrade_PiercingReturn_TT = "A returned bolt passes through @n bodies, hurting each, before it stops.";
RSQ_Upgrade_SaberThrow_Name = "Saber Throw";
RSQ_Upgrade_SaberThrow_Desc = "Saber: the thrown saber hunts more targets.";
RSQ_Upgrade_SaberThrow_TT = "When its route is done, the thrown saber flies on to @n more enemies near it.";
RSQ_Upgrade_ChainChoke_Name = "Chain Choke";
RSQ_Upgrade_ChainChoke_Desc = "Saber: a choke kill jumps the grip.";
RSQ_Upgrade_ChainChoke_TT = "When a Force choke kills, the grip jumps to the nearest enemy within @r while you hold it.";
RSQ_Upgrade_DualHarmony_Name = "Assault";
RSQ_Upgrade_DualHarmony_Desc = "Saber: alternate the two blades to stack damage.";
RSQ_Upgrade_DualHarmony_TT = "Each cut with the other saber within three quarters of a second adds @step, up to @max.";
// THE SABER TREE (GBOVR_TREES.md 4.2), new nodes
RSQ_Upgrade_BattleMeditation_Name = "Battle Meditation";
RSQ_Upgrade_BattleMeditation_Desc = "Saber: mark more enemies for a throw.";
RSQ_Upgrade_BattleMeditation_TT = "A throw marks up to @n enemies (one at first).";
RSQ_Upgrade_SaberBarrage_Name = "Saber Barrage";
RSQ_Upgrade_SaberBarrage_Desc = "Saber: the thrown blade cuts on its way home.";
RSQ_Upgrade_SaberBarrage_TT = "Your thrown saber cuts what it passes as it comes back to your hand, for @share of a cut.";
RSQ_Upgrade_ReturningBlade_Name = "Returning Blade";
RSQ_Upgrade_ReturningBlade_Desc = "Saber: the thrown blade goes round again.";
RSQ_Upgrade_ReturningBlade_TT = "Your thrown saber flies its marks @n more time(s) before it comes home.";
RSQ_Upgrade_StrikeTrue_Name = "Strike True";
RSQ_Upgrade_StrikeTrue_Desc = "Saber: each cut stops them for a beat.";
RSQ_Upgrade_StrikeTrue_TT = "What your blade cuts freezes for @time.";
RSQ_Upgrade_KyberAttunement_Name = "Kyber Attunement";
RSQ_Upgrade_KyberAttunement_Desc = "Saber: a longer blade.";
RSQ_Upgrade_KyberAttunement_TT = "Your blade is at least @cm long (the Blade Length setting is the shortest it gets).";
RSQ_Upgrade_HighGround_Name = "High Ground";
RSQ_Upgrade_HighGround_Desc = "Saber: finish them in pieces.";
RSQ_Upgrade_HighGround_TT = "A cut on an enemy below @share health cuts it apart. Not bosses.";
RSQ_Upgrade_PointTaken_Name = "Point Taken";
RSQ_Upgrade_PointTaken_Desc = "Saber: lunge into the stab.";
RSQ_Upgrade_PointTaken_TT = "A stab with your body moving forward does @mult damage.";
RSQ_Upgrade_RunThrough_Name = "Run Through";
RSQ_Upgrade_RunThrough_Desc = "Saber: hold them on the blade.";
RSQ_Upgrade_RunThrough_TT = "A stabbed enemy is held on your blade for @time. Pull the blade out of one that is nearly dead and it dies.";
RSQ_Upgrade_ReturnToSender_Name = "Return to Sender";
RSQ_Upgrade_ReturnToSender_Desc = "Saber: turned shots go home.";
RSQ_Upgrade_ReturnToSender_TT = "A shot your blade turns flies back at whoever fired it: @cone.";
RSQ_Upgrade_GuidedReturn_Name = "Guided Return";
RSQ_Upgrade_GuidedReturn_Desc = "Saber: send turned shots where you choose.";
RSQ_Upgrade_GuidedReturn_TT = "A shot your blade turns flies where you look, helped onto the enemy nearest your gaze. Level 2: where your off hand points.";
RSQ_Upgrade_Precognition_Name = "Precognition";
RSQ_Upgrade_Precognition_Desc = "Saber: parry sooner, block wider.";
RSQ_Upgrade_Precognition_TT = "A swing at @speed of the usual speed parries, and the blade blocks @width units either side of its line.";
RSQ_Upgrade_TwoSabers_Name = "Two Sabers";
RSQ_Upgrade_TwoSabers_Desc = "Saber: a second saber for the off hand.";
RSQ_Upgrade_TwoSabers_TT = "You carry a second saber in your off hand (the Start With Dual Sabers setting can still switch it off).";
RSQ_Upgrade_DoubleBladed_Name = "Double-Bladed";
RSQ_Upgrade_DoubleBladed_Desc = "Saber: light the second blade.";
RSQ_Upgrade_DoubleBladed_TT = "Your saber's second blade can be lit. Level 2: it cuts on the backswing. Level 3: twirling it cuts all round you.";
RSQ_Upgrade_CrossGuard_Name = "Cross Guard";
RSQ_Upgrade_CrossGuard_Desc = "Saber: the crossed blades turn what they stop.";
RSQ_Upgrade_CrossGuard_TT = "What your crossed blades stop goes straight back. Level 2: at whoever fired it. Level 3: opening the X shoves everything in front of you away.";
RSQ_Upgrade_Clash_Name = "Clash";
RSQ_Upgrade_Clash_Desc = "Saber: crossing blades shakes the room.";
RSQ_Upgrade_Clash_TT = "Bringing your two blades together releases a shockwave that staggers everything within @radius.";
RSQ_Upgrade_ForceSensitive_Name = "Force Sensitive";
RSQ_Upgrade_ForceSensitive_Desc = "Saber: the Force is with you.";
RSQ_Upgrade_ForceSensitive_TT = "Your off hand's Force gestures work: push, pull, grip, jump. Each power grows as you learn it.";
RSQ_Upgrade_ForceSpeed_Name = "Force Speed";
RSQ_Upgrade_ForceSpeed_Desc = "Saber: still your mind, slow the world.";
RSQ_Upgrade_ForceSpeed_TT = "Hold the Force up and your hand still for a second with nothing to grip: the world slows for @time (RSQ SlowMo).";
RSQ_Upgrade_ForceLightning_Name = "Force Lightning";
RSQ_Upgrade_ForceLightning_Desc = "Saber: unlimited power.";
RSQ_Upgrade_ForceLightning_TT = "Turn your Force hand palm-down and aim it at an enemy for half a second, then flick: lightning pours into it for a second, @dmg a tic, chaining to @n enemies.";
RSQ_Upgrade_ForcePush_Name = "Force Push";
RSQ_Upgrade_ForcePush_Desc = "Saber: a stronger push; a wider cone; then a shockwave.";
RSQ_Upgrade_ForcePush_TT = "Push at @pwr. Level 2 opens the cone; level 3 adds a shockwave all round you.";
RSQ_Upgrade_ForcePull_Name = "Force Pull";
RSQ_Upgrade_ForcePull_Desc = "Saber: a stronger pull that stuns, then disarms.";
RSQ_Upgrade_ForcePull_TT = "Pull at @pwr. Level 2 stuns what arrives; level 3 yanks its weapon away (no ranged attacks).";
RSQ_Upgrade_ForceChoke_Name = "Force Grip";
RSQ_Upgrade_ForceChoke_Desc = "Saber: a choke that lifts, crushes, then holds several.";
RSQ_Upgrade_ForceChoke_TT = "Choke at @pwr. Level 2 lifts and crushes harder the longer you hold; level 3 and up holds @n.";
RSQ_Upgrade_ForceJump_Name = "Force Jump";
RSQ_Upgrade_ForceJump_Desc = "Saber: a higher jump; then a slam when you land.";
RSQ_Upgrade_ForceJump_TT = "Jump at @pwr. Level 2 and up: landing from a Force jump slams everything around you.";

RSQ_Upgrade_Ricochet_Name = "Ricochet";
RSQ_Upgrade_Ricochet_Desc = "ShieldSaw: the disc bounces off walls into new targets.";
RSQ_Upgrade_Ricochet_TT = "A thrown disc that hits a wall turns toward a new enemy instead of coming home, @n times.";
RSQ_Upgrade_MeatGrinder_Name = "Meat Grinder";
RSQ_Upgrade_MeatGrinder_Desc = "ShieldSaw: an embedded kill frees the disc at full speed.";
RSQ_Upgrade_MeatGrinder_TT = "Kill what the disc is stuck in and it flies straight to the next lock at full speed. Grind damage @grind.";
RSQ_Upgrade_HuntersReturn_Name = "Hunter's Return";
RSQ_Upgrade_HuntersReturn_Desc = "ShieldSaw: the way home swerves through enemies.";
RSQ_Upgrade_HuntersReturn_TT = "On its way back the disc swerves into up to @n enemies within @r of its path.";
RSQ_Upgrade_Bulwark_Name = "Bulwark";
RSQ_Upgrade_Bulwark_Desc = "ShieldSaw: perfect blocks are easier.";
RSQ_Upgrade_Bulwark_TT = "A perfect block needs only @need of the usual plate speed.";
RSQ_Upgrade_Rebound_Name = "Rebound";
RSQ_Upgrade_Rebound_Desc = "ShieldSaw: turned shots hit harder.";
RSQ_Upgrade_Rebound_TT = "Shots the shield turns or sends back do @mult damage.";
RSQ_Upgrade_BatteringRam_Name = "Battering Ram";
RSQ_Upgrade_BatteringRam_Desc = "ShieldSaw: bash them into each other.";
RSQ_Upgrade_BatteringRam_TT = "A bashed enemy flies further, and whatever it hits takes @dmg damage, and so does it.";

RSQ_Upgrade_Broadening_Name = "Broadening";
RSQ_Upgrade_Broadening_Desc = "ShieldSaw: the blocking plate grows.";
RSQ_Upgrade_Broadening_TT = "The plate that blocks, bashes and grinds is @r of its size (double at level 5). Replaces the ShieldSaw's Double Block Radius option while this patch is loaded.";
RSQ_Upgrade_Lockstep_Name = "Lockstep";
RSQ_Upgrade_Lockstep_Desc = "ShieldSaw: lock on to more targets.";
RSQ_Upgrade_Lockstep_TT = "The thrown disc locks on to @n targets. Without Lockstep it locks on to one; level 4 reaches the ShieldSaw's Locks setting.";
RSQ_Upgrade_WallBounces_Name = "Wall Bounces";
RSQ_Upgrade_WallBounces_Desc = "ShieldSaw: the disc bounces off more walls.";
RSQ_Upgrade_WallBounces_TT = "A thrown disc bounces off @n walls on its way to its marks before it comes home.";
RSQ_Upgrade_Cleaver_Name = "Cleaver";
RSQ_Upgrade_Cleaver_Desc = "ShieldSaw: the disc cuts through tougher monsters.";
RSQ_Upgrade_WallSlam_Name = "Wall Slam";
RSQ_Upgrade_WallSlam_Desc = "ShieldSaw: bash them into walls harder.";
RSQ_Upgrade_WallSlam_TT = "A body you bash into a wall takes @mult damage and is stunned @time longer.";
RSQ_Upgrade_BashHitStop_Name = "Strike True";
RSQ_Upgrade_BashHitStop_Desc = "ShieldSaw: a bash stops them dead.";
RSQ_Upgrade_BashHitStop_TT = "A bash freezes the monster for @n tics. Replaces the Hit-Stop option.";
RSQ_Upgrade_Charge_Name = "Charge";
RSQ_Upgrade_Charge_Desc = "ShieldSaw: bash on the move to hit a crowd.";
RSQ_Upgrade_Charge_TT = "Bash while moving forward at 2 m/s or more and everything in a wedge @m ahead is bashed too.";
RSQ_Upgrade_ShieldSize_Name = "Shield Size";
RSQ_Upgrade_ShieldSize_Desc = "ShieldSaw: a bigger shield.";
RSQ_Upgrade_ShieldSize_TT = "The shield grows to @size: what you see, what blocks and what bashes. The menu's Shield Size is the smallest it gets.";
RSQ_Upgrade_ShieldDash_Name = "Shield Dash";
RSQ_Upgrade_ShieldDash_Desc = "ShieldSaw: thrust the shield to dash in and bash.";
RSQ_Upgrade_ShieldDash_TT = "Thrust the shield forward hard with the stick pushed forward: you dash @m the way it faces and land a bash. Two seconds between dashes.";
RSQ_Upgrade_HungryBlades_Name = "Hungry Blades";
RSQ_Upgrade_HungryBlades_Desc = "ShieldSaw: the blades grind harder.";
RSQ_Upgrade_HungryBlades_TT = "A grind hit does @g; a disc stuck in a monster grinds @e a tic.";
RSQ_Upgrade_RevShield_Name = "Rev Shield";
RSQ_Upgrade_RevShield_Desc = "ShieldSaw: a revving shield grinds what claws it.";
RSQ_Upgrade_RevShield_TT = "Hold the shield up while it revs and whatever claws at it is ground. Level 2: it turns a blocked shot back even with the Deflect option off.";
RSQ_Upgrade_BuzzsawReturn_Name = "Buzzsaw Return";
RSQ_Upgrade_BuzzsawReturn_Desc = "ShieldSaw: the returning disc grinds through them.";
RSQ_Upgrade_BuzzsawReturn_TT = "The disc on its way home grinds everything it passes for @share of a grind hit.";
RSQ_Upgrade_Spartan_Name = "Spartan";
RSQ_Upgrade_Spartan_Desc = "ShieldSaw and saber: the blade over the shield parries.";
RSQ_Upgrade_Spartan_TT = "Rest your lit saber across the shield and every shot the shield turns goes straight back at whoever fired it. Level 2: a bash in that stance cuts as well.";
RSQ_Upgrade_Bandolier_Name = "Bandolier";
RSQ_Upgrade_Bandolier_Desc = "Grenade: carry more.";
RSQ_Upgrade_Bandolier_TT = "Carry @n grenades (a backpack doubles it).";
RSQ_Upgrade_Scavenger_Name = "Scavenger";
RSQ_Upgrade_Scavenger_Desc = "Grenade: find more lying around.";
RSQ_Upgrade_Scavenger_TT = "Up to @s grenades and @p packs are scattered through each map. Level 3: one Kill Rewards ammo bit in four is a grenade.";
RSQ_Upgrade_StrongArm_Name = "Strong Arm";
RSQ_Upgrade_StrongArm_Desc = "Grenade: throw it further.";
RSQ_Upgrade_StrongArm_TT = "Your throw leaves at @mult of your hand's speed.";
RSQ_Upgrade_FlatArc_Name = "Flat Arc";
RSQ_Upgrade_FlatArc_Desc = "Grenade: a flatter, longer throw.";
RSQ_Upgrade_FlatArc_TT = "The grenade arcs less and falls slower, so it flies flatter and further.";
RSQ_Upgrade_Bounce_Name = "Bounce";
RSQ_Upgrade_Bounce_Desc = "Grenade: bank shots off walls.";
RSQ_Upgrade_Bounce_TT = "A grenade keeps @k of its speed off a wall: bank it round corners.";
RSQ_Upgrade_CookSense_Name = "Cook Sense";
RSQ_Upgrade_CookSense_Desc = "Grenade: feel the fuse.";
RSQ_Upgrade_CookSense_TT = "A tick in the hand at every second of a cooking fuse. Level 2: the flash runs amber, then red for the last half. Level 3 (with RSQ Gun Cards): the grenade's card counts the seconds down.";
RSQ_Upgrade_ShortFuse_Name = "Short Fuse";
RSQ_Upgrade_ShortFuse_Desc = "Grenade: a quicker fuse.";
RSQ_Upgrade_ShortFuse_TT = "The fuse burns for @s.";
RSQ_Upgrade_BigBang_Name = "Big Bang";
RSQ_Upgrade_BigBang_Desc = "Grenade: a wider blast.";
RSQ_Upgrade_BigBang_TT = "The blast reaches @r further.";
RSQ_Upgrade_Frag_Name = "Frag";
RSQ_Upgrade_Frag_Desc = "Grenade: a harder blast.";
RSQ_Upgrade_Frag_TT = "The blast does @d damage.";
RSQ_Upgrade_Cluster_Name = "Cluster";
RSQ_Upgrade_Cluster_Desc = "Grenade: the blast throws bomblets.";
RSQ_Upgrade_Cluster_TT = "The blast scatters @n small bomblets 2-4 m around it, each going off a second later.";
RSQ_Upgrade_Sticky_Name = "Sticky";
RSQ_Upgrade_Sticky_Desc = "Grenade: it sticks to what it hits.";
RSQ_Upgrade_Sticky_TT = "The grenade sticks to the first monster it touches and goes off there. Level 2: it sticks to walls too.";
RSQ_Upgrade_Teeth_Name = "Teeth";
RSQ_Upgrade_Teeth_Desc = "Grenade: pull the pin with your teeth.";
RSQ_Upgrade_Teeth_TT = "A pin pulled with your teeth counts for style. Level 2 and up: the throw after it does @mult damage.";
RSQ_Upgrade_Skeet_Name = "Skeet";
RSQ_Upgrade_Skeet_Desc = "Grenade: shoot it out of the air.";
RSQ_Upgrade_Skeet_TT = "Shoot your own grenade while it flies and it bursts right there at @mult damage.";
RSQ_Upgrade_SkeetWindow_Name = "Skeet Window";
RSQ_Upgrade_SkeetWindow_Desc = "Grenade: time slows to line up the shot.";
RSQ_Upgrade_SkeetWindow_TT = "Just after a throw time slows for @time and the grenade glows: a window to shoot it (needs RSQ SlowMo; RSQ Grenade's menu can turn the slow motion off).";
RSQ_Upgrade_SlowBurn_Name = "Slow Burn";
RSQ_Upgrade_SlowBurn_Desc = "Grenade: cooked kills keep time slow.";
RSQ_Upgrade_SlowBurn_TT = "A kill with a grenade you cooked for a second or more, while time is slowed, keeps it slowed for @time more (needs RSQ SlowMo).";
RSQ_Upgrade_Impact_Name = "Impact Grenade";
RSQ_Upgrade_Impact_Desc = "Grenade kind: bursts on contact.";
RSQ_Upgrade_Impact_TT = "A grenade kind (the holding hand's alt trigger picks it; orange): it bursts on the first thing it touches. Level 2: +15% damage.";
RSQ_Upgrade_Incendiary_Name = "Incendiary Grenade";
RSQ_Upgrade_Incendiary_Desc = "Grenade kind: leaves fire behind.";
RSQ_Upgrade_Incendiary_TT = "A grenade kind (amber): the blast leaves fire over its whole radius for @s s, burning what stands in it.";
RSQ_Upgrade_Freeze_Name = "Freeze Grenade";
RSQ_Upgrade_Freeze_Desc = "Grenade kind: freezes them solid.";
RSQ_Upgrade_Freeze_TT = "A grenade kind (sky blue): no blast damage; monsters inside freeze solid for @s s (bosses are slowed). A hard hit on a frozen one shatters it for double.";
RSQ_Upgrade_Stun_Name = "Stun Grenade";
RSQ_Upgrade_Stun_Desc = "Grenade kind: staggers what it hits.";
RSQ_Upgrade_Stun_TT = "A grenade kind (violet): half the blast's damage, and monsters inside are staggered for @s s.";
RSQ_Upgrade_Smoke_Name = "Smoke Grenade";
RSQ_Upgrade_Smoke_Desc = "Grenade kind: a cloud they cannot see through.";
RSQ_Upgrade_Smoke_TT = "A grenade kind (grey): a cloud @m m wide for @s s; monsters inside it, or looking through it, lose sight of their target.";
RSQ_Upgrade_Flash_Name = "Flash Grenade";
RSQ_Upgrade_Flash_Desc = "Grenade kind: blinds and stuns.";
RSQ_Upgrade_Flash_TT = "A grenade kind (white): no damage; monsters inside are stunned for @s s and lose their target.";
RSQ_Upgrade_Charm_Name = "Charm Grenade";
RSQ_Upgrade_Charm_Desc = "Grenade kind: they fight for you.";
RSQ_Upgrade_Charm_TT = "A grenade kind (pink): monsters inside fight on your side for @s s. Bosses are immune.";
RSQ_Upgrade_Infight_Name = "Infight Grenade";
RSQ_Upgrade_Infight_Desc = "Grenade kind: they turn on each other.";
RSQ_Upgrade_Infight_TT = "A grenade kind (green): monsters inside turn on the nearest monster for @s s. Bosses are immune.";
RSQ_Upgrade_Grapple_Name = "Grapple";
RSQ_Upgrade_Grapple_Desc = "Unlock the grappling hook.";
RSQ_Upgrade_Grapple_TT = "The grappling hook fires. (Without Gun Bonsai VR it always does.)";
RSQ_Upgrade_SwingMomentum_Name = "Momentum";
RSQ_Upgrade_SwingMomentum_Desc = "Grapple: swing on the rope and keep your speed.";
RSQ_Upgrade_SwingMomentum_TT = "The rope becomes a swing: hang, pump with the stick, and keep your speed when you let go or land. (RSQ Grapple's Swing and Momentum option.)";
RSQ_Upgrade_ZipKick_Name = "Zip Kick";
RSQ_Upgrade_ZipKick_Desc = "Grapple: fly into them feet first.";
RSQ_Upgrade_ZipKick_TT = "Arrive on a monster by the rope at 3 m/s or more and it takes @dmg, more the faster you come, and is knocked on.";
RSQ_Upgrade_Scorpion_Name = "Scorpion";
RSQ_Upgrade_Scorpion_Desc = "Grapple: get over here -- and take this.";
RSQ_Upgrade_Scorpion_TT = "A monster the hook brings to you is punched by your empty fist at full power, @mult, as a counter (needs RSQ Melee).";
RSQ_Upgrade_TwinLines_Name = "Twin Lines";
RSQ_Upgrade_TwinLines_Desc = "Grapple: a rope from each hand.";
RSQ_Upgrade_TwinLines_TT = "Hook a wall with each hand at once and hang between them; hold one's reel to pull toward it. Level 2: let one go and you are flung along the other.";
RSQ_Upgrade_BackPlate_Name = "Back Plate";
RSQ_Upgrade_BackPlate_Desc = "ShieldSaw: the shield on your back blocks.";
RSQ_Upgrade_BackPlate_TT = "The ShieldSaw on your back blocks what hits it. Level 2: it turns shots back as well. (Replaces the Block While Holstered option.)";
RSQ_Upgrade_ShieldWall_Name = "Shield Wall";
RSQ_Upgrade_ShieldWall_Desc = "ShieldSaw: a perfect block slows time.";
RSQ_Upgrade_ShieldWall_TT = "A perfect block slows time for @time (needs RSQ SlowMo). Replaces the Perfect-Block Slow-Mo option.";
RSQ_Upgrade_Reflect_Name = "Reflect";
RSQ_Upgrade_Reflect_Desc = "ShieldSaw: returned bullets hit harder.";
RSQ_Upgrade_Reflect_TT = "A bullet the shield stops and sends back does @mult damage.";
RSQ_Upgrade_Cleaver_TT = "The disc cuts in two anything of @cut health or less, and sticks in and grinds anything of @grind or less (Brutal Doom's tiers rise the same).";
RSQ_Upgrade_Deflector_Name = "Deflector";
RSQ_Upgrade_Deflector_Desc = "Saber: bolts you send back hit harder.";
RSQ_Upgrade_Deflector_TT = "A bolt the saber deflects or returns does @mult damage.";
RSQ_Upgrade_LongArm_Name = "Long Arm";
RSQ_Upgrade_LongArm_Desc = "Distance Grab: reach further.";
RSQ_Upgrade_LongArm_TT = "The grab reaches @r as far.";
RSQ_Upgrade_IronGrip_Name = "Iron Grip";
RSQ_Upgrade_IronGrip_Desc = "Distance Grab: heavy things come easier.";
RSQ_Upgrade_IronGrip_TT = "Pull strength on heavy things @kg; carried weight slows you as if it were @burden lighter.";
RSQ_Upgrade_HeavyHitter_Name = "Heavy Hitter";
RSQ_Upgrade_HeavyHitter_Desc = "Distance Grab: throws hit harder.";
RSQ_Upgrade_HeavyHitter_TT = "A thrown object does @mult damage, and heavy things leave your hand faster.";
RSQ_Upgrade_AirCatch_Name = "Air Catch";
RSQ_Upgrade_AirCatch_Desc = "Distance Grab: catch it out of the air.";
RSQ_Upgrade_AirCatch_TT = "The catch window is @r as wide, and a thing caught mid-air and thrown again does @mult damage.";
RSQ_Upgrade_PowderKeg_Name = "Powder Keg";
RSQ_Upgrade_PowderKeg_Desc = "Distance Grab: thrown barrels blow harder.";
RSQ_Upgrade_PowderKeg_TT = "The blast of a barrel a throw set off, and the blasts it sets off, do @mult damage.";
RSQ_Upgrade_QuickDraw_Name = "Quick Draw";
RSQ_Upgrade_QuickDraw_Desc = "Tactical Rig: a fresh draw hits harder.";
RSQ_Upgrade_QuickDraw_TT = "For @time after you draw a gun from a holster, it does @mult damage.";
RSQ_Upgrade_PairDraw_Name = "Pair Draw";
RSQ_Upgrade_PairDraw_Desc = "Tactical Rig: draw two, hit with both.";
RSQ_Upgrade_PairDraw_TT = "Draw a gun as a pair and both hands do @mult damage for @time.";
RSQ_Upgrade_Showdown_Name = "Showdown";
RSQ_Upgrade_Showdown_Desc = "Tactical Rig + SlowMo: a quick-draw kill slows time.";
RSQ_Upgrade_Showdown_TT = "A kill within 2 seconds of a holster draw, with that gun, slows the world for @time.";
RSQ_Upgrade_Marksman_Name = "Marksman";
RSQ_Upgrade_Marksman_Desc = "SlowMo: hit harder in slow motion.";
RSQ_Upgrade_Marksman_TT = "While the world is slowed you do @mult damage.";
RSQ_Upgrade_Dodger_Name = "Dodger";
RSQ_Upgrade_Dodger_Desc = "SlowMo: take less in slow motion.";
RSQ_Upgrade_Dodger_TT = "While the world is slowed you take @cut less damage.";
RSQ_Upgrade_SecondWind_Name = "Second Wind";
RSQ_Upgrade_SecondWind_Desc = "SlowMo: kills charge adrenaline.";
RSQ_Upgrade_SecondWind_TT = "Every kill adds @n to the adrenaline meter (when SlowMo's meter is on).";
RSQ_Upgrade_TimeDilation_Name = "Time Dilation";
RSQ_Upgrade_TimeDilation_Desc = "SlowMo: kills in slow motion keep it going.";
RSQ_Upgrade_TimeDilation_TT = "A kill while the world is slowed holds it slowed for @time more, and gives back a little adrenaline.";
RSQ_Upgrade_Akimbo_Name = "Akimbo";
RSQ_Upgrade_Akimbo_Desc = "Two hands: fire both at once.";
RSQ_Upgrade_Akimbo_TT = "While both hands' guns are firing, they do @mult damage.";
RSQ_Upgrade_Crossfire_Name = "Crossfire";
RSQ_Upgrade_Crossfire_Desc = "Two hands: one gun on each target.";
RSQ_Upgrade_Crossfire_TT = "A hit on something other than what your other hand just hit does @mult damage.";
RSQ_Upgrade_Alternator_Name = "Alternator";
RSQ_Upgrade_Alternator_Desc = "Two hands: alternate the guns.";
RSQ_Upgrade_Alternator_TT = "Each hit with the other hand's gun within two thirds of a second adds @step, up to @max.";
RSQ_Upgrade_Evasion_Name = "Evasion";
RSQ_Upgrade_Evasion_Desc = "Body: keep your head moving.";
RSQ_Upgrade_Evasion_TT = "While your head moves at 1.2 m/s or more you take @cut less damage.";
RSQ_Upgrade_Guard_Name = "Guard";
RSQ_Upgrade_Guard_Desc = "Body: both hands up at your face block blows.";
RSQ_Upgrade_Guard_TT = "With both hands at your face and no gun in either, a blow from in front does only @take of its damage. A blow of @brk or more breaks the guard.";
RSQ_Upgrade_Southpaw_Name = "Southpaw";
RSQ_Upgrade_Southpaw_Desc = "Body: the off hand hits harder.";
RSQ_Upgrade_Southpaw_TT = "Whatever your off hand holds does @mult damage.";
RSQ_Upgrade_SteadyAim_Name = "Steady Aim";
RSQ_Upgrade_SteadyAim_Desc = "Body: hold your head still and shoot.";
RSQ_Upgrade_SteadyAim_TT = "A bullet fired with your head still does @mult damage.";
RSQ_Upgrade_LongLine_Name = "Long Line";
RSQ_Upgrade_LongLine_Desc = "Grapple: the claw flies further.";
RSQ_Upgrade_LongLine_TT = "The claw's range is @r (@m).";
RSQ_Upgrade_FastReel_Name = "Fast Reel";
RSQ_Upgrade_FastReel_Desc = "Grapple: reel in faster.";
RSQ_Upgrade_FastReel_TT = "Reeling in, the claw's flight and a hooked monster's slide are @r faster.";
RSQ_Upgrade_HeavyHaul_Name = "Heavy Haul";
RSQ_Upgrade_HeavyHaul_Desc = "Grapple: bigger things come; bosses stagger.";
RSQ_Upgrade_HeavyHaul_TT = "The heaviest thing the hook brings or throws @kg, the biggest @size. A boss, or anything still too heavy to come, staggers for @time when the claw bites.";
RSQ_Upgrade_GetOverHere_Name = "Get Over Here";
RSQ_Upgrade_GetOverHere_Desc = "Grapple: what you pull in arrives stunned.";
RSQ_Upgrade_GetOverHere_TT = "A monster the hook brings to you is staggered for @time when it gets there.";
RSQ_Upgrade_Bowling_Name = "Bowling";
RSQ_Upgrade_Bowling_Desc = "Grapple: what you pull in bowls over what is in its way.";
RSQ_Upgrade_Bowling_TT = "A monster on its way to you strikes what stands in its path for @dmg damage (more the faster it comes), staggers it for @time and knocks it aside.";
RSQ_Upgrade_BarbedClaw_Name = "Barbed Claw";
RSQ_Upgrade_BarbedClaw_Desc = "Grapple: the claw bites and tears.";
RSQ_Upgrade_BarbedClaw_TT = "The claw's bite does @bite damage, and tearing it out of a living monster does @tear.";
RSQ_Upgrade_Slingshot_Name = "Slingshot";
RSQ_Upgrade_Slingshot_Desc = "Grapple: let go of a swing and fly further.";
RSQ_Upgrade_Slingshot_TT = "Letting go of the rope in mid-air carries you @r faster.";
RSQ_Upgrade_SteadyLine_Name = "Steady Line";
RSQ_Upgrade_SteadyLine_Desc = "Grapple: hang still to shoot.";
RSQ_Upgrade_SteadyLine_TT = "Hanging on the rope with the stick centred, the swing's air drag is @x, so it settles in about half the time. Pushing the stick still pumps it.";
RSQ_Upgrade_DoubleHook_Name = "Double Hook";
RSQ_Upgrade_DoubleHook_Desc = "Grapple: hook two and slam them together.";
RSQ_Upgrade_DoubleHook_TT = "With a monster on each hand's hook, they are dragged into each other: @dmg damage each, staggered for @time. Offered from player level 5.";

