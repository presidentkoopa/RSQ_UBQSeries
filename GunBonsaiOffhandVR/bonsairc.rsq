  RSQ_Upgrade_Haymaker RSQ_Upgrade_OneTwo RSQ_Upgrade_StarPunch
  RSQ_Upgrade_Counterpunch RSQ_Upgrade_BodyBlow RSQ_Upgrade_Knockdown
  RSQ_Upgrade_HeavyHands RSQ_Upgrade_ReturnFire RSQ_Upgrade_WallSplat RSQ_Upgrade_Guard
  RSQ_Upgrade_Lunge RSQ_Upgrade_Executioner RSQ_Upgrade_Adrenaline
  RSQ_Upgrade_Momentum RSQ_Upgrade_RiposteEdge RSQ_Upgrade_PiercingReturn
  RSQ_Upgrade_SaberThrow RSQ_Upgrade_ChainChoke RSQ_Upgrade_DualHarmony
  RSQ_Upgrade_ForcePush RSQ_Upgrade_ForcePull RSQ_Upgrade_ForceChoke RSQ_Upgrade_ForceJump
  RSQ_Upgrade_Ricochet RSQ_Upgrade_MeatGrinder RSQ_Upgrade_HuntersReturn
  RSQ_Upgrade_Bulwark RSQ_Upgrade_Rebound RSQ_Upgrade_BatteringRam
  RSQ_Upgrade_Broadening RSQ_Upgrade_Lockstep RSQ_Upgrade_Deflector
  RSQ_Upgrade_WallBounces RSQ_Upgrade_Cleaver RSQ_Upgrade_BackPlate RSQ_Upgrade_ShieldWall RSQ_Upgrade_Reflect
  RSQ_Upgrade_LongArm RSQ_Upgrade_IronGrip RSQ_Upgrade_HeavyHitter RSQ_Upgrade_AirCatch RSQ_Upgrade_PowderKeg
  RSQ_Upgrade_QuickDraw RSQ_Upgrade_PairDraw RSQ_Upgrade_Showdown
  RSQ_Upgrade_Marksman RSQ_Upgrade_Dodger RSQ_Upgrade_SecondWind RSQ_Upgrade_TimeDilation
  RSQ_Upgrade_Akimbo RSQ_Upgrade_Crossfire RSQ_Upgrade_Alternator
  RSQ_Upgrade_Evasion RSQ_Upgrade_Southpaw RSQ_Upgrade_SteadyAim
  RSQ_Upgrade_LongLine RSQ_Upgrade_FastReel RSQ_Upgrade_HeavyHaul RSQ_Upgrade_GetOverHere RSQ_Upgrade_Bowling
  RSQ_Upgrade_BarbedClaw RSQ_Upgrade_Slingshot RSQ_Upgrade_SteadyLine RSQ_Upgrade_DoubleHook
  RSQ_Upgrade_Uppercut RSQ_Upgrade_Launcher RSQ_Upgrade_Juggle RSQ_Upgrade_Meteor
  RSQ_Upgrade_GroundPound RSQ_Upgrade_ClearOut
  RSQ_Upgrade_ExplosiveFist RSQ_Upgrade_FrostFist RSQ_Upgrade_ShockFist RSQ_Upgrade_FireFist
  RSQ_Upgrade_ThreeHit RSQ_Upgrade_Dempsey RSQ_Upgrade_Finisher
  RSQ_Upgrade_SwatBack RSQ_Upgrade_Parry RSQ_Upgrade_ReflectGuard RSQ_Upgrade_AbsorbRelease
  RSQ_Upgrade_HumanShield RSQ_Upgrade_HeadlockUppercut RSQ_Upgrade_HeavierHeadlock RSQ_Upgrade_Slam
  RSQ_Upgrade_ThrowInto RSQ_Upgrade_Chokehold
  RSQ_Upgrade_Rage RSQ_Upgrade_BloodRush RSQ_Upgrade_BerserkMeter RSQ_Upgrade_PistolWhip RSQ_Upgrade_RifleButt
  RSQ_Upgrade_Taunt RSQ_Upgrade_CriticalHits RSQ_Upgrade_Headshot RSQ_Upgrade_Backstab
  RSQ_Upgrade_BattleMeditation RSQ_Upgrade_SaberBarrage RSQ_Upgrade_ReturningBlade RSQ_Upgrade_StrikeTrue
  RSQ_Upgrade_KyberAttunement RSQ_Upgrade_HighGround RSQ_Upgrade_PointTaken RSQ_Upgrade_RunThrough
  RSQ_Upgrade_ReturnToSender RSQ_Upgrade_GuidedReturn RSQ_Upgrade_Precognition
  RSQ_Upgrade_TwoSabers RSQ_Upgrade_DoubleBladed RSQ_Upgrade_CrossGuard RSQ_Upgrade_Clash
  RSQ_Upgrade_ForceSensitive RSQ_Upgrade_ForceSpeed RSQ_Upgrade_ForceLightning
;

# The gloves, the sabers and the ShieldSaw are melee weapons whatever they are seen to do: the
# ShieldSaw carries no MELEEWEAPON flag, and a saber's thrown blade and turned bolts would
# otherwise teach it that it is a projectile weapon.
type RSQ_Glove RSQ_GloveOff UBQS_Saber UBQS_SaberOff SSQ_ShieldSaw : MELEE ;

# No elemental damage and nothing that is rate of fire on these: in VR the rewards are for how
# you move.
disable RSQ_Glove RSQ_GloveOff UBQS_Saber UBQS_SaberOff SSQ_ShieldSaw :
  TFLV_Upgrade_RapidFire
  TFLV_Upgrade_IncendiaryShots TFLV_Upgrade_BurningTerror TFLV_Upgrade_Conflagration TFLV_Upgrade_InfernalKiln
  TFLV_Upgrade_PoisonShots TFLV_Upgrade_Weakness TFLV_Upgrade_Putrefaction TFLV_Upgrade_Hallucinogens
  TFLV_Upgrade_CorrosiveShots TFLV_Upgrade_AcidSpray TFLV_Upgrade_ConcentratedAcid TFLV_Upgrade_Embrittlement
  TFLV_Upgrade_ShockingInscription TFLV_Upgrade_Revivification TFLV_Upgrade_ChainLightning TFLV_Upgrade_Thunderbolt
  TFLV_Upgrade_ElementalBeam TFLV_Upgrade_ElementalBlast TFLV_Upgrade_ElementalWave
;

# RSQ Whip's weapon, when it is loaded: melee. Its hits are paid to it through the patch's claim bracket
# (Whip/zscript/rsqwp/fx.zs Hurt); without this line a crack at range could teach it that it is a projectile
# weapon. (RSQ Grenade's RSQGN_Grenade needs no type line: a thrown grenade is a projectile, as inferred.)
ifdef RSQWP_WhipWeapon {
  type RSQWP_WhipWeapon : MELEE ;
}

# SuperPunchOut's own gloves, when that pack is loaded too: the same.
ifdef SPO_Glove {
  type SPO_Glove SPO_GloveOff : MELEE ;
  disable SPO_Glove SPO_GloveOff : TFLV_Upgrade_RapidFire ;
}
