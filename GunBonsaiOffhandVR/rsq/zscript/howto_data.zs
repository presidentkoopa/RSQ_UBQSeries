		r.Push("||HOLD A WEAPON IN A HAND|||||DO:~HOLD A WEAPON IN A HAND~GET:~A GAUGE FOR THAT HAND IS DRAWN AT THE TOP OF THE VIEW, THE MAIN HAND'S ON THE RIGHT, THE OFF HAND'S ON THE LEFT: THE WEAPON'S NAME, ITS LEVEL AND XP, ITS XP BAR, YOUR PLAYER LEVEL AND PLAYER XP BAR. AN EMPTY HAND HAS NO GAUGE. THE GAUGE'S FRAME AND BARS CYCLE THROUGH COLOURS ALL THE TIME AND THE BARS AND TEXT PULSE IN BRIGHTNESS~NEEDS:~DUAL HUD: ON (DEFAULT); MAIN HUD COLOUR CYCLE AND OFF HUD COLOUR CYCLE: ON (DEFAULT); GBOVR MENUS AND HUD: ON (DEFAULT) FOR THE PULSE");
		r.Push("||HURT A MONSTER WITH A WEAPON|||||DO:~HURT A MONSTER WITH A WEAPON~GET:~THAT WEAPON GETS XP: THE DAMAGE TIMES GUN BONSAI'S DAMAGE-TO-XP SETTING, TIMES (LOG10 OF THE MONSTER'S STARTING HEALTH, MINUS 1) WHEN THAT HEALTH IS OVER 100. DAMAGE PAST ZERO HEALTH PAYS NOTHING. HURTING YOURSELF, A FRIENDLY MONSTER OR A THING THAT IS NO MONSTER PAYS NOTHING");
		r.Push("||FIRE A BULLET WEAPON FROM ONE HAND|||||DO:~FIRE A BULLET WEAPON FROM ONE HAND~GET:~EVERY HIT OF THAT SHOT PAYS THE WEAPON IN THE HAND THAT FIRED IT, EVEN WHILE THE OTHER HAND FIRES IN THE SAME TIC");
		r.Push("||FIRE A ROCKET OR ANOTHER PROJECTILE|||||DO:~FIRE A ROCKET OR ANOTHER PROJECTILE~GET:~THE SHOT IS TIED TO A WEAPON AS IT APPEARS: THE HAND NEARER TO IT (UP TO 3 POINTS), THE HAND POINTING ITS WAY (UP TO 2), THE HAND WHOSE WEAPON IS IN ITS FIRE FRAMES (2.5), THE HAND WHOSE TRIGGER IS DOWN (0.5); THE HIGHER TOTAL WINS. ITS BLAST AND ANYTHING IT SPAWNS PAY THE SAME WEAPON");
		r.Push("||HIT WITH A WEAPON THAT DEALS THE BLOW ITSELF, SUCH AS A SABER CUT|||||DO:~HIT WITH A WEAPON THAT DEALS THE BLOW ITSELF, SUCH AS A SABER CUT~GET:~THAT WEAPON IS PAID, WHICHEVER HAND HOLDS IT, AND EVEN IF IT IS IN NEITHER HAND");
		r.Push("||BURN OR POISON A MONSTER WITH GUN BONSAI'S ELEMENTAL UPGRADES FROM TWO WEAPONS|||||DO:~BURN OR POISON A MONSTER WITH GUN BONSAI'S ELEMENTAL UPGRADES FROM TWO WEAPONS~GET:~EACH TICK OF IT PAYS BOTH WEAPONS, SPLIT BY HOW MUCH EACH ONE PUT ON");
		r.Push("||SWITCH THE WEAPON IN A HAND|||||DO:~SWITCH THE WEAPON IN A HAND~GET:~THAT HAND'S GAUGE FOLLOWS. THE UPGRADES OF THE WEAPON THAT LEFT STOP AND THE NEW WEAPON'S START. A WEAPON HELD FOR THE FIRST TIME GETS A NEW RECORD AT LEVEL 0");
