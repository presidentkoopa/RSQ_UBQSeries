// #namespace TFLV;
//
// ---------------------------------------------------------------------------
// VR / OFFHAND PATCH -- replaces the stock 0.10.6 file.
//
// Stock Gun Bonsai draws one HUD for one weapon. We have two weapons, so we
// draw two HUDs: mainhand top-right, offhand top-left.
//
// Almost nothing here needed to change to make that work. The stock HUD was
// already fully parameterised -- position, scale, alpha and mirroring all
// arrive through Calibrate() -- so cloning it is a matter of calling it twice
// with a second set of anchors rather than of rewriting any drawing code. The
// only structural change is that Calibrate() now takes its geometry as
// arguments instead of reading the cvars itself.
//
// The mirror settings are picked so the two read as a matched pair. `face`
// selects a corner-specific frame texture on the numpad convention (4 = points
// left, 6 = points right), so the offhand HUD keeps GB's stock top-left look
// and the mainhand HUD is its horizontal reflection.
//
// Both HUDs carry the player XP bar. That is duplicated information, but it is
// what the frame art draws and blanking one side would mean shipping new
// textures -- which belongs to the in-world HUD work, not here.
// ---------------------------------------------------------------------------

// All values here are in texture coordinate space.
const HUD_HEIGHT = 512;
const HUD_WIDTH = 3*HUD_HEIGHT;
// Starting X coordinate and total width of XP bars.
const HUD_WXP_X = 492;
const HUD_WXP_W = 916;
const HUD_PXP_X = 491;
const HUD_PXP_W = 304;
// Text positioning.
// Northwest gravity
const HUD_TOPTEXT_X = 150;
const HUD_TOPTEXT_Y = 117;
// Southeast gravity
const HUD_BOTTEXT_X = 400;
const HUD_BOTTEXT_Y = 392;
// Southwest gravity
const HUD_INFOTEXT_X = 508;
const HUD_INFOTEXT_Y = 271;

enum TFLV_HUD_Gravity {
  HUD_GRAV_NW = 0,
  HUD_GRAV_NE = 1,
  HUD_GRAV_SW = 2,
  HUD_GRAV_SE = 3
}

enum TFLV_HUD_Mirror {
  HUD_MIRROR_H = 1,
  HUD_MIRROR_V = 2
}

class TFLV_HUD : Object ui {
  double scale, screenscale, alpha;
  uint hudx, hudy;
  uint hudw, hudh;
  uint fbw, fbh;
  uint mirror;
  // RSQ PATCH (the bars' life, RSQGB_BarLife below): which gauge is being drawn (0 main hand, 1 off hand, 3 the
  // single HUD), and the render's fraction of a tic (EventHandler.RenderOverlay sets it).
  int lifeSlot;
  double fracTic;
  RSQGB_BarLife life0, life1, life2, life3;

  // one bar-life record per gauge, made once (no allocation while drawing)
  RSQGB_BarLife Life(int slot) {
    if (slot == 0) { if (!life0) life0 = new("RSQGB_BarLife"); return life0; }
    if (slot == 1) { if (!life1) life1 = new("RSQGB_BarLife"); return life1; }
    if (slot == 2) { if (!life2) life2 = new("RSQGB_BarLife"); return life2; }
    if (!life3) life3 = new("RSQGB_BarLife");
    return life3;
  }

  // Stock entry point. Uses the stock bonsai_hud_* cvars.
  void Draw(TFLV_CurrentStats stats) {
    double x, y, sc, al; uint mi;
    [x, y, sc, al, mi] = TFLV_Settings.hud_params();
    Calibrate(x, y, sc, al, mi);
    lifeSlot = 3;
    DrawHUD(stats);
  }

  // VR PATCH: draw this hand's HUD at its own anchor.
  // 0 = mainhand (top right by default), 1 = offhand (top left).
  void DrawForHand(TFLV_CurrentStats stats, int hand) {
    CalibrateForHand(hand);
    lifeSlot = hand ? 1 : 0;
    DrawHUD(stats);
  }

  // RSQ PATCH (LegenDoom HUD, owner 11-11 15:30): DrawForHand's placement on its own, so a piece drawn under a hand's
  // gauge (rsq/ui/legendoom.zs, the gauge row) reads the very box the gauge is drawn in: hudx, hudy, hudw, hudh, fbw,
  // fbh and mirror after the call. Nothing else changed.
  void CalibrateForHand(int hand) {
    double x, y, sc, al; uint mi;
    // Scale and alpha stay shared -- two HUDs at different sizes reads as a
    // bug rather than as a choice.
    [x, y, sc, al, mi] = TFLV_Settings.hud_params();
    // Read through TFLV_Settings, not as bare identifiers: these are `user`
    // cvars, and ZScript refuses direct access to userinfo cvars from any
    // scope -- "Cannot access userinfo CVARs directly. Use GetCVar() instead."
    if (hand) {
      x = TFLV_Settings.GetDouble("bonsai_vr_hud_off_x");
      y = TFLV_Settings.GetDouble("bonsai_vr_hud_off_y");
      mi = TFLV_Settings.GetInt("bonsai_vr_hud_off_mirror");
    } else {
      x = TFLV_Settings.GetDouble("bonsai_vr_hud_main_x");
      y = TFLV_Settings.GetDouble("bonsai_vr_hud_main_y");
      mi = TFLV_Settings.GetInt("bonsai_vr_hud_main_mirror");
    }
    Calibrate(x, y, sc, al, mi);
    // RSQ PATCH (left-handed): the anchors are written for a right-hander (main hand top right).
    // A left-hander's main hand is on the left, so the pair is reflected across the screen: the
    // same place measured from the other edge, and the horizontal mirror bit flipped so the
    // corner frame still points outward. Whatever the anchor's form (fraction, pixels from the
    // right, absolute pixels), hudx is resolved by now, so one reflection covers all three.
    if (RSQ_LeftLayout() && fbw > hudw) {
      hudx = (hudx <= fbw - hudw) ? (fbw - hudw) - hudx : 0;
      mirror ^= 1;
    }
  }

  // RSQ PATCH: the single HUD's placement (Draw's), for the same reason
  void CalibrateSingle() {
    double x, y, sc, al; uint mi;
    [x, y, sc, al, mi] = TFLV_Settings.hud_params();
    Calibrate(x, y, sc, al, mi);
  }

  // RSQ PATCH (owner 11-11): where the hand gauges end, for a HUD placed under them (RSQ Score's line, asked by
  // name through RSQ_HudService, rsq/zscript/hudservice.zs). The same sums Calibrate makes: a gauge's box is
  // bonsai_hud_size of the screen's height tall, its top at (1 - size) x its Down setting. y < 0 or > 1 are pixel
  // anchors (fbh units) as in realposition. Returns the box's bottom as a fraction of the screen's height.
  // RSQ PATCH (owner 11-11): the top of a hand gauge, as a fraction of the screen's height (RSQ Score centres its line
  // between the gauges)
  static double GaugeTop(double y) {
    double sc = TFLV_Settings.GetDouble("bonsai_hud_size");
    if (sc > 1) sc = sc / 1080;
    if (sc <= 0) return 0;
    double fbh = 512 / (sc / 0.15);
    double hudh = fbh * sc;
    return realposition(fbh, hudh, y) / fbh;
  }

  static double GaugeBottom(double y) {
    double sc = TFLV_Settings.GetDouble("bonsai_hud_size");
    if (sc > 1) sc = sc / 1080;
    if (sc <= 0) return 0;
    double fbh = 512 / (sc / 0.15);
    double hudh = fbh * sc;
    return (realposition(fbh, hudh, y) + hudh) / fbh;
  }

  // rsqa_handed (RSQ_Accessibility: 1 right, 2 left) when set, else QuestZDoom's own Control Scheme.
  static clearscope bool RSQ_LeftLayout() {
    CVar h = null; { Name rsqaN = "RSQA_Menu"; class<Object> rsqaC = rsqaN; if (rsqaC) h = CVar.FindCVar("rsqa_handed"); }  // only while RSQ_Accessibility is loaded: a value left in the ini must not act on its own
    int v = h ? h.GetInt() : 0;
    if (v == 1) return false;
    if (v == 2) return true;
    let cs = CVar.FindCVar("vr_control_scheme");
    return cs && cs.GetInt() >= 10;
  }

  // at scale 1.0, the framebuffer height is 512 and the width is whatever is
  // appropriate to the screen AR based on that.
  // For a framebuffer size of 768, the font looks about right for a HUD size
  // of 0.1.
  void Calibrate(double x, double y, double sc, double al, uint mi) {
    self.scale = sc;
    self.alpha = al;
    self.mirror = mi;
    if (scale > 1) // compatibility hack for pre-0.8.6 configs
      scale = scale/1080;
    // For a framebuffer size of 768, the font looks about right for a HUD scale
    // of 0.1.
    // This means that for a size of 512 it would be about right for a scale of 0.15.
    self.fbh = 512/(scale/0.15);
    self.fbw = self.fbh*screen.GetAspectRatio();
    self.hudh = self.fbh * self.scale;
    self.hudw = 3*self.hudh;
    self.hudx = realposition(self.fbw, self.hudw, x);
    self.hudy = realposition(self.fbh, self.hudh, y);
    self.screenscale = float(self.fbh)/HUD_HEIGHT;
  }

  static uint realposition(double field_size, double obj_size, double setting) {
    if (setting >= 0.0 && setting <= 1.0) {
      return (field_size - obj_size)*setting;
    } else if (setting < 0) {
      return field_size + setting - obj_size;
    } else {
      return setting;
    }
  }

  static TextureID tex(string name) {
    return TexMan.CheckForTexture(name, TexMan.TYPE_ANY);
  }

  // Coordinates are in HUD texture coordinate space, relative to the top left
  // corner of the HUD.
  void Text(string text, uint colour, uint x, uint y, TFLV_HUD_Gravity grav) {
    let thefont = NewSmallFont;
    // Apply mirroring settings.
    if (mirror & HUD_MIRROR_H) x = HUD_WIDTH - x;
    if (mirror & HUD_MIRROR_V) y = HUD_HEIGHT - y + 10; // A bit of padding
    grav ^= mirror;

    // Convert to framebuffer coordinate space. hudx/y are already in framebuffer
    // coordinates.
    // x/y are in texture coordinates, which we need to convert based on both the
    // ratio between the texture size (1536x512) and the framebuffer size, and
    // the configured scale factor.
    x = hudx + x * scale * screenscale;
    y = hudy + y * scale * screenscale;

    // Adjust for gravity based on the as-rendered size of the text.
    switch (grav) {
      case HUD_GRAV_NW:
        // No changes needed.
        break;
      case HUD_GRAV_SE:
        x = x - thefont.StringWidth(text);
        y = y - thefont.GetHeight();
        break;
      case HUD_GRAV_NE:
        x = x - thefont.StringWidth(text);
        break;
      case HUD_GRAV_SW:
        y = y - thefont.GetHeight();
        break;
    }

    screen.DrawText(thefont, thefont.CR_WHITE, x, y, text,
      DTA_VirtualWidth, fbw, DTA_VirtualHeight, fbh, DTA_KeepRatio, true,
      DTA_Color, colour, DTA_Alpha, alpha);
  }

  // RSQ PATCH (owner 11-13: "it would be nice to see GBOVR text like the weapon name and the x/y xp numerals get the kind
  // of life our SCORE word has"): the same text, each letter its bar's breath (RSQGB_BarLife.Tint) a step on from the last,
  // as RS Score's "Score:" word with Letters on Wave (55 degrees a letter). Kicks and flares light the whole line, as they
  // light the bar. Photosensitive Mode: Tint gives the steady colour, so the line is still.
  void TextLive(string text, uint colour, uint x, uint y, TFLV_HUD_Gravity grav, RSQGB_BarLife lf, double frac, double phase,
                double kick, double flare, double t, int cb, bool ready, bool cyc) {
    let thefont = NewSmallFont;
    // Apply mirroring settings.
    if (mirror & HUD_MIRROR_H) x = HUD_WIDTH - x;
    if (mirror & HUD_MIRROR_V) y = HUD_HEIGHT - y + 10; // A bit of padding
    grav ^= mirror;

    // Convert to framebuffer coordinate space. hudx/y are already in framebuffer
    // coordinates.
    // x/y are in texture coordinates, which we need to convert based on both the
    // ratio between the texture size (1536x512) and the framebuffer size, and
    // the configured scale factor.
    x = hudx + x * scale * screenscale;
    y = hudy + y * scale * screenscale;

    // Adjust for gravity based on the as-rendered size of the text.
    switch (grav) {
      case HUD_GRAV_NW:
        // No changes needed.
        break;
      case HUD_GRAV_SE:
        x = x - thefont.StringWidth(text);
        y = y - thefont.GetHeight();
        break;
      case HUD_GRAV_NE:
        x = x - thefont.StringWidth(text);
        break;
      case HUD_GRAV_SW:
        y = y - thefont.GetHeight();
        break;
    }

    double lx = x;
    int n = text.CodePointCount();
    for (int ci = 0, pos = 0; ci < n; ci++) {
      int ch; [ch, pos] = text.GetNextCodePoint(pos);
      string one = string.Format("%c", ch);
      uint c = lf.Tint(colour, frac, phase + 55.0 * ci, kick, flare, t, cb, ready, cyc);
      screen.DrawText(thefont, thefont.CR_WHITE, lx, y, one,
        DTA_VirtualWidth, fbw, DTA_VirtualHeight, fbh, DTA_KeepRatio, true,
        DTA_Color, c, DTA_Alpha, alpha);
      lx += thefont.StringWidth(one);
    }
  }


  // Draw a progress bar overlay using the given texture and colour, starting at
  // texture coordinate tx and with a maximum width of tw.
  void DrawProgressBar(TextureID texture, uint colour, double progress, uint tx, uint tw) {
    // VR PATCH (2026-11-03, the owner: bars "do not fill in vr"). Stock Gun Bonsai clipped the bar with
    // DTA_ClipLeft/ClipRight at a SCREEN x. QuestZDoom turns a clip into a GL scissor box in flat window pixels
    // (v_2ddrawer.cpp:507-512, hw_draw2d.cpp:141-153), but in VR the HUD's quads go through the HUD projection
    // (gl_openvr.cpp:986-1046 getHUDProjection, vr_hud_scale/vr_hud_distance), so the box misses the bar and cuts the
    // fill away. Here the bar is cropped from the source instead (DTA_WindowLeftF/RightF, in texels), which needs no
    // scissor. The edge is stock Gun Bonsai's own screen column (the same uint maths, kept to the pixel), turned back
    // into texels, so the flat look does not change.
    uint clip_at;
    if (mirror & HUD_MIRROR_H) {
      clip_at = hudx + HUD_WIDTH * scale * screenscale; // right edge of hud
      clip_at -= (tx + tw * progress) * scale * screenscale;
    } else {
      clip_at = hudx + (tx + tw * progress) * scale * screenscale;
    }
    double sx = screen.GetWidth()/float(fbw);
    clip_at *= sx;
    Vector2 ts = TexMan.GetScaledSize(texture);
    if (hudw <= 0 || sx <= 0) return;
    // the clip's screen column, in texels of the bar's art (drawn at hudx..hudx+hudw virtual, sx screen px each)
    double t = clamp((clip_at / sx - hudx) / hudw * ts.x, 0.0, ts.x);
    if (mirror & HUD_MIRROR_H) {
      if (t >= ts.x) return;
      Screen.DrawTexture(
          texture, false, hudx, hudy,
          DTA_VirtualWidth, fbw, DTA_VirtualHeight, fbh, DTA_KeepRatio, true,
          DTA_DestWidth, hudw, DTA_DestHeight, hudh,
          DTA_Color, colour, DTA_Alpha, alpha,
          DTA_WindowLeftF, t);
    } else {
      if (t <= 0) return;
      Screen.DrawTexture(
          texture, false, hudx, hudy,
          DTA_VirtualWidth, fbw, DTA_VirtualHeight, fbh, DTA_KeepRatio, true,
          DTA_DestWidth, hudw, DTA_DestHeight, hudh,
          DTA_Color, colour, DTA_Alpha, alpha,
          DTA_WindowRightF, t);
    }
  }

  // We want the spike for each colour channel to sweep from 0 to 17, hold for 34,
  // then back down to 0, hold for 34, etc.
  // This is equivalent to sweeping from 0 to 51 and then back to 0, continuously,
  // but then subtracting 17 and clipping it at y=[0,17]
  // To get a triangle wave of wavelength 102 and amplitude 51, we need a sawtooth
  // wave of wavelength 102, which is just y = x % 102
  int sawtooth(int x) {
    return x % 102;
  }
  int triangle(int x) {
    return abs(sawtooth(x) - 51);
  }
  int clamped_triangle(int x) {
    return clamp(triangle(x) - 17, 0, 17);
  }

  // RSQ PATCH (owner 11-06: "give the HUD the life from my old fork's HUD"). Gun Bonsai's own GetShinyColour
  // (ToxicFrog, MIT) with the owner's per-hand tuning from his fork, and its ambient cycle (CycleOr). Each hand's gauge
  // reads its own set (the off hand's gauge bonsai_vr_hud_off_*, the main hand's and the single HUD
  // bonsai_vr_hud_main_*):
  //   *_cycle       Colour Cycle: the frame and both bars cycle all the time (else Gun Bonsai's colours, as before)
  //   *_cyclespeed  scales the tic rate (0 = frozen)
  //   *_gradient    Spread: scales the 0 / 34 / 68 offsets between frame, weapon bar and player bar
  //   *_intensity   scales the brightness (clamped to 255)
  // Defaults 1.0 / 1.0 / 1.0 are Gun Bonsai's stock cycle exactly (RGB triangle waves 34 tics apart, period 102).
  // A level-up waiting still turns everything to the cycle, whatever the switch (stock Gun Bonsai).
  // Colour-blind modes (RSQGB_CB): the switch reads as off for both hands (CycleOn).
  // Photosensitive Mode (RSQGB_Photo): no cycling at all: the switch reads as off, and the level-up's colours are held
  // still at tic 102 (frame red, weapon bar green, player bar blue at the default Spread).
  string CyclePrefix() {
    return lifeSlot == 1 ? "bonsai_vr_hud_off_" : "bonsai_vr_hud_main_";
  }
  double CycleF(string cvn, double def) {
    CVar c = CVar.GetCVar(cvn, players[consoleplayer]);
    return c ? c.GetFloat() : def;
  }

  uint GetShinyColour(int offset) {
    // Simple RGB cycle. Ramps up R to max, then G to max, then R to 0, then B
    // to max, etc. Ramps are in increments of 15.
    // To do this we generate a triangle wave with a wavelength of (255/15*6)
    // from the tic counter, centered at 0 for red, 34 for green, and 68 for blue.
    string p = CyclePrefix();
    double speed = CycleF(p.."cyclespeed", 1.0);
    double grad = CycleF(p.."gradient", 1.0);
    double inten = CycleF(p.."intensity", 1.0);
    int t = RSQGB_Photo.On() ? 102 : int(gametic * speed);
    int o = int(offset * grad);
    uint r = clamp(int(15 * inten * clamped_triangle(o + t)), 0, 255);
    uint g = clamp(int(15 * inten * clamped_triangle(o + t - 34)), 0, 255);
    uint b = clamp(int(15 * inten * clamped_triangle(o + t - 68)), 0, 255);
    // ARGB8 format
    return 0xFF000000 | r<<16 | g<<8 | b;
  }

  // The hand's Colour Cycle switch (off under Photosensitive Mode, and under any colour-blind mode: owner 11-06 06:59,
  // "color blind turns off the HUD life"; the colour-blind pair is drawn as before). A level-up under a colour-blind
  // mode stays as it was: the cycle plus the whole HUD breathing in brightness, so it does not rest on colour alone.
  bool CycleOn() {
    if (RSQGB_Photo.On() || RSQGB_CB.Mode()) return false;
    CVar c = CVar.GetCVar(CyclePrefix().."cycle", players[consoleplayer]);
    return c && c.GetBool();
  }
  // With the switch on, the cycle at this offset; off, the colour given (today's, untouched).
  uint CycleOr(uint base, int offset) {
    return CycleOn() ? GetShinyColour(offset) : base;
  }

  bool LevelUp(TFLV_CurrentStats stats) {
    return stats.wxp >= stats.wmax || stats.pxp >= stats.pmax;
  }

  void DrawHUD(TFLV_CurrentStats stats) {
    string frame_tex, weapon_tex, player_tex;
    [frame_tex, weapon_tex, player_tex] = TFLV_Settings.hud_skin();
    uint frame_rgb, weapon_rgb, player_rgb;
    [frame_rgb, weapon_rgb, player_rgb] = TFLV_Settings.hud_colours();
    // VR PATCH, colour-blind play (RSQ_Accessibility's rsqa_colorblind; RSQGB_CB below). Off,
    // the HUD is Gun Bonsai's own. On, the weapon and player bars (and their text) take the
    // series pair for that vision -- the stock azure 0080FF and green 00FF80 are one colour to a
    // tritanope -- and a level-up is not colour alone: the whole HUD breathes in brightness
    // while the colours cycle.
    int cb = RSQGB_CB.Mode();
    double alpha0 = alpha;
    if (cb) {
      weapon_rgb = 0xFF000000 | RSQGB_CB.Rgb(RSQGB_CB.CB_HAVE, cb);
      player_rgb = 0xFF000000 | RSQGB_CB.Rgb(RSQGB_CB.CB_COULD, cb);
      if (LevelUp(stats)) alpha = alpha0 * (0.45 + 0.55 * (0.5 + 0.5 * sin(gametic * 12.0)));
    }
    uint face = 2;
    if (mirror & HUD_MIRROR_V) face = 4;
    if (mirror & HUD_MIRROR_H) face = 10 - face;

    // HUD disabled completely?
    if (frame_tex == "") return;

    Screen.DrawTexture(tex(frame_tex..face), false, hudx, hudy,
        DTA_VirtualWidth, fbw, DTA_VirtualHeight, fbh, DTA_KeepRatio, true,
        DTA_Color, LevelUp(stats) ? GetShinyColour(0) : CycleOr(frame_rgb, 0),
        DTA_Alpha, alpha,
        DTA_DestWidth, hudw, DTA_DestHeight, hudh);

    // RSQ PATCH (owner 11-05, "let's give the GBOVR XP bars some life like we did to the word SCORE"): with GBOVR
    // Menus and HUD On, each bar breathes around its own colour (RSQGB_BarLife). Off, the bars are Gun Bonsai's own.
    // RSQ PATCH (11-06): with this hand's Colour Cycle on, the bars cycle too, 34 and 68 tics behind the frame.
    uint wcol = LevelUp(stats) ? GetShinyColour(34) : CycleOr(weapon_rgb, 34);
    uint pcol = LevelUp(stats) ? GetShinyColour(68) : CycleOr(player_rgb, 68);
    bool cyc = CycleOn();
    if (RSQGB_BarLife.MockupOn()) {
      let lf = Life(lifeSlot);
      double t = gametic + fracTic;
      lf.Watch(stats, t);
      double wf = stats.wmax > 0 ? stats.wxp / stats.wmax : 0;
      double pf = stats.pmax > 0 ? double(stats.pxp) / stats.pmax : 0;
      wcol = lf.Tint(wcol, wf, lf.phaseW, lf.kickW, lf.flareW, t, cb, LevelUp(stats), cyc);
      pcol = lf.Tint(pcol, pf, lf.phaseP, lf.kickP, lf.flareP, t, cb, LevelUp(stats), cyc);
    }
    DrawProgressBar(
        tex(weapon_tex..face), wcol,
        stats.wxp/stats.wmax, HUD_WXP_X, HUD_WXP_W);
    DrawProgressBar(
        tex(player_tex..face), pcol,
        double(stats.pxp)/(stats.pmax), HUD_PXP_X, HUD_PXP_W);

    // RSQ PATCH (11-13): with GBOVR Menus and HUD On the words and numbers breathe too, letter by letter (TextLive)
    bool live = RSQGB_BarLife.MockupOn();
    let lfT = Life(lifeSlot);
    double tT = gametic + fracTic;
    double wfT = stats.wmax > 0 ? stats.wxp / stats.wmax : 0;
    double pfT = stats.pmax > 0 ? double(stats.pxp) / stats.pmax : 0;
    if (live) {
      TextLive(string.format(StringTable.Localize("$TFLV_HUD_LV"), stats.plvl),
        player_rgb, HUD_TOPTEXT_X, HUD_TOPTEXT_Y, HUD_GRAV_NW, lfT, pfT, lfT.phaseP, lfT.kickP, lfT.flareP, tT, cb, LevelUp(stats), cyc);
      TextLive(string.format("%d/%d", stats.pxp, stats.pmax),
        player_rgb, HUD_BOTTEXT_X, HUD_BOTTEXT_Y, HUD_GRAV_SE, lfT, pfT, lfT.phaseP, lfT.kickP, lfT.flareP, tT, cb, LevelUp(stats), cyc);
    } else {
    Text(
      string.format(StringTable.Localize("$TFLV_HUD_LV"), stats.plvl),
      player_rgb, HUD_TOPTEXT_X, HUD_TOPTEXT_Y, HUD_GRAV_NW);
    Text(
      string.format("%d/%d", stats.pxp, stats.pmax),
      player_rgb, HUD_BOTTEXT_X, HUD_BOTTEXT_Y, HUD_GRAV_SE);
    }

    let spacer = stats.effect == "" ? "" : " ";
    if (live)
      TextLive(string.format("%s%s%s", stats.effect, spacer, stats.wname),
        weapon_rgb, HUD_INFOTEXT_X, HUD_INFOTEXT_Y - NewSmallFont.GetHeight()/scale/screenscale, HUD_GRAV_SW,
        lfT, wfT, lfT.phaseW, lfT.kickW, lfT.flareW, tT, cb, LevelUp(stats), cyc);
    else
    Text(
      string.format("%s%s%s", stats.effect, spacer, stats.wname),
      weapon_rgb, HUD_INFOTEXT_X,
      // HACK HACK HACK, we adjust y in HUD coordinate space so that it ends up
      // in the right place (directly above the weapon name) when it gets rendered.
      HUD_INFOTEXT_Y - NewSmallFont.GetHeight()/scale/screenscale,
      HUD_GRAV_SW);
    if (stats.winfo.IsIgnored()) {
      Text(
        StringTable.Localize("$TFLV_HUD_LV_IGNORED"),
        weapon_rgb, HUD_INFOTEXT_X, HUD_INFOTEXT_Y, HUD_GRAV_SW);
      DrawProgressBar(tex(weapon_tex..face), 0xFF808080, 1.0, HUD_WXP_X, HUD_WXP_W);
    } else if (live) {
      TextLive(string.format(StringTable.Localize("$TFLV_HUD_LVXP"), stats.wlvl, stats.wxp, stats.wmax),
        weapon_rgb, HUD_INFOTEXT_X, HUD_INFOTEXT_Y, HUD_GRAV_SW, lfT, wfT, lfT.phaseW, lfT.kickW, lfT.flareW, tT, cb, LevelUp(stats), cyc);
    } else {
      Text(
        string.format(StringTable.Localize("$TFLV_HUD_LVXP"),
          stats.wlvl, stats.wxp, stats.wmax),
        weapon_rgb, HUD_INFOTEXT_X, HUD_INFOTEXT_Y, HUD_GRAV_SW);
    }
    alpha = alpha0;
  }
}

// RSQGB_BarLife -- THE XP BARS BREATHE (owner 11-05: "let's give the GBOVR XP bars some life like we did to the word
// SCORE just now"). The idea is the owner's own ScoreLabelColor (hf_score_hud.zs): a calm base that a sine pulse
// brightens, and a reaction that pushes it toward hot white. Here, around each bar's OWN colour (Gun Bonsai's weapon
// and player colours, the colour-blind pair, or the level-up cycle), with GBOVR Menus and HUD On:
//   breath    a 2 s sine in brightness (75..100 % of the colour)
//   near      past 60 % full the fill warms toward amber (35 % at most) and the breath quickens to 0.8 s
//   kick      XP gained: a short push toward white (8 tics)
//   flare     the bar fills (a level waits) or a level is taken: a bright push toward white (24 tics)
// Photosensitive Mode (RSQ_Accessibility, RSQGB_Photo): the bar's own colour, steady: no breath, kick or flare.
// Colour-blind modes: brightness only, no warming (the pair keeps its hues). Colour maths only, nothing allocated.
class RSQGB_BarLife ui {
  const BREATH = 70.0;   // tics per breath, far from a level (2 s)
  const QUICK = 28.0;    // tics per breath, at a level (0.8 s)
  const KICK = 8.0;
  const FLARE = 24.0;

  bool primed;
  TFLV_WeaponInfo info;
  double lastW, lastT;
  uint lastWl, lastP, lastPl;
  bool lastReadyW, lastReadyP;
  double phaseW, phaseP;
  double kickW, kickP, flareW, flareP;

  static bool MockupOn() {
    let cv = CVar.FindCVar("rsq_ui_skin");
    return !cv || cv.GetInt() != 0;
  }

  // Each frame, before the bars are drawn: what changed since the last one, and the breaths' phases.
  void Watch(TFLV_CurrentStats stats, double t) {
    bool readyW = stats.wmax > 0 && stats.wxp >= stats.wmax;
    bool readyP = stats.pxp >= stats.pmax;
    if (!primed) {
      kickW = kickP = flareW = flareP = -1000;
      lastT = t;
    } else {
      // the weapon bar: only while it is the same gun (a swap is not a gain)
      if (info == stats.winfo) {
        if (stats.wlvl > lastWl || (readyW && !lastReadyW)) flareW = t;
        else if (stats.wxp > lastW + 0.0001) kickW = t;
      }
      if (stats.plvl > lastPl || (readyP && !lastReadyP)) flareP = t;
      else if (stats.pxp > lastP) kickP = t;
    }
    double dt = clamp(t - lastT, 0.0, 4.0);
    double wf = stats.wmax > 0 ? stats.wxp / stats.wmax : 0;
    double pf = stats.pmax > 0 ? double(stats.pxp) / stats.pmax : 0;
    phaseW += dt * 360.0 / Period(wf);   // dt <= 4 tics: under 52 degrees a frame
    phaseP += dt * 360.0 / Period(pf);
    if (phaseW >= 360) phaseW -= 360;
    if (phaseP >= 360) phaseP -= 360;
    primed = true;
    info = stats.winfo;
    lastW = stats.wxp; lastWl = stats.wlvl; lastReadyW = readyW;
    lastP = stats.pxp; lastPl = stats.plvl; lastReadyP = readyP;
    lastT = t;
  }

  static double Near(double frac) {
    double n = clamp((frac - 0.6) / 0.4, 0.0, 1.0);
    return n * n;
  }

  static double Period(double frac) { return BREATH + (QUICK - BREATH) * Near(frac); }

  static double Fade(double since, double len) {
    double k = clamp(1.0 - since / len, 0.0, 1.0);
    return k * k;
  }

  // The bar's colour this frame (ARGB). ready: a level waits (the colour is Gun Bonsai's cycle; it is not warmed).
  // cycling: the hand's Colour Cycle is on (the colour is the cycle; it is not warmed either, as with ready).
  uint Tint(uint base, double frac, double phase, double kick, double flare, double t, int cb, bool ready, bool cycling = false) {
    if (RSQGB_Photo.On()) return base;
    double r = (base >> 16) & 0xFF, g = (base >> 8) & 0xFF, b = base & 0xFF;
    double near = ready ? 1.0 : Near(frac);
    if (!cb && !ready && !cycling) {
      double w = 0.35 * near;
      r += (255 - r) * w; g += (190 - g) * w; b += (90 - b) * w;
    }
    double amp = 0.25 + 0.10 * near;
    double br = 1.0 - amp + amp * (0.5 + 0.5 * sin(phase));
    r *= br; g *= br; b *= br;
    double hot = max(0.6 * Fade(t - kick, KICK), 0.85 * Fade(t - flare, FLARE));
    r += (255 - r) * hot; g += (255 - g) * hot; b += (255 - b) * hot;
    return 0xFF000000 | (uint(clamp(r, 0, 255)) << 16) | (uint(clamp(g, 0, 255)) << 8) | uint(clamp(b, 0, 255));
  }
}

// RSQGB_CB -- the series' colour-blind palette, read from RSQ_Accessibility's rsqa_colorblind.
// The same table sits in every Radiant Silvergun Quest mod under its own prefix (RSQ_Accessibility,
// tools/cb_template.zs), so a cue means the same colour across the series and each mod still
// loads alone: without RSQ_Accessibility the setting reads 0 and every cue keeps its own colour.
//
//   rsqa_colorblind  0 Off, 1 Protanopia, 2 Deuteranopia, 3 Tritanopia, 4 High Contrast
//
// Roles, not colours: IDLE (searching, nothing found), COULD (noticed, would take it), HAVE
// (taken, locked, yours). A pair of anything (two hands, two bars) uses HAVE and COULD.
//   protan/deutan  grey D0D0D0, amber FFB000, azure 3090FF  (the blue-yellow axis they keep)
//   tritan         grey D0D0D0, red FF4040, cyan 00E0E0     (the red-cyan axis they keep)
//   high contrast  dim grey 8C8C8C, yellow FFFF00, magenta FF40FF (the widest brightness gaps)
// Measured with tools/cvd.py (Machado 2009 / Vienot 1999, CIEDE2000): every pair >= 24 in the
// vision it is for; the stock amber/green pair is 7.5 for deuteranopia.
class RSQGB_CB
{
	enum ERole { CB_IDLE, CB_COULD, CB_HAVE }

	static clearscope int Mode()
	{
		CVar cv = null; { Name rsqaN = "RSQA_Menu"; class<Object> rsqaC = rsqaN; if (rsqaC) cv = CVar.FindCVar("rsqa_colorblind"); }  // only while RSQ_Accessibility is loaded: a value left in the ini must not act on its own
		return cv ? clamp(cv.GetInt(), 0, 4) : 0;
	}

	// 0xRRGGBB for a role in a mode (1..4).
	static clearscope int Rgb(int role, int mode)
	{
		static const int T[] = {
			0xD0D0D0, 0xFFB000, 0x3090FF,   // 1 protanopia
			0xD0D0D0, 0xFFB000, 0x3090FF,   // 2 deuteranopia
			0xD0D0D0, 0xFF4040, 0x00E0E0,   // 3 tritanopia
			0x8C8C8C, 0xFFFF00, 0xFF40FF    // 4 high contrast
		};
		return T[(clamp(mode, 1, 4) - 1) * 3 + clamp(role, 0, 2)];
	}

	// For lump-defined looks (TRNSLATE, TEXTCOLO): "" off, "_PD", "_T" or "_HC" appended to a name.
	static clearscope String Suffix()
	{
		switch (Mode())
		{
			case 1: case 2: return "_PD";
			case 3: return "_T";
			case 4: return "_HC";
		}
		return "";
	}

	// The role's colour while the setting is on, else the mod's own colour.
	static clearscope int Pick(int role, int own)
	{
		int m = Mode();
		return m ? Rgb(role, m) : own;
	}
}

// RSQGB_Photo -- RSQ_Accessibility's Photosensitive Mode (rsqa_photosafe) for the shadowed Gun Bonsai
// files, which compile under Gun Bonsai's own ZSCRIPT (version 2.5, before services): only the three
// reads they need. The rest of the round-two settings are RSQGB_A11y (rsq/zscript/a11y.zs, the
// series template). Without RSQ_Accessibility, or off, every answer is "as Gun Bonsai does it".
class RSQGB_Photo
{
	static clearscope bool On()
	{
		CVar cv = null; { Name rsqaN = "RSQA_Menu"; class<Object> rsqaC = rsqaN; if (rsqaC) cv = CVar.FindCVar("rsqa_photosafe"); }  // only while RSQ_Accessibility is loaded
		return cv && cv.GetInt() != 0;
	}
	// a strong flash at 40% of its brightness
	static clearscope double Dim(double v) { return On() ? v * 0.4 : v; }
	// at least 14 tics between strong flashes (2.5 a second)
	static clearscope bool Gap(int sinceLast) { return !On() || sinceLast >= 14; }
}
