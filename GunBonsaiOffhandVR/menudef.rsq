// RSQ Gun Bonsai VR -- the patch's options: ONE page under Radiant Silvergun Options (owner 11-04 19:36; the screens'
// rows and the HUD's per-hand rows on it), the numbers on Test and Debug, Reset All (the series' RSQGBVResetAll).
// Gun Bonsai VR's own page shows no gating line (MENU_PASS_BRIEF.md). Gun Bonsai's own menu stays where
// Gun Bonsai puts it; the patch adds a way here at its bottom. (Slappers Only, Start With Gloves and the punch
// sliders moved to RSQ Melee's page on 2026-11-01.)

// ---- Radiant Silvergun Options (tools/rsmenu) ----------------------------------------------------
// The series' one Options entry. Every series pk3 carries this same block with its own prefix: the
// parent is PROTECTED, so the first definition stays and later ones add nothing (QZD 17.3 merges a
// protected option menu instead of replacing it); the link row removes any earlier copy of itself,
// so Options shows one row however many series pk3s load. Each mod then adds its own row only.
OptionMenu "RSQ_RSOptions" protected
{
	Class "RSQGBV_RSMenu"
	Title "RADIANT SILVERGUN OPTIONS"
}

AddOptionMenu "OptionsMenu"
{
	RSQGBVRSLink "Radiant Silvergun Options", "RSQ_RSOptions"
}

AddOptionMenu "RSQ_RSOptions"
{
	Submenu "RSQ Gun Bonsai VR", "RSQ_MeleeOptions"
}
// ----------------------------------------------------------------------------------------------------

AddOptionMenu "GunBonsaiOptions"
{
	StaticText " "
	Submenu "$RSQ_MENU_TITLE", "RSQ_MeleeOptions"
}

OptionValue "RSQ_XPSources"
{
	0, "$RSQ_MENU_XPSRC_DAMAGE"
	1, "$RSQ_MENU_XPSRC_STYLE"
	2, "$RSQ_MENU_XPSRC_BOTH"
}

OptionValue "RSQ_StockModes"
{
	0, "$RSQ_MENU_STOCK_SILVERGUN"
	1, "$RSQ_MENU_STOCK_ALL"
}

OptionValue "RSQ_HudHand"
{
	0, "Main Hand"
	1, "Off Hand"
	2, "Last to Earn XP"
}

OptionValue "RSQ_HudMirror"
{
	0, "None"
	1, "Left-Right"
	2, "Up-Down"
	3, "Both"
}

OptionMenu "RSQ_MeleeOptions"
{
	Title "RSQ GUN BONSAI VR"
	Option "$RSQ_MENU_STOCK", "rsq_stock_mode", "RSQ_StockModes"
	Option "$RSQ_MENU_XPSRC", "rsq_xp_source", "RSQ_XPSources"
	Option "$RSQ_MENU_FORCE_LEARNS", "rsq_force_learns", "OnOff"
	Slider "$RSQ_MENU_FORCE_SHARE", "rsq_force_share", 0, 100, 5, 0
	StaticText " "
	StaticText "HUD", 1
	// On: the Mockup's screens, bottom row and breathing XP bars; Off: Gun Bonsai's own (rsq/ui/skin.zs)
	Option "GBOVR Menus and HUD", "rsq_ui_skin", "OnOff"
	Option "Ammo and Health Row", "rsq_ui_bottom", "OnOff", "rsq_ui_skin"
	Slider "HUD Size", "rsq_ui_hud_scale", 0.5, 2.0, 0.05, 2
	Option "Dual HUD", "bonsai_vr_dual_hud", "OnOff"
	Option "Single HUD Follows", "bonsai_vr_hud_hand", "RSQ_HudHand"
	Option "$RSQ_MENU_SHIELDGAUGE", "rsq_hud_shield", "OnOff"
	Option "Berserk Meter Gauge", "rsqgb_berserk_gauge", "OnOff"
	Option "Gauge Animation", "rsqgb_gauge_anim", "OnOff"
	StaticText " "
	StaticText "HUD Position", 1
	Slider "Main HUD Across", "bonsai_vr_hud_main_x", 0.0, 1.0, 0.01, 2
	Slider "Main HUD Down", "bonsai_vr_hud_main_y", 0.0, 1.0, 0.01, 2
	Option "Main HUD Mirror", "bonsai_vr_hud_main_mirror", "RSQ_HudMirror"
	Slider "Off HUD Across", "bonsai_vr_hud_off_x", 0.0, 1.0, 0.01, 2
	Slider "Off HUD Down", "bonsai_vr_hud_off_y", 0.0, 1.0, 0.01, 2
	Option "Off HUD Mirror", "bonsai_vr_hud_off_mirror", "RSQ_HudMirror"
	StaticText " "
	// Colour Cycle per hand (ca.ancilla.bonsai/HUD.zsc CycleOr; the sliders also tune the level-up cycle, so not greyed)
	StaticText "HUD Colour Cycle", 1
	Option "Main HUD Colour Cycle", "bonsai_vr_hud_main_cycle", "OnOff"
	Slider "Main HUD Cycle Speed", "bonsai_vr_hud_main_cyclespeed", 0.0, 3.0, 0.1, 1
	Slider "Main HUD Cycle Spread", "bonsai_vr_hud_main_gradient", 0.0, 3.0, 0.1, 1
	Slider "Main HUD Cycle Intensity", "bonsai_vr_hud_main_intensity", 0.0, 2.0, 0.1, 1
	Option "Off HUD Colour Cycle", "bonsai_vr_hud_off_cycle", "OnOff"
	Slider "Off HUD Cycle Speed", "bonsai_vr_hud_off_cyclespeed", 0.0, 3.0, 0.1, 1
	Slider "Off HUD Cycle Spread", "bonsai_vr_hud_off_gradient", 0.0, 3.0, 0.1, 1
	Slider "Off HUD Cycle Intensity", "bonsai_vr_hud_off_intensity", 0.0, 2.0, 0.1, 1
	StaticText " "
	Submenu "Test and Debug", "RSQ_MeleeAdvanced"
	// Every cvar a row names on both pages; the third argument adds Star Punch's two (no rows: Star Punch is no longer
	// offered, GBOVR_TREES.md 2.1 #5; a save that learned it still reads them).
	RSQGBVResetAll "Reset All", "$RSQ_MENU_RESETALL_Q", "rsq_star_first rsq_star_every"
}

OptionMenu "RSQ_MeleeAdvanced"
{
	Title "RSQ GUN BONSAI VR: TEST AND DEBUG"
	Slider "$RSQ_MENU_FORCE_START", "rsq_force_start", 0.0, 1.0, 0.05, 2
	Slider "$RSQ_MENU_HOOK_XP", "rsq_hook_xp", 0, 3, 0.1, 1
	Slider "$RSQ_MENU_XPSTYLE", "rsq_xp_style_scale", 0.1, 3, 0.1, 1
	Slider "$RSQ_MENU_XPPLAYER", "rsq_xp_style_player", 0, 50, 5, 0
	Slider "HUD Inset", "rsq_ui_inset", 0.0, 0.25, 0.01, 2
	StaticText " "
	Option "Debug Log", "rsq_xp_debug", "OnOff"
	Command "Debug: Add All", "netevent rsqgb_dbg_all"
	Command "Debug: Add Incremental", "netevent rsqgb_dbg_step"
}

// The screens: Gun Bonsai's three menu names, pointed at the routers (rsq/ui/router.zs), which are
// Gun Bonsai's own menus with GBOVR Menus and HUD Off and open the Mockup's screens when it is On.
OptionMenu "GunBonsaiStatusDisplay"
{
	class RSQUI_StatusRouter
	Title "$TFLV_MENU_STATUS_TITLE"
}

OptionMenu "GunBonsaiWeaponLevelUpMenu"
{
	class RSQUI_WeaponLevelUpRouter
	Title "$TFLV_MENU_WEAPON_LEVELUP_TITLE"
}

OptionMenu "GunBonsaiPlayerLevelUpMenu"
{
	class RSQUI_PlayerLevelUpRouter
	Title "$TFLV_MENU_PLAYER_LEVELUP_TITLE"
}

// (RSQUI_Skins is gone since 11-05: the Mockup is the only look, "GBOVR Menus and HUD" turns it on or off.)
// (RSQUI_Options, the screens' own page, is folded into RSQ_MeleeOptions and Tuning and Debug.)
