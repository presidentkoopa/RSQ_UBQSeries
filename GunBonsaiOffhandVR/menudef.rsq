// RSQ Gun Bonsai VR -- the patch's options: a front page under Radiant Silvergun Options with the choices a player makes
// (the series' menu standard, design/MENU_STANDARD.md, 2026-11-24), everything else on Test and Debug, Reset All (the
// series' RSQGBVResetAll). Each row's "// tip:" says what it does.
// Gun Bonsai VR's own page shows no gating line (MENU_PASS_BRIEF.md). Gun Bonsai's own menu stays where
// Gun Bonsai puts it; the patch adds a way here at its bottom. (Slappers Only, Start With Gloves and the punch
// sliders moved to RSQ Melee's page on 2026-11-01.)

// ---- Radiant Silvergun Options (tools/rsmenu) ----------------------------------------------------
// The series' one Options entry. Every series pk3 carries this same block with its own prefix: the
// parent is PROTECTED, so the first definition stays and later ones add nothing (QZD 17.3 merges a
// protected option menu instead of replacing it); the link row removes any earlier copy of itself,
// so Options shows one row however many series pk3s load. Each mod then adds its own row only.
OptionMenu "RSQ_RSOptions" protected
{
	Class "RSQGBV_RSMenu"
	Title "RADIANT SILVERGUN OPTIONS"
}

AddOptionMenu "OptionsMenu"
{
	RSQGBVRSLink "Radiant Silvergun Options", "RSQ_RSOptions"
}

AddOptionMenu "RSQ_RSOptions"
{
	Submenu "RSQ Gun Bonsai VR", "RSQ_MeleeOptions"
}
// ----------------------------------------------------------------------------------------------------

// ---- How To Play (tools/howtoplay, design/HOWTOPLAY_BUILD.md) --------------------------------------
// Every series pk3 carries this block with its own prefix. The help screen (F1 / Read This!) is the LAST loaded pk3's:
// a later ListMenu of one name replaces an earlier one, and every copy of the page is the same code, showing a tab for
// every loaded series mod. The row stands first in Radiant Silvergun Options, one row however many pk3s add it.
ListMenu "ReadThisMenu"
{
	Class "RSQGBV_HowToMenu"
}

ListMenu "RSQGBV_HowTo"
{
	Class "RSQGBV_HowToMenu"
}

AddOptionMenu "RSQ_RSOptions"
{
	RSQGBVHowToLink "How To Play", "RSQGBV_HowTo"
}
// ----------------------------------------------------------------------------------------------------

AddOptionMenu "GunBonsaiOptions"
{
	StaticText " "
	Submenu "$RSQ_MENU_TITLE", "RSQ_MeleeOptions"
}

OptionValue "RSQ_HudHand"
{
	0, "Main Hand"
	1, "Off Hand"
	2, "Last XP"
}

OptionValue "RSQ_HudMirror"
{
	0, "None"
	1, "Horizontal"
	2, "Vertical"
	3, "Both"
}

OptionMenu "RSQ_MeleeOptions"
{
	Title "RSQ GUN BONSAI VR"
	StaticText "HUD", 1
	// On: the Mockup's screens, bottom row and breathing XP bars; Off: Gun Bonsai's own (rsq/ui/skin.zs)
	// tip: The new status screens, bottom row and breathing XP bars; off uses Gun Bonsai's own.
	Option "GBOVR Menus and HUD", "rsq_ui_skin", "OnOff"
	// tip: Shows the ammo and health row at the bottom of the HUD.
	Option "Ammo and Health Row", "rsq_ui_bottom", "OnOff", "rsq_ui_skin"
	// sizes the Ammo and Health Row only (draw.zs HudFrame); Gun Bonsai's XP
	// gauges keep Gun Bonsai's own HUD size (bonsai_hud_size, its own menu)
	// tip: The size of the ammo and health row.
	Slider "Gauge Size", "rsq_ui_hud_scale", 0.5, 2.0, 0.05, 2
	// tip: Draws a HUD for each hand instead of a single one.
	Option "Dual HUD", "bonsai_vr_dual_hud", "OnOff"
	// greyed rows (QZD 17.3 graycheck, its last number the value that greys, as FlashFlare's rows): Single HUD Follows
	// is only read with Dual HUD off (EventHandler.zsc RenderOverlay), and the six HUD Position rows only with it on
	// (DrawForHand)
	// tip: With Dual HUD off, which hand the single HUD follows: main, off, or the last to earn XP.
	Option "Single HUD Follows", "bonsai_vr_hud_hand", "RSQ_HudHand", "bonsai_vr_dual_hud", 0, 1
	// Colour Cycle per hand (ca.ancilla.bonsai/HUD.zsc CycleOr; the sliders also tune the level-up cycle, so not greyed)
	// tip: The main hand's HUD cycles its colours.
	Option "Main HUD Colour Cycle", "bonsai_vr_hud_main_cycle", "OnOff"
	// tip: The off hand's HUD cycles its colours.
	Option "Off HUD Colour Cycle", "bonsai_vr_hud_off_cycle", "OnOff"
	StaticText " "
	// tip: Every other setting: HUD position and colour tuning.
	Submenu "More Settings", "RSQ_MeleeAdvanced"
	// Every cvar a row names on both pages.
	// tip: Puts every RSQ Gun Bonsai VR setting back to its default.
	RSQGBVResetAll "Reset All", "$RSQ_MENU_RESETALL_Q"
}

OptionMenu "RSQ_MeleeAdvanced"
{
	Title "RSQ GUN BONSAI VR: MORE SETTINGS"
	StaticText "LegenDoom", 1
	// the LegenDoom HUD, direction D (rsq/ui/legendoom.zs): each off brings LegenDoom's own back
	// tip: LegenDoom's pickup card in this HUD's style; off brings LegenDoom's own back.
	RSQGBNeedsOption "LegenDoom Card", "rsqgb_ld_card", "OnOff", "legendoom"
	// tip: LegenDoom's gauge row in this HUD's style; off brings LegenDoom's own back.
	RSQGBNeedsOption "LegenDoom Gauge Row", "rsqgb_ld_row", "OnOff", "legendoom"
	// tip: How far the HUD sits in from the edge of the view.
	Slider "HUD Inset", "rsq_ui_inset", 0.0, 0.25, 0.01, 2
	StaticText " "
	StaticText "HUD Position", 1
	// tip: Where the main hand's HUD sits across the view (Dual HUD only).
	Slider "Main HUD Across", "bonsai_vr_hud_main_x", 0.0, 1.0, 0.01, 2, "bonsai_vr_dual_hud"
	// tip: Where the main hand's HUD sits down the view (Dual HUD only).
	Slider "Main HUD Down", "bonsai_vr_hud_main_y", 0.0, 1.0, 0.01, 2, "bonsai_vr_dual_hud"
	// tip: Mirrors the main hand's HUD horizontally, vertically or both.
	Option "Main HUD Mirror", "bonsai_vr_hud_main_mirror", "RSQ_HudMirror", "bonsai_vr_dual_hud"
	// tip: Where the off hand's HUD sits across the view (Dual HUD only).
	Slider "Off HUD Across", "bonsai_vr_hud_off_x", 0.0, 1.0, 0.01, 2, "bonsai_vr_dual_hud"
	// tip: Where the off hand's HUD sits down the view (Dual HUD only).
	Slider "Off HUD Down", "bonsai_vr_hud_off_y", 0.0, 1.0, 0.01, 2, "bonsai_vr_dual_hud"
	// tip: Mirrors the off hand's HUD horizontally, vertically or both.
	Option "Off HUD Mirror", "bonsai_vr_hud_off_mirror", "RSQ_HudMirror", "bonsai_vr_dual_hud"
	StaticText " "
	// (the sliders also tune the level-up cycle, so not greyed)
	StaticText "HUD Colour Cycle", 1
	// tip: How fast the main HUD's colours cycle (also the level-up cycle).
	Slider "Main Cycle Speed", "bonsai_vr_hud_main_cyclespeed", 0.0, 3.0, 0.1, 1
	// tip: How widely the main HUD's colours spread across it.
	Slider "Main Cycle Spread", "bonsai_vr_hud_main_gradient", 0.0, 3.0, 0.1, 1
	// tip: How strong the main HUD's colour cycle is.
	Slider "Main Cycle Intensity", "bonsai_vr_hud_main_intensity", 0.0, 2.0, 0.1, 1
	// tip: How fast the off HUD's colours cycle (also the level-up cycle).
	Slider "Off Cycle Speed", "bonsai_vr_hud_off_cyclespeed", 0.0, 3.0, 0.1, 1
	// tip: How widely the off HUD's colours spread across it.
	Slider "Off Cycle Spread", "bonsai_vr_hud_off_gradient", 0.0, 3.0, 0.1, 1
	// tip: How strong the off HUD's colour cycle is.
	Slider "Off Cycle Intensity", "bonsai_vr_hud_off_intensity", 0.0, 2.0, 0.1, 1
	StaticText " "
}

// The screens: Gun Bonsai's three menu names, pointed at the routers (rsq/ui/router.zs), which are
// Gun Bonsai's own menus with GBOVR Menus and HUD Off and open the Mockup's screens when it is On.
OptionMenu "GunBonsaiStatusDisplay"
{
	class RSQUI_StatusRouter
	Title "$TFLV_MENU_STATUS_TITLE"
}

OptionMenu "GunBonsaiWeaponLevelUpMenu"
{
	class RSQUI_WeaponLevelUpRouter
	Title "$TFLV_MENU_WEAPON_LEVELUP_TITLE"
}

OptionMenu "GunBonsaiPlayerLevelUpMenu"
{
	class RSQUI_PlayerLevelUpRouter
	Title "$TFLV_MENU_PLAYER_LEVELUP_TITLE"
}

// (RSQUI_Skins is gone since 11-05: the Mockup is the only look, "GBOVR Menus and HUD" turns it on or off.)
// (RSQUI_Options, the screens' own page, is folded into RSQ_MeleeOptions and Test and Debug.)
