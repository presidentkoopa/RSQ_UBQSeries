// Radiant Silvergun Options -- the series' shared menu pieces. GENERATED by tools/rsmenu/gen_rsmenu.sh
// from tools/rsmenu/rsmenu_template.zs in RSQ_UBQSeries: do not edit a mod's copy, edit the template.
// Every series pk3 carries its own copy under its own prefix (SSQ): the pk3s load alone or together,
// in any order, and two pk3s cannot both define one class.
//
// HOW THE ONE PARENT MENU WORKS (measured on QuestZDoom 17.3, src/common/menu/menudef.cpp):
//  * Every series MENUDEF defines  OptionMenu "RSQ_RSOptions" protected { ... }  with NO rows. The first
//    pk3 to load creates it; a later definition of a PROTECTED option menu does not replace it, it is
//    merged into it (ReplaceMenu), and a merge of zero rows changes nothing. So the parent exists
//    whichever series pk3 loads first, and nothing a later pk3 does can wipe it.
//  * Each mod then adds only its own row:  AddOptionMenu "RSQ_RSOptions" { Submenu "RSQ Saber", ... }.
//    A mod that is not loaded adds no row, so there is nothing to hide.
//  * The parent's Class is the first-loaded pk3's SSQ_RSMenu (every copy is the same code): it puts
//    the rows in the series' fixed order with blank lines between groups, whatever the load order.
//  * The Options menu gets ONE "Radiant Silvergun Options" row however many series pk3s add one: the
//    row is an OptionMenuItemSSQRSLink, and an item whose Init takes an OptionMenuDescriptor first is
//    handed the menu it is being added to (menudef.cpp), so it removes any earlier row to the same
//    menu before the parser pushes it. It keeps one copy in OptionsMenuSimple too (see below).

class OptionMenuItemSSQRSLink : OptionMenuItemSubmenu
{
	OptionMenuItemSSQRSLink Init(OptionMenuDescriptor desc, String label, Name command)
	{
		if (desc) Unlink(desc, command, false);
		// QZD's Options button opens OptionsMenuSimple when "Simple Options" is on (m_simpleoptions;
		// doommenu.cpp), and AddOptionMenu on a menu an older engine pk3 lacks is a fatal error, so the
		// simple menu gets its copy here, only if it exists: above "Full options menu", set apart.
		if (desc && desc.mMenuName == 'OptionsMenu')
		{
			let simple = OptionMenuDescriptor(MenuDescriptor.GetDescriptor('OptionsMenuSimple'));
			if (simple)
			{
				Unlink(simple, command, true);
				int at = simple.mItems.Size();
				for (int i = 0; i < simple.mItems.Size(); i++)
				{
					Name a = simple.mItems[i].GetAction();
					if (a == 'OptionsMenuFull') { at = i; break; }
				}
				if (at > 0 && at < simple.mItems.Size() && IsSpacer(simple.mItems[at - 1])) at--;
				simple.mItems.Insert(at, new("OptionMenuItemSubmenu").Init(label, command));
				simple.mItems.Insert(at, new("OptionMenuItemStaticText").Init(" "));
			}
		}
		Super.Init(label, command);
		return self;
	}

	static bool IsSpacer(OptionMenuItem it)
	{
		return (it is "OptionMenuItemStaticText") && (it.mLabel == " " || it.mLabel == "");
	}

	// Removes every row that opens <command> (and, with spacer, the blank line put above it).
	static void Unlink(OptionMenuDescriptor desc, Name command, bool spacer)
	{
		for (int i = desc.mItems.Size() - 1; i >= 0; i--)
		{
			let it = desc.mItems[i];
			if (!it || !(it is "OptionMenuItemSubmenu") || (it is "OptionMenuItemCommand")) continue;
			Name a = it.GetAction();
			if (a != command) continue;
			desc.mItems.Delete(i);
			if (spacer && i > 0 && IsSpacer(desc.mItems[i - 1])) { desc.mItems.Delete(i - 1); i--; }
		}
	}
}

class SSQ_RSMenu : OptionMenu
{
	override void Init(Menu parent, OptionMenuDescriptor desc)
	{
		SSQ_RSMenu.Arrange(desc);
		Super.Init(parent, desc);
	}

	// The series' order: the front page each mod adds, and its group (a blank line between groups).
	// A page this copy does not know yet (a newer series mod) goes in group 3, before Accessibility.
	static int Rank(OptionMenuItem it, out int grp)
	{
		static const Name PAGES[] = {
			'UBQS_Options', 'SSQ_Options', 'RSQDG_Options', 'RSQGR_Options', 'RSQLS_Options',
			'RSQTR_Options', 'RSQSM_Options',
			'RSQSC_Options', 'RSQMB_Options', 'RSQTHP_Options', 'RSQ_MeleeOptions',
			'RSQA_Options'
		};
		static const int GROUPS[] = {
			0, 0, 0, 0, 0,
			1, 1,
			2, 2, 2, 2,
			4
		};
		Name a = it.GetAction();
		for (int i = 0; i < PAGES.Size(); i++) if (a == PAGES[i]) { grp = GROUPS[i]; return i; }
		grp = 3;
		return PAGES.Size() - 1;
	}

	static int Group(OptionMenuItem it)
	{
		int g;
		Rank(it, g);
		return g;
	}

	// Rows sorted by the series' order (stable), a spacer between groups; spacers already there are
	// dropped first, so it gives the same list every time the menu opens.
	static void Arrange(OptionMenuDescriptor desc)
	{
		Array<OptionMenuItem> rows;
		for (int i = 0; i < desc.mItems.Size(); i++)
		{
			let it = desc.mItems[i];
			if (!it || !it.Selectable()) continue;
			int g;
			int r = Rank(it, g);
			int at = rows.Size();
			for (int j = 0; j < rows.Size(); j++) if (Rank(rows[j], g) > r) { at = j; break; }
			rows.Insert(at, it);
		}
		Array<OptionMenuItem> outr;
		for (int i = 0; i < rows.Size(); i++)
		{
			if (i > 0 && Group(rows[i]) != Group(rows[i - 1])) outr.Push(new("OptionMenuItemStaticText").Init(" "));
			outr.Push(rows[i]);
		}
		bool same = outr.Size() == desc.mItems.Size();
		for (int i = 0; same && i < outr.Size(); i++)
			if (outr[i] != desc.mItems[i] && (outr[i].Selectable() || desc.mItems[i].Selectable())) same = false;
		if (same) return;
		desc.mItems.Move(outr);
		desc.mSelectedItem = -1;
		desc.mScrollPos = 0;
	}
}

// A named PRESET row: one row that sets several settings at once, and shows which preset they match
// ("Custom" when they match none). No cvar of its own, so nothing new is saved and nothing can drift
// out of step. The choices are an OptionString in MENUDEF: each value is "cvar value cvar value ...",
// each text the name shown, e.g.
//   OptionString "UBQS_SwingFeel" { "ubqs_swing_cut 3.5 ubqs_cut_rate 4", "Light" ... }
//   SSQPreset "Swing Feel", "UBQS_SwingFeel"
// A one-cvar preset is a named choice for a number (Size: Small / Standard / Large) that still shows
// the right name, or Custom, when the number was set on the Tuning page.
class OptionMenuItemSSQPreset : OptionMenuItemOptionBase
{
	OptionMenuItemSSQPreset Init(String label, Name values, CVar graycheck = null, int graycheckVal = 0)
	{
		Super.Init(label, 'none', values, graycheck, 0, graycheckVal);
		return self;
	}

	static bool Matches(String pairs)
	{
		Array<String> t;
		pairs.Split(t, " ", TOK_SKIPEMPTY);
		if (t.Size() < 2) return false;
		for (int i = 0; i + 1 < t.Size(); i += 2)
		{
			let cv = CVar.FindCVar(t[i]);
			if (!cv) return false;
			int ty = cv.GetRealType();
			if (ty == CVar.CVAR_String || ty == CVar.CVAR_Color)
			{
				if (!(cv.GetString() ~== t[i + 1])) return false;
			}
			else if (abs(cv.GetFloat() - t[i + 1].ToDouble()) > 0.0001) return false;
		}
		return true;
	}

	static void Apply(String pairs)
	{
		Array<String> t;
		pairs.Split(t, " ", TOK_SKIPEMPTY);
		for (int i = 0; i + 1 < t.Size(); i += 2)
		{
			let cv = CVar.FindCVar(t[i]);
			if (!cv) continue;
			int ty = cv.GetRealType();
			if (ty == CVar.CVAR_String || ty == CVar.CVAR_Color) cv.SetString(t[i + 1]);
			else if (ty == CVar.CVAR_Float) cv.SetFloat(t[i + 1].ToDouble());
			else cv.SetInt(t[i + 1].ToInt());
		}
	}

	override int GetSelection()
	{
		int cnt = OptionValues.GetCount(mValues);
		for (int i = 0; i < cnt; i++) if (Matches(OptionValues.GetTextValue(mValues, i))) return i;
		return -1;
	}

	override void SetSelection(int sel)
	{
		if (sel >= 0 && sel < OptionValues.GetCount(mValues)) Apply(OptionValues.GetTextValue(mValues, sel));
	}

	override int Draw(OptionMenuDescriptor desc, int y, int indent, bool selected)
	{
		drawLabel(indent, y, selected ? OptionMenuSettings.mFontColorSelection : OptionMenuSettings.mFontColor, isGrayed());
		int sel = GetSelection();
		String text = sel >= 0 ? StringTable.Localize(OptionValues.GetText(mValues, sel)) : "Custom";
		drawValue(indent, y, OptionMenuSettings.mFontColorValue, text, isGrayed());
		return indent;
	}
}
