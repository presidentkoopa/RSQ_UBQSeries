// RSQ Saber -- THE SABER AT THE HIP WITHOUT RSQ TACTICAL RIG (UBQS_HipSaber, zscript/ubqs_hip.zs; Show Sabers). A lump of
// its own: MODELDEF is generated by ubqs.py. This block is UBQS_Saber's own UBSP block (MODELDEF, the pickup mesh and
// skins the Rig wears for a holstered saber, frame N = 13, RSQTRFIT.txt), copied as it is, with USEACTORPITCH and
// USEACTORROLL so the hang turns it (the Rig sets those two flags with SetModelFlag, which this pack's ZScript 4.10 lacks).
Model UBQS_HipSaber
{
	Path "models/ubqs"
	Model 0 "ubqs_saber.md3"
	SurfaceSkin 0 0 "saber.jpg"
	SurfaceSkin 0 1 "saber.jpg"
	SurfaceSkin 0 2 "saber.jpg"
	SurfaceSkin 0 3 "saber.jpg"
	SurfaceSkin 0 4 "saber.jpg"
	SurfaceSkin 0 5 "blade_core.png"
	SurfaceSkin 0 6 "blade_inner_B.png"
	SurfaceSkin 0 7 "blade_mid_B.png"
	SurfaceSkin 0 8 "clear.png"
	SurfaceSkin 0 9 "clear.png"
	SurfaceSkin 0 10 "clear.png"
	Scale -1.608 1.608 1.608
	Offset 0.0 -29.0 -8.0
	USEACTORPITCH
	USEACTORROLL
	FrameIndex UBSP N 0 13
}
