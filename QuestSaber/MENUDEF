// RSQ Saber options, modelled on Brutal Doom Quest 2.0's options page (the owner, 10-28): ONE front
// page with every real choice as a short Title Case row, groups split by blank lines, choices NAMED
// (a slider only where the number itself matters). No help text on the page.
//
// ELEVEN ROWS, ONE PAGE (the owner, 10-30: "Yes, sure, 11 rows, one page. Let's do it."). The old
// page was 142 value rows across 14 pages, and 97 of the cvars behind them wanted the value they
// already had. The Tuning and Debug tree is gone, and so are the presets: a preset row set five rows
// that no longer exist, and the two it really stood for -- Damage and Size -- are now rows of their
// own. Fifteen cvars are still live with no row here; they are listed and explained in CVARINFO.
// Defaults are unchanged except ubqs_dual_mode (1 -> 2), so nobody's saved settings move.

// ---- Radiant Silvergun Options (tools/rsmenu) ----------------------------------------------------
// UNCHANGED, AND IT MUST STAY UNCHANGED. The series' one Options entry. Every series pk3 carries this
// same block with its own prefix: the parent is PROTECTED, so the first definition stays and later
// ones add nothing (QZD 17.3 merges a protected option menu instead of replacing it); the link row
// removes any earlier copy of itself, so Options shows one row however many series pk3s load. Each
// mod then adds its own row only. UBQSRSLink and UBQS_RSMenu come from zscript/ubqs_rsmenu.zs, which
// is generated from the series template -- do not edit a mod's copy.
OptionMenu "RSQ_RSOptions" protected
{
	Class "UBQS_RSMenu"
	Title "RADIANT SILVERGUN OPTIONS"
}

AddOptionMenu "OptionsMenu"
{
	UBQSRSLink "Radiant Silvergun Options", "RSQ_RSOptions"
}

AddOptionMenu "RSQ_RSOptions"
{
	Submenu "RSQ Saber", "UBQS_Options"
}
// ----------------------------------------------------------------------------------------------------

OptionValue "UBQS_Colors"
{
	0, "Blue"
	1, "Green"
	2, "Red"
	3, "Purple"
	4, "Yellow"
	5, "Orange"
	6, "Cyan"
	7, "White"
}
// START WITH DUAL SABERS. 2 is both blades always out, 0 is one saber. The old value 1 -- the Dual
// key brings the second out and puts it away, matched to Brutal Doom's +user3 -- is off the page but
// still honoured by DualMode() (zscript.txt:5668-5673) and still has its bind in KEYCONF. That is
// why ubqs_dual_mode's default moved to 2: an Option row shows nothing useful for a value that is
// not in its list, and 1 was the old default.
OptionValue "UBQS_DualStart"
{
	2, "On"
	0, "Off"
}
// THE FIVE BLADES THAT EXIST, AND THEIR REAL LENGTHS. ubqs_size is not continuous: ResolveSizeIdx
// snaps it to the nearest of 0.70 0.85 1.00 1.15 1.30 (zscript.txt:30, :466-478), and the blade is
// 26.0 map units times that (:851), which at vr_vunits_per_meter 34 (hw_vrmodes.cpp:94) is 54 65 76
// 88 99 cm. The labels are those lengths, so the row cannot promise a blade the mod cannot draw.
// Two more scales would need a MODELDEF regen -- see CHANGES.md Part C.
OptionValue "UBQS_Length"
{
	0.70, "54 cm"
	0.85, "65 cm"
	1.00, "76 cm"
	1.15, "88 cm"
	1.30, "99 cm"
}
OptionValue "UBQS_LengthOff"
{
	-1,   "Same as Main"
	0.70, "54 cm"
	0.85, "65 cm"
	1.00, "76 cm"
	1.15, "88 cm"
	1.30, "99 cm"
}

OptionMenu "UBQS_Options"
{
	Title "RSQ SABER"
	Option "Sabers", "ubqs_on", "OnOff"
	Option "Start With Dual Sabers", "ubqs_dual_mode", "UBQS_DualStart"
	Slider "Damage", "ubqs_damage", 15, 60, 3, 0
	Slider "Max Lock-On Targets", "ubqs_locks", 1, 5, 1, 0
	StaticText " "
	Option "Main Blade Colour", "ubqs_color", "UBQS_Colors"
	Option "Main Blade Length", "ubqs_size", "UBQS_Length"
	Option "Off Blade Colour", "ubqs_color_off", "UBQS_Colors"
	Option "Off Blade Length", "ubqs_size_off", "UBQS_LengthOff"
	Option "Off Blade Light", "ubqs_lights_offhand", "OnOff"
	StaticText " "
	Slider "Swing to Cut", "ubqs_swing_cut", 3, 20, 0.5, 1
	Slider "Blade Block Reach", "ubqs_blade_guard", 1, 24, 1, 0
	StaticText " "
	Submenu "Controls", "UBQS_Keys"
	StaticText " "
	SafeCommand "Reset All", "resetcvar ubqs_on ubqs_dual_mode ubqs_damage ubqs_locks ubqs_color ubqs_size ubqs_color_off ubqs_size_off ubqs_lights_offhand ubqs_swing_cut ubqs_blade_guard ubqs_start ubqs_world_saber ubqs_lights ubqs_deflect_aim ubqs_deflect_lead ubqs_throw_min ubqs_force ubqs_force_jump ubqs_force_gesture ubqs_gesture_straight ubqs_saber_sound ubqs_haptics ubqs_lefty ubqs_remote_level ubqs_diag", "Reset all RSQ Saber settings?"
}

// The SAME bind targets as Customize Controls (KEYCONF's aliases), so a key bound in either place
// shows as bound in both. These four are the only inputs the mod has that are not the trigger, and
// the second blade and the douse are reachable nowhere else -- so this page stays.
// (The old duplicate "Summon / Dismiss Remote" Command row is gone: the Control row above it binds
// the same alias.)
OptionMenu "UBQS_Keys"
{
	Title "CONTROLS"
	Control "Second Saber", "ubqs_dual_toggle"
	Control "Second Blade", "ubqs_blade2_toggle"
	Control "Blade On / Off", "ubqs_ignite_toggle"
	Control "Training Remote", "ubqs_remote_toggle"
}
