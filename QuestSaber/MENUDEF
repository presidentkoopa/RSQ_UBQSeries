// RSQ Saber options, the series' menu (MENU_PASS_BRIEF.md, owner 11-04): ONE page with every option, short Title Case
// rows under short headers, On/Off first, sliders only where the number matters to play; ONE sub menu, "Test and Debug",
// with the raw numbers and the debug view. No help text, no presets. Rows behind a Gun Bonsai VR upgrade are UBQSGbOption
// rows: with RSQ Gun Bonsai VR loaded they grey while the upgrade is not learned, asked of UBQS_SaberService
// "menu.locked" (zscript.txt); learned, the row still decides (owner 11-04: Off is off; Hit-Stop and Lock-On Targets cap
// the upgrade's tics and locks). Turned Shots Go greys whenever Gun Bonsai VR is loaded: the Deflect nodes decide there
// ("PatchDecides"). Reset All (UBQSResetAll) resets every row on both
// pages. Defaults are unchanged except Show Sabers (new, On).

// ---- Radiant Silvergun Options (tools/rsmenu) ----------------------------------------------------
// UNCHANGED, AND IT MUST STAY UNCHANGED. The series' one Options entry. Every series pk3 carries this
// same block with its own prefix: the parent is PROTECTED, so the first definition stays and later
// ones add nothing (QZD 17.3 merges a protected option menu instead of replacing it); the link row
// removes any earlier copy of itself, so Options shows one row however many series pk3s load. Each
// mod then adds its own row only. UBQSRSLink and UBQS_RSMenu come from zscript/ubqs_rsmenu.zs, which
// is generated from the series template -- do not edit a mod's copy.
OptionMenu "RSQ_RSOptions" protected
{
	Class "UBQS_RSMenu"
	Title "RADIANT SILVERGUN OPTIONS"
}

AddOptionMenu "OptionsMenu"
{
	UBQSRSLink "Radiant Silvergun Options", "RSQ_RSOptions"
}

AddOptionMenu "RSQ_RSOptions"
{
	Submenu "RSQ Saber", "UBQS_Options"
}
