// RSQ SABER. Your look and your alt fire are yours (userinfo: every machine sees your
// choice); what it does to the game is the server's.
//
// What is a cvar here is a real setting; every other number lives as a literal in zscript.txt (11-10: the last
// reads of names that were never defined are marked there "/* fixed: was ubqs_..., never a setting */").

// ---- THE MENU (every cvar here has a row on the page or on Test and Debug, except ubqs_world_saber) ------------------
server bool  ubqs_on            = true;   // the saber at all
server int   ubqs_dual_mode     = 2;      // "Start With Dual Sabers": 2 On (the second saber is the off hand's
                                          // weapon; RSQ Tactical Rig's holster puts it away and draws
                                          // it), 0 Off (one saber). 1 was the old Dual key mode, RETIRED
                                          // 11-01 with the key: a saved 1 reads as 2 and the host
                                          // rewrites it to 2 (UBQS_Bridge.WorldLoaded / DualMode).
server int   ubqs_dual_start    = 0;      // "Second Saber Starts" (owner 11-02): 0 Put Away -- at the start
                                          // (a new game, or the first time the second saber is given)
                                          // it goes into its RSQ Tactical Rig holster, or without the
                                          // rig sits in the off hand; 1 In Hand. Lit whenever drawn
                                          // (owner 11-10). Never re-holsters on a level change.
server float ubqs_damage        = 30.0;   // the cut. The menu runs 15-60, which is 0.5x to 2.0x of this
user  int    ubqs_locks         = 5;      // lock-on targets; the code clamps 1-8, the menu offers 1-5

user  int    ubqs_color         = 0;      // main blade
user  float  ubqs_size          = 1.0;    // main blade length. FIVE VALUES EXIST AND NO OTHERS:
                                          // 0.70 0.85 1.00 1.15 1.30, which are 54 65 76 88 99 cm at
                                          // vr_vunits_per_meter 34. ResolveSizeIdx snaps anything else
                                          // to the nearest of them (zscript.txt:30, :466-478), so a
                                          // value between two of them silently becomes one of them.
user  int    ubqs_color_off     = 2;      // off blade
user  float  ubqs_size_off      = -1.0;   // off blade length; -1 the same as the main hand
user  bool   ubqs_lights_offhand = true;  // NEW. The off blade's own dynamic light. It replaces the
                                          // hand-distance merge that used to decide this for you:
                                          // "only the main hand's light when your blades are close
                                          // together" was written as 40.0 MAP UNITS, and a map unit is
                                          // 1/34 m (hw_vrmodes.cpp:94), so the cut-off was 1.17 m --
                                          // wider than hands ever are, and the off blade was unlit in
                                          // every normal dual-wield pose. One switch instead.

server float ubqs_swing_cut     = 8.0;    // units a tic the blade must travel to cut: THE most-felt
                                          // number. On the menu because it is the only one no single
                                          // value can get right -- what counts as a hard swing depends
                                          // on arm length, standing or seated, and the size of the room
server float ubqs_blade_width   = 1.5;    // (owner 2026-10-31: "saber width") how far off a blade's line a shot or
                                          // an attack may pass and still be blocked or turned, map units:
                                          // the blade's own half-width. Was ubqs_blade_guard 6 (a slab a
                                          // quarter of your body, "like having a second shield"), the
                                          // deflect sweep's 5 and the crossed blades' 14.
server int   ubqs_hitstop       = 0;      // (owner's pick 2, 2026-10-31; off by default) tics a cut monster freezes:
                                          // 0 off, 3 light, 4 medium, 6 heavy (surveys/01_MELEE 3.6)
server bool  ubqs_parry_slowmo  = false;  // (owner's pick 5; off by default) a perfect parry asks RSQ SlowMo
                                          // for half a second of slow motion (rsm_pulse 500 35); nothing
                                          // happens without SlowMo
user  bool   ubqs_show          = true;   // Show Sabers (owner 11-04): each saber you own and do not hold is drawn in its RSQ
                                          // Tactical Rig holster (the rig reads this by name); without the rig at the same hip
                                          // spot, drawn by this mod (zscript/ubqs_hip.zs)
user  float  ubqs_hum_swing     = 1.1;    // how much louder the hum gets on a hard swing (0 = steady)

server bool  ubqs_bd_sword      = true;   // (worklist #14, menu row 11-01) Brutal Doom's sword (DSweap)
                                          // becomes the saber: its pickups and the one you carry. Read
                                          // by UBQS_Bridge.IsTheirs; it was on in code with no entry.
user  int    ubqs_alt           = 1;      // (worklist #14, menu row 11-01) the main saber's alt trigger:
                                          // 1 Force push, 0 the second blade on / off instead. Read by
                                          // A_UBAltFire (fallback 1); it was on in code with no entry.

// ---- ON TEST AND DEBUG (and ubqs_world_saber, which has no row) ------------------------------------------

server bool  ubqs_start         = true;   // begin holding one. false = it exists, you pick it up.
                                          // "Sabers Off" covers the common case, so this is not a row
user  bool   ubqs_world_saber   = false;  // the whole saber drawn in the world as one actor. SETTLED,
                                          // AND KEPT: the blades become world sabers when they CROSS
                                          // to deflect, which is the entire point of the path, and the
                                          // crossed case brings it up on its own whatever this says
                                          // (zscript.txt:1662-1663). It is also the lever for the
                                          // SteamVR two-hand-grip fix (03_SABER_AND_SAW.md 2.6).
                                          // Not a row because it should not be a choice.
user  int    ubqs_lights        = 1;      // blade light detail: 0 none, 1 one light per blade (Quest),
                                          // 2 two per blade, 3 three (PC); the menu offers all four
user  int    ubqs_deflect_aim   = 1;      // where a turned shot goes: 1 where you look, 0 at the
                                          // shooter, 2 a true mirror off the blade. Three real answers
server float ubqs_deflect_lead  = 3.0;    // tics of a shot's own path the blade is tested against. 3
                                          // turns shots two tics early, including ones that would have
                                          // missed; only the headset can say whether that reads psychic
user  float  ubqs_throw_min     = 1.5;    // how hard a throw must be. Body-dependent, like swing_cut,
                                          // but a throw that does not go is visible and a cut that does
                                          // not land is not -- so this one stays off the page
server int   ubqs_force         = 1;      // the Force at all: push, pull, choke, jump
server int   ubqs_force_jump    = 1;      // it changes how you move, so it is worth being able to stop
server bool  ubqs_force_saber   = true;   // (owner, 11-03 17:44) "Force Only With the Saber": the bare Force hand is in the off
                                          // hand only while the saber is the main hand's; switch the saber away and the off
                                          // hand gets the load order's empty hand (BD22 VR's RSQ_Hands, else nothing) that tic
user  int    ubqs_hilt_hand     = 1;      // (owner, 11-03 19:25) Hand on the Hilt: BD22 VR's FBX hand (its magazine hold, the
                                          // Force hand's mesh) wrapped round each held saber's hilt; 0 = the hilt alone
user  int    ubqs_fhand_mesh    = 0;      // (owner, 11-03) the bare Force hand's mesh: 0 Our Hand (BD22 VR Reloaded's FBX
                                          // hand in its rifle-magazine hold, one steady pose), 1 Original (Ermac's, open/fist)
server int   ubqs_lightning_beam = 1;     // (owner, 11-03) Force Lightning drawn as a beam per hop (Distance Grab's beam
                                          // mesh, blue-white, writhing) with sparse crackle on top; 0: the particle arcs alone
user  float  ubqs_force_gesture = 2.0;    // how sharp a push or pull gesture must be
user  float  ubqs_gesture_straight = 0.55; // and how straight (a dot, not degrees -- 0.55 is not the
                                          // cosine of any round number)
user  int    ubqs_saber_sound   = 0;      // 0 Graflex, 1 Vader (Rogue One), 2 Rogue Rebel
user  int    ubqs_haptics       = 1;      // controller buzz at all. The cut and the clash used to have
                                          // their own switches; they were subsets of this one
user  int    ubqs_lefty         = -1;     // which controller the rumble goes to: -1 follow the engine's
                                          // handedness (it reads vr_control_scheme in single player),
                                          // 0 right-handed, 1 left-handed. The engine already answers
                                          // this, which is why it is not a row
user  int    ubqs_remote_level  = 2;      // the training remote's starting level
user  int    ubqs_diag          = 0;      // 1 blade-line dots, 2 glow telemetry (log + overlay)
