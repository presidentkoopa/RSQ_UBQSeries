// HOW TO PLAY AND RSQOOPACONTROLS -- RSQ Controls' page, Options rows and first-launch screen. GENERATED by
// tools/howtoplay/gen_howtoplay.py from tools/howtoplay/howto_template.zs in RSQ_UBQSeries into Controls/ (RSQCT = RSQCT):
// do not edit the copy, edit the template and re-run it. Since 2026-11-27 (owner, 11:3x) the page is in ONE mod, RSQ
// Controls (RSQ_Controls.pk3); the other series mods carry none. design/HOWTOPLAY_BUILD.md tells the whole story.
//
// THE PAGE (owner 2026-11-27, mockup B "with a body tab"): RSQ Score's Glossary generalised. A 640 x 400 virtual page,
// near-black, the title in gold, a strip of tabs, the list on the left (the name in the tab's colour, a value in white),
// the detail on the right (gold labels, white text). First the CONTROLS tab (owner 11:33): RSQoopaControls as the front
// README's table picture draws it. Then a BODY tab: a flat figure with the places on your body, the moves done at each
// place from every loaded mod, each with DO / GET. Then one tab per LOADED series mod, in the Options menu's order, each
// tab's rows from that mod's README (RSQCT_HowToData, generated); RSQ Score's tab is its Glossary (its families are the
// tab's sections). A mod is loaded when the class its tab names (RSQCT_HowToData.PROBE) exists.
//   Up / Down: the list (Page Up / Down a page). Left / Right: the next section or tab (through all of them, wrapping).
//   Select on a SHOW ME row: the menu closes and RSQ Tactical Rig's ghost hand does that move once on your body.
//   Select on SHOW ON MY BODY: the menu closes and the Rig's mirror stands in front of you with that place lit.
//   Back: close. A click picks a tab, a section, a place on the figure or a row; a click on the picked SHOW row acts.
// Without RSQ Tactical Rig (or with it off, or out of a game) no SHOW row is listed: the Rig answers by name
// (RSQTR_RigService "ghost.demo" / "mirror.show") and the page shows only what it says it can do.
//
// WHO OPENS IT: RSQ Controls' MENUDEF has  ListMenu "ReadThisMenu" { Class "RSQCT_HowToMenu" }  (the engine's help, F1 /
// Read This!: a descriptor of that name is found before the engine's class of that name),  ListMenu "RSQCT_HowTo"  and
// the "How To Play" row (RSQCTHowToLink), first in Radiant Silvergun Options. Series pk3s built before 2026-11-27 carry
// their own older copy: each answers a *_HowToService with its PAGEVERSION, and an older page that opens hands over on its
// first tic to the newest one it finds (this one, RSQCT_HowToService "howto.menu").

class RSQCT_HowToService : Service
{
	override int GetIntUI(String request, String stringArg, int intArg, double doubleArg, Object objectArg, Name nameArg)
	{
		if (request == "howto.version") return RSQCT_HowToMenu.PAGEVERSION;
		return 0;
	}

	override String GetStringUI(String request, String stringArg, int intArg, double doubleArg, Object objectArg, Name nameArg)
	{
		if (request == "howto.menu") return "RSQCT_HowTo";
		return "";
	}

	// a < b, case not counted (by bytes; no relational operator on strings is relied on)
	static clearscope bool Before(String a, String b)
	{
		a = a.MakeLower();
		b = b.MakeLower();
		int n = min(a.Length(), b.Length());
		for (int i = 0; i < n; i++)
		{
			int ca = a.ByteAt(i), cb = b.ByteAt(i);
			if (ca != cb) return ca < cb;
		}
		return a.Length() < b.Length();
	}

	static clearscope bool IsHowTo(Service s)
	{
		if (!s) return false;
		String cn = s.GetClassName();
		int n = cn.Length();
		return n > 13 && (cn.Mid(n - 13) ~== "_HowToService");
	}

	// The copy that speaks (the first-run line): the loaded How To service whose class name sorts first. With RSQ Controls
	// alone that is this one; an older series pk3's copy (before 2026-11-27) still asks the same, so one line is shown.
	static clearscope bool Leader()
	{
		String mine = "RSQCT_HowToService";
		let it = ServiceIterator.Find("_HowToService");
		Service s;
		while (s = it.Next())
		{
			if (!IsHowTo(s)) continue;
			String cn = s.GetClassName();
			if (Before(cn, mine)) return false;
		}
		return true;
	}
}

class RSQCT_HowToMenu : ListMenu
{
	const PAGEVERSION = 3;   // 3: one copy, in RSQ Controls, with the CONTROLS tab. Raise when the page changes: a newer copy in another pk3 then takes over (above). Not "VERSION": a ZScript keyword (does not compile)

	const VW = 640;
	const VH = 400;
	const TS = 1.6;          // detail text, as the Glossary's; shrunk step by step (to TSMIN) only when a row would not fit
	const TSMIN = 1.0;
	const LS = 1.35;         // the list's text
	const ROWH = 30;
	const LISTX = 16;
	const LISTW = 286;
	const DX = 318;          // detail panel left
	const TABY = 52;         // the tab strip
	const TABH = 34;
	const TABSHOWN = 6;      // tabs shown at once; the strip scrolls to keep the current one in view
	const ARROW = 16;        // the strip's ends: "<" / ">" while tabs lie beyond them
	const SECY = 90;         // the section strip (Score's families), under the tabs
	const SECH = 22;
	const BODYROWH = 22;     // the body tab's list
	const BODYROWS = 4;
	const PANELB = 376;      // the panels' foot
	// the CONTROLS tab: two panels, one under the other; four columns (their left edges); rows CTLROWH apart
	const CTLY = 94;
	const CTLHEAD = 30;      // a panel's title and column heads, above its first row
	const CTLROWH = 12;
	const CTLGAP = 6;
	static const int CTLX[] = { 24, 142, 292, 452 };
	const CTLRIGHT = 616;    // the last column's right edge

	static const String PLACES[] = { "MOUTH", "LSH", "RSH", "CHEST", "BELT", "LHIP", "RHIP", "OFF", "MAIN", "BOTH" };
	static const String PLACENAME[] = { "MOUTH", "L SHOULDER", "R SHOULDER", "CHEST", "BELT", "L HIP", "R HIP", "OFF HAND", "MAIN HAND", "BOTH HANDS" };
	// the figure's place chips: centre x, centre y, width (virtual); OFF / MAIN swap sides when left-handed. They stand round
	// the marine, each joined by a line to its place on him.
	static const int CHIPX[] = { 159, 56, 262, 56, 262, 56, 262, 56, 262, 159 };
	static const int CHIPY[] = { 110, 142, 142, 222, 222, 262, 262, 182, 182, 352 };
	static const int CHIPW[] = { 60, 74, 74, 60, 52, 60, 60, 70, 74, 92 };
	// THE FIGURE IS THE DOOM MARINE (owner 2026-11-27: "use the god damn Doom marine"): the sprite PLAYA1, the one RSQ
	// Wheel's holster screen draws, flipped so your left is on the left as you wear it, MARS times its pixels, its top
	// left at MARX, MARY. Each place's spot on him in the flipped sprite's pixels (PTX, PTY; by place, as CHIPX).
	const MARS = 3.4;
	const MARX = 69;         // his body's middle (column 14.5 of BD's PLAYA1, as RSQ Wheel measures it; 26.5 flipped) on the panel's middle, 159
	const MARY = 130;
	static const double PTX[] = { 26.5, 14.25, 36.75, 26.5, 26.5, 16.5, 32.75, 8.25, 37.75, -1 };
	static const double PTY[] = { 9.0, 12.0, 13.0, 17.5, 27.5, 31.0, 31.0, 17.5, 22.0, -1 };
	// without a PLAYA1 sprite (none loaded at all): grey boxes in his shape: x, y, w, h of each part
	static const int FIG[] = { 141, 100, 36, 34,   123, 140, 72, 106,   127, 250, 28, 112,   163, 250, 28, 112,
		105, 144, 16, 40,   97, 182, 16, 36,   85, 216, 16, 32,   75, 248, 22, 18,
		197, 144, 16, 40,   205, 182, 16, 36,   217, 216, 16, 32,   221, 248, 22, 18 };

	// the Show rows' own words (the owner's mockups, 2026-11-27)
	const SHOWME = "SHOW ME";
	const SHOWME_TEXT = "THE MENU CLOSES AND A GHOST HAND DOES THE MOVE AT THE REAL PLACE ON YOUR BODY.";
	const SHOWBODY = "SHOW ON MY BODY";
	const SHOWBODY_TEXT = "THE MENU CLOSES AND THE TACTICAL RIG'S MIRROR STANDS IN FRONT OF YOU WITH THIS PLACE LIT.";

	// tabs
	Array<String> tName, tColour;
	Array<int> tKind;        // 0 a mod's, 1 the body tab, 2 the controls tab
	int mBody;               // the body tab's index, -1 none
	int mControls;           // the controls tab's index (0)
	// rows, parallel arrays
	Array<int> rTab, rOwner, rKind;              // kind 0 a move, 1 SHOW ME, 2 SHOW ON MY BODY
	Array<String> rSec, rColour, rLabel, rValue, rPlaces, rDemo, rPara, rPairs;
	// stops: every section of every tab, in order (Left / Right walk them)
	Array<int> sTab, sSel, sTopRow;   // not "sTop": names ignore case, and "stop" is a ZScript keyword
	Array<String> sSec;
	int mStop, mSel, mTop, mTabFirst;
	Array<int> mShown;
	bool mHanded;            // left-handed: the main hand is the left one
	bool mChecked;           // the version hand-over looked at
	Service mRig;            // RSQ Tactical Rig's RSQTR_RigService, if it is loaded

	Font fBig, fSmall;
	double s, ox, oy;

	// ---------------------------------------------------------------------------------------------- content

	override void Init(Menu parent, ListMenuDescriptor desc)
	{
		Super.Init(parent, desc);
		DontDim = false;
		fBig = Font.GetFont("RSSCFON");   if (!fBig) fBig = bigfont;     // RSQ Score's fonts when it is loaded
		fSmall = Font.GetFont("RSSCFN2"); if (!fSmall) fSmall = smallfont;
		let cs = CVar.FindCVar("vr_control_scheme");
		mHanded = cs && cs.GetInt() >= 10;
		mBody = -1;
		mControls = -1;
		mRig = Rig();
		Build();
		mStop = 0;
		Refill();
	}

	// the controls tab; then every loaded mod's tab, in the Options menu's order; then the body tab between them
	void Build()
	{
		tName.Push("CONTROLS");
		tColour.Push("RSScore_Gold");
		tKind.Push(2);
		mControls = 0;

		// the mods' tabs (their index; the body tab, if any, goes in at 1 below). A mod is loaded when its PROBE class
		// exists: a class named in a String is looked up as the page runs and is null when no loaded pk3 declares it
		// (gzdoom qzd17.3 src/common/scripting/backend/codegen.cpp:12370-12392, NativeNameToClass)
		Array<String> raw;
		Array<int> rawTab;
		for (int m = 0; m < RSQCT_HowToData.NMODS; m++)
		{
			String probe = RSQCT_HowToData.PROBE[m];
			Class<Object> there = probe;
			if (!there) continue;
			int ti = tName.Size();
			tName.Push(RSQCT_HowToData.TAB[m]);
			tColour.Push(RSQCT_HowToData.COLOUR[m]);
			tKind.Push(0);
			Array<String> lines;
			RSQCT_HowToData.Rows(m, lines);
			for (int k = 0; k < lines.Size(); k++) { raw.Push(lines[k]); rawTab.Push(ti); }
		}

		bool anyPlace = false;
		for (int i = 0; i < raw.Size(); i++)
		{
			Array<String> f;
			raw[i].Split(f, "|");
			if (f.Size() > 4 && f[4].Length() > 0) { anyPlace = true; break; }
		}
		int shift = anyPlace ? 1 : 0;
		if (anyPlace)
		{
			tName.Insert(1, "BODY");
			tColour.Insert(1, "RSScore_Counter");
			tKind.Insert(1, 1);
			mBody = 1;
		}

		// each mod's rows, a SHOW ME after each move the Rig can show
		for (int i = 0; i < raw.Size(); i++)
		{
			Array<String> f;
			raw[i].Split(f, "|");
			while (f.Size() < 8) f.Push("");
			int t = rawTab[i] + shift;   // the mods' tabs start at 1, after CONTROLS; BODY went in before them
			String col = f[1].Length() > 0 ? f[1] : tColour[t];
			AddRow(t, t, 0, f[0], col, f[2], KeyValue(f[3]), f[4], f[5], f[6], KeyPairs(f[7], f[3]));
			if (f[5].Length() > 0 && RigCan("ghost.demo", f[5]))
				AddRow(t, t, 1, f[0], col, SHOWME, "", "", f[5], SHOWME_TEXT, OnlyDo(f[7]));
		}

		// the body tab: the places in the figure's order, the moves done there from every tab
		if (mBody >= 0)
		{
			int n = rTab.Size();
			for (int pl = 0; pl < PLACES.Size(); pl++)
			{
				int first = rTab.Size();
				for (int i = 0; i < n; i++)
				{
					if (rKind[i] != 0 || !AtPlace(rPlaces[i], pl)) continue;
					AddRow(mBody, rTab[i], 0, PLACES[pl], rColour[i], rLabel[i], tName[rTab[i]], rPlaces[i], rDemo[i], "", BodyPairs(rPairs[i]));
					if (rDemo[i].Length() > 0 && RigCan("ghost.demo", rDemo[i]))
						AddRow(mBody, rTab[i], 1, PLACES[pl], rColour[i], SHOWME, tName[rTab[i]], "", rDemo[i], SHOWME_TEXT, OnlyDo(rPairs[i]));
				}
				if (rTab.Size() > first && RigCan("mirror.show", PLACES[pl]))
				{
					// first on the place's list
					AddRow(mBody, mBody, 2, PLACES[pl], tColour[mBody], SHOWBODY, "", PLACES[pl], "", SHOWBODY_TEXT, "");
					int last = rTab.Size() - 1;
					MoveRow(last, first);
				}
			}
		}

		// the stops: a tab with sections (Score's families, the body's places) has one per section
		for (int t = 0; t < tName.Size(); t++)
		{
			Array<String> secs;
			for (int i = 0; i < rTab.Size(); i++)
			{
				if (rTab[i] != t) continue;
				bool had = false;
				for (int k = 0; k < secs.Size(); k++) if (secs[k] == rSec[i]) { had = true; break; }
				if (!had) secs.Push(rSec[i]);
			}
			if (secs.Size() == 0) secs.Push("");
			for (int k = 0; k < secs.Size(); k++) { sTab.Push(t); sSec.Push(secs[k]); sSel.Push(0); sTopRow.Push(0); }
		}
	}

	void AddRow(int tab, int owner, int kind, String sec, String col, String label, String value, String places, String demo, String para, String pairs)
	{
		rTab.Push(tab); rOwner.Push(owner); rKind.Push(kind); rSec.Push(sec); rColour.Push(col); rLabel.Push(label);
		rValue.Push(value); rPlaces.Push(places); rDemo.Push(demo); rPara.Push(para); rPairs.Push(pairs);
	}

	void MoveRow(int from, int to)
	{
		if (from == to) return;
		rTab.Insert(to, rTab[from]); rTab.Delete(from + 1);
		rOwner.Insert(to, rOwner[from]); rOwner.Delete(from + 1);
		rKind.Insert(to, rKind[from]); rKind.Delete(from + 1);
		rSec.Insert(to, rSec[from]); rSec.Delete(from + 1);
		rColour.Insert(to, rColour[from]); rColour.Delete(from + 1);
		rLabel.Insert(to, rLabel[from]); rLabel.Delete(from + 1);
		rValue.Insert(to, rValue[from]); rValue.Delete(from + 1);
		rPlaces.Insert(to, rPlaces[from]); rPlaces.Delete(from + 1);
		rDemo.Insert(to, rDemo[from]); rDemo.Delete(from + 1);
		rPara.Insert(to, rPara[from]); rPara.Delete(from + 1);
		rPairs.Insert(to, rPairs[from]); rPairs.Delete(from + 1);
	}

	// a row's places hold this one; MSH / OSH / MHIP / OHIP are the main or off hand's side, by handedness
	bool AtPlace(String plist, int pl)   // not "places": names ignore case, and PLACES is the table
	{
		Array<String> p;
		plist.Split(p, " ", TOK_SKIPEMPTY);
		String want = PLACES[pl];
		for (int i = 0; i < p.Size(); i++)
		{
			String q = p[i];
			if (q == "MSH") q = mHanded ? "LSH" : "RSH";
			else if (q == "OSH") q = mHanded ? "RSH" : "LSH";
			else if (q == "MHIP") q = mHanded ? "LHIP" : "RHIP";
			else if (q == "OHIP") q = mHanded ? "RHIP" : "LHIP";
			if (q == want) return true;
		}
		return false;
	}

	// "KEY:<command>": the key bound to it now, or NOT BOUND
	static String KeyName(String value)
	{
		if (value.Left(4) != "KEY:") return "";
		int k1, k2;
		[k1, k2] = Bindings.GetKeysForCommand(value.Mid(4));
		if (k1 <= 0 && k2 <= 0) return "NOT BOUND";
		String n = Bindings.NameKeys(k1, k2);
		n = n.MakeUpper();
		return n.Length() > 0 ? n : "NOT BOUND";
	}
	static String KeyValue(String value) { return value.Left(4) == "KEY:" ? KeyName(value) : value; }
	static String KeyPairs(String pairs, String value)
	{
		if (value.Left(4) != "KEY:") return pairs;
		return pairs .. (pairs.Length() > 0 ? "~" : "") .. "KEY:~" .. KeyName(value);
	}
	// the body tab's detail: DO and GET only (the owner: "each with DO / GET")
	static String BodyPairs(String pairs)
	{
		Array<String> p;
		pairs.Split(p, "~");
		String res = "";   // not "out": a ZScript keyword
		for (int i = 0; i + 1 < p.Size(); i += 2)
			if (p[i] == "DO:" || p[i] == "GET:") res = res .. (res.Length() > 0 ? "~" : "") .. p[i] .. "~" .. p[i + 1];
		return res;
	}
	static String OnlyDo(String pairs)
	{
		Array<String> p;
		pairs.Split(p, "~");
		for (int i = 0; i + 1 < p.Size(); i += 2) if (p[i] == "DO:") return "DO:~" .. p[i + 1];
		return "";
	}

	// RSQ Tactical Rig says it can do this now (RSQTR_RigService, by name; 0 without the Rig)
	static Service Rig()
	{
		let it = ServiceIterator.Find("RSQTR_RigService");
		Service s;
		while (s = it.Next()) if (s.GetClassName() == 'RSQTR_RigService') return s;
		return null;
	}
	bool RigCan(String ask, String what)
	{
		return mRig && mRig.GetIntUI(ask, what) == 1;
	}

	// ---------------------------------------------------------------------------------------------- state

	void Refill()
	{
		mShown.Clear();
		if (sTab.Size() == 0) return;
		mStop = clamp(mStop, 0, sTab.Size() - 1);
		for (int i = 0; i < rTab.Size(); i++) if (rTab[i] == sTab[mStop] && rSec[i] == sSec[mStop]) mShown.Push(i);
		mSel = clamp(sSel[mStop], 0, max(0, mShown.Size() - 1));
		mTop = sTopRow[mStop];
		Scroll();
		int t = sTab[mStop];
		if (t < mTabFirst) mTabFirst = t;
		if (t >= mTabFirst + TABSHOWN) mTabFirst = t - TABSHOWN + 1;
		mTabFirst = clamp(mTabFirst, 0, max(0, tName.Size() - TABSHOWN));
	}

	void SetStop(int st)
	{
		int n = sTab.Size();
		if (n == 0) return;
		sSel[mStop] = mSel; sTopRow[mStop] = mTop;
		mStop = (st + n) % n;
		Refill();
		MenuSound("menu/change");
	}

	// the first stop of tab t
	void SetTab(int t)
	{
		for (int i = 0; i < sTab.Size(); i++) if (sTab[i] == t) { if (i != mStop) SetStop(i); return; }
	}

	int Rows() { return CurTab() == mBody ? BODYROWS : (Sections() > 1 ? 8 : 9); }
	int RowHeight() { return CurTab() == mBody ? BODYROWH : ROWH; }
	int ListY() { return CurTab() == mBody ? 118 : (Sections() > 1 ? 124 : 100); }
	int CurTab() { return sTab.Size() ? sTab[mStop] : -1; }
	int Sections()
	{
		int n = 0, t = CurTab();
		for (int i = 0; i < sTab.Size(); i++) if (sTab[i] == t) n++;
		return n;
	}

	void Scroll()
	{
		int rows = Rows();
		if (mSel < mTop) mTop = mSel;
		if (mSel >= mTop + rows) mTop = mSel - rows + 1;
		mTop = clamp(mTop, 0, max(0, mShown.Size() - rows));
	}

	void Move(int d, bool wrap)
	{
		int n = mShown.Size();
		if (n == 0) return;
		int was = mSel;
		if (wrap) mSel = (mSel + d + n) % n;
		else      mSel = clamp(mSel + d, 0, n - 1);
		Scroll();
		if (mSel != was) MenuSound("menu/cursor");
	}

	// SHOW ME / SHOW ON MY BODY: the Rig is told by name (a network event it names itself), every menu closes
	bool Act()
	{
		if (mShown.Size() == 0) return false;
		int e = mShown[mSel];
		if (rKind[e] == 0) return false;
		let r = mRig;
		String ask = rKind[e] == 1 ? "ghost.demo" : "mirror.show";
		String what = rKind[e] == 1 ? rDemo[e] : Resolve(rPlaces[e]);
		String ev = r ? r.GetStringUI(ask, what) : "";
		if (ev.Length() == 0) { MenuSound("menu/invalid"); return true; }
		MenuSound("menu/choose");
		EventHandler.SendNetworkEvent(ev);
		for (int i = 0; i < 16; i++)
		{
			let m = Menu.GetCurrentMenu();
			if (!m) break;
			m.Close();
		}
		return true;
	}

	String Resolve(String place)
	{
		for (int pl = 0; pl < PLACES.Size(); pl++) if (AtPlace(place, pl)) return PLACES[pl];
		return place;
	}

	override bool MenuEvent(int mkey, bool fromcontroller)
	{
		switch (mkey)
		{
		case MKEY_Up:       Move(-1, true); return true;
		case MKEY_Down:     Move(1, true); return true;
		case MKEY_PageUp:   Move(-Rows(), false); return true;
		case MKEY_PageDown: Move(Rows(), false); return true;
		case MKEY_Left:     SetStop(mStop - 1); return true;
		case MKEY_Right:    SetStop(mStop + 1); return true;
		case MKEY_Enter:    Act(); return true;
		}
		return Super.MenuEvent(mkey, fromcontroller);   // Back: Menu closes it
	}

	override void Ticker()
	{
		Super.Ticker();
		// pk3s built from different versions of the template: the newest copy's page takes over, once
		if (!mChecked)
		{
			mChecked = true;
			int best = PAGEVERSION;
			String to = "";
			let it = ServiceIterator.Find("_HowToService");
			Service sv;
			while (sv = it.Next())
			{
				if (!RSQCT_HowToService.IsHowTo(sv)) continue;
				int v = sv.GetIntUI("howto.version");
				if (v > best) { best = v; to = sv.GetStringUI("howto.menu"); }
			}
			if (to.Length() > 0)
			{
				Name nm = to;
				Close();
				Menu.SetMenu(nm);
				return;
			}
		}
		// TEST ONLY (the rig cannot send menu keys): RSQ Score's rs_score_glosstest, as its Glossary reads it (1 up, 2 down,
		// 3 left, 4 right, 5 page down, 6 page up) and 7 select; done once, then set back to 0. Only with RSQ Score loaded.
		CVar cv = CVar.FindCVar("rs_score_glosstest");
		if (!cv || cv.GetInt() == 0) return;
		static const int KEYS[] = { MKEY_Up, MKEY_Down, MKEY_Left, MKEY_Right, MKEY_PageDown, MKEY_PageUp, MKEY_Enter };
		int k = cv.GetInt();
		cv.SetInt(0);
		if (k >= 1 && k <= 7) MenuEvent(KEYS[k - 1], false);
	}

	override bool MouseEvent(int type, int mx, int my)
	{
		Frame();
		double x = (mx - ox) / s, y = (my - oy) / s;
		if (type != MOUSE_Release) return true;
		// the tab strip and its ends
		if (y >= TABY && y < TABY + TABH && x >= LISTX && x < VW - LISTX)
		{
			int n = tName.Size();
			bool scroll = n > TABSHOWN;
			if (scroll && x < LISTX + ARROW) { SetTab(max(0, CurTab() - 1)); return true; }
			if (scroll && x >= VW - LISTX - ARROW) { SetTab(min(n - 1, CurTab() + 1)); return true; }
			double x0, tw;
			[x0, tw] = TabGeometry();
			int t = mTabFirst + int((x - x0) / tw);
			if (x >= x0 && t >= 0 && t < n) SetTab(t);
			return true;
		}
		int ct = CurTab();
		// the section strip
		if (ct != mBody && Sections() > 1 && y >= SECY && y < SECY + SECH)
		{
			int first = -1, cnt = Sections();
			for (int i = 0; i < sTab.Size(); i++) if (sTab[i] == ct) { first = i; break; }
			double sw = (VW - 2 * LISTX) / double(cnt);
			int k = clamp(int((x - LISTX) / sw), 0, cnt - 1);
			if (first >= 0 && first + k != mStop) SetStop(first + k);
			return true;
		}
		// the figure's places
		if (ct == mBody && x >= LISTX && x < LISTX + LISTW && y >= 94 && y < PANELB)
		{
			for (int pl = 0; pl < PLACES.Size(); pl++)
			{
				int cx, cy, cw;
				[cx, cy, cw] = Chip(pl);
				if (abs(x - cx) > cw / 2 || abs(y - cy) > 10) continue;
				for (int i = 0; i < sTab.Size(); i++) if (sTab[i] == ct && sSec[i] == PLACES[pl]) { if (i != mStop) SetStop(i); break; }
				return true;
			}
			return true;
		}
		// the list
		double lx = ct == mBody ? DX - 6 : LISTX, lw = ct == mBody ? VW - LISTX - DX + 6 : LISTW;
		if (x >= lx && x < lx + lw && y >= ListY() && y < ListY() + Rows() * RowHeight())
		{
			int r = mTop + int((y - ListY()) / RowHeight());
			if (r < mShown.Size())
			{
				if (r == mSel) Act();
				else { mSel = r; MenuSound("menu/cursor"); }
			}
		}
		return true;
	}

	// ---------------------------------------------------------------------------------------------- drawing

	void Frame()
	{
		double w = Screen.GetWidth(), h = Screen.GetHeight();
		s = min(w / VW, h / VH);
		ox = (w - VW * s) / 2;
		oy = (h - VH * s) / 2;
	}

	// a colour by name (RSQ Score's TEXTCOLO); the engine's own when Score is not loaded
	static int Col(String name)
	{
		int c = Font.FindFontColor(name);
		if (c != Font.FindFontColor('RSQ_HowTo_NoSuchColour')) return c;
		if (name == "RSScore_Gold") return Font.CR_GOLD;
		if (name == "RSScore_Efficiency") return Font.CR_RED;
		if (name == "RSScore_Style") return Font.CR_GREEN;
		if (name == "RSScore_Daring") return Font.CR_ORANGE;
		if (name == "RSScore_Melee") return Font.CR_LIGHTBLUE;
		if (name == "RSScore_Counter") return Font.CR_PURPLE;
		return Font.CR_WHITE;
	}

	void Txt(Font f, int col, double x, double y, String t, double k = 1.0, double alpha = 1.0, double kx = 0)
	{
		if (kx <= 0) kx = k;
		Screen.DrawText(f, col, ox + x * s, oy + y * s, t, DTA_ScaleX, s * kx, DTA_ScaleY, s * k, DTA_Alpha, alpha);
	}

	// solid boxes (Screen.Clear), as the Glossary: Screen.Dim read much darker under Brutal Doom on the rig
	void Box(Color c, double a, double x, double y, double w, double h)
	{
		int x0 = int(ox + x * s), y0 = int(oy + y * s);
		Screen.Clear(x0, y0, x0 + int(w * s), y0 + int(h * s), Color(int(c.r * a), int(c.g * a), int(c.b * a)));
	}

	// text on one line, narrowed to fit w (down to `least` of k), else cut with ".."
	void Fit(Font f, int col, double x, double y, double w, String t, double k, double least = 0.6, double alpha = 1.0)
	{
		double tw = f.StringWidth(t) * k;
		if (tw <= w) { Txt(f, col, x, y, t, k, alpha); return; }
		double kx = k * w / max(1, tw);
		if (kx >= k * least) { Txt(f, col, x, y, t, k, alpha, kx); return; }
		kx = k * least;
		String c = t;
		while (c.Length() > 1 && (f.StringWidth(c .. "..") * kx) > w) c = c.Left(c.Length() - 1);
		Txt(f, col, x, y, c .. "..", k, alpha, kx);
	}

	// "Label: value": the label in gold, the value in white, wrapped under it when long; returns the y under it
	double Labeled(Font f, int lc, int vc, double x, double y, double w, String label, String val, double k, bool draw = true)
	{
		double lw = f.StringWidth(label .. " ") * k;
		if (draw) Txt(f, lc, x, y, label, k);
		BrokenLines bl = f.BreakLines(val, int(max(w - lw, 40) / k));
		double lh = f.GetHeight() * k + 3;
		for (int i = 0; i < bl.Count(); i++) { if (draw) Txt(f, vc, x + lw, y, bl.StringAt(i), k); y += lh; }
		return bl.Count() > 0 ? y : y + lh;
	}

	double Para(Font f, int col, double x, double y, double w, String t, double k, bool draw = true)
	{
		BrokenLines bl = f.BreakLines(t, int(w / k));
		double lh = f.GetHeight() * k + 3;
		for (int i = 0; i < bl.Count(); i++) { if (draw) Txt(f, col, x, y, bl.StringAt(i), k); y += lh; }
		return y;
	}

	// the detail of row e from y down to the panel's foot: its name (unless `noTitle`), the paragraph, then each label and
	// its text, at the largest size from TS down to TSMIN that fits
	void Detail(int e, double x, double y, double w, bool noTitle)
	{
		int white = Col("RSScore_White"), gold = Col("RSScore_Gold");
		int fc = Col(rColour[e]);
		// the name in big letters when it fits one line (a longer one is the DO line's start: shown there, not twice)
		String nm = rLabel[e];
		double nk = min(1.0, (w - 4) / max(1, fBig.StringWidth(nm)));
		if (!noTitle && nk >= 0.75) { Txt(fBig, fc, x, y, nm, nk); y += fBig.GetHeight() * nk + 10; }
		Array<String> p;
		rPairs[e].Split(p, "~");
		double k = TS;
		while (k > TSMIN)
		{
			double yy = y;
			if (rPara[e].Length() > 0) yy = Para(fSmall, white, x, yy, w, rPara[e], k, false) + 10;
			for (int i = 0; i + 1 < p.Size(); i += 2) yy = Labeled(fSmall, gold, white, x, yy, w, p[i], p[i + 1], k, false) + 6;
			if (yy <= PANELB - 2) break;
			k -= 0.1;
		}
		k = max(k, TSMIN);
		if (rPara[e].Length() > 0) y = Para(fSmall, white, x, y, w, rPara[e], k) + 10;
		// the label in gold and the value in white, drawn apart (the Glossary: a colour code inside the line drew a stray "?")
		for (int i = 0; i + 1 < p.Size(); i += 2) y = Labeled(fSmall, gold, white, x, y, w, p[i], p[i + 1], k) + 6;
	}

	double, double TabGeometry()
	{
		int n = tName.Size();
		if (n > TABSHOWN) return LISTX + ARROW, (VW - 2 * LISTX - 2 * ARROW) / double(TABSHOWN);
		return LISTX, (VW - 2 * LISTX) / double(max(n, 1));
	}

	// the place's spot on the marine: OFF and MAIN are the other hand when left-handed, as their chips
	int PtOf(int pl)
	{
		if (mHanded && PLACES[pl] == "OFF") return pl + 1;
		if (mHanded && PLACES[pl] == "MAIN") return pl - 1;
		return pl;
	}

	int, int, int Chip(int pl)
	{
		// the figure is your body as you wear it, your left on the left; the off hand is the left one unless left-handed
		int at = pl;
		if (mHanded && PLACES[pl] == "OFF") at = pl + 1;
		else if (mHanded && PLACES[pl] == "MAIN") at = pl - 1;
		return CHIPX[at], CHIPY[pl], CHIPW[pl];
	}

	override void Drawer()
	{
		Frame();
		int white = Col("RSScore_White");
		int gold  = Col("RSScore_Gold");

		Screen.Clear(0, 0, Screen.GetWidth(), Screen.GetHeight(), Color(8, 8, 8));

		// title
		double tk = 1.4;
		String title = "HOW TO RIP AND TEAR";   // owner 2026-11-27: the title only; the Options row stays "How To Play"
		Txt(fBig, gold, (VW - fBig.StringWidth(title) * tk) / 2, 12, title, tk);

		// the tab strip: TABSHOWN at a time, "<" / ">" at its ends while tabs lie beyond
		int nt = tName.Size();
		int ct = CurTab();
		double x0, tw;
		[x0, tw] = TabGeometry();
		for (int i = 0; i < min(nt, TABSHOWN); i++)
		{
			int t = mTabFirst + i;
			if (t >= nt) break;
			double tx = x0 + i * tw;
			bool on = (t == ct);
			if (on) { Box(0x606060, 0.6, tx + 2, TABY, tw - 4, TABH); Box(0xFFFFFF, 0.8, tx + 2, TABY + TABH - 2, tw - 4, 2); }
			else    Box(0x303030, 0.6, tx + 2, TABY, tw - 4, TABH);
			String nm = tName[t];
			double k = min(1.25, (tw - 12) / max(1, fSmall.StringWidth(nm)));
			Txt(fSmall, Col(tColour[t]), tx + (tw - fSmall.StringWidth(nm) * k) / 2, TABY + TABH / 2 - fSmall.GetHeight() * k / 2, nm, k, on ? 1.0 : 0.55);
		}
		if (nt > TABSHOWN)
		{
			bool more0 = mTabFirst > 0, more1 = mTabFirst + TABSHOWN < nt;
			double ak = 1.4;
			Txt(fSmall, more0 ? gold : white, LISTX + (ARROW - fSmall.StringWidth("<") * ak) / 2, TABY + TABH / 2 - fSmall.GetHeight() * ak / 2, "<", ak, more0 ? 1.0 : 0.25);
			Txt(fSmall, more1 ? gold : white, VW - LISTX - ARROW + (ARROW - fSmall.StringWidth(">") * ak) / 2, TABY + TABH / 2 - fSmall.GetHeight() * ak / 2, ">", ak, more1 ? 1.0 : 0.25);
		}

		if (ct >= 0 && ct == mControls) DrawControls(white, gold);
		else if (ct < 0 || mShown.Size() == 0)
		{
			Para(fSmall, white, 30, 110, VW - 60, "NOTHING HERE YET.", TS);
		}
		else if (ct == mBody) DrawBody(white, gold);
		else DrawList(white, gold);

		// footer
		bool show = mShown.Size() > 0 && rKind[mShown[mSel]] != 0;
		String hint = show ? "UP/DOWN: CHOOSE     LEFT/RIGHT: TAB     SELECT: SHOW     BACK: CLOSE"
			: (ct >= 0 && ct == mControls ? "LEFT/RIGHT: TAB     BACK: CLOSE" : "UP/DOWN: CHOOSE     LEFT/RIGHT: TAB     BACK: CLOSE");
		Txt(fSmall, white, (VW - fSmall.StringWidth(hint) * 1.1) / 2, VH - 22, hint, 1.1, 0.75);

		Super.Drawer();
	}

	// THE CONTROLS TAB (owner 2026-11-27 11:33): RSQoopaControls as design/readme_art/screens/keys_buttons.png draws it,
	// two panels, BUTTON / PRESS / DOUBLE PRESS / RIGHT GRIP + PRESS, a dash where nothing is; the rows GENERATED from the
	// ini in the picture's own words (RSQCT_HowToData.CTL_OFF / CTL_MAIN), the note under them too.
	// LEFT-HANDED (vr_control_scheme 10 or more, as mHanded): QuestZDoom swaps the hands. It hands HandleInput_Default the
	// LEFT controller as the dominant one with X / Y as its two buttons, and the right one as the off hand with A / B
	// (questzdoom a85c819 Projects/Android/jni/QzDoom/QzDoom_OpenXR.cpp:397-416); the dominant grip is the modifier
	// (VrInputDefault.cpp:51-55) and the key names follow the role, not the controller (VrInputDefault.cpp:338-484). So the
	// panel that says LEFT CONTROLLER shows the main hand's rows, X / Y stand where A / B stood (and the other way round),
	// and the modifier column is the left grip.
	void DrawControls(int white, int gold)
	{
		double y = CTLY;
		y = CtlPanel("LEFT CONTROLLER", mHanded, y, white, gold) + CTLGAP;
		y = CtlPanel("RIGHT CONTROLLER", !mHanded, y, white, gold);
		double nk = 0.9, w = VW - 2 * LISTX;
		String n1 = RSQCT_HowToData.CTL_NOTE, n2 = RSQCT_HowToData.CTL_NOTE2;
		Fit(fSmall, gold, LISTX + max(0, (w - fSmall.StringWidth(n1) * nk) / 2), y + 4, w, n1, nk, 0.6);
		Fit(fSmall, white, LISTX + max(0, (w - fSmall.StringWidth(n2) * nk) / 2), y + 4 + fSmall.GetHeight() * nk + 4, w, n2, nk, 0.6, 0.8);
	}

	// one panel: its title, the column heads, its rows (the main hand's or the off hand's); returns the y under it
	double CtlPanel(String title, bool isMain, double y, int white, int gold)
	{
		int n = isMain ? RSQCT_HowToData.CTL_NMAIN : RSQCT_HowToData.CTL_NOFF;
		double w = VW - 2 * LISTX;
		double h = CTLHEAD + n * CTLROWH + 4;
		Box(0x202020, 0.7, LISTX, y, w, h);
		Box(0x806020, 1.0, LISTX, y, w, 1);
		double tk = 1.2;
		Txt(fSmall, Col("RSScore_Efficiency"), LISTX + (w - fSmall.StringWidth(title) * tk) / 2, y + 4, title, tk);
		for (int c = 0; c < 4; c++) Fit(fSmall, gold, CTLX[c], y + 17, ColW(c) - 6, CtlColTitle(c), 1.0, 0.6);
		for (int i = 0; i < n; i++)
		{
			String line = isMain ? RSQCT_HowToData.CTL_MAIN[i] : RSQCT_HowToData.CTL_OFF[i];
			Array<String> f;
			line.Split(f, "|");
			while (f.Size() < 4) f.Push("-");
			double ry = y + CTLHEAD + i * CTLROWH;
			if (i % 2 == 0) Box(0x303030, 0.7, LISTX + 4, ry - 2, w - 8, CTLROWH);
			for (int c = 0; c < 4; c++)
			{
				String v = c == 0 ? Physical(f[0]) : f[c];
				bool dashed = c > 0 && v == "-";
				Fit(fSmall, c == 0 ? Col("RSScore_Style") : white, CTLX[c], ry, ColW(c) - 6, v, 1.0, 0.6, dashed ? 0.35 : 1.0);
			}
		}
		return y + h;
	}

	String CtlColTitle(int c)
	{
		if (c == 0) return "BUTTON";
		if (c == 1) return "PRESS";
		if (c == 2) return "DOUBLE PRESS";
		return mHanded ? "LEFT GRIP + PRESS" : "RIGHT GRIP + PRESS";
	}

	double ColW(int c) { return c < 3 ? CTLX[c + 1] - CTLX[c] : CTLRIGHT - CTLX[c]; }

	// a face button's name on the controller in your hand: left-handed, X / Y are the main hand's and A / B the off hand's
	String Physical(String b)
	{
		if (!mHanded) return b;
		if (b == "A") return "X";
		if (b == "B") return "Y";
		if (b == "X") return "A";
		if (b == "Y") return "B";
		return b;
	}

	// a mod's tab: Score's Glossary laid out as it is, a section strip over it when the tab has sections
	void DrawList(int white, int gold)
	{
		int ct = CurTab();
		int nsec = Sections();
		if (nsec > 1)
		{
			int first = -1;
			for (int i = 0; i < sTab.Size(); i++) if (sTab[i] == ct) { first = i; break; }
			double sw = (VW - 2 * LISTX) / double(nsec);
			for (int k = 0; k < nsec; k++)
			{
				double sx = LISTX + k * sw;
				bool on = first + k == mStop;
				if (on) { Box(0x606060, 0.6, sx + 2, SECY, sw - 4, SECH); Box(0xFFFFFF, 0.8, sx + 2, SECY + SECH - 2, sw - 4, 2); }
				else    Box(0x303030, 0.6, sx + 2, SECY, sw - 4, SECH);
				String nm = sSec[first + k];
				int col = white;
				for (int i = 0; i < rTab.Size(); i++) if (rTab[i] == ct && rSec[i] == nm) { col = Col(rColour[i]); break; }
				double kk = min(1.1, (sw - 10) / max(1, fSmall.StringWidth(nm)));
				Txt(fSmall, col, sx + (sw - fSmall.StringWidth(nm) * kk) / 2, SECY + SECH / 2 - fSmall.GetHeight() * kk / 2, nm, kk, on ? 1.0 : 0.55);
			}
		}

		int rows = Rows(), ly = ListY();
		Box(0x202020, 0.7, LISTX, ly - 6, LISTW, rows * ROWH + 12);
		double lh = fSmall.GetHeight() * LS;
		for (int r = 0; r < rows && mTop + r < mShown.Size(); r++)
		{
			int i = mShown[mTop + r];
			double ry = ly + r * ROWH;
			if (mTop + r == mSel) Box(0x707070, 0.55, LISTX + 2, ry - 2, LISTW - 14, ROWH - 2);
			int fc = rKind[i] != 0 ? gold : Col(rColour[i]);
			double vw = rValue[i].Length() > 0 ? fSmall.StringWidth(rValue[i]) * 1.0 : 0;
			double room = LISTW - 30 - (vw > 0 ? vw + 8 : 0);
			double nw = fSmall.StringWidth(rLabel[i]) * LS;
			if (nw * 0.75 <= room || rKind[i] != 0)
			{
				// one line: the Glossary's own, a long name narrowed beside its value
				double ty = ry + (ROWH - 2 - lh) / 2 - 2;
				Fit(fSmall, fc, LISTX + 8, ty, room, rLabel[i], LS, 0.75);
			}
			else
			{
				// a long name: two lines at the footer's size
				double k2 = 1.0, h2 = fSmall.GetHeight() * k2;
				BrokenLines bl = fSmall.BreakLines(rLabel[i], int(room / k2));
				double ty = ry + (ROWH - 2 - (2 * h2 + 2)) / 2 - 1;
				Fit(fSmall, fc, LISTX + 8, ty, room, bl.Count() > 0 ? bl.StringAt(0) : rLabel[i], k2, 0.8);
				if (bl.Count() > 1)
				{
					String rest = bl.StringAt(1);
					for (int b = 2; b < bl.Count(); b++) rest = rest .. " " .. bl.StringAt(b);
					Fit(fSmall, fc, LISTX + 8, ty + h2 + 2, room, rest, k2, 0.8);
				}
			}
			if (vw > 0) Txt(fSmall, white, LISTX + LISTW - 20 - vw, ry + (ROWH - 2 - fSmall.GetHeight()) / 2 - 2, rValue[i], 1.0);
		}
		ScrollBar(LISTX + LISTW - 9, ly, rows, ROWH);

		// detail
		int e = mShown[mSel];
		double dx = DX, dw = VW - LISTX - dx;
		Box(0x202020, 0.7, dx - 6, ly - 6, dw + 6, PANELB - ly + 6);
		Detail(e, dx + 4, ly + 2, dw - 12, false);
	}

	void ScrollBar(double x, double y, int rows, int rowh)
	{
		if (mShown.Size() <= rows) return;
		double bh = rows * rowh;
		double th = max(12.0, bh * rows / mShown.Size());
		double tyb = y + (bh - th) * mTop / double(mShown.Size() - rows);
		Box(0x404040, 1.0, x, y, 5, bh);
		Box(0xC0C0C0, 1.0, x, tyb, 5, th);
	}

	// the body tab: the flat figure (left), the place's moves and the picked one's DO / GET (right)
	void DrawBody(int white, int gold)
	{
		int ct = CurTab();
		String here = sSec[mStop];
		// the figure: your body as you wear it, your left on the left
		Box(0x202020, 0.7, LISTX, 94, LISTW, PANELB - 94);
		TextureID mar = TexMan.CheckForTexture("PLAYA1", TexMan.Type_Sprite);
		if (mar.IsValid())
		{
			Vector2 msz = TexMan.GetScaledSize(mar);
			Screen.DrawTexture(mar, false, ox + MARX * s, oy + MARY * s, DTA_DestWidthF, msz.x * MARS * s, DTA_DestHeightF, msz.y * MARS * s,
				DTA_LeftOffset, 0, DTA_TopOffset, 0, DTA_FlipX, true);
			// a line from each chip to its spot on him, and the spot; the picked place's in gold
			for (int pl = 0; pl < PLACES.Size(); pl++)
			{
				bool on = PLACES[pl] == here;
				int cx, cy, cw;
				[cx, cy, cw] = Chip(pl);
				Color lc = on ? Color(255, 255, 208, 48) : Color(255, 150, 150, 150);
				for (int h = 0; h < 2; h++)
				{
					int at = PLACES[pl] == "BOTH" ? 7 + h : PtOf(pl);
					if (h == 1 && PLACES[pl] != "BOTH") break;
					double px = MARX + PTX[at] * MARS, py = MARY + PTY[at] * MARS;
					Screen.DrawLine(int(ox + cx * s), int(oy + cy * s), int(ox + px * s), int(oy + py * s), lc, on ? 255 : 150);
					Box(on ? 0xFFD030 : 0x969696, 1.0, px - 2, py - 2, 4, 4);
				}
			}
		}
		else for (int b = 0; b + 3 < FIG.Size(); b += 4) Box(0x3A3A3A, 1.0, FIG[b], FIG[b + 1], FIG[b + 2], FIG[b + 3]);
		for (int pl = 0; pl < PLACES.Size(); pl++)
		{
			bool has = false;
			for (int i = 0; i < sTab.Size(); i++) if (sTab[i] == ct && sSec[i] == PLACES[pl]) { has = true; break; }
			bool on = PLACES[pl] == here;
			int cx, cy, cw;
			[cx, cy, cw] = Chip(pl);
			// a chip: a dark box with a grey edge; the picked one the tabs' grey with their white underline
			Box(on ? 0x909090 : 0x505050, 1.0, cx - cw / 2 - 1, cy - 11, cw + 2, 22);
			if (on) { Box(0x606060, 0.9, cx - cw / 2, cy - 10, cw, 20); Box(0xFFFFFF, 0.8, cx - cw / 2, cy + 8, cw, 2); }
			else    Box(0x101010, 1.0, cx - cw / 2, cy - 10, cw, 20);
			String nm = PLACENAME[pl];
			double k = min(1.0, (cw - 6) / max(1, fSmall.StringWidth(nm)));
			Txt(fSmall, on ? gold : white, cx - fSmall.StringWidth(nm) * k / 2, cy - fSmall.GetHeight() * k / 2, nm, k, on ? 1.0 : (has ? 0.8 : 0.25));
		}

		// the place's moves
		double dx = DX, dw = VW - LISTX - dx;
		Box(0x202020, 0.7, dx - 6, 94, dw + 6, PANELB - 94);
		int moves = 0;
		for (int i = 0; i < mShown.Size(); i++) if (rKind[mShown[i]] == 0) moves++;
		String head = "";
		for (int pl = 0; pl < PLACES.Size(); pl++) if (PLACES[pl] == here) head = PLACENAME[pl];
		head = String.Format("%s: %d %s", head, moves, moves == 1 ? "MOVE" : "MOVES");
		Fit(fSmall, Col(tColour[ct]), dx + 2, 98, dw - 8, head, 1.25);
		int rows = Rows(), ly = ListY();
		for (int r = 0; r < rows && mTop + r < mShown.Size(); r++)
		{
			int i = mShown[mTop + r];
			double ry = ly + r * BODYROWH;
			if (mTop + r == mSel) Box(0x707070, 0.55, dx - 4, ry - 2, dw - 6, BODYROWH - 2);
			double vw = rValue[i].Length() > 0 ? fSmall.StringWidth(rValue[i]) * 0.9 : 0;
			double room = dw - 16 - (vw > 0 ? vw + 8 : 0);
			double ty = ry + (BODYROWH - 2 - fSmall.GetHeight() * 1.2) / 2 - 1;
			Fit(fSmall, rKind[i] != 0 ? gold : Col(rColour[i]), dx + 2, ty, room, rLabel[i], 1.2, 0.6);
			if (vw > 0) Txt(fSmall, white, dx + dw - 12 - vw, ry + (BODYROWH - 2 - fSmall.GetHeight() * 0.9) / 2 - 1, rValue[i], 0.9, 0.8);
		}
		ScrollBar(dx + dw - 7, ly, rows, BODYROWH);
		// the picked move: DO / GET under the list
		double dy = ly + rows * BODYROWH + 6;
		Box(0x404040, 1.0, dx, dy - 4, dw - 8, 1);
		Detail(mShown[mSel], dx + 2, dy + 2, dw - 10, true);
	}
}

// THE "How To Play" ROW: first in Radiant Silvergun Options, one row even with an older series pk3 that adds its own (each
// copy's Init is handed the menu it is added to and takes away any How To Play row already there, as the rsmenu link row
// does).
// Radiant Silvergun Options sorts its rows by the series' order when it opens (rsmenu Arrange), and a page it does not
// know goes last; this row moves itself back to the top, with a blank line under it, on the menu's first tic (an option
// menu ticks its rows before it draws them). An older copy added to Options itself (RSQ PlayLog's, before 2026-11-27)
// takes itself away whenever Radiant Silvergun Options exists, which RSQ Controls always defines.
// In Radiant Silvergun Options it also puts the Use RSQoopaControls row (below) right under itself, once.
class OptionMenuItemRSQCTHowToLink : OptionMenuItemSubmenu
{
	OptionMenuItemRSQCTHowToLink Init(OptionMenuDescriptor desc, String label, Name command)
	{
		if (desc)
		{
			for (int i = desc.mItems.Size() - 1; i >= 0; i--)
			{
				let it = desc.mItems[i];
				if (!it) continue;
				String cn = it.GetClassName();
				if (cn.IndexOf("HowToLink") >= 0) desc.mItems.Delete(i);
			}
		}
		Super.Init(label, command);
		return self;
	}

	override void Ticker()
	{
		let m = OptionMenu(Menu.GetCurrentMenu());
		if (!m || !m.mDesc) return;
		let d = m.mDesc;
		int at = -1;
		for (int i = 0; i < d.mItems.Size(); i++) if (d.mItems[i] == self) { at = i; break; }
		if (at < 0) return;
		if (d.mMenuName == 'RSQ_RSOptions')
		{
			// the Use RSQoopaControls row sits right under this one (one row, whichever copy made it)
			int sc = -1;
			for (int i = 0; i < d.mItems.Size(); i++)
			{
				if (!d.mItems[i]) continue;
				String cn = d.mItems[i].GetClassName();
				if (cn.IndexOf("StdControls") >= 0) { sc = i; break; }
			}
			if (at == 0 && sc == 1) return;
			OptionMenuItem std;
			if (sc >= 0) { std = d.mItems[sc]; d.mItems.Delete(sc); }
			else std = new("OptionMenuItemRSQCTStdControls").Init(OptionMenuItemRSQCTStdControls.LABEL);
			for (int i = 0; i < d.mItems.Size(); i++) if (d.mItems[i] == self) { d.mItems.Delete(i); break; }
			int last = d.mItems.Size() - 1;
			if (last >= 0 && IsBlank(d.mItems[last])) d.mItems.Delete(last);
			d.mItems.Insert(0, self);
			d.mItems.Insert(1, std);
			if (d.mItems.Size() > 2 && !IsBlank(d.mItems[2])) d.mItems.Insert(2, new("OptionMenuItemStaticText").Init(" "));
			d.mSelectedItem = 0;
			d.mScrollPos = 0;
		}
		else if (MenuDescriptor.GetDescriptor('RSQ_RSOptions'))
		{
			d.mItems.Delete(at);
			if (d.mSelectedItem >= at && d.mSelectedItem > 0) d.mSelectedItem--;
		}
	}

	static bool IsBlank(OptionMenuItem it)
	{
		return it && (it is "OptionMenuItemStaticText") && (it.mLabel == " " || it.mLabel == "");
	}
}

// CONTROLS: RSQOOPACONTROLS / MY OWN (owner 2026-11-27; the name RSQoopaControls, owner 11:23; "i want this mod loaded and
// the ability to swap to and from my control scheme", owner 15:50; design/controls/CONTROLS.md): the row right under How
// To Play in Radiant Silvergun Options (the How To Play row above puts it there). ONE row, drawn as the engine's Option
// rows are (OptionMenuItemOptionBase.Draw, gzdoom qzd17.3 wadsrc/static/zscript/engine/ui/menu/optionmenuitems.zs:
// 353-361; the series' own pages are Option rows): the label "Controls", and in the value colour which set is on now,
// "RSQoopaControls" or "My Own". One press, then the engine's own yes / no prompt, worded as OptionMenuItemSafeCommand
// words it (optionmenuitems.zs:287-297, "$SAFEMESSAGE"), switches to the other set.
// - TO RSQOOPACONTROLS (UseOurs; also the first-launch screen's Yes): first the player's own set is saved, then every
//   line of design/controls/rsq_standard_controls.ini is written: [Doom.Bindings] into the engine's binds,
//   [Doom.DoubleBindings] into its double-press binds (a line with nothing after "=" empties that button), [CVars] sets
//   each named CVar (vr_crouch_use_button=false: natural crouch on). No other key or CVar is touched.
// - THE SAVE (SaveOwn): what every key the ini names is bound to now (normal and double, an empty bind as empty) and the
//   value of every [CVars] CVar, into rsqct_own_controls (Controls/CVARINFO.txt, nosave: kept in the engine's ini, not in
//   savegames; d_main.cpp:1714-1717 CVAR_CONFIG_ONLY, gameconfigfile.cpp:946-953). Only when the set on now is NOT
//   already RSQoopaControls (IsOurs: every ini line already in force), so switching twice never saves ours over his.
//   The string: "v1|" then "B:Key=command|", "D:Key=command|", "C:name=value|"; "%", "|", CR and LF in a value are
//   written %25, %7C, %0D, %0A (Esc). The engine writes a config value as it is, on one line, and reads it back to the
//   line's end, trimming only the ends (src/common/utility/configfile.cpp:654-730, :820-830); the string starts with
//   "v1|" and ends with "|", so nothing is trimmed.
// - TO MY OWN (UseOwn): every saved line written back as it was: an empty one unbinds. Nothing saved yet (the set on is
//   RSQoopaControls and was never switched to from another): a notice says so and nothing changes.
// The three lists below and LAYOUT_ID (the first-launch screen asks once per id) are GENERATED from the ini by
// tools/howtoplay/gen_howtoplay.py: never type them. The class keeps its name (StdControls): the How To Play row finds
// it by that name in every copy, old builds included.
// HOW (gzdoom qzd17.3): KeyBindings.SetBind(key, command) (ui/menu/menu.zs:36-47) on the globals Bindings and
// DoubleBindings (zscript/engine/base.zs:199-201), the call the engine's own Customize Controls rows make. Its native
// (src/common/scripting/interface/vmnatives.cpp:1083-1098) refuses outside menu code; the yes arrives as MKEY_MBYes from the
// prompt (ui/menu/messagebox.zs:184) through the option menu to its selected row (ui/menu/optionmenu.zs:376-378), inside
// the menu's own event call (src/common/menu/menu.cpp:316-326). An empty command is an empty bind (c_bind.h:64-68).
// A key name to its code by the engine's own names: KeyBindings.NameKeys(k, 0) gives KeyNames[k] (src/common/console/
// c_bind.cpp:228-237, :268-282), the table the ini's names are read from (GetKeyFromName, c_bind.cpp:172-191), for every
// key below NUM_KEYS (src/common/console/keydef.h:138).
// THE CVARS (gzdoom qzd17.3): CVar.FindCVar(name), then SetBool / SetInt / SetFloat / SetString by its GetRealType()
// (zscript/engine/base.zs:685-712). The natives refuse a CVar the engine defined (not CVAR_MOD) outside menu code by the
// same test as SetBind, DMenu::InMenu (src/common/scripting/interface/vmnatives.cpp:947-958 SetInt, :981-991 SetFloat,
// :1014-1025 SetString); the yes runs inside CallMenuEvent, which raises InMenu (src/common/menu/menu.cpp:316-326).
// SetBool is SetInt (base.zs:706); a Bool CVar takes it as non-zero (src/common/console/c_cvars.cpp:712-715 DoSet,
// :308-333 ToBool), through SetGenericRep, which drops it only for CVAR_NOSET or a latched CVar (c_cvars.cpp:279-305).
// vr_crouch_use_button is CVAR_ARCHIVE | CVAR_GLOBALCONFIG, no NOSET, no LATCH (src/common/rendering/hwrenderer/data/
// hw_vrmodes.cpp:122), so it is saved in [GlobalSettings] at exit like any such CVar (src/gameconfigfile.cpp:987-989).
class OptionMenuItemRSQCTStdControls : OptionMenuItemSubmenu
{
	const LABEL = "Controls";
	const OURS = "RSQoopaControls";
	const OWN = "My Own";
	const SAVED = "rsqct_own_controls";
	const SAVE_TAG = "v1|";
	const NUM_KEYS = 0x1C4;  // keydef.h:138

	// GENERATED by tools/howtoplay/gen_howtoplay.py from design/controls/rsq_standard_controls.ini: do not edit,
	// change the ini and re-run it. Each line as the ini has it: Key=command (nothing after "=": that button emptied);
	// in CVARS name=value. LAYOUT_ID: these lines' id (layout_id); the first-launch screen asks once per id.
	const LAYOUT_ID = 1129514440;
	static const String BINDS[] =    // [Doom.Bindings]
	{
		"Shift=+oh_attack",
		"Alt=+oh_altatk",
		"RThumb=",
		"Axis1Plus=+moveright",
		"Axis1Minus=+moveleft",
		"Axis2Plus=+forward",
		"Axis2Minus=+back",
		"Space=rsqsm_toggle",
		"Home=rsqsm_dodge",
		"Pad_X=ssq_draw",
		"Pad_Y=invnext",
		"PgDn=netevent bonsai-show-info",
		"PgUp=invuse",
		"RTrigger=+attack",
		"LTrigger=+altattack",
		"MWheelUp=+jump",
		"Axis8Plus=+user1",
		"MWheelDown=+zoom",
		"Axis8Minus=+reload",
		"Axis7Minus=weapprev",
		"Axis7Plus=weapnext",
		"Pad_A=+use",
		"LThumb=+user3",
		"Pad_B=rsqtr_recenter",
		"Backspace=menu_main",
		"Enter=+rsqgr_hook",
		"Tab=+wr_wheel"
	};
	static const String DOUBLEBINDS[] =    // [Doom.DoubleBindings]
	{
		"Space=brutaltaunt",
		"Enter=brutaltaunt",
		"RThumb=",
		"Pad_Y=togglemap",
		"Pad_A=slot 3",
		"Pad_B=netevent rsqgd_randomize"
	};
	static const String CVARS[] =    // [CVars]
	{
		"vr_crouch_use_button=false"
	};

	bool mToOwn;     // what the open yes / no asks: true back to My Own, false to RSQoopaControls
	bool mOurs;      // RSQoopaControls is on (IsOurs), looked at every REFRESH tics while the menu is open
	int mTics;
	const REFRESH = 10;

	OptionMenuItemRSQCTStdControls Init(String label)
	{
		Super.Init(label, 'None');
		mOurs = IsOurs();
		return self;
	}

	override void Ticker()
	{
		if (mTics++ % REFRESH == 0) mOurs = IsOurs();
	}

	// as an Option row: the label, and the set that is on in the value colour
	override int Draw(OptionMenuDescriptor desc, int y, int indent, bool selected)
	{
		drawLabel(indent, y, selected ? OptionMenuSettings.mFontColorSelection : OptionMenuSettings.mFontColor);
		drawValue(indent, y, OptionMenuSettings.mFontColorValue, mOurs ? OURS : OWN, false, false);
		return indent;
	}

	override bool Activate()
	{
		mOurs = IsOurs();
		if (mOurs && !HasSaved())
		{
			Menu.StartMessage(String.Format("%sNothing of your own is saved yet.%s\n\nYour own buttons are saved\nwhen you switch from them\nto %s.", TEXTCOLOR_WHITE, TEXTCOLOR_NORMAL, OURS), 1);
			return true;
		}
		mToOwn = mOurs;
		String target = mToOwn ? "My Own Controls" : OURS;
		Menu.StartMessage(String.Format("%sSwitch to %s%s\n\n%s", TEXTCOLOR_WHITE, target, TEXTCOLOR_NORMAL, StringTable.Localize("$SAFEMESSAGE")), 0);
		return true;
	}

	override bool MenuEvent(int mkey, bool fromcontroller)
	{
		if (mkey == Menu.MKEY_MBYes)
		{
			if (mToOwn) UseOwn();
			else UseOurs();
			mOurs = IsOurs();
			Menu.MenuSound("menu/choose");
			return true;
		}
		return Super.MenuEvent(mkey, fromcontroller);
	}

	static int KeyCode(String name)
	{
		for (int k = 1; k < NUM_KEYS; k++) if (KeyBindings.NameKeys(k, 0) ~== name) return k;
		return 0;
	}

	// "name=value" lines, as the ini's [CVars] has them; set by the CVar's own type
	static void SetCVar(String line)
	{
		int eq = line.IndexOf("=");
		if (eq <= 0) return;
		String name = line.Left(eq);
		String val = line.Mid(eq + 1);
		let cv = CVar.FindCVar(name);
		if (!cv) { Console.Printf("%s: no CVar named %s", OURS, name); return; }
		switch (cv.GetRealType())
		{
		case CVar.CVAR_Bool:
			if (val ~== "true" || val == "1") cv.SetBool(true);
			else if (val ~== "false" || val == "0") cv.SetBool(false);
			else Console.Printf("%s: %s is a true / false CVar, not %s", OURS, name, val);
			break;
		case CVar.CVAR_Int:
			cv.SetInt(val.ToInt(10));
			break;
		case CVar.CVAR_Float:
			cv.SetFloat(val.ToDouble());
			break;
		default:
			cv.SetString(val);
			break;
		}
	}

	// "name=value": that CVar has that value now (by its own type). A CVar the engine lacks counts as matching
	static bool CVarIs(String line)
	{
		int eq = line.IndexOf("=");
		if (eq <= 0) return true;
		String val = line.Mid(eq + 1);
		let cv = CVar.FindCVar(line.Left(eq));
		if (!cv) return true;
		switch (cv.GetRealType())
		{
		case CVar.CVAR_Bool: return cv.GetBool() == (val ~== "true" || val == "1");
		case CVar.CVAR_Int: return cv.GetInt() == val.ToInt(10);
		case CVar.CVAR_Float: return abs(cv.GetFloat() - val.ToDouble()) < 0.00001;
		}
		return cv.GetString() == val;
	}

	// "Key=command" lines, as the ini has them
	static void Write(bool dbl, String line)
	{
		int eq = line.IndexOf("=");
		if (eq <= 0) return;
		String key = line.Left(eq);
		String cmd = line.Mid(eq + 1);
		int k = KeyCode(key);
		if (k <= 0) { Console.Printf("%s: no key named %s", OURS, key); return; }
		if (dbl) DoubleBindings.SetBind(k, cmd);
		else Bindings.SetBind(k, cmd);
	}

	// "Key=command": that key is bound to exactly that now (case aside). A key the engine lacks counts as matching
	static bool BoundAs(bool dbl, String line)
	{
		int eq = line.IndexOf("=");
		if (eq <= 0) return true;
		int k = KeyCode(line.Left(eq));
		if (k <= 0) return true;
		String now = dbl ? DoubleBindings.GetBinding(k) : Bindings.GetBinding(k);
		return now ~== line.Mid(eq + 1);
	}

	// RSQoopaControls is on: every line of the ini is in force now
	static bool IsOurs()
	{
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.BINDS.Size(); i++) if (!BoundAs(false, OptionMenuItemRSQCTStdControls.BINDS[i])) return false;
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.DOUBLEBINDS.Size(); i++) if (!BoundAs(true, OptionMenuItemRSQCTStdControls.DOUBLEBINDS[i])) return false;
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.CVARS.Size(); i++) if (!CVarIs(OptionMenuItemRSQCTStdControls.CVARS[i])) return false;
		return true;
	}

	static String Esc(String s)
	{
		s.Replace("%", "%25");
		s.Replace("|", "%7C");
		s.Replace("\r", "%0D");
		s.Replace("\n", "%0A");
		return s;
	}

	static String Unesc(String s)
	{
		s.Replace("%0A", "\n");
		s.Replace("%0D", "\r");
		s.Replace("%7C", "|");
		s.Replace("%25", "%");
		return s;
	}

	static bool HasSaved()
	{
		let cv = CVar.FindCVar(SAVED);
		return cv && cv.GetString().Left(SAVE_TAG.Length()) == SAVE_TAG;
	}

	// one list's keys as they are bound now, "B:" or "D:" lines
	static void SaveKeys(out String s, bool dbl, String tag)
	{
		int n = dbl ? OptionMenuItemRSQCTStdControls.DOUBLEBINDS.Size() : OptionMenuItemRSQCTStdControls.BINDS.Size();
		for (int i = 0; i < n; i++)
		{
			String line = dbl ? OptionMenuItemRSQCTStdControls.DOUBLEBINDS[i] : OptionMenuItemRSQCTStdControls.BINDS[i];
			int eq = line.IndexOf("=");
			if (eq <= 0) continue;
			String key = line.Left(eq);
			int k = KeyCode(key);
			if (k <= 0) continue;
			s.AppendFormat("%s%s=%s|", tag, key, Esc(dbl ? DoubleBindings.GetBinding(k) : Bindings.GetBinding(k)));
		}
	}

	// the set on now, for every key and CVar the ini names, into rsqct_own_controls
	static void SaveOwn()
	{
		let cv = CVar.FindCVar(SAVED);
		if (!cv) return;
		String s = SAVE_TAG;
		SaveKeys(s, false, "B:");
		SaveKeys(s, true, "D:");
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.CVARS.Size(); i++)
		{
			String line = OptionMenuItemRSQCTStdControls.CVARS[i];
			int eq = line.IndexOf("=");
			if (eq <= 0) continue;
			String name = line.Left(eq);
			let c = CVar.FindCVar(name);
			if (c) s.AppendFormat("C:%s=%s|", name, Esc(c.GetString()));
		}
		cv.SetString(s);
		Console.PrintfEx(PRINT_LOG, "%s: your own controls saved: %s", OURS, s);
	}

	// every saved line written back as it was (an empty bind unbinds). Only from a menu's event call
	static void RestoreOwn()
	{
		let cv = CVar.FindCVar(SAVED);
		if (!cv) return;
		Array<String> parts;
		cv.GetString().Split(parts, "|");
		int n = 0;
		for (int i = 1; i < parts.Size(); i++)
		{
			String p = parts[i];
			if (p.Length() < 4 || p.Mid(1, 1) != ":") continue;
			String kind = p.Left(1);
			String rest = p.Mid(2);
			int eq = rest.IndexOf("=");
			if (eq <= 0) continue;
			String line = rest.Left(eq) .. "=" .. Unesc(rest.Mid(eq + 1));
			if (kind == "B") Write(false, line);
			else if (kind == "D") Write(true, line);
			else if (kind == "C") SetCVar(line);
			else continue;
			n++;
		}
		Console.PrintfEx(PRINT_LOG, "%s: your own controls written back (%d lines)", OURS, n);
	}

	// to RSQoopaControls: the player's own set saved first (unless RSQoopaControls is already on), then every ini line.
	// Only from a menu's event call (KeyBindings.SetBind and an engine CVar's Set refuse outside one: see above)
	static void UseOurs()
	{
		if (!IsOurs()) SaveOwn();
		ApplyAll();
		Console.PrintfEx(PRINT_LOG, "%s: on", OURS);
	}

	// back to the player's own set, when one is saved
	static void UseOwn()
	{
		if (HasSaved()) RestoreOwn();
	}

	// every line of the ini
	static void ApplyAll()
	{
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.BINDS.Size(); i++) Write(false, OptionMenuItemRSQCTStdControls.BINDS[i]);
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.DOUBLEBINDS.Size(); i++) Write(true, OptionMenuItemRSQCTStdControls.DOUBLEBINDS[i]);
		for (int i = 0; i < OptionMenuItemRSQCTStdControls.CVARS.Size(); i++) SetCVar(OptionMenuItemRSQCTStdControls.CVARS[i]);
	}
}

// THE FIRST-LAUNCH SCREEN (owner 2026-11-27 11:3x): the first time RSQ_Controls.pk3 loads, a yes / no screen
// (OptionMenu "RSQCT_FirstRun", RSQ Controls' MENUDEF) offers RSQoopaControls. Yes saves the player's own set and writes
// every line of the ini, as the Options row does (OptionMenuItemRSQCTStdControls.UseOurs), so Options > Radiant Silvergun
// Options > Controls can switch back to it; No changes nothing; Back is No. Asked once per layout: the
// CVar rsqct_layout_asked (Controls/CVARINFO.txt, saved) takes the layout's LAYOUT_ID as the screen opens, so it never
// asks again until the ini's lines change.
// WHY A MENU: the engine lets only menu code bind keys. KeyBindings.SetBind is a fatal error unless DMenu::InMenu is
// raised (gzdoom qzd17.3 src/common/scripting/interface/vmnatives.cpp:1083-1098), and only a menu's input and event
// calls raise it (src/common/menu/menu.cpp:277-326, CallResponder and CallMenuEvent). A row's Activate runs inside them:
// Enter reaches it through OptionMenu.MenuEvent, a click through the menu's input call.
// THE HOOK: a StaticEventHandler's UiTick, which the engine calls every tic in every game state, the title screen
// included (src/g_game.cpp:1429 G_Ticker: primaryLevel->localEventManager->UiTick(), which calls the static handlers
// first, src/events.cpp:640, :675-678). Once the game has run WAIT tics and no menu is open, it opens the screen with
// Menu.SetMenu (wadsrc/static/zscript/engine/ui/menu/menu.zs:144).
class RSQCT_FirstRun : StaticEventHandler
{
	const WAIT = 35;         // a second after the first tic: the title is up
	const ASKED = "rsqct_layout_asked";
	ui int mTics;            // ui: the handler is play scope (events.zs:147) and UiTick writes these
	ui bool mDone;

	override void UiTick()
	{
		if (mDone) return;
		let cv = CVar.FindCVar(ASKED);
		if (!cv || cv.GetInt() == OptionMenuItemRSQCTStdControls.LAYOUT_ID) { mDone = true; return; }
		if (++mTics < WAIT) return;
		if (gamestate != GS_DEMOSCREEN && gamestate != GS_TITLELEVEL && gamestate != GS_LEVEL) return;
		if (Menu.GetCurrentMenu()) return;   // a menu is open: wait until it closes
		mDone = true;
		cv.SetInt(OptionMenuItemRSQCTStdControls.LAYOUT_ID);
		Menu.SetMenu('RSQCT_FirstRun');
	}
}

// the first-launch screen's two rows: RSQCTAnswer "Yes ...", 1  and  RSQCTAnswer "No ...", 0  (RSQ Controls' MENUDEF)
class OptionMenuItemRSQCTAnswer : OptionMenuItemSubmenu
{
	bool mYes;

	OptionMenuItemRSQCTAnswer Init(String label, int yes)
	{
		Super.Init(label, 'None');
		mYes = yes != 0;
		return self;
	}

	override bool Activate()
	{
		if (mYes)
		{
			OptionMenuItemRSQCTStdControls.UseOurs();
			Menu.MenuSound("menu/choose");
		}
		else Menu.MenuSound("menu/backup");
		let m = Menu.GetCurrentMenu();
		if (m) m.Close();
		return true;
	}
}

// THE FIRST-RUN LINE (owner 2026-11-27: "THINK OF SOMETHING"; F1 is not a key in a headset): on the first map of a new
// game, 5 seconds in, one short line says where How To Play is: as RSQ VisualRewards' toast when it is loaded (its
// RSQVR_Service "toast", by name), else a plain print. Once a game: a later map, a reload or a respawn never shows it.
// RSQ Controls has this handler; with an older series pk3 that has its own copy, only the copy whose How To service
// sorts first (RSQCT_HowToService.Leader) speaks.
class RSQCT_HowToStart : StaticEventHandler
{
	const SHOW_AT = 175;     // tics into the first map
	bool fresh, armed;

	override void NewGame() { fresh = true; }

	override void WorldLoaded(WorldEvent e)
	{
		armed = fresh && !e.IsSaveGame;
		fresh = false;
	}

	override void WorldTick()
	{
		if (!armed || level.maptime < SHOW_AT) return;
		armed = false;
		if (!RSQCT_HowToService.Leader()) return;
		String where = "HOW TO PLAY: OPTIONS > RADIANT SILVERGUN OPTIONS";   // RSQ Controls always defines it
		Service vr = null;
		let it = ServiceIterator.Find("RSQVR_Service");
		Service s;
		while (s = it.Next()) if (s.GetClassName() == 'RSQVR_Service') { vr = s; break; }
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (!playeringame[i] || !players[i].mo) continue;
			if (!vr || vr.GetInt("toast", "info|" .. where, 0, 0, players[i].mo) <= 0) players[i].mo.A_Print(where);
		}
	}
}
