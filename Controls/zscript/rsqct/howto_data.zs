		r.Push("DARING|RSScore_Daring|GLASS|+24|||A SNIPER RIFLE OR RAILGUN KILL FROM VERY FAR AWAY, AIMED DOWN THE GUN.|BONUS:~+24 ON AN IMP; +36 FROM TWICE AS FAR~NEEDS:~NOTHING EXTRA");
		r.Push("DARING|RSScore_Daring|GLASS CANNON|+21|||KILL A BLACK CHAMPION IN ONE BLOW FROM FULL HEALTH.|BONUS:~+21 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|GOLD CHAMPION|+45|||KILL A GOLD CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+45 ON AN IMP~NEEDS:~CHAMPIONS");
