	static void Rows(int m, out Array<String> r)
	{
		switch (m)
		{
		case 0: RowsTacticalRig(r); break;
		case 1: RowsQuestSaber(r); break;
		case 2: RowsShieldSaw(r); break;
		case 3: RowsMelee(r); break;
		case 4: RowsWhip(r); break;
		case 5: RowsGrenade(r); break;
		case 6: RowsFlashFlare(r); break;
		case 7: RowsGrapple(r); break;
		case 8: RowsDistanceGrab(r); break;
		case 9: RowsLaserSight(r); break;
		case 10: RowsSlowMo(r); break;
		case 11: RowsScore(r); break;
		case 12: RowsMiniboss(r); break;
		case 13: RowsVisualRewards(r); break;
		case 14: RowsGunCards(r); break;
		case 15: RowsWheel(r); break;
		case 16: RowsGlowInTheDark(r); break;
		case 17: RowsGunBonsaiOffhandVR(r); break;
		case 18: RowsMonsters(r); break;
		case 19: RowsGraveyard(r); break;
		case 20: RowsPlayLog(r); break;
		}
	}

	// RSQ Tactical Rig (TacticalRig/README.md)
	static void RowsTacticalRig(out Array<String> r)
	{
		r.Push("||BRING A HAND NEAR A HOLSTER||LHIP RHIP CHEST LSH RSH|||DO:~BRING A HAND NEAR A HOLSTER: A HIP, EITHER SIDE OF THE CHEST, OVER A SHOULDER~GET:~A WIRE RING SHOWS THERE IF A GRIP BY THAT HAND WOULD DO SOMETHING. THE NEAREST SUCH RING IS BRIGHT, THE OTHERS FAINT. WITH THE HAND INSIDE, THE RING CHANGES COLOUR AND GROWS, AND THAT HAND TICKS ONCE~NEEDS:~HOLSTER RINGS: ON (DEFAULT)");
		r.Push("||HOLD A GUN IN THE MAIN HAND INSIDE AN EMPTY HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE||LHIP RHIP CHEST LSH RSH MAIN|holster||DO:~HOLD A GUN IN THE MAIN HAND INSIDE AN EMPTY HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE~GET:~THE GUN GOES IN AND THE HOLSTER BECOMES THAT GUN'S OWN (THE FIRST TIME, THE RING FLASHES AND THE GUN'S PICTURE SHOWS OVER IT). THE HAND GOES TO ITS FIST. ONE PULSE AND A HOLSTER SOUND~NEEDS:~GRIP HOLSTERS: ON (DEFAULT) FOR THE GRIP, USE HOLSTERS: ON (DEFAULT) FOR USE; THE HAND MUST HAVE BEEN INSIDE 3 TICS (PRESS DELAY); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||PUT THE EMPTY MAIN HAND IN A FULL HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE||LHIP RHIP CHEST LSH RSH MAIN|draw||DO:~PUT THE EMPTY MAIN HAND IN A FULL HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE~GET:~THAT GUN IS DRAWN INTO THE MAIN HAND. ONE PULSE AND A DRAW SOUND~NEEDS:~GRIP HOLSTERS: ON, USE HOLSTERS: ON (DEFAULTS); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SQUEEZE THE OFF HAND'S GRIP IN A HOLSTER||LHIP RHIP CHEST LSH RSH OFF|offdraw||DO:~SQUEEZE THE OFF HAND'S GRIP IN A HOLSTER~GET:~THE OFF HAND DOES THE SAME FOR ITSELF: A GUN IT HOLDS GOES IN, AN EMPTY OFF HAND DRAWS THE HOLSTER'S GUN INTO THE OFF HAND. HOLSTER WITH ONE HAND AND DRAW WITH THE OTHER TO MOVE A GUN ACROSS~NEEDS:~GRIP HOLSTERS: ON (DEFAULT)");
		r.Push("||PRESS USE WITH ONLY THE OFF HAND IN A PLACE||OFF|||DO:~PRESS USE WITH ONLY THE OFF HAND IN A PLACE~GET:~THE PRESS IS THE OFF HAND'S. WITH THE MAIN HAND IN ANY PLACE, USE IS THE MAIN HAND'S AND THE OFF HAND'S PLACE IS NOT PRESSED~NEEDS:~USE HOLSTERS: ON (DEFAULT)");
		r.Push("||SQUEEZE A GRIP WITH THAT HAND IN NO PLACE|||||DO:~SQUEEZE A GRIP WITH THAT HAND IN NO PLACE~GET:~NOTHING FROM THE RIG. THE RIG NEVER EATS THE GRIP KEY, SO THE GAME KEEPS WHATEVER ELSE THE GRIP DOES");
		r.Push("||PUT A GUN THAT HAS ITS OWN HOLSTER INTO ANOTHER GUN'S FULL HOLSTER|||||DO:~PUT A GUN THAT HAS ITS OWN HOLSTER INTO ANOTHER GUN'S FULL HOLSTER~GET:~AT ONCE, YOUR GUN GOES HOME TO ITS OWN HOLSTER (A STREAK OF LIGHT RUNS TO IT) AND THE GUN THAT WAS IN THIS HOLSTER COMES TO YOUR HAND~NEEDS:~QUICK SWAP: ON (DEFAULT) SKIPS THE PRESS DELAY; MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||PUT A GUN THAT HAS NO HOLSTER INTO ANOTHER GUN'S FULL HOLSTER|||||DO:~PUT A GUN THAT HAS NO HOLSTER INTO ANOTHER GUN'S FULL HOLSTER~GET:~AT ONCE, THAT HOLSTER'S GUN COMES TO YOUR HAND. YOUR GUN LEAVES THE HAND AND STAYS CARRIED, IN NO HOLSTER~NEEDS:~SWAP AT HOLSTER: TO WHEEL (DEFAULT); QUICK SWAP: ON (DEFAULT); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||PUT A GUN THAT HAS ITS OWN HOLSTER INTO A DIFFERENT, EMPTY HOLSTER|||||DO:~PUT A GUN THAT HAS ITS OWN HOLSTER INTO A DIFFERENT, EMPTY HOLSTER~GET:~IT GOES HOME TO ITS OWN HOLSTER (THE STREAK OF LIGHT) AND THE HAND GOES TO ITS FIST~NEEDS:~MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||PUT A GUN THAT HAS NO HOLSTER INTO AN EMPTY HOLSTER THAT BELONGS TO ANOTHER GUN|||||DO:~PUT A GUN THAT HAS NO HOLSTER INTO AN EMPTY HOLSTER THAT BELONGS TO ANOTHER GUN~GET:~IT TAKES THAT HOLSTER OVER: THE HOLSTER IS NOW THIS GUN'S, THE RING FLASHES AND SHOWS ITS PICTURE, AND THE OTHER GUN HAS NO HOLSTER~NEEDS:~MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SQUEEZE A GRIP WITH AN EMPTY HAND IN AN EMPTY HOLSTER|||||DO:~SQUEEZE A GRIP WITH AN EMPTY HAND IN AN EMPTY HOLSTER~GET:~REFUSED: A DOUBLE PULSE AND DOOM'S \"USE FAILED\" SOUND. NOTHING IS DRAWN~NEEDS:~MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SWITCH AWAY FROM A GUN THAT HAS A HOLSTER SO IT IS IN NEITHER HAND|||||DO:~SWITCH AWAY FROM A GUN THAT HAS A HOLSTER (A KEY, A WHEEL, NEXT WEAPON) SO IT IS IN NEITHER HAND~GET:~AFTER 10 TICS IT IS BACK IN ITS OWN HOLSTER, IF THAT HOLSTER IS EMPTY");
		r.Push("||TAKE A HOLSTERED GUN INTO A HAND SOME OTHER WAY|||||DO:~TAKE A HOLSTERED GUN INTO A HAND SOME OTHER WAY (A KEY, A WHEEL)~GET:~AFTER 3 TICS THE HOLSTER SHOWS EMPTY. IT IS STILL THAT GUN'S");
		r.Push("||SQUEEZE A GRIP JUST AFTER YOUR HAND SLIPPED OUT OF A SHOULDER HOLSTER||LSH RSH|||DO:~SQUEEZE A GRIP JUST AFTER YOUR HAND SLIPPED OUT OF A SHOULDER HOLSTER (WITHIN 10 TICS)~GET:~THE PRESS STILL COUNTS AT THAT SHOULDER~NEEDS:~MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||BRING A HAND NEAR A FULL HOLSTER - AMMO LIGHT: ON|||||DO:~BRING A HAND NEAR A FULL HOLSTER~GET:~A SMALL LIGHT SITS IN THE RING: GREEN WITH HALF A MAGAZINE OR MORE, YELLOW WHEN LOW OR NEEDING A RELOAD, RED AND PULSING WHEN EMPTY. AN ARC ROUND IT SHOWS HOW FULL THE GUN IS~NEEDS:~AMMO LIGHT: ON (DEFAULT); THE RING MUST BE SHOWING");
		r.Push("||LOOK AT A HOLSTER WITH A GUN IN IT|||||DO:~LOOK AT A HOLSTER WITH A GUN IN IT~GET:~THE GUN HANGS THERE: MUZZLE DOWN AT THE HIPS, ACROSS THE CHEST, ON YOUR BACK OVER THE SHOULDERS~NEEDS:~SHOW STORED GUNS: ON (DEFAULT); A GUN THE RIG HAS MEASURED");
		r.Push("||SQUEEZE EITHER HAND'S GRIP, OR PRESS USE, AT THE BELT BUCKLE||BELT|nade||DO:~SQUEEZE EITHER HAND'S GRIP, OR PRESS USE, AT THE BELT BUCKLE (THE GRENADE SPOT)~GET:~THE HAND GRENADE COMES TO THE MAIN HAND, WHICHEVER HAND PRESSED. WITH NONE LEFT: REFUSED. A GRENADE HANGS AT THE BUCKLE WHILE YOU HAVE ONE. WITH A HAND NEAR, THE SPOT'S LIGHT SITS ON TOP OF THE GRENADE: GREEN TWO OR MORE, YELLOW ONE, RED NONE (A REFUSED PRESS FLASHES IT)~NEEDS:~GRENADE SPOT: ON (DEFAULT); A HAND GRENADE WEAPON LOADED (BRUTAL DOOM'S, OR RSQ GRENADE'S)");
		r.Push("||SQUEEZE A GRIP AT THE GRENADE SPOT WITH THE GRENADE IN THE MAIN HAND||BELT MAIN|||DO:~SQUEEZE A GRIP AT THE GRENADE SPOT WITH THE GRENADE IN THE MAIN HAND~GET:~THE GUN YOU HELD BEFORE COMES BACK~NEEDS:~GRENADE SPOT: ON (DEFAULT); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||LOOK DOWN AT YOUR BELT, TO THE OFF HAND'S SIDE OF THE BUCKLE||BELT|||DO:~LOOK DOWN AT YOUR BELT, TO THE OFF HAND'S SIDE OF THE BUCKLE~GET:~THE KEYS YOU CARRY HANG ON A STEEL RING THERE, UP TO EIGHT, AND SWAY AS YOU MOVE~NEEDS:~KEYRING: ON (DEFAULT)");
		r.Push("||SQUEEZE THE MAIN HAND'S GRIP, OR PRESS USE, AT THE POCKET JUST LEFT OF YOUR BREASTBONE, 30 CM UNDER YOUR EYES||CHEST|cig||DO:~SQUEEZE THE MAIN HAND'S GRIP, OR PRESS USE, AT THE POCKET JUST LEFT OF YOUR BREASTBONE, 30 CM UNDER YOUR EYES (JUST RIGHT OF IT FOR A LEFT-HANDED LAYOUT)~GET:~A CIGARETTE IS IN THE MAIN HAND AND A ZIPPO IN THE OFF HAND. THE POCKET HOLDS ONE FEWER. WITH NONE LEFT: A WEAK TICK~NEEDS:~CIGARETTES: ON (DEFAULT); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SQUEEZE THE MAIN GRIP AT THE POCKET WITH THE CIGARETTE IN THAT HAND||CHEST|||DO:~SQUEEZE THE MAIN GRIP AT THE POCKET WITH THE CIGARETTE IN THAT HAND~GET:~IT GOES BACK IN THE POCKET AND BOTH HANDS GET BACK WHAT THEY HELD~NEEDS:~CIGARETTES: ON (DEFAULT); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||PRESS USE WITH THE CIGARETTE AT YOUR LIPS, OR WITHIN A THIRD OF A SECOND OF LEAVING THERE||MOUTH|mouth||DO:~PRESS USE WITH THE CIGARETTE AT YOUR LIPS (FROM THE LIPS TO JUST UNDER THE CHIN), OR WITHIN A THIRD OF A SECOND OF LEAVING THERE~GET:~IT GOES IN YOUR MOUTH AND STAYS, AND THE MAIN HAND HAS ITS GUN BACK. COMING INTO REACH GIVES A GLOW AT THE TIP, A TICK AND A SOFT SOUND~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||PRESS USE WITH THE CIGARETTE IN THE HAND, ANYWHERE ELSE|||||DO:~PRESS USE WITH THE CIGARETTE IN THE HAND, ANYWHERE ELSE~GET:~IT IS FLICKED AWAY AND USED UP~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||PRESS USE AT A DOOR, A SWITCH OR A HOLSTER WHILE A CIGARETTE IS OUT|||||DO:~PRESS USE AT A DOOR, A SWITCH OR A HOLSTER WHILE A CIGARETTE IS OUT~GET:~NOTHING: USE IS THE CIGARETTE'S UNTIL THE RITUAL ENDS~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||PRESS THE OFF HAND'S FIRE WITH THE ZIPPO AWAY FROM THE CIGARETTE'S TIP||OFF|||DO:~PRESS THE OFF HAND'S FIRE WITH THE ZIPPO AWAY FROM THE CIGARETTE'S TIP~GET:~THE ZIPPO FLICKS OPEN AND LIT, OR SHUT~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||PRESS THE OFF HAND'S FIRE WITH THE ZIPPO'S FLAME AT THE TIP OF THE CIGARETTE IN YOUR MOUTH||MOUTH OFF|||DO:~PRESS THE OFF HAND'S FIRE WITH THE ZIPPO'S FLAME AT THE TIP OF THE CIGARETTE IN YOUR MOUTH~GET:~IT LIGHTS. YOU SMOKE FOR 2 SECONDS, THEN IT FLICKS OUT OF YOUR MOUTH AND YOU EXHALE. RSQ SLOWMO IS ASKED FOR 15 SECONDS OF SLOW TIME AT 25% SPEED~NEEDS:~CIGARETTES: ON (DEFAULT); SMOKE SLOWS TIME: ON (DEFAULT) AND RSQ SLOWMO FOR THE SLOW TIME");
		r.Push("||PRESS USE WHILE SMOKING|||||DO:~PRESS USE WHILE SMOKING~GET:~IT FLICKS OUT NOW. THE SLOW TIME STARTS THE SAME WAY~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||SQUEEZE THE MAIN GRIP AT YOUR MOUTH WITH AN UNLIT CIGARETTE IN IT||MOUTH MAIN|||DO:~SQUEEZE THE MAIN GRIP AT YOUR MOUTH WITH AN UNLIT CIGARETTE IN IT~GET:~IT COMES BACK OUT INTO THE MAIN HAND~NEEDS:~CIGARETTES: ON (DEFAULT); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||LEAVE A CIGARETTE UNLIT IN YOUR MOUTH FOR 7 SECONDS||MOUTH|||DO:~LEAVE A CIGARETTE UNLIT IN YOUR MOUTH FOR 7 SECONDS~GET:~IT DROPS AND IS USED UP. NO SLOW TIME~NEEDS:~UNLIT GOES AWAY: ON (DEFAULT)");
		r.Push("||WITH A CIGARETTE OUT, PRESS A KEY BOUND TO NEXT WEAPON, PREVIOUS WEAPON, A SLOT OR SWITCH HANDS, PICK FROM A WHEEL, OR SQUEEZE A GRIP IN A HOLSTER|||||DO:~WITH A CIGARETTE OUT, PRESS A KEY BOUND TO NEXT WEAPON, PREVIOUS WEAPON, A SLOT OR SWITCH HANDS, PICK FROM A WHEEL, OR SQUEEZE A GRIP IN A HOLSTER~GET:~THE RITUAL ENDS AT ONCE. UNLIT, IT GOES BACK IN THE POCKET. LIT, IT COUNTS AS SMOKED AND THE SLOW TIME STARTS. THEN THE SWITCH OR THE HOLSTER PRESS IS CARRIED OUT; NEXT AND PREVIOUS STEP FROM THE GUN YOU HELD BEFORE THE CIGARETTE~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||FLICK A SMOKED BUTT ONTO THE FLOOR|||||DO:~FLICK A SMOKED BUTT ONTO THE FLOOR~GET:~IT SMOULDERS THERE FOR 10 TO 30 SECONDS AND MONSTERS NEAR IT GO FOR IT~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||HOLD BOTH HANDS AGAINST YOUR CHEST FOR 0.4 SECONDS, WITH NO GRIP, USE OR FIRE HELD||CHEST BOTH|recenter||DO:~HOLD BOTH HANDS AGAINST YOUR CHEST (ABOUT 12 CM IN FRONT OF AND 30 CM UNDER YOUR EYES) FOR 0.4 SECONDS, WITH NO GRIP, USE OR FIRE HELD~GET:~THE TORSO, AND EVERY PLACE ON IT, TURNS TO WHERE YOUR HEAD FACES. A SOFT CLICK AND A TICK IN BOTH HANDS~NEEDS:~RECENTER BY HANDS: ON (DEFAULT)");
		r.Push("||PRESS RECENTER TORSO|KEY:rsqtr_recenter||||DO:~PRESS RECENTER TORSO (NO KEY BY DEFAULT)~GET:~THE SAME RECENTER");
		r.Push("||TURN WITH THE STICK, SNAP OR SMOOTH|||||DO:~TURN WITH THE STICK, SNAP OR SMOOTH~GET:~THE TORSO AND ITS PLACES TURN WITH YOU, EXACTLY");
		r.Push("||LOOK AROUND OR NOD WITHOUT TURNING YOUR BODY|||||DO:~LOOK AROUND OR NOD WITHOUT TURNING YOUR BODY~GET:~THE PLACES STAY WHERE THEY ARE. A NOD DOES NOT SLIDE THEM FORWARD~NEEDS:~HANG FROM NECK: ON (DEFAULT) FOR THE NOD");
		r.Push("||TURN YOUR REAL BODY IN THE ROOM AND KEEP YOUR HEAD MORE THAN BODY TURN ANGLE OFF THE TORSO FOR BODY TURN DELAY, WITH NO HAND IN A PLACE OR REACHING FAR TO THE SIDE, AND NOT LOOKING DOWN|||||DO:~TURN YOUR REAL BODY IN THE ROOM AND KEEP YOUR HEAD MORE THAN BODY TURN ANGLE OFF THE TORSO (DEFAULT 35 DEGREES) FOR BODY TURN DELAY (DEFAULT 1 SECOND), WITH NO HAND IN A PLACE OR REACHING FAR TO THE SIDE, AND NOT LOOKING DOWN~GET:~THE TORSO EASES ROUND TO YOUR HEAD~NEEDS:~TORSO FOLLOWS ROOM: ON (DEFAULT)");
		r.Push("||STAND STILL FOR 2 SECONDS THE FIRST TIME YOU PLAY|||||DO:~STAND STILL FOR 2 SECONDS THE FIRST TIME YOU PLAY~GET:~YOUR EYE HEIGHT IS MEASURED AND THE WHOLE RIG IS SCALED TO YOU (BETWEEN 70% AND 130%)~NEEDS:~STANDING; HEIGHT NOT MEASURED YET");
		r.Push("||CHOOSE MEASURE HEIGHT ON THE RIG'S PAGE WHILE STANDING STRAIGHT|||||DO:~CHOOSE MEASURE HEIGHT ON THE RIG'S PAGE WHILE STANDING STRAIGHT~GET:~THE SAME MEASUREMENT, ON DEMAND. A MESSAGE GIVES THE HEIGHT AND THE SCALE");
		r.Push("||LOOK DOWN AT YOURSELF|||||DO:~LOOK DOWN AT YOURSELF~GET:~YOU WEAR A TORSO. THE MARINE'S IS GREEN, BLUE WITH BLUE ARMOUR. UNDER 35 HEALTH A RED COPY BREATHES OVER IT. IT FADES AS YOU LOOK FURTHER DOWN~NEEDS:~TORSO: ON (DEFAULT), TORSO STYLE: DOOM MARINE (DEFAULT), TORSO FADES: ON (DEFAULT)");
		r.Push("||STAND AT A MIRROR IN A MAP|||||DO:~STAND AT A MIRROR IN A MAP~GET:~YOU SEE THE TORSO, A HELMET, AND COPIES OF WHAT YOUR HANDS HOLD. THE SPRITE MARINE IS HIDDEN THERE~NEEDS:~TORSO: ON (DEFAULT), HELMET: ON (DEFAULT)");
		r.Push("||HOLD A GUN IN THE MAIN HAND FOR 2 SECONDS, BEFORE YOU HAVE EVER HOLSTERED ONE BY HAND|||||DO:~HOLD A GUN IN THE MAIN HAND FOR 2 SECONDS, BEFORE YOU HAVE EVER HOLSTERED ONE BY HAND~GET:~A FAINT GHOST HAND MOVES FROM YOUR HAND TO A FREE HOLSTER AND BACK, AND THAT HOLSTER'S RING LIGHTS. IT IS GONE FOR GOOD ONCE ANY GUN GOES INTO A HOLSTER BY HAND~NEEDS:~BRUTAL DOOM 22 VR RELOADED FOR THE GHOST HAND'S MODEL; WITHOUT IT ONLY THE RING LIGHTS");
		r.Push("||PLAY THE FIRST MAP FOR ABOUT 10 SECONDS|||||DO:~PLAY THE FIRST MAP FOR ABOUT 10 SECONDS~GET:~ONCE EVER: \"HOLSTERS IN THE WRONG PLACE? BRING BOTH HANDS TO YOUR CHEST.\"~NEEDS:~RECENTER BY HANDS: ON (DEFAULT)");
		r.Push("||PUT A HAND IN AND OUT OF THE SAME PLACE THREE TIMES IN 6 SECONDS WITHOUT PRESSING|||||DO:~PUT A HAND IN AND OUT OF THE SAME PLACE THREE TIMES IN 6 SECONDS WITHOUT PRESSING~GET:~THAT PLACE'S RING SHOWS AT FULL STRENGTH FOR 3 SECONDS, AT MOST THREE TIMES A MAP");
		r.Push("||START A MAP, RESPAWN OR LOAD A SAVE|||||DO:~START A MAP, RESPAWN OR LOAD A SAVE~GET:~THE TORSO STARTS FACING WHERE YOUR HEAD FACES");
		r.Push("||GO TO THE NEXT LEVEL|||||DO:~GO TO THE NEXT LEVEL~GET:~EACH HOLSTER KEEPS ITS GUN AND ITS OWNER. A HOLSTER SHOWS A GUN ONLY WHILE YOU STILL OWN IT~NEEDS:~KEEP BETWEEN LEVELS: ON (DEFAULT)");
		r.Push("||DIE|||||DO:~DIE~GET:~EVERY RING, STORED GUN AND LIGHT IS HIDDEN UNTIL YOU LIVE AGAIN. A CIGARETTE THAT WAS OUT IS GONE");
		r.Push("||CHOOSE SAVE OR LOAD FOR ONE OF THE FOUR HOLSTER PROFILES|||||DO:~CHOOSE SAVE OR LOAD FOR ONE OF THE FOUR HOLSTER PROFILES~GET:~SAVE WRITES EVERY PLACE'S POSITION AND SIZE AND MAKES THAT PROFILE THE ONE IN USE. LOAD READS THEM BACK. THE RINGS TAKE THE PROFILE'S COLOUR: BLUE, ORANGE, PURPLE OR YELLOW");
		r.Push("||SQUEEZE THE MAIN GRIP AT THE SPOT JUST BELOW THE MAIN HAND'S HIP||MHIP MAIN|saber||DO:~SQUEEZE THE MAIN GRIP AT THE SPOT JUST BELOW THE MAIN HAND'S HIP~GET:~THE SABER IS DRAWN INTO THE MAIN HAND, OR PUT BACK. THE OFF HAND THERE IS REFUSED~NEEDS:~RSQ SABER; MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SQUEEZE THE OFF GRIP AT THE SPOT JUST BELOW THE OFF HAND'S HIP||OHIP OFF|offsaber||DO:~SQUEEZE THE OFF GRIP AT THE SPOT JUST BELOW THE OFF HAND'S HIP~GET:~THE SECOND SABER COMES OUT INTO THE OFF HAND, OR GOES BACK. THE MAIN HAND THERE IS REFUSED~NEEDS:~RSQ SABER, WITH ITS SECOND SABER ALLOWED");
		r.Push("||SQUEEZE A GRIP WITH A SABER IN THE HAND AT AN EMPTY GUN HOLSTER|||||DO:~SQUEEZE A GRIP WITH A SABER IN THE HAND AT AN EMPTY GUN HOLSTER~GET:~THE SABER GOES TO ITS OWN SPOT INSTEAD~NEEDS:~RSQ SABER; MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SQUEEZE THE GRIP OF THE WHIP'S HAND BEHIND AND OUTSIDE THE MAIN HAND'S SABER SPOT||MHIP|whip||DO:~SQUEEZE THE GRIP OF THE WHIP'S HAND BEHIND AND OUTSIDE THE MAIN HAND'S SABER SPOT~GET:~THE WHIP IS DRAWN, OR PUT AWAY. THE OTHER HAND THERE IS REFUSED. A WHIP PUT AT AN EMPTY GUN HOLSTER GOES TO ITS OWN HOLSTER~NEEDS:~RSQ WHIP; WHIP HOLSTER: ON (DEFAULT); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||SQUEEZE THE OFF GRIP BEHIND AND OUTSIDE THE OFF HAND'S SABER SPOT||OHIP|flare||DO:~SQUEEZE THE OFF GRIP BEHIND AND OUTSIDE THE OFF HAND'S SABER SPOT~GET:~AN UNLIT FLARE COMES UP INTO THE OFF HAND. WITH AN UNLIT FLARE IN THE HAND, IT GOES BACK. WITH NO FLARES: REFUSED~NEEDS:~RSQ FNF; FLARE HOLSTER: ON (DEFAULT)");
		r.Push("||SQUEEZE THE OFF GRIP AT ANY PLACE WITH A LIT FLARE IN THE OFF HAND||OFF|||DO:~SQUEEZE THE OFF GRIP AT ANY PLACE WITH A LIT FLARE IN THE OFF HAND~GET:~REFUSED, EVERYWHERE~NEEDS:~RSQ FNF");
		r.Push("||SQUEEZE A GRIP IN THE AMMO POUCH, BESIDE THE BUCKLE ON THE OFF HAND'S SIDE||BELT OFF|||DO:~SQUEEZE A GRIP IN THE AMMO POUCH, BESIDE THE BUCKLE ON THE OFF HAND'S SIDE~GET:~NOTHING FROM THE RIG. THE POUCH EASES UP TO 3.5 CM TOWARD THE OFF HAND AS IT COMES NEAR~NEEDS:~BRUTAL DOOM 22 VR RELOADED; AMMO POUCH: ON (DEFAULT), POUCH REACHES OUT: ON (DEFAULT)");
		r.Push("||SQUEEZE THE MAIN GRIP AT THE KEYRING, HOLD IT, AND TOUCH THE KEYS TO A LOCKED DOOR||BELT MAIN|keyring||DO:~SQUEEZE THE MAIN GRIP AT THE KEYRING, HOLD IT, AND TOUCH THE KEYS TO A LOCKED DOOR~GET:~THE KEYS ARE IN THAT HAND WHILE THE GRIP IS HELD. THE DOOR IS USED THROUGH THE GAME'S OWN LOCK CHECK: IT OPENS IF YOU HAVE THE KEY~NEEDS:~KEYS OPEN DOORS: ON (DEFAULT OFF); A KEY CARRIED");
		r.Push("||HOLD THE OFF GRIP AT THE KEYRING, BRING THE KEYS WITHIN 25 CM OF A LOCKED DOOR AND PRESS THE OFF HAND'S FIRE||BELT OFF|||DO:~HOLD THE OFF GRIP AT THE KEYRING, BRING THE KEYS WITHIN 25 CM OF A LOCKED DOOR AND PRESS THE OFF HAND'S FIRE~GET:~THE DOOR IS USED THE SAME WAY. THE OFF HAND'S WEAPON DOES NOT FIRE WHILE IT HOLDS THE KEYS~NEEDS:~KEYS OPEN DOORS: ON (DEFAULT OFF)");
		r.Push("||HOLDING THE KEYS IN THE OFF HAND AT A LOCKED DOOR, HOLD THE OFF HAND'S ALT FIRE AND RAISE THE HAND 12 CM||OFF|||DO:~HOLDING THE KEYS IN THE OFF HAND AT A LOCKED DOOR, HOLD THE OFF HAND'S ALT FIRE AND RAISE THE HAND 12 CM~GET:~THE DOOR IS USED. WITH RSQ DISTANCE GRAB THE DOOR LIFTS WITH YOUR HAND INSTEAD~NEEDS:~KEYS OPEN DOORS: ON (DEFAULT OFF)");
		r.Push("||PRESS A GRIP WITH THAT HAND SWINGING AT 2.5 METRES A SECOND OR MORE, OUTSIDE EVERY PLACE|||||DO:~PRESS A GRIP WITH THAT HAND SWINGING AT 2.5 METRES A SECOND OR MORE, OUTSIDE EVERY PLACE~GET:~THE GUN IN THAT HAND IS THROWN AND LANDS AS A PICKUP. ITS HOLSTER IS FREED, AND THE HAND GOES TO ITS FIST~NEEDS:~THROW GUNS: ON (DEFAULT OFF); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||PRESS USE WITH THE MAIN HAND SWINGING THAT FAST, OUTSIDE EVERY PLACE||MAIN|||DO:~PRESS USE WITH THE MAIN HAND SWINGING THAT FAST, OUTSIDE EVERY PLACE~GET:~THE MAIN HAND'S GUN IS THROWN THE SAME WAY~NEEDS:~THROW GUNS: ON AND THROW WITH USE: ON (BOTH DEFAULT OFF)");
		r.Push("||HIT A MONSTER WITH A THROWN GUN WITHIN 2 SECONDS OF THE THROW|||||DO:~HIT A MONSTER WITH A THROWN GUN WITHIN 2 SECONDS OF THE THROW~GET:~IT IS HURT BY THE GUN'S SIZE AND SPEED (1 TO 60), FLINCHES, FREEZES FOR 3 TICS AND IS SHOVED. THE GUN DROPS OFF IT~NEEDS:~THROW GUNS: ON (DEFAULT OFF); THROWN GUNS HURT: ON (DEFAULT)");
		r.Push("||PUT ANY GUN INTO ANOTHER GUN'S FULL HOLSTER|||||DO:~PUT ANY GUN INTO ANOTHER GUN'S FULL HOLSTER~GET:~THAT HOLSTER'S GUN COMES TO YOUR HAND AND YOUR GUN GOES IN: THE HOLSTER IS NOW YOUR GUN'S, AND THE OTHER GUN HAS NONE~NEEDS:~SWAP AT HOLSTER: TAKE HOLSTER (DEFAULT TO WHEEL)");
		r.Push("||HOLD THE WATCH CHECK POSE WITH A HAND AND PRESS USE||MAIN OFF|watch||DO:~HOLD THE WATCH CHECK POSE WITH A HAND AND PRESS USE~GET:~THAT HAND'S GUN MOVES TO THE OTHER HAND. A GUN IN THE OTHER HAND COMES BACK THE OTHER WAY~NEEDS:~MOVE GUN AT WATCH: ON (DEFAULT OFF); NO HAND IN A PLACE");
		r.Push("||PLAY SITTING DOWN|||||DO:~PLAY SITTING DOWN~GET:~THE RIG HANGS FROM YOUR SEATED EYES, NOT THE STANDING VIEW HEIGHT~NEEDS:~SEATED: ON (DEFAULT OFF)");
		r.Push("||LOAD OR SAVE A SEATED PROFILE|||||DO:~LOAD OR SAVE A SEATED PROFILE (SEATED A OR B)~GET:~THE HIPS AND THE BELT SPOTS THAT WERE NEVER MOVED SIT HIGHER AND FURTHER FORWARD. ONCE EVER: \"SEATED: YOUR HIP AND BELT SPOTS SIT HIGHER AND FORWARD.\"~NEEDS:~A SEATED HOLSTER PROFILE");
		r.Push("||SQUEEZE A GRIP, OR PRESS USE, IN A PLACE, CARRY IT AND LET GO|||||DO:~SQUEEZE A GRIP, OR PRESS USE, IN A PLACE, CARRY IT AND LET GO~GET:~THE PLACE MOVES WITH YOUR HAND AND STAYS WHERE YOU LET GO. A MESSAGE GIVES ITS NEW POSITION. NOTHING IS HOLSTERED OR DRAWN WHILE THIS IS ON, AND EVERY RING SHOWS~NEEDS:~MOVE HOLSTERS BY HAND: ON (DEFAULT OFF); MAIN GRIP: SECONDARY BUTTON MAPPINGS OFF (ENGINE)");
		r.Push("||TURN MOVE HOLSTERS BY HAND ON|||||DO:~TURN MOVE HOLSTERS BY HAND ON~GET:~A MIRROR STANDS ONE METRE IN FRONT OF YOU: YOUR FRONT AND YOUR BACK SIDE BY SIDE, WITH THE TORSO, EVERY RING, WHAT EACH PLACE HOLDS AND YOUR TWO HANDS~NEEDS:~MIRROR: WHILE MOVING (DEFAULT); ALWAYS SHOWS IT ALL THE TIME");
		r.Push("||BRING A HAND NEAR A FULL HOLSTER - AMMO COUNT: ON|||||DO:~BRING A HAND NEAR A FULL HOLSTER~GET:~THE GUN'S ROUNDS SHOW AS A SMALL NUMBER AT THE RING'S FAR EDGE FROM YOU, FACING YOU~NEEDS:~AMMO COUNT: ON (DEFAULT OFF)");
		r.Push("||PUT A GUN INTO ANOTHER GUN'S FULL HOLSTER WITH QUICK SWAP OFF|||||DO:~PUT A GUN INTO ANOTHER GUN'S FULL HOLSTER WITH QUICK SWAP OFF~GET:~THE SAME SWAP, AFTER THE PRESS DELAY~NEEDS:~QUICK SWAP: OFF (DEFAULT ON)");
		r.Push("||TURN YOUR HEAD AND BOTH HANDS TOGETHER, OR HOLD YOUR HEAD TURNED|||||DO:~TURN YOUR HEAD AND BOTH HANDS TOGETHER, OR HOLD YOUR HEAD TURNED~GET:~THE TORSO TURNS WITH THEM AT ONCE (HEAD AND HANDS TURN), OR EASES ROUND AFTER THE BODY TURN DELAY ONCE PAST THE BODY TURN ANGLE (TORSO CATCHES UP)~NEEDS:~HEAD AND HANDS TURN: ON OR TORSO CATCHES UP: ON (BOTH DEFAULT OFF)");
		r.Push("||SQUEEZE THE OFF GRIP AT THE OFF SHOULDER HOLSTER WITH RSQ SHIELDSAW'S SAW MOUNTED THERE||OSH OFF|shield||DO:~SQUEEZE THE OFF GRIP AT THE OFF SHOULDER HOLSTER WITH RSQ SHIELDSAW'S SAW MOUNTED THERE~GET:~SAW ON THE SHOULDER: IT COMES INTO THE OFF HAND. SAW IN THE OFF HAND: IT GOES BACK TO THE SHOULDER. SAW THROWN: REFUSED. USE THERE DOES NOTHING FOR THE SAW~NEEDS:~RSQ SHIELDSAW, ITS SAW MOUNTED FROM RSQ WHEEL'S HOLSTER ASSIGNMENT SCREEN; SHOULDER FOR SHIELD: ON (DEFAULT)");
	}

	// RSQ Saber (QuestSaber/README.md)
	static void RowsQuestSaber(out Array<String> r)
	{
		r.Push("||START A GAME, OR RESPAWN|||||DO:~START A GAME, OR RESPAWN~GET:~YOU ARE GIVEN THE SABER (WEAPON SLOT 1) AND THE FORCE. IT IS GIVEN AGAIN WITHIN 5 TICS WHENEVER YOU DO NOT CARRY IT~NEEDS:~SABERS: ON (DEFAULT); START WITH SABER: ON (DEFAULT)");
		r.Push("||PICK THE SABER FROM WEAPON SLOT 1|||||DO:~PICK THE SABER FROM WEAPON SLOT 1~GET:~IT COMES UP IN THE MAIN HAND, THE BLADE RUNS OUT OVER 8 TICS WITH THE IGNITION SOUND, THEN IT HUMS. IT ALWAYS LIGHTS WHEN DRAWN");
		r.Push("||LEAVE THE OFF HAND EMPTY|||||DO:~LEAVE THE OFF HAND EMPTY (THE MAIN HAND'S WEAPON MUST NOT BE A TWO-HANDED ONE)~GET:~THE SECOND SABER COMES UP IN THE OFF HAND BY ITSELF WITHIN 5 TICS, LIT~NEEDS:~DUAL SABERS: ON (DEFAULT)");
		r.Push("||BRING THE SABER INTO THE MAIN HAND WITH THE OFF HAND EMPTY AND NO SECOND SABER DUE THERE|||||DO:~BRING THE SABER INTO THE MAIN HAND WITH THE OFF HAND EMPTY AND NO SECOND SABER DUE THERE~GET:~THE BARE FORCE HAND COMES INTO THE OFF HAND. SWITCH THE MAIN HAND OFF THE SABER AND THE FORCE HAND LEAVES THE SAME TIC~NEEDS:~THE FORCE: ON (DEFAULT); FORCE ONLY WITH SABER: ON (DEFAULT); DUAL SABERS: OFF, OR THE SECOND SABER PUT AWAY");
		r.Push("||SWING THE LIT BLADE SO ITS TIP TRAVELS 8 UNITS A TIC OR MORE THROUGH A MONSTER|||||DO:~SWING THE LIT BLADE SO ITS TIP TRAVELS 8 UNITS A TIC OR MORE THROUGH A MONSTER~GET:~IT IS CUT: BLOOD, SPARKS, SMOKE, A HIT SOUND AT THE BODY AND A BUZZ IN THAT HAND. A SWING THAT FAST ALSO WHOOSHES, AT MOST ONCE EVERY 8 TICS~NEEDS:~SWING TO CUT (DEFAULT 8)");
		r.Push("||SWING FASTER OR SLOWER|||||DO:~SWING FASTER OR SLOWER~GET:~A CUT DOES HALF OF DAMAGE AT 10 UNITS A TIC OR LESS, DAMAGE AT 20, TWICE DAMAGE AT 40 OR MORE: 15 TO 60. THE CUT MONSTER IS SHOVED ALONG THE SWING, LIGHTER ONES FURTHER~NEEDS:~DAMAGE (DEFAULT 30)");
		r.Push("||KEEP THE BLADE IN A MONSTER|||||DO:~KEEP THE BLADE IN A MONSTER~GET:~THE SAME MONSTER IS CUT AGAIN ONLY AFTER 8 TICS. NOTHING IS CUT THROUGH A WALL");
		r.Push("||PUSH OR LEAN THE BLADE INTO A MONSTER WITHOUT A FAST SWING|||||DO:~PUSH OR LEAN THE BLADE INTO A MONSTER WITHOUT A FAST SWING~GET:~IT STILL CUTS ONCE THE BLADE'S TRAVEL OVER THE LAST FEW TICS ADDS UP: A STEADY 3.4 UNITS A TIC OR SO IS ENOUGH. NO WHOOSH~NEEDS:~SWING TO CUT (DEFAULT 8)");
		r.Push("||DRIVE THE HAND ALONG THE BLADE'S OWN LINE WITH THE BLADE TURNING LESS THAN 30 DEGREES|||||DO:~DRIVE THE HAND ALONG THE BLADE'S OWN LINE (WITHIN 30 DEGREES) WITH THE BLADE TURNING LESS THAN 30 DEGREES~GET:~A STAB: ONLY THE FIRST MONSTER ALONG THE BLADE IS HIT, FOR 1.5 TIMES THE DAMAGE, AND IT IS NOT SHOVED");
		r.Push("||HOLD OR SWING THE BLADE SO A MONSTER'S MISSILE CROSSES IT|||||DO:~HOLD OR SWING THE BLADE SO A MONSTER'S MISSILE CROSSES IT (WITHIN 1.5 UNITS OF THE BLADE PLUS THE MISSILE'S OWN RADIUS, TESTED 3 TICS ALONG THE MISSILE'S PATH)~GET:~THE MISSILE IS TURNED: IT FLIES WHERE YOU LOOK, ONTO THE MONSTER NEAREST YOUR GAZE WITHIN 14 DEGREES IF THERE IS ONE, AT 1.2 TIMES ITS SPEED, AND IS YOURS. CLASH SOUND, SPARKS, A FLASH~NEEDS:~BLOCK WIDTH (DEFAULT 1.5); SHOT LOOKAHEAD (DEFAULT 3 TICS); TURNED SHOTS GO: YOUR AIM (DEFAULT)");
		r.Push("||PUT THE BLADE ON THE LINE OF A MONSTER'S BULLET|||||DO:~PUT THE BLADE ON THE LINE OF A MONSTER'S BULLET (WITHIN 1.5 UNITS OF THE BLADE, SWEPT OVER THE LAST TIC)~GET:~THE BULLET IS STOPPED BEFORE IT IS FIRED. ONE BOLT IN YOUR BLADE'S COLOUR GOES BACK AT THE SHOOTER: 20 DAMAGE AT 60 UNITS A TIC~NEEDS:~BLOCK WIDTH (DEFAULT 1.5)");
		r.Push("||HOLD THE BLADE ACROSS THE LINE FROM A MONSTER'S MIDDLE TO YOURS AS IT HITS YOU IN MELEE|||||DO:~HOLD THE BLADE ACROSS THE LINE FROM A MONSTER'S MIDDLE TO YOURS AS IT HITS YOU IN MELEE~GET:~NO DAMAGE. THE MONSTER FLINCHES AND IS PUSHED BACK, AND A BOLT GOES BACK AT IT~NEEDS:~BLOCK WIDTH (DEFAULT 1.5)");
		r.Push("||LET A MISSILE OR A BLAST REACH YOUR BODY WITH THE BLADE ON ITS LINE|||||DO:~LET A MISSILE OR A BLAST REACH YOUR BODY WITH THE BLADE ON ITS LINE~GET:~NO DAMAGE. THE MISSILE ITSELF GOES BACK OFF THE BLADE; A BLAST IS STOPPED~NEEDS:~BLOCK WIDTH (DEFAULT 1.5)");
		r.Push("||MOVE THE BLADE'S TIP 6 UNITS A TIC OR MORE INTO THE SHOT OR CLAW AS IT IS BLOCKED|||||DO:~MOVE THE BLADE'S TIP 6 UNITS A TIC OR MORE INTO THE SHOT OR CLAW AS IT IS BLOCKED~GET:~A PARRY: THE BUZZ KNOCKS TWICE, A WHITE STARBURST AT THE BLADE, A HIGHER CLASH, THE RETURN BOLT UP TO TWICE AS FAST AND A MELEE ATTACKER PUSHED UP TO TWICE AS HARD");
		r.Push("||PUSH THE BLADE INTO A WALL, A FLOOR OR A CEILING|||||DO:~PUSH THE BLADE INTO A WALL, A FLOOR OR A CEILING~GET:~A BURN SOUND, AT MOST EVERY 5 TICS. ON A WALL IT LEAVES A SCORCH MARK AND AN EMBER");
		r.Push("||BRING YOUR TWO LIT BLADES WITHIN 3.5 UNITS OF EACH OTHER||BOTH|||DO:~BRING YOUR TWO LIT BLADES WITHIN 3.5 UNITS OF EACH OTHER (NOT HILT AGAINST HILT)~GET:~A CLASH: A CRACK, A WHITE STARBURST, SPARKS, THE BUZZ KNOCKS TWICE. HELD TOGETHER THEY LOCK: A LOOPING SNARL, A FLICKERING LIGHT AND A BUZZ EVERY OTHER TIC, UNTIL THEY ARE APART FOR MORE THAN 4 TICS~NEEDS:~A SABER IN EACH HAND");
		r.Push("||HOLD THE TWO BLADES CROSSED WHILE SOMETHING ATTACKS FROM WITHIN 100 DEGREES OF WHERE YOUR BODY FACES|||||DO:~HOLD THE TWO BLADES CROSSED WHILE SOMETHING ATTACKS FROM WITHIN 100 DEGREES OF WHERE YOUR BODY FACES~GET:~THE CROSS GUARD: AN ATTACK WHOSE LINE CROSSES EITHER BLADE (WITHIN 1.5 UNITS) DOES NO DAMAGE~NEEDS:~A SABER IN EACH HAND; BLOCK WIDTH (DEFAULT 1.5)");
		r.Push("||HOLD A SABER HAND'S FIRE AND POINT THAT HAND AT MONSTERS|||||DO:~HOLD A SABER HAND'S FIRE AND POINT THAT HAND AT MONSTERS~GET:~LOCK ON: EVERY 3 TICS THE MONSTER NEAREST THE HAND'S LINE (WITHIN 14 DEGREES, WITHIN 1536 UNITS, IN SIGHT) GETS A LOCK MARK, A DIAMOND RING IN THE BLADE'S COLOUR, WITH A SHORT BUZZ; UP TO 5~NEEDS:~LOCK ON TARGETS (DEFAULT 5)");
		r.Push("||LET GO OF FIRE WITH MONSTERS MARKED, THE ARM MOVING AT 1.0 M/S OR MORE TOWARD THE FIRST MARK|||||DO:~LET GO OF FIRE WITH MONSTERS MARKED, THE ARM MOVING AT 1.0 M/S OR MORE TOWARD THE FIRST MARK (WITHIN 60 DEGREES)~GET:~THE SABER IS THROWN. IT FLIES TO EACH MARKED MONSTER IN TURN, CURVING IN AT UP TO 9 DEGREES A TIC ON THE FIRST, CUTTING THEM, THEN COMES HOME");
		r.Push("||LET GO OF FIRE WITH MONSTERS MARKED AND THE HAND STILL OR MOVING AWAY|||||DO:~LET GO OF FIRE WITH MONSTERS MARKED AND THE HAND STILL OR MOVING AWAY~GET:~NOTHING IS THROWN. THE MARKS STAY 35 TICS; PRESS FIRE AGAIN IN THAT TIME AND THEY ARE PICKED BACK UP");
		r.Push("||HOLD FIRE, SWING, AND LET GO WITH NOTHING MARKED, THE HAND AT 2.2 M/S OR MORE AND WITHIN ABOUT 57 DEGREES OF WHERE YOU LOOK|||||DO:~HOLD FIRE, SWING, AND LET GO WITH NOTHING MARKED, THE HAND AT 2.2 M/S OR MORE (ITS FASTEST 2 TICS OF THE LAST 7) AND WITHIN ABOUT 57 DEGREES OF WHERE YOU LOOK~GET:~THE SABER IS THROWN ALONG THE ARM'S MOTION, STEADIED TOWARD WHERE THE HAND POINTS: 14 UNITS A TIC AT 2.2 M/S UP TO 44 AT 5 M/S, OUT 410 TO 819 UNITS, THEN HOME~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S)");
		r.Push("||LET GO OF FIRE WITH NOTHING MARKED AND THE HAND SLOWER THAN THAT, OR NOT TOWARD WHERE YOU LOOK|||||DO:~LET GO OF FIRE WITH NOTHING MARKED AND THE HAND SLOWER THAN THAT, OR NOT TOWARD WHERE YOU LOOK~GET:~NOTHING~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S)");
		r.Push("||THROW WITH THE WRIST UPRIGHT, OR TURNED ON ITS SIDE|||||DO:~THROW WITH THE WRIST UPRIGHT, OR TURNED ON ITS SIDE~GET:~UPRIGHT IT SPINS END OVER END; ON ITS SIDE IT SPINS FLAT LIKE A DISC");
		r.Push("||WATCH THE THROWN SABER|||||DO:~WATCH THE THROWN SABER~GET:~ITS SECOND BLADE LIGHTS AS IT LEAVES. IT CUTS EVERY MONSTER WITHIN A BLADE'S LENGTH FOR 1.5 TIMES DAMAGE (45), EACH AT MOST EVERY 10 TICS, TURNS MISSILES IT MEETS, AND SCORCHES WALLS. A WALL ENDS A FREE THROW; A MARKED THROW PASSES THROUGH WALLS~NEEDS:~DAMAGE (DEFAULT 30)");
		r.Push("||WAIT FOR THE THROWN SABER|||||DO:~WAIT FOR THE THROWN SABER~GET:~IT FLIES TO THAT HAND AT 30 UNITS A TIC, THROUGH WALLS IF IT MUST, AND IS CAUGHT WITHIN 26 UNITS WITH THE BLADE LIT. AFTER 12 SECONDS OUT IT HEADS HOME WHATEVER IT WAS DOING");
		r.Push("||PRESS THAT HAND'S FIRE OR ALT FIRE WHILE ITS SABER IS OUT OF THE HAND|||||DO:~PRESS THAT HAND'S FIRE OR ALT FIRE WHILE ITS SABER IS OUT OF THE HAND~GET:~IT IS CALLED BACK AT ONCE: IT LIFTS FOR 8 TICS, THEN FLIES TO THE HAND AT UP TO 34 UNITS A TIC");
		r.Push("||LET THE SABER FAIL TO REACH YOUR HAND FOR 140 TICS|||||DO:~LET THE SABER FAIL TO REACH YOUR HAND FOR 140 TICS~GET:~IT FALLS, SHUTS OFF AND LIES ON THE FLOOR. WALK OVER IT, OR PRESS THAT HAND'S FIRE, AND YOU HAVE IT BACK");
		r.Push("||PRESS ALT FIRE ON THE MAIN SABER'S HAND - THE FORCE: ON||MAIN|||DO:~PRESS ALT FIRE ON THE MAIN SABER'S HAND~GET:~ONE FORCE PUSH A PRESS FROM THAT HAND, ALONG WHERE IT POINTS: MONSTERS WITHIN 448 UNITS AND 40 DEGREES ARE THROWN BACK (LIGHTER ONES FURTHER) AND TAKE 8 DAMAGE, AND MISSILES IN THE CONE ARE SENT BACK: AT THE MONSTER YOU LOOK AT (WITHIN 14 DEGREES), ELSE ALONG THE PUSH~NEEDS:~THE FORCE: ON (DEFAULT); FORCE PUSH ON ALT: ON (DEFAULT)");
		r.Push("||PRESS IT AGAIN, OR TRY A PULL, WITHIN 1.5 SECONDS|||||DO:~PRESS IT AGAIN, OR TRY A PULL, WITHIN 1.5 SECONDS~GET:~A QUIET CLICK AND NOTHING ELSE: PUSH AND PULL SHARE ONE 1.5 SECOND WAIT");
		r.Push("||HOLD ALT FIRE ON THE SECOND SABER'S HAND AND THRUST THAT HAND AT 2 UNITS A TIC OR MORE WITHIN ABOUT 57 DEGREES OF WHERE YOU LOOK|||||DO:~HOLD ALT FIRE ON THE SECOND SABER'S HAND AND THRUST THAT HAND AT 2 UNITS A TIC OR MORE (ABOUT 2.1 M/S) WITHIN ABOUT 57 DEGREES OF WHERE YOU LOOK~GET:~FORCE PUSH, HALF WAY BETWEEN THE THRUST AND WHERE YOU LOOK. ONE GESTURE A HOLD: LET GO OF THE BUTTON BEFORE THE NEXT~NEEDS:~THE FORCE: ON (DEFAULT); GESTURE SHARPNESS (DEFAULT 2.0); GESTURE STRAIGHTNESS (DEFAULT 0.55)");
		r.Push("||HOLD THAT ALT FIRE AND YANK THE HAND BACK TOWARD YOU AS FAST|||||DO:~HOLD THAT ALT FIRE AND YANK THE HAND BACK TOWARD YOU AS FAST~GET:~FORCE PULL: MONSTERS WITHIN 768 UNITS AND 30 DEGREES (HALF WAY BETWEEN WHERE THE HAND POINTS AND WHERE YOU LOOK) ARE YANKED TOWARD YOU AND LIFTED, PICKUPS THERE FLY TO YOU AND ARE TAKEN, AND YOUR THROWN SABERS COME HOME~NEEDS:~THE FORCE: ON (DEFAULT)");
		r.Push("||HOLD THAT ALT FIRE WITH THE HAND STILL FOR 8 TICS, POINTING WITHIN 12 DEGREES OF A MONSTER|||||DO:~HOLD THAT ALT FIRE WITH THE HAND STILL (UNDER 1.5 UNITS A TIC) FOR 8 TICS, POINTING WITHIN 12 DEGREES OF A MONSTER~GET:~FORCE GRIP: IT RISES, HANGS WHERE THE HAND POINTS AND FOLLOWS IT, AND TAKES 18 DAMAGE A SECOND WITH A CHOKING LOOP. NOT BOSSES, NOTHING HEAVIER THAN MASS 600, NOTHING PAST 1024 UNITS. A DIM OUTLINE ON A MONSTER SHOWS WHAT A GRIP WOULD TAKE, WHENEVER THAT HAND POINTS AT ONE~NEEDS:~THE FORCE: ON (DEFAULT)");
		r.Push("||LET GO OF THAT ALT FIRE WHILE A MONSTER IS GRIPPED|||||DO:~LET GO OF THAT ALT FIRE WHILE A MONSTER IS GRIPPED~GET:~IT IS DROPPED. WITH THE HAND MOVING IT IS FLUNG AT 3.5 TIMES THE HAND'S SPEED (40 UNITS A TIC AT MOST), AND WHEN IT STOPS DEAD IT TAKES 3 TIMES ITS SPEED AS DAMAGE");
		r.Push("||HOLD FIRE OR ALT FIRE ON THE BARE FORCE HAND AND THRUST, YANK OR HOLD STILL|||||DO:~HOLD FIRE OR ALT FIRE ON THE BARE FORCE HAND AND THRUST, YANK OR HOLD STILL~GET:~THE SAME PUSH, PULL AND GRIP~NEEDS:~THE BARE FORCE HAND IN THE OFF HAND");
		r.Push("||WITH THE SABER IN THE MAIN HAND AND A FIST IN THE OFF HAND, HOLD THE OFF HAND'S ALT FIRE AND THRUST, YANK OR HOLD STILL||OFF|||DO:~WITH THE SABER IN THE MAIN HAND AND A FIST IN THE OFF HAND (DOOM'S FIST, BD22 VR'S RSQ_HANDS, RSQ MELEE'S GLOVE), HOLD THE OFF HAND'S ALT FIRE AND THRUST, YANK OR HOLD STILL~GET:~THE SAME PUSH, PULL AND GRIP. THE FIST'S OWN FIRE STILL PUNCHES~NEEDS:~THE FORCE: ON (DEFAULT)");
		r.Push("||FIGHT WITH A SECOND BLADE LIT|||||DO:~FIGHT WITH A SECOND BLADE LIT~GET:~IT CUTS, BLOCKS, TURNS SHOTS AND BURNS WALLS FROM THE POMMEL END AS THE FIRST BLADE DOES");
		r.Push("||HOLD JUMP WITH A SABER IN EITHER HAND, OR THE BARE FORCE HAND IN THE OFF HAND||MAIN OFF|||DO:~HOLD JUMP WITH A SABER IN EITHER HAND, OR THE BARE FORCE HAND IN THE OFF HAND~GET:~A FORCE JUMP: YOU KEEP RISING FOR THE FIRST 8 TICS OF THE JUMP; KEEP HOLDING AND YOU FALL NO FASTER THAN 5 UNITS A TIC~NEEDS:~THE FORCE: ON (DEFAULT); FORCE JUMP: ON (DEFAULT)");
		r.Push("||PRESS BRUTAL DOOM'S DUAL BUTTON WITH THE SABER IN THE MAIN HAND||MAIN|||DO:~PRESS BRUTAL DOOM'S DUAL BUTTON (+USER3) WITH THE SABER IN THE MAIN HAND~GET:~THE SECOND SABER IS PUT AWAY (THE OFF HAND GOES BACK TO ITS EMPTY HAND OR THE FORCE HAND), OR BROUGHT OUT AGAIN~NEEDS:~DUAL SABERS: ON (DEFAULT)");
		r.Push("||WITH THE SECOND SABER OR THE BARE FORCE HAND IN THE OFF HAND AND A GUN IN THE MAIN HAND, FLICK THE GUN'S BARREL DOWN 45 DEGREES WITHIN 4 TICS TO 40 DEGREES BELOW LEVEL||MAIN|||DO:~WITH THE SECOND SABER OR THE BARE FORCE HAND IN THE OFF HAND AND A GUN IN THE MAIN HAND, FLICK THE GUN'S BARREL DOWN 45 DEGREES WITHIN 4 TICS TO 40 DEGREES BELOW LEVEL~GET:~THE GUN'S OWN RELOAD STATE STARTS. RAISE IT ABOVE 15 DEGREES BELOW LEVEL BEFORE THE NEXT FLICK~NEEDS:~A MAIN-HAND GUN WITH A RELOAD STATE");
		r.Push("||OPEN THE OPTIONS AND PRESS TRAINING REMOTE WITH A SABER IN A HAND|||||DO:~OPEN THE OPTIONS AND PRESS TRAINING REMOTE WITH A SABER IN A HAND~GET:~THE TRAINING REMOTE APPEARS 112 UNITS AHEAD, CIRCLES YOU BETWEEN 56 AND 300 UNITS AWAY, BEEPS, GLOWS AND FIRES RED BOLTS AT YOU: 2 DAMAGE EACH");
		r.Push("||TURN A BOLT BACK INTO THE REMOTE|||||DO:~TURN A BOLT BACK INTO THE REMOTE~GET:~A HIT, AND IT IS KNOCKED AWAY. FOUR HITS WITHIN THE ROUND'S 30 SECONDS: REMOTE DOWN, 25 HEALTH, AND AFTER 3 SECONDS IT RISES ONE ROUND HARDER");
		r.Push("||LET THE ROUND'S 30 SECONDS RUN OUT, HOLD NO SABER FOR MORE THAN 10 TICS, OR PRESS TRAINING REMOTE AGAIN|||||DO:~LET THE ROUND'S 30 SECONDS RUN OUT, HOLD NO SABER FOR MORE THAN 10 TICS, OR PRESS TRAINING REMOTE AGAIN~GET:~THE TRAINING IS OVER AND THE REMOTE LEAVES. ON THE CLOCK OR WITH NO SABER: TRAINING OVER WITH YOUR ROUNDS, BEST STREAK AND POINTS. ON THE BUTTON: \"TRAINING REMOTE DISMISSED\"");
		r.Push("||PRESS TRAINING REMOTE WITH NO SABER IN A HAND|||||DO:~PRESS TRAINING REMOTE WITH NO SABER IN A HAND~GET:~\"TRAINING REMOTE: DRAW YOUR SABER FIRST\"");
		r.Push("||WALK OVER ANOTHER SABER MOD'S SABER ON THE MAP|||||DO:~WALK OVER ANOTHER SABER MOD'S SABER ON THE MAP (WARDUST'S LIGHTSABER, SWSP_SABER, BRUTAL DOOM'S SWORD, XIM'S STAR WARS DOOM CHAINSAW)~GET:~IT IS THIS SABER. ONE YOU ALREADY CARRY IS SWAPPED FOR THIS SABER TOO~NEEDS:~SABERS: ON (DEFAULT); SWORD BECOMES SABER: ON (DEFAULT) FOR BRUTAL DOOM'S SWORD");
		r.Push("||LOOK DOWN AT YOUR HIP WHILE A SABER YOU OWN IS NOT IN A HAND||LHIP RHIP|||DO:~LOOK DOWN AT YOUR HIP WHILE A SABER YOU OWN IS NOT IN A HAND~GET:~IT IS DRAWN HANGING THERE, 21 CM TO ITS SIDE AND 84 CM UNDER THE EYES: THE MAIN SABER ON THE MAIN HAND'S SIDE, THE SECOND ON THE OTHER. IT CANNOT BE TAKEN FROM THERE~NEEDS:~SHOW SABERS: ON (DEFAULT); RSQ TACTICAL RIG NOT LOADED");
		r.Push("||PRESS ALT FIRE ON THE MAIN SABER'S HAND - FORCE PUSH ON ALT: OFF||MAIN|||DO:~PRESS ALT FIRE ON THE MAIN SABER'S HAND~GET:~THE MAIN SABER'S SECOND BLADE LIGHTS OR GOES DARK, ONCE A PRESS~NEEDS:~FORCE PUSH ON ALT: OFF (DEFAULT ON)");
		r.Push("||PRESS ALT FIRE ON EITHER SABER'S HAND|||||DO:~PRESS ALT FIRE ON EITHER SABER'S HAND~GET:~THAT SABER'S SECOND BLADE LIGHTS OR GOES DARK; NO PUSH, PULL, GRIP OR FORCE JUMP, AND NO FORCE HAND IS HANDED OUT~NEEDS:~THE FORCE: OFF (DEFAULT ON)");
		r.Push("||TURN A MISSILE WITH THE BLADE|||||DO:~TURN A MISSILE WITH THE BLADE~GET:~IT GOES BACK AT WHOEVER FIRED IT, OR STRAIGHT OFF THE BLADE AS A MIRROR~NEEDS:~TURNED SHOTS GO: AT SHOOTER, OR MIRRORED (DEFAULT YOUR AIM)");
		r.Push("||CUT A MONSTER|||||DO:~CUT A MONSTER~GET:~IT FREEZES FOR 3, 4 OR 6 TICS~NEEDS:~HIT STOP: LIGHT, MEDIUM OR HEAVY (DEFAULT OFF)");
		r.Push("||PARRY|||||DO:~PARRY~GET:~HALF A SECOND OF SLOW MOTION~NEEDS:~PARRY SLOW MOTION: ON (DEFAULT OFF); RSQ SLOWMO");
		r.Push("||START A GAME - DUAL SABERS: OFF|||||DO:~START A GAME~GET:~ONE SABER ONLY: THE BARE FORCE HAND COMES INTO THE EMPTY OFF HAND WHILE THE SABER IS IN THE MAIN HAND. A SECOND SABER YOU ALREADY HOLD IS NOT TAKEN AWAY~NEEDS:~DUAL SABERS: OFF (DEFAULT ON)");
		r.Push("||START A GAME - START WITH SABER: OFF|||||DO:~START A GAME~GET:~YOU ARE NOT GIVEN THE SABER. YOU HAVE IT ONCE YOU PICK UP ANOTHER MOD'S SABER~NEEDS:~START WITH SABER: OFF (DEFAULT ON)");
		r.Push("||START A GAME - SABERS: OFF|||||DO:~START A GAME~GET:~NOTHING IS GIVEN OR SWAPPED AND BULLETS ARE NOT STOPPED AT THE MUZZLE. A SABER YOU ALREADY CARRY STILL CUTS, BLOCKS AND THROWS~NEEDS:~SABERS: OFF (DEFAULT ON)");
		r.Push("||HOLD JUMP WITH A SABER OUT|||||DO:~HOLD JUMP WITH A SABER OUT~GET:~AN ORDINARY JUMP~NEEDS:~FORCE JUMP: OFF (DEFAULT ON)");
		r.Push("||HOLD ANY WEAPON IN THE MAIN HAND WITH THE OFF HAND EMPTY|||||DO:~HOLD ANY WEAPON IN THE MAIN HAND WITH THE OFF HAND EMPTY~GET:~THE BARE FORCE HAND COMES INTO THE OFF HAND WHATEVER THE MAIN HAND HOLDS~NEEDS:~FORCE ONLY WITH SABER: OFF (DEFAULT ON); DUAL SABERS: OFF, OR THE SECOND SABER PUT AWAY");
	}

	// RSQ ShieldSaw (ShieldSaw/README.md)
	static void RowsShieldSaw(out Array<String> r)
	{
		r.Push("||PRESS THE SHIELDSAW KEY WITH THE SHIELD AWAY|KEY:ssq_draw||||DO:~PRESS THE SHIELDSAW KEY WITH THE SHIELD AWAY (NO KEY IS BOUND UNTIL YOU BIND ONE)~GET:~THE SHIELD COMES INTO THE OFF HAND WITH A SOUND AND A BUZZ. WHATEVER THAT HAND HELD STEPS ASIDE");
		r.Push("||PRESS THE SHIELDSAW KEY WITH THE SHIELD IN THE OFF HAND|KEY:ssq_draw|OFF|||DO:~PRESS THE SHIELDSAW KEY WITH THE SHIELD IN THE OFF HAND~GET:~THE SHIELD GOES AWAY, AND THE OFF HAND GETS THE WEAPON IT HELD BEFORE THE SHIELD (WITH NONE: RSQ SABER'S OFF BLADE OR BD22 VR RELOADED'S EMPTY HAND, WHEN YOU CARRY ONE)");
		r.Push("||PRESS THE SHIELDSAW KEY WHILE THE DISC IS OUT|KEY:ssq_draw||||DO:~PRESS THE SHIELDSAW KEY WHILE THE DISC IS OUT~GET:~THE DISC TURNS FOR HOME AT ONCE");
		r.Push("||HOLD MAIN PRIMARY FIRE WITH THE SHIELD IN THE OFF HAND, AND POINT THE MAIN HAND AT MONSTERS||MAIN|||DO:~HOLD MAIN PRIMARY FIRE WITH THE SHIELD IN THE OFF HAND, AND POINT THE MAIN HAND AT MONSTERS~GET:~A RING GOES ON THE MONSTER NEAREST THE MAIN HAND'S LINE, ONE EVERY 3 TICS, UP TO 5, EACH WITH A TICK IN THE OFF HAND. WITHIN 25 DEGREES, 1200 UNITS AND IN SIGHT. THE MAIN HAND'S GUN FIRES AS IT ALWAYS DOES~NEEDS:~MAX LOCKS ABOVE 0 (DEFAULT 5)");
		r.Push("||LET GO OF MAIN PRIMARY FIRE||MAIN|||DO:~LET GO OF MAIN PRIMARY FIRE~GET:~THE RINGS STAY FOR 5 SECONDS~NEEDS:~RINGS KEPT (DEFAULT 175 TICS)");
		r.Push("||HOLD OFF PRIMARY FIRE WITH THE SHIELD IN HAND||OFF|||DO:~HOLD OFF PRIMARY FIRE WITH THE SHIELD IN HAND~GET:~THE SAW REVS: FULL SPEED AFTER 21 TICS, THE BLADES COME OUT AND THE SOUND RISES. LET GO AND IT WINDS DOWN TWICE AS FAST");
		r.Push("||PRESS OFF PRIMARY FIRE WITH RINGS ON||OFF|||DO:~PRESS OFF PRIMARY FIRE WITH RINGS ON~GET:~EVERY RING IS CLEARED");
		r.Push("||HOLD THE FULLY REVVED SHIELD ON A MONSTER|||||DO:~HOLD THE FULLY REVVED SHIELD ON A MONSTER~GET:~GRIND: 6 DAMAGE TO EACH BODY ON THE PLATE, EACH AT MOST ONCE EVERY 4 TICS, WITH BLOOD, SPARKS AND A BUZZ~NEEDS:~GRIND DAMAGE ABOVE 0 (DEFAULT 6)");
		r.Push("||SWING THE OFF ARM FORWARD AT 2.2 M/S OR MORE, WITH RINGS ON||OFF|||DO:~SWING THE OFF ARM FORWARD AT 2.2 M/S OR MORE (WITHIN ABOUT 70 DEGREES OF WHERE YOU LOOK), WITH RINGS ON~GET:~THROW. NO BUTTON. THE DISC LEAVES BETWEEN THE SWING AND THE FIRST RINGED MONSTER, VISITS EACH RINGED MONSTER IN THE ORDER YOU RINGED THEM, THEN COMES HOME~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S); AIM FORWARD (DEFAULT 0.35)");
		r.Push("||SWING THE OFF ARM FORWARD THE SAME WAY WITH NOTHING RINGED||OFF|||DO:~SWING THE OFF ARM FORWARD THE SAME WAY WITH NOTHING RINGED~GET:~THROW ALONG THE SWING. THE DISC TAKES UP TO 5 MONSTERS WITHIN 25 DEGREES OF ITS LINE; WITH NONE IT FLIES ON FOR 2 SECONDS, BOUNCING OFF UP TO 3 WALLS, THEN COMES HOME~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S); AIM FORWARD (DEFAULT 0.35)");
		r.Push("||SWING THE OFF ARM HARDER||OFF|||DO:~SWING THE OFF ARM HARDER~GET:~THE DISC LEAVES FASTER AND HITS HARDER: NOTHING EXTRA AT 2.2 M/S, UP TO 60% MORE OF BOTH AT 4.4 M/S OR OVER~NEEDS:~REV THROW BONUS (DEFAULT 0.6); THROW SPEED (DEFAULT 2.2 M/S)");
		r.Push("||SWING THE OFF ARM IN THE FIRST 10 TICS AFTER THE SHIELD COMES INTO THE HAND||OFF|||DO:~SWING THE OFF ARM IN THE FIRST 10 TICS AFTER THE SHIELD COMES INTO THE HAND~GET:~NO THROW");
		r.Push("||SWING THE SHIELD FACE FIRST INTO A MONSTER IN REACH|||||DO:~SWING THE SHIELD FACE FIRST INTO A MONSTER IN REACH~GET:~A BASH, NOT A THROW. NOTHING IS THROWN FOR THE 10 TICS AFTER A BASH LANDS~NEEDS:~SHIELD BASH: ON (DEFAULT)");
		r.Push("||HIT A MONSTER WITH THE THROWN DISC|||||DO:~HIT A MONSTER WITH THE THROWN DISC~GET:~70 HEALTH OR LESS: CUT IN TWO, THE DISC FLIES ON. UP TO 600: THE DISC STICKS IN IT FOR 21 TICS AND GRINDS. MORE, OR A BOSS: A GLANCING HIT AT 40% AND THE DISC BOUNCES AWAY~NEEDS:~HIT TIERS: ON (DEFAULT)");
		r.Push("||HOLD THE OFF HAND WITHIN 24 UNITS OF THE RETURNING DISC||OFF|||DO:~HOLD THE OFF HAND WITHIN 24 UNITS OF THE RETURNING DISC~GET:~CAUGHT: THE SHIELD IS BACK IN THE OFF HAND WITH A STRONG BUZZ. OTHERWISE IT GOES AWAY (TO YOUR SHOULDER WHEN IT IS MOUNTED)~NEEDS:~CATCH ON RETURN: ON (DEFAULT)");
		r.Push("||HOLD THE SHIELD SO ITS FACE IS BETWEEN YOU AND AN ATTACK|||||DO:~HOLD THE SHIELD SO ITS FACE IS BETWEEN YOU AND AN ATTACK~GET:~THE HIT DOES NO DAMAGE: A SPARK WHERE IT CROSSED THE FACE, A THUD AND A BUZZ IN THE HAND~NEEDS:~SHIELD BLOCKS: ON (DEFAULT)");
		r.Push("||BLOCK A FIREBALL OR OTHER PROJECTILE, OR HOLD THE SHIELD IN ITS PATH|||||DO:~BLOCK A FIREBALL OR OTHER PROJECTILE, OR HOLD THE SHIELD IN ITS PATH~GET:~IT IS TURNED AND FLIES BACK OFF THE FACE LIKE OFF A MIRROR, PUSHED THE WAY THE SHIELD WAS MOVING. IT NOW HURTS MONSTERS, NOT YOU~NEEDS:~BLOCKED SHOTS: RETURNED (DEFAULT); TURNED SHOTS GO: MIRROR SWING (DEFAULT); TURN SHOTS EARLY: ON (DEFAULT)");
		r.Push("||HOLD THE SHIELD ACROSS A MONSTER'S LINE OF FIRE AS IT SHOOTS A BULLET|||||DO:~HOLD THE SHIELD ACROSS A MONSTER'S LINE OF FIRE AS IT SHOOTS A BULLET~GET:~THE SHOT IS CANCELLED BEFORE IT IS TRACED, AND A BULLET OF THE SAME DAMAGE GOES BACK OFF THE PLATE~NEEDS:~MUZZLE BLOCK: ON (DEFAULT); RETURN BULLETS: ON (DEFAULT)");
		r.Push("||BLOCK A MONSTER'S CLAW OR BITE|||||DO:~BLOCK A MONSTER'S CLAW OR BITE~GET:~THE ATTACKER IS PUT IN PAIN AND SHOVED BACK~NEEDS:~BLOCKED MELEE: STUN SHOVE (DEFAULT)");
		r.Push("||MOVE THE SHIELD INTO THE ATTACK AS IT LANDS|||||DO:~MOVE THE SHIELD INTO THE ATTACK AS IT LANDS (ABOUT 0.75 M/S TOWARD IT)~GET:~PERFECT BLOCK: A HIGHER RING, A DOUBLE KNOCK IN THE HAND AND A WHITE BLOOM. A MISSILE GOES BACK 1.6 TIMES FASTER AND A BULLET IS STOPPED DEAD; A MELEE ATTACKER IS ALWAYS STAGGERED AND SHOVED TWICE AS FAR~NEEDS:~PERFECT BLOCK: ON (DEFAULT)");
		r.Push("||SHOVE THE SHIELD FACE FIRST INTO A MONSTER|||||DO:~SHOVE THE SHIELD FACE FIRST INTO A MONSTER (ABOUT 1.3 M/S, OR A STEADY LEAN)~GET:~BASH: 10 TO 40 DAMAGE BY HOW HARD, THE BODY IS THROWN BACK AND LIFTED (LESS THE HEAVIER IT IS), A BURST AND A LONG BUZZ. THE NEXT BASH WAITS 10 TICS~NEEDS:~SHIELD BASH: ON (DEFAULT)");
		r.Push("||BASH A MONSTER INTO A WALL|||||DO:~BASH A MONSTER INTO A WALL~GET:~WALL SLAM: 5 TO 40 MORE DAMAGE BY HOW HARD IT STRUCK, IT IS PUT IN PAIN, FROZEN 8 TICS AND BOUNCES OFF~NEEDS:~WALL SLAM: ON (DEFAULT)");
		r.Push("||WITH THE SHIELD IN THE OFF HAND, FLICK THE MAIN HAND'S GUN DOWN 45 DEGREES WITHIN 4 TICS, ENDING 40 DEGREES BELOW LEVEL||MAIN|||DO:~WITH THE SHIELD IN THE OFF HAND, FLICK THE MAIN HAND'S GUN DOWN 45 DEGREES WITHIN 4 TICS, ENDING 40 DEGREES BELOW LEVEL~GET:~THE GUN GOES TO ITS RELOAD STATE~NEEDS:~A MAIN HAND GUN THAT HAS A RELOAD STATE");
		r.Push("||SWITCH HANDS, OR PICK UP SOMETHING THAT GOES TO THE OFF HAND, WITH THE SHIELD IN IT|||||DO:~SWITCH HANDS, OR PICK UP SOMETHING THAT GOES TO THE OFF HAND, WITH THE SHIELD IN IT~GET:~THE SHIELD IS PUT STRAIGHT BACK IN THE OFF HAND~NEEDS:~OFF HAND SWITCH: KEEP SHIELD (DEFAULT)");
		r.Push("||DIE|||||DO:~DIE~GET:~A SHIELD IN THE HAND GOES AWAY");
		r.Push("||REST RSQ SABER'S LIT BLADE ACROSS THE FRONT OF THE SHIELD|||||DO:~REST RSQ SABER'S LIT BLADE ACROSS THE FRONT OF THE SHIELD (TWO OR MORE POINTS OF THE BLADE OVER THE FACE, WITHIN 15 CM OF IT)~GET:~THE BLOCK IS 1.3 TIMES AS WIDE WHILE THE BLADE RESTS THERE~NEEDS:~RSQ SABER; SABER OVER SHIELD: ON (DEFAULT)");
		r.Push("||IN RSQ WHEEL, TAKE THE SHIELDSAW'S CARD WITH EITHER HAND|||||DO:~IN RSQ WHEEL, TAKE THE SHIELDSAW'S CARD WITH EITHER HAND~GET:~THE SHIELD COMES INTO THE OFF HAND~NEEDS:~RSQ WHEEL");
		r.Push("||IN RSQ WHEEL, PRESS MAIN SECONDARY FIRE ON THE SHIELDSAW'S CARD, THEN PRIMARY FIRE ON THE OFF SHOULDER'S RING|||||DO:~IN RSQ WHEEL, PRESS MAIN SECONDARY FIRE ON THE SHIELDSAW'S CARD, THEN PRIMARY FIRE ON THE OFF SHOULDER'S RING~GET:~THE SHIELD IS MOUNTED: AWAY, IT HANGS ON THAT SHOULDER (RSQ TACTICAL RIG'S OFF SHOULDER HOLSTER) AND NO GUN CAN USE THAT HOLSTER. ANY OTHER RING: A DULL TICK AND NOTHING~NEEDS:~RSQ WHEEL; RSQ TACTICAL RIG WITH SHOULDER FOR SHIELD: ON (DEFAULT)");
		r.Push("||IN RSQ WHEEL, PRESS MAIN SECONDARY FIRE ON THE SHIELDSAW'S CARD, THEN PRIMARY FIRE ON CLEAR|||||DO:~IN RSQ WHEEL, PRESS MAIN SECONDARY FIRE ON THE SHIELDSAW'S CARD, THEN PRIMARY FIRE ON CLEAR~GET:~THE SHIELD IS NO LONGER MOUNTED~NEEDS:~RSQ WHEEL; RSQ TACTICAL RIG");
		r.Push("||SQUEEZE THE OFF HAND'S GRIP AT THE SHOULDER THE SHIELD IS MOUNTED ON||OSH OFF|||DO:~SQUEEZE THE OFF HAND'S GRIP AT THE SHOULDER THE SHIELD IS MOUNTED ON~GET:~SHIELD ON THE SHOULDER: IT COMES INTO THE OFF HAND. SHIELD IN THE OFF HAND: IT GOES BACK TO THE SHOULDER. DISC OUT: REFUSED~NEEDS:~RSQ TACTICAL RIG; THE SHIELD MOUNTED");
		r.Push("||PRESS A KEY BOUND TO NEXT OR PREVIOUS OFFHAND WEAPON|||||DO:~PRESS A KEY BOUND TO NEXT OR PREVIOUS OFFHAND WEAPON~GET:~AWAY: THE SHIELD IS DRAWN WHEN THE CYCLE LANDS ON IT. IN HAND: IT GOES AWAY AND THE NEXT OFF HAND WEAPON COMES UP~NEEDS:~OFFHAND WEAPON CYCLE: ON (DEFAULT OFF)");
		r.Push("||START A MAP - START IN HAND: ON|||||DO:~START A MAP~GET:~THE SHIELD IS IN YOUR OFF HAND THREE TICS AFTER YOU SPAWN~NEEDS:~START IN HAND: ON (DEFAULT OFF)");
		r.Push("||START A MAP - START WITH SHIELD: OFF|||||DO:~START A MAP~GET:~YOU ARE NOT GIVEN A SHIELD~NEEDS:~START WITH SHIELD: OFF (DEFAULT ON)");
		r.Push("||SWITCH HANDS, OR PICK UP A WEAPON THAT GOES TO THE OFF HAND|||||DO:~SWITCH HANDS, OR PICK UP A WEAPON THAT GOES TO THE OFF HAND~GET:~THE SHIELD GOES AWAY AND THE NEW WEAPON KEEPS THE HAND~NEEDS:~OFF HAND SWITCH: ALLOW SWITCH (DEFAULT KEEP SHIELD)");
		r.Push("||TURN YOUR BACK TO AN ATTACK WITH THE SHIELD MOUNTED ON YOUR SHOULDER||OSH|||DO:~TURN YOUR BACK TO AN ATTACK WITH THE SHIELD MOUNTED ON YOUR SHOULDER~GET:~THE MOUNTED SHIELD BLOCKS IT AND TURNS SHOTS, AS IN THE HAND~NEEDS:~BLOCK WHILE HOLSTERED: ON (DEFAULT OFF); THE SHIELD MOUNTED");
		r.Push("||BASH A MONSTER, OR BLOCK IT PERFECTLY|||||DO:~BASH A MONSTER, OR BLOCK IT PERFECTLY~GET:~IT STOPS DEAD FOR 4 TICS~NEEDS:~HIT STOP: ON (DEFAULT OFF)");
	}

	// RSQ Melee (Melee/README.md)
	static void RowsMelee(out Array<String> r)
	{
		r.Push("||HOLD A FIST IN A HAND|||||DO:~HOLD A FIST IN A HAND (EITHER HAND)~GET:~THAT HAND IS READ FOR PUNCHES, THE SWAT, THE HADOUKEN AND THE BARREL TARGET. A HAND WITH ANY OTHER WEAPON IS NOT~NEEDS:~BRUTAL DOOM FISTS: ON (DEFAULT) FOR BRUTAL DOOM'S FISTS AND BD22 VR'S FREE OFF FIST");
		r.Push("||START A SWING WITH A FIST|||||DO:~START A SWING WITH A FIST: THE HAND SLOWER THAN 1.2 M/S, THEN 0.15 M OF TRAVEL IN AT MOST 14 TICS, AVERAGING 2.0 M/S OR MORE~GET:~THE SWING IS A PUNCH FROM THAT TIC. A SWING GOING FORWARD OR UP PLAYS A WHOOSH, HIT OR MISS~NEEDS:~MIN SPEED (DEFAULT 2.0 M/S)");
		r.Push("||CARRY THAT SWING INTO A MONSTER, THE FIST WITHIN 9 CM PLUS 4 UNITS OF ITS BODY, DRIVING TOWARD IT|||||DO:~CARRY THAT SWING INTO A MONSTER, THE FIST WITHIN 9 CM PLUS 4 UNITS OF ITS BODY, DRIVING TOWARD IT~GET:~IT IS PUNCHED: 10 DAMAGE AT 2 M/S RISING TO 20 AT 7 M/S, BLOOD, A SPARK SIZED BY THE SPEED, A BUZZ IN THAT HAND, AND A KNOCK THE WAY THE FIST WENT (2 TO 8 UNITS A TIC FOR A 100-MASS MONSTER, LESS FOR A HEAVIER ONE). THAT HAND PUNCHES AGAIN AFTER 6 TICS~NEEDS:~PUNCH DAMAGE (DEFAULT 10); FULL SPEED (DEFAULT 7); REHIT WAIT (DEFAULT 6); EXTRA REACH (DEFAULT 4)");
		r.Push("||PUNCH STRAIGHT AT THE MONSTER|||||DO:~PUNCH STRAIGHT AT THE MONSTER~GET:~A JAB: THE THREE JAB SOUNDS IN TURN");
		r.Push("||PUNCH ACROSS THE MONSTER|||||DO:~PUNCH ACROSS THE MONSTER (MORE THAN 0.6 OF THE SWING SIDEWAYS, AND MORE SIDEWAYS THAN TOWARD IT)~GET:~A HOOK: THE SAME DAMAGE AND KNOCK, WITH THE RIGHT HAND'S OR THE LEFT HAND'S HOOK SOUND");
		r.Push("||PUNCH UPWARD INTO A MONSTER|||||DO:~PUNCH UPWARD INTO A MONSTER (THE SWING, OR ITS LAST TIC, RISING MORE THAN HALF ITS LENGTH: 30 DEGREES)~GET:~AN UPPERCUT: THE SAME DAMAGE, AND IT IS LIFTED (5 TO 9 UNITS A TIC BY SPEED, TIMES 100 OVER ITS MASS, A BOSS 0.3 OF THAT), PUSHED 2 TO 5 BACK, AND HELD IN ITS PAIN FRAMES WHILE IN THE AIR. NO LAUNCH GOES HIGHER THAN 3 M~NEEDS:~UPPERCUT RISE (DEFAULT 0.5); LIFT CAP (DEFAULT 3 M)");
		r.Push("||PUNCH A MONSTER WHILE IT IS IN ITS ATTACK FRAMES|||||DO:~PUNCH A MONSTER WHILE IT IS IN ITS ATTACK FRAMES~GET:~A COUNTER: A RED SPARK, AND WITH IMPACT STYLE: ARCADE A RED BURST AND THE WORD COUNTER! (RSQ VISUALREWARDS DRAWS THE WORD). THE DAMAGE IS THE SAME~NEEDS:~IMPACT WORDS: ON (DEFAULT)");
		r.Push("||PUNCH AT 5.4 M/S OR FASTER, OR KILL WITH A PUNCH|||||DO:~PUNCH AT 5.4 M/S OR FASTER, OR KILL WITH A PUNCH~GET:~A BIGGER BURST AND SHARDS, A MONSTER STILL ALIVE IS HELD 4 OR 5 TICS BEFORE THE KNOCK THROWS IT, AND A WORD OVER IT: POW!, BAM!, WHAM!, SMASH!, OR FATALITY! ON A KILL (WORDS NEED RSQ VISUALREWARDS, ONE EVERY 14 TICS AT MOST)~NEEDS:~IMPACT STYLE: ARCADE (DEFAULT); HIT STOP: ON (DEFAULT); IMPACT WORDS: ON (DEFAULT)");
		r.Push("||PUNCH WHILE YOU HOLD THE BERSERK PACK|||||DO:~PUNCH WHILE YOU HOLD THE BERSERK PACK~GET:~THE PUNCH DOES 5 TIMES ITS DAMAGE");
		r.Push("||PUNCH A WALL LINE THAT HAS A SWITCH OR A DOOR ON IT|||||DO:~PUNCH A WALL LINE THAT HAS A SWITCH OR A DOOR ON IT (NO MONSTER IN THE FIST'S WAY)~GET:~THE LINE IS WORKED AS A USE PRESS WOULD WORK IT, WITH A BUZZ IN THAT HAND");
		r.Push("||UPPERCUT A BARREL - BARREL LAUNCH: ON|||||DO:~UPPERCUT A BARREL~GET:~NO DAMAGE: THE BARREL FLIES, TUMBLING, AT 28 UNITS A TIC TO THE MONSTER THAT HAND HAS PAINTED (NEXT ROW). WITH NONE PAINTED IT FLIES THE WAY THE FIST WAS GOING ACROSS THE FLOOR, OR AWAY FROM YOU IF THE SWING WAS NEARLY STRAIGHT UP. IT GOES OFF ON THE FIRST MONSTER, WALL, FLOOR OR CEILING, OR AFTER 3 SECONDS. THE BLAST IS YOURS~NEEDS:~BARREL LAUNCH: ON (DEFAULT)");
		r.Push("||HOLD THAT HAND'S TRIGGER AND POINT AT A MONSTER, THEN UPPERCUT, SHOVE, WHIP OR THROW A BARREL|||||DO:~HOLD THAT HAND'S TRIGGER AND POINT AT A MONSTER, THEN UPPERCUT, SHOVE, WHIP OR THROW A BARREL~GET:~WHILE A FIST (OR THE GUN IN THE MAIN HAND, OR A HAND RSQ DISTANCE GRAB SAYS IS CARRYING SOMETHING) HAS ITS FIRE HELD, THE MONSTER NEAREST THAT HAND'S AIM LINE IS PAINTED: WITHIN 25 DEGREES OF THE LINE AND 1536 UNITS OF THE HAND, IN YOUR SIGHT. A GREEN RING SHOWS OVER IT AND THAT HAND BUZZES LIGHTLY. IT STAYS PAINTED UNTIL YOU LET GO OF THE TRIGGER, IT DIES, OR THE HAND, HELD STILL (UNDER 1.2 M/S), POINTS AT ANOTHER. A BARREL THAT HAND LAUNCHES FLIES TO IT. THE TRIGGER IS NOT TAKEN: A GUN IN THAT HAND STILL FIRES~NEEDS:~BARREL LAUNCH: ON (DEFAULT)");
		r.Push("||SWING A FIST THROUGH A MONSTER'S SHOT - PALM SWAT: ON|||||DO:~SWING A FIST THROUGH A MONSTER'S SHOT~GET:~AT 1.5 M/S OR MORE, ANY DIRECTION, A MISSILE THE FIST MEETS IS KNOCKED ASIDE, KEEPS ITS SPEED, AND IS YOURS: IT HURTS MONSTERS, NOT YOU. A SLAP SOUND, A SPARK, A BUZZ. A BODY THE SAME SWING MEETS IS STILL PUNCHED~NEEDS:~PALM SWAT: ON (DEFAULT)");
		r.Push("||SWING A FIST AT 1.5 M/S OR MORE ACROSS THE LINE OF A MONSTER'S BULLET, BETWEEN IT AND YOU|||||DO:~SWING A FIST AT 1.5 M/S OR MORE ACROSS THE LINE OF A MONSTER'S BULLET, BETWEEN IT AND YOU~GET:~THE SHOT IS CANCELLED: IT HITS NOBODY~NEEDS:~PALM SWAT: ON (DEFAULT); SWAT BULLETS: ON (DEFAULT)");
		r.Push("||WITH A GUN IN THE MAIN HAND, DRIVE THAT HAND 0.15 M AT AN AVERAGE OF 3.6 M/S OR MORE, ANY WAY BUT BACK TOWARD YOU OR DOWNWARD||MAIN|||DO:~WITH A GUN IN THE MAIN HAND, DRIVE THAT HAND 0.15 M AT AN AVERAGE OF 3.6 M/S OR MORE, ANY WAY BUT BACK TOWARD YOU OR DOWNWARD~GET:~A GUN BUTT SHOVE: EVERY MONSTER WITHIN 60 UNITS ALONG THE SWING (12 UNITS WIDE, A CLEAR LINE FROM THE HAND) IS PUSHED AWAY FROM YOU (LIGHTER FURTHER), AND PUT IN ITS PAIN FRAMES (NOT A BOSS). DOOM'S ZOMBIEMAN, SHOTGUN GUY AND IMP ARE THROWN FURTHER BACK AND UP, AND SOME OTHERS LIFTED. NO DAMAGE. A SWING SOUND, A BUZZ, MONSTERS WITHIN 200 UNITS ARE ALERTED. THE NEXT SHOVE IS TAKEN AFTER 12 TICS~NEEDS:~GUN BUTT SHOVE: ON (DEFAULT); SHOVE SPEED (DEFAULT 3.6 M/S)");
		r.Push("||LAND THAT SHOVE ON AT LEAST ONE MONSTER|||||DO:~LAND THAT SHOVE ON AT LEAST ONE MONSTER~GET:~RSQ SLOWMO IS ASKED FOR 1000 MS OF SLOW MOTION AT 35% SPEED~NEEDS:~SHOVE SLOW MO: ON (DEFAULT); SLOW MO LENGTH (DEFAULT 1000 MS); RSQ SLOWMO");
		r.Push("||HIT A MONSTER WITH A SHOTGUN WHILE THAT SLOW MOTION LASTS|||||DO:~HIT A MONSTER WITH A SHOTGUN WHILE THAT SLOW MOTION LASTS~GET:~THE HIT BLEEDS TWICE. A KILL IS THE MONSTER'S EXTREME DEATH IN A BURST OF BLOOD MIST, \"F.E.A.R. EFFECT\" SHOWS LOW IN THE VIEW FOR 1.5 SECONDS, AND RSQ SCORE IS SENT THE AWARD~NEEDS:~BLOOD MIST: ON (DEFAULT); RSQ SLOWMO; RSQ SCORE FOR THE AWARD");
		r.Push("||SHOVE THE GUN AT A SWITCH OR A DOOR LINE WITH NO MONSTER IN REACH|||||DO:~SHOVE THE GUN AT A SWITCH OR A DOOR LINE WITH NO MONSTER IN REACH~GET:~THE LINE IS WORKED AS A USE PRESS, WITH A BUZZ~NEEDS:~GUN BUTT SHOVE: ON (DEFAULT)");
		r.Push("||SWING THE GUN AS FOR A SHOVE WITH A BARREL WITHIN 72 UNITS OF THE GUN HAND AND WITHIN 60 DEGREES OF THE SWING|||||DO:~SWING THE GUN AS FOR A SHOVE (3.6 M/S OR MORE ON AVERAGE, 12 TICS AFTER THE LAST SHOVE OR LAUNCH) WITH A BARREL WITHIN 72 UNITS OF THE GUN HAND AND WITHIN 60 DEGREES OF THE SWING~GET:~THE BARREL IS LAUNCHED AS AN UPPERCUT LAUNCHES IT: TO THE MONSTER THE GUN HAND'S TRIGGER HAS PAINTED, OR WITH NONE PAINTED ALONG THE SWING~NEEDS:~BARREL LAUNCH: ON (DEFAULT); SHOVE SPEED (DEFAULT 3.6 M/S)");
		r.Push("||CARRY A BARREL WITH RSQ DISTANCE GRAB AND THROW IT|||||DO:~CARRY A BARREL WITH RSQ DISTANCE GRAB AND THROW IT (ITS OWN THROW TEST: THE ARM'S PART OF THE RELEASE OVER 0.5 M/S)~GET:~DISTANCE GRAB HANDS THE THROW TO MELEE AND THE BARREL IS LAUNCHED AS AN UPPERCUT LAUNCHES IT: TO THE MONSTER THE CARRYING HAND'S TRIGGER HAS PAINTED, OR WITH NONE PAINTED THE WAY IT WAS THROWN. SAME SPEED, TUMBLE, BLAST AND SLOW MOTION; NO HIT SOUND AND NO DUST. A BARREL SET DOWN IS NOT LAUNCHED. WHILE DISTANCE GRAB'S BARREL LOCK-ON HOLDS A LOCK, ONLY A PAINTED THROW IS MELEE'S: WITH NOTHING PAINTED THE BARREL GOES TO THE LOCK BY DISTANCE GRAB'S OWN THROW~NEEDS:~BARREL LAUNCH: ON (DEFAULT); RSQ DISTANCE GRAB");
		r.Push("||LAND BD22 VR RELOADED'S PISTOL WHIP OR BUTT STRIKE ON A BARREL|||||DO:~LAND BD22 VR RELOADED'S PISTOL WHIP OR BUTT STRIKE ON A BARREL~GET:~THE BARREL TAKES NO BLOW AND IS LAUNCHED AS AN UPPERCUT LAUNCHES IT: TO THE MONSTER THAT HAND'S TRIGGER HAS PAINTED, OR WITH NONE PAINTED THE WAY THE GUN WAS MOVING. THE WHIP'S SOUND FOR A WHIP, THE SHOVE'S FOR A BUTT STRIKE~NEEDS:~BARREL LAUNCH: ON (DEFAULT); PISTOL WHIP: ON (DEFAULT); BUTT STRIKE: ON (DEFAULT); BD22 VR RELOADED 2.0.4U OR LATER");
		r.Push("||LAUNCH A BARREL ANY OF THESE WAYS|||||DO:~LAUNCH A BARREL ANY OF THESE WAYS~GET:~RSQ SLOWMO SLOWS THE WORLD UNTIL THE BARREL GOES OFF, 3 SECONDS AT MOST~NEEDS:~BARREL SLOW MO: ON (DEFAULT); RSQ SLOWMO");
		r.Push("||PRESS THE OFF HAND'S GRIP WITH THE OFF PALM WITHIN 0.30 M OF A LIVING MONSTER'S BODY||OFF|||DO:~PRESS THE OFF HAND'S GRIP (KEY CODE 443, OR 436) WITH THE OFF PALM WITHIN 0.30 M OF A LIVING MONSTER'S BODY~GET:~THE HEADLOCK: THE MONSTER IS FROZEN AND CARRIED AT THE OFF HAND, ITS FACE AT THE HAND'S HEIGHT, TURNED TO YOU, FOR 3 SECONDS OR UNTIL YOU LET GO OF THE GRIP. BOSSES AND ANYTHING HEAVIER THAN MASS 400 ARE NOT TAKEN. A BUZZ IN THE OFF HAND~NEEDS:~HEADLOCK: ON (DEFAULT); REACH (DEFAULT 0.30 M); HEAVIEST (DEFAULT 400); HOLD TIME (DEFAULT 3 S); OFF GRIP KEYS (DEFAULT \"443 436\")");
		r.Push("||LET GO OF THE OFF GRIP WHILE HOLDING A MONSTER||OFF|||DO:~LET GO OF THE OFF GRIP WHILE HOLDING A MONSTER~GET:~IT IS LET GO WHERE IT IS");
		r.Push("||HOLD A MONSTER IN THE OFF HAND||OFF|||DO:~HOLD A MONSTER IN THE OFF HAND~GET:~THE OFF HAND DOES NOT PUNCH, SWAT OR RETURN MISSILES UNTIL IT LETS GO");
		r.Push("||PUNCH THE HELD MONSTER WITH THE MAIN HAND, THREE TIMES||MAIN|||DO:~PUNCH THE HELD MONSTER WITH THE MAIN HAND, THREE TIMES~GET:~THE FIRST BLOW DOES ITS OWN DAMAGE, THE SECOND 1.5 TIMES, THE THIRD 2.5 TIMES. THE THIRD LETS IT GO AND, AFTER 4 TICS, SENDS IT FLYING AWAY FROM YOU (26 UNITS A TIC FOR A 100-MASS MONSTER), ALIVE OR DEAD: EACH MONSTER IT MEETS TAKES 10 TO 150 DAMAGE BY ITS SPEED, IS SHOVED ALONG AND STAGGERED 24 TICS~NEEDS:~HEADLOCK COMBO: ON (DEFAULT)");
		r.Push("||LAND ANY BLOW OF YOUR OWN ON THE MONSTER YOU HOLD|||||DO:~LAND ANY BLOW OF YOUR OWN ON THE MONSTER YOU HOLD~GET:~IT SHOWS ITS PAIN FRAME FOR 6 TICS WITH ITS PAIN SOUND, AND BLEEDS EXTRA: 0.3 OF THE BLOW ON THE FIRST, 0.6 ON THE SECOND, THE WHOLE BLOW AGAIN FROM THE THIRD~NEEDS:~EXTRA BLOOD: ON (DEFAULT)");
		r.Push("||WHILE HOLDING A MONSTER, SWING THE OFF HAND ACROSS THE GROUND WITHIN 60 DEGREES OF WHERE YOU FACE AT 3.0 M/S OR MORE, THEN SLOW IT||OFF|||DO:~WHILE HOLDING A MONSTER, SWING THE OFF HAND ACROSS THE GROUND WITHIN 60 DEGREES OF WHERE YOU FACE AT 3.0 M/S OR MORE, THEN SLOW IT~GET:~IT IS THROWN THE WAY THE HAND MOVED, COUNTED AS 30% OF ITS WEIGHT, IN ITS PAIN FRAMES. WITHOUT RSQ DISTANCE GRAB, WHATEVER IT HITS AT 3 M/S OR MORE (A WALL OR A BODY) TAKES THE IMPACT AND SO DOES IT~NEEDS:~THROW AT (DEFAULT 3.0 M/S); THROW WEIGHT (DEFAULT 30%)");
		r.Push("||WITH BOTH HANDS ON A LONG GUN OF BD22 VR RELOADED, DRIVE THE STOCK FORWARD AT 2.4 M/S OR MORE||BOTH|||DO:~WITH BOTH HANDS ON A LONG GUN OF BD22 VR RELOADED (RIFLE, SHOT_GUN, SSG, ASSAULTSHOTGUN, MP40, BRUTALSMG, MACHINEGUN, MG42), DRIVE THE STOCK FORWARD AT 2.4 M/S OR MORE~GET:~THE BUTT STRIKE: MONSTERS THE STOCK MEETS, OR WITHIN 90 UNITS AHEAD OF IT, ARE SHOVED AS THE GUN BUTT SHOVE SHOVES THEM (NO DAMAGE), WITH THE SAME SLOW MOTION ONCE A SWING. A SWITCH OR DOOR IT MEETS IS WORKED~NEEDS:~BUTT STRIKE: ON (DEFAULT); BUTT STRIKE SPEED (DEFAULT 2.4 M/S); BUTT FORWARD SHARE (DEFAULT 0.5); BD22 VR RELOADED 2.0.4U OR LATER");
		r.Push("||SWING BD22 VR RELOADED'S PISTOL OR REVOLVER, IN EITHER HAND, SO THE MUZZLE MOVES AT 5.0 M/S OR MORE WITH A QUARTER OF THAT DOWNWARD|||||DO:~SWING BD22 VR RELOADED'S PISTOL OR REVOLVER, IN EITHER HAND, SO THE MUZZLE MOVES AT 5.0 M/S OR MORE WITH A QUARTER OF THAT DOWNWARD~GET:~THE PISTOL WHIP: BRUTAL DOOM'S OWN PUNCH LANDS ON EACH MONSTER THE GUN MEETS (A SECOND ONE AT TWICE THAT SPEED), WITH THE WHIP SOUND. INTO A WALL IT MAKES BRUTAL DOOM'S AXE IMPACT~NEEDS:~PISTOL WHIP: ON (DEFAULT); WHIP SPEED (DEFAULT 5.0 M/S); WHIP DOWN SHARE (DEFAULT 0.25); BD22 VR RELOADED 2.0.4U OR LATER");
		r.Push("||TURN ON BOXING GLOVES|||||DO:~TURN ON BOXING GLOVES~GET:~AT THE NEXT MAP START OR RESPAWN THE TWO BOXING GLOVES ARE PUT IN YOUR INVENTORY, NOT IN YOUR HANDS (THE GLOVE ASKS FOR WEAPON SLOT 1)~NEEDS:~BOXING GLOVES: ON (DEFAULT OFF)");
		r.Push("||TURN ON SLAPPERS ONLY|||||DO:~TURN ON SLAPPERS ONLY~GET:~AT ONCE THE BOXING GLOVES GO ON BOTH HANDS AND EVERY WEAPON BUT THE GLOVES, DOOM'S FIST, BRUTAL DOOM'S FISTS AND BD22 VR'S HANDS IS PUT AWAY. WEAPON PICKUPS VANISH AND A WEAPON GIVEN LATER IS PUT AWAY WITHIN 8 TICS. TURNED OFF, THE WEAPONS COME BACK WITH THE AMMO YOU HAVE NOW~NEEDS:~SLAPPERS ONLY: ON (DEFAULT OFF)");
		r.Push("||WITH THE BOXING GLOVES IN THE MAIN HAND, HOLD BOTH HANDS AT YOUR FACE FOR 4 TICS: WITHIN 0.35 M OF YOUR HEAD ACROSS, FROM 0.25 M BELOW TO 0.15 M ABOVE YOUR EYES||BOTH|||DO:~WITH THE BOXING GLOVES IN THE MAIN HAND (AND NOTHING BUT A GLOVE IN THE OFF HAND), HOLD BOTH HANDS AT YOUR FACE FOR 4 TICS: WITHIN 0.35 M OF YOUR HEAD ACROSS, FROM 0.25 M BELOW TO 0.15 M ABOVE YOUR EYES~GET:~THE GUARD: A BLOW FROM WITHIN 55 DEGREES OF WHERE YOU FACE DOES 60%, PUSHES YOU BACK A STEP, WITH A FLASH, A TICK AND A BUZZ IN BOTH HANDS. A BLOW OF 35 OR MORE BREAKS IT: FULL DAMAGE, AND NO GUARD FOR 14 TICS~NEEDS:~GUARD: ON (DEFAULT OFF); BOXING GLOVES OR SLAPPERS ONLY: ON");
		r.Push("||SWING A FIST AT 2.0 M/S OR MORE THROUGH A MONSTER'S MISSILE|||||DO:~SWING A FIST AT 2.0 M/S OR MORE THROUGH A MONSTER'S MISSILE~GET:~THE HADOUKEN, IN PLACE OF THE SWAT: IT FLIES BACK AT ITS SHOOTER 1.15 TIMES AS FAST AND HITS FOR 1.5 TIMES ITS DAMAGE~NEEDS:~HADOUKEN: ON (DEFAULT OFF)");
		r.Push("||SWING A FIST AT 2.0 M/S OR MORE ACROSS THE LINE OF A MONSTER'S BULLET, BETWEEN IT AND YOU|||||DO:~SWING A FIST AT 2.0 M/S OR MORE ACROSS THE LINE OF A MONSTER'S BULLET, BETWEEN IT AND YOU~GET:~THE SHOT IS CANCELLED AND A ROUND FLIES FROM YOUR HAND AT THE SHOOTER FOR 1.5 TIMES THE SHOT'S DAMAGE~NEEDS:~HADOUKEN: ON (DEFAULT OFF); SWAT BULLETS: ON (DEFAULT)");
		r.Push("||LAND A PUNCH - HEAVY HANDS: ON|||||DO:~LAND A PUNCH~GET:~HEAVY HANDS: THE MONSTER IS FROZEN 2 TICS (4 FOR A PUNCH AT 4.5 M/S OR MORE) WITH CHICKS AND STARS OVER ITS HEAD, AND KNOCKED 1.25 TIMES AS FAR~NEEDS:~HEAVY HANDS: ON (DEFAULT OFF)");
		r.Push("||PUNCH A MONSTER SO IT MEETS A WALL WITHIN 12 TICS AT 3 UNITS A TIC OR MORE|||||DO:~PUNCH A MONSTER SO IT MEETS A WALL WITHIN 12 TICS AT 3 UNITS A TIC OR MORE~GET:~WALL SPLAT: 10 TO 20 DAMAGE BY ITS SPEED, IT BOUNCES OFF, IS FROZEN 5 TICS AND REELS 15~NEEDS:~WALL SPLAT: ON (DEFAULT OFF)");
		r.Push("||WITH MELEE'S GLOVES IN BOTH HANDS, SWING BOTH HANDS DOWN TOGETHER TO 0.60 M OR MORE BELOW YOUR EYES||BOTH|||DO:~WITH MELEE'S GLOVES IN BOTH HANDS, SWING BOTH HANDS DOWN TOGETHER TO 0.60 M OR MORE BELOW YOUR EYES (EACH 2.0 M/S OR MORE DOWNWARD, THE SLOWER ONE 3.0 M/S OR MORE, WITHIN 120 MS OF EACH OTHER)~GET:~GROUND POUND: EVERY MONSTER WITHIN 2.5 M TAKES 30 DAMAGE, IS THROWN OUT AND UP AND STAGGERED 15 TICS. A THUD, A RING ALONG THE FLOOR, A SHAKE, A BUZZ IN BOTH HANDS~NEEDS:~GROUND POUND: ON (DEFAULT OFF); BOXING GLOVES OR SLAPPERS ONLY: ON");
		r.Push("||WITH NOTHING BUT MELEE'S GLOVES IN YOUR HANDS, THRUST BOTH PALMS FORWARD TOGETHER||BOTH|||DO:~WITH NOTHING BUT MELEE'S GLOVES IN YOUR HANDS (AT LEAST ONE), THRUST BOTH PALMS FORWARD TOGETHER (EACH 2.5 M/S OR MORE, CONTROLLERS TILTED UP 20 DEGREES OR MORE, HANDS 0.25 M APART SIDEWAYS, NO LOWER THAN 0.60 M BELOW YOUR EYES)~GET:~CLEAR OUT: EVERY MONSTER WITHIN 2.5 M AND 45 DEGREES OF WHERE YOU FACE, IN SIGHT, TAKES 15 DAMAGE, IS SHOVED BACK HARD (LIGHTER FURTHER) AND STAGGERED 10 TICS~NEEDS:~CLEAR OUT: ON (DEFAULT OFF); BOXING GLOVES OR SLAPPERS ONLY: ON");
		r.Push("||HOLD A MONSTER IN THE HEADLOCK|||||DO:~HOLD A MONSTER IN THE HEADLOCK~GET:~HUMAN SHIELD: IT IS TURNED TO FACE AWAY FROM YOU AND STAYS HELD AS LONG AS YOU GRIP, A MINUTE AT MOST~NEEDS:~HUMAN SHIELD: ON (DEFAULT OFF)");
		r.Push("||UPPERCUT A BARREL - UPPERCUT BARRELS: ON WITH BARREL LAUNCH: OFF|||||DO:~UPPERCUT A BARREL~GET:~IT IS LIFTED UP AND AWAY FROM YOU AT THE UPPERCUT'S SPEED WITH NO DAMAGE, AND ITS BLAST IS YOURS~NEEDS:~UPPERCUT BARRELS: ON (DEFAULT OFF) WITH BARREL LAUNCH: OFF");
		r.Push("||JAB FORWARD WITH BD22 VR'S FISTS|||||DO:~JAB FORWARD WITH BD22 VR'S FISTS (THE HAND 0.25 M AHEAD OF YOU, 0.15 M OF TRAVEL, 2.5 M/S OR MORE, 0.7 OF IT FORWARD)~GET:~BRUTAL DOOM'S OWN PUNCH FLIES FROM THE HAND AND DEALS THAT SWING'S DAMAGE. MELEE'S PUNCH STILL GIVES THE KIND OF PUNCH, THE KNOCK AND THE LIFT, WITH NO DAMAGE OF ITS OWN~NEEDS:~VR PUNCH: ON (DEFAULT OFF); BD22 VR RELOADED 2.0.4U OR LATER");
		r.Push("||UPPERCUT WITH THAT HAND'S FIRE OR ALT FIRE HELD|||||DO:~UPPERCUT WITH THAT HAND'S FIRE OR ALT FIRE HELD~GET:~A STAR PUNCH, SPENDING A BANKED STAR: A LONGER, STRONGER BUZZ AND THE STAR SOUND (THE HARDER HIT IS GUN BONSAI VR'S). A STAR IS BANKED ON A COUNTER, ON THE FIRST PUNCH LANDED AND EVERY SECOND ONE AFTER, THREE AT MOST~NEEDS:~RSQ GUN BONSAI VR WITH STAR PUNCH LEARNED ON A BOXING GLOVE");
		r.Push("||PUNCH A MONSTER YOUR UPPERCUT LAUNCHED WHILE IT IS STILL IN THE AIR, WITHIN 70 TICS|||||DO:~PUNCH A MONSTER YOUR UPPERCUT LAUNCHED WHILE IT IS STILL IN THE AIR, WITHIN 70 TICS~GET:~JUGGLE: IT IS LIFTED AGAIN~NEEDS:~RSQ GUN BONSAI VR WITH JUGGLE LEARNED");
		r.Push("||HOLD A FIST NEARLY STILL WHERE A MONSTER'S MISSILE ARRIVES|||||DO:~HOLD A FIST NEARLY STILL (UNDER 1.5 M/S) WHERE A MONSTER'S MISSILE ARRIVES~GET:~CATCH: THE MISSILE IS HELD AT THE HAND. SWING THE HAND AT 2.0 M/S OR MORE TO THROW IT WHERE THE HAND GOES (ONTO A MONSTER WITHIN 12 DEGREES OF THAT LINE). HELD TOO LONG IT GOES OFF IN YOUR HAND~NEEDS:~RSQ GUN BONSAI VR WITH CATCH LEARNED");
		r.Push("||WITH THE GUARD UP, DRIVE BOTH HANDS FORWARD AT 1.0 M/S OR MORE JUST BEFORE A BLOW LANDS||BOTH|||DO:~WITH THE GUARD UP, DRIVE BOTH HANDS FORWARD AT 1.0 M/S OR MORE JUST BEFORE A BLOW LANDS~GET:~PARRY: NO DAMAGE, THE ATTACKER IS KNOCKED BACK AND STAGGERED~NEEDS:~RSQ GUN BONSAI VR WITH GUARD AND PARRY LEARNED");
		r.Push("||THROW BOTH HANDS APART||BOTH|||DO:~THROW BOTH HANDS APART~GET:~RELEASE: WHAT THE GUARD HAS TAKEN GOES OUT AS DAMAGE TO THE MONSTERS ROUND YOU AND THROWS THEM BACK. WITH NO CHARGE, A TAUNT: MONSTERS IN RANGE THAT SEE YOU TURN ON YOU AND YOUR NEXT PUNCH DOES DOUBLE~NEEDS:~RSQ GUN BONSAI VR WITH ABSORB AND RELEASE, OR TAUNT, LEARNED");
		r.Push("||WHILE HOLDING A MONSTER, SWING THE OFF HAND DOWN HARD||OFF|||DO:~WHILE HOLDING A MONSTER, SWING THE OFF HAND DOWN HARD (0.7 OR MORE OF THE SWING DOWNWARD)~GET:~SLAM: IT IS LET GO, PUT ON THE FLOOR AND HURT BY ITS WEIGHT AND THE HAND'S SPEED; MONSTERS ROUND IT STAGGER~NEEDS:~RSQ GUN BONSAI VR WITH SLAM LEARNED ON THE OFF GLOVE");
		r.Push("||UPPERCUT THE MONSTER YOU HOLD|||||DO:~UPPERCUT THE MONSTER YOU HOLD~GET:~HEADLOCK UPPERCUT: THE PUNCH HITS HARDER, THE MONSTER IS LET GO AND LAUNCHED HIGHER~NEEDS:~RSQ GUN BONSAI VR WITH HEADLOCK UPPERCUT LEARNED ON THE OFF GLOVE");
		r.Push("||SWING A FIST|||||DO:~SWING A FIST~GET:~NOTHING WITH BRUTAL DOOM'S FISTS OR BD22 VR'S FREE OFF FIST: BRUTAL DOOM PUNCHES AS IT SHIPS~NEEDS:~BRUTAL DOOM FISTS: OFF (DEFAULT ON)");
		r.Push("||SWING A FIST THROUGH A MONSTER'S SHOT - PALM SWAT: OFF|||||DO:~SWING A FIST THROUGH A MONSTER'S SHOT~GET:~IT IS NOT KNOCKED AWAY. WITH HADOUKEN ON, A FIST AT 2.0 M/S OR MORE STILL SENDS IT BACK~NEEDS:~PALM SWAT: OFF (DEFAULT ON)");
		r.Push("||SHOVE WITH A GUN|||||DO:~SHOVE WITH A GUN~GET:~NO SHOVE. WITH BD22 VR RELOADED LOADED THE HAND IS STILL READ WHILE SHOVE SLOW MO IS ON~NEEDS:~GUN BUTT SHOVE: OFF (DEFAULT ON)");
		r.Push("||PRESS THE OFF GRIP AT A MONSTER||OFF|||DO:~PRESS THE OFF GRIP AT A MONSTER~GET:~NOTHING FROM THIS MOD~NEEDS:~HEADLOCK: OFF (DEFAULT ON)");
		r.Push("||LAND A PUNCH - IMPACT STYLE: CLASSIC|||||DO:~LAND A PUNCH~GET:~THE HIT SPARK ALONE: NO BURSTS, SHARDS, HIT STOP OR WORDS~NEEDS:~IMPACT STYLE: CLASSIC (DEFAULT ARCADE)");
	}

	// RSQ Whip (Whip/README.md)
	static void RowsWhip(out Array<String> r)
	{
		r.Push("||START A MAP|||||DO:~START A MAP~GET:~WITHIN A SECOND YOU ARE GIVEN THE WHIP IN SLOT 1. YOU ARE NOT SWITCHED TO IT~NEEDS:~WHIP: ON, WHIP IN SLOT 1: ON (DEFAULTS)");
		r.Push("||PRESS A KEY BOUND TO SLOT 1, OR STEP TO THE WHIP WITH NEXT OR PREVIOUS WEAPON|||||DO:~PRESS A KEY BOUND TO SLOT 1, OR STEP TO THE WHIP WITH NEXT OR PREVIOUS WEAPON~GET:~THE WHIP COMES UP IN THE WHIP IN HAND, COILED AT THE HANDLE WITH A SHORT TAIL HANGING~NEEDS:~WHIP IN: MAIN HAND (DEFAULT)");
		r.Push("||GET THE WHIP INTO THE HAND WHIP IN DOES NOT NAME|||||DO:~GET THE WHIP INTO THE HAND WHIP IN DOES NOT NAME~GET:~WITHIN A SECOND IT IS MOVED TO THE WHIP IN HAND");
		r.Push("||OWN THE WHIP AND HOLD IT IN NEITHER HAND|||||DO:~OWN THE WHIP AND HOLD IT IN NEITHER HAND~GET:~IT HANGS COILED AT THE MAIN HAND'S HIP~NEEDS:~SHOW WHIP: ON (DEFAULT)");
		r.Push("||HOLD THE WHIP AND MOVE THAT HAND|||||DO:~HOLD THE WHIP AND MOVE THAT HAND~GET:~THE THONG, 25 LINKS AND 1.8 M LONG, FOLLOWS THE HANDLE. IT TOUCHES AND HURTS NOTHING. THE WEAPON NEVER FIRES A SHOT");
		r.Push("||WIDE SWING|||||DO:~WIDE SWING: SWING THE WHIP HAND IN A WIDE LEVEL ARC ROUND YOUR BODY: 70 DEGREES OF BEARING IN A FIFTH OF A SECOND, AT 2 M/S OR MORE~GET:~EVERY MONSTER IN SIGHT WITHIN 2.6 M, IN THE 120 DEGREES IN FRONT OF THE SWING (60 EITHER SIDE OF ITS MIDDLE), TAKES 8 DAMAGE, IS PUSHED AWAY AND FLINCHES. YOU HEAR THE LIGHT CRACK");
		r.Push("||HIT AT LEAST ONE MONSTER WITH A WIDE SWING|||||DO:~HIT AT LEAST ONE MONSTER WITH A WIDE SWING~GET:~SLOW MOTION IS ASKED FOR, HALF A SECOND~NEEDS:~RSQ SLOWMO LOADED");
		r.Push("||GROUND CRACK|||||DO:~GROUND CRACK: FLICK THE WHIP HAND HARD DOWNWARD: 1.6 M/S OR MORE DOWN, MORE DOWN THAN ACROSS, THEN STOPPED DEAD WITHIN A NINTH OF A SECOND~GET:~THE THONG FLIES TO THE FLOOR WHERE THE HAND'S LINE MEETS IT WITHIN 4.5 M. IF THAT LINE MEETS NO FLOOR THERE, IT FLIES TO THE FLOOR UNDER WHERE THE LINE ENDS");
		r.Push("||WAIT 5 TICS FOR THE THONG TO LAND|||||DO:~WAIT 5 TICS FOR THE THONG TO LAND~GET:~THE IMPACT: THE HEAVY CRACK, SPARKS AND A RING OF SPARKS AND DUST RUNNING OUT ALONG THE FLOOR. EVERY LIVING HOSTILE MONSTER IN YOUR SIGHT WITHIN 3 M OF THE SPOT IS THROWN UP INTO THE AIR AND OUTWARD, AND FLINCHES. IT TAKES NO DAMAGE");
		r.Push("||CATCH A BOSS, A MONSTER THAT CANNOT BE PUSHED, OR ONE OF MASS 1000 OR MORE IN THE SHOCKWAVE|||||DO:~CATCH A BOSS, A MONSTER THAT CANNOT BE PUSHED, OR ONE OF MASS 1000 OR MORE IN THE SHOCKWAVE~GET:~IT FLINCHES AND IS NOT THROWN");
		r.Push("||CATCH A FLYING MONSTER IN THE SHOCKWAVE|||||DO:~CATCH A FLYING MONSTER IN THE SHOCKWAVE~GET:~IT IS PUSHED OUTWARD AND FLINCHES, AND IS NOT LIFTED");
		r.Push("||CATCH AT LEAST ONE MONSTER IN THE SHOCKWAVE|||||DO:~CATCH AT LEAST ONE MONSTER IN THE SHOCKWAVE~GET:~SLOW MOTION IS ASKED FOR, ONE SECOND~NEEDS:~RSQ SLOWMO LOADED");
		r.Push("||CATCH A MONSTER IN THE SHOCKWAVE|||||DO:~CATCH A MONSTER IN THE SHOCKWAVE~GET:~RSQ SCORE IS TOLD THAT YOUR GROUND CRACK CAUGHT IT. KILL IT WITHIN 2 S WHILE IT IS STILL IN THE AIR AND SCORE GIVES ITS GROUND CRACK ROW~NEEDS:~RSQ SCORE LOADED");
		r.Push("||SNAP TURN, STICK TURN, OR TURN YOUR HEAD|||||DO:~SNAP TURN, STICK TURN, OR TURN YOUR HEAD~GET:~NEITHER MOVE STARTS. AFTER A SNAP OR STICK TURN NONE STARTS FOR 8 TICS");
		r.Push("||RAISE THE WHIP HAND TO SHOULDER HEIGHT OR HIGHER WITH THE HANDLE POINTING UP AND BACK, AND HOLD IT THERE A MOMENT|||||DO:~RAISE THE WHIP HAND TO SHOULDER HEIGHT OR HIGHER WITH THE HANDLE POINTING UP AND BACK, AND HOLD IT THERE A MOMENT~GET:~THE COIL PAYS OUT AND THE THONG STIFFENS INTO A LINE OUT OF THE HANDLE. SWING FORWARD AND IT FOLLOWS LIKE A ROD. THIS HITS NOTHING");
		r.Push("||HOLD THE WHIP STILL FOR ABOUT A SECOND|||||DO:~HOLD THE WHIP STILL FOR ABOUT A SECOND~GET:~THE THONG REELS BACK INTO ITS COIL");
		r.Push("||PULL THE WHIP HAND'S TRIGGER OR ALT FIRE|||||DO:~PULL THE WHIP HAND'S TRIGGER OR ALT FIRE~GET:~NOTHING: THE WEAPON HAS NO SHOT AND READS NO BUTTON");
		r.Push("||SWITCH TO ANOTHER WEAPON|||||DO:~SWITCH TO ANOTHER WEAPON~GET:~THE THONG IS GONE WITHIN 2 TICS. A GROUND CRACK STILL IN THE AIR MAKES NO IMPACT");
		r.Push("||DIE|||||DO:~DIE~GET:~THE THONG IS GONE");
		r.Push("||SET WHIP IN TO OFF HAND||OFF|||DO:~SET WHIP IN TO OFF HAND~GET:~THE WHIP LIVES IN THE OFF HAND~NEEDS:~WHIP IN: OFF HAND (DEFAULT MAIN HAND)");
		r.Push("||TURN HAND ON THE HANDLE OFF|||||DO:~TURN HAND ON THE HANDLE OFF~GET:~NO HAND IS DRAWN ON THE HANDLE; THE WHIP DRAWS ITS OWN HANDLE~NEEDS:~HAND ON THE HANDLE: OFF (DEFAULT ON)");
	}

	// RSQ Grenade (Grenade/README.md)
	static void RowsGrenade(out Array<String> r)
	{
		r.Push("||START A NEW GAME, OR RESPAWN WITHOUT THE GRENADE|||||DO:~START A NEW GAME, OR RESPAWN WITHOUT THE GRENADE~GET:~YOU ARE GIVEN THE GRENADE (WEAPON SLOT 9) AND 3 GRENADES. IT IS NOT PUT IN YOUR HAND~NEEDS:~GRENADES: ON (DEFAULT); START WITH (DEFAULT 3)");
		r.Push("||PICK THE GRENADE FROM WEAPON SLOT 9|||||DO:~PICK THE GRENADE FROM WEAPON SLOT 9~GET:~IT COMES INTO THE HAND, RING IN. ITS OWN TRIGGER FIRES NOTHING: THE BUTTONS AND HANDS BELOW ARE READ INSTEAD");
		r.Push("||WALK OVER A GRENADE, OR A PACK OF THREE, LYING IN A MAP|||||DO:~WALK OVER A GRENADE, OR A PACK OF THREE, LYING IN A MAP~GET:~1 OR 3 GRENADES. YOU CARRY 8, OR 16 WITH A BACKPACK~NEEDS:~GRENADES IN LEVELS: ON (DEFAULT) PUTS UP TO 4 SINGLES AND 2 PACKS BESIDE EACH MAP'S ITEMS");
		r.Push("||PRESS QUICK GRENADE OR THE ENGINE'S +USER1 BUTTON|KEY:rsqgn_quickthrow||||DO:~PRESS QUICK GRENADE (NO KEY IS BOUND UNTIL YOU BIND ONE) OR THE ENGINE'S +USER1 BUTTON (BRUTAL DOOM'S TOSS GRENADE)~GET:~ONE GRENADE IS THROWN FROM YOUR BODY ALONG WHERE YOU LOOK, WHATEVER YOUR HANDS HOLD: PIN SOUND AFTER 7 TICS, TOSS SOUND AFTER 15, OUT AFTER 17 AT 45 UNITS A TIC. THE NEXT PRESS IS TAKEN AFTER 22 TICS~NEEDS:~QUICK GRENADE: ON (DEFAULT)");
		r.Push("||PRESS QUICK GRENADE WITH NO GRENADES LEFT|KEY:rsqgn_quickthrow||||DO:~PRESS QUICK GRENADE WITH NO GRENADES LEFT~GET:~\"NO GRENADES\" IS SHOWN. NOTHING IS THROWN~NEEDS:~QUICK GRENADE: ON (DEFAULT)");
		r.Push("||PRESS QUICK GRENADE WHILE THE GRENADE IN YOUR HAND HAS ITS PIN OUT|KEY:rsqgn_quickthrow||||DO:~PRESS QUICK GRENADE WHILE THE GRENADE IN YOUR HAND HAS ITS PIN OUT~GET:~NOTHING");
		r.Push("||BRING THE OTHER HAND WITHIN 12 CM OF THE RING ON THE GRENADE AND PRESS THE OTHER HAND'S PRIMARY FIRE|||||DO:~BRING THE OTHER HAND WITHIN 12 CM OF THE RING ON THE GRENADE AND PRESS THE OTHER HAND'S PRIMARY FIRE~GET:~THE RING IS TAKEN: A SHORT BUZZ IN THE OTHER HAND");
		r.Push("||KEEP THAT FIRE HELD AND PULL THE OTHER HAND MORE THAN 20 CM FROM THE RING|||||DO:~KEEP THAT FIRE HELD AND PULL THE OTHER HAND MORE THAN 20 CM FROM THE RING~GET:~THE PIN IS OUT: A PIN SOUND, A BUZZ IN THE OTHER HAND, AND THE RING IS NO LONGER DRAWN. NOTHING BURNS YET");
		r.Push("||HOLD PRIMARY FIRE OR SECONDARY FIRE ON THE GRENADE HAND WITH THE GRENADE AT YOUR MOUTH FOR 12 TICS||MOUTH|||DO:~HOLD PRIMARY FIRE OR SECONDARY FIRE ON THE GRENADE HAND WITH THE GRENADE AT YOUR MOUTH (WITHIN 15 CM OF THE LINE FROM YOUR LIPS TO UNDER YOUR CHIN) FOR 12 TICS~GET:~THE PIN COMES OUT IN YOUR TEETH: A PIN SOUND AND A BUZZ IN THE GRENADE HAND~NEEDS:~PIN WITH YOUR TEETH: ON (DEFAULT)");
		r.Push("||WITH THE PIN OUT, HOLD PRIMARY FIRE OR SECONDARY FIRE ON THE GRENADE HAND, SWING THE ARM, AND LET GO OF BOTH WHILE THE HAND MOVES AT 2.2 M/S OR MORE|||||DO:~WITH THE PIN OUT, HOLD PRIMARY FIRE OR SECONDARY FIRE ON THE GRENADE HAND, SWING THE ARM, AND LET GO OF BOTH WHILE THE HAND MOVES AT 2.2 M/S OR MORE~GET:~THROWN. IT LEAVES THE HAND ALONG THE WAY THE HAND MOVED, AT TWICE THE HAND'S FASTEST SPEED AWAY FROM YOU IN THE LAST 7 TICS (AT MOST 30 M/S), WITH YOUR OWN RUNNING SPEED ADDED. A THROW STEEPER THAN 40 DEGREES UP IS LAID DOWN TO 40~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S); THROW STRENGTH (DEFAULT 0.5)");
		r.Push("||WITH THE PIN OUT, HOLD FIRE ON THE GRENADE HAND AND LET GO WITH THE HAND SLOWER THAN 2.2 M/S|||||DO:~WITH THE PIN OUT, HOLD FIRE ON THE GRENADE HAND AND LET GO WITH THE HAND SLOWER THAN 2.2 M/S~GET:~THE SPOON FLIES OFF AND THE FUSE BURNS IN YOUR HAND (COOKING): A CLINK AND A BUZZ. THE FUSE IS 3 SECONDS~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S); FUSE (DEFAULT 3 S)");
		r.Push("||WHILE IT COOKS, PRESS AND LET GO OF PRIMARY FIRE OR SECONDARY FIRE ON THE GRENADE HAND|||||DO:~WHILE IT COOKS, PRESS AND LET GO OF PRIMARY FIRE OR SECONDARY FIRE ON THE GRENADE HAND~GET:~THROWN, HOWEVER SLOWLY THE HAND MOVES. IT KEEPS WHAT IS LEFT OF THE FUSE");
		r.Push("||HOLD A COOKING GRENADE UNTIL ITS FUSE ENDS|||||DO:~HOLD A COOKING GRENADE UNTIL ITS FUSE ENDS~GET:~IT GOES OFF AT YOUR BODY WITH ITS FULL BLAST AND ONE GRENADE IS USED");
		r.Push("||WATCH OR LISTEN TO A GRENADE WHOSE FUSE BURNS, IN THE HAND OR THROWN|||||DO:~WATCH OR LISTEN TO A GRENADE WHOSE FUSE BURNS, IN THE HAND OR THROWN~GET:~IT FLASHES RED WITH A TICK: EVERY 16 TICS WITH THE WHOLE FUSE LEFT, DOWN TO EVERY 2 AT THE END");
		r.Push("||WITH THE PIN OUT AND THE SPOON STILL ON, BRING THE OTHER HAND WITHIN ABOUT 7 CM OF WHERE THE RING WAS AND PRESS ITS PRIMARY FIRE|||||DO:~WITH THE PIN OUT AND THE SPOON STILL ON, BRING THE OTHER HAND WITHIN ABOUT 7 CM OF WHERE THE RING WAS AND PRESS ITS PRIMARY FIRE~GET:~THE PIN GOES BACK IN: A PIN SOUND AND A BUZZ. NO GRENADE IS USED");
		r.Push("||SWITCH WEAPONS, OR DIE, WHILE THE GRENADE COOKS|||||DO:~SWITCH WEAPONS, OR DIE, WHILE THE GRENADE COOKS~GET:~THE LIT GRENADE DROPS AT YOUR FEET AND GOES OFF WHEN ITS FUSE ENDS");
		r.Push("||SWITCH WEAPONS WITH THE PIN OUT AND THE SPOON STILL ON|||||DO:~SWITCH WEAPONS WITH THE PIN OUT AND THE SPOON STILL ON~GET:~THE PIN GOES BACK IN. NO GRENADE IS USED");
		r.Push("||WITH THE PIN IN AND THE GRENADE AWAY FROM YOUR MOUTH, PRESS SECONDARY FIRE ON THE GRENADE HAND||MOUTH|||DO:~WITH THE PIN IN AND THE GRENADE AWAY FROM YOUR MOUTH, PRESS SECONDARY FIRE ON THE GRENADE HAND~GET:~THE NEXT GRENADE TYPE: FRAG, IMPACT, INCENDIARY, FREEZE, STUN, SMOKE, FLASH, CHARM, INFIGHT, THEN FRAG AGAIN. A CLICK, A BUZZ, AND THE GRENADE TAKES THAT TYPE'S COLOUR~NEEDS:~ALT FIRE CHANGES TYPE: ON (DEFAULT); GRENADE TYPES: ALL TYPES (DEFAULT)");
		r.Push("||THROW A FRAG|||||DO:~THROW A FRAG~GET:~WHEN THE FUSE ENDS: 85 DAMAGE OVER 200 UNITS, THEN 75 OVER 255 A TIC LATER. IT HURTS YOU TOO. UNTIL THEN IT BOUNCES OFF FLOORS, WALLS AND MONSTERS AND SLIDES TO A STOP~NEEDS:~FLOOR BOUNCE (DEFAULT 0.5); WALL BOUNCE (DEFAULT 0.25); GRAVITY (DEFAULT 0.35)");
		r.Push("||THROW AN IMPACT|||||DO:~THROW AN IMPACT~GET:~IT BURSTS WITH THE FRAG'S BLAST ON THE FIRST THING IT TOUCHES, ONCE IT IS 2 TICS OUT OF THE HAND");
		r.Push("||THROW AN INCENDIARY|||||DO:~THROW AN INCENDIARY~GET:~THE FRAG'S BLAST, THEN THE GROUND BURNS FOR 4 SECONDS OVER 200 UNITS: 1 DAMAGE EVERY 7 TICS TO EACH MONSTER STANDING IN IT");
		r.Push("||THROW A FREEZE|||||DO:~THROW A FREEZE~GET:~NO BLAST DAMAGE. MONSTERS WITHIN 200 UNITS THAT IT CAN SEE ARE FROZEN FOR 3 SECONDS. BOSSES ARE NOT");
		r.Push("||THROW A STUN|||||DO:~THROW A STUN~GET:~HALF THE FRAG'S DAMAGE. MONSTERS WITHIN 200 UNITS ARE HELD IN THEIR PAIN FRAMES FOR 3 SECONDS. BOSSES ARE NOT");
		r.Push("||THROW A SMOKE|||||DO:~THROW A SMOKE~GET:~NO DAMAGE. A CLOUD 68 UNITS IN RADIUS (2 M) FOR 12 SECONDS: A MONSTER IN IT, OR WHOSE LINE TO ITS TARGET CROSSES IT, LOSES THAT TARGET");
		r.Push("||THROW A FLASH|||||DO:~THROW A FLASH~GET:~NO DAMAGE. MONSTERS WITHIN 200 UNITS ARE STAGGERED FOR 3 SECONDS AND FORGET THEIR TARGET");
		r.Push("||THROW A CHARM|||||DO:~THROW A CHARM~GET:~NO DAMAGE. MONSTERS WITHIN 200 UNITS FIGHT ON YOUR SIDE FOR 15 SECONDS. BOSSES ARE NOT TURNED");
		r.Push("||THROW AN INFIGHT|||||DO:~THROW AN INFIGHT~GET:~NO DAMAGE. MONSTERS WITHIN 200 UNITS TURN ON THE NEAREST OTHER MONSTER FOR 15 SECONDS. BOSSES ARE NOT TURNED");
		r.Push("||SHOOT A THROWN GRENADE - SHOOT GRENADES: ON|||||DO:~SHOOT A THROWN GRENADE: A BULLET FROM EITHER HAND PASSING WITHIN 0.35 M OF IT, OR A PLAYER'S ROCKET OR OTHER PROJECTILE PASSING AS NEAR, 6 TICS OR MORE AFTER IT LEFT THE HAND~GET:~IT GOES OFF WHERE IT IS. IN THE AIR IT IS A SKEET: A GOLD BURST IS ADDED. IN CO-OP THE SHOOTER GETS THE KILLS~NEEDS:~SHOOT GRENADES: ON (DEFAULT); SHOT REACH (DEFAULT 0.35 M); GRENADE EXPLOSION: NEW (DEFAULT) FOR THE GOLD BURST");
		r.Push("||THROW THE LAST GRENADE|||||DO:~THROW THE LAST GRENADE~GET:~THE MAIN HAND PICKS ANOTHER WEAPON; AN OFF HAND IS LEFT EMPTY");
		r.Push("||SHOOT A BARREL, OR CATCH IT IN A BLAST|||||DO:~SHOOT A BARREL, OR CATCH IT IN A BLAST~GET:~IT STANDS 5 TICS, BLINKS LIT AND UNLIT FOR 10, THEN GOES OFF WITH ONE OF FIVE EXPLOSIONS PICKED AT RANDOM: 128 DAMAGE REACHING 192 UNITS~NEEDS:~BARRELS: ON (DEFAULT); BARREL EXPLOSION: RANDOM (DEFAULT); BARREL BLAST RADIUS (DEFAULT 1.5)");
		r.Push("||SET OFF A ROW OF BARRELS, EACH BY THE BLAST OF THE ONE BEFORE|||||DO:~SET OFF A ROW OF BARRELS, EACH BY THE BLAST OF THE ONE BEFORE~GET:~EACH BARREL DOWN THE CHAIN BLOWS BIGGER AND BLINKS SHORTER. FROM THE THIRD BARREL THE BLAST REACHES FURTHER (240, 288, THEN 336 UNITS) AND THE SCREEN KICKS A LITTLE~NEEDS:~CHAIN: ON (DEFAULT); CHAIN ESCALATION: ON (DEFAULT); SCREEN KICK ON CHAINS: ON (DEFAULT)");
		r.Push("||RUN THAT CHAIN UNDER OPEN SKY TO ITS THIRD BARREL OR FURTHER|||||DO:~RUN THAT CHAIN UNDER OPEN SKY TO ITS THIRD BARREL OR FURTHER~GET:~EVERY 3RD BARREL PLAYS THE MEGA BLAST IN PLACE OF ITS OWN, AND EVERY 5TH THE MUSHROOM MEGA. THE DAMAGE IS STILL THE BARREL'S~NEEDS:~CHAIN MEGA EVERY (DEFAULT 3); CHAIN MUSHROOM EVERY (DEFAULT 5); BIG BLASTS OUTDOORS ONLY: ON (DEFAULT); MEGA EXPLOSION SIZE (DEFAULT 0.6)");
		r.Push("||THROW WITH ARC RAISED|||||DO:~THROW WITH ARC RAISED~GET:~THAT SHARE OF THE THROW'S SPEED ACROSS THE GROUND IS ADDED UPWARD~NEEDS:~ARC ABOVE 0 (DEFAULT 0)");
		r.Push("||SHOOT A THROWN GRENADE WHILE TIME IS NOT SLOWED|||||DO:~SHOOT A THROWN GRENADE WHILE TIME IS NOT SLOWED~GET:~NOTHING: IT CAN BE SHOT ONLY IN SLOW MOTION~NEEDS:~ONLY IN SLOW MOTION: ON (DEFAULT OFF); RSQ SLOWMO");
		r.Push("||THROW A GRENADE IN SLOW MOTION|||||DO:~THROW A GRENADE IN SLOW MOTION~GET:~IT RUNS HALF WAY BETWEEN THE WORLD'S SPEED AND REAL SPEED, NOT AT THE WORLD'S~NEEDS:~FASTER IN SLOW MOTION: ON (DEFAULT OFF); SLOW MOTION SPEED (DEFAULT 0.5); RSQ SLOWMO");
		r.Push("||STAND IN THE FIRE OF YOUR OWN INCENDIARY|||||DO:~STAND IN THE FIRE OF YOUR OWN INCENDIARY~GET:~IT BURNS YOU TOO~NEEDS:~YOUR FIRE BURNS YOU: YES (DEFAULT AUTO: ONLY WITH BRUTAL DOOM LOADED)");
		r.Push("||PRESS SECONDARY FIRE ON THE GRENADE HAND WITH THE PIN IN - ALT FIRE CHANGES TYPE: OFF|||||DO:~PRESS SECONDARY FIRE ON THE GRENADE HAND WITH THE PIN IN~GET:~NOTHING: THE TYPE STAYS~NEEDS:~ALT FIRE CHANGES TYPE: OFF (DEFAULT ON)");
		r.Push("||PRESS SECONDARY FIRE ON THE GRENADE HAND WITH THE PIN IN - GRENADE TYPES: FRAG ONLY|||||DO:~PRESS SECONDARY FIRE ON THE GRENADE HAND WITH THE PIN IN~GET:~NOTHING: ONLY THE FRAG EXISTS~NEEDS:~GRENADE TYPES: FRAG ONLY (DEFAULT ALL TYPES)");
		r.Push("||HOLD THE SQUEEZED GRENADE AT YOUR MOUTH||MOUTH|||DO:~HOLD THE SQUEEZED GRENADE AT YOUR MOUTH~GET:~NOTHING: ONLY THE RING PULL TAKES THE PIN OUT~NEEDS:~PIN WITH YOUR TEETH: OFF (DEFAULT ON)");
		r.Push("||PRESS QUICK GRENADE OR +USER1|KEY:rsqgn_quickthrow||||DO:~PRESS QUICK GRENADE OR +USER1~GET:~NOTHING~NEEDS:~QUICK GRENADE: OFF (DEFAULT ON)");
		r.Push("||SHOOT A THROWN GRENADE - SHOOT GRENADES: OFF|||||DO:~SHOOT A THROWN GRENADE~GET:~NOTHING~NEEDS:~SHOOT GRENADES: OFF (DEFAULT ON)");
		r.Push("||START A NEW GAME|||||DO:~START A NEW GAME~GET:~YOU ARE GIVEN NO GRENADE AND NONE ARE SCATTERED. A GRENADE YOU ALREADY CARRY STILL WORKS IN THE HAND~NEEDS:~GRENADES: OFF (DEFAULT ON)");
		r.Push("||SHOOT A BARREL|||||DO:~SHOOT A BARREL~GET:~DOOM'S OWN BARREL DEATH, UNCHANGED~NEEDS:~BARRELS: OFF (DEFAULT ON)");
	}

	// RSQ FnF (Flash and Flare) (FlashFlare/README.md)
	static void RowsFlashFlare(out Array<String> r)
	{
		r.Push("||START A NEW GAME, OR COME BACK AFTER DYING|||||DO:~START A NEW GAME, OR COME BACK AFTER DYING~GET:~YOU CARRY 2 FLARES (TOPPED UP TO 2 IF YOU HAVE FEWER)~NEEDS:~FLARES: ON (DEFAULT); START WITH (DEFAULT 2)");
		r.Push("||WALK OVER A BOX OF FLARES LYING IN A MAP|||||DO:~WALK OVER A BOX OF FLARES LYING IN A MAP~GET:~6 FLARES. YOU CARRY 24 AT MOST~NEEDS:~BOXES IN LEVELS: ON (DEFAULT): EACH ITEM IN A MAP HAS ABOUT A 1 IN 21 CHANCE OF A BOX BESIDE IT, UP TO 2 BOXES A MAP");
		r.Push("||LOOK DOWN AT YOUR CHEST||CHEST|||DO:~LOOK DOWN AT YOUR CHEST~GET:~A FLARE HANGS AT THE POCKET WHILE YOU CARRY AT LEAST ONE; THE FLASHLIGHT HANGS ON ITS CLIP WHILE IT IS NOT IN YOUR HAND~NEEDS:~SHOW FLARE: ON (DEFAULT); SHOW FLASHLIGHT: ON (DEFAULT)");
		r.Push("||BRING THE OFF HAND WITHIN 11 CM OF THE POCKET AND PRESS THE GRIP||CHEST OFF|||DO:~BRING THE OFF HAND WITHIN 11 CM OF THE POCKET (ON THE CHEST TOWARD THE MAIN HAND'S SIDE: 12 CM AHEAD OF, 15 CM TO THE SIDE OF AND 28 CM UNDER YOUR EYES) AND PRESS THE GRIP~GET:~AN UNLIT FLARE, CAP ON, IS IN THE OFF HAND AND ONE IS TAKEN FROM YOUR COUNT: A PICKUP SOUND AND A SHORT BUZZ IN THE OFF HAND~NEEDS:~FLARES: ON (DEFAULT)");
		r.Push("||PRESS THAT GRIP WHILE THE ENGINE IS STEADYING YOUR MAIN WEAPON WITH BOTH HANDS|||||DO:~PRESS THAT GRIP WHILE THE ENGINE IS STEADYING YOUR MAIN WEAPON WITH BOTH HANDS~GET:~THE FLARE WAITS AND COMES UP THE TIC THE STEADYING ENDS (WHEN YOU LET THE GRIP GO). AFTER 6 SECONDS OF WAITING THE TAKE IS DROPPED WITH A LONGER BUZZ");
		r.Push("||PRESS THE GRIP AT THE POCKET WITH NO FLARES LEFT||CHEST|||DO:~PRESS THE GRIP AT THE POCKET WITH NO FLARES LEFT~GET:~\"NO FLARES LEFT\" IS SHOWN. NOTHING IS TAKEN");
		r.Push("||WITH AN UNLIT FLARE, PRESS THE GRIP AT THE POCKET AGAIN||CHEST|||DO:~WITH AN UNLIT FLARE, PRESS THE GRIP AT THE POCKET AGAIN~GET:~IT GOES BACK: YOUR COUNT GOES UP BY ONE AND THE OFF HAND GETS BACK WHAT IT HELD BEFORE");
		r.Push("||WITH AN UNLIT FLARE, PULL THE TRIGGER|||||DO:~WITH AN UNLIT FLARE, PULL THE TRIGGER~GET:~IT LIGHTS: A STRIKE SOUND, A STRONGER BUZZ, AND 24 TICS OF SPUTTER AND SPARKS BEFORE IT BURNS STEADILY~NEEDS:~LIGHT IT BY: EITHER (DEFAULT)");
		r.Push("||WITH AN UNLIT FLARE, MORE THAN 8 TICS AFTER TAKING IT, FLICK THE OFF HAND DOWN AT 1.4 M/S OR MORE||OFF|||DO:~WITH AN UNLIT FLARE, MORE THAN 8 TICS AFTER TAKING IT, FLICK THE OFF HAND DOWN AT 1.4 M/S OR MORE (THE DOWNWARD PART AT LEAST 0.6 OF THE HAND'S WHOLE SPEED)~GET:~IT LIGHTS THE SAME WAY~NEEDS:~LIGHT IT BY: EITHER (DEFAULT); STRIKE SPEED (DEFAULT 1.4 M/S)");
		r.Push("||HOLD A LIT FLARE|||||DO:~HOLD A LIT FLARE~GET:~A RED-ORANGE LIGHT OF RADIUS 140 MAP UNITS SITS AT THE BURNING END AND FLICKERS EVERY 4 TICS, WITH FLAME, SPARKS AND A CRACKLE. IT BURNS 60 SECONDS IN ALL, IN THE HAND OR OUT OF IT, AND FADES OVER THE LAST 2~NEEDS:~BURN TIME (DEFAULT 60 S); LIGHT RADIUS (DEFAULT 140)");
		r.Push("||WITH A LIT FLARE, HOLD THE TRIGGER, SWING, AND LET THE TRIGGER GO WHILE THE HAND MOVES AT 2.2 M/S OR MORE|||||DO:~WITH A LIT FLARE, HOLD THE TRIGGER (THE PULL THAT LIT IT COUNTS), SWING, AND LET THE TRIGGER GO WHILE THE HAND MOVES AT 2.2 M/S OR MORE~GET:~THROWN ALONG THE HAND'S OWN MOTION AT 4 TIMES THE HAND'S FASTEST SPEED IN THE LAST 7 TICS (AT MOST 30 M/S), WITH 0.35 OF ITS SPEED ACROSS THE GROUND ADDED UPWARD AND YOUR OWN MOVEMENT ADDED. A BUZZ. THE OFF HAND GETS BACK WHAT IT HELD~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S); THROW STRENGTH (DEFAULT 1.0); ARC (DEFAULT 0.35)");
		r.Push("||LET THE TRIGGER GO WITH THE HAND SLOWER THAN 2.2 M/S|||||DO:~LET THE TRIGGER GO WITH THE HAND SLOWER THAN 2.2 M/S~GET:~NOTHING: THE LIT FLARE STAYS IN THE HAND~NEEDS:~THROW SPEED (DEFAULT 2.2 M/S)");
		r.Push("||PRESS THE GRIP WITH A LIT FLARE, AT THE POCKET OR ANYWHERE||CHEST|||DO:~PRESS THE GRIP WITH A LIT FLARE, AT THE POCKET OR ANYWHERE~GET:~NOTHING: A LIT FLARE IS NEVER PUT BACK OR DROPPED BY THE GRIP");
		r.Push("||WATCH A THROWN FLARE|||||DO:~WATCH A THROWN FLARE~GET:~IT FALLS AT HALF OF DOOM'S GRAVITY, TUMBLES, BOUNCES OFF FLOORS, WALLS AND MONSTERS, SLIDES TO A STOP AND LIES BURNING, ITS LIGHT 12 UNITS ABOVE IT");
		r.Push("||THROW A LIT OR SPENT FLARE INTO A MONSTER|||||DO:~THROW A LIT OR SPENT FLARE INTO A MONSTER~GET:~4 DAMAGE, ONCE FOR EACH MONSTER IN ONE FLIGHT, WHILE THE FLARE STILL MOVES FASTER THAN 2 MAP UNITS A TIC");
		r.Push("||LET A FLARE BURN OUT|||||DO:~LET A FLARE BURN OUT~GET:~IN THE HAND: THE SPENT FLARE FALLS AND THE OFF HAND GETS BACK WHAT IT HELD. A SPENT FLARE LIES DARK FOR 10 SECONDS, THEN IS GONE");
		r.Push("||HAVE MORE THAN 3 FLARES BURNING|||||DO:~HAVE MORE THAN 3 FLARES BURNING~GET:~ONLY 3 GIVE LIGHT: THE OLDEST ONE LYING GOES DARK OVER 15 TICS AND BURNS ON AS FLAME AND SPARKS; THE ONE IN A HAND IS THE LAST TO GO DARK. WHEN ONE BURNS OUT, THE LAST TO GO DARK LIGHTS AGAIN~NEEDS:~MOST LIT AT ONCE (DEFAULT 3)");
		r.Push("||TAKE ANOTHER WEAPON INTO THE OFF HAND, OR DIE, WITH A FLARE OUT|||||DO:~TAKE ANOTHER WEAPON INTO THE OFF HAND, OR DIE, WITH A FLARE OUT~GET:~UNLIT: IT GOES BACK TO YOUR COUNT. LIT: IT FALLS WHERE THE HAND WAS, STILL BURNING");
		r.Push("||LEAVE THE LEVEL WITH A FLARE IN THE HAND|||||DO:~LEAVE THE LEVEL WITH A FLARE IN THE HAND~GET:~UNLIT: IT IS BACK IN YOUR COUNT ON THE NEXT MAP. LIT: IT IS USED UP. EITHER WAY THE OFF HAND GETS BACK THE WEAPON IT HELD BEFORE THE FLARE, IF YOU STILL CARRY IT");
		r.Push("||BRING THE OFF HAND WITHIN 8 CM OF THE FLASHLIGHT CLIP AND PRESS THE GRIP||CHEST OFF|||DO:~BRING THE OFF HAND WITHIN 8 CM OF THE FLASHLIGHT CLIP (ON THE CHEST TOWARD THE OFF HAND'S SIDE: 10 CM AHEAD OF, 17 CM TO THE SIDE OF AND 22 CM UNDER YOUR EYES) AND PRESS THE GRIP~GET:~THE FLASHLIGHT IS IN THE OFF HAND AND SWITCHED ON: A PICKUP SOUND, A CLICK AND A SHORT BUZZ~NEEDS:~FLASHLIGHT: ON (DEFAULT)");
		r.Push("||PULL THE TRIGGER WITH THE FLASHLIGHT IN THE HAND|||||DO:~PULL THE TRIGGER WITH THE FLASHLIGHT IN THE HAND~GET:~IT SWITCHES OFF, OR ON AGAIN: A CLICK AND A SHORT BUZZ");
		r.Push("||POINT THE LIT FLASHLIGHT - BEAM SIZE: MEDIUM|||||DO:~POINT THE LIT FLASHLIGHT~GET:~ONE SPOT LIGHT SHINES FROM THE LENS ALONG THE FLASHLIGHT FOR 448 MAP UNITS (10 DEGREES BRIGHT, 22 TO ITS EDGE), WARM WHITE, WITH A SEE-THROUGH CONE 4 M LONG THAT STOPS AT THE FIRST WALL OR MONSTER~NEEDS:~BEAM SIZE: MEDIUM, BEAM COLOUR: WARM WHITE, BEAM QUALITY: QUEST, BEAM LENGTH: 4 M, SHOW CONE: ON (ALL DEFAULTS)");
		r.Push("||PRESS THE GRIP AT THE CLIP WITH THE FLASHLIGHT IN THE HAND||CHEST|||DO:~PRESS THE GRIP AT THE CLIP WITH THE FLASHLIGHT IN THE HAND~GET:~IT GOES BACK ON THE CLIP, SWITCHED OFF: A PICKUP SOUND. THE OFF HAND GETS BACK WHAT IT HELD BEFORE");
		r.Push("||TAKE A FLARE FROM THE POCKET WHILE HOLDING THE FLASHLIGHT||CHEST|||DO:~TAKE A FLARE FROM THE POCKET WHILE HOLDING THE FLASHLIGHT~GET:~THE FLASHLIGHT IS PUT AWAY. WHEN THE FLARE IS PUT BACK, THROWN OR BURNT OUT, THE FLASHLIGHT COMES BACK AS IT WAS, ON OR OFF");
		r.Push("||PRESS THE GRIP AT THE CLIP WHILE HOLDING A FLARE||CHEST|||DO:~PRESS THE GRIP AT THE CLIP WHILE HOLDING A FLARE~GET:~NOTHING: THE OFF HAND HOLDS ONE OF THE TWO AT A TIME");
		r.Push("||LEAVE THE FLASHLIGHT ON - BATTERY (MIN)|||||DO:~LEAVE THE FLASHLIGHT ON~GET:~ITS BATTERY DRAINS: 3 MINUTES OF LIGHT FROM FULL. A METER OF 10 STEPS ON THE FLASHLIGHT'S BODY SHOWS IT. AT HALF AND UNDER THE BEAM DIMS, LOWER STILL IT NARROWS AND FLICKERS; AT THE LAST STEP THE METER BLINKS. EMPTY, IT CLICKS OFF BY ITSELF~NEEDS:~BATTERY (MIN) (DEFAULT 3); BATTERY NEVER DRAINS: OFF (DEFAULT)");
		r.Push("||LEAVE THE FLASHLIGHT OFF, IN THE HAND OR ON ITS CLIP|||||DO:~LEAVE THE FLASHLIGHT OFF, IN THE HAND OR ON ITS CLIP~GET:~IT RECHARGES AS FAST AS IT DRAINS. WITH UNDER ONE SECOND OF LIGHT LEFT IT WILL NOT SWITCH ON: THE CLICK ALONE~NEEDS:~BATTERY (MIN) (DEFAULT 3)");
		r.Push("||KILL A MONSTER THAT IS INSIDE THE LIT BEAM AND IN YOUR SIGHT|||||DO:~KILL A MONSTER THAT IS INSIDE THE LIT BEAM AND IN YOUR SIGHT~GET:~THE BATTERY GETS BACK 5% OF A FULL CHARGE~NEEDS:~BATTERY NEVER DRAINS: OFF (DEFAULT)");
		r.Push("||GO TO THE NEXT LEVEL WITH THE FLASHLIGHT|||||DO:~GO TO THE NEXT LEVEL WITH THE FLASHLIGHT~GET:~THE BATTERY'S CHARGE IS KEPT. A FLASHLIGHT IN THE HAND STAYS IN THE HAND, SWITCHED OFF. PUT BACK ON ITS CLIP ON THE NEW MAP, THE OFF HAND STILL GETS BACK THE WEAPON IT HELD BEFORE, IF YOU STILL CARRY IT");
		r.Push("||THROW A LIT FLARE INTO A ZOMBIEMAN, SHOTGUNNER, CHAINGUNNER, SS, IMP, OR ANOTHER WALKING MONSTER OF RADIUS 21 OR LESS, HEIGHT 64 OR LESS AND 100 HEALTH OR LESS|||||DO:~THROW A LIT FLARE INTO A ZOMBIEMAN, SHOTGUNNER, CHAINGUNNER, SS, IMP, OR ANOTHER WALKING MONSTER OF RADIUS 21 OR LESS, HEIGHT 64 OR LESS AND 100 HEALTH OR LESS~GET:~THE HIT IS FIRE DAMAGE AND THE MONSTER BURNS FOR 5 SECONDS: 3 FIRE DAMAGE EVERY 6 TICS (90 IN ALL) WITH FLAMES ON ITS BODY. A LEGENDOOM LEGENDARY OR A CHAMPIONS CHAMPION BURNS ONLY UNDER 25% OF ITS HEALTH~NEEDS:~BRUTAL DOOM (FOUND BY ITS CLASSES BDWEAPONSPAWNER OR BRUTALPISTOL); BOOSTED IGNITE (DEFAULT 25%)");
		r.Push("||PULL THE TRIGGER WITH AN UNLIT FLARE|||||DO:~PULL THE TRIGGER WITH AN UNLIT FLARE~GET:~NOTHING: ONLY THE FLICK LIGHTS IT~NEEDS:~LIGHT IT BY: STRIKE (DEFAULT EITHER)");
		r.Push("||FLICK AN UNLIT FLARE DOWN|||||DO:~FLICK AN UNLIT FLARE DOWN~GET:~NOTHING: ONLY THE TRIGGER LIGHTS IT~NEEDS:~LIGHT IT BY: TRIGGER (DEFAULT EITHER)");
		r.Push("||SHOOT OR OTHERWISE DAMAGE A THROWN OR DROPPED FLARE THAT STILL BURNS|||||DO:~SHOOT OR OTHERWISE DAMAGE A THROWN OR DROPPED FLARE THAT STILL BURNS~GET:~IT GOES OUT AND LIES SPENT~NEEDS:~SHOOT OUT FLARES: ON (DEFAULT OFF)");
		r.Push("||START A NEW LEVEL|||||DO:~START A NEW LEVEL~GET:~YOUR FLARES ARE TOPPED UP TO 4~NEEDS:~REFILL EACH LEVEL: ON (DEFAULT OFF); REFILL TO (DEFAULT 4)");
		r.Push("||LEAVE THE FLASHLIGHT ON - BATTERY NEVER DRAINS: ON|||||DO:~LEAVE THE FLASHLIGHT ON~GET:~THE BATTERY NEVER DRAINS AND NO METER IS DRAWN~NEEDS:~BATTERY NEVER DRAINS: ON (DEFAULT OFF), OR BATTERY (MIN): 0");
		r.Push("||SWITCH THE FLASHLIGHT ON|||||DO:~SWITCH THE FLASHLIGHT ON~GET:~THE BEAM TAKES ONE OF THE SIX COLOURS, NEVER THE ONE IT HAD LAST~NEEDS:~BEAM COLOUR: RANDOM (DEFAULT WARM WHITE)");
		r.Push("||POINT THE LIT FLASHLIGHT - BEAM QUALITY: PCVR OR HIGH|||||DO:~POINT THE LIT FLASHLIGHT~GET:~THE LIGHT REACHES 640 OR 896 MAP UNITS, THE CONE HAS TWO LAYERS AND DUST DRIFTS IN IT~NEEDS:~BEAM QUALITY: PCVR OR HIGH (DEFAULT QUEST)");
		r.Push("||POINT THE LIT FLASHLIGHT - BEAM HOTSPOT: ON|||||DO:~POINT THE LIT FLASHLIGHT~GET:~A SOFT SPOT IS DRAWN WHERE THE BEAM LANDS, OUT TO 2.5 TIMES THE LIGHT'S REACH~NEEDS:~BEAM HOTSPOT: ON (DEFAULT OFF)");
		r.Push("||POINT THE LIT FLASHLIGHT - BEAM LOOK: DARKDOOMZ|||||DO:~POINT THE LIT FLASHLIGHT~GET:~THE LIGHT TAKES THAT DARKDOOMZ TYPE'S COLOUR, ANGLES AND REACH; BEAM SIZE AND BEAM COLOUR NO LONGER APPLY. WITH THE SPILL LIGHT ON, A SECOND WIDER LIGHT IS ADDED~NEEDS:~BEAM LOOK: DARKDOOMZ (DEFAULT FNF); DARKDOOMZ BEAM TYPE (DEFAULT HALOGEN); DARKDOOMZ SPILL LIGHT (DEFAULT ON)");
		r.Push("||KILL A LEGION OF BONES MONSTER|||||DO:~KILL A LEGION OF BONES MONSTER~GET:~8 TIMES IN 100 IT DROPS ONE BATTERY BIT; A LEGENDARY OR CHAMPION ALWAYS DROPS 3. EACH BIT PICKED UP GIVES 15% OF A FULL CHARGE~NEEDS:~BONES DROP BATTERY BITS: ON (DEFAULT OFF); LEGION OF BONES; RSQ VISUALREWARDS; BATTERY NEVER DRAINS: OFF");
		r.Push("||PRESS THE GRIP AT THE POCKET||CHEST|||DO:~PRESS THE GRIP AT THE POCKET~GET:~NOTHING. NO FLARES ARE GIVEN OR SCATTERED AND NONE HANGS AT THE POCKET; A FLARE IN THE HAND IS PUT AWAY (UNLIT: BACK TO YOUR COUNT; LIT: IT FALLS BURNING). THE FLASHLIGHT STILL WORKS~NEEDS:~FLARES: OFF (DEFAULT ON)");
		r.Push("||PRESS THE GRIP AT THE CLIP||CHEST|||DO:~PRESS THE GRIP AT THE CLIP~GET:~NOTHING. A FLASHLIGHT IN THE HAND IS PUT AWAY~NEEDS:~FLASHLIGHT: OFF (DEFAULT ON)");
		r.Push("||PRESS ANOTHER BUTTON AS THE GRIP|||||DO:~PRESS ANOTHER BUTTON AS THE GRIP~GET:~THE KEY CODES TYPED IN THE ROW ARE READ AS THE OFF HAND'S GRIP, FOR THE POCKET AND THE CLIP BOTH~NEEDS:~OFF GRIP KEYS (DEFAULT \"443 436\")");
		r.Push("||REACH FOR THE POCKET OR THE CLIP SOMEWHERE ELSE||CHEST|||DO:~REACH FOR THE POCKET OR THE CLIP SOMEWHERE ELSE~GET:~THE POCKET AND THE CLIP ARE MOVED, AND HOW NEAR THE HAND MUST COME IS CHANGED~NEEDS:~POCKET: FORWARD, TOWARD MAIN HAND, HEIGHT, REACH; FLASHLIGHT CLIP: FORWARD, TOWARD OFF HAND, HEIGHT, REACH");
	}

	// RSQ Grapple (Grapple/README.md)
	static void RowsGrapple(out Array<String> r)
	{
		r.Push("||PRESS FIRE HOOK|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK (YOU BIND IT: CUSTOMIZE CONTROLS > RSQ GRAPPLE)~GET:~A CLAW FLIES FROM THE OFF HAND ALONG THE LINE A GUN IN THAT HAND WOULD FIRE, 40 UNITS A TIC, OUT TO 780 UNITS (ABOUT 23 M). IT BITES THE FIRST WALL, FLOOR, CEILING OR LIVE MONSTER IT REACHES~NEEDS:~HOOK HAND: OFF HAND (DEFAULT), FIRING LINE: ON (DEFAULT), RANGE (DEFAULT 780)");
		r.Push("||LET GO OF FIRE HOOK|KEY:+rsqgr_hook||||DO:~LET GO OF FIRE HOOK~GET:~NOTHING. THE HOOK IS ONE PRESS");
		r.Push("||HOLD THE HOOK HAND OUT WHILE THE HOOK IS READY|||||DO:~HOLD THE HOOK HAND OUT WHILE THE HOOK IS READY~GET:~A SMALL DOT SITS WHERE THE CLAW WOULD BITE: CYAN ON THE WORLD, GOLD ON A MONSTER~NEEDS:~AIM DOT: ON (DEFAULT)");
		r.Push("||HOOK A WALL, FLOOR OR CEILING|||||DO:~HOOK A WALL, FLOOR OR CEILING~GET:~ONE SHOVE TOWARD THE BITE IS ADDED TO YOUR SPEED, HARDER THE FARTHER AWAY IT IS AND UPWARD WHEN IT IS ABOVE YOU. THE CLAW STAYS SHUT 16 TICS, THEN COMES BACK");
		r.Push("||HOOK THE FACE OF A STEP WITHIN 40 UNITS UNDER ITS TOP, OR THE TOP OF A FLOOR TOO HIGH TO STEP ONTO, WITH ROOM TO STAND THERE|||||DO:~HOOK THE FACE OF A STEP WITHIN 40 UNITS UNDER ITS TOP, OR THE TOP OF A FLOOR TOO HIGH TO STEP ONTO, WITH ROOM TO STAND THERE~GET:~YOU ARE LIFTED UP THE FACE AND SET DOWN ON TOP. IT GIVES UP AFTER 45 TICS");
		r.Push("||HOOK A LIVE MONSTER|||||DO:~HOOK A LIVE MONSTER~GET:~YOU FLY STRAIGHT TO IT. ARRIVING IS A KICK: 30 DAMAGE, IT IS KNOCKED BACK AND STUNNED, AND YOU ARE THROWN OFF IT, AWAY AND ABOUT 1.5 M UP");
		r.Push("||SWING BOTH HANDS DOWN HARD TOGETHER WHILE YOU ARE IN THE AIR AND FLYING TO A HOOKED MONSTER||BOTH|||DO:~SWING BOTH HANDS DOWN HARD TOGETHER (EACH AT 3 M/S OR MORE) WHILE YOU ARE IN THE AIR AND FLYING TO A HOOKED MONSTER~GET:~THE AIR SPIKE. YOU STOP AND HANG WHERE YOU ARE, THE CLAW LETS GO, AND THE MONSTER IS DRIVEN STRAIGHT DOWN, 30 UNITS A TIC, TO THE FLOOR UNDER IT. WHERE IT LANDS: BLOOD, SIX FLAMES, AND A RING THAT SHOVES AND STUNS EVERY LIVE MONSTER WITHIN 160 UNITS. THEN YOU FALL. THERE IS NO KICK~NEEDS:~BOTH HANDS TRACKED IN VR. THE EXPLOSION NEEDS RSQ GRENADE AND THE SLOW MOTION RSQ SLOWMO (SEE WORKS WITH)");
		r.Push("||SWING BOTH HANDS DOWN THE SAME WAY WITHIN 15 TICS AFTER A KICK, WHILE YOU ARE IN THE AIR||BOTH|||DO:~SWING BOTH HANDS DOWN THE SAME WAY WITHIN 15 TICS (0.43 S) AFTER A KICK, WHILE YOU ARE IN THE AIR~GET:~THE SAME AIR SPIKE, ON THE MONSTER YOU JUST KICKED. NOT IF THE KICK KILLED IT, AND NOT WHILE YOU HANG FOR A CLAW~NEEDS:~BOTH HANDS TRACKED IN VR");
		r.Push("||SWING BOTH HANDS DOWN WHILE YOU STAND ON THE GROUND||BOTH|||DO:~SWING BOTH HANDS DOWN WHILE YOU STAND ON THE GROUND~GET:~NOTHING");
		r.Push("||AIM AT THE SKY, OR AT NOTHING WITHIN REACH|||||DO:~AIM AT THE SKY, OR AT NOTHING WITHIN REACH~GET:~THE CLAW COMES BACK EMPTY");
		r.Push("||PRESS FIRE HOOK AGAIN WHILE A CLAW IS STILL FLYING|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK AGAIN WHILE A CLAW IS STILL FLYING~GET:~ANOTHER CLAW FLIES AS WELL. EACH ONE ACTS ON WHAT IT REACHES");
		r.Push("||PRESS FIRE HOOK WHILE FLYING TO A MONSTER, BEING LIFTED ONTO A LEDGE, OR WHILE A SPIKED MONSTER FALLS|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK WHILE FLYING TO A MONSTER, BEING LIFTED ONTO A LEDGE, OR WHILE A SPIKED MONSTER FALLS~GET:~NOTHING: THE PRESS IS IGNORED. A CLAW THAT ARRIVES DURING ANY OF THEM LETS GO AND COMES BACK");
		r.Push("||KICK A SECOND MONSTER BEFORE YOU LAND|||||DO:~KICK A SECOND MONSTER BEFORE YOU LAND~GET:~THE KICK COUNTS UP (2, 3, ...). LANDING SETS THE COUNT BACK TO NONE");
		r.Push("||PRESS FIRE HOOK IN THE AIR AFTER A KICK, BEFORE YOU LAND|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK IN THE AIR AFTER A KICK, BEFORE YOU LAND~GET:~YOU STOP AND HANG WHERE YOU ARE UNTIL THE CLAW BITES, THEN THE BITE PLAYS AS USUAL. IF IT REACHES NOTHING YOU DROP AND THE KICK COUNT ENDS");
		r.Push("||PRESS FIRE HOOK AGAIN WHILE HANGING|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK AGAIN WHILE HANGING~GET:~EVERY CLAW YOU HANG FOR IS REELED IN, YOU DROP, AND THE KICK COUNT ENDS");
		r.Push("||PRESS JUMP IN THE AIR AFTER A KICK, BEFORE YOU LAND|||||DO:~PRESS JUMP IN THE AIR AFTER A KICK, BEFORE YOU LAND~GET:~A DOUBLE JUMP: UP TO ABOUT 1.5 M MORE, ONCE FOR EACH KICK. UP TO FIVE MONSTERS IN REACH AND IN SIGHT ARE MARKED");
		r.Push("||FIRE THE HOOK IN THE AIR WITH A MARKED MONSTER WITHIN 10 DEGREES OF YOUR AIM|||||DO:~FIRE THE HOOK IN THE AIR WITH A MARKED MONSTER WITHIN 10 DEGREES OF YOUR AIM~GET:~THE CLAW TURNS TO THE MARKED MONSTER NEAREST YOUR LINE~NEEDS:~AIM ASSIST: ON (DEFAULT)");
		r.Push("||HOOK A MARKED MONSTER|||||DO:~HOOK A MARKED MONSTER~GET:~ITS MARK IS TAKEN OFF (AND PAYS ITS TIME, SEE RSQ SLOWMO BELOW)");
		r.Push("||PRESS JUMP IN THE AIR IN ANY JUMP OR FALL|||||DO:~PRESS JUMP IN THE AIR IN ANY JUMP OR FALL~GET:~ONE DOUBLE JUMP, UP TO ABOUT 1.5 M, UNTIL YOU LAND. NOT UNDER WATER, FLYING OR WITH NOCLIP~NEEDS:~DOUBLE JUMP ALWAYS: ON (DEFAULT)");
		r.Push("||HOLD A GUN WITH BOTH HANDS AND PRESS FIRE HOOK|KEY:+rsqgr_hook|BOTH|||DO:~HOLD A GUN WITH BOTH HANDS AND PRESS FIRE HOOK~GET:~THE CLAW FLIES DOWN THE STEADIED GUN'S LINE. AIM TRIM IS NOT APPLIED~NEEDS:~FIRING LINE: ON (DEFAULT)");
		r.Push("||LAND|||||DO:~LAND~GET:~THE KICK COUNT ENDS, THE MARKS ARE CLEARED, AND THE DOUBLE JUMP IS YOURS AGAIN");
		r.Push("||DIE|||||DO:~DIE~GET:~THE CLAW IS REMOVED AND THE KICK COUNT ENDS");
		r.Push("||PRESS FIRE HOOK WITH HOOK HAND SET TO MAIN HAND|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK WITH HOOK HAND SET TO MAIN HAND~GET:~THE CLAW FLIES FROM THE MAIN HAND AND ALONG ITS LINE~NEEDS:~HOOK HAND: MAIN HAND (DEFAULT OFF HAND)");
		r.Push("||MOVE AIM TRIM SIDEWAYS OR AIM TRIM VERTICAL|||||DO:~MOVE AIM TRIM SIDEWAYS OR AIM TRIM VERTICAL~GET:~THE CLAW'S LINE AND THE DOT TURN LEFT OR RIGHT, UP OR DOWN, BY UP TO 15 DEGREES~NEEDS:~AIM TRIM SIDEWAYS, AIM TRIM VERTICAL (DEFAULT 0)");
		r.Push("||PRESS FIRE HOOK WITH FIRING LINE OFF|KEY:+rsqgr_hook||||DO:~PRESS FIRE HOOK WITH FIRING LINE OFF~GET:~THE CLAW FOLLOWS THE HAND'S OWN YAW AND PITCH INSTEAD OF THE GUN'S LINE; TWO-HANDING, IT FLIES WHERE YOU LOOK~NEEDS:~FIRING LINE: OFF (DEFAULT ON)");
		r.Push("||MOVE RANGE|||||DO:~MOVE RANGE~GET:~THE CLAW REACHES THAT FAR, AND THE DOT, THE DOUBLE JUMP'S MARKS AND AIM ASSIST REACH AS FAR~NEEDS:~RANGE (DEFAULT 780, 256 TO 2048)");
	}

	// RSQ Distance Grab (DistanceGrab/README.md)
	static void RowsDistanceGrab(out Array<String> r)
	{
		r.Push("||TURN A PALM OUT AND POINT THE HAND|||||DO:~TURN A PALM OUT AND POINT THE HAND~GET:~A BLUE BEAM, A DOT WHERE IT LANDS AND A FAINT CONE ARE DRAWN FROM THAT PALM. THE CONE IS WHAT THE GRAB CAN TAKE: 12 DEGREES EITHER SIDE OF THE HAND'S LINE, OUT TO 512 UNITS (ABOUT 15 M)~NEEDS:~DISTANCE GRAB: ON (DEFAULT); BEAM, DOT, REACH CONE, SHOW WHEN IDLE: ON (DEFAULT)");
		r.Push("||POINT THE PALM AT A PICKUP, A GUN, A BARREL OR A FLARE INSIDE THE CONE, WITH NOTHING IN THE WAY|||||DO:~POINT THE PALM AT A PICKUP, A GUN, A BARREL OR A FLARE INSIDE THE CONE, WITH NOTHING IN THE WAY~GET:~IT IS LOCKED AT ONCE: IT GLOWS GREEN AND BREATHES, THE BEAM TURNS GREEN AND RUNS TO IT, ONE TICK IN THAT HAND, THEN A LOW HUM WHILE IT STAYS LOCKED. THE THING NEAREST THE HAND'S LINE WINS; BARRELS, GUNS, KEYS AND FLARES WIN TIES OVER AMMO, HEALTH AND ARMOUR~NEEDS:~LINE OF SIGHT: ON (DEFAULT); TARGET GLOW: ON (DEFAULT); HAPTICS: ON (DEFAULT)");
		r.Push("||KEEP THE PALM OUT AND POINT OR LOOK ELSEWHERE|||||DO:~KEEP THE PALM OUT AND POINT OR LOOK ELSEWHERE~GET:~THE LOCK STAYS ON THAT THING. IT ENDS WHEN THE PALM TURNS BACK, WHEN THE THING IS TAKEN OR CAN NO LONGER BE GRABBED, OR WHEN IT IS MORE THAN 640 UNITS (1.25 TIMES REACH) FROM THE PALM");
		r.Push("||WITH A LOCK, TIP THE WRIST UP SHARPLY AND ROLL THE PALM BACK WITHIN A FIFTH OF A SECOND|||||DO:~WITH A LOCK, TIP THE WRIST UP SHARPLY (5 DEGREES IN ONE TIC OR FASTER) AND ROLL THE PALM BACK WITHIN A FIFTH OF A SECOND~GET:~THE THING FLIES TO THAT HAND ON AN ARC AT 22 M/S (AT LEAST 6 TICS, AT MOST 40), TURNING END OVER END ONCE AND LEAVING A FAINT GREEN TRAIL. A TICK IN THE HAND, THEN A RUMBLE THAT BUILDS AS IT COMES~NEEDS:~FLIGHT PATH: ARC (DEFAULT); FLICK STRENGTH (DEFAULT 5)");
		r.Push("||WITH A LOCK, ROLL THE PALM BACK WITHOUT THE FLICK|||||DO:~WITH A LOCK, ROLL THE PALM BACK WITHOUT THE FLICK~GET:~THE LOCK IS LET GO. NOTHING MOVES");
		r.Push("||TURN THE PALM OUT AGAIN BEFORE THE PULLED THING ARRIVES, AND HOLD IT THERE|||||DO:~TURN THE PALM OUT AGAIN BEFORE THE PULLED THING ARRIVES, AND HOLD IT THERE~GET:~CAUGHT WHEN IT COMES WITHIN 24 UNITS OF THE PALM: A THUD, A STRONG TICK (TWO FOR A HEAVY THING) AND A GREEN BLOOM AT THE PALM~NEEDS:~CATCH DISTANCE (DEFAULT 24); CATCH FLASH: ON (DEFAULT); SOUNDS: ON (DEFAULT)");
		r.Push("||LEAVE THE PALM TURNED AWAY AS THE PULLED THING ARRIVES|||||DO:~LEAVE THE PALM TURNED AWAY AS THE PULLED THING ARRIVES~GET:~IT WAITS ON THE PALM FOR 4 TICS, THEN DROPS FROM THERE~NEEDS:~CATCH WINDOW (DEFAULT 4 TICS)");
		r.Push("||CATCH A PICKUP|||||DO:~CATCH A PICKUP: AMMO, HEALTH, ARMOUR, A KEY, A POWERUP~GET:~IT IS PICKED UP AT ONCE, AS IF YOU HAD WALKED OVER IT~NEEDS:~USE ON CATCH: ON (DEFAULT)");
		r.Push("||CATCH A GUN|||||DO:~CATCH A GUN~GET:~IT IS PICKED UP AND GOES TO THE HAND THAT CAUGHT IT: THE MAIN HAND SWITCHES TO IT, OR IT IS RAISED IN THE OFF HAND. A MELEE WEAPON, AN OFF-HAND-ONLY, TWO-HANDED OR NEVER-SWITCHES WEAPON, AND A GUN ALREADY IN THE OTHER HAND, STAY WHERE THE GAME PUT THEM~NEEDS:~USE ON CATCH: ON (DEFAULT)");
		r.Push("||CATCH A GUN YOU ALREADY HAVE WITH ITS AMMO FULL, AMMO YOU ARE ALREADY FULL OF, OR A HEALTH OR ARMOUR PICKUP YOU CANNOT USE|||||DO:~CATCH A GUN YOU ALREADY HAVE WITH ITS AMMO FULL, AMMO YOU ARE ALREADY FULL OF, OR A HEALTH OR ARMOUR PICKUP YOU CANNOT USE~GET:~IT IS NOT TAKEN. AMMO FULL, HEALTH FULL OR ARMOR FULL IS SHOWN, THE HAND GETS A SOFT BUZZ, AND THE THING IS PUT AT YOUR FEET. CAUGHT BY THE OFF HAND, THE GUN YOU ALREADY OWN IS RAISED IN THE OFF HAND~NEEDS:~USE ON CATCH: ON (DEFAULT)");
		r.Push("||CATCH A BARREL, OR ANY OTHER PICKUP THE GAME WOULD NOT TAKE|||||DO:~CATCH A BARREL, OR ANY OTHER PICKUP THE GAME WOULD NOT TAKE (NOT A GUN, AMMO, HEALTH OR ARMOUR)~GET:~IT IS CARRIED: IT FLOATS ABOUT 30 CM AHEAD OF THAT HAND AND FOLLOWS IT ON A SPRING, LAGGING AND HANGING LOWER THE HEAVIER IT IS, AND IT TIPS WITH YOUR WRIST~NEEDS:~TIP WITH WRIST: ON (DEFAULT); HOLD DISTANCE (DEFAULT 0.30 M)");
		r.Push("||CARRY SOMETHING HEAVY|||||DO:~CARRY SOMETHING HEAVY~GET:~YOU MOVE SLOWER: A 60 KG BARREL LEAVES YOU AT TWO THIRDS OF YOUR SPEED~NEEDS:~HEAVY SLOWS YOU: ON (DEFAULT); HALF SPEED MASS (DEFAULT 120 KG)");
		r.Push("||ROLL THE PALM BACK WHILE THE CARRYING HAND IS STILL|||||DO:~ROLL THE PALM BACK WHILE THE CARRYING HAND IS STILL~GET:~THE THING IS SET DOWN: IT DROPS WHERE IT IS");
		r.Push("||SWING THE CARRYING ARM AWAY FROM YOU AND ROLL THE PALM BACK|||||DO:~SWING THE CARRYING ARM AWAY FROM YOU AND ROLL THE PALM BACK~GET:~THROWN, WITH A WHOOSH. THE HAND HOLDS ON UNTIL THE FORWARD STROKE PEAKS (AT MOST 9 TICS), THEN THE THING LEAVES AT THE STROKE'S FASTEST SPEED TIMES ARM / (ARM + ITS WEIGHT) TIMES 2.5: A CLIP AT ABOUT 2.5 TIMES YOUR HAND'S SPEED, A 60 KG BARREL AT ABOUT 0.8 TIMES~NEEDS:~THROW STRENGTH (DEFAULT 1); THROW BOOST (DEFAULT 2.5); ARM WEIGHT (DEFAULT 30 KG)");
		r.Push("||THROW WITHIN 12 DEGREES OF A MONSTER YOU CAN SEE, UP TO 1200 UNITS AWAY|||||DO:~THROW WITHIN 12 DEGREES OF A MONSTER YOU CAN SEE, UP TO 1200 UNITS AWAY~GET:~THE THROW BENDS ONTO THE MONSTER AND IS LOBBED TO COME DOWN ON ITS MIDDLE~NEEDS:~THROW AIM ASSIST (DEFAULT 12)");
		r.Push("||HIT A MONSTER WITH A THROWN THING - IMPACT DAMAGE|||||DO:~HIT A MONSTER WITH A THROWN THING~GET:~DAMAGE BY WEIGHT AND SPEED: HALF ITS KILOGRAMS TIMES ITS SPEED SQUARED, ONE POINT FOR EVERY 15 JOULES, NOTHING UNDER 3 M/S. 20 DAMAGE OR MORE PUTS THE MONSTER IN PAIN AND SHOVES IT~NEEDS:~IMPACT DAMAGE (DEFAULT 15); MIN IMPACT SPEED (DEFAULT 3 M/S); STAGGER FROM (DEFAULT 20)");
		r.Push("||THROW A BARREL AT 4 M/S OR MORE|||||DO:~THROW A BARREL AT 4 M/S OR MORE (DISTANCE GRAB'S OWN THROW: RSQ MELEE NOT LOADED, OR ITS BARREL LAUNCH OFF)~GET:~IT GOES OFF WHERE IT FIRST HITS OR LANDS, AND THE KILLS ARE YOURS~NEEDS:~BARREL BLAST (DEFAULT 4 M/S)");
		r.Push("||THROW A CARRIED BARREL WITH RSQ MELEE LOADED|||||DO:~THROW A CARRIED BARREL WITH RSQ MELEE LOADED~GET:~THE THROW IS MELEE'S. THE HAND LETS GO AS ON ANY THROW (THE WHOOSH, THE TICK, \"HOLD.THROW\" TOLD), AND MELEE LAUNCHES THE BARREL AS IT LAUNCHES A PUNCHED ONE: TO THE MONSTER THAT HAND'S TRIGGER HAS PAINTED, OR WITH NONE PAINTED THE WAY IT WAS THROWN. THROW STRENGTH, THROW BOOST, THE AIM ASSIST, BARREL BLAST AND THE IMPACT RULE DO NOT APPLY TO IT. A BARREL SET DOWN IS SET DOWN AS BEFORE~NEEDS:~RSQ MELEE WITH ITS BARREL LAUNCH: ON (DEFAULT)");
		r.Push("||PUT A PALM WITHIN 30 CM OF A PICKUP, A GUN, A BARREL OR A FLARE AND PRESS THAT HAND'S GRIP|||||DO:~PUT A PALM WITHIN 30 CM OF A PICKUP, A GUN, A BARREL OR A FLARE AND PRESS THAT HAND'S GRIP~GET:~WALK-UP GRAB. A PICKUP IS PICKED UP (A GUN INTO THAT HAND); A BARREL IS CARRIED AND THE GRIP NOW HOLDS IT. A GUN, HEALTH OR ARMOUR YOU CANNOT USE IS LEFT WHERE IT IS, WITH THE SAME AMMO FULL, HEALTH FULL OR ARMOR FULL~NEEDS:~WALK UP GRAB: ON (DEFAULT); WALK UP REACH (DEFAULT 0.30 M)");
		r.Push("||LET GO OF THE GRIP WHILE IT HOLDS A CARRIED THING|||||DO:~LET GO OF THE GRIP WHILE IT HOLDS A CARRIED THING~GET:~A STILL HAND SETS IT DOWN. A MOVING HAND THROWS IT, BY THE SAME RULE AS THE PALM'S THROW");
		r.Push("||PRESS THE GRIP WHILE THE HAND CARRIES A THING THE PALM CAUGHT, OR KEEP THE GRIP SQUEEZED AS A PULLED THING ARRIVES|||||DO:~PRESS THE GRIP WHILE THE HAND CARRIES A THING THE PALM CAUGHT, OR KEEP THE GRIP SQUEEZED AS A PULLED THING ARRIVES~GET:~THE GRIP TAKES THE CARRY OVER: THE PALM NO LONGER MATTERS, AND THE THING STAYS IN THE HAND UNTIL THE GRIP IS LET GO");
		r.Push("||LAY THE OTHER PALM ON A CARRIED THING, THAT HAND CARRYING NOTHING||BOTH|||DO:~LAY THE OTHER PALM ON A CARRIED THING (WITHIN ITS BODY PLUS 25 CM), THAT HAND CARRYING NOTHING~GET:~BOTH HANDS CARRY IT: A THUD, IT SITS BETWEEN THE TWO HANDS AND HANDLES AS IF HALF AS HEAVY, SO IT FOLLOWS FASTER, SAGS LESS AND THROWS HARDER~NEEDS:~TWO HAND LIFT (DEFAULT 2)");
		r.Push("||SWING A CARRIED THING INTO A MONSTER AT 3 M/S OR MORE|||||DO:~SWING A CARRIED THING INTO A MONSTER AT 3 M/S OR MORE~GET:~IT HITS, BY THE SAME WEIGHT AND SPEED RULE AS A THROW: ONCE PER SWING FOR EACH MONSTER, UP TO 4, WITH A THUD AND A TICK IN THE HAND~NEEDS:~SWING HITS: ON (DEFAULT); SWING HITS FROM (DEFAULT 3 M/S)");
		r.Push("||HOLD A CARRIED BARREL BETWEEN YOU AND A FIREBALL OR OTHER PROJECTILE|||||DO:~HOLD A CARRIED BARREL BETWEEN YOU AND A FIREBALL OR OTHER PROJECTILE~GET:~THE PROJECTILE STOPS ON THE BARREL AND GOES OFF THERE. THE BARREL TAKES THE HIT, SO IT CAN BLOW UP IN YOUR HAND~NEEDS:~BODY SHIELD: ON (DEFAULT)");
		r.Push("||WALK AWAY FROM A CARRIED THING THAT IS STUCK BEHIND A WALL|||||DO:~WALK AWAY FROM A CARRIED THING THAT IS STUCK BEHIND A WALL (MORE THAN 1.5 M FROM WHERE THE HAND WANTS IT FOR HALF A SECOND)~GET:~THE HAND RUMBLES HARDER THE FURTHER IT IS HELD BACK, THEN LETS GO AND THE THING IS SET DOWN THERE~NEEDS:~BREAK DISTANCE (DEFAULT 1.5 M); HELD BACK RUMBLE: ON (DEFAULT)");
		r.Push("||WITH A BARREL IN ONE HAND, OR STANDING WITHIN 64 UNITS OF A BARREL, TURN A FREE PALM OUT AT A MONSTER|||||DO:~WITH A BARREL IN ONE HAND, OR STANDING WITHIN 64 UNITS OF A BARREL, TURN A FREE PALM OUT AT A MONSTER (WITHIN 12 DEGREES, 512 UNITS, IN SIGHT)~GET:~THE MONSTER IS LOCKED AND GLOWS GREEN. THAT PALM TAKES NO PICKUP WHILE IT IS ON A MONSTER. THE LOCK HOLDS WHILE A PALM STAYS WITHIN 24 DEGREES OF IT, AND FOR 3 SECONDS AFTER~NEEDS:~BARREL LOCK ON: ON (DEFAULT)");
		r.Push("||THROW A BARREL WHILE A MONSTER IS LOCKED|||||DO:~THROW A BARREL WHILE A MONSTER IS LOCKED~GET:~WITH RSQ MELEE LOADED AND A MONSTER PAINTED BY THAT HAND'S TRIGGER, THE PAINTED MONSTER COMES FIRST AND THE THROW IS MELEE'S. OTHERWISE THE BARREL FLIES TO THE LOCKED MONSTER AND IS STEERED ONTO IT ALL THE WAY, AT LEAST AS FAST AS THE 45 DEGREE LOB THAT REACHES IT, AND ITS BLOW LANDS WHEN IT MEETS THE MONSTER. FOR HALF A SECOND AFTER THE LOCK ENDS IT STILL GOES TO WHERE THE MONSTER LAST WAS~NEEDS:~BARREL LOCK ON: ON (DEFAULT)");
		r.Push("||PUT A HAND WITHIN 7 UNITS OF THE FRONT OF AN ORDINARY DOOR, THEN PRESS THAT HAND'S GRIP, PRESS USE, OR TURN THE PALM OUT AGAINST IT, AND RAISE THE HAND|||||DO:~PUT A HAND WITHIN 7 UNITS (ABOUT 20 CM) OF THE FRONT OF AN ORDINARY DOOR, THEN PRESS THAT HAND'S GRIP, PRESS USE, OR TURN THE PALM OUT AGAINST IT, AND RAISE THE HAND~GET:~YOU HOLD THE DOOR. IT FOLLOWS YOUR HAND UP, EASED; 22 CM OF LIFT OR LESS BRINGS ANY DOOR TO ITS COMMIT POINT. THE DOOR'S OWN OPENING SOUND PLAYS FASTER THE FASTER YOU LIFT, AND THE HAND TICKS FASTER PAST HALF OPEN~NEEDS:~LIFT DOORS: ON (DEFAULT); GRIP TAKES DOOR, USE TAKES DOOR, PALM TAKES DOOR: ON (DEFAULT); DOOR REACH (DEFAULT 0.22 M)");
		r.Push("||LET GO OF THE DOOR WITH IT 40% OPEN OR MORE|||||DO:~LET GO OF THE DOOR (GRIP AND USE RELEASED, PALM TURNED BACK) WITH IT 40% OPEN OR MORE~GET:~THE DOOR FINISHES OPENING BY ITS OWN ACTION, WAITS AND CLOSES AS IT ALWAYS DID. A TICK IN THE HAND~NEEDS:~DOOR COMMIT POINT (DEFAULT 0.40)");
		r.Push("||LET GO OF THE DOOR BELOW 40% OPEN|||||DO:~LET GO OF THE DOOR BELOW 40% OPEN~GET:~THE DOOR DROPS SHUT");
		r.Push("||THROW THE HAND UPWARD AS YOU LET GO|||||DO:~THROW THE HAND UPWARD (1.2 M/S OVER 3 TICS) AS YOU LET GO~GET:~THE DOOR FINISHES OPENING FROM 15% OPEN");
		r.Push("||TAKE HOLD OF A LOCKED DOOR WITHOUT ITS KEY|||||DO:~TAKE HOLD OF A LOCKED DOOR WITHOUT ITS KEY~GET:~NOTHING LIFTS, AND THE GAME SHOWS ITS OWN LOCKED MESSAGE");
		r.Push("||LAY A PALM TURNED OUT ON THE FRONT OF A SWITCH, THE HAND CARRYING NOTHING|||||DO:~LAY A PALM TURNED OUT ON THE FRONT OF A SWITCH (WITHIN 7 UNITS), THE HAND CARRYING NOTHING~GET:~THE SWITCH IS USED ONCE, EXACTLY AS A USE PRESS WOULD. THE PALM MUST LEAVE IT BEFORE IT CAN BE USED AGAIN~NEEDS:~PALM FLIPS SWITCHES: ON (DEFAULT)");
		r.Push("||HOLD A GUN IN BOTH HANDS||BOTH|||DO:~HOLD A GUN IN BOTH HANDS: THE OFF HAND 5 TO 70 CM AHEAD ALONG THE BARREL AND WITHIN 20 CM OF ITS LINE, OR THE TWO HANDS WITHIN 16 CM OF EACH OTHER, OR QUESTZDOOM'S OWN TWO-HAND GRIP~GET:~DISTANCE GRAB STANDS DOWN ON BOTH HANDS UNTIL HALF A SECOND AFTER THE HANDS PART: LOCKS ARE LET GO, NO BEAM, NO WALK-UP GRAB. A HAND ALREADY CARRYING KEEPS ITS THING~NEEDS:~TWO HAND REACH (DEFAULT 0.2 M)");
		r.Push("||PUNCH, OR MOVE A HAND AT 2 M/S OR MORE|||||DO:~PUNCH, OR MOVE A HAND AT 2 M/S OR MORE~GET:~THAT HAND DOES NOT REACH FOR THE NEXT 0.75 SECONDS. A HAND WITH A LOCK, A PULL OR A CARRY IS NOT STOOD DOWN~NEEDS:~NOT WITH MELEE: ON (DEFAULT)");
		r.Push("||HOLD A PALM OUT FOR HALF A SECOND ON A HAND THAT HOLDS A MELEE WEAPON|||||DO:~HOLD A PALM OUT FOR HALF A SECOND ON A HAND THAT HOLDS A MELEE WEAPON~GET:~NO REACH. THE CONSOLE LINE \"DISTANCE GRAB: THE MAIN HAND DOES NOT REACH\" (OR \"THE OFF HAND\") SAYS WHY, AT MOST ONCE EVERY 10 SECONDS FOR THE SAME REASON. BARE FISTS AND BRUTAL DOOM'S FISTS DO REACH~NEEDS:~NOT WITH MELEE: ON (DEFAULT)");
		r.Push("||PULL A THING THAT MEETS A WALL, OR THAT CANNOT ARRIVE IN TIME|||||DO:~PULL A THING THAT MEETS A WALL, OR THAT CANNOT ARRIVE IN TIME~GET:~THE PULL ENDS AND THE THING DROPS WHERE IT IS");
		r.Push("||DIE, OR TURN DISTANCE GRAB OFF|||||DO:~DIE, OR TURN DISTANCE GRAB OFF~GET:~LOCKS END, PULLS STOP WHERE THEY ARE, AND CARRIED THINGS ARE PUT DOWN");
		r.Push("||POINT A PALM AT A CORPSE, OR GRIP ONE WITHIN 30 CM|||||DO:~POINT A PALM AT A CORPSE, OR GRIP ONE WITHIN 30 CM~GET:~CORPSES LOCK, PULL, CARRY AND THROW LIKE BARRELS. A CARRIED CORPSE ALSO STOPS BULLETS AND PROJECTILES~NEEDS:~CORPSES: ON (DEFAULT OFF)");
		r.Push("||CATCH OR GRIP A PICKUP|||||DO:~CATCH OR GRIP A PICKUP~GET:~IT IS CARRIED IN THE HAND, NOT USED, UNTIL YOU SET IT DOWN OR THROW IT~NEEDS:~USE ON CATCH: OFF (DEFAULT ON)");
		r.Push("||HOLD THE PALM ON ONE THING FOR THE SET NUMBER OF TICS|||||DO:~HOLD THE PALM ON ONE THING FOR THE SET NUMBER OF TICS~GET:~THE THING GLOWS AMBER WHILE YOU WAIT, THEN LOCKS AND TURNS GREEN~NEEDS:~LOCK DELAY ABOVE 0 (DEFAULT 0)");
		r.Push("||FLICK TO PULL|||||DO:~FLICK TO PULL~GET:~STEER: THE THING HOMES ON THE PALM AT UP TO 12 M/S, SLOWER AND LAZIER THE HEAVIER IT IS. LOB: IT IS LOBBED UNDER GRAVITY, PEAKING ABOUT 1 M UP, AND THE LOB FOLLOWS YOUR HAND~NEEDS:~FLIGHT PATH: STEER OR LOB (DEFAULT ARC)");
		r.Push("||HIT A MONSTER WITH A THROWN THING - HIT STOP: TAP|||||DO:~HIT A MONSTER WITH A THROWN THING~GET:~THE MONSTER ALSO FREEZES FOR 3, 4 OR 6 TICS~NEEDS:~HIT STOP: TAP, BEAT OR HEAVY (DEFAULT OFF)");
		r.Push("||POINT A PALM AT A THING BEHIND A WALL|||||DO:~POINT A PALM AT A THING BEHIND A WALL~GET:~IT CAN BE LOCKED AND PULLED; THE PULL STILL STOPS AT THE WALL~NEEDS:~LINE OF SIGHT: OFF (DEFAULT ON)");
		r.Push("||PRESS THE GRIP WITH THE PALM ON A PICKUP|||||DO:~PRESS THE GRIP WITH THE PALM ON A PICKUP~GET:~NOTHING: THE GRIP ONLY TAKES DOORS AND TAKES OVER CARRIES~NEEDS:~WALK UP GRAB: OFF (DEFAULT ON)");
	}

	// RSQ Laser Sight (LaserSight/README.md)
	static void RowsLaserSight(out Array<String> r)
	{
		r.Push("||HOLD A MEASURED GUN IN EITHER HAND AND POINT IT|||||DO:~HOLD A MEASURED GUN IN EITHER HAND AND POINT IT~GET:~A BEAM FROM THAT GUN'S MUZZLE ALONG ITS BARREL, BRIGHTEST AT THE MUZZLE, FADING TO NOTHING OVER 3 M AND STOPPING AT WHAT IT HITS; AND A DOT WHERE IT LANDS. MAIN HAND RED, OFF HAND GREEN~NEEDS:~LASER SIGHT, MAIN HAND, OFF HAND, SHOW BEAM, SHOW DOT: ON (DEFAULT); COLOUR MODE: PER HAND (DEFAULT); BEAM FADE LENGTH (DEFAULT 3)");
		r.Push("||HOLD ANY OTHER GUN|||||DO:~HOLD ANY OTHER GUN (PLAIN DOOM'S OWN, OR A PACK'S THIS MOD HAS NO MEASUREMENT FOR)~GET:~NO BEAM. ONLY THE DOT, TRACED FROM THE CONTROLLER ALONG WHERE THE HAND POINTS~NEEDS:~SHOW DOT: ON (DEFAULT)");
		r.Push("||HOLD A MELEE WEAPON OR A THING THAT IS NOT A GUN: A SABER, THE WHIP, A GLOVE, THE SHIELDSAW, THE FORCE HAND, THE HAND GRENADE, A WEAPON SET'S BARE HAND|||||DO:~HOLD A MELEE WEAPON OR A THING THAT IS NOT A GUN: A SABER, THE WHIP, A GLOVE, THE SHIELDSAW, THE FORCE HAND, THE HAND GRENADE, A WEAPON SET'S BARE HAND~GET:~NO BEAM AND NO DOT ON THAT HAND. THE TEST: THE WEAPON IS FLAGGED MELEEWEAPON, OR IT IS FLAGGED CHEATNOTWEAPON AND IS NOT A MEASURED GUN~NEEDS:~SHOW ON MELEE: OFF (DEFAULT)");
		r.Push("||HOLD NOTHING IN A HAND|||||DO:~HOLD NOTHING IN A HAND~GET:~NOTHING IS DRAWN ON THAT HAND, WHATEVER THE SETTINGS");
		r.Push("||POINT THE DOT AT A WALL, A FLOOR OR A CEILING|||||DO:~POINT THE DOT AT A WALL, A FLOOR OR A CEILING~GET:~THE DOT IS PAINTED FLAT ON THAT SURFACE. IT GROWS WITH DISTANCE SO IT LOOKS THE SAME SIZE AT ANY RANGE. A SOFT BLOOM 1.8 TIMES THE DOT LIES OVER IT AND A REAL LIGHT OF ITS COLOUR LIGHTS THE SPOT~NEEDS:~DOT GLOW: BOTH (DEFAULT); DOT SIZE (DEFAULT 1); GLOW SIZE (DEFAULT 1.8)");
		r.Push("||POINT AT THE SKY, OR AT NOTHING WITHIN 2048 MAP UNITS|||||DO:~POINT AT THE SKY, OR AT NOTHING WITHIN 2048 MAP UNITS~GET:~NO DOT. THE BEAM IS STILL DRAWN, OUT TO ITS FADE LENGTH~NEEDS:~TRACE RANGE (DEFAULT 2048)");
		r.Push("||PUT THE DOT ON A LIVE MONSTER THAT IS NOT FRIENDLY - TARGET LOCK: ON|||||DO:~PUT THE DOT ON A LIVE MONSTER THAT IS NOT FRIENDLY~GET:~THE DOT IS DRAWN ON ITS BODY, 1.25 TIMES ITS SIZE, SWELLING AND SHRINKING BY 12% AT 2.2 TIMES A SECOND. THE BEAM IS 1.35 TIMES BRIGHTER~NEEDS:~TARGET LOCK: ON (DEFAULT); LOCK PULSE RATE (DEFAULT 2.2)");
		r.Push("||HOLD THE MUZZLE OF A MEASURED GUN CLOSER THAN 10 CM TO WHAT IT POINTS AT|||||DO:~HOLD THE MUZZLE OF A MEASURED GUN CLOSER THAN 10 CM TO WHAT IT POINTS AT~GET:~THE BEAM GOES (THE SHORTEST BEAM IS 10 CM). THE DOT STAYS");
		r.Push("||POINT A GUN DOWN MORE THAN 55 DEGREES BELOW LEVEL|||||DO:~POINT A GUN DOWN MORE THAN 55 DEGREES BELOW LEVEL~GET:~THAT HAND'S BEAM AND DOT GO OFF UNTIL IT COMES BACK UP~NEEDS:~AIM DOWN OFF (DEFAULT 55)");
		r.Push("||SWITCH WEAPONS|||||DO:~SWITCH WEAPONS~GET:~THE MAIN HAND'S BEAM AND DOT ARE OFF FROM THE MOMENT THE SWITCH IS ASKED FOR UNTIL IT IS DONE");
		r.Push("||PRESS PRIMARY FIRE OR SECONDARY FIRE ON A HAND HOLDING A MEASURED GUN|||||DO:~PRESS PRIMARY FIRE OR SECONDARY FIRE ON A HAND HOLDING A MEASURED GUN~GET:~THE BEAM KEEPS ITS LAST MEASURED POSE THROUGH THE FRAMES THAT FOLLOW, FOR 35 TICS AFTER THAT HAND'S FIRE WAS LAST SEEN HELD. PAST THAT, ON A FRAME WITH NO MEASUREMENT (A RELOAD), THE BEAM HIDES UNTIL THE GUN IS BACK ON A MEASURED FRAME. THE DOT STAYS");
		r.Push("||RAISE EITHER WRIST FOR THE WATCH CHECK||MAIN OFF|||DO:~RAISE EITHER WRIST FOR THE WATCH CHECK~GET:~THE LASER GOES OFF ON EACH HAND WHOSE GUN IS NOT AIMED WITHIN 40 DEGREES OF WHERE YOU LOOK, UNTIL THE WRIST COMES DOWN. A GUN AIMED THAT WAY KEEPS ITS LASER~NEEDS:~RSQ GUN CARDS");
		r.Push("||STEADY THE OFF HAND'S GUN WITH BOTH HANDS||BOTH|||DO:~STEADY THE OFF HAND'S GUN WITH BOTH HANDS (THE ENGINE'S TWO HANDED WEAPONS)~GET:~THE OFF HAND'S BEAM AND DOT GO OFF WHILE THE ENGINE MARKS THE GUN AS STEADIED. THE CODE'S OWN NOTE SAYS ONLY PC VR SETS THAT MARK, NOT THE QUEST");
		r.Push("||WALK FROM A DARK ROOM INTO A BRIGHT ONE|||||DO:~WALK FROM A DARK ROOM INTO A BRIGHT ONE~GET:~THE BEAM DIMS WITH THE ROOM'S LIGHT AT THE MUZZLE: IN FULL LIGHT IT IS 35% OF WHAT IT IS IN THE DARK~NEEDS:~BEAM IN DAYLIGHT (DEFAULT 0.35); BEAM BRIGHTNESS (DEFAULT 0.8)");
		r.Push("||PUT THE DOT ON WATER, NUKAGE, SLIME, LAVA, BLOOD OR A FALL|||||DO:~PUT THE DOT ON WATER, NUKAGE, SLIME, LAVA, BLOOD OR A FALL (BY THE TEXTURE'S NAME)~GET:~THE DOT SWIMS: ITS SIZE GOES UP AND DOWN BY 18% AND IT IS DRAWN AT 75% BRIGHTNESS~NEEDS:~DOT REACTS TO SURFACE: ON (DEFAULT)");
		r.Push("||PUT THE DOT ON METAL|||||DO:~PUT THE DOT ON METAL (A TEXTURE NAMED METAL, SUPPORT, DOOR, STEEL, SHAWN, PLAT OR PIPE)~GET:~THE DOT'S BLOOM AND LIGHT ARE 1.5 TIMES WIDER~NEEDS:~DOT REACTS TO SURFACE: ON (DEFAULT)");
		r.Push("||FIRE A GUN WHOSE SHOT FALLS UNDER GRAVITY ONCE, WITH THAT HAND'S FIRE HELD|||||DO:~FIRE A GUN WHOSE SHOT FALLS UNDER GRAVITY (A GRENADE LAUNCHER) ONCE, WITH THAT HAND'S FIRE HELD~GET:~THE SHOT IS LEARNED FOR THE REST OF THE SESSION. FROM THEN ON THAT GUN'S BEAM BENDS ALONG THE PATH THE SHOT WILL FLY, 24 DOTS MARK THE PATH, AND THE DOT IS WHERE IT LANDS~NEEDS:~GRENADE ARC: ON (DEFAULT); ARC WITH BEAM: ON (DEFAULT)");
		r.Push("||DIE|||||DO:~DIE~GET:~EVERY BEAM, DOT, ARC AND READOUT HIDES");
		r.Push("||HOLD A MELEE WEAPON OR A THING THAT IS NOT A GUN|||||DO:~HOLD A MELEE WEAPON OR A THING THAT IS NOT A GUN~GET:~A DOT ONLY, TRACED FROM THE CONTROLLER ALONG WHERE THE HAND POINTS. NEVER A BEAM~NEEDS:~SHOW ON MELEE: ON (DEFAULT OFF)");
		r.Push("||PUT THE DOT ON A LIVE MONSTER THAT IS NOT FRIENDLY - COLOUR ON TARGET: ON|||||DO:~PUT THE DOT ON A LIVE MONSTER THAT IS NOT FRIENDLY~GET:~THE DOT AND THE BEAM TURN THE TARGET COLOUR (YELLOW)~NEEDS:~COLOUR ON TARGET: ON (DEFAULT OFF); TARGET LOCK: ON (DEFAULT)");
		r.Push("||PUT THE DOT ON A LIVE MONSTER THAT IS NOT FRIENDLY - LOCK TIGHTEN ABOVE 0|||||DO:~PUT THE DOT ON A LIVE MONSTER THAT IS NOT FRIENDLY~GET:~THE DOT IS SMALLER BY THAT SHARE, AND STILL PULSES~NEEDS:~LOCK TIGHTEN ABOVE 0 (DEFAULT 0)");
		r.Push("||PUT THE DOT ON A MONSTER'S HEAD - HEADSHOT PULSE: ON|||||DO:~PUT THE DOT ON A MONSTER'S HEAD~GET:~THE DOT AND THE BEAM PULSE BETWEEN THEIR OWN COLOUR AND THE HEADSHOT COLOUR (WHITE), 4 TIMES A SECOND~NEEDS:~HEADSHOT REACTION: ON (DEFAULT OFF); HEADSHOT PULSE: ON (DEFAULT); HEADSHOT PULSE RATE (DEFAULT 4)");
		r.Push("||PUT THE DOT ON A MONSTER'S HEAD - HEADSHOT PULSE: OFF|||||DO:~PUT THE DOT ON A MONSTER'S HEAD~GET:~THE DOT AND THE BEAM TURN THE HEADSHOT COLOUR AND STAY IT~NEEDS:~HEADSHOT REACTION: ON (DEFAULT OFF); HEADSHOT PULSE: OFF (DEFAULT ON)");
		r.Push("||POINT AT ANYTHING THAT IS NOT A LIVE UNFRIENDLY MONSTER|||||DO:~POINT AT ANYTHING THAT IS NOT A LIVE UNFRIENDLY MONSTER~GET:~NO DOT~NEEDS:~DOT ONLY ON ENEMIES: ON (DEFAULT OFF)");
		r.Push("||POINT AT SOMETHING FURTHER THAN THE LIMIT|||||DO:~POINT AT SOMETHING FURTHER THAN THE LIMIT~GET:~NO DOT~NEEDS:~DOT RANGE LIMIT ABOVE 0 (DEFAULT 0: AS FAR AS TRACE RANGE)");
		r.Push("||POINT AT SOMETHING|||||DO:~POINT AT SOMETHING~GET:~THE RANGE TO IT IS DRAWN AS DIGITS IN THE DOT'S COLOUR, BESIDE THE GUN OR OVER THE DOT: THE MAIN HAND'S, OR THE OFF HAND'S WHEN THE MAIN HAND HAS NONE. METRES SHOW ONE DECIMAL UNDER 10 M~NEEDS:~SHOW RANGE: AT GUN OR AT DOT (DEFAULT OFF); RANGE UNITS: METRES (DEFAULT), FEET OR MAP UNITS");
		r.Push("||FIRE A BULLET GUN THREE TIMES WITH THAT HAND'S FIRE HELD|||||DO:~FIRE A BULLET GUN THREE TIMES WITH THAT HAND'S FIRE HELD~GET:~A RING AT THE DOT SHOWS WHERE THAT GUN'S SHOTS CAN LAND: THE ANGLE 95% OF ITS SEEN SHOTS FELL INSIDE~NEEDS:~SPREAD RING: ON (DEFAULT OFF); RING MINIMUM SPREAD (DEFAULT 0.75)");
		r.Push("||RELOAD, RAISE OR LOWER A WEAPON|||||DO:~RELOAD, RAISE OR LOWER A WEAPON~GET:~THAT HAND'S BEAM AND DOT ARE OFF WHILE ITS WEAPON IS NOT READY~NEEDS:~ONLY WHEN READY: ON (DEFAULT OFF)");
		r.Push("||PICK UP THE LIGHT AMPLIFICATION GOGGLES|||||DO:~PICK UP THE LIGHT AMPLIFICATION GOGGLES~GET:~THE LASER SHOWS ONLY WHILE YOU CARRY THE GOGGLES' POWER; WITHOUT IT NOTHING IS DRAWN~NEEDS:~INFRARED ONLY: ON (DEFAULT OFF)");
		r.Push("||HOLD A GUN IN EACH HAND - COLOUR MODE: SINGLE|||||DO:~HOLD A GUN IN EACH HAND~GET:~BOTH HANDS USE THE ONE LASER COLOUR~NEEDS:~COLOUR MODE: SINGLE (DEFAULT PER HAND)");
		r.Push("||HOLD A GUN IN EACH HAND - COLOUR MODE: BEAM DOT|||||DO:~HOLD A GUN IN EACH HAND~GET:~EACH DOT TAKES ITS OWN COLOUR (MAIN HAND DOT, OFF HAND DOT), APART FROM ITS BEAM'S~NEEDS:~COLOUR MODE: BEAM DOT (DEFAULT PER HAND)");
		r.Push("||SWITCH TO A GUN IN ANOTHER WEAPON SLOT|||||DO:~SWITCH TO A GUN IN ANOTHER WEAPON SLOT~GET:~THE LASER TAKES THAT SLOT'S COLOUR (SLOT 1 TO SLOT 0)~NEEDS:~COLOUR PER SLOT: ON (DEFAULT OFF)");
		r.Push("||HOLD A GUN - CYCLE COLOURS: ON|||||DO:~HOLD A GUN~GET:~THE BEAM'S COLOUR RUNS ROUND THE HUES AT 60 DEGREES A SECOND, THE TWO HANDS HALF A TURN APART; THE DOT TOO~NEEDS:~CYCLE COLOURS: ON (DEFAULT OFF); DOT CYCLES TOO: ON (DEFAULT); CYCLE SPEED (DEFAULT 60)");
		r.Push("||HOLD A MEASURED GUN|||||DO:~HOLD A MEASURED GUN~GET:~NOW AND THEN A SMALL SPARK SHOWS BESIDE THE BEAM, IN THE BEAM'S COLOUR WHITENED~NEEDS:~BEAM SPARKLE: ON (DEFAULT OFF)");
		r.Push("||HOLD A GUN WHOSE FALLING SHOT HAS BEEN LEARNED - ARC WITH BEAM: OFF|||||DO:~HOLD A GUN WHOSE FALLING SHOT HAS BEEN LEARNED~GET:~ONLY THE 24 DOTS MARK THE PATH. NO BEAM IS DRAWN ON THAT GUN AT ALL~NEEDS:~ARC WITH BEAM: OFF (DEFAULT ON)");
		r.Push("||HOLD A GUN WHOSE FALLING SHOT HAS BEEN LEARNED - GRENADE ARC: OFF|||||DO:~HOLD A GUN WHOSE FALLING SHOT HAS BEEN LEARNED~GET:~THE PLAIN STRAIGHT BEAM AND DOT, AS ON ANY GUN~NEEDS:~GRENADE ARC: OFF (DEFAULT ON)");
		r.Push("||POINT A GUN AT THE FLOOR|||||DO:~POINT A GUN AT THE FLOOR~GET:~THE LASER STAYS ON AT ANY ANGLE~NEEDS:~AIM DOWN OFF: 0 (DEFAULT 55)");
		r.Push("||POINT THE DOT AT A SURFACE|||||DO:~POINT THE DOT AT A SURFACE~GET:~NO BLOOM AND NO LIGHT (OFF), THE BLOOM ONLY (BLOOM), OR THE LIGHT ONLY (LIGHT)~NEEDS:~DOT GLOW: OFF, BLOOM OR LIGHT (DEFAULT BOTH)");
		r.Push("||MOVE A HAND|||||DO:~MOVE A HAND~GET:~THE DOT IS DRAWN THAT MANY TICS AHEAD OF WHERE THE HAND'S MOVEMENT CARRIES IT~NEEDS:~DOT LEAD ABOVE 0 (DEFAULT 0)");
		r.Push("||HOLD A GUN - SHOW BEAM: OFF|||||DO:~HOLD A GUN~GET:~NO BEAM; THE DOT ONLY~NEEDS:~SHOW BEAM: OFF (DEFAULT ON)");
		r.Push("||HOLD A GUN - SHOW DOT: OFF|||||DO:~HOLD A GUN~GET:~NO DOT; THE BEAM ONLY~NEEDS:~SHOW DOT: OFF (DEFAULT ON)");
		r.Push("||HOLD A GUN IN THE MAIN HAND, OR IN THE OFF HAND|||||DO:~HOLD A GUN IN THE MAIN HAND, OR IN THE OFF HAND~GET:~NOTHING ON THAT HAND~NEEDS:~MAIN HAND: OFF, OR OFF HAND: OFF (DEFAULT ON)");
		r.Push("||HOLD A GUN - LASER SIGHT: OFF|||||DO:~HOLD A GUN~GET:~NOTHING IS DRAWN~NEEDS:~LASER SIGHT: OFF (DEFAULT ON)");
	}

	// RSQ SlowMo (SlowMo/README.md)
	static void RowsSlowMo(out Array<String> r)
	{
		r.Push("||CROSS YOUR HANDS IN FRONT OF YOUR FACE||BOTH|||DO:~CROSS YOUR HANDS IN FRONT OF YOUR FACE: MAIN HAND AT LEAST 3 CM OVER ON THE OFF HAND'S SIDE, HANDS WITHIN 16 CM OF EACH OTHER, 12 TO 60 CM AHEAD OF YOUR EYES, BETWEEN 40 CM BELOW AND 15 CM ABOVE EYE LEVEL. HOLD IT FOR 12 TICS (A THIRD OF A SECOND)~GET:~SLOW MOTION TURNS ON AND STAYS ON. DO IT AGAIN AND IT TURNS OFF. A SOUND PLAYS AND BOTH HANDS RUMBLE. THE HANDS MUST COME APART BEFORE THE NEXT CROSS COUNTS, AND 20 TICS MUST PASS~NEEDS:~WRIST CROSS: ON (DEFAULT)");
		r.Push("||PRESS SLOW MOTION ON/OFF|KEY:rsqsm_toggle||||DO:~PRESS SLOW MOTION ON/OFF (NO KEY IS BOUND UNTIL YOU BIND ONE)~GET:~THE SAME ON AND OFF AS THE WRIST CROSS~NEEDS:~SLOW MOTION KEY TRIGGER: ON (DEFAULT)");
		r.Push("||START SLOW MOTION WITH LESS THAN 25 ADRENALINE|||||DO:~START SLOW MOTION WITH LESS THAN 25 ADRENALINE~GET:~NOTHING STARTS. A SHORT LOW BUZZ IN THE MAIN HAND AND THE \"OOF\" SOUND~NEEDS:~ADRENALINE: ON (DEFAULT), TO START 25");
		r.Push("||KEEP SLOW MOTION HELD ON|||||DO:~KEEP SLOW MOTION HELD ON~GET:~THE ADRENALINE METER DRAINS. A FULL METER LASTS 10 SECONDS. AT ZERO SLOW MOTION ENDS, WITH THE SAME LIFT SOUND AND RUMBLE IN BOTH HANDS AS ENDING IT YOURSELF~NEEDS:~ADRENALINE: ON (DEFAULT)");
		r.Push("||KILL A MONSTER, LET AN ENEMY ROUND PASS YOUR HEAD, OR TAKE DAMAGE|||||DO:~KILL A MONSTER, LET AN ENEMY ROUND PASS YOUR HEAD, OR TAKE DAMAGE~GET:~THE METER GAINS 12, 4, OR HALF THE DAMAGE TAKEN. NOTHING IS GAINED WHILE SLOW MOTION IS HELD ON OR A DIVE IS IN THE AIR. A CHIME PLAYS WHEN IT REACHES FULL~NEEDS:~ADRENALINE: ON (DEFAULT)");
		r.Push("||START A NEW GAME|||||DO:~START A NEW GAME~GET:~THE METER STARTS EMPTY. IT CARRIES OVER FROM LEVEL TO LEVEL~NEEDS:~ADRENALINE: ON, KEEP ADRENALINE: ON (DEFAULTS)");
		r.Push("||PRESS CRISIS DIVE WHILE STANDING ON THE GROUND|KEY:rsqsm_dodge||||DO:~PRESS CRISIS DIVE WHILE STANDING ON THE GROUND (NO KEY IS BOUND UNTIL YOU BIND ONE)~GET:~YOU JUMP AND ARE THROWN THE WAY THE MOVEMENT STICK POINTS, OR THE WAY YOU FACE WITH THE STICK CENTRED. THE WORLD DROPS TO A TENTH OF ITS SPEED UNTIL YOU LAND, DIE, 6 SECONDS PASS, OR THE METER EMPTIES. YOUR OWN FLIGHT IS SLOWED TOO, LESS THAN THE WORLD: TO ABOUT A THIRD OF YOUR SPEED AT THE DEFAULT HANG, THEN DIVIDED BY CRISIS DIVE AIR TIME (TO ABOUT A FIFTH AT ITS DEFAULT 1.5). THE ARC KEEPS ABOUT THE SAME SHAPE AND HEIGHT: AT 1.5 YOU STAY IN THE AIR ONE AND A HALF TIMES AS LONG AS AT 1 AND LAND JUST AS FAR. ON FLAT GROUND WITH THE DEFAULTS THAT IS ABOUT 3 SECONDS IN THE AIR INSTEAD OF 2, LANDING ABOUT 340 MAP UNITS AWAY~NEEDS:~CRISIS DIVE TRIGGER: ON (DEFAULT); 25 ADRENALINE WITH ADRENALINE ON; CRISIS DIVE AIR TIME 1.5 (DEFAULT)");
		r.Push("||PRESS CRISIS DIVE IN THE AIR, DUCKED BELOW THREE QUARTERS OF STANDING HEIGHT, IN DEEP WATER, OR ON A MAP THAT FORBIDS JUMPING|KEY:rsqsm_dodge||||DO:~PRESS CRISIS DIVE IN THE AIR, DUCKED BELOW THREE QUARTERS OF STANDING HEIGHT, IN DEEP WATER, OR ON A MAP THAT FORBIDS JUMPING~GET:~NOTHING, AND NO SOUND OR RUMBLE SAYS WHY");
		r.Push("||PRESS THE KEY OR CROSS YOUR WRISTS WHILE SOMETHING ELSE HAS SLOWED THE WORLD||BOTH|||DO:~PRESS THE KEY OR CROSS YOUR WRISTS WHILE SOMETHING ELSE HAS SLOWED THE WORLD~GET:~YOUR HELD SLOW MOTION TAKES OVER, AND THE OTHER SLOW MOTION'S REMAINING TIME IS DROPPED");
		r.Push("||WALK, JUMP OR FALL WHILE THE WORLD IS SLOWED|||||DO:~WALK, JUMP OR FALL WHILE THE WORLD IS SLOWED~GET:~YOUR OWN WALKING, JUMPING AND FALLING SLOW AS MUCH AS THE WORLD~NEEDS:~SLOW ME TOO: ON (DEFAULT), SLOW ME TOO STRENGTH 1");
		r.Push("||AIM, FIRE AND RELOAD WHILE THE WORLD IS SLOWED|||||DO:~AIM, FIRE AND RELOAD WHILE THE WORLD IS SLOWED~GET:~FULL SPEED. PLAYERS AND EVERYTHING THEY CARRY ARE NEVER SLOWED");
		r.Push("||STAND WITHIN 3000 MAP UNITS OF ANYTHING WHILE THE WORLD IS SLOWED|||||DO:~STAND WITHIN 3000 MAP UNITS OF ANYTHING WHILE THE WORLD IS SLOWED~GET:~IT MOVES, ANIMATES AND FALLS AT THE WORLD'S SPEED, AND ITS SOUNDS DROP IN PITCH. THINGS FARTHER AWAY RUN AT FULL SPEED~NEEDS:~RANGE 3000, SOUND FOLLOWS 1 (DEFAULTS)");
		r.Push("||FIRE A ROCKET, PLASMA OR ANY SHOT THAT FLIES|||||DO:~FIRE A ROCKET, PLASMA OR ANY SHOT THAT FLIES~GET:~IT FLIES AT THE WORLD'S SPEED AND LEAVES A PALE WAKE~NEEDS:~SLOW MY SHOTS: ON, MISSILE WAKES: ON (DEFAULTS)");
		r.Push("||FIRE A HITSCAN GUN WHILE THE WORLD IS SLOWED|||||DO:~FIRE A HITSCAN GUN WHILE THE WORLD IS SLOWED~GET:~THE SHOT LANDS AT ONCE AND LEAVES A FADING TRAIL FROM MUZZLE TO HIT~NEEDS:~SHOT TRAILS: ON (DEFAULT)");
		r.Push("||BE SHOT AT BY A MONSTER'S HITSCAN WHILE THE WORLD IS SLOWED|||||DO:~BE SHOT AT BY A MONSTER'S HITSCAN WHILE THE WORLD IS SLOWED~GET:~THE SHOT BECOMES A ROUND YOU CAN SEE, FLYING AT 14 MAP UNITS A TIC AT THE SET WORLD SPEED. STEP OUT OF ITS PATH AND IT MISSES. IF IT HITS, IT DOES THE SHOT'S DAMAGE~NEEDS:~DODGEABLE BULLETS: ON (DEFAULT)");
		r.Push("||LEAN YOUR HEAD 6 CM OR MORE TO ONE SIDE, STICK CENTRED, AS A SLOWED ROUND OR ENEMY BULLET REACHES YOU|||||DO:~LEAN YOUR HEAD 6 CM OR MORE TO ONE SIDE, STICK CENTRED, AS A SLOWED ROUND OR ENEMY BULLET REACHES YOU~GET:~A ROUND PASSING ON THE SIDE YOU LEANED AWAY FROM MISSES YOU~NEEDS:~LEAN OUT OF BULLETS: ON (DEFAULT)");
		r.Push("||LET A ROUND PASS WITHIN 64 MAP UNITS OF YOUR HEAD|||||DO:~LET A ROUND PASS WITHIN 64 MAP UNITS OF YOUR HEAD~GET:~A WHIZ, OR A CRACK INSIDE 22 UNITS, A SHORT RUMBLE IN BOTH HANDS, AND 4 ADRENALINE");
		r.Push("||LOSE 75% OF YOUR MAX HEALTH IN ONE TIC TO A LEGENDARY, A CHAMPION, A BOSS OR ITS THRALL, A BOSS MONSTER OR A BIG DEMON; OR TO ANYTHING WHEN THE HIT IS AN ARCH-VILE'S FIRE, THROWS YOU UPWARD, COMES FROM MORE THAN 60 DEGREES OFF YOUR VIEW, OR TAKES YOUR LAST ARMOUR|||||DO:~LOSE 75% OF YOUR MAX HEALTH IN ONE TIC TO A LEGENDARY, A CHAMPION, A BOSS OR ITS THRALL, A BOSS MONSTER OR A BIG DEMON; OR TO ANYTHING WHEN THE HIT IS AN ARCH-VILE'S FIRE, THROWS YOU UPWARD, COMES FROM MORE THAN 60 DEGREES OFF YOUR VIEW, OR TAKES YOUR LAST ARMOUR~GET:~THE WORLD SLOWS FOR 3 SECONDS. NEVER ON A HIT THAT KILLS YOU OR WHILE YOU ARE DOWN~NEEDS:~HEAVY HIT SLOWDOWN: ON (DEFAULT)");
		r.Push("||BE WITHIN 2 METRES OF A BARREL GOING OFF, KILL 2 OR MORE MONSTERS WITH ONE BARREL'S BLAST, OR SET ONE BARREL OFF WITH ANOTHER|||||DO:~BE WITHIN 2 METRES OF A BARREL GOING OFF, KILL 2 OR MORE MONSTERS WITH ONE BARREL'S BLAST, OR SET ONE BARREL OFF WITH ANOTHER~GET:~THE WORLD SLOWS FOR 3 SECONDS (BLAST TIME)~NEEDS:~BARREL NEAR YOU, BARREL MULTI KILL, CHAIN REACTION: ON (DEFAULTS)");
		r.Push("||WAIT AFTER THE GAME SLOWED TIME BY ITSELF|||||DO:~WAIT AFTER THE GAME SLOWED TIME BY ITSELF~GET:~THE NEXT AUTOMATIC SLOW MOTION IS REFUSED FOR 25 SECONDS AFTER THE LAST ONE ENDED. HEAVY HIT SLOWDOWN DOES NOT WAIT AND DOES NOT START THE WAIT~NEEDS:~AUTO COOLDOWN 25 (DEFAULT)");
		r.Push("||LOOK LEFT OF THE SCORE BAR|||||DO:~LOOK LEFT OF THE SCORE BAR~GET:~A BLUE BAR SHOWS THE ADRENALINE METER, WITH A WHITE TICK AT THE AMOUNT NEEDED TO START. UNDER IT, WHILE THE GAME HAS SLOWED TIME BY ITSELF, A GREEN BAR COUNTS DOWN THE REAL TIME LEFT, WITH A WORD NAMING THE CAUSE~NEEDS:~STORED BAR: ON, COUNTDOWN BAR: ON (DEFAULTS)");
		r.Push("||TAKE A KILLING HIT FROM A MONSTER|||||DO:~TAKE A KILLING HIT FROM A MONSTER~GET:~YOU GO DOWN: HELD AT 1 HP, THE WORLD AT A TWENTIETH OF ITS SPEED, A DEATH IN CLOCK OF 9 REAL SECONDS (6 ON THE SECOND DOWN, 3 FROM THE THIRD). A HEAVY HIT SOUND, RINGING, AND BOTH HANDS RUMBLE. THE MONSTER THAT DOWNED YOU BECOMES THE TARGET IF IT IS WITHIN 1024 UNITS, OR IN SIGHT WITHIN 2048; OTHERWISE A COPY OF IT APPEARS IN VIEW. THE TARGET IS LIT, 15% LARGER AND HAS HALF AGAIN ITS HEALTH~NEEDS:~LAST STAND: ON (DEFAULT)");
		r.Push("||TAKE A KILLING HIT FROM A FALL, A CRUSHER, YOUR OWN SHOT, OR SOMETHING NO MONSTER SET OFF|||||DO:~TAKE A KILLING HIT FROM A FALL, A CRUSHER, YOUR OWN SHOT, OR SOMETHING NO MONSTER SET OFF~GET:~NO DOWN. YOU DIE AS USUAL");
		r.Push("||MOVE AND SHOOT WHILE DOWN|||||DO:~MOVE AND SHOOT WHILE DOWN~GET:~YOU MOVE AT A THIRD OF YOUR SPEED. YOUR OWN SHOTS FLY AT FULL SPEED. HITS CANNOT KILL YOU; ONLY THE CLOCK CAN");
		r.Push("||LOOK FOR THE TARGET WHILE DOWN|||||DO:~LOOK FOR THE TARGET WHILE DOWN~GET:~A CROSSHAIR SITS ON IT WHEN IT IS IN SIGHT WITHIN 38 DEGREES OF YOUR VIEW. WITHIN 75 DEGREES A TRAIL OF SIX CHEVRONS AT EYE LEVEL LEADS TO IT. FARTHER ROUND, A TURN MARKER ON A RING ROUND YOUR GAZE POINTS THE WAY TO TURN (STRAIGHT BEHIND: AT THE BOTTOM, POINTING DOWN). THE WORLD TURNS GREY WITH A RED TINT~NEEDS:~GREY WORLD: ON (DEFAULT)");
		r.Push("||HURT THE TARGET, OR ONE OF UP TO TEN OTHER MONSTERS IN SIGHT THAT CARRY A SMALL WHITE CROSSHAIR, WHILE DOWN|||||DO:~HURT THE TARGET, OR ONE OF UP TO TEN OTHER MONSTERS IN SIGHT THAT CARRY A SMALL WHITE CROSSHAIR, WHILE DOWN~GET:~THE CLOCK GAINS TIME: A WHOLE SMALL MONSTER'S OR LOST SOUL'S HEALTH IS WORTH 0.25 S, A BIGGER ONE'S 0.5 S. THE CLOCK NEVER GOES ABOVE WHERE THE CLOCK ROW SETS IT (9 S), AND STILL DRAINS AT A QUARTER SPEED AT BEST");
		r.Push("||KILL THE TARGET WHILE DOWN|||||DO:~KILL THE TARGET WHILE DOWN~GET:~YOU GET UP: HEALTH AT 100%, 66% OR 33% OF MAX BY HOW MANY TIMES YOU HAVE GONE DOWN, BOTH HELD GUNS' MAGAZINES FILLED, AND BY THE THIRD OF THE CLOCK YOU WERE IN (TOP, MIDDLE, BOTTOM): INVULNERABLE 5, 3 OR 1 S, SLOW MOTION 3, 1.5 OR 5 S, AND ARMOUR RAISED TO 100, 66 OR 33");
		r.Push("||LET DEATH IN REACH ZERO|||||DO:~LET DEATH IN REACH ZERO~GET:~YOU TAKE THE KILLING BLOW");
		r.Push("||CROSS YOUR WRISTS WITH WRIST CROSS BURSTS ON||BOTH|||DO:~CROSS YOUR WRISTS WITH WRIST CROSS BURSTS ON~GET:~A 4 SECOND SLOW MOTION THAT ENDS BY ITSELF, PAID UP FRONT: 40% OF A FULL METER~NEEDS:~WRIST CROSS BURSTS: ON (DEFAULT OFF)");
		r.Push("||HOLD SLOW MOTION ON WITH ADRENALINE OFF|KEY:rsqsm_toggle||||DO:~HOLD SLOW MOTION ON WITH ADRENALINE OFF~GET:~IT IS FREE, AND LETS GO BY ITSELF AFTER 6 REAL SECONDS. PRESS AGAIN TO END IT SOONER~NEEDS:~ADRENALINE: OFF (DEFAULT ON), SLOW MOTION LENGTH 6");
		r.Push("||RELOAD A GUN BY HAND|||||DO:~RELOAD A GUN BY HAND~GET:~THE WORLD SLOWS FOR 1.2 SECONDS. A RELOAD THAT STARTS WITHIN 3 SECONDS OF PRESSING A RELOAD BUTTON GETS NONE~NEEDS:~RELOAD: ON (DEFAULT OFF)");
		r.Push("||LET A MONSTER'S ROCKET OR FIREBALL COME WITHIN 14 TICS OF HITTING YOU, INSIDE 400 UNITS|||||DO:~LET A MONSTER'S ROCKET OR FIREBALL COME WITHIN 14 TICS OF HITTING YOU, INSIDE 400 UNITS~GET:~THE WORLD SLOWS FOR 0.7 SECONDS~NEEDS:~CLOSE CALL: ON (DEFAULT OFF)");
		r.Push("||THROW A HAND GRENADE, OR FIRE BD22 VR'S OVER-UNDER 40 MM|||||DO:~THROW A HAND GRENADE (BRUTAL DOOM'S OR RSQ GRENADE'S), OR FIRE BD22 VR'S OVER-UNDER 40 MM~GET:~WHEN IT GOES OFF THE WORLD SLOWS FOR 3 SECONDS~NEEDS:~GRENADE BLAST, OVER UNDER BLAST: ON (DEFAULT OFF)");
		r.Push("||GO DOWN WITH LOWER VIEW ON|||||DO:~GO DOWN WITH LOWER VIEW ON~GET:~YOUR VIEW AND BODY EASE DOWN TO 40% OF STANDING HEIGHT~NEEDS:~LOWER VIEW: ON (DEFAULT OFF)");
		r.Push("||SLOW THE WORLD WITH COLOUR DRAIN ON|||||DO:~SLOW THE WORLD WITH COLOUR DRAIN ON~GET:~COLOURS FADE AS THE WORLD SLOWS, UP TO 35% AT FULL DEPTH~NEEDS:~COLOUR DRAIN: ON (DEFAULT OFF)");
	}

	// RSQ Score (Score/README.md; its Glossary, Score/zscript/rsscore/glossary_data.zs)
	static void RowsScore(out Array<String> r)
	{
		r.Push("EFFICIENCY|RSScore_Efficiency|CIVIL WAR|+24|||A MONSTER YOUR INFIGHT OR CHARM GRENADE TURNED MAKES THE KILL.|BONUS:~+24 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("EFFICIENCY|RSScore_Efficiency|HAND CANNON|+15|||ONE REVOLVER ROUND FROM FULL HEALTH TO DEAD.|BONUS:~+15 ON AN IMP WITH BRUTAL DOOM VR'S REVOLVER; +18 WITH THE OTHER REVOLVER~NEEDS:~BRUTAL DOOM VR'S REVOLVER");
		r.Push("EFFICIENCY|RSScore_Efficiency|INFIGHTER|+12|||A MONSTER KILLS ANOTHER MONSTER. EVERY PLAYER GETS IT.|BONUS:~+12 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("EFFICIENCY|RSScore_Efficiency|KEEP THE CHANGE|+18|||KILL IT WHILE IT FLASHES, ABOUT TO MOVE UP A TIER. MORE IF IT WAS BECOMING A BOSS.|BONUS:~+18 ON AN IMP; +30 IF IT WAS BECOMING A BOSS~NEEDS:~RSQ MONSTERS");
		r.Push("EFFICIENCY|RSScore_Efficiency|SPREE|+2|||KILL AGAIN AND AGAIN, FAST. EACH KILL GIVES YOU 2 TO 10 SECONDS TO MAKE THE NEXT ONE.|BONUS:~+2 ON AN IMP FOR EACH KILL IN THE RUN, UP TO +15~NEEDS:~NOTHING EXTRA");
		r.Push("EFFICIENCY|RSScore_Efficiency|UNTOUCHABLE|+30|||KILL WITHOUT TAKING DAMAGE. IT STARTS AFTER A TENTH OF THE MAP IS DOWN WITHOUT A SCRATCH, THEN GROWS.|BONUS:~UP TO +30 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("EFFICIENCY|RSScore_Efficiency|UPSET|+45|||A COMMON, GREEN OR BLUE MONSTER KILLS A BOSS TIER OR AN EX. EVERY PLAYER GETS IT.|BONUS:~+45 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("STYLE|RSScore_Style|AIR|+30|||KILL WHILE YOU ARE OFF THE GROUND. THE HIGHER THE JUMP, THE BIGGER THE BONUS.|BONUS:~+30 ON AN IMP FROM 164 UNITS UP, UP TO +120~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|AIRBURST|+21|||YOUR GRENADE GOES OFF IN THE AIR.|BONUS:~+21 ON AN IMP~NEEDS:~RSQ GRENADE OR BRUTAL DOOM VR");
		r.Push("STYLE|RSScore_Style|BARBECUE|+15|||YOUR INCENDIARY GRENADE'S FIRE FINISHES IT.|BONUS:~+15 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("STYLE|RSScore_Style|BLINDSIDE|+18|||KILL WHILE YOUR FLASH OR SMOKE GRENADE HAS IT BLIND.|BONUS:~+18 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("STYLE|RSScore_Style|BODY BLOW|+18|||A CORPSE YOU THREW KILLS IT.|BONUS:~+18 ON AN IMP~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|BOWLING|+30|||A MONSTER YOU THREW OUT OF THE HEADLOCK HITS IT.|BONUS:~+30 ON AN IMP~NEEDS:~RSQ MELEE");
		r.Push("STYLE|RSScore_Style|CLUSTER BOMB|+15|||KILL WITH A CLUSTER BOMBLET.|BONUS:~+15 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("STYLE|RSScore_Style|COLOUR CHAIN|+9|||KILL THE SAME COLOUR AGAIN AND AGAIN.|BONUS:~+9 ON AN IMP FOR EACH KILL PAST TWO, UP TO +45~NEEDS:~RSQ MONSTERS");
		r.Push("STYLE|RSScore_Style|CONTACT|+24|||AN IMPACT GRENADE BURSTS ON IT.|BONUS:~+24 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("STYLE|RSScore_Style|CURVEBALL|+12|||KILL A MONSTER THAT CANNOT SEE YOU: ROUND A CORNER, OVER A LEDGE, THROUGH A DOOR.|BONUS:~+12 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|DARWIN|+120|||A MONSTER KILLS ITSELF. YOU DID NOT DO IT, YOU SET IT UP. EVERY PLAYER GETS IT.|BONUS:~+120 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|DIRECT HIT|+12|||A ROCKET'S DIRECT HIT, NOT ITS SPLASH.|BONUS:~+12 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|DOUBLE TAP|+12|||TWO PISTOL HITS WITHIN A THIRD OF A SECOND; THE SECOND KILLS.|BONUS:~+12 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|FRESH PAINT|+15|||KILL IT WITHIN 3 SECONDS OF MOVING UP A TIER.|BONUS:~+15 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("STYLE|RSScore_Style|FULL HANDS|+15|||A SHOT KILL WHILE A HAND CARRIES SOMETHING WITH DISTANCE GRAB.|BONUS:~+15 ON AN IMP~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|GROUND CRACK|+18|||CRACK THE WHIP DOWN AT THE GROUND TO THROW MONSTERS INTO THE AIR. KILL ONE BEFORE IT LANDS. IT TAKES THE PLACE OF JUGGLE AND SKEET.|BONUS:~+18 ON AN IMP~NEEDS:~RSQ WHIP");
		r.Push("STYLE|RSScore_Style|HAND-ME-DOWN|+18|||KILL BY THROWING A GUN A DEAD MONSTER DROPPED.|BONUS:~+18 ON AN IMP~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|HEAVY THROW|+9|||KILL WITH A THROWN THING OF 100 KG OR MORE.|BONUS:~+9 ON AN IMP~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|HOLD STREAK|+9|||KILLS WHILE ONE TRIGGER STAYS DOWN.|BONUS:~+9 ON AN IMP FOR EACH KILL PAST TWO, UP TO +36~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|JUGGLER|+15|||KILL WHILE YOUR THROWN SABER OR DISC IS STILL IN THE AIR.|BONUS:~+15 ON AN IMP~NEEDS:~RSQ SABER OR RSQ SHIELDSAW");
		r.Push("STYLE|RSScore_Style|LAST GRAIN|+12|||KILL AS THE WORLD SPEEDS BACK UP AT THE END OF A SLOW MOTION.|BONUS:~+12 ON AN IMP~NEEDS:~RSQ SLOWMO");
		r.Push("STYLE|RSScore_Style|MULTI-KILL|+18|||ONE BLOW, BLAST OR SWING KILLS MORE THAN ONE. EACH KILL PAST THE FIRST ADDS MORE, BY WEAPON.|BONUS:~+18 ON AN IMP A KILL WITH A SHOTGUN, +12 A GRENADE, +9 MOST GUNS; UP TO +45~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|OFF-HAND|+12|||YOUR OFF HAND'S TRIGGER FIRES THE KILL.|BONUS:~+12 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|POWDER KEG|+18|||THE BLAST OF A BARREL YOUR THROW SET OFF. EACH MORE KILL WITHIN A SECOND IS WORTH MORE.|BONUS:~+18 ON AN IMP, +12 MORE EACH, UP TO +66~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|RED MIST|+21|||A SHOTGUN KILL IN YOUR F.E.A.R. SLOW MOTION, ON A MONSTER YOU DID NOT SHOVE.|BONUS:~+21 ON AN IMP~NEEDS:~RSQ MELEE AND RSQ SLOWMO");
		r.Push("STYLE|RSScore_Style|SKEET|+15|||KILL A MONSTER WHILE IT IS IN THE AIR (NOT ONE THAT FLIES).|BONUS:~+15 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|STRETCHED SECOND||||KILL WHILE RSQ SLOWMO HAS THE WORLD SLOWED. IT ADDS HALF OF WHAT THE KILL'S OTHER BONUSES GAVE (NOT EFFICIENCY).|BONUS:~HALF OF THE KILL'S OTHER BONUSES; MORE AT VERY SLOW SPEED~NEEDS:~RSQ SLOWMO");
		r.Push("STYLE|RSScore_Style|SWITCHAROO|+9|||KILL WITH A DIFFERENT GUN FROM THE ONE YOU JUST FIRED. TWO TRIGGERS ON THE SAME GUN COUNT FOR LESS.|BONUS:~+9 ON AN IMP FOR TWO GUNS, +5 FOR TWO TRIGGERS~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|TAGGED|+21|||A STICKY GRENADE KILLS THE MONSTER IT RIDES.|BONUS:~+21 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("STYLE|RSScore_Style|TEETH|+9|||KILL WITH A GRENADE YOU PULLED THE PIN OF WITH YOUR TEETH.|BONUS:~+9 ON AN IMP~NEEDS:~RSQ GRENADE");
		r.Push("STYLE|RSScore_Style|TELEFRAGGED|+60|||KILL A MONSTER BY TELEPORTING INTO IT.|BONUS:~+60 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|THROWAWAY|+18|||KILL WITH A GUN YOU THREW. MORE IF IT WAS EMPTY.|BONUS:~+18 ON AN IMP, +30 IF IT WAS EMPTY~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|THROWN|+12|||KILL WITH SOMETHING YOU THREW WITH DISTANCE GRAB. THE FASTER THE THROW, THE BIGGER THE BONUS.|BONUS:~+12 ON AN IMP, UP TO +30~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("STYLE|RSScore_Style|TRAP SHOT|+36|||SHOOT YOUR OWN GRENADE IN THE AIR.|BONUS:~+36 ON AN IMP~NEEDS:~RSQ GRENADE OR BRUTAL DOOM VR");
		r.Push("STYLE|RSScore_Style|TWO GUNS|+15|||A SHOT KILL FROM ONE HAND WITHIN A SECOND OF ONE FROM THE OTHER.|BONUS:~+15 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("STYLE|RSScore_Style|VARIETY|+9|||USE THREE OR MORE OF YOUR TOOLS IN ONE FIGHT, WITH KILLS WITHIN 10 SECONDS OF EACH OTHER.|BONUS:~+9 ON AN IMP FOR EACH TOOL PAST TWO, UP TO +36~NEEDS:~NOTHING EXTRA");
		r.Push("DARING|RSScore_Daring|ABYSS TIER|+18|||KILL AN ABYSS TIER MONSTER. THE HIGHER THE TIER, THE BIGGER THE BONUS.|BONUS:~+18 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("DARING|RSScore_Daring|AIR CATCH|+60|||CATCH A THROWN THING BACK OUT OF THE AIR AND THROW IT AGAIN FOR THE KILL.|BONUS:~+60 ON AN IMP, +30 MORE A CATCH, UP TO +120~NEEDS:~RSQ DISTANCE GRAB");
		r.Push("DARING|RSScore_Daring|ARMORY|+30|||THREE DIFFERENT GUNS, EACH DRAWN FROM A HOLSTER AND EACH KILLING, INSIDE 6 SECONDS.|BONUS:~+30 ON AN IMP~NEEDS:~RSQ TACTICAL RIG");
		r.Push("DARING|RSScore_Daring|BALLOON|+15|||KILL A BALLOON CHAMPION.|BONUS:~+15 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|BARE KNUCKLE|+9|||A GLOVE KILL WITH RSQ MELEE'S SLAPPERS ONLY ON.|BONUS:~+9 ON AN IMP~NEEDS:~RSQ MELEE");
		r.Push("DARING|RSScore_Daring|BLACK BOSS|+45|||KILL A BLACK BOSS TIER MONSTER.|BONUS:~+45 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("DARING|RSScore_Daring|BLACK CHAMPION|+15|||KILL A BLACK CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+15 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|BLIND-FIRE|+24|||YOUR EYES COULD NOT SEE IT, BUT YOUR HAND'S SHOT COULD. IT TAKES THE PLACE OF NO-LOOK.|BONUS:~+24 ON AN IMP~NEEDS:~NOTHING EXTRA");
		r.Push("DARING|RSScore_Daring|BLUE CHAMPION|+15|||KILL A BLUE CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+15 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|BLUE TIER|+9|||KILL A BLUE TIER MONSTER. THE HIGHER THE TIER, THE BIGGER THE BONUS.|BONUS:~+9 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("DARING|RSScore_Daring|BOSS|+3000|||KILL THE BOSS YOU CALLED IN.|BONUS:~+3000 ON A BARON OF HELL~NEEDS:~RSQ MINIBOSS");
		r.Push("DARING|RSScore_Daring|BRAWLER|+30|||KILL WITH YOUR FISTS OR A BLADE.|BONUS:~+30 ON AN IMP WITH FISTS, A SAW OR AN AXE; SOME WEAPONS LESS~NEEDS:~NOTHING EXTRA");
		r.Push("DARING|RSScore_Daring|BRONZE CHAMPION|+30|||KILL A BRONZE CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+30 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|BROWN TIER|+21|||KILL A BROWN TIER MONSTER. THE HIGHER THE TIER, THE BIGGER THE BONUS.|BONUS:~+21 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("DARING|RSScore_Daring|CHAIN GANG|+24|||KILL THRALLS ONE AFTER ANOTHER, EACH WITHIN 12 SECONDS OF THE LAST.|BONUS:~+24 ON AN IMP FOR THE SECOND, +48 FOR THE THIRD, THEN +60~NEEDS:~RSQ MINIBOSS");
		r.Push("DARING|RSScore_Daring|CHAMPION STREAK|+6|||CHAMPION KILLS, EACH WITHIN 5 SECONDS.|BONUS:~+6 ON AN IMP FOR EACH, UP TO +30~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|COACH GUN|+15|||KILL WITH A SUPER SHOTGUN BLAST.|BONUS:~+15 ON AN IMP~NEEDS:~BRUTAL DOOM'S SUPER SHOTGUN");
		r.Push("DARING|RSScore_Daring|COOKED|+12|||KILL WITH A GRENADE YOU HELD IN YOUR HAND FOR A SECOND OR MORE.|BONUS:~+12 ON AN IMP, +6 MORE EACH HALF SECOND, UP TO +36~NEEDS:~RSQ GRENADE OR BRUTAL DOOM VR");
		r.Push("DARING|RSScore_Daring|CYAN CHAMPION|+15|||KILL A CYAN CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+15 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|CYAN TIER|+12|||KILL A CYAN TIER MONSTER. THE HIGHER THE TIER, THE BIGGER THE BONUS.|BONUS:~+12 ON AN IMP~NEEDS:~RSQ MONSTERS");
		r.Push("DARING|RSScore_Daring|DANGER CLOSE|+30|||A NUKE KILL WITH YOU CLOSE BY, AND ALIVE.|BONUS:~+30 ON AN IMP~NEEDS:~BRUTAL DOOM'S NUKE");
		r.Push("DARING|RSScore_Daring|DARK GREEN CHAMPION|+15|||KILL A DARK GREEN CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+15 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|DARK RED CHAMPION|+15|||KILL A DARK RED CHAMPION. THIS IS FOR ITS POWERS; ITS EXTRA HEALTH IS IN THE BASE ALREADY.|BONUS:~+15 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|EX BOSS|+30|||KILL AN EX BOSS. THIS COMES ON TOP OF ITS TIER.|BONUS:~+30 ON AN IMP~NEEDS:~RSQ MONSTERS");
