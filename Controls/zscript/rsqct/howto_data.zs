		r.Push("DARING|RSScore_Daring|FOOL'S GOLD|+12|||KILL A MONSTER A GOLD CHAMPION GILDED.|BONUS:~+12 ON AN IMP~NEEDS:~CHAMPIONS");
		r.Push("DARING|RSScore_Daring|FULL SPECTRUM|+120|||KILL ALL 13 COLOURS YOURSELF IN ONE MAP. GIVEN ONCE.|BONUS:~+120 ON AN IMP ONCE~NEEDS:~RSQ MONSTERS");
