	// RSQ Boss (Miniboss/README.md)
	static void RowsMiniboss(out Array<String> r)
	{
		r.Push("||KILL MONSTERS, KILL AGAIN WITHIN 3 S, AND KEEP MOVING|||||DO:~KILL MONSTERS, KILL AGAIN WITHIN 3 S, AND KEEP MOVING~GET:~THE BOSS METER (RIGHT OF RSQ SCORE'S BAR) FILLS: A KILL 10 + ITS HEALTH / 50 (AT MOST 30), +6 A STEP OF A CHAIN (AT MOST +30), 2 POINTS EVERY 2 S YOU MOVED 3 M; 1000 IS FULL~NEEDS:~BOSSES: ON (DEFAULT); METER SPEED (DEFAULT 1)");
		r.Push("||THE SAME WITH RSQ SCORE OR GUN BONSAI VR LOADED|||||DO:~THE SAME WITH RSQ SCORE OR GUN BONSAI VR LOADED~GET:~A KILL COUNTS 4 WHILE SCORE FILLS IT; EACH KILL'S SCORE STYLE POINTS ADD X0.25 (AT MOST 120), GUN BONSAI XP ON THE MAIN HAND'S GUN X0.2~NEEDS:~METER FILLS FROM: BOTH (DEFAULT); RSQ SCORE / RSQ GUN BONSAI VR");
		r.Push("||FILL THE METER|||||DO:~FILL THE METER~GET:~IT TURNS GOLD AND BEATS; RSQ GLOW IN THE DARK'S MAP GLOW BEATS RED WHILE IT WAITS. A FIGHT'S OWN MONSTERS NEVER FILL IT, AND NOTHING FILLS IT DURING A FIGHT, THE 20 S AFTER ONE, OR AFTER THIS MAP'S BOSS");
		r.Push("||LEAVE A FULL METER ALONE|||||DO:~LEAVE A FULL METER ALONE~GET:~THE BOSS COMES BY ITSELF 60 S AFTER THE METER FILLED; WHILE LITTLE IS HAPPENING TO YOU (THE DIRECTOR'S INTENSITY UNDER 0.15) EACH TIC COUNTS TWICE. IT COMES WHEN THE RULES ALLOW; UNTIL THEN ONE LINE UNDER THE METER SAYS WHY: NO BOSS: TOO EARLY, MAP LIMIT, COOLDOWN, LOW HEALTH, NEAR EXIT, TOO BUSY, NO ROOM, OR BOSS: GET READY~NEEDS:~ARRIVES BY ITSELF (DEFAULT 60 S); DIRECTOR: ON (DEFAULT)");
		r.Push("||CHECK YOUR PULSE||OFF|pulse||DO:~CHECK YOUR PULSE: THE INSIDE OF THE OFF-HAND WRIST UNDER 60 DEGREES OFF FACING YOUR EYES, THE WRIST WITHIN 50 DEGREES OF WHERE YOUR HEAD POINTS (KEPT TO 75 AND 65)~GET:~THE START FIGHT CARD SHOWS ON THE INSIDE OF THAT WRIST: GREY; GOLD (START FIGHT?) WHEN THE METER IS FULL, NOTHING IS CALLED AND CALL IT IN IS ON; BIG BOSS! WHEN A BIG BOSS IS DUE. IT STAYS 2 S AFTER (OR GUN CARDS' STAYS AFTER WHEN LONGER). NOT WHILE THE OFF HAND STEADIES THE GUN~NEEDS:~WRIST CARD: ON (DEFAULT)");
		r.Push("||PRESS USE WHILE THE GOLD CARD SHOWS|||||DO:~PRESS USE WHILE THE GOLD CARD SHOWS~GET:~THE FIGHT IS CALLED IN, WITH A CHIME, PAST EVERY WAIT (TIME, MAP LIMIT, COOLDOWN, HEALTH, EXIT, BUSY, THE DIRECTOR); ONLY NO MONSTERS AND NO ROOM STILL STOP IT. THIS IS THE ONLY CALL: THE WATCH CHECK AND USE CALL NOTHING~NEEDS:~CALL IT IN AND WRIST CARD: ON (DEFAULT)");
		r.Push("||WATCH YOUR SIDES AND BACK WHEN THE FIGHT COMES|||||DO:~WATCH YOUR SIDES AND BACK WHEN THE FIGHT COMES~GET:~3 S OF SLOW MOTION AND DARK. EACH THRALL'S SPOT IS MARKED BY ITS CROSSHAIR 0.75 S BEFORE IT LANDS, AT YOUR SIDES AND BEHIND, 400 TO 700 UNITS OUT, 0.5 TO 1 S APART; EACH FIGHTS THE MOMENT IT LANDS. THE BOSS LANDS IN FRONT LAST, 1.25X SIZE, AND CANNOT BE HURT FOR 1.5 S~NEEDS:~ARRIVAL: AROUND YOU (DEFAULT); SLOW MOTION RSQ SLOWMO, DARK RSQ GLOW IN THE DARK");
		r.Push("||KILL THE THRALLS|||||DO:~KILL THE THRALLS~GET:~WHILE THRALLS LIVE THE BOSS TAKES 20% OF EACH BLOW (EVERY THRALL UP) TO 100% (NONE LEFT), AND ITS RING OF FIRE BURNS. EACH THRALL'S DEATH TAKES AWAY THE CHAMPION POWER IT GAVE THE BOSS~NEEDS:~THRALLS (DEFAULT 3, UP TO 3 MORE BY WORLD TIER)");
		r.Push("||SHOOT THE BOSS|||||DO:~SHOOT THE BOSS~GET:~IT HAS 3 LIVES (X3 ON ITS BAR). EACH LIFE LASTS ABOUT 20 S OF YOUR OWN RECENT DAMAGE (NEVER UNDER ITS OWN HEALTH). A LIFE LOST: IT REFILLS, CANNOT BE HURT FOR 5 S (GUARD ON ITS BAR), THROWS 6 AMMO BITS AT ITS FEET, AND STEPS UP: ITS BAR'S COLOUR ONE UP, 15% FASTER, ONE FRESH THRALL (IT DROPS NO GUN, AS EVERY THRALL)~NEEDS:~LIVES (DEFAULT 3); BOSS LIFE BY TIME: ON (DEFAULT); BOSS STEPS UP: ON (DEFAULT); THE AMMO BITS: RSQ VISUALREWARDS WITH KILL REWARDS ON");
		r.Push("||SHOOT THE WEAK! POINTS WHILE THE BOSS WINDS UP|||||DO:~SHOOT THE WEAK! POINTS WHILE THE BOSS WINDS UP~GET:~EVERY 20 S (RANK 0) TO 10 S (RANK 100) IT ROARS, THE ROOM GOES RED AND 2 WEAK! POINTS (40 HEALTH EACH) WITH GOLD CROSSHAIRS SHOW ON ITS FRONT FOR 3 S. BREAK BOTH: CRITICAL!, IT STAGGERS 3 S TAKING X2 DAMAGE, AND ITS THRALLS STAGGER AS LONG~NEEDS:~TELEGRAPHED ATTACK: ON (DEFAULT)");
		r.Push("||MISS, AND DODGE WHAT COMES|||||DO:~MISS, AND DODGE WHAT COMES~GET:~THE ATTACK FIRES: A FAN OF BIG SHOTS AIMED AT YOU, A FIRE RING ALONG THE FLOOR WITH TWO GAPS (STEP INTO A GAP OR JUMP IT), OR A SLOW BALL AIMED WHERE YOU STOOD. 15 DAMAGE A HIT AT THE LOWEST TIER, MORE EACH TIER AND LIFE~NEEDS:~TELEGRAPHED ATTACK: ON (DEFAULT)");
		r.Push("||HIT A STAGGERED THRALL OR THE BOSS IN CRITICAL! WITH MELEE|||||DO:~HIT A STAGGERED THRALL OR THE BOSS IN CRITICAL! WITH MELEE (PUNCH, KICK, HEADLOCK, SABER, SHIELDSAW, WHIP, BD22'S AXE, CHAINSAW OR SWORD)~GET:~FINISHER: +25 HEALTH, +15 ARMOUR, 250 SCORE POINTS (THE BOSS: TWICE), A 1 S SLOW (BOSS 2 S); THE THRALL DIES. A THRALL STAGGERS 2 S, ONCE, WHEN A BLOW TAKES IT UNDER 25% OF ITS MOST HEALTH~NEEDS:~MELEE FINISHERS: ON (DEFAULT)");
		r.Push("||STAND WITHIN 4 M OF ONE SPOT FOR 8 S IN A FIGHT|||||DO:~STAND WITHIN 4 M OF ONE SPOT FOR 8 S IN A FIGHT~GET:~THE NEAREST LIVING THRALL IS SENT STRAIGHT AT YOU, ROARING, AND SHOOTS LESS WHILE IT CLOSES~NEEDS:~CAMPING PRESSURE: ON (DEFAULT)");
		r.Push("||HURT A SUMMONER! WHILE IT CASTS|||||DO:~HURT A SUMMONER! WHILE IT CASTS (GREEN RINGS ON THE FLOOR, 1.5 S)~GET:~EVERY 10% OF ITS LIFE'S HEALTH YOU DEAL TAKES ONE RING AWAY; WHAT IS LEFT LANDS AS 2 TO 3 LOWER MONSTERS (AT MOST 6 ALIVE), EVERY 15 S~NEEDS:~BOSS TRAITS AND SUMMONER: ON (DEFAULT)");
		r.Push("||SIDESTEP A CHARGER! AFTER ITS TWO STAMPS AND THE LINE ON THE FLOOR|||||DO:~SIDESTEP A CHARGER! AFTER ITS TWO STAMPS AND THE LINE ON THE FLOOR~GET:~IT RUSHES THE LINE, HITS THE WALL OR SKIDS, AND IS STUNNED 2 S TAKING X1.5 DAMAGE. CAUGHT: 20 DAMAGE, KNOCKED BACK, AND THE NEXT CHARGE COMES SOONER~NEEDS:~BOSS TRAITS AND CHARGER: ON (DEFAULT)");
		r.Push("||HIT A SHIELDED! BOSS FROM BEHIND, OR BREAK ITS 3 WEAK! RIM POINTS|||||DO:~HIT A SHIELDED! BOSS FROM BEHIND, OR BREAK ITS 3 WEAK! RIM POINTS~GET:~BLOWS WITHIN 90 DEGREES OF ITS FRONT ARE BLOCKED. ALL THREE POINTS BROKEN: THE SHELL SHATTERS FOR THE REST OF THAT LIFE. CRITICAL! OPENS IT TOO~NEEDS:~BOSS TRAITS AND SHIELDED: ON (DEFAULT)");
		r.Push("||KILL BOTH HALVES OF A SPLITTER!|||||DO:~KILL BOTH HALVES OF A SPLITTER!~GET:~SPLITTING! WARNS NEAR THE END OF EACH LIFE BUT THE LAST; IT BECOMES TWO AT 0.7 SIZE DEALING X0.75, THE LIFE'S HEALTH SPLIT BETWEEN THEM; THE LIFE ENDS WHEN BOTH ARE DOWN~NEEDS:~BOSS TRAITS AND SPLITTER: ON (DEFAULT)");
		r.Push("||KILL THE BOSS|||||DO:~KILL THE BOSS~GET:~BOSS DEFEATED!; THE WORLD TIER GOES UP ONE; SCORE'S MINIBOSS CALLED ROW (1500); RSQ SCORE'S LIFE CRATE WHERE IT DIED; THE BIG BOSS BAR +25%; THE BOSS KIOSK BESIDE IT. THE THRALLS LEFT GO FREE~NEEDS:~TIER CHANGE: RSQ MONSTERS; CRATE: RSQ SCORE; KIOSK: SEE BELOW");
		r.Push("||WALK OVER THE LIFE CRATE|||||DO:~WALK OVER THE LIFE CRATE~GET:~+1 SCORE LIFE (RSQ SCORE'S OWN CRATE)~NEEDS:~RSQ SCORE");
		r.Push("||SPEND A SCORE LIFE DURING THE FIGHT, OR LEAVE THE MAP WITH IT ON|||||DO:~SPEND A SCORE LIFE DURING THE FIGHT, OR LEAVE THE MAP WITH IT ON~GET:~THE FIGHT IS LOST: THE BOSS AND THRALLS LEAVE ON BEAMS (NO DROPS, NO KILL), BOSS WINS!, THE WORLD TIER GOES DOWN ONE. THE BIG BOSS BAR STILL GETS +25%~NEEDS:~TIER CHANGE: RSQ MONSTERS");
		r.Push("||STAND STILL FOR 2 S WITHIN 3 M OF THE KIOSK|||||DO:~STAND STILL FOR 2 S WITHIN 3 M OF THE KIOSK~GET:~IT OPENS AND TURNS TO FACE YOU: UP TO THREE LEGENDARY OFFERS FOR GUNS YOU CARRY, PRICED IN SCORE GOLD. SHUT WHILE A FIGHT LANDS OR RUNS~NEEDS:~BOSS KIOSK: ON (DEFAULT); BD22 VR RELOADED WITH LEGENDOOM, RSQ SCORE");
		r.Push("||POINT A HAND AT AN OFFER|||||DO:~POINT A HAND AT AN OFFER (OR PUT YOUR HAND IN IT)~GET:~ITS CARD SHOWS (THE GUN, RARITY, EFFECT, WHAT YOU HAVE ON THAT GUN) AND A DOTTED BEAM RUNS TO IT. THAT HAND'S TRIGGER THEN BELONGS TO THE KIOSK: THE GUN DOES NOT FIRE~NEEDS:~BOSS KIOSK: ON (DEFAULT)");
		r.Push("||PULL THAT HAND'S TRIGGER|||||DO:~PULL THAT HAND'S TRIGGER~GET:~BOUGHT IF YOUR GOLD COVERS IT (COMMON 150, UNCOMMON 250, RARE 500, EPIC 900): BD22 VR MAKES THE REAL LEGENDARY AND HANDS IT OVER. ONE WEAPON A KIOSK: ONCE ONE IS BOUGHT THE OTHER OFFERS GREY OUT, AND A TRIGGER ON ONE IS REFUSED WITH A BUZZ AND ONE WEAPON PER KIOSK~NEEDS:~KIOSK PRICES (DEFAULTS AS SHOWN)");
		r.Push("||PRESS THAT HAND'S ALT FIRE ON AN OFFER, OR TRIGGER LUCKY THEN TRIGGER AN OFFER|||||DO:~PRESS THAT HAND'S ALT FIRE ON AN OFFER, OR TRIGGER LUCKY THEN TRIGGER AN OFFER~GET:~LUCKY: ONE SCORE LIFE SPENT (NO RANK LOST), THE OFFER ONE RARITY UP. ONCE A KIOSK, AND NOT AFTER A WEAPON IS BOUGHT THERE. A BOSS KIOSK'S OFFERS STOP AT RARE: ITS CARD OFFERS LUCKY ONLY UNDER RARE (ELSEWHERE UNDER EPIC)~NEEDS:~A SCORE LIFE");
		r.Push("||POINT AT REPAIR AND PULL THE TRIGGER|||||DO:~POINT AT REPAIR AND PULL THE TRIGGER~GET:~EVERY GUN YOU CARRY BACK TO FULL CONDITION, 1 GOLD A MISSING POINT (AT LEAST 10)~NEEDS:~RSQ GUN CARDS' WEAPON CONDITION");
		r.Push("||WALK 0.75 M PAST THE KIOSK'S RANGE|||||DO:~WALK 0.75 M PAST THE KIOSK'S RANGE~GET:~IT FOLDS AWAY. IT STAYS WHERE IT IS UNTIL THE MAP ENDS");
		r.Push("||FILL THE BIG BOSS BAR|||||DO:~FILL THE BIG BOSS BAR (+25% A BOSS FIGHT, WON OR LOST)~GET:~A BIG BOSS IS DUE: IT IS CALLED LIKE A BOSS (USE ON THE CARD, WHICH READS BIG BOSS!) OR COMES BY ITSELF; NEVER HELD BY THE MAP LIMIT~NEEDS:~BIG BOSS: ON (DEFAULT)");
		r.Push("||FIGHT A BIG BOSS|||||DO:~FIGHT A BIG BOSS~GET:~ITS ARRIVAL CARD SHOWS ITS WEAK POINTS AND HP; IT LANDS ALONE, EACH LIFE WORTH ABOUT 60 S OF YOUR DAMAGE. 3 WEAK POINTS (60 HEALTH); EACH ONE BROKEN THROWS 10 HEALTH AND 10 ARMOUR BITS, A CRITICAL! 40 AND 25; CRITICAL! IS X3 FOR 4 S~NEEDS:~BIG BOSS: ON (DEFAULT); RSQ MONSTERS FOR AN EX BIG BOSS");
		r.Push("||KILL A BIG BOSS'S SUMMONS WHILE IT SHOWS GUARD|||||DO:~KILL A BIG BOSS'S SUMMONS WHILE IT SHOWS GUARD~GET:~AFTER ITS WINDOW IT TAKES NO DAMAGE WHILE ITS OWN SUMMONS LIVE (LINES OF LIGHT JOIN THEM TO IT), 20 S AT MOST~NEEDS:~BIG BOSS GUARD: ON (DEFAULT)");
		r.Push("||BEAT A BIG BOSS|||||DO:~BEAT A BIG BOSS~GET:~AS A BOSS WIN, AND ITS KIOSK HAS FIVE EPIC OFFERS, NO LUCKY");
		r.Push("||GET A REVENGE OR A REVIVE|||||DO:~GET A REVENGE OR A REVIVE~GET:~YOUR DAMAGE X1.5 FOR 10 S; DAMAGE UP~NEEDS:~RSQ SLOWMO'S DOWN");
		r.Push("||DEAL ANY DAMAGE|||||DO:~DEAL ANY DAMAGE~GET:~YOUR DAMAGE IS +10% FOR EACH WORLD TIER COLOUR ABOVE COMMON (X1.9 AT RED)~NEEDS:~YOUR DAMAGE A COLOUR (DEFAULT 0.1); RSQ MONSTERS");
		r.Push("||KILL, FIGHT ON UNHURT; OR TAKE HEAVY DAMAGE, GO DOWN, LOSE A SCORE LIFE, DIE|||||DO:~KILL, FIGHT ON UNHURT; OR TAKE HEAVY DAMAGE, GO DOWN, LOSE A SCORE LIFE, DIE~GET:~RANK (0 TO 100) MOVES (A LOST SCORE LIFE: RANK DOWN PER LIFE, 8, ONCE); EVERY 8 POINTS IS THE NEXT WORLD TIER COLOUR, INSIDE A WINDOW THE MAP SETS (COMMON ON THE FIRST MAP UP TO RED ON THE SECOND-TO-LAST). RANK NN UNDER THE METER~NEEDS:~RANK DIFFICULTY AND RANK CEILING: ON (DEFAULT); RSQ MONSTERS");
		r.Push("||HIT A MELEE STRIKE ON A KNOCKED-DOWN OR DAZED MONSTER OUTSIDE A BOSS FIGHT|||||DO:~HIT A MELEE STRIKE ON A KNOCKED-DOWN OR DAZED MONSTER OUTSIDE A BOSS FIGHT~GET:~VR FINISHER: IT IS GIBBED, BD22'S TWO FATALITY BONUS ITEMS DROP, 100 SCORE POINTS, A 1 S SLOW. NOT OVER 1000 SPAWN HEALTH, NOT A BOSS~NEEDS:~VR FINISHER: ON (DEFAULT); BD22 (KNOCKED DOWN) OR GUN BONSAI VR (DAZED)");
		r.Push("||DO A BD22 FATALITY, STEALTH KILL OR EXECUTION|||||DO:~DO A BD22 FATALITY, STEALTH KILL OR EXECUTION~GET:~NO SCENE: THE MONSTER'S BODY IS GIBBED WHERE IT STOOD AND THE FINISHER IS PAID~NEEDS:~NO BD22 FATALITIES: ON (DEFAULT); BRUTAL DOOM 22");
		r.Push("||BRING A LEGENDARY MONSTER UNDER HALF ITS HEALTH|||||DO:~BRING A LEGENDARY MONSTER (3X HEALTH) UNDER HALF ITS HEALTH~GET:~IT TRANSFORMS: FULL HEALTH AGAIN, A STAT BOOST AND X2 DAMAGE; KILLED, IT DROPS LOOT BY ITS HEALTH~NEEDS:~LEGENDOOM LITE (STANDS DOWN WHILE LEGENDOOM IS LOADED)");
		r.Push("||KILL A CHAMPION|||||DO:~KILL A CHAMPION~GET:~CHAMPIONS' COLOUR POWERS AND ITS ITEM BUNDLE (ABOUT HALF THE MONSTERS AT ULTRA-VIOLENCE: CHAMPION CHANCE, DIFFICULTY BASED)~NEEDS:~CHAMPIONS (BUILT IN)");
		r.Push("||CALL A FIGHT WITH ARRIVAL: CLASSIC|||||DO:~CALL A FIGHT WITH ARRIVAL: CLASSIC~GET:~EVERY THRALL LANDS IN FRONT, THEN THE BOSS; ALL ARE HELD AND CANNOT BE HURT UNTIL A 5 S COUNT ENDS~NEEDS:~ARRIVAL: CLASSIC (DEFAULT AROUND YOU)");
		r.Push("||PRESS USE ON THE START FIGHT CARD|||||DO:~PRESS USE ON THE START FIGHT CARD~GET:~NOTHING: THE CARD STAYS GREY AND THE FIGHT ONLY COMES BY ITSELF~NEEDS:~CALL IT IN: OFF (DEFAULT ON)");
		r.Push("||CALL A FIGHT THAT WOULD WAIT|||||DO:~CALL A FIGHT THAT WOULD WAIT~GET:~IT COMES ANYWAY (ONLY THE MAP LIMIT AND COOLDOWN STILL HOLD IT); WITH NO ROOM, THE SPOT IS TAKEN ANYWHERE IT FITS~NEEDS:~IGNORE SPAWN RESTRICTIONS: ON (DEFAULT OFF)");
		r.Push("||CALL A FIGHT WITH GRAVES RISE ON|||||DO:~CALL A FIGHT WITH GRAVES RISE ON~GET:~NOW AND THEN (30 FIGHTS IN 100, ROLLED AS IT LANDS, WITH NO SIGN WHICH), RSQ GRAVEYARDS' TOMBSTONES RAISE LEGION OF BONES UNDEAD AS IT LANDS (ONE A STONE, OR ONE PER THRALL A STONE; THE MAP OR A RADIUS). THE OTHER FIGHTS WAKE NO GRAVE~NEEDS:~GRAVES RISE: ON (DEFAULT OFF); GRAVES RISE CHANCE (DEFAULT 30); LEGION OF BONES AND RSQ GRAVEYARDS");
		r.Push("||PLAY WITH RANK DIFFICULTY OFF|||||DO:~PLAY WITH RANK DIFFICULTY OFF~GET:~THE WORLD TIER STAYS WHERE RSQ MONSTERS' PAGE SETS IT; BOSS WINS AND LOSSES STILL STEP IT~NEEDS:~RANK DIFFICULTY: OFF (DEFAULT ON)");
	}

	// RSQ VisualRewards (VisualRewards/README.md)
	static void RowsVisualRewards(out Array<String> r)
	{
		r.Push("||HIT A MONSTER WITH ANYTHING - HP BARS: ON|||||DO:~HIT A MONSTER WITH ANYTHING~GET:~A HEALTH BAR APPEARS OVER IT FROM THAT HIT AND STAYS WHILE IT LIVES, WHITE FOR ONE TIC AFTER YOUR HIT~NEEDS:~HP BARS: ON (DEFAULT)");
		r.Push("||HIT A MONSTER WITH ANYTHING - DAMAGE NUMBERS: ON|||||DO:~HIT A MONSTER WITH ANYTHING~GET:~A SMALL NUMBER OF THE HEALTH IT REALLY LOST JETS UP FROM WHERE YOU HIT, SPINS A LITTLE AND FADES IN ABOUT 0.6 S~NEEDS:~DAMAGE NUMBERS: ON (DEFAULT)");
		r.Push("||HIT THE SAME MONSTER AGAIN WITHIN 3 SECONDS|||||DO:~HIT THE SAME MONSTER AGAIN WITHIN 3 SECONDS~GET:~A RUNNING TOTAL OVER ITS BAR AND AN \"XN\" COMBO BESIDE IT; BOTH STEP WHITE, YELLOW, ORANGE, RED AND SHAKE FROM X5~NEEDS:~RUNNING TOTAL, COMBO COUNTER: ON (DEFAULT)");
		r.Push("||HIT A BRUTAL DOOM MONSTER IN THE HEAD|||||DO:~HIT A BRUTAL DOOM MONSTER IN THE HEAD~GET:~HEADSHOT OVER A BIGGER GOLD NUMBER THAT JOLTS AND ARCS OUT TO ONE SIDE~NEEDS:~HEADSHOT WORD: ON (DEFAULT); BRUTAL DOOM");
		r.Push("||KILL A MONSTER - KILL SLAM: ON|||||DO:~KILL A MONSTER~GET:~ITS TOTAL (OR THE KILLING HIT'S NUMBER) PUNCHES ONCE, HOLDS AND FADES~NEEDS:~KILL SLAM: ON (DEFAULT)");
		r.Push("||KILL A MONSTER - KILL REWARDS: ON|||||DO:~KILL A MONSTER~GET:~IT BURSTS INTO BITS: ONE ROLL PER 10 OF ITS STARTING HEALTH, EACH ROLL A 50% DROP; A BOSS DROPS EVERY ROLL, THREE TIMES AS MANY. ONE AMMO ROLL IN FIVE IS A LIGHT GREEN AMMO BIT (FOR THE GUNS YOU CARRY BUT DO NOT HOLD)~NEEDS:~KILL REWARDS: ON (DEFAULT); THE LIGHT GREEN BIT: AMMO FOR OTHER GUNS: ON (DEFAULT)");
		r.Push("||WALK OVER A BIT, OR STAND WITHIN 2 M OF IT|||||DO:~WALK OVER A BIT, OR STAND WITHIN 2 M OF IT (IT FLIES TO YOU)~GET:~HEALTH BIT: +25 HEALTH. ARMOUR BIT: +10 ARMOUR (UP TO 250). AMMO BIT: +5 ROUNDS FOR EACH GUN IN YOUR HANDS. ALWAYS THESE AMOUNTS~NEEDS:~BITS FLY TO ME (DEFAULT 2 M)");
		r.Push("||WALK OVER A LIGHT GREEN AMMO BIT|||||DO:~WALK OVER A LIGHT GREEN AMMO BIT~GET:~+5 ROUNDS FOR EACH AMMO TYPE OF THE GUNS YOU CARRY BUT HOLD IN NEITHER HAND, ONCE A TYPE. WITH EVERY GUN YOU CARRY IN A HAND: AS AN AMMO BIT~NEEDS:~AMMO FOR OTHER GUNS: ON (DEFAULT)");
		r.Push("||WALK OVER A GOLD BIT|||||DO:~WALK OVER A GOLD BIT~GET:~+5 GOLD BANKED IN RSQ SCORE. GOLD COMES ONLY FROM A BIG BOSS, A BOSS OR A LEGENDARY CHAMPION; ANY OTHER KILL ROLLS NO GOLD AND DROPS THE SAME BITS AS WITHOUT SCORE~NEEDS:~RSQ SCORE; GOLD BITS: ON (DEFAULT)");
		r.Push("||WALK OVER A STEEL BIT|||||DO:~WALK OVER A STEEL BIT~GET:~+1 CONDITION TO EACH GUN IN YOUR HANDS~NEEDS:~RSQ GUN CARDS WITH WEAPON CONDITION ON");
		r.Push("||WALK OVER A BATTERY BIT|||||DO:~WALK OVER A BATTERY BIT~GET:~15% OF YOUR FLASHLIGHT BATTERY~NEEDS:~RSQ FNF, WHICH DROPS THEM");
		r.Push("||IN AN RSQ MINIBOSS BOSS OR BIG BOSS FIGHT, KILL WITHIN 256 UNITS OR WITHIN 2 S OF YOUR LAST KILL|||||DO:~IN AN RSQ MINIBOSS BOSS OR BIG BOSS FIGHT, KILL WITHIN 256 UNITS OR WITHIN 2 S OF YOUR LAST KILL~GET:~2 MORE HEALTH BITS AND 2 MORE ARMOUR BITS DROP, EVERY ONE~NEEDS:~FIGHT KILL REWARDS: ON (DEFAULT); RSQ MINIBOSS");
		r.Push("||IN AN RSQ MINIBOSS BOSS FIGHT, TAKE ONE OF THE BOSS'S LIVES|||||DO:~IN AN RSQ MINIBOSS BOSS FIGHT, TAKE ONE OF THE BOSS'S LIVES~GET:~6 AMMO BITS BURST OUT AT ITS FEET (ONE IN FIVE LIGHT GREEN), EVERY ONE DROPPING~NEEDS:~RSQ MINIBOSS; KILL REWARDS: ON (DEFAULT)");
		r.Push("||KILL A MONSTER WITHIN 3 TIMES BITS FLY TO ME WHILE YOU ARE DOWN|||||DO:~KILL A MONSTER WITHIN 3 TIMES BITS FLY TO ME (6 M) WHILE YOU ARE DOWN~GET:~ITS BITS FLY INTO YOUR DOWN PLATE: HEALTH AND ARMOUR BANK FOR YOUR REVIVE, AMMO IS GIVEN AT ONCE~NEEDS:~RSQ SLOWMO");
		r.Push("||PICK UP A HEALTH, ARMOUR OR AMMO ITEM|||||DO:~PICK UP A HEALTH, ARMOUR OR AMMO ITEM~GET:~A \"+N\" RISES FROM IT AND FLIES TO YOUR WRIST: HEALTH AND ARMOUR TO THE OFF HAND, AMMO TO THE HAND WHOSE GUN TAKES IT~NEEDS:~GAINS ON YOU: ON (DEFAULT)");
		r.Push("||GAIN A PLAYER LEVEL, OR A GUN GAINS A LEVEL|||||DO:~GAIN A PLAYER LEVEL, OR A GUN GAINS A LEVEL~GET:~LEVEL UP! IN GOLD AT THE MUZZLE OF THE GUN IN THAT HAND (THE MAIN HAND FOR A PLAYER LEVEL), AND A LEVEL UP! TOAST LOW IN THE VIEW~NEEDS:~REWARD WORDS: WORLD (DEFAULT); GUN BONSAI'S LEVEL-UP EVENT; THE TOAST: TOASTS: ON (DEFAULT)");
		r.Push("||GET INVULNERABLE|||||DO:~GET INVULNERABLE (SPHERE OR ANY INVULNERABILITY POWER)~GET:~A MAGENTA BAR WITH DOOMGUY'S GOD FACE IN THE TOP STACK, DRAINING OVER THE TIME LEFT~NEEDS:~INVULNERABILITY BAR: ON (DEFAULT)");
		r.Push("||GET UP FROM RSQ SLOWMO'S DOWN|||||DO:~GET UP FROM RSQ SLOWMO'S DOWN~GET:~REVIVE! RISES FROM THE FLOOR IN FRONT OF YOU, IN CYAN, AND A TOAST LOW IN THE VIEW SAYS WHAT GETTING UP GAVE: \"REVIVE! +100 HP +10 ARMOR 3S INVULNERABLE\" (ONLY THE PARTS THAT ARE NOT ZERO)~NEEDS:~RSQ SLOWMO; REWARD WORDS: WORLD (DEFAULT); THE TOAST: TOASTS: ON (DEFAULT)");
		r.Push("||KILL THE MONSTER THAT PUT YOU DOWN|||||DO:~KILL THE MONSTER THAT PUT YOU DOWN~GET:~REVENGE! ON IT IN MAGENTA (IN FRONT OF YOU IF IT IS GONE), NEVER HIGHER THAN JUST UNDER YOUR EYE LINE, SO IT STAYS UNDER RSQ SCORE'S LINE AND OVER REVIVE!, AND A REVENGE! TOAST LOW IN THE VIEW~NEEDS:~RSQ SLOWMO; REWARD WORDS: WORLD (DEFAULT); THE TOAST: TOASTS: ON (DEFAULT)");
		r.Push("||GAIN A LIFE IN RSQ SCORE|||||DO:~GAIN A LIFE IN RSQ SCORE~GET:~1UP IN GOLD RISES FROM THE LIFE CRATE YOU TOOK (ELSE IN FRONT OF YOU), AND A 1UP! TOAST LOW IN THE VIEW~NEEDS:~RSQ SCORE; REWARD WORDS: WORLD (DEFAULT); THE TOAST: TOASTS: ON (DEFAULT)");
		r.Push("||HIT A MONSTER WHILE YOU ARE DOWN|||||DO:~HIT A MONSTER WHILE YOU ARE DOWN~GET:~THE TIME THAT HIT BOUGHT (\"+0.4S\") POPS OVER IT IN CRIMSON~NEEDS:~RSQ SLOWMO; DAMAGE NUMBERS: ON (DEFAULT)");
		r.Push("||WALK WITHIN ABOUT 1.4 M OF A LEGENDOOM LEGENDARY DROP|||||DO:~WALK WITHIN ABOUT 1.4 M OF A LEGENDOOM LEGENDARY DROP~GET:~THE POWER'S NAME OVER IT IN ITS RARITY'S COLOURS; IT GOES WHEN YOU ARE 1.8 M AWAY~NEEDS:~DROP WORDS: ON (DEFAULT); LEGENDOOM OR BD22 VR'S LD MODE");
		r.Push("||POINT EITHER HAND'S GUN AT A MONSTER|||||DO:~POINT EITHER HAND'S GUN AT A MONSTER~GET:~ITS BAR SHOWS WHILE YOU AIM AND HALF A SECOND AFTER, EVEN AT FULL HEALTH; NO OTHER BARS SHOW~NEEDS:~ONLY WHERE I AIM: ON (DEFAULT OFF)");
		r.Push("||KILL WITH A LAST HIT WELL PAST ZERO|||||DO:~KILL WITH A LAST HIT WELL PAST ZERO~GET:~OVERKILL OVER THE NUMBER~NEEDS:~OVERKILL WORD: ON (DEFAULT OFF)");
		r.Push("||HIT A MONSTER|||||DO:~HIT A MONSTER~GET:~WHAT THE HIT TOOK OFF STAYS LIT WHITE ON THE BAR HALF A SECOND, THEN DRAINS~NEEDS:~DAMAGE CHUNK: ON (DEFAULT OFF)");
		r.Push("||GAIN A LEVEL WITH REWARD WORDS ON HUD OR BOTH|||||DO:~GAIN A LEVEL WITH REWARD WORDS ON HUD OR BOTH~GET:~LEVEL UP! BANNER WITH PLAYER LV N AND +1 UPGRADE; A GUN'S LEVEL SHOWS ITS NAME, A BIG LV N AND NEW UPGRADE BY THE GUN~NEEDS:~REWARD WORDS: HUD OR BOTH (DEFAULT WORLD); BANNERS: ON (DEFAULT)");
		r.Push("||GAIN A LEVEL WITH REWARD WORDS ON HUD OR BOTH AND BANNERS OFF|||||DO:~GAIN A LEVEL WITH REWARD WORDS ON HUD OR BOTH AND BANNERS OFF~GET:~THE OLD BAND ACROSS THE VIEW (PLAYER), OR A SMALL TAG AT THE HAND (GUN)~NEEDS:~BANNERS: OFF (DEFAULT ON)");
		r.Push("||HURT A LEGENDOOM LEGENDARY UNTIL IT RISES|||||DO:~HURT A LEGENDOOM LEGENDARY UNTIL IT RISES~GET:~THREAT! OVER IT FOR 3 SECONDS~NEEDS:~THREAT WORD: ON (DEFAULT OFF); LEGENDOOM");
	}

	// RSQ Gun Cards (GunCards/README.md)
	static void RowsGunCards(out Array<String> r)
	{
		r.Push("||HOLD A GUN IN THE MAIN HAND|||||DO:~HOLD A GUN IN THE MAIN HAND~GET:~THE SMALL CARD SHOWS BESIDE THE WRIST, RIGHT OF THE MAIN HAND: ERMAC'S PANEL IN THE GUN'S WEAPON-SLOT COLOUR, THE WORD AMMO OR MAGAZINE, THE ROUNDS YOU CAN FIRE NOW BIG, AND THE RESERVE SMALL IN GOLD WHEN THE GUN HAS A MAGAZINE~NEEDS:~SHOW CARDS: ALWAYS (DEFAULT)");
		r.Push("||HOLD A GUN IN THE OFF HAND|||||DO:~HOLD A GUN IN THE OFF HAND~GET:~THE SAME CARD ON THAT WRIST, MIRRORED, BUT ONLY FOR A GUN WHOSE OWN PACK CARRIES THE CARD'S MODELS AND NAMES THE GUN IN AN RSQGCOFF LUMP. ANY OTHER OFF-HAND GUN HAS NO SMALL CARD~NEEDS:~SHOW CARDS: ALWAYS (DEFAULT); A PACK THAT CARRIES THE OFF-HAND CARD");
		r.Push("||FIRE A GUN WITH A MAGAZINE|||||DO:~FIRE A GUN WITH A MAGAZINE~GET:~THE BIG NUMBER IS GREEN ABOVE HALF A MAGAZINE, YELLOW FROM HALF DOWN TO A QUARTER, RED AT A QUARTER OR LESS. ANY GUN AT 0 IS RED~NEEDS:~LOW AMMO COLOUR: ON (DEFAULT); LOW AMMO SHARE (DEFAULT 0.25)");
		r.Push("||EMPTY THE MAGAZINE WITH ROUNDS STILL IN RESERVE|||||DO:~EMPTY THE MAGAZINE WITH ROUNDS STILL IN RESERVE~GET:~RELOAD IN RED TAKES THE BIG NUMBER'S PLACE, THEN A RED 0, SWITCHING EVERY 52 TICS UNTIL YOU RELOAD");
		r.Push("||PICK UP AMMO FOR A GUN IN YOUR HAND|||||DO:~PICK UP AMMO FOR A GUN IN YOUR HAND~GET:~\"+N\" SHOWS IN THE RESERVE'S PLACE FOR 52 TICS; PICKUPS INSIDE THAT TIME ADD UP (AT MOST +99 SHOWN)~NEEDS:~PICKUP NOTE (DEFAULT 52 TICS)");
		r.Push("||CHECK YOUR WATCH WITH EITHER HAND||MAIN OFF|watch||DO:~CHECK YOUR WATCH WITH EITHER HAND: TURN THE BACK OF THAT WRIST TOWARD YOUR EYES AND LOOK TOWARD IT. THE BACK OF THE WRIST MUST BE LESS THAN 80 DEGREES OFF FACING YOUR EYES (90 IS EDGE ON), AND THE WRIST LESS THAN 50 DEGREES FROM WHERE YOUR HEAD POINTS. WHERE THE HAND IS, HOW STILL IT IS AND HOW LONG YOU HOLD IT DO NOT MATTER~GET:~THAT HAND'S WATCH CARD FADES IN OVER 4 TICS, FLAT ON THE BACK-OF-THE-HAND SIDE OF THE WRIST, AND THAT HAND'S SMALL CARD GOES. IT STAYS WHILE THE BACK OF THE WRIST IS LESS THAN 88 DEGREES OFF FACING YOUR EYES AND THE WRIST LESS THAN 65 DEGREES FROM WHERE YOUR HEAD POINTS, AND 70 TICS (2 SECONDS) AFTER~NEEDS:~WATCH CARD: ON CHECK (DEFAULT); STAYS AFTER (DEFAULT 70 TICS); FADE (DEFAULT 4 TICS)");
		r.Push("||CHECK YOUR WATCH WITH A HAND THAT HOLDS A GUN||MAIN OFF|||DO:~CHECK YOUR WATCH WITH A HAND THAT HOLDS A GUN~GET:~THE WEAPON CARD: MAG OR AMMO (RELOAD IN RED ON AN EMPTY MAGAZINE WITH ROUNDS TO LOAD) AND RESERVE, THE TWO COUNTS BIG, \"+N\" IN GREEN AFTER A PICKUP; THEN ONE LINE EACH: MODE (ONLY WHEN THE GUN'S PACK TELLS ONE), LAUNCHER N (ONLY ON BD22 VR'S RIFLE AND MACHINEGUN), GRENADES N, KILLS N IN RED, AND GOLD N ON THE OFF HAND'S CARD~NEEDS:~WATCH SHOWS: WEAPON (DEFAULT); GRENADES NEEDS A GRENADE PILE (RSQ GRENADE, BRUTAL DOOM OR THE WEAPON SETS); GOLD NEEDS RSQ SCORE");
		r.Push("||CHECK YOUR WATCH WITH AN EMPTY MAIN HAND OR WITH FISTS||MAIN|||DO:~CHECK YOUR WATCH WITH AN EMPTY MAIN HAND OR WITH FISTS~GET:~THE STATUS CARD: H AND A, HEALTH BIG (RED AT 25 OR LESS) AND ARMOUR BIG IN BLUE, A KEY ICON FOR EACH KEY KIND THIS MAP HAS (LIT WHEN YOU HOLD IT, DARK WHEN NOT), \"+N\" FOR OTHER KEYS, G:N FOR GRENADES, GOLD N ON THE OFF HAND'S CARD~NEEDS:~KEY ICONS: ON (DEFAULT); MAP KEYS ONLY: ON (DEFAULT)");
		r.Push("||CHECK YOUR WATCH WITH AN EMPTY OFF HAND||OFF|||DO:~CHECK YOUR WATCH WITH AN EMPTY OFF HAND~GET:~THE STATUS CARD. WITH A WEAPON IN THE OFF-HAND SLOT (SUCH AS BD22 VR'S OFF-HAND FISTS) IT IS DRAWN WITH THE HAND; WITH NOTHING IN THAT SLOT IT IS DRAWN IN THE WORLD AT THE WRIST");
		r.Push("||CHECK YOUR WATCH WITH A HAND THAT HOLDS RSQ SABER'S SABER, RSQ FLASHLIGHT & FLARE'S FLARE OR FLASHLIGHT, OR RSQ TACTICAL RIG'S CIGARETTES|||||DO:~CHECK YOUR WATCH WITH A HAND THAT HOLDS RSQ SABER'S SABER, RSQ FLASHLIGHT & FLARE'S FLARE OR FLASHLIGHT, OR RSQ TACTICAL RIG'S CIGARETTES~GET:~THE ITEM CARD, ITS WORDS IN THE HALF OF THE CARD NEARER YOUR ELBOW: THE ITEM'S NAME, ITS COUNT BIG WHEN IT HAS ONE (FLARES LEFT, BATTERY, CIGARETTES; RED AT 0), LIT / UNLIT FOR A FLARE OR ON / OFF FOR A FLASHLIGHT, THEN H N, A N, G:N, THE KEY ICONS, GOLD N ON THE OFF HAND~NEEDS:~WATCH SHOWS: WEAPON (DEFAULT) OR BOTH; COUNTS AND STATES NEED THE MOD THAT OWNS THE ITEM");
		r.Push("||CHECK THE OFF-HAND WATCH WHILE THAT HAND STEADIES A GUN: THE ENGINE'S TWO-HAND STEADYING IS ON, OR THE OFF HAND IS WITHIN 16 MAP UNITS OF THE GUN HAND AND WITHIN 8 MAP UNITS OF THE GUN'S LINE||OFF|||DO:~CHECK THE OFF-HAND WATCH WHILE THAT HAND STEADIES A GUN: THE ENGINE'S TWO-HAND STEADYING IS ON, OR THE OFF HAND IS WITHIN 16 MAP UNITS (ABOUT 45 CM) OF THE GUN HAND AND WITHIN 8 MAP UNITS (ABOUT 23 CM) OF THE GUN'S LINE~GET:~NOTHING. THE OFF HAND'S CHECK DOES NOT COUNT");
		r.Push("||KILL A MONSTER WITHIN 35 TICS OF A HAND'S SHOT|||||DO:~KILL A MONSTER WITHIN 35 TICS OF A HAND'S SHOT~GET:~THAT HAND'S GUN GETS ONE MORE ON ITS KILLS LINE, FOR THIS LEVEL. THE HAND IS THE ONE THE ENGINE SAYS FIRED THE SHOT (BULLETS, PELLETS, RAILS, AND A MELEE WEAPON'S TRACED ATTACK), OR THE ONE WHOSE ROUNDS WENT DOWN (WHAT FLIES). IF BOTH HANDS FIRED ON THE SAME TIC, NO GUN GETS THE KILL");
		r.Push("||HOLD A COOKING RSQ GRENADE|||||DO:~HOLD A COOKING RSQ GRENADE~GET:~ITS WHOLE SECONDS LEFT TAKE THE BIG NUMBER ON THE SMALL CARD, AMBER FOR THE FIRST HALF OF THE FUSE AND RED AFTER, WHATEVER SHOW CARDS SAYS EXCEPT OFF~NEEDS:~RSQ GRENADE ANSWERING ITS FUSE COUNT (ITS COOK SENSE 3)");
		r.Push("||BRING THE GUN TO BETWEEN ABOUT 12 CM AND 0.7 M FROM YOUR EYES, WITHIN 30 DEGREES OF WHERE YOU LOOK|||||DO:~BRING THE GUN TO BETWEEN ABOUT 12 CM AND 0.7 M FROM YOUR EYES, WITHIN 30 DEGREES OF WHERE YOU LOOK~GET:~THE SMALL CARD SHOWS ONLY WHILE YOU DO~NEEDS:~SHOW CARDS: ON LOOK (DEFAULT ALWAYS); LOOK REACH (DEFAULT 0.7 M); LOOK CONE (DEFAULT 30 DEGREES)");
		r.Push("||CHECK YOUR WATCH - SHOW CARDS: INSPECT|||||DO:~CHECK YOUR WATCH~GET:~THE SMALL CARD SHOWS, AND STAYS 70 TICS AFTER. WITH WATCH CARD: ON CHECK THE WATCH CARD TAKES THE WATCH CHECK INSTEAD, SO THE SMALL CARD IS SEEN THIS WAY ONLY WITH WATCH CARD: OFF~NEEDS:~SHOW CARDS: INSPECT (DEFAULT ALWAYS); WATCH CARD: OFF (DEFAULT ON CHECK); STAYS AFTER (DEFAULT 70 TICS)");
		r.Push("||HOLD THAT HAND'S RELOAD BUTTON, OR THE SHARED RELOAD BUTTON|||||DO:~HOLD THAT HAND'S RELOAD BUTTON, OR THE SHARED RELOAD BUTTON~GET:~THE SMALL CARD SHOWS WHILE IT IS HELD AND 70 TICS AFTER~NEEDS:~SHOW CARDS: ON RELOAD (DEFAULT ALWAYS); STAYS AFTER (DEFAULT 70 TICS)");
		r.Push("||HOLD A GUN|||||DO:~HOLD A GUN~GET:~NO SMALL CARD. A COOKING GRENADE'S COUNT IS NOT SHOWN EITHER~NEEDS:~SHOW CARDS: OFF (DEFAULT ALWAYS)");
		r.Push("||TURN THE BACK OF EITHER WRIST TO WITHIN 60 DEGREES OF FACING YOUR EYES, THE WRIST WITHIN 45 DEGREES OF WHERE YOU LOOK||MAIN OFF|||DO:~TURN THE BACK OF EITHER WRIST TO WITHIN 60 DEGREES OF FACING YOUR EYES, THE WRIST WITHIN 45 DEGREES OF WHERE YOU LOOK~GET:~THE WATCH CARD SHOWS WITHOUT A WATCH CHECK, WITH THE SMALL CARD BESIDE IT. TURNED AWAY, THE SMALL CARD SHOWS ALONE~NEEDS:~WATCH CARD: ALWAYS (DEFAULT ON CHECK)");
		r.Push("||CHECK YOUR WATCH - WATCH CARD: OFF|||||DO:~CHECK YOUR WATCH~GET:~NOTHING~NEEDS:~WATCH CARD: OFF (DEFAULT ON CHECK)");
		r.Push("||CHECK YOUR WATCH WITH A GUN - WATCH SHOWS: STATUS|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~THE STATUS CARD INSTEAD OF THE WEAPON CARD~NEEDS:~WATCH SHOWS: STATUS (DEFAULT WEAPON)");
		r.Push("||CHECK YOUR WATCH WITH A GUN - WATCH SHOWS: BOTH|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~BOTH ON ONE CARD: MAG AND RESERVE AND THE COUNTS, \"H N\" AND \"A N\", THE KEY ICONS AND G:N, THEN CND, GOLD AND LAUNCHER WHEN THEY APPLY. NO MODE, GRENADES OR KILLS LINES~NEEDS:~WATCH SHOWS: BOTH (DEFAULT WEAPON)");
		r.Push("||CHECK YOUR WATCH WITH A GUN - GUN BONSAI ON CARD: ON|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~BELOW THE WEAPON CARD'S LINES: \"LV N\" WITH AN XP BAR, THEN UP TO 4 UPGRADES WITH THEIR LEVEL (DARK WHEN SWITCHED OFF), AND \"+N MORE\" WHEN NOT ALL FIT~NEEDS:~GUN BONSAI ON CARD: ON (DEFAULT OFF); RSQ GUN BONSAI VR");
		r.Push("||HOLD A GUN IN EACH HAND|||||DO:~HOLD A GUN IN EACH HAND~GET:~ONE SMALL CARD, ON THE MAIN HAND: THE MAIN GUN'S ROUNDS BIG, THE OFF-HAND GUN'S ROUNDS IN THE SMALL NUMBER. THE OFF HAND'S SMALL CARD GOES~NEEDS:~BOTH GUNS ONE CARD: ON (DEFAULT OFF)");
		r.Push("||RAISE THE GUN TO WITHIN 0.30 M OF YOUR EYE, POINTING WITHIN 25 DEGREES OF WHERE YOU LOOK|||||DO:~RAISE THE GUN TO WITHIN 0.30 M OF YOUR EYE, POINTING WITHIN 25 DEGREES OF WHERE YOU LOOK~GET:~THAT HAND'S SMALL CARD HIDES~NEEDS:~HIDE AT EYE: ON (DEFAULT OFF); EYE REACH (DEFAULT 0.30 M)");
		r.Push("||TURN YOUR WRIST|||||DO:~TURN YOUR WRIST~GET:~THE SMALL CARD TURNS TOWARD YOUR EYES EVERY TIC, AT MOST 20 DEGREES EACH WAY~NEEDS:~TILT TO EYES: ON (DEFAULT OFF); TILT MAX (DEFAULT 20 DEGREES)");
		r.Push("||HOLD A GUN, OR CHECK YOUR WATCH|||||DO:~HOLD A GUN, OR CHECK YOUR WATCH~GET:~THE CARDS ARE FLAT SIGNS PLACED AT THE HAND ONCE A TIC, FACING YOUR EYE, IN PLACE OF THE CARDS DRAWN WITH THE HAND. THE SABER, THE FLARE, THE FLASHLIGHT AND THE CIGARETTES SHOW THE STATUS CARD; ANY OTHER WEAPON WITH NO AMMO PILE SHOWS ITS NAME OVER THE WEAPON CARD'S LINES, WITH NO COUNTS. THE SMALL CARD'S TOP WORD IS MAG, AMMO, RELOAD OR +N~NEEDS:~DRAW IN WORLD: ON (DEFAULT OFF); WORLD CARD SIZE (DEFAULT 1.4)");
		r.Push("||TAKE ONE BLOW OF MORE THAN 20 DAMAGE|||||DO:~TAKE ONE BLOW OF MORE THAN 20 DAMAGE~GET:~EACH GUN IN YOUR HANDS LOSES 3 CONDITION (TWO GUNS OF ONE CLASS LOSE IT ONCE). A GUN STARTS AT 100 AND STOPS AT 0~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); BIG HIT OVER (DEFAULT 20); WEAR PER HIT (DEFAULT 3)");
		r.Push("||HIT SOMETHING WITH A WORN GUN|||||DO:~HIT SOMETHING WITH A WORN GUN~GET:~THE DAMAGE IS SCALED BY THE GUN'S CONDITION. MOST GUNS: X0.90 AT 70 TO 79, X0.85, X0.80, X0.70, THEN X0.60 AT 30 TO 39, AND UNDER 30 MORE THAN NEW: X1.2, X1.5, THEN X1.8 UNDER 10. SHOTGUNS AND CHAINGUNS, AND PRECISION GUNS, HAVE THEIR OWN TABLES~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF)");
		r.Push("||PULL THE TRIGGER ON A WORN GUN|||||DO:~PULL THE TRIGGER ON A WORN GUN~GET:~FROM THE PULL UNTIL THE GUN IS READY AGAIN ITS FRAMES RUN SLOWER AT 40 TO 69 CONDITION (X0.85, X0.67, X0.70) AND FASTER UNDER 40 (X1.05, X1.2, X1.25 UNDER 10). A FRAME 1 TIC LONG CANNOT BE SHORTENED~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); FIRE RATE FOLLOWS CONDITION: ON (DEFAULT)");
		r.Push("||FIRE A GUN WHOSE CONDITION IS UNDER 60|||||DO:~FIRE A GUN WHOSE CONDITION IS UNDER 60~GET:~EACH SHOT HAS A SMALL CHANCE (0.5 TO 7 IN 100) TO BACKFIRE: 1 TO 5 HEALTH, ARMOUR IGNORED. UNDER 30 IT CAN ALSO MISFIRE FOR 4 TO 12 (AN ENERGY GUN OVERLOADS FOR 8 TO 20 AND NEVER BACKFIRES). NEITHER CAN KILL YOU. AT MOST ONE A SECOND A HAND~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); THE WORD IS SHOWN AS RSQ VISUALREWARDS' TOAST, ELSE ONLY A SOUND PLAYS");
		r.Push("||CHECK YOUR WATCH WITH A GUN - WEAPON CONDITION: ON|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~A CND LINE: A BAR AND THE NUMBER, GREEN AT 90 AND UP, THEN LIME, YELLOW, ORANGE, AND RED UNDER 30~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); CONDITION ON CARD: ON (DEFAULT)");
		r.Push("||PICK UP ONE OF RSQ VISUALREWARDS' STEEL BITS|||||DO:~PICK UP ONE OF RSQ VISUALREWARDS' STEEL BITS~GET:~EACH WORN GUN IN YOUR HANDS GAINS THE POINTS THAT MOD SENDS~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); RSQ VISUALREWARDS");
		r.Push("||BUY REPAIR AT RSQ MINIBOSS'S KIOSK|||||DO:~BUY REPAIR AT RSQ MINIBOSS'S KIOSK~GET:~EVERY GUN YOU CARRY GOES BACK TO 100~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); RSQ MINIBOSS");
		r.Push("||TAKE A BIG HIT WITH A GUN THAT IS AT 0, OR THAT THE HIT BRINGS TO 0|||||DO:~TAKE A BIG HIT WITH A GUN THAT IS AT 0, OR THAT THE HIT BRINGS TO 0~GET:~THE GUN BREAKS: A SOUND, \"<NAME> BROKE\", AND IT IS TAKEN FROM YOU~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); LOSE GUN AT 0: ON (DEFAULT OFF)");
		r.Push("||WITH A GUN IN THE MAIN HAND, OPEN TEST AND DEBUG AND MOVE SPOT UP, SPOT SIDE OR SPOT IN|||||DO:~WITH A GUN IN THE MAIN HAND, OPEN TEST AND DEBUG AND MOVE SPOT UP, SPOT SIDE OR SPOT IN (CM)~GET:~THAT GUN'S SMALL CARD MOVES AND THE SPOT IS SAVED FOR THAT GUN'S CLASS ON THIS MACHINE. OTHER GUNS KEEP THE PLACEMENT SLIDERS~NEEDS:~THE ROWS ARE GREYED WITH NO GUN IN THAT HAND");
		r.Push("||SET EDIT SPOT FOR TO OFF HAND|||||DO:~SET EDIT SPOT FOR TO OFF HAND~GET:~THE SPOT ROWS EDIT THE OFF-HAND GUN. BD22 VR'S OFF-HAND COPY OF A GUN USES ITS GUN'S SPOT UNTIL IT HAS ITS OWN~NEEDS:~EDIT SPOT FOR: OFF HAND (DEFAULT MAIN HAND)");
		r.Push("||CHOOSE RESET THIS GUN OR RESET ALL SPOTS AND CONFIRM|||||DO:~CHOOSE RESET THIS GUN OR RESET ALL SPOTS AND CONFIRM~GET:~THAT GUN'S SMALL CARD, OR EVERY GUN'S, GOES BACK TO THE PLACEMENT SLIDERS");
		r.Push("||TURN ON HIDE HUD HEALTH OR HIDE HUD AMMO|||||DO:~TURN ON HIDE HUD HEALTH OR HIDE HUD AMMO~GET:~ANOTHER PACK'S STATUS BAR SETTING IS SWITCHED; NOTHING IN THIS MOD CHANGES. THE ROWS ARE GREYED WHEN NO LOADED PACK HAS THE SETTING~NEEDS:~BD22 VR RELOADED (THE SETTING IS ITS OWN)");
		r.Push("||TURN ON HAND NUMBERS|||||DO:~TURN ON HAND NUMBERS~GET:~EVERY 5 TICS THE MIDDLE OF THE SCREEN SHOWS THE ENGINE'S HAND POSITIONS AND ANGLES, THE WEAPONS HELD, THE WATCH CHECK'S ANSWER FOR EACH HAND (0 OR 2), AND FOR EACH WRIST HOW MANY DEGREES THE BACK OF THE WRIST IS OFF FACING YOUR EYES AND HOW MANY DEGREES THE WRIST IS FROM WHERE YOUR HEAD POINTS~NEEDS:~HAND NUMBERS: ON (DEFAULT OFF)");
		r.Push("||CHECK YOUR WATCH WITH A HAND THAT HOLDS ANY OTHER WEAPON WITH NO AMMO PILE|||||DO:~CHECK YOUR WATCH WITH A HAND THAT HOLDS ANY OTHER WEAPON WITH NO AMMO PILE (BD22 VR'S CHAINSAW AND DRAGONSLAYER, GLOVES, A WHIP, ANY PACK'S MELEE WEAPON)~GET:~THE WEAPON CARD WITH THE WEAPON'S NAME WHERE A GUN HAS MAG AND RESERVE, AND NO COUNTS; THEN THE SAME LINES: GRENADES N, KILLS N IN RED, GOLD N ON THE OFF HAND'S CARD. THERE IS NO SMALL CARD~NEEDS:~WATCH SHOWS: WEAPON (DEFAULT); WITH BOTH THE NAME STANDS OVER \"H N\", \"A N\", THE KEY ICONS AND G:N");
		r.Push("||KILL A MONSTER WITH A BLOW OF A WEAPON THAT HAS NO AMMO PILE, OR OF A WEAPON FLAGGED A MELEE WEAPON: THE MONSTER'S EDGE WITHIN 128 MAP UNITS OF THE HAND THAT HOLDS IT|||||DO:~KILL A MONSTER WITH A BLOW OF A WEAPON THAT HAS NO AMMO PILE, OR OF A WEAPON FLAGGED A MELEE WEAPON (BD22 VR'S AXE): THE MONSTER'S EDGE WITHIN 128 MAP UNITS (ABOUT 3.7 M) OF THE HAND THAT HOLDS IT~GET:~THAT WEAPON GETS ONE MORE ON ITS KILLS LINE, WHATEVER THE OTHER HAND FIRED. WITH SUCH A WEAPON IN EACH HAND, THE NEARER HAND'S GETS IT. A BLOW IS DAMAGE YOU DEAL THROUGH AN ATTACK ACTOR OF YOUR OWN THAT IS NOT A TRACED SHOT AND NOT AN EXPLOSION; A TRACED MELEE ATTACK COUNTS AS A SHOT, ABOVE");
		r.Push("||HOLD BD22 VR'S SILVERGUN IN EITHER HAND|||||DO:~HOLD BD22 VR'S SILVERGUN (BRUTALREVOLVER) IN EITHER HAND~GET:~RESERVE, ON THE SMALL CARD AND THE WATCH CARD, IS THE ROUNDS YOU CAN STILL LOAD: THE PISTOL'S PILE DIVIDED BY 3 (ONE CHAMBER COSTS 3), ROUNDED DOWN. RELOAD SHOWS ONLY WHEN AT LEAST ONE ROUND CAN BE LOADED, AND \"+N\" COUNTS ROUNDS~NEEDS:~BD22 VR RELOADED. ANY GUN WITH A MAGAZINE WHOSE OWN AMMO USE PER SHOT IS MORE THAN 1 IS COUNTED THE SAME WAY");
		r.Push("||PLAY BRUTAL DOOM WITHOUT RELOADING|||||DO:~PLAY BRUTAL DOOM WITHOUT RELOADING: AS PURIST (ITS ISPLAYINGASPURIST TOKEN, WITH A PURIST GUN OR ANY OTHER) OR WITH ITS NORELOADING TOKEN~GET:~THE GUN'S CARDS SAY AMMO WITH THE PILE THE GUN FIRES FROM, AND NO RESERVE. AS PURIST THE SSG AND THE GRENADE LAUNCHER KEEP MAGAZINE AND RESERVE, BECAUSE THEY STILL LOAD FROM THE PILE~NEEDS:~BRUTAL DOOM");
		r.Push("||LOAD OR FIRE THE LAUNCHER UNDER BD22 VR'S RIFLE OR MACHINEGUN|||||DO:~LOAD OR FIRE THE LAUNCHER UNDER BD22 VR'S RIFLE OR MACHINEGUN~GET:~LAUNCHER 1 IN ORANGE WITH A ROUND IN IT, LAUNCHER 0 DARK WITHOUT, ON THAT GUN'S WATCH CARD. THE OFF HAND'S RIFLE SHOWS ITS OWN LAUNCHER~NEEDS:~BD22 VR RELOADED; NOT ON THE PURIST RIFLE, WHICH HAS NO LAUNCHER");
	}

	// RSQ Wheel (Wheel/README.md)
	static void RowsWheel(out Array<String> r)
	{
		r.Push("||PRESS OPEN WHEEL|KEY:+wr_wheel||||DO:~PRESS OPEN WHEEL (RSQOOPACONTROLS: RIGHT GRIP + RIGHT STICK CLICK)~GET:~THE RING OPENS IN FRONT OF YOUR MAIN HAND AND STAYS UP. LETTING GO OF THE KEY TAKES NOTHING");
		r.Push("||PULL A TRIGGER ON A CARD THAT SAYS \"N WEAPONS\"|||||DO:~PULL A TRIGGER ON A CARD THAT SAYS \"N WEAPONS\"~GET:~THAT SLOT OPENS: THE RING NOW HOLDS THAT SLOT'S WEAPONS AND A BACK CARD, AND STAYS UP. TAKING BACK RETURNS TO THE SLOTS~NEEDS:~RING LAYOUT: ALWAYS GROUP (DEFAULT)");
		r.Push("||PRESS OPEN WHEEL WHILE THE RING IS UP|KEY:+wr_wheel||||DO:~PRESS OPEN WHEEL WHILE THE RING IS UP~GET:~THE RING CLOSES. WITH A SLOT OPEN IT GOES BACK TO THE SLOTS INSTEAD");
		r.Push("||PRESS OPEN WHEEL TWICE WITHIN ABOUT A THIRD OF A SECOND|KEY:+wr_wheel||||DO:~PRESS OPEN WHEEL TWICE WITHIN ABOUT A THIRD OF A SECOND~GET:~THE RING CLOSES AND THE HAND THAT LAST TOOK A GUN FROM IT GETS BACK THE GUN IT HELD BEFORE~NEEDS:~DOUBLE TAP ABOVE 0 (DEFAULT 10 TICS)");
		r.Push("||OPEN THE RING, ANY WAY|||||DO:~OPEN THE RING, ANY WAY~GET:~TIME STOPS UNTIL THE RING CLOSES~NEEDS:~TIME WHILE OPEN: FROZEN (DEFAULT)");
		r.Push("||WITH THE RING UP, PUSH THE STICK TO WALK OR TURN, OR PULL A TRIGGER OFF THE CARDS|||||DO:~WITH THE RING UP, PUSH THE STICK TO WALK OR TURN, OR PULL A TRIGGER OFF THE CARDS~GET:~NOTHING: THE WHEEL FREEZES THE PLAYER UNTIL THE RING CLOSES. A STICK TURN (SNAP OR SMOOTH) IS HANDED BACK THE TIC IT LANDS, SO A SNAP CAN SHOW FOR A FRAME~NEEDS:~HOLD STILL WHILE OPEN: ON (DEFAULT) FOR WALKING AND TURNING");
		r.Push("||WITH THE RING UP, PRESS USE, TOSS GRENADE OR QUICK GRENADE|||||DO:~WITH THE RING UP, PRESS USE, TOSS GRENADE OR QUICK GRENADE~GET:~NOTHING: THE WHEEL TAKES THE PRESS, SO NO DOOR OPENS AND NO GRENADE IS THROWN");
		r.Push("||POINT EITHER HAND AT A CARD|||||DO:~POINT EITHER HAND AT A CARD~GET:~A BEAM RUNS FROM THAT HAND. THE CARD UNDER IT LIGHTS, GROWS, STEPS TOWARD YOU AND TICKS IN THAT HAND. THE OTHER HAND TAKES OVER THE BEAM WHEN IT IS ON A CARD AND THE FIRST IS NOT~NEEDS:~EITHER HAND: ON (DEFAULT)");
		r.Push("||PULL THE TRIGGER OF EITHER HAND WHILE A CARD IS LIT|||||DO:~PULL THE TRIGGER OF EITHER HAND WHILE A CARD IS LIT~GET:~THE LIT CARD'S GUN GOES INTO THE POINTING HAND AND THE RING CLOSES. NO SHOT IS FIRED");
		r.Push("||PRESS THE OFF HAND'S ALT FIRE ON A CARD|||||DO:~PRESS THE OFF HAND'S ALT FIRE ON A CARD~GET:~THAT GUN GOES INTO THE OFF HAND AND THE RING STAYS UP. IT GOES BY THE OFF HAND'S OWN BEAM, WHEREVER THE OTHER HAND POINTS");
		r.Push("||PRESS THE MAIN HAND'S ALT FIRE ON A CARD|||||DO:~PRESS THE MAIN HAND'S ALT FIRE ON A CARD~GET:~WITHOUT RSQ TACTICAL RIG: A DULL TICK IN THE MAIN HAND, NOTHING ELSE");
		r.Push("||TAKE THE FIST CARD|||||DO:~TAKE THE FIST CARD~GET:~THE HAND THAT TOOK IT GETS ITS OWN FIST, GIVEN TO YOU IF YOU HAD NONE");
		r.Push("||TAKE A GUN WITH NO AMMO ANYWHERE|||||DO:~TAKE A GUN WITH NO AMMO ANYWHERE~GET:~A DRY CLICK, THE HAND KEEPS THE GUN IT HAD, AND THE RING CLOSES");
		r.Push("||TAKE THE GUN YOUR OTHER HAND IS HOLDING|||||DO:~TAKE THE GUN YOUR OTHER HAND IS HOLDING (WITH BRUTAL DOOM 22 VR, THE OTHER HAND'S OWN VERSION OF IT COUNTS)~GET:~THE TWO HANDS TRADE GUNS, EACH IN THAT HAND'S VERSION; AN EMPTY HAND HANDS OVER ITS FIST (A SPARE NUMBERED COPY IS TAKEN INSTEAD, IF YOU OWN ONE)");
		r.Push("||PULL A TRIGGER OR ALT FIRE WHILE POINTING AT THE DATA SHEET|||||DO:~PULL A TRIGGER OR ALT FIRE WHILE POINTING AT THE DATA SHEET~GET:~THE PRESS IS SWALLOWED AND NOTHING HAPPENS~NEEDS:~DATA SHEET: ON (DEFAULT)");
		r.Push("||LEAVE THE RING UP WITH NO CARD LIT FOR FOUR SECONDS|||||DO:~LEAVE THE RING UP WITH NO CARD LIT FOR FOUR SECONDS~GET:~IT FADES FOR THE LAST 25 TICS WITH ONE TICK IN THE HAND, THEN FOLDS AWAY~NEEDS:~FOLDS AFTER (DEFAULT 140 TICS)");
		r.Push("||TURN MORE THAN 45 DEGREES AWAY FROM THE OPEN RING|||||DO:~TURN MORE THAN 45 DEGREES AWAY FROM THE OPEN RING~GET:~THE RING SWINGS ROUND TO SIT AHEAD OF YOU AGAIN~NEEDS:~RING FOLLOWS PAST ABOVE 0 (DEFAULT 45)");
		r.Push("||PRESS A KEY BOUND TO NEXT WEAPON OR PREVIOUS WEAPON - WEAPON WHEEL: ON|||||DO:~PRESS A KEY BOUND TO NEXT WEAPON OR PREVIOUS WEAPON~GET:~THAT HAND STEPS TO ITS NEXT GUN IN SLOT ORDER THAT HAS AMMO, RING UP OR DOWN~NEEDS:~WEAPON WHEEL: ON (DEFAULT)");
		r.Push("||WITH THE RING CLOSED, POINT A HAND AT A WEAPON ON THE FLOOR WITHIN 1.7 METRES AND HOLD FOR HALF A SECOND|||||DO:~WITH THE RING CLOSED, POINT A HAND AT A WEAPON ON THE FLOOR WITHIN 1.7 METRES AND HOLD FOR HALF A SECOND~GET:~A DATA SHEET FOR THAT WEAPON STANDS AT THE POINTING HAND UNTIL YOU POINT AWAY~NEEDS:~POINT AT A GUN: ON (DEFAULT)");
		r.Push("||DIE, OR LEAVE THE LEVEL|||||DO:~DIE, OR LEAVE THE LEVEL~GET:~THE RING CLOSES AT ONCE");
		r.Push("||REST THE BEAM ON A CARD WITH \"+N\" IN ITS CORNER FOR A FIFTH OF A SECOND, OR PRESS USE ON IT FROM A DISTANCE|||||DO:~REST THE BEAM ON A CARD WITH \"+N\" IN ITS CORNER FOR A FIFTH OF A SECOND, OR PRESS USE ON IT FROM A DISTANCE~GET:~A FAN OF THAT SLOT'S OTHER WEAPONS OPENS OUT OF THE CARD~NEEDS:~RING LAYOUT: WHEN CROWDED, WITH MORE WEAPONS THAN OWN CARDS UP TO");
		r.Push("||HOLD THE TRIGGER ON A FAN CARD, MOVE TO ANOTHER PLACE IN THE FAN, LET GO|||||DO:~HOLD THE TRIGGER ON A FAN CARD, MOVE TO ANOTHER PLACE IN THE FAN, LET GO~GET:~THE GUN TAKES THAT PLACE IN ITS SLOT, AND THE ORDER IS SAVED. LET GO WITHOUT MOVING AND THE GUN IS TAKEN~NEEDS:~RING LAYOUT: WHEN CROWDED, WITH MORE WEAPONS THAN OWN CARDS UP TO");
		r.Push("||PRESS A KEY BOUND TO NEXT WEAPON OR PREVIOUS WEAPON - SKIP HOLSTERED GUNS: ON|||||DO:~PRESS A KEY BOUND TO NEXT WEAPON OR PREVIOUS WEAPON~GET:~GUNS THAT HAVE A HOLSTER ARE SKIPPED, AND THE CARDS OF THE GUNS IT DOES REACH WEAR A GOLD RUNNING LIGHT~NEEDS:~SKIP HOLSTERED GUNS: ON (DEFAULT OFF)");
		r.Push("||WITH THE RING CLOSED, BRING A FOREARM UP ACROSS YOUR CHEST, WRIST IN FRONT OF YOUR FACE AND HAND POINTING ACROSS YOUR BODY, AND HOLD IT||MAIN OFF|||DO:~WITH THE RING CLOSED, BRING A FOREARM UP ACROSS YOUR CHEST, WRIST IN FRONT OF YOUR FACE AND HAND POINTING ACROSS YOUR BODY, AND HOLD IT~GET:~A CARD STANDS OVER THAT WRIST WITH THE GUN'S NAME, ROUNDS, AND KILLS AND HITS~NEEDS:~WRIST CARD: ON (DEFAULT OFF)");
		r.Push("||POINT THE OTHER HAND AT A DIFFERENT GUN'S CARD|||||DO:~POINT THE OTHER HAND AT A DIFFERENT GUN'S CARD~GET:~THE DATA SHEET TURNS INTO THE TWO GUNS SIDE BY SIDE~NEEDS:~TWO HANDS COMPARE: ON (DEFAULT OFF)");
		r.Push("||TWIST THE WRIST OF THE HAND THE RING OPENED ON|||||DO:~TWIST THE WRIST OF THE HAND THE RING OPENED ON~GET:~THE CARDS TURN ROUND THE RING~NEEDS:~WRIST ROLL SPIN ABOVE 0 (DEFAULT 0)");
		r.Push("||OPEN THE RING WITH OPENS ON SET TO OFF HAND|||||DO:~OPEN THE RING WITH OPENS ON SET TO OFF HAND~GET:~THE RING OPENS IN FRONT OF THE OFF HAND~NEEDS:~OPENS ON: OFF HAND (DEFAULT MAIN HAND)");
		r.Push("||POINT WITH THE HAND THAT DID NOT OPEN THE RING|||||DO:~POINT WITH THE HAND THAT DID NOT OPEN THE RING~GET:~NOTHING: ONLY THE HAND THE RING OPENED ON POINTS, AND THE GUN GOES TO THAT HAND~NEEDS:~EITHER HAND: OFF (DEFAULT ON)");
		r.Push("||OPEN THE RING WITH TIME WHILE OPEN ON SLOW|||||DO:~OPEN THE RING WITH TIME WHILE OPEN ON SLOW~GET:~TIME SLOWS UNTIL THE RING CLOSES. WITHOUT RSQ SLOWMO LOADED IT STOPS INSTEAD~NEEDS:~TIME WHILE OPEN: SLOW (DEFAULT FROZEN), RSQ SLOWMO");
		r.Push("||OPEN THE RING WITH TIME WHILE OPEN ON NORMAL|||||DO:~OPEN THE RING WITH TIME WHILE OPEN ON NORMAL~GET:~TIME RUNS ON~NEEDS:~TIME WHILE OPEN: NORMAL (DEFAULT FROZEN)");
		r.Push("||START A MAP|||||DO:~START A MAP~GET:~THE RING OPENS BY ITSELF~NEEDS:~OPEN AT LEVEL START: ON (DEFAULT OFF)");
	}

	// RSQ Glow In The Dark (GlowInTheDark/README.md)
	static void RowsGlowInTheDark(out Array<String> r)
	{
		r.Push("||START A MAP|||||DO:~START A MAP~GET:~EVERY ROOM'S WALLS GLOW: A BAND UP FROM THE FLOOR AND A BAND DOWN FROM THE CEILING, 64 UNITS, EACH CHANNEL OF EACH COLOUR PICKED AT RANDOM. ONE PAIR OF COLOURS FOR EACH TAG GROUP; ALL UNTAGGED ROOMS SHARE ONE PAIR. NEW COLOURS EVERY MAP~NEEDS:~GLOW IN THE DARK: ON (DEFAULT); PROFILE: CLASSIC (1.1) (DEFAULT); REROLL COLOURS: EVERY MAP (DEFAULT); FLOORS AND CEILINGS: ON (DEFAULT)");
		r.Push("||LOOK ROUND ANY ROOM|||||DO:~LOOK ROUND ANY ROOM~GET:~IT IS DARKER THAN THE MAP MADE IT: EACH ROOM'S LIGHT TIMES 0.625, SKY ROOMS TOO~NEEDS:~DARKNESS MODE: COMPRESS (DEFAULT); DARKNESS LEVEL: DISMAL (DEFAULT)");
		r.Push("||LOOK AT A LIQUID - LIQUIDS GLOW: ON|||||DO:~LOOK AT A LIQUID (WATER, NUKAGE, SLIME, LAVA, BLOOD, SCREENS, EXIT SIGNS AND THE REST OF THE GLOW LIST)~GET:~THE WALLS ROUND IT GLOW IN THE LIQUID'S OWN COLOUR, 128 UNITS UP, AND BREATHE AT ITS OWN PACE (LAVA SLOW, WATER QUICK)~NEEDS:~LIQUIDS GLOW: ON (DEFAULT); LIVING LIQUIDS: ON (DEFAULT); LIQUID COLOUR: BY PROFILE (DEFAULT)");
		r.Push("||LOOK AT A LIQUID FROM ANOTHER MAP PACK, NOT IN THE LIST|||||DO:~LOOK AT A LIQUID FROM ANOTHER MAP PACK, NOT IN THE LIST~GET:~IF ITS NAME SAYS NUK, ACID, TOXIC, OOZE, LAVA, MAGMA, BLOOD, WATER, SLIM, SLUDG OR POIS, OR THE MAP CALLS IT LIQUID, IT GLOWS THE SAME WAY~NEEDS:~GUESS LIQUIDS BY NAME: ON (DEFAULT)");
		r.Push("||LOOK AT A FLOOR THAT HURTS AND IS NOT A KNOWN LIQUID|||||DO:~LOOK AT A FLOOR THAT HURTS AND IS NOT A KNOWN LIQUID~GET:~THE WALLS ROUND IT THROB RED, 40 TIMES A MINUTE~NEEDS:~HURT FLOORS THROB RED: ON (DEFAULT)");
		r.Push("||LOOK AT A TELEPORTER PAD|||||DO:~LOOK AT A TELEPORTER PAD (A FLOOR NAMED GATE...)~GET:~A CYAN SHIMMER UP THE WALLS ROUND IT~NEEDS:~SWITCHES AND EXITS: ON (DEFAULT)");
		r.Push("||LOOK AT A SWITCH|||||DO:~LOOK AT A SWITCH (ANY WALL YOU USE OR SHOOT THAT DOES SOMETHING)~GET:~THAT WALL IS LIT AMBER~NEEDS:~SWITCHES AND EXITS: ON (DEFAULT)");
		r.Push("||LOOK AT AN EXIT SWITCH|||||DO:~LOOK AT AN EXIT SWITCH~GET:~LIT GREEN, BREATHING~NEEDS:~SWITCHES AND EXITS: ON (DEFAULT)");
		r.Push("||LOOK AT A LOCKED DOOR|||||DO:~LOOK AT A LOCKED DOOR~GET:~LIT IN ITS KEY'S COLOUR (RED, BLUE, YELLOW; LAVENDER FOR ANY OTHER LOCK), BREATHING 18 TIMES A MINUTE~NEEDS:~SWITCHES AND EXITS: ON (DEFAULT)");
		r.Push("||PICK UP THAT DOOR'S KEY|||||DO:~PICK UP THAT DOOR'S KEY (ANY PLAYER HOLDING IT COUNTS)~GET:~THE DOOR GLOWS BRIGHTER AND BREATHES FASTER, 50 TIMES A MINUTE~NEEDS:~SWITCHES AND EXITS: ON (DEFAULT)");
		r.Push("||LOOK AT AN ORDINARY DOOR|||||DO:~LOOK AT AN ORDINARY DOOR~GET:~A FAINT COOL EDGE~NEEDS:~SWITCHES AND EXITS: ON (DEFAULT); ORDINARY DOORS TOO: ON (DEFAULT)");
		r.Push("||LOOK AT KEYS AND POWERUPS LYING IN THE MAP|||||DO:~LOOK AT KEYS AND POWERUPS LYING IN THE MAP~GET:~DRAWN AT FULL BRIGHTNESS. PICKED UP, THEY ARE NORMAL AGAIN~NEEDS:~KEYS AND PICKUPS: KEYS (DEFAULT)");
		r.Push("||WALK INTO A DARK ROOM|||||DO:~WALK INTO A DARK ROOM~GET:~ITS GLOW IS STRONGER AND TALLER: UP TO 1.6 TIMES AS STRONG AND 1.4 TIMES AS TALL, BY HOW DARK IT IS~NEEDS:~STRONGER IN THE DARK: ON (DEFAULT)");
		r.Push("||KILL SOMETHING STANDING IN A LIQUID|||||DO:~KILL SOMETHING (OR DIE) STANDING IN A LIQUID~GET:~THE POOL FLARES IN ITS COLOUR FOR 18 TICS~NEEDS:~SPLASH FLARES: ON (DEFAULT)");
		r.Push("||PRESS SHUFFLE PROFILE|||||DO:~PRESS SHUFFLE PROFILE (OPTIONS > RADIANT SILVERGUN OPTIONS > RSQ GLOW IN THE DARK)~GET:~ANOTHER NAMED PROFILE AT RANDOM, WITH NEW COLOURS 2 TICS LATER. WITH PROFILE AT CUSTOM OR RANDOM PROFILE IT ONLY GIVES NEW COLOURS");
		r.Push("||PRESS RANDOMIZE LOOK|||||DO:~PRESS RANDOMIZE LOOK (SAME PAGE)~GET:~A NEW LOOK MADE UP AT RANDOM (COLOURS, PULSE, STRENGTH, LIQUIDS), PROFILE SET TO CUSTOM, NEW COLOURS");
		r.Push("||PRESS RANDOMIZE COLOURS|||||DO:~PRESS RANDOMIZE COLOURS (SAME PAGE)~GET:~NEW COLOURS NOW, THE SAME PROFILE AND LOOK");
		r.Push("||PRESS ANY OF THOSE THREE DURING A BOSS FIGHT, A BOSS'S TINT, A SCORE LIFE FLASH OR WHILE ANY PLAYER IS DOWN|||||DO:~PRESS ANY OF THOSE THREE DURING A BOSS FIGHT, A BOSS'S TINT, A SCORE LIFE FLASH OR WHILE ANY PLAYER IS DOWN~GET:~NOTHING. YOUR CONSOLE SAYS \"GLOW IN THE DARK: COLOURS HELD DURING A BOSS FIGHT OR SEQUENCE\"");
		r.Push("||STEP PROFILE LEFT OR RIGHT|||||DO:~STEP PROFILE LEFT OR RIGHT (OR CLICK IT)~GET:~THE NEXT OR PREVIOUS OF 37 ROWS: CUSTOM, RANDOM PROFILE, CLASSIC (1.1) AND 34 NAMED LOOKS");
		r.Push("||PRESS PAIR DARKNESS TO PROFILE|||||DO:~PRESS PAIR DARKNESS TO PROFILE (TEST AND DEBUG PAGE)~GET:~DARKNESS MODE AND DARKNESS LEVEL ARE SET TO THAT PROFILE'S PAIRING. GREYED FOR CUSTOM AND RANDOM PROFILE");
		r.Push("||CHANGE ANY GLOW SETTING|||||DO:~CHANGE ANY GLOW SETTING~GET:~THE MAP IS WRITTEN AGAIN WITHIN A SECOND");
		r.Push("||PLAY A WHOLE MAP WITH REROLL COLOURS AT NEVER|||||DO:~PLAY A WHOLE MAP WITH REROLL COLOURS AT NEVER~GET:~THE SAME COLOURS EVERY MAP, FROM COLOUR SEED (DEFAULT 1337). RANDOMIZE COLOURS WRITES A NEW SEED~NEEDS:~REROLL COLOURS: NEVER");
		r.Push("||DIE|||||DO:~DIE~GET:~NEW COLOURS. ALONE: WHEN THE MAP OR A SAVE IS LOADED AGAIN. IN A NETGAME: AT ONCE~NEEDS:~REROLL COLOURS: ON DEATH");
		r.Push("||LEVEL UP A GUN IN GUN BONSAI|||||DO:~LEVEL UP A GUN IN GUN BONSAI~GET:~NEW COLOURS~NEEDS:~REROLL COLOURS: LEVEL UP; GUN BONSAI OR RSQ GUN BONSAI VR");
		r.Push("||PLAY ON|||||DO:~PLAY ON~GET:~NEW COLOURS EVERY REROLL EVERY (MIN) MINUTES (DEFAULT 5), COUNTED FROM THE MAP'S START~NEEDS:~REROLL COLOURS: TIMED");
		r.Push("||LOOK AT A SECRET ROOM YOU HAVE NOT FOUND|||||DO:~LOOK AT A SECRET ROOM YOU HAVE NOT FOUND~GET:~ITS WALLS SHIMMER GOLD UNTIL YOU FIND IT~NEEDS:~SECRET ROOMS SHIMMER: ON (DEFAULT OFF)");
		r.Push("||LOOK AT A LIQUID - LIQUID COLOUR: ROOM COLOUR|||||DO:~LOOK AT A LIQUID~GET:~IT WEARS THE ROOM'S COLOUR (AS 1.1 DID)~NEEDS:~LIQUID COLOUR: ROOM COLOUR (DEFAULT BY PROFILE)");
		r.Push("||LOOK AT A LIQUID - LIQUID COLOUR: OWN COLOUR|||||DO:~LOOK AT A LIQUID~GET:~ALWAYS ITS OWN COLOUR, WHATEVER THE PROFILE SAYS~NEEDS:~LIQUID COLOUR: OWN COLOUR (DEFAULT BY PROFILE)");
		r.Push("||WALK ROOM TO ROOM - ONE COLOUR PER: EACH ROOM OR TAG GROUP|||||DO:~WALK ROOM TO ROOM~GET:~A COLOUR FOR EACH ROOM, OR FOR EACH TAG GROUP, WHATEVER THE PROFILE SAYS~NEEDS:~ONE COLOUR PER: EACH ROOM OR TAG GROUP (DEFAULT BY PROFILE)");
		r.Push("||WALK ROOM TO ROOM - BLEND ROOMS: ON|||||DO:~WALK ROOM TO ROOM~GET:~EACH ROOM'S FLOOR COLOUR IS PULLED HALF WAY TO ITS NEIGHBOURS'~NEEDS:~BLEND ROOMS: ON (DEFAULT OFF)");
		r.Push("||LOOK AT HEALTH AND ARMOUR LYING IN THE MAP|||||DO:~LOOK AT HEALTH AND ARMOUR (AND AMMO AND WEAPONS) LYING IN THE MAP~GET:~DRAWN AT FULL BRIGHTNESS TOO~NEEDS:~KEYS AND PICKUPS: PLUS HEALTH OR PLUS AMMO (DEFAULT KEYS)");
		r.Push("||LOOK AT THE LARGEST POOLS, OR THE MOST IMPORTANT ITEMS|||||DO:~LOOK AT THE LARGEST POOLS, OR THE MOST IMPORTANT ITEMS~GET:~A REAL LIGHT OVER EACH (AS MANY AS THE ROW SAYS), COLOURED LIKE IT~NEEDS:~LIGHTS OVER POOLS ABOVE 0 (DEFAULT 0); LIGHTS ON ITEMS ABOVE 0 (DEFAULT 0)");
		r.Push("||TURN GLOW IN THE DARK OFF|||||DO:~TURN GLOW IN THE DARK OFF~GET:~THE MAP'S OWN GLOW AND LIGHT COME BACK: NO DARKNESS, NO LIT WALLS, ITEMS NORMAL~NEEDS:~GLOW IN THE DARK: OFF");
	}

	// RSQ Gun Bonsai VR (GunBonsaiOffhandVR/README.md)
	static void RowsGunBonsaiOffhandVR(out Array<String> r)
	{
		r.Push("||HOLD A WEAPON IN A HAND|||||DO:~HOLD A WEAPON IN A HAND~GET:~A GAUGE FOR THAT HAND IS DRAWN AT THE TOP OF THE VIEW, THE MAIN HAND'S ON THE RIGHT, THE OFF HAND'S ON THE LEFT: THE WEAPON'S NAME, ITS LEVEL AND XP, ITS XP BAR, YOUR PLAYER LEVEL AND PLAYER XP BAR. AN EMPTY HAND HAS NO GAUGE. THE GAUGE'S FRAME AND BARS CYCLE THROUGH COLOURS ALL THE TIME AND THE BARS AND TEXT PULSE IN BRIGHTNESS~NEEDS:~DUAL HUD: ON (DEFAULT); MAIN HUD COLOUR CYCLE AND OFF HUD COLOUR CYCLE: ON (DEFAULT); GBOVR MENUS AND HUD: ON (DEFAULT) FOR THE PULSE");
		r.Push("||HURT A MONSTER WITH A WEAPON|||||DO:~HURT A MONSTER WITH A WEAPON~GET:~THAT WEAPON GETS XP: THE DAMAGE TIMES GUN BONSAI'S DAMAGE-TO-XP SETTING, TIMES (LOG10 OF THE MONSTER'S STARTING HEALTH, MINUS 1) WHEN THAT HEALTH IS OVER 100. DAMAGE PAST ZERO HEALTH PAYS NOTHING. HURTING YOURSELF, A FRIENDLY MONSTER OR A THING THAT IS NO MONSTER PAYS NOTHING");
		r.Push("||FIRE A BULLET WEAPON FROM ONE HAND|||||DO:~FIRE A BULLET WEAPON FROM ONE HAND~GET:~EVERY HIT OF THAT SHOT PAYS THE WEAPON IN THE HAND THAT FIRED IT, EVEN WHILE THE OTHER HAND FIRES IN THE SAME TIC");
		r.Push("||FIRE A ROCKET OR ANOTHER PROJECTILE|||||DO:~FIRE A ROCKET OR ANOTHER PROJECTILE~GET:~THE SHOT IS TIED TO A WEAPON AS IT APPEARS: THE HAND NEARER TO IT (UP TO 3 POINTS), THE HAND POINTING ITS WAY (UP TO 2), THE HAND WHOSE WEAPON IS IN ITS FIRE FRAMES (2.5), THE HAND WHOSE TRIGGER IS DOWN (0.5); THE HIGHER TOTAL WINS. ITS BLAST AND ANYTHING IT SPAWNS PAY THE SAME WEAPON");
		r.Push("||HIT WITH A WEAPON THAT DEALS THE BLOW ITSELF, SUCH AS A SABER CUT|||||DO:~HIT WITH A WEAPON THAT DEALS THE BLOW ITSELF, SUCH AS A SABER CUT~GET:~THAT WEAPON IS PAID, WHICHEVER HAND HOLDS IT, AND EVEN IF IT IS IN NEITHER HAND");
		r.Push("||BURN OR POISON A MONSTER WITH GUN BONSAI'S ELEMENTAL UPGRADES FROM TWO WEAPONS|||||DO:~BURN OR POISON A MONSTER WITH GUN BONSAI'S ELEMENTAL UPGRADES FROM TWO WEAPONS~GET:~EACH TICK OF IT PAYS BOTH WEAPONS, SPLIT BY HOW MUCH EACH ONE PUT ON");
		r.Push("||SWITCH THE WEAPON IN A HAND|||||DO:~SWITCH THE WEAPON IN A HAND~GET:~THAT HAND'S GAUGE FOLLOWS. THE UPGRADES OF THE WEAPON THAT LEFT STOP AND THE NEW WEAPON'S START. A WEAPON HELD FOR THE FIRST TIME GETS A NEW RECORD AT LEVEL 0");
		r.Push("||TAKE A HIT|||||DO:~TAKE A HIT~GET:~YOUR PLAYER UPGRADES AND THE UPGRADES ON BOTH HANDS' WEAPONS ALL GET TO CHANGE THE DAMAGE");
		r.Push("||FILL A WEAPON'S XP BAR|||||DO:~FILL A WEAPON'S XP BAR~GET:~A LEVEL WAITS FOR THAT WEAPON: GUN BONSAI'S LEVEL-UP FLASH AND SOUND (WHEN ITS SETTINGS HAVE THEM) AND ITS \"LEVEL UP READY\" MESSAGE. NOTHING IS CHOSEN YET. IF GUN BONSAI'S \"CHOICES PER GUN LEVEL\" IS 0 OR 1 THE UPGRADE IS CHOSEN FOR YOU AT ONCE");
		r.Push("||PRESS THE INFO KEY WHILE A WEAPON'S LEVEL WAITS|||||DO:~PRESS THE INFO KEY WHILE A WEAPON'S LEVEL WAITS~GET:~THAT WEAPON'S LEVEL-UP SCREEN OPENS: THE WEAPON'S NAME AS THE TITLE AND UP TO FOUR CARDS, EACH ONE UPGRADE GUN BONSAI OFFERS, WITH ITS DESCRIPTION AND NEW OR THE LEVEL IT WOULD GO TO. THE MAIN HAND'S WEAPON IS SERVED FIRST, THEN THE OFF HAND'S~NEEDS:~GBOVR MENUS AND HUD: ON (DEFAULT)");
		r.Push("||ON A LEVEL-UP SCREEN, MENU LEFT OR UP, MENU RIGHT OR DOWN|||||DO:~ON A LEVEL-UP SCREEN, MENU LEFT OR UP, MENU RIGHT OR DOWN~GET:~THE HIGHLIGHT MOVES TO THE CARD BEFORE OR AFTER, WRAPPING ROUND. PAGE UP AND PAGE DOWN MOVE IT FOUR CARDS");
		r.Push("||ON A LEVEL-UP SCREEN, MENU SELECT|||||DO:~ON A LEVEL-UP SCREEN, MENU SELECT~GET:~THE HIGHLIGHTED CARD IS TAKEN: THE WEAPON GAINS THE LEVEL AND THAT UPGRADE, THE NEXT LEVEL COSTS MORE, AND YOU GAIN 1 PLAYER XP. THE SCREEN CLOSES");
		r.Push("||ON A LEVEL-UP SCREEN, PRESS 1, 2, 3 OR 4 ON A KEYBOARD|||||DO:~ON A LEVEL-UP SCREEN, PRESS 1, 2, 3 OR 4 ON A KEYBOARD~GET:~THE CARD WITH THAT NUMBER ON THE PAGE SHOWN IS TAKEN");
		r.Push("||ON A LEVEL-UP SCREEN, MENU BACK|||||DO:~ON A LEVEL-UP SCREEN, MENU BACK~GET:~THE LEVEL IS REFUSED: NO UPGRADE, AND GUN BONSAI TAKES THE XP OF THAT LEVEL (A WEAPON'S WHOLE LEVEL; HALF OF A PLAYER LEVEL)");
		r.Push("||GAIN ENOUGH PLAYER XP|||||DO:~GAIN ENOUGH PLAYER XP (GUN BONSAI'S \"GUN LEVELS PER PLAYER LEVEL\")~GET:~A PLAYER LEVEL WAITS: A LONGER FLASH, THE SOUND AND A MESSAGE. WITH GUN BONSAI'S \"CHOICES PER PLAYER LEVEL\" AT 0 OR 1 THE UPGRADE IS CHOSEN FOR YOU");
		r.Push("||PRESS THE INFO KEY WHILE A PLAYER LEVEL WAITS AND NO WEAPON LEVEL DOES|||||DO:~PRESS THE INFO KEY WHILE A PLAYER LEVEL WAITS AND NO WEAPON LEVEL DOES~GET:~THE PLAYER LEVEL-UP SCREEN OPENS, TITLED LEVEL AND THE NUMBER, WITH CARDS FROM GUN BONSAI'S PLAYER UPGRADES. IT IS WORKED THE SAME WAY~NEEDS:~GBOVR MENUS AND HUD: ON (DEFAULT)");
		r.Push("||PRESS THE INFO KEY WITH NO LEVEL WAITING|||||DO:~PRESS THE INFO KEY WITH NO LEVEL WAITING~GET:~THE STATUS SCREEN OPENS. LEFT: PLAYER STATUS WITH YOUR LEVEL, XP AND YOUR UPGRADES. MIDDLE: A CARD FOR EACH HAND'S WEAPON WITH ITS PICTURE, NAME, LV AND XP. RIGHT: EACH WEAPON'S WEAPON STATUS, THE LIST OF ITS UPGRADES. BOTTOM: DESCRIPTION. THE CURSOR STARTS ON THE MAIN HAND'S WEAPON THE FIRST TIME AND, WITH A WEAPON IN EACH HAND, ON THE OTHER HAND'S WEAPON EACH TIME AFTER~NEEDS:~GBOVR MENUS AND HUD: ON (DEFAULT); A WEAPON IN AT LEAST ONE HAND");
		r.Push("||ON THE STATUS SCREEN, MENU UP OR DOWN|||||DO:~ON THE STATUS SCREEN, MENU UP OR DOWN~GET:~THE CURSOR WALKS EVERY ROW AND WRAPS: THE MAIN HAND'S WEAPON, ITS UPGRADES, THE OFF HAND'S WEAPON, ITS UPGRADES, THEN YOUR PLAYER UPGRADES. DESCRIPTION SHOWS THE UPGRADE'S TEXT AND NUMBERS, OR THE WEAPON'S NAME AND CLASS");
		r.Push("||ON THE STATUS SCREEN WITH THE CURSOR ON A WEAPON, MENU RIGHT OR MENU SELECT|||||DO:~ON THE STATUS SCREEN WITH THE CURSOR ON A WEAPON, MENU RIGHT OR MENU SELECT~GET:~THE CURSOR JUMPS TO THAT WEAPON'S FIRST UPGRADE. MENU LEFT JUMPS TO YOUR FIRST PLAYER UPGRADE. WITH NO UPGRADES THERE, NOTHING");
		r.Push("||ON THE STATUS SCREEN WITH THE CURSOR ON AN UPGRADE, MENU SELECT|||||DO:~ON THE STATUS SCREEN WITH THE CURSOR ON AN UPGRADE, MENU SELECT~GET:~THAT UPGRADE IS SWITCHED OFF, OR BACK ON. AN UPGRADE THAT IS OFF IS GREY AND MARKED [OFF]");
		r.Push("||ON THE STATUS SCREEN WITH THE CURSOR ON AN UPGRADE, MENU LEFT OR RIGHT|||||DO:~ON THE STATUS SCREEN WITH THE CURSOR ON AN UPGRADE, MENU LEFT OR RIGHT~GET:~THE LEVEL THAT UPGRADE WORKS AT GOES DOWN OR UP BY ONE, NEVER UNDER 1 AND NEVER OVER ITS TOP LEVEL. SHOWN AS LEVEL/TOP. NOTHING IF THE UPGRADE IS OFF");
		r.Push("||ON THE STATUS SCREEN, PRESS THE INFO KEY AGAIN ON A KEYBOARD|||||DO:~ON THE STATUS SCREEN, PRESS THE INFO KEY AGAIN ON A KEYBOARD (A LETTER OR DIGIT KEY)~GET:~THE CURSOR JUMPS TO THE OTHER HAND'S WEAPON. WITH ONE WEAPON, THE SCREEN CLOSES");
		r.Push("||LOOK AT THE BOTTOM OF THE VIEW|||||DO:~LOOK AT THE BOTTOM OF THE VIEW~GET:~EACH HAND'S AMMO ON THAT HAND'S SIDE (THE RESERVE, AND THE MAGAZINE TOO WHEN THE WEAPON HAS TWO AMMO POOLS), DOOM'S FACE IN THE MIDDLE, HEALTH TO ITS LEFT AND ARMOUR TO ITS RIGHT~NEEDS:~GBOVR MENUS AND HUD: ON (DEFAULT); AMMO AND HEALTH ROW: ON (DEFAULT)");
		r.Push("||PICK UP A LEGENDOOM WEAPON POWER|||||DO:~PICK UP A LEGENDOOM WEAPON POWER~GET:~A CARD SHOWS FOR ABOUT 3 SECONDS (105 TICS) UNDER THE GAUGES: THE POWER'S NAME FLASHING BETWEEN TWO LOOKS EVERY 10 TICS, ITS RARITY AND THE GUN IT IS ON, LEGENDOOM'S DESCRIPTION AND ICON. LEGENDOOM'S OWN PICKUP SCREEN IS TAKEN OFF WHILE THE CARD IS UP. THE CARD THEN FOLDS, IN 14 TICS, INTO THE ROW UNDER THAT GUN'S GAUGE~NEEDS:~LEGENDOOM; LEGENDOOM CARD: ON (DEFAULT)");
		r.Push("||HOLD A GUN THAT CARRIES A LEGENDOOM POWER|||||DO:~HOLD A GUN THAT CARRIES A LEGENDOOM POWER~GET:~A ROW UNDER THAT HAND'S GAUGE: THE POWER'S ICON AND NAME IN ITS RARITY COLOUR. WHILE THE POWER'S TIMED BUFF RUNS, A LINE UNDER THE NAME DRAINS, AND MURDEROUS SHOWS X3. THE STATUS SCREEN SHOWS THE SAME POWER AS LEGENDARY POWER UNDER THAT WEAPON'S UPGRADES~NEEDS:~LEGENDOOM; LEGENDOOM GAUGE ROW: ON (DEFAULT)");
		r.Push("||KILL WITH SOMETHING NO WEAPON OWNS|||||DO:~KILL WITH SOMETHING NO WEAPON OWNS: AN OBJECT THROWN WITH RSQ DISTANCE GRAB OR THE BLAST IT SET OFF, OR A THROWN GUN THAT HAS NO RECORD~GET:~THE XP GOES TO A PLAYER POOL. EVERY TIME THE POOL REACHES GUN BONSAI'S BASE LEVEL COST YOU GAIN 1 PLAYER XP~NEEDS:~RSQ DISTANCE GRAB, OR RSQ TACTICAL RIG FOR THE THROWN GUN");
		r.Push("||THROW A GUN YOU HAVE HELD AT A MONSTER|||||DO:~THROW A GUN YOU HAVE HELD AT A MONSTER (RSQ TACTICAL RIG)~GET:~THE HIT PAYS THAT GUN'S OWN RECORD~NEEDS:~RSQ TACTICAL RIG");
		r.Push("||HURT A MONSTER WITH THE FORCE|||||DO:~HURT A MONSTER WITH THE FORCE (RSQ SABER)~GET:~THE FORCE HAND'S RECORD IS PAID; WITHOUT A FORCE HAND, THE MAIN SABER'S. THE FORCE HAND IS NEVER PICKED BY THE HAND GUESS ABOVE~NEEDS:~RSQ SABER");
		r.Push("||HOLD BRUTAL DOOM 22 VR'S AXE IN EITHER HAND, OR BOTH|||||DO:~HOLD BRUTAL DOOM 22 VR'S AXE IN EITHER HAND, OR BOTH~GET:~BOTH HANDS' AXES ARE ONE RECORD: ONE LEVEL, ONE XP, ONE SET OF UPGRADES. IT IS KEPT WHEN EVERY AXE IS THROWN~NEEDS:~BD22 VR RELOADED");
		r.Push("||SCORE POINTS WHILE GUN BONSAI'S SCORE-TO-XP FACTOR IS ABOVE 0|||||DO:~SCORE POINTS WHILE GUN BONSAI'S SCORE-TO-XP FACTOR IS ABOVE 0~GET:~THE RISE IN SCORE BECOMES XP, SHARED AMONG THE KILLS OF THE LAST 2 SECONDS BY EACH VICTIM'S STARTING HEALTH; EACH SHARE GOES TO THE WEAPON THAT MADE THAT KILL, A THROW'S SHARE TO THE PLAYER POOL~NEEDS:~GUN BONSAI'S SCORE-TO-XP FACTOR ABOVE 0 (GUN BONSAI'S OWN OPTION)");
		r.Push("||HOLD WEAPONS WITH DUAL HUD OFF|||||DO:~HOLD WEAPONS WITH DUAL HUD OFF~GET:~ONE GAUGE AT GUN BONSAI'S OWN HUD POSITION, FOR THE MAIN HAND'S WEAPON; FOR THE OTHER HAND'S WHEN THE MAIN HAND IS EMPTY~NEEDS:~DUAL HUD: OFF (DEFAULT ON); SINGLE HUD FOLLOWS: MAIN HAND (DEFAULT)");
		r.Push("||THE SAME, WITH SINGLE HUD FOLLOWS CHANGED|||||DO:~THE SAME, WITH SINGLE HUD FOLLOWS CHANGED~GET:~THE ONE GAUGE SHOWS THE OFF HAND'S WEAPON, OR THE WEAPON OF THE HAND THAT LAST EARNED XP~NEEDS:~DUAL HUD: OFF (DEFAULT ON); SINGLE HUD FOLLOWS: OFF HAND OR LAST XP (DEFAULT MAIN HAND)");
		r.Push("||PRESS THE INFO KEY WITH GBOVR MENUS AND HUD OFF|||||DO:~PRESS THE INFO KEY WITH GBOVR MENUS AND HUD OFF~GET:~GUN BONSAI'S OWN LIST MENUS OPEN IN PLACE OF THIS MOD'S SCREENS. ITS STATUS MENU SHOWS ONE HAND'S WEAPON, SAYS MAINHAND OR OFFHAND AND \"PRESS AGAIN FOR OTHER HAND\"; EACH PRESS OF THE INFO KEY FROM PLAY STEPS TO THE OTHER HAND. NO AMMO AND HEALTH ROW IS DRAWN AND THE BARS DO NOT PULSE~NEEDS:~GBOVR MENUS AND HUD: OFF (DEFAULT ON)");
		r.Push("||HOLD A WEAPON WITH THAT HAND'S COLOUR CYCLE OFF|||||DO:~HOLD A WEAPON WITH THAT HAND'S COLOUR CYCLE OFF~GET:~THAT HAND'S GAUGE KEEPS GUN BONSAI'S OWN COLOURS, AND CYCLES ONLY WHILE A LEVEL WAITS~NEEDS:~MAIN HUD COLOUR CYCLE OR OFF HUD COLOUR CYCLE: OFF (DEFAULT ON)");
		r.Push("||PICK UP A LEGENDOOM POWER WITH LEGENDOOM CARD OFF|||||DO:~PICK UP A LEGENDOOM POWER WITH LEGENDOOM CARD OFF~GET:~LEGENDOOM'S OWN PICKUP SCREEN SHOWS; NO CARD~NEEDS:~LEGENDOOM CARD: OFF (DEFAULT ON)");
		r.Push("||HOLD A LEGENDOOM GUN WITH LEGENDOOM GAUGE ROW OFF|||||DO:~HOLD A LEGENDOOM GUN WITH LEGENDOOM GAUGE ROW OFF~GET:~NO ROW UNDER THE GAUGE~NEEDS:~LEGENDOOM GAUGE ROW: OFF (DEFAULT ON)");
		r.Push("||PLAY LEFT-HANDED|||||DO:~PLAY LEFT-HANDED~GET:~THE TWO GAUGES SWAP SIDES (THE MAIN HAND'S ON THE LEFT) AND SO DO THE AMMO COUNTERS~NEEDS:~QUESTZDOOM'S OWN LEFT-HANDED CONTROL SCHEME");
	}

	// RSQ Monsters (Monsters/README.md)
	static void RowsMonsters(out Array<String> r)
	{
		r.Push("||START A MAP WITH BRUTAL DOOM LOADED|||||DO:~START A MAP WITH BRUTAL DOOM LOADED~GET:~BRUTAL DOOM'S AND XMVE'S OWN MONSTERS SPAWN AS THEIR MODS SHIP THEM (NOTHING REPLACES THEM); EACH ONE WITH A DOOM FAMILY GETS A TIER KIT AT THE MONSTER TIER'S COLOUR. AT COMMON THE KIT CHANGES NOTHING~NEEDS:~MONSTER SET: BD22 XMVE (DEFAULT)");
		r.Push("||START A MAP WITHOUT BRUTAL DOOM LOADED|||||DO:~START A MAP WITHOUT BRUTAL DOOM LOADED~GET:~DOOM'S OWN MONSTERS SPAWN, WITH THE SAME KITS~NEEDS:~MONSTER SET: BD22 XMVE (DEFAULT)");
		r.Push("||SET MONSTER TIER|||||DO:~SET MONSTER TIER (COMMON TO RED)~GET:~WITHIN 8 TICS EVERY KIT MONSTER AND EVERY COLORFULHELL MONSTER ON THE MAP STARTS ITS TIER FLASH AND MOVES BY THE SAME NUMBER OF COLOURS; MONSTERS SPAWNED LATER COME AT THE NEW COLOUR~NEEDS:~TIERS: ON (DEFAULT)");
		r.Push("||WATCH A MONSTER CHANGE TIER|||||DO:~WATCH A MONSTER CHANGE TIER~GET:~FOR 5 TO 25 TICS (EACH PICKS ITS OWN WAIT, SO A ROOM RIPPLES) IT SHOWS, EVERY 3 TICS, THE COLOUR IT IS BECOMING, FULL BRIGHT, THEN ITS OWN. THEN IT CHANGES. A SECOND CHANGE ASKED WHILE IT FLASHES STARTS THE WAIT AGAIN");
		r.Push("||FIGHT A KIT MONSTER ABOVE COMMON|||||DO:~FIGHT A KIT MONSTER ABOVE COMMON~GET:~MORE HEALTH, RISING EVENLY TO X2.5 AT RED (CACODEMON X2.08, LOST SOUL X2.4, ARACHNOTRON X2.0); MORE DAMAGE, FROM X1.11 AT GREEN TO X1.83 AT RED; SPEED NEVER LOWER (X1.0 TO X1.5 AT RED, BY FAMILY); IT FLINCHES LESS~NEEDS:~MONSTER SET: BD22 XMVE (DEFAULT)");
		r.Push("||LOOK AT A KIT MONSTER ABOVE COMMON|||||DO:~LOOK AT A KIT MONSTER ABOVE COMMON~GET:~IT IS DRAWN FROM THE PAINTED FRAME FOR ITS COLOUR WHERE ONE EXISTS, ELSE IT WEARS THE COLOUR'S TINT~NEEDS:~PAINTED COLOUR ART: ON (DEFAULT); THE FRAMES: RSQ_BDXMTIERS_<COLOUR>.PK3 LOADED");
		r.Push("||KILL A COLOURED KIT MONSTER|||||DO:~KILL A COLOURED KIT MONSTER~GET:~ITS CORPSE, CRAWLER, LAST STAND, LIMBS AND GIBS KEEP ITS COLOUR. BLOOD, SMOKE, FIRE, SPARKS, CASINGS AND PICKUPS KEEP THEIR OWN LOOK");
		r.Push("||DO A BRUTAL DOOM FATALITY ON A COLOURED MONSTER|||||DO:~DO A BRUTAL DOOM FATALITY ON A COLOURED MONSTER~GET:~THE GORE AND CORPSE YOU THROW KEEP THE VICTIM'S COLOUR, AND YOUR FATALITY FRAMES ARE DRAWN FROM THE PAINTED ART IN THAT COLOUR~NEEDS:~BRUTAL DOOM; PAINTED COLOUR ART: ON (DEFAULT)");
		r.Push("||FIGHT A GREEN KIT MONSTER|||||DO:~FIGHT A GREEN KIT MONSTER~GET:~ITS SHOTS LEAVE A 3 S ACID PATCH WHERE THEY LAND, AND ITS HITS LEAVE ONE UNDER WHAT THEY HIT (ONE A SECOND AT MOST). STANDING IN IT COSTS 5 HEALTH A SECOND~NEEDS:~MONSTER TIER GREEN");
		r.Push("||FIGHT A BLUE KIT MONSTER|||||DO:~FIGHT A BLUE KIT MONSTER~GET:~ITS SHOTS FLY 20% FASTER AND ZAP WHERE THEY LAND: 8 DAMAGE TO YOU WITHIN 48 UNITS (PLUS YOUR WIDTH), IN SIGHT OF THE SPOT~NEEDS:~MONSTER TIER BLUE");
		r.Push("||FIGHT A PURPLE KIT MONSTER|||||DO:~FIGHT A PURPLE KIT MONSTER~GET:~EACH ATTACK FIRES ONE MORE SHOT, 6 DEGREES TO ONE SIDE~NEEDS:~MONSTER TIER PURPLE");
		r.Push("||FIGHT A CYAN KIT MONSTER|||||DO:~FIGHT A CYAN KIT MONSTER~GET:~ITS SHOTS ARE ICE; A HIT SLOWS YOU TO HALF SPEED FOR 1 S. WHEN YOUR AIM IS ON IT (WITHIN 6 DEGREES, 1536 UNITS) IT MAY HOP SIDEWAYS (4 TRIES IN 10, EVERY 20 TICS). ICE DOES A FIFTH TO IT; FIRE AND MELEE DO X1.5~NEEDS:~MONSTER TIER CYAN");
		r.Push("||FIGHT A BROWN KIT MONSTER|||||DO:~FIGHT A BROWN KIT MONSTER~GET:~EVERY 3 S EVERY OTHER MONSTER ON ITS SIDE WITHIN 512 UNITS GETS 5% OF ITS FULL HEALTH BACK, AND THE NEAREST ONE GETS A 2 S SHIELD THAT HALVES WHAT IT TAKES (TAN SPARKS)~NEEDS:~MONSTER TIER BROWN");
		r.Push("||FIGHT A YELLOW KIT MONSTER|||||DO:~FIGHT A YELLOW KIT MONSTER~GET:~ITS SHOTS LEAVE A 2 S FLAME PATCH WHERE THEY LAND, AND ITS HITS SET YOU ALIGHT: 2 FIRE DAMAGE EVERY 10 TICS FOR 2 S. FIRE DOES HALF TO IT; ICE DOES X1.2~NEEDS:~MONSTER TIER YELLOW");
		r.Push("||FIGHT A FIREBLU KIT MONSTER|||||DO:~FIGHT A FIREBLU KIT MONSTER~GET:~EVERY SHOT HAS A BLUE TWIN 4 DEGREES OFF. FIRE DOES A QUARTER TO IT. WHEN IT DIES IT BLASTS 64 DAMAGE OVER 128 UNITS~NEEDS:~MONSTER TIER FIREBLU");
		r.Push("||FIGHT A GRAY KIT MONSTER|||||DO:~FIGHT A GRAY KIT MONSTER~GET:~STONE: X0.8 SPEED, NEVER FLINCHES, TAKES HALF FROM EXPLOSIONS AND 0.65 FROM EVERYTHING ELSE; ITS SHOTS ARE GREY~NEEDS:~MONSTER TIER GRAY");
		r.Push("||HURT A RED KIT MONSTER TO HALF HEALTH, OR INTO ITS PAIN FRAMES|||||DO:~HURT A RED KIT MONSTER TO HALF HEALTH, OR INTO ITS PAIN FRAMES~GET:~IT RAGES: X1.4 SPEED, NEVER FLINCHES, ATTACKS FAR MORE OFTEN, RED SPARKS. ICE DOES X1.4 TO IT. WHEN IT DIES IT THROWS 3 TO 5 RED BOLTS (3 DAMAGE EACH)~NEEDS:~MONSTER TIER RED");
		r.Push("||KILL A MONSTER THAT CAME FROM A COLOURED ONE|||||DO:~KILL A MONSTER THAT CAME FROM A COLOURED ONE~GET:~A MONSTER CALLED IN BY ANOTHER (ITS MASTER), OR A LOST SOUL BORN WITHIN 128 UNITS OF A KIT PAIN ELEMENTAL, TAKES THE HIGHER OF ITS OWN COLOUR AND ITS SUMMONER'S");
		r.Push("||KILL A MONSTER THAT RISES OUT OF A COLOURED BODY MID-MAP|||||DO:~KILL A MONSTER THAT RISES OUT OF A COLOURED BODY MID-MAP~GET:~A DEATH STAGE, OR THE SAME FAMILY BORN AGAIN ON THE SPOT, TAKES THE BODY'S COLOUR, NOT THE MONSTER TIER'S");
		r.Push("||KILL A COLORFULHELL MONSTER WITH ICE|||||DO:~KILL A COLORFULHELL MONSTER WITH ICE~GET:~IT DIES ITS OWN DEATH; NO MONSTER OF THIS MOD IS LEFT STANDING AS A FROZEN STATUE");
		r.Push("||CHANGE A COLORFULHELL MONSTER'S TIER|||||DO:~CHANGE A COLORFULHELL MONSTER'S TIER~GET:~ITS BODY IS SWAPPED FOR THAT COLOUR'S MONSTER. IT KEEPS THE SHARE OF HEALTH IT HAD LOST, ITS CHAMPIONS CHAMPION, ITS LEGENDOOM LEGENDARY, ITS UNIVERSAL ENTROPY SIZE AND ITS PLACE IN RSQ SCORE'S COUNT; IT DOES NOT COUNT AS A KILL~NEEDS:~ON TIER CHANGE: INSTANT FULL (DEFAULT): A FLASHED CHANGE KEEPS THE SHARE");
		r.Push("||RAISE THE MONSTER TIER WITH COLORFULHELL MONSTERS ABOUT|||||DO:~RAISE THE MONSTER TIER WITH COLORFULHELL MONSTERS ABOUT~GET:~A BODY THAT GOT ITS COLOUR FROM A CHANGE STANDS ON ITS FAMILY'S LADDER HEALTH, SO NO STEP UP LOSES HEALTH (THE BLACK AND WHITE BOSSES KEEP THEIR OWN)");
		r.Push("||TAKE ON A BOSS FIGHT FROM RSQ MINIBOSS|||||DO:~TAKE ON A BOSS FIGHT FROM RSQ MINIBOSS~GET:~ITS BOSS AND THRALLS COME FROM COLOURFUL HELL'S ROSTER AT THE COLOURS THE FIGHT ASKS FOR; NOTHING IN THE FIGHT CHANGES TIER UNTIL THE FIGHT ENDS (NO FLASH, NO SWAP)~NEEDS:~RSQ MINIBOSS; BOSS FROM: COLORFULHELL (DEFAULT); THRALLS FROM: AS BOSS (DEFAULT)");
		r.Push("||MEET AN EX BOSS|||||DO:~MEET AN EX BOSS~GET:~\"A CHILL RUNS DOWN YOUR SPINE\" IS PRINTED AS ANY OF THE 16 EX BOSSES ARRIVES~NEEDS:~COLORFULHELL MONSTERS (A BOSS FIGHT'S BOSS AT BLACK OR WHITE, OR A RAISED SPAWN CAP)");
		r.Push("||FIGHT TIME TO DIE|||||DO:~FIGHT TIME TO DIE (THE WHITE ARCH-VILE EX)~GET:~UNDER 12,500 HEALTH (AN RSQ MINIBOSS BIG BOSS: FROM ITS SECOND LIFE) IT CAN STEAL: A WHITE FLASH, EVERY POINT OF YOUR ARMOUR TAKEN, 20 DAMAGE AND 10 S AT A QUARTER SPEED. AT ANY TIME IT CAN START END OF TIME: A COUNT OF 300 S ON SCREEN (300, 200, 100, 50, 20, THEN 10 TO 1) WITH A CLOCK AND QUAKES; AT ZERO IT CANNOT BE HURT, HOLDS YOU STILL AND FIRES UNTIL YOU DIE. KILLING IT ENDS THE COUNT~NEEDS:~COLORFULHELL MONSTERS");
		r.Push("||FACE A COLORFULHELL MONSTER'S RAILGUN|||||DO:~FACE A COLORFULHELL MONSTER'S RAILGUN~GET:~AFTER ITS OWN WIND-UP A GLOWING BEAM HEAD FLIES AT YOU AT NO MORE HITSCANS' SPEED (80 WITHOUT IT) AND THE BEAM GROWS BEHIND IT. ONLY THE HEAD HURTS: STEP OUT OF ITS PATH AND IT MISSES. RSQ SLOWMO SLOWS IT LIKE ANY SHOT~NEEDS:~COLORFULHELL MONSTERS");
		r.Push("||KILL A COLORFULHELL MONSTER|||||DO:~KILL A COLORFULHELL MONSTER~GET:~IT DROPS COLOURFUL HELL'S BUNDLES: HEALTH AND ARMOUR BONUSES, BACKPACKS, AMMO, WEAPONS, POWERUPS, ARMOUR, MEDIKITS, BY THE DROP SETTINGS (HEALTH DROPS ALSO SETS THE ARMOUR BONUSES)~NEEDS:~DROPS: STANDARD (DEFAULT)");
		r.Push("||OPEN TEST AND DEBUG, PICK FAMILY, PRESS A SPAWN ROW|||||DO:~OPEN TEST AND DEBUG, PICK FAMILY, PRESS A SPAWN ROW (C0001 TO A0003)~GET:~THAT MONSTER OF THE FAMILY STANDS 160 UNITS IN FRONT OF YOU, FACING YOU, DORMANT UNTIL WAKE; THE CONSOLE NAMES IT. A ROW THE FAMILY LACKS IS GREY~NEEDS:~SPAWN HOSTILE: OFF (DEFAULT)");
		r.Push("||PRESS SPAWN ALL|||||DO:~PRESS SPAWN ALL~GET:~THE WHOLE FAMILY IN A LINE, 72 UNITS APART");
		r.Push("||PRESS WAKE|||||DO:~PRESS WAKE~GET:~THE SPAWNED MONSTERS WAKE AND COME FOR YOU");
		r.Push("||PRESS DIAGNOSE|||||DO:~PRESS DIAGNOSE~GET:~ONE CONSOLE LINE FOR EACH SPAWNED MONSTER: ITS CLASS, NAME, HEALTH, LADDER TIER");
		r.Push("||PRESS REMOVE ALL|||||DO:~PRESS REMOVE ALL~GET:~EVERY MONSTER THE ROWS SPAWNED IS REMOVED; NONE COUNTS AS A KILL");
		r.Push("||LOOK AT A MONSTER AND PRESS WHAT IS IT|||||DO:~LOOK AT A MONSTER AND PRESS WHAT IS IT~GET:~THE CONSOLE SAYS WHAT IT IS: A COLORFULHELL MONSTER'S FAMILY AND TIER (AND ITS PLACE PAST WHITE), A KIT MONSTER'S FAMILY, RUNG, ENTRY COLOUR, TIER AND EX STEPS, OR \"NOT ON THE LADDER\". THE AIMED MONSTER IS THE ONE YOUR VIEW MEETS, ELSE THE ONE A SHOT YOUR WAY WOULD TAKE");
		r.Push("||LOOK AT A MONSTER AND PRESS ONE TIER UP|||||DO:~LOOK AT A MONSTER AND PRESS ONE TIER UP~GET:~IT FLASHES AND GOES ONE COLOUR UP FROM THE COLOUR IT IS HEADING FOR (TWICE INSIDE ONE FLASH: TWO). A KIT MONSTER CAN PASS WHITE (EACH STEP PAST WHITE IS AN EX STEP); A COLORFULHELL MONSTER STOPS AT WHITE. A BOSS FIGHT'S MONSTER REFUSES");
		r.Push("||PRESS MAP ONE TIER UP|||||DO:~PRESS MAP ONE TIER UP~GET:~EVERY LIVING MONSTER ON THE LADDER GOES ONE COLOUR UP, EACH THROUGH ITS FLASH");
		r.Push("||PRESS GOD MODE|||||DO:~PRESS GOD MODE (TEST AND DEBUG)~GET:~THE ENGINE'S GOD MODE, ON OR OFF");
		r.Push("||FIGHT AN ABYSS KIT MONSTER|||||DO:~FIGHT AN ABYSS KIT MONSTER~GET:~EVERY HIT TURNS IT SEE-THROUGH FOR 1 S, AND WHILE IT IS, HALF OF WHAT HITS IT PASSES THROUGH. EVERY 6 TO 10 S IT STEPS OUT BESIDE OR BEHIND YOU (TELEPORT FOG). IT DIES ONCE AND RISES AGAIN 3 S LATER IF ITS BODY CAN~NEEDS:~A TIER CHANGE PAST RED (ONE TIER UP, OR ANOTHER MOD'S ASK)");
		r.Push("||FIGHT A BLACK KIT MONSTER|||||DO:~FIGHT A BLACK KIT MONSTER~GET:~TAKES 0.6 OF EVERY HIT, NEVER FLINCHES; AT HALF HEALTH TWO MORE OF ITS KIND ARRIVE BESIDE IT AT THE MONSTER TIER'S COLOUR. WHEN IT DIES: 8 BOLTS AND A DARK BURST~NEEDS:~A TIER CHANGE PAST RED");
		r.Push("||FIGHT A WHITE KIT MONSTER|||||DO:~FIGHT A WHITE KIT MONSTER~GET:~AS BLACK, AND IT STEPS OUT BESIDE OR BEHIND YOU EVERY 8 TO 12 S, AND CALLS TWO MORE AGAIN AT A QUARTER HEALTH~NEEDS:~A TIER CHANGE PAST RED");
		r.Push("||PUSH A KIT MONSTER PAST WHITE|||||DO:~PUSH A KIT MONSTER PAST WHITE~GET:~EACH STEP PAST WHITE IS AN EX STEP: +10% HEALTH AND +5% DAMAGE EACH; IT IS A WHITE, AND IT ALSO RAGES AS RED AND PHASES AS ABYSS~NEEDS:~ONE TIER UP, OR ANOTHER MOD'S ASK");
		r.Push("||SET MONSTER SET TO COLORFULHELL|||||DO:~SET MONSTER SET TO COLORFULHELL~GET:~FROM THE NEXT MAP (OR A RESTART) EVERY DOOM MONSTER IS COLOURFUL HELL'S. WITH THE SPAWN CAPS AT THEIR DEFAULT (COMMON) EVERY SPAWN IS THE COMMON ONE, THEN RAISED BY THE MONSTER TIER; DOOM'S PROJECTILES OF SIX MONSTERS BECOME COLOURFUL HELL'S~NEEDS:~MONSTER SET: COLORFULHELL (DEFAULT BD22 XMVE)");
		r.Push("||SET MONSTER TIER TO CYAN, BROWN, FIREBLU OR GRAY WITH COLORFULHELL MONSTERS|||||DO:~SET MONSTER TIER TO CYAN, BROWN, FIREBLU OR GRAY WITH COLORFULHELL MONSTERS~GET:~THE COLOUR IS STEPPED PAST WHILE IT IS OFF: CYAN AND BROWN COME AS YELLOW, FIREBLU AND GRAY AS RED. A COLOUR SWITCHED OFF IS NEVER STEPPED INTO BLACK OR WHITE~NEEDS:~MONSTER SET: COLORFULHELL; EXTRA COLOURS: OFF (DEFAULT)");
		r.Push("||RAISE A FAMILY'S SPAWN CAP|||||DO:~RAISE A FAMILY'S SPAWN CAP (TEST AND DEBUG, COLORFULHELL SPAWN CAPS)~GET:~THAT FAMILY ROLLS COLOURFUL HELL'S OWN WEIGHTS UP TO THAT COLOUR, THEN THE MONSTER TIER RAISES THE ROLL; 13 IS THE FAMILY'S WHOLE ROLL, BLACK, WHITE AND EX BOSSES INCLUDED~NEEDS:~MONSTER SET: COLORFULHELL; CAPS ON: ON (DEFAULT)");
		r.Push("||SET EXTRA COLOURS TO ON OR HALF|||||DO:~SET EXTRA COLOURS TO ON OR HALF~GET:~CYAN, BROWN, ABYSS, FIREBLU AND GRAY SPAWN (HALF: CYAN, BROWN AND ABYSS HALF AS OFTEN) AND ARE NO LONGER STEPPED PAST~NEEDS:~MONSTER SET: COLORFULHELL (DEFAULT OFF)");
		r.Push("||SET BLACK BOSS OR WHITE BOSS TO OFF|||||DO:~SET BLACK BOSS OR WHITE BOSS TO OFF~GET:~A BLACK BOSS COMES AS RED; A WHITE ONE AS BLACK (RED WITH BOTH OFF). THIS HOLDS FOR SPAWNS, TIER CHANGES AND RSQ MINIBOSS'S PICKS~NEEDS:~(DEFAULT ON)");
		r.Push("||SET EX BOSSES|||||DO:~SET EX BOSSES~GET:~HOW OFTEN A BLACK OR WHITE BOSS THAT HAS AN EX FORM COMES AS IT: NEVER, RARE (24 IN 256, DEFAULT), HALF, ALWAYS~NEEDS:~COLORFULHELL MONSTERS");
		r.Push("||SET DROPS TO SCARCE, GENEROUS OR NONE|||||DO:~SET DROPS TO SCARCE, GENEROUS OR NONE~GET:~WRITES THE SEVEN DROP SETTINGS AT ONCE (TEST AND DEBUG SHOWS EACH; THE ROW READS CUSTOM WHEN THEY MATCH NONE)~NEEDS:~(DEFAULT STANDARD)");
		r.Push("||SET WHITE ARACHNOTRON BOSS, BLACK LOST SOUL BOSS OR WHITE MASTERMIND BOSS|||||DO:~SET WHITE ARACHNOTRON BOSS, BLACK LOST SOUL BOSS OR WHITE MASTERMIND BOSS~GET:~WHICH BODY THAT BOSS GETS: SPIDER (DEFAULT), OLD, FUSION OR NEW; QUEEN BEE (DEFAULT) OR OLD; ARMED (DEFAULT), EVERLASTING OR EITHER. A TIER CHANGE TO THAT COLOUR GIVES THE SAME PICK~NEEDS:~COLORFULHELL MONSTERS");
		r.Push("||TURN ON TIER ICONS|||||DO:~TURN ON TIER ICONS~GET:~THE TIER'S GEM (COMMON A TO WHITE M) FLOATS UP OFF EACH MONSTER AND SHOWS FOR 30 TICS: ONCE A SECOND OFF A KIT MONSTER, FROM ITS OWN LOOPS OFF A COLORFULHELL MONSTER~NEEDS:~TIER ICONS: ON (DEFAULT OFF)");
		r.Push("||TURN PAINTED COLOUR ART OFF|||||DO:~TURN PAINTED COLOUR ART OFF~GET:~KIT MONSTERS WEAR THE TINT ONLY~NEEDS:~PAINTED COLOUR ART: OFF (DEFAULT ON)");
		r.Push("||TURN TIERS OFF|||||DO:~TURN TIERS OFF~GET:~EVERY KIT STANDS DOWN TO ITS MOD'S OWN LOOK AND NUMBERS, AND THE MONSTER TIER COUNTS AS COMMON EVERYWHERE (COLORFULHELL SPAWNS, RSQ MINIBOSS'S FIGHTS); A BOSS WON OR LOST DOES NOT MOVE IT. ON AGAIN, EACH KIT GOES BACK, PLUS EVERY STEP MADE WHILE IT WAS OFF. MONSTERS SPAWNED WHILE IT WAS OFF GET A KIT ON THE NEXT MAP~NEEDS:~TIERS: OFF (DEFAULT ON)");
		r.Push("||CHANGE TIER WITH ON TIER CHANGE SET|||||DO:~CHANGE TIER WITH ON TIER CHANGE SET~GET:~KEEP SHARE: THE SHARE OF HEALTH LOST IS KEPT EVEN ON AN INSTANT CHANGE. ALWAYS FULL: FULL HEALTH AFTER EVERY CHANGE~NEEDS:~ON TIER CHANGE (DEFAULT INSTANT FULL)");
		r.Push("||SET CYAN MONSTERS DODGE, LEAD-AIMED SHOTS, RED BOSS FORM, ORANGE REVENANT, NORMAL ROCKET DAMAGE, ABYSS SHOT MARKERS|||||DO:~SET CYAN MONSTERS DODGE, LEAD-AIMED SHOTS, RED BOSS FORM, ORANGE REVENANT, NORMAL ROCKET DAMAGE, ABYSS SHOT MARKERS~GET:~COLOURFUL HELL'S OWN SWITCHES FOR ITS MONSTERS (TEST AND DEBUG, COLORFULHELL SWITCHES)~NEEDS:~COLORFULHELL MONSTERS");
		r.Push("||SET BOSS FROM OR THRALLS FROM|||||DO:~SET BOSS FROM OR THRALLS FROM~GET:~RSQ MINIBOSS TAKES ITS BOSS FROM THE MAP'S OWN MONSTERS (MONSTER SET) OR COLOURFUL HELL, AND ITS THRALLS AS THE BOSS, FROM COLOURFUL HELL, OR FROM THE MAP'S OWN MONSTERS~NEEDS:~RSQ MINIBOSS");
	}

	// RSQ Graveyards (Graveyard/README.md)
	static void RowsGraveyard(out Array<String> r)
	{
		r.Push("||DIE|||||DO:~DIE (PLAYING ALONE)~GET:~YOUR DEATH IS STORED: THE MAP, THE SPOT, \"HERE LIES <NAME>, KILLED BY <KILLER>.\", THE DATE AND THE MAP TIME. NO STONE YET: IT STANDS THERE FROM THE NEXT TIME THE MAP IS LOADED (A SAVED GAME, A RESTART, COMING BACK)");
		r.Push("||DIE IN A NETGAME|||||DO:~DIE IN A NETGAME~GET:~THE SAME, AND THE STONE STANDS AT ONCE ON EVERY MACHINE");
		r.Push("||ENTER A MAP WHERE PLAYERS DIED|||||DO:~ENTER A MAP WHERE PLAYERS DIED~GET:~A GRAVESTONE AT EACH SPOT, ONE OF FOUR TOMB PICTURES PICKED BY THE SPOT. STONES ALREADY STANDING IN A LOADED SAVE STAY AS THEY STOOD");
		r.Push("||WATCH THE STONES AS A MAP STARTS|||||DO:~WATCH THE STONES AS A MAP STARTS~GET:~EACH ONE POPS UP FROM TINY OVER 24 TICS, SWELLS TO 1.35 TIMES ITS SIZE AND SETTLES; THE WHOLE GRAVEYARD POPS OVER ABOUT ONE SECOND. A STONE MADE LATER POPS AT ONCE~NEEDS:~ANIMATE GRAVESTONES: ON (DEFAULT); POP IN ON SPAWN: ON (DEFAULT)");
		r.Push("||LOOK AT A STONE - ANIMATE GRAVESTONES: ON|||||DO:~LOOK AT A STONE~GET:~IT BREATHES: A SLOW SQUASH AND STRETCH, ABOUT ONE BREATH EVERY 7 SECONDS~NEEDS:~ANIMATE GRAVESTONES: ON (DEFAULT)");
		r.Push("||WALK WITHIN 640 MAP UNITS OF A STONE|||||DO:~WALK WITHIN 640 MAP UNITS OF A STONE~GET:~ITS CANDLE LIGHT FADES UP OVER 20 TICS (RADIUS 72) AND FLICKERS; WALK AWAY AND IT FADES OUT~NEEDS:~GRAVE LIGHT: ON (DEFAULT); CANDLE FLICKER: ON (DEFAULT)");
		r.Push("||LOOK AT THE STONES' COLOUR - LIVING STONES: ON|||||DO:~LOOK AT THE STONES' COLOUR~GET:~THE LIGHT AND THE STONE'S TINT BREATHE FROM COOL BLUE TO WARM YELLOW, ONE BREATH EVERY 2 SECONDS, ALL STONES TOGETHER~NEEDS:~LIVING STONES: ON (DEFAULT)");
		r.Push("||PRESS USE ON A STONE|||||DO:~PRESS USE ON A STONE~GET:~ITS WORDS FLOAT OVER IT FOR ABOUT 4 SECONDS: THE NAME, KILLED BY AND THE KILLER, THE DATE, MAP TIME. USE AGAIN AND THEY START AGAIN~NEEDS:~RSQ VISUALREWARDS, ITS MONSTER WORDS ON");
		r.Push("||PRESS USE ON A STONE, WITHOUT THOSE WORDS|||||DO:~PRESS USE ON A STONE, WITHOUT THOSE WORDS~GET:~THE OBITUARY IS PRINTED IN THE CONSOLE, ON YOUR MACHINE ONLY");
		r.Push("||PRESS REMOVE MAP GRAVESTONES|||||DO:~PRESS REMOVE MAP GRAVESTONES (OPTIONS > RADIANT SILVERGUN OPTIONS > RSQ GRAVEYARDS, CONTROLS)~GET:~EVERY STONE ON THIS MAP IS TAKEN AWAY AND FORGOTTEN; THE CONSOLE SAYS \"GRAVESTONES ON THIS MAP ARE REMOVED.\"");
		r.Push("||PRESS REMOVE ALL GRAVESTONES|||||DO:~PRESS REMOVE ALL GRAVESTONES (SAME PAGE)~GET:~EVERY STONE ON THIS MAP GOES AND EVERY STORED STONE ON EVERY MAP IS FORGOTTEN; THE CONSOLE SAYS \"ALL GRAVESTONES ARE REMOVED.\"");
		r.Push("||DIE MORE THAN 200 TIMES ON ONE MAP|||||DO:~DIE MORE THAN 200 TIMES ON ONE MAP~GET:~THE OLDEST STONES OF THAT MAP ARE FORGOTTEN AND TAKEN OFF THE MAP, SO 200 STAND AT MOST");
		r.Push("||LOSE AN EXTRA LIFE IN RSQ SCORE|||||DO:~LOSE AN EXTRA LIFE IN RSQ SCORE (IT CATCHES THE KILLING BLOW)~GET:~A GOLD STONE STANDS WHERE YOU WERE, AT ONCE: \"HERE <NAME> LOST A LIFE, KILLED BY <KILLER>.\" IT HAS A STRONGER, STEADIER GOLD CANDLE WITH A SECOND LIGHT IN IT~NEEDS:~RSQ SCORE");
		r.Push("||KILL A BRUTAL DOOM, XMVE OR PLAIN DOOM MONSTER - BONES BRIDGE: ON|||||DO:~KILL A BRUTAL DOOM, XMVE OR PLAIN DOOM MONSTER~GET:~NOW AND THEN (15 TIMES IN 100, ROLLED AT THE DEATH, WITH NO SIGN WHICH), AFTER LEGION OF BONES' DEATH ANIMATION AND A DELAY OF 0, 5, 10, 15 OR 20 SECONDS PICKED AT THE DEATH, ITS LEGION OF BONES UNDEAD RISES FROM THE CORPSE WITH FIRE AND THE TELEPORT SOUND, AND COMES FOR WHOEVER KILLED IT. THE CORPSE GOES. A LOSER STAYS DEAD FOR GOOD~NEEDS:~LEGION OF BONES; BONES BRIDGE: ON (DEFAULT); RISE CHANCE (DEFAULT 15); RANDOM DELAY: ON (DEFAULT)");
		r.Push("||STAND ON A CORPSE WHEN ITS RISE IS DUE - WHAT STOPS A RISE: SOMETHING ON IT|||||DO:~STAND ON A CORPSE (OR ANYTHING SOLID DOES) WHEN ITS RISE IS DUE~GET:~THE WAIT STARTS AGAIN (AT LEAST 1 SECOND). AFTER 4 SUCH HOLDS IT RISES AT THE NEAREST FREE SPOT BESIDE THE CORPSE, OR STAYS DEAD IF THERE IS NONE~NEEDS:~LEGION OF BONES; WHAT STOPS A RISE: SOMETHING ON IT (DEFAULT)");
		r.Push("||KILL ONE OF LEGION OF BONES' OWN MONSTERS THAT RISE AGAIN|||||DO:~KILL ONE OF LEGION OF BONES' OWN MONSTERS THAT RISE AGAIN~GET:~THE SAME ROLL: A LOSER'S CORPSE STAYS FOR GOOD; A WINNER RISES LEGION OF BONES' OWN WAY AFTER ITS OWN PICKED DELAY. THIS HAPPENS WITH BONES BRIDGE OFF TOO~NEEDS:~LEGION OF BONES; RISE CHANCE (DEFAULT 15); RANDOM DELAY: ON (DEFAULT)");
		r.Push("||LOOK AT A STONE - ANIMATE GRAVESTONES: OFF|||||DO:~LOOK AT A STONE~GET:~IT STANDS STILL AT FULL SIZE~NEEDS:~ANIMATE GRAVESTONES: OFF (DEFAULT ON)");
		r.Push("||WATCH A MAP START|||||DO:~WATCH A MAP START~GET:~STONES APPEAR AT FULL SIZE, NO POP~NEEDS:~POP IN ON SPAWN: OFF (DEFAULT ON)");
		r.Push("||WALK UP TO A STONE|||||DO:~WALK UP TO A STONE~GET:~NO CANDLE LIGHT~NEEDS:~GRAVE LIGHT: OFF (DEFAULT ON)");
		r.Push("||WATCH A CANDLE|||||DO:~WATCH A CANDLE~GET:~IT BURNS STEADY~NEEDS:~CANDLE FLICKER: OFF (DEFAULT ON)");
		r.Push("||LOOK AT THE STONES' COLOUR - LIVING STONES: OFF|||||DO:~LOOK AT THE STONES' COLOUR~GET:~STONES KEEP THEIR OWN COLOUR AND A WARM CANDLE; A GOLD STONE IS TINTED GOLD WITH AN AMBER CANDLE~NEEDS:~LIVING STONES: OFF (DEFAULT ON)");
		r.Push("||LOOK AT THE STONES' COLOUR - LIVING STONES MODE: WAVE|||||DO:~LOOK AT THE STONES' COLOUR~GET:~THE BREATH RUNS ACROSS THE STONES AS A WAVE BY THEIR DISTANCE FROM YOU, ONE BREATH PER 512 MAP UNITS~NEEDS:~LIVING STONES MODE: WAVE (DEFAULT UNIFORM)");
		r.Push("||LOOK AT THE STONES' COLOUR - LIVING STONES MODE: CHAOS|||||DO:~LOOK AT THE STONES' COLOUR~GET:~EACH STONE BREATHES AT ITS OWN PACE (0.55 TO 1.6 TIMES) FROM ITS OWN START~NEEDS:~LIVING STONES MODE: CHAOS (DEFAULT UNIFORM)");
		r.Push("||STAND ON A CORPSE WHEN ITS RISE IS DUE - WHAT STOPS A RISE: NOTHING|||||DO:~STAND ON A CORPSE WHEN ITS RISE IS DUE~GET:~IT RISES ANYWAY, ON TIME~NEEDS:~LEGION OF BONES; WHAT STOPS A RISE: NOTHING (DEFAULT SOMETHING ON IT)");
		r.Push("||KILL A MONSTER THAT RISES|||||DO:~KILL A MONSTER THAT RISES~GET:~IT WAITS LEGION OF BONES' OWN RESPAWN DELAY (ITS MENU)~NEEDS:~LEGION OF BONES; RANDOM DELAY: OFF (DEFAULT ON)");
		r.Push("||KILL A BRUTAL DOOM, XMVE OR PLAIN DOOM MONSTER - BONES BRIDGE: OFF|||||DO:~KILL A BRUTAL DOOM, XMVE OR PLAIN DOOM MONSTER~GET:~IT STAYS DEAD. LEGION OF BONES' OWN MONSTER SWAPS RUN AS LEGION OF BONES SHIPS THEM~NEEDS:~LEGION OF BONES; BONES BRIDGE: OFF (DEFAULT ON)");
	}

	// RSQ Play Log (PlayLog/README.md)
	static void RowsPlayLog(out Array<String> r)
	{
		r.Push("||TURN ON RECORD PLAY LOG|||||DO:~TURN ON RECORD PLAY LOG (OPTIONS > RSQ PLAY LOG)~GET:~FROM NOW ON THE LINES BELOW ARE WRITTEN TO THE CONSOLE~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||PRESS START LOG FILE|||||DO:~PRESS START LOG FILE (SAME PAGE)~GET:~THE ENGINE'S LOGFILE RSQPLAY.TXT RUNS: EVERYTHING THE CONSOLE PRINTS FROM NOW IS COPIED INTO RSQPLAY.TXT (THE TIP SAYS: IN THE GAME'S OWN FOLDER; PRESSING IT AGAIN STARTS THE FILE OVER)");
		r.Push("||PRESS STOP LOG FILE|||||DO:~PRESS STOP LOG FILE~GET:~THE ENGINE'S LOGFILE RUNS: THE COPYING STOPS");
		r.Push("||START A MAP|||||DO:~START A MAP~GET:~MAP: THE MAP'S LUMP, ITS TITLE, HOW MANY MONSTERS, THE SKILL. NOT ON LOADING A SAVED GAME~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||LEAVE A MAP|||||DO:~LEAVE A MAP~GET:~END: THE SECONDS SPENT, KILLS OF TOTAL, HOW MANY TIMES YOU DIED~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||SWING EITHER HAND FASTER THAN 1.0 M/S AGAINST YOUR BODY, THEN SLOW IT UNDER 0.6 M/S FOR 2 TICS|||||DO:~SWING EITHER HAND FASTER THAN 1.0 M/S AGAINST YOUR BODY, THEN SLOW IT UNDER 0.6 M/S FOR 2 TICS~GET:~SWING: WHICH HAND (MAIN OR OFF), ITS TOP SPEED IN M/S, HOW MANY TICS, HOW MUCH OF IT WENT AHEAD OF YOU AND HOW MUCH UP, THE WEAPON THAT HAND HOLDS, AND \"THROW-FAST\" WHEN THE TOP SPEED REACHED 2.2 M/S~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF); VR HANDS");
		r.Push("||BRING THE OFF HAND WITHIN 0.8 M OF YOUR EYES|||||DO:~BRING THE OFF HAND WITHIN 0.8 M OF YOUR EYES~GET:~WRIST EVERY 7 TICS AND ON EVERY CHANGE: THE WATCH CHECK AND THE PULSE CHECK FOR THE OFF HAND, AND WHY EACH ONE'S POSE IS NOT MET~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF); VR HANDS; RSQ GUN CARDS");
		r.Push("||KILL A MONSTER|||||DO:~KILL A MONSTER (YOU ARE THE ONE IT WAS FIGHTING)~GET:~KILL: THE MONSTER, ITS SPAWN HEALTH, WHAT KILLED IT (THE PROJECTILE OR PUFF, ELSE YOUR MAIN HAND'S WEAPON), HOW FAR IN METRES, THE DAMAGE TYPE~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||GET HURT|||||DO:~GET HURT~GET:~HURT: HOW MUCH, BY WHAT, THE DAMAGE TYPE, THE HEALTH LEFT~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||DIE|||||DO:~DIE~GET:~DIED: BY WHAT, AND THE MONSTER THAT WAS FIGHTING YOU~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||PLAY ON|||||DO:~PLAY ON~GET:~FPS ONCE A SECOND: HOW MANY TIMES THE SCREEN WAS DRAWN AND THE LONGEST WAIT BETWEEN TWO DRAWS IN MS. HITCH FOR EACH WAIT OF 50 MS OR MORE, AT MOST 3 A SECOND~NEEDS:~RECORD PLAY LOG: ON (DEFAULT OFF)");
		r.Push("||PRESS RESET ALL|||||DO:~PRESS RESET ALL~GET:~RECORD PLAY LOG GOES BACK TO OFF");
	}
}
