+// gl_openvr_fake.h -- a FAKE OpenVR runtime for headless testing on Windows (RSQ_UBQSeries/TestRig, 2026-11-03).
+//
+// The OpenVR mode (gl_openvr.cpp, vr_mode 10) talks to SteamVR through four C function tables. With
+// `-qzfake` on the command line (or the environment variable QZ_FAKE=1) it takes these tables instead,
+// which answer from console cvars, so the headset and both controllers can be posed from a script with no
+// runtime and no hardware -- the Windows twin of the Linux rig's qz_linux_glue.cpp (RSQ_WeaponDepot
+// tools/rig), with the same cvar names, so the rig's probes port over:
+//   qz_hmd   "x y z pitch yaw roll"   default "0 1.6 0 0 0 0"        (metres, degrees; OpenVR stage space:
+//   qz_rhand "x y z pitch yaw roll"   default "0.25 1.3 -0.3 60 0 0"   +X right, +Y up, -Z forward)
+//   qz_lhand "x y z pitch yaw roll"   default "-0.25 1.3 -0.3 60 0 0"
+//   qz_rtrigger / qz_rgrip / qz_ltrigger / qz_lgrip   0..1 (over 0.5 = pressed)
+//   qz_rbuttons / qz_lbuttons   extra raw OpenVR button bits (k_EButton_A = 1<<7, ApplicationMenu = 1<<1, ...)
+//   qz_rstick / qz_lstick "x y"   thumbstick axes
+// Pitch is about +X (positive = up), yaw about +Y (positive = left), roll about -Z. Numbers may also be split by
+// colons ("0.25:1.3:-0.3:60:0:0") so a value can pass through a launcher's quoting. A hand pitch of +60 aims the
+// in-game weapon LEVEL on this (OpenVR) path -- measured 2026-11-03: raw 30 read as AttackPitch -30, raw 0 as -60
+// (the Linux OpenXR glue's +30 does not carry over). Poses are read each render frame; read a result 2+ tics later.
+// Everything downstream of the tables -- AttackPos/Angle/Pitch/Roll, OffhandPos/..., the weapon and off-hand
+// transforms, haptics, the overlay -- is the mode's own code, untouched. Nothing changes without -qzfake.
+#pragma once
+
+namespace openvr {
+	struct VR_IVRSystem_FnTable;
+	struct VR_IVRCompositor_FnTable;
+	struct VR_IVROverlay_FnTable;
+	struct VR_IVRRenderModels_FnTable;
+}
+
+bool QZ_FakeVR();   // -qzfake on the command line, or QZ_FAKE=1 in the environment (decided once)
+openvr::VR_IVRSystem_FnTable* QZ_FakeSystem();
+openvr::VR_IVRCompositor_FnTable* QZ_FakeCompositor();
+openvr::VR_IVROverlay_FnTable* QZ_FakeOverlay();
+openvr::VR_IVRRenderModels_FnTable* QZ_FakeRenderModels();
