# working pk3s inside the mod folders are build output; only pk3/ is kept
*.pk3
!pk3/*.pk3
# owner 2026-11-13: each weapon set's pk3 lives in its own weaponsets/ folder until it is 1.0
!weaponsets/*/*.pk3

# agent worktrees (temporary, never committed)
.claude/
__pycache__/
*.pyc

# tools/rig: the Linux QuestZDoom 17.3 test rig (moved here from RS_ModelSwapper, 2026-11-27).
# The engine's own pk3s ARE kept; what a run or a build writes is not.
!tools/rig/bin/*.pk3
!tools/rig/bin/res/*.pk3
tools/rig/build/
tools/rig/runs/
tools/rig/bin/libGLESv3.so
tools/rig/bin/saves/
