	// src 0 the voxel pack's keys, 1 Freedoom's; type 0-2 red / yellow / blue keycard, 3-5 the skulls; var 1: a skull
	// placed after the keycards; dim: not held (dark grey)
	static State Key(int src, int fam, int type, int after, int dim)
	{
		if (src < 0 || src > 1 || fam < 0 || fam > 3 || type < 0 || type > 5) return null;
		let d = GetDefaultByType("RSQGC_SideStatesB");
		State st = null;
		switch (src * 4 + fam)
		{
		case 0: st = d.FindState("K00"); break;
		case 1: st = d.FindState("K01"); break;
		case 2: st = d.FindState("K02"); break;
		case 3: st = d.FindState("K03"); break;
		case 4: st = d.FindState("K10"); break;
		case 5: st = d.FindState("K11"); break;
		case 6: st = d.FindState("K12"); break;
		case 7: st = d.FindState("K13"); break;
		}
		return Walk(st, (type * 2 + (after ? 1 : 0)) * 2 + (dim ? 1 : 0));
	}
	static double RowY(int row, int fam)
	{
		if (row < 0 || row >= ROWS || fam < 0 || fam > 3) return 0;
		return RSQGC_SideStates.ROW_Y[row * 4 + fam];
	}
	static State Panel(int fam, int hi)
	{
		let d = GetDefaultByType("RSQGC_SideStatesB");
		State st = null;
		switch (fam)
		{
		case 0: st = d.FindState("P0"); break;
		case 1: st = d.FindState("P1"); break;
		case 2: st = d.FindState("P2"); break;
		case 3: st = d.FindState("P3"); break;
		}
		return Walk(st, hi);
	}
}
