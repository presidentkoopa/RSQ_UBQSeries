	private static State Walk(State s, int n) { for (int i = 0; i < n && s; i++) s = s.NextState; return s; }
	static int Adv(int code) { return code >= 0 && code < 128 ? RSQGC_SideStates.SMALL_ADV[code] : 0; }
	static State Glyph(int set, int fam, int pos, int code)
	{
		if (code >= 97 && code <= 122) code -= 32;
		if (code < 0 || code >= 128 || set < 0 || set > 3 || fam < 0 || fam > 3) return null;
		int idx = set < 2 ? RSQGC_SideStates.SMALL_IDX[code] : RSQGC_SideStates.BIG_IDX[code];
		if (idx < 0 || pos < 0 || pos >= (set < 2 ? SMALL_UNITS : BIG_UNITS)) return null;
		let d = GetDefaultByType("RSQGC_SideStatesB");
		State st = null;
		switch ((set * 4 + fam) * 100 + pos)
		{
		case 0: st = d.FindState("F0000"); break;
		case 1: st = d.FindState("F0001"); break;
