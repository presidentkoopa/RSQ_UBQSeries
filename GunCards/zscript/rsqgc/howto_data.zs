	static void Rows(out Array<String> r)
	{
		r.Push("||HOLD A GUN IN THE MAIN HAND|||||DO:~HOLD A GUN IN THE MAIN HAND~GET:~THE SMALL CARD SHOWS BESIDE THE WRIST, RIGHT OF THE MAIN HAND: ERMAC'S PANEL IN THE GUN'S WEAPON-SLOT COLOUR, THE WORD AMMO OR MAGAZINE, THE ROUNDS YOU CAN FIRE NOW BIG, AND THE RESERVE SMALL IN GOLD WHEN THE GUN HAS A MAGAZINE~NEEDS:~SHOW CARDS: ALWAYS (DEFAULT)");
		r.Push("||HOLD A GUN IN THE OFF HAND|||||DO:~HOLD A GUN IN THE OFF HAND~GET:~THE SAME CARD ON THAT WRIST, MIRRORED, BUT ONLY FOR A GUN WHOSE OWN PACK CARRIES THE CARD'S MODELS AND NAMES THE GUN IN AN RSQGCOFF LUMP. ANY OTHER OFF-HAND GUN HAS NO SMALL CARD~NEEDS:~SHOW CARDS: ALWAYS (DEFAULT); A PACK THAT CARRIES THE OFF-HAND CARD");
		r.Push("||FIRE A GUN WITH A MAGAZINE|||||DO:~FIRE A GUN WITH A MAGAZINE~GET:~THE BIG NUMBER IS GREEN ABOVE HALF A MAGAZINE, YELLOW FROM HALF DOWN TO A QUARTER, RED AT A QUARTER OR LESS. ANY GUN AT 0 IS RED~NEEDS:~LOW AMMO COLOUR: ON (DEFAULT); LOW AMMO SHARE (DEFAULT 0.25)");
		r.Push("||EMPTY THE MAGAZINE WITH ROUNDS STILL IN RESERVE|||||DO:~EMPTY THE MAGAZINE WITH ROUNDS STILL IN RESERVE~GET:~RELOAD IN RED TAKES THE BIG NUMBER'S PLACE, THEN A RED 0, SWITCHING EVERY 52 TICS UNTIL YOU RELOAD");
		r.Push("||PICK UP AMMO FOR A GUN IN YOUR HAND|||||DO:~PICK UP AMMO FOR A GUN IN YOUR HAND~GET:~\"+N\" SHOWS IN THE RESERVE'S PLACE FOR 52 TICS; PICKUPS INSIDE THAT TIME ADD UP (AT MOST +99 SHOWN)~NEEDS:~PICKUP NOTE (DEFAULT 52 TICS)");
		r.Push("||CHECK YOUR WATCH WITH EITHER HAND||MAIN OFF|watch||DO:~CHECK YOUR WATCH WITH EITHER HAND: TURN THE BACK OF THAT WRIST TOWARD YOUR EYES AND LOOK TOWARD IT. THE BACK OF THE WRIST MUST BE LESS THAN 80 DEGREES OFF FACING YOUR EYES (90 IS EDGE ON), AND THE WRIST LESS THAN 50 DEGREES FROM WHERE YOUR HEAD POINTS. WHERE THE HAND IS, HOW STILL IT IS AND HOW LONG YOU HOLD IT DO NOT MATTER~GET:~THAT HAND'S WATCH CARD FADES IN OVER 4 TICS, FLAT ON THE BACK-OF-THE-HAND SIDE OF THE WRIST, AND THAT HAND'S SMALL CARD GOES. IT STAYS WHILE THE BACK OF THE WRIST IS LESS THAN 88 DEGREES OFF FACING YOUR EYES AND THE WRIST LESS THAN 65 DEGREES FROM WHERE YOUR HEAD POINTS, AND 70 TICS (2 SECONDS) AFTER~NEEDS:~WATCH CARD: ON CHECK (DEFAULT); STAYS AFTER (DEFAULT 70 TICS); FADE (DEFAULT 4 TICS)");
		r.Push("||CHECK YOUR WATCH WITH A HAND THAT HOLDS A GUN||MAIN OFF|||DO:~CHECK YOUR WATCH WITH A HAND THAT HOLDS A GUN~GET:~THE WEAPON CARD: MAG OR AMMO (RELOAD IN RED ON AN EMPTY MAGAZINE WITH ROUNDS TO LOAD) AND RESERVE, THE TWO COUNTS BIG, \"+N\" IN GREEN AFTER A PICKUP; THEN ONE LINE EACH: MODE (ONLY WHEN THE GUN'S PACK TELLS ONE), LAUNCHER N (ONLY ON BD22 VR'S RIFLE AND MACHINEGUN), GRENADES N, KILLS N IN RED, AND GOLD N ON THE OFF HAND'S CARD~NEEDS:~WATCH SHOWS: WEAPON (DEFAULT); GRENADES NEEDS A GRENADE PILE (RSQ GRENADE, BRUTAL DOOM OR THE WEAPON SETS); GOLD NEEDS RSQ SCORE");
		r.Push("||CHECK YOUR WATCH WITH AN EMPTY MAIN HAND OR WITH FISTS||MAIN|||DO:~CHECK YOUR WATCH WITH AN EMPTY MAIN HAND OR WITH FISTS~GET:~THE STATUS CARD: H AND A, HEALTH BIG (RED AT 25 OR LESS) AND ARMOUR BIG IN BLUE, A KEY ICON FOR EACH KEY KIND THIS MAP HAS (LIT WHEN YOU HOLD IT, DARK WHEN NOT), \"+N\" FOR OTHER KEYS, G:N FOR GRENADES, GOLD N ON THE OFF HAND'S CARD~NEEDS:~KEY ICONS: ON (DEFAULT); MAP KEYS ONLY: ON (DEFAULT)");
		r.Push("||CHECK YOUR WATCH WITH AN EMPTY OFF HAND||OFF|||DO:~CHECK YOUR WATCH WITH AN EMPTY OFF HAND~GET:~THE STATUS CARD. WITH A WEAPON IN THE OFF-HAND SLOT (SUCH AS BD22 VR'S OFF-HAND FISTS) IT IS DRAWN WITH THE HAND; WITH NOTHING IN THAT SLOT IT IS DRAWN IN THE WORLD AT THE WRIST");
		r.Push("||CHECK YOUR WATCH WITH A HAND THAT HOLDS RSQ SABER'S SABER, RSQ FLASHLIGHT & FLARE'S FLARE OR FLASHLIGHT, OR RSQ TACTICAL RIG'S CIGARETTES|||||DO:~CHECK YOUR WATCH WITH A HAND THAT HOLDS RSQ SABER'S SABER, RSQ FLASHLIGHT & FLARE'S FLARE OR FLASHLIGHT, OR RSQ TACTICAL RIG'S CIGARETTES~GET:~THE ITEM CARD, ITS WORDS IN THE HALF OF THE CARD NEARER YOUR ELBOW: THE ITEM'S NAME, ITS COUNT BIG WHEN IT HAS ONE (FLARES LEFT, BATTERY, CIGARETTES; RED AT 0), LIT / UNLIT FOR A FLARE OR ON / OFF FOR A FLASHLIGHT, THEN H N, A N, G:N, THE KEY ICONS, GOLD N ON THE OFF HAND~NEEDS:~WATCH SHOWS: WEAPON (DEFAULT) OR BOTH; COUNTS AND STATES NEED THE MOD THAT OWNS THE ITEM");
		r.Push("||CHECK THE OFF-HAND WATCH WHILE THAT HAND STEADIES A GUN: THE ENGINE'S TWO-HAND STEADYING IS ON, OR THE OFF HAND IS WITHIN 16 MAP UNITS OF THE GUN HAND AND WITHIN 8 MAP UNITS OF THE GUN'S LINE||OFF|||DO:~CHECK THE OFF-HAND WATCH WHILE THAT HAND STEADIES A GUN: THE ENGINE'S TWO-HAND STEADYING IS ON, OR THE OFF HAND IS WITHIN 16 MAP UNITS (ABOUT 45 CM) OF THE GUN HAND AND WITHIN 8 MAP UNITS (ABOUT 23 CM) OF THE GUN'S LINE~GET:~NOTHING. THE OFF HAND'S CHECK DOES NOT COUNT");
		r.Push("||KILL A MONSTER WITHIN 35 TICS OF A HAND'S SHOT|||||DO:~KILL A MONSTER WITHIN 35 TICS OF A HAND'S SHOT~GET:~THAT HAND'S GUN GETS ONE MORE ON ITS KILLS LINE, FOR THIS LEVEL. THE HAND IS THE ONE THE ENGINE SAYS FIRED THE SHOT (BULLETS, PELLETS, RAILS, AND A MELEE WEAPON'S TRACED ATTACK), OR THE ONE WHOSE ROUNDS WENT DOWN (WHAT FLIES). IF BOTH HANDS FIRED ON THE SAME TIC, NO GUN GETS THE KILL");
		r.Push("||HOLD A COOKING RSQ GRENADE|||||DO:~HOLD A COOKING RSQ GRENADE~GET:~ITS WHOLE SECONDS LEFT TAKE THE BIG NUMBER ON THE SMALL CARD, AMBER FOR THE FIRST HALF OF THE FUSE AND RED AFTER, WHATEVER SHOW CARDS SAYS EXCEPT OFF~NEEDS:~RSQ GRENADE ANSWERING ITS FUSE COUNT (ITS COOK SENSE 3)");
		r.Push("||BRING THE GUN TO BETWEEN ABOUT 12 CM AND 0.7 M FROM YOUR EYES, WITHIN 30 DEGREES OF WHERE YOU LOOK|||||DO:~BRING THE GUN TO BETWEEN ABOUT 12 CM AND 0.7 M FROM YOUR EYES, WITHIN 30 DEGREES OF WHERE YOU LOOK~GET:~THE SMALL CARD SHOWS ONLY WHILE YOU DO~NEEDS:~SHOW CARDS: ON LOOK (DEFAULT ALWAYS); LOOK REACH (DEFAULT 0.7 M); LOOK CONE (DEFAULT 30 DEGREES)");
		r.Push("||CHECK YOUR WATCH - SHOW CARDS: INSPECT|||||DO:~CHECK YOUR WATCH~GET:~THE SMALL CARD SHOWS, AND STAYS 70 TICS AFTER. WITH WATCH CARD: ON CHECK THE WATCH CARD TAKES THE WATCH CHECK INSTEAD, SO THE SMALL CARD IS SEEN THIS WAY ONLY WITH WATCH CARD: OFF~NEEDS:~SHOW CARDS: INSPECT (DEFAULT ALWAYS); WATCH CARD: OFF (DEFAULT ON CHECK); STAYS AFTER (DEFAULT 70 TICS)");
		r.Push("||HOLD THAT HAND'S RELOAD BUTTON, OR THE SHARED RELOAD BUTTON|||||DO:~HOLD THAT HAND'S RELOAD BUTTON, OR THE SHARED RELOAD BUTTON~GET:~THE SMALL CARD SHOWS WHILE IT IS HELD AND 70 TICS AFTER~NEEDS:~SHOW CARDS: ON RELOAD (DEFAULT ALWAYS); STAYS AFTER (DEFAULT 70 TICS)");
		r.Push("||HOLD A GUN|||||DO:~HOLD A GUN~GET:~NO SMALL CARD. A COOKING GRENADE'S COUNT IS NOT SHOWN EITHER~NEEDS:~SHOW CARDS: OFF (DEFAULT ALWAYS)");
		r.Push("||TURN THE BACK OF EITHER WRIST TO WITHIN 60 DEGREES OF FACING YOUR EYES, THE WRIST WITHIN 45 DEGREES OF WHERE YOU LOOK||MAIN OFF|||DO:~TURN THE BACK OF EITHER WRIST TO WITHIN 60 DEGREES OF FACING YOUR EYES, THE WRIST WITHIN 45 DEGREES OF WHERE YOU LOOK~GET:~THE WATCH CARD SHOWS WITHOUT A WATCH CHECK, WITH THE SMALL CARD BESIDE IT. TURNED AWAY, THE SMALL CARD SHOWS ALONE~NEEDS:~WATCH CARD: ALWAYS (DEFAULT ON CHECK)");
		r.Push("||CHECK YOUR WATCH - WATCH CARD: OFF|||||DO:~CHECK YOUR WATCH~GET:~NOTHING~NEEDS:~WATCH CARD: OFF (DEFAULT ON CHECK)");
		r.Push("||CHECK YOUR WATCH WITH A GUN - WATCH SHOWS: STATUS|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~THE STATUS CARD INSTEAD OF THE WEAPON CARD~NEEDS:~WATCH SHOWS: STATUS (DEFAULT WEAPON)");
		r.Push("||CHECK YOUR WATCH WITH A GUN - WATCH SHOWS: BOTH|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~BOTH ON ONE CARD: MAG AND RESERVE AND THE COUNTS, \"H N\" AND \"A N\", THE KEY ICONS AND G:N, THEN CND, GOLD AND LAUNCHER WHEN THEY APPLY. NO MODE, GRENADES OR KILLS LINES~NEEDS:~WATCH SHOWS: BOTH (DEFAULT WEAPON)");
		r.Push("||CHECK YOUR WATCH WITH A GUN - GUN BONSAI ON CARD: ON|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~BELOW THE WEAPON CARD'S LINES: \"LV N\" WITH AN XP BAR, THEN UP TO 4 UPGRADES WITH THEIR LEVEL (DARK WHEN SWITCHED OFF), AND \"+N MORE\" WHEN NOT ALL FIT~NEEDS:~GUN BONSAI ON CARD: ON (DEFAULT OFF); RSQ GUN BONSAI VR");
		r.Push("||HOLD A GUN IN EACH HAND|||||DO:~HOLD A GUN IN EACH HAND~GET:~ONE SMALL CARD, ON THE MAIN HAND: THE MAIN GUN'S ROUNDS BIG, THE OFF-HAND GUN'S ROUNDS IN THE SMALL NUMBER. THE OFF HAND'S SMALL CARD GOES~NEEDS:~BOTH GUNS ONE CARD: ON (DEFAULT OFF)");
		r.Push("||RAISE THE GUN TO WITHIN 0.30 M OF YOUR EYE, POINTING WITHIN 25 DEGREES OF WHERE YOU LOOK|||||DO:~RAISE THE GUN TO WITHIN 0.30 M OF YOUR EYE, POINTING WITHIN 25 DEGREES OF WHERE YOU LOOK~GET:~THAT HAND'S SMALL CARD HIDES~NEEDS:~HIDE AT EYE: ON (DEFAULT OFF); EYE REACH (DEFAULT 0.30 M)");
		r.Push("||TURN YOUR WRIST|||||DO:~TURN YOUR WRIST~GET:~THE SMALL CARD TURNS TOWARD YOUR EYES EVERY TIC, AT MOST 20 DEGREES EACH WAY~NEEDS:~TILT TO EYES: ON (DEFAULT OFF); TILT MAX (DEFAULT 20 DEGREES)");
		r.Push("||HOLD A GUN, OR CHECK YOUR WATCH|||||DO:~HOLD A GUN, OR CHECK YOUR WATCH~GET:~THE CARDS ARE FLAT SIGNS PLACED AT THE HAND ONCE A TIC, FACING YOUR EYE, IN PLACE OF THE CARDS DRAWN WITH THE HAND. THE SABER, THE FLARE, THE FLASHLIGHT AND THE CIGARETTES SHOW THE STATUS CARD; ANY OTHER WEAPON WITH NO AMMO PILE SHOWS ITS NAME OVER THE WEAPON CARD'S LINES, WITH NO COUNTS. THE SMALL CARD'S TOP WORD IS MAG, AMMO, RELOAD OR +N~NEEDS:~DRAW IN WORLD: ON (DEFAULT OFF); WORLD CARD SIZE (DEFAULT 1.4)");
		r.Push("||TAKE ONE BLOW OF MORE THAN 20 DAMAGE|||||DO:~TAKE ONE BLOW OF MORE THAN 20 DAMAGE~GET:~EACH GUN IN YOUR HANDS LOSES 3 CONDITION (TWO GUNS OF ONE CLASS LOSE IT ONCE). A GUN STARTS AT 100 AND STOPS AT 0~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); BIG HIT OVER (DEFAULT 20); WEAR PER HIT (DEFAULT 3)");
		r.Push("||HIT SOMETHING WITH A WORN GUN|||||DO:~HIT SOMETHING WITH A WORN GUN~GET:~THE DAMAGE IS SCALED BY THE GUN'S CONDITION. MOST GUNS: X0.90 AT 70 TO 79, X0.85, X0.80, X0.70, THEN X0.60 AT 30 TO 39, AND UNDER 30 MORE THAN NEW: X1.2, X1.5, THEN X1.8 UNDER 10. SHOTGUNS AND CHAINGUNS, AND PRECISION GUNS, HAVE THEIR OWN TABLES~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF)");
		r.Push("||PULL THE TRIGGER ON A WORN GUN|||||DO:~PULL THE TRIGGER ON A WORN GUN~GET:~FROM THE PULL UNTIL THE GUN IS READY AGAIN ITS FRAMES RUN SLOWER AT 40 TO 69 CONDITION (X0.85, X0.67, X0.70) AND FASTER UNDER 40 (X1.05, X1.2, X1.25 UNDER 10). A FRAME 1 TIC LONG CANNOT BE SHORTENED~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); FIRE RATE FOLLOWS CONDITION: ON (DEFAULT)");
		r.Push("||FIRE A GUN WHOSE CONDITION IS UNDER 60|||||DO:~FIRE A GUN WHOSE CONDITION IS UNDER 60~GET:~EACH SHOT HAS A SMALL CHANCE (0.5 TO 7 IN 100) TO BACKFIRE: 1 TO 5 HEALTH, ARMOUR IGNORED. UNDER 30 IT CAN ALSO MISFIRE FOR 4 TO 12 (AN ENERGY GUN OVERLOADS FOR 8 TO 20 AND NEVER BACKFIRES). NEITHER CAN KILL YOU. AT MOST ONE A SECOND A HAND~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); THE WORD IS SHOWN AS RSQ VISUALREWARDS' TOAST, ELSE ONLY A SOUND PLAYS");
		r.Push("||CHECK YOUR WATCH WITH A GUN - WEAPON CONDITION: ON|||||DO:~CHECK YOUR WATCH WITH A GUN~GET:~A CND LINE: A BAR AND THE NUMBER, GREEN AT 90 AND UP, THEN LIME, YELLOW, ORANGE, AND RED UNDER 30~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); CONDITION ON CARD: ON (DEFAULT)");
		r.Push("||PICK UP ONE OF RSQ VISUALREWARDS' STEEL BITS|||||DO:~PICK UP ONE OF RSQ VISUALREWARDS' STEEL BITS~GET:~EACH WORN GUN IN YOUR HANDS GAINS THE POINTS THAT MOD SENDS~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); RSQ VISUALREWARDS");
		r.Push("||BUY REPAIR AT RSQ MINIBOSS'S KIOSK|||||DO:~BUY REPAIR AT RSQ MINIBOSS'S KIOSK~GET:~EVERY GUN YOU CARRY GOES BACK TO 100~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); RSQ MINIBOSS");
		r.Push("||TAKE A BIG HIT WITH A GUN THAT IS AT 0, OR THAT THE HIT BRINGS TO 0|||||DO:~TAKE A BIG HIT WITH A GUN THAT IS AT 0, OR THAT THE HIT BRINGS TO 0~GET:~THE GUN BREAKS: A SOUND, \"<NAME> BROKE\", AND IT IS TAKEN FROM YOU~NEEDS:~WEAPON CONDITION: ON (DEFAULT OFF); LOSE GUN AT 0: ON (DEFAULT OFF)");
		r.Push("||WITH A GUN IN THE MAIN HAND, OPEN TEST AND DEBUG AND MOVE SPOT UP, SPOT SIDE OR SPOT IN|||||DO:~WITH A GUN IN THE MAIN HAND, OPEN TEST AND DEBUG AND MOVE SPOT UP, SPOT SIDE OR SPOT IN (CM)~GET:~THAT GUN'S SMALL CARD MOVES AND THE SPOT IS SAVED FOR THAT GUN'S CLASS ON THIS MACHINE. OTHER GUNS KEEP THE PLACEMENT SLIDERS~NEEDS:~THE ROWS ARE GREYED WITH NO GUN IN THAT HAND");
		r.Push("||SET EDIT SPOT FOR TO OFF HAND|||||DO:~SET EDIT SPOT FOR TO OFF HAND~GET:~THE SPOT ROWS EDIT THE OFF-HAND GUN. BD22 VR'S OFF-HAND COPY OF A GUN USES ITS GUN'S SPOT UNTIL IT HAS ITS OWN~NEEDS:~EDIT SPOT FOR: OFF HAND (DEFAULT MAIN HAND)");
		r.Push("||CHOOSE RESET THIS GUN OR RESET ALL SPOTS AND CONFIRM|||||DO:~CHOOSE RESET THIS GUN OR RESET ALL SPOTS AND CONFIRM~GET:~THAT GUN'S SMALL CARD, OR EVERY GUN'S, GOES BACK TO THE PLACEMENT SLIDERS");
		r.Push("||TURN ON HIDE HUD HEALTH OR HIDE HUD AMMO|||||DO:~TURN ON HIDE HUD HEALTH OR HIDE HUD AMMO~GET:~ANOTHER PACK'S STATUS BAR SETTING IS SWITCHED; NOTHING IN THIS MOD CHANGES. THE ROWS ARE GREYED WHEN NO LOADED PACK HAS THE SETTING~NEEDS:~BD22 VR RELOADED (THE SETTING IS ITS OWN)");
		r.Push("||TURN ON HAND NUMBERS|||||DO:~TURN ON HAND NUMBERS~GET:~EVERY 5 TICS THE MIDDLE OF THE SCREEN SHOWS THE ENGINE'S HAND POSITIONS AND ANGLES, THE WEAPONS HELD, THE WATCH CHECK'S ANSWER FOR EACH HAND (0 OR 2), AND FOR EACH WRIST HOW MANY DEGREES THE BACK OF THE WRIST IS OFF FACING YOUR EYES AND HOW MANY DEGREES THE WRIST IS FROM WHERE YOUR HEAD POINTS~NEEDS:~HAND NUMBERS: ON (DEFAULT OFF)");
		r.Push("||CHECK YOUR WATCH WITH A HAND THAT HOLDS ANY OTHER WEAPON WITH NO AMMO PILE|||||DO:~CHECK YOUR WATCH WITH A HAND THAT HOLDS ANY OTHER WEAPON WITH NO AMMO PILE (BD22 VR'S CHAINSAW AND DRAGONSLAYER, GLOVES, A WHIP, ANY PACK'S MELEE WEAPON)~GET:~THE WEAPON CARD WITH THE WEAPON'S NAME WHERE A GUN HAS MAG AND RESERVE, AND NO COUNTS; THEN THE SAME LINES: GRENADES N, KILLS N IN RED, GOLD N ON THE OFF HAND'S CARD. THERE IS NO SMALL CARD~NEEDS:~WATCH SHOWS: WEAPON (DEFAULT); WITH BOTH THE NAME STANDS OVER \"H N\", \"A N\", THE KEY ICONS AND G:N");
		r.Push("||KILL A MONSTER WITH A BLOW OF A WEAPON THAT HAS NO AMMO PILE, OR OF A WEAPON FLAGGED A MELEE WEAPON: THE MONSTER'S EDGE WITHIN 128 MAP UNITS OF THE HAND THAT HOLDS IT|||||DO:~KILL A MONSTER WITH A BLOW OF A WEAPON THAT HAS NO AMMO PILE, OR OF A WEAPON FLAGGED A MELEE WEAPON (BD22 VR'S AXE): THE MONSTER'S EDGE WITHIN 128 MAP UNITS (ABOUT 3.7 M) OF THE HAND THAT HOLDS IT~GET:~THAT WEAPON GETS ONE MORE ON ITS KILLS LINE, WHATEVER THE OTHER HAND FIRED. WITH SUCH A WEAPON IN EACH HAND, THE NEARER HAND'S GETS IT. A BLOW IS DAMAGE YOU DEAL THROUGH AN ATTACK ACTOR OF YOUR OWN THAT IS NOT A TRACED SHOT AND NOT AN EXPLOSION; A TRACED MELEE ATTACK COUNTS AS A SHOT, ABOVE");
		r.Push("||HOLD BD22 VR'S SILVERGUN IN EITHER HAND|||||DO:~HOLD BD22 VR'S SILVERGUN (BRUTALREVOLVER) IN EITHER HAND~GET:~RESERVE, ON THE SMALL CARD AND THE WATCH CARD, IS THE ROUNDS YOU CAN STILL LOAD: THE PISTOL'S PILE DIVIDED BY 3 (ONE CHAMBER COSTS 3), ROUNDED DOWN. RELOAD SHOWS ONLY WHEN AT LEAST ONE ROUND CAN BE LOADED, AND \"+N\" COUNTS ROUNDS~NEEDS:~BD22 VR RELOADED. ANY GUN WITH A MAGAZINE WHOSE OWN AMMO USE PER SHOT IS MORE THAN 1 IS COUNTED THE SAME WAY");
		r.Push("||PLAY BRUTAL DOOM WITHOUT RELOADING|||||DO:~PLAY BRUTAL DOOM WITHOUT RELOADING: AS PURIST (ITS ISPLAYINGASPURIST TOKEN, WITH A PURIST GUN OR ANY OTHER) OR WITH ITS NORELOADING TOKEN~GET:~THE GUN'S CARDS SAY AMMO WITH THE PILE THE GUN FIRES FROM, AND NO RESERVE. AS PURIST THE SSG AND THE GRENADE LAUNCHER KEEP MAGAZINE AND RESERVE, BECAUSE THEY STILL LOAD FROM THE PILE~NEEDS:~BRUTAL DOOM");
		r.Push("||LOAD OR FIRE THE LAUNCHER UNDER BD22 VR'S RIFLE OR MACHINEGUN|||||DO:~LOAD OR FIRE THE LAUNCHER UNDER BD22 VR'S RIFLE OR MACHINEGUN~GET:~LAUNCHER 1 IN ORANGE WITH A ROUND IN IT, LAUNCHER 0 DARK WITHOUT, ON THAT GUN'S WATCH CARD. THE OFF HAND'S RIFLE SHOWS ITS OWN LAUNCHER~NEEDS:~BD22 VR RELOADED; NOT ON THE PURIST RIFLE, WHICH HAS NO LAUNCHER");
	}
}
