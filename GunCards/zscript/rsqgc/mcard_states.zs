	// the first state of a piece: code = (kind * 100 + slot) * 2 + (1: In below 0); kind 0 panel, 1 short panel, 2 the
	// word, 3 RELOAD, 4 big JFO digit (card with the word), 5 big JFO digit (short card), 6 small JFO digit, 7 / 8 / 9
	// the same in Ermac's lettering. A letter's states are the 2 n-th and the next. (FindState wants a constant label.)
	static State Piece(int code)
	{
		let d = GetDefaultByType("RSQGC_MCStates");
		switch (code)
		{
		case 0: return d.FindState("MC_QPT_P");
		case 1: return d.FindState("MC_QPT_M");
		case 200: return d.FindState("MC_QPS_P");
		case 201: return d.FindState("MC_QPS_M");
		case 400: return d.FindState("MC_QLW_P");
		case 401: return d.FindState("MC_QLW_M");
		case 600: return d.FindState("MC_QRW_P");
		case 601: return d.FindState("MC_QRW_M");
		case 800: return d.FindState("MC_QK0_P");
		case 801: return d.FindState("MC_QK0_M");
		case 1000: return d.FindState("MC_QH0_P");
		case 1001: return d.FindState("MC_QH0_M");
		case 802: return d.FindState("MC_QK1_P");
		case 803: return d.FindState("MC_QK1_M");
		case 1002: return d.FindState("MC_QH1_P");
		case 1003: return d.FindState("MC_QH1_M");
		case 804: return d.FindState("MC_QK2_P");
		case 805: return d.FindState("MC_QK2_M");
		case 1004: return d.FindState("MC_QH2_P");
		case 1005: return d.FindState("MC_QH2_M");
		case 806: return d.FindState("MC_QK3_P");
		case 807: return d.FindState("MC_QK3_M");
		case 1006: return d.FindState("MC_QH3_P");
		case 1007: return d.FindState("MC_QH3_M");
		case 808: return d.FindState("MC_QK4_P");
		case 809: return d.FindState("MC_QK4_M");
		case 1008: return d.FindState("MC_QH4_P");
		case 1009: return d.FindState("MC_QH4_M");
		case 1200: return d.FindState("MC_QS0_P");
		case 1201: return d.FindState("MC_QS0_M");
		case 1202: return d.FindState("MC_QS1_P");
		case 1203: return d.FindState("MC_QS1_M");
		case 1204: return d.FindState("MC_QS2_P");
		case 1205: return d.FindState("MC_QS2_M");
		case 1206: return d.FindState("MC_QS3_P");
		case 1207: return d.FindState("MC_QS3_M");
		case 1208: return d.FindState("MC_QS4_P");
		case 1209: return d.FindState("MC_QS4_M");
		case 1400: return d.FindState("MC_QN0_P");
		case 1401: return d.FindState("MC_QN0_M");
		case 1600: return d.FindState("MC_QO0_P");
		case 1601: return d.FindState("MC_QO0_M");
		case 1402: return d.FindState("MC_QN1_P");
		case 1403: return d.FindState("MC_QN1_M");
		case 1602: return d.FindState("MC_QO1_P");
		case 1603: return d.FindState("MC_QO1_M");
		case 1404: return d.FindState("MC_QN2_P");
		case 1405: return d.FindState("MC_QN2_M");
		case 1604: return d.FindState("MC_QO2_P");
		case 1605: return d.FindState("MC_QO2_M");
		case 1406: return d.FindState("MC_QN3_P");
		case 1407: return d.FindState("MC_QN3_M");
		case 1606: return d.FindState("MC_QO3_P");
		case 1607: return d.FindState("MC_QO3_M");
		case 1408: return d.FindState("MC_QN4_P");
		case 1409: return d.FindState("MC_QN4_M");
		case 1608: return d.FindState("MC_QO4_P");
		case 1609: return d.FindState("MC_QO4_M");
		case 1800: return d.FindState("MC_QJ0_P");
		case 1801: return d.FindState("MC_QJ0_M");
		case 1802: return d.FindState("MC_QJ1_P");
		case 1803: return d.FindState("MC_QJ1_M");
		case 1804: return d.FindState("MC_QJ2_P");
		case 1805: return d.FindState("MC_QJ2_M");
		case 1806: return d.FindState("MC_QJ3_P");
		case 1807: return d.FindState("MC_QJ3_M");
		case 1808: return d.FindState("MC_QJ4_P");
		case 1809: return d.FindState("MC_QJ4_M");
		}
		return null;
	}
}

