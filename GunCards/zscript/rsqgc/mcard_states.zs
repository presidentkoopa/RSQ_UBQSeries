	// the first state of a piece: code = kind * 1000 + slot * 100 + depth; kind 0 panel, 1 short panel, 2 the word,
	// 3 RELOAD, 4 big digit (card with the word), 5 big digit (short card), 6 small digit. (FindState wants a
	// constant label, hence the table.)
	static State Piece(int code)
	{
		let d = GetDefaultByType("RSQGC_MCStatesB");
		switch (code)
		{
		case 0: return d.FindState("QPT0");
		case 1: return d.FindState("QPT1");
		case 2: return d.FindState("QPT2");
		case 3: return d.FindState("QPT3");
		case 4: return d.FindState("QPT4");
		case 5: return d.FindState("QPT5");
		case 6: return d.FindState("QPT6");
		case 7: return d.FindState("QPT7");
		case 8: return d.FindState("QPT8");
		case 9: return d.FindState("QPT9");
		case 10: return d.FindState("QPTA");
		case 11: return d.FindState("QPTB");
		case 12: return d.FindState("QPTC");
		case 1000: return d.FindState("QPS0");
		case 1001: return d.FindState("QPS1");
		case 1002: return d.FindState("QPS2");
		case 1003: return d.FindState("QPS3");
