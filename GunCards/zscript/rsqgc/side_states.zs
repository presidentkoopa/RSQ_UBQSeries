	static double RowY(int row, int fam)
	{
		if (row < 0 || row >= ROWS || fam < 0 || fam > 3) return 0;
		return RSQGC_SideStates.ROW_Y[row * 4 + fam];
	}
	static State Panel(int fam, int hi)
	{
		let d = GetDefaultByType("RSQGC_SideStates");
		switch (hi * 4 + fam)
		{
		case 0: return d.FindState("P00");
		case 1: return d.FindState("P01");
		case 2: return d.FindState("P02");
		case 3: return d.FindState("P03");
		case 4: return d.FindState("P10");
		case 5: return d.FindState("P11");
