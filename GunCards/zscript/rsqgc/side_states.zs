	static int IndexOf(int font, int code)
	{
		if (font == 0) { for (int i = 0; i < RSQGC_SideStates.CODES0.Size(); i++) if (RSQGC_SideStates.CODES0[i] == code) return i; }
		else if (font == 1) { for (int i = 0; i < RSQGC_SideStates.CODES1.Size(); i++) if (RSQGC_SideStates.CODES1[i] == code) return i; }
		else { for (int i = 0; i < RSQGC_SideStates.CODES2.Size(); i++) if (RSQGC_SideStates.CODES2[i] == code) return i; }
		return -1;
	}
	static State Glyph(int row, int fam, int col, int code)
	{
