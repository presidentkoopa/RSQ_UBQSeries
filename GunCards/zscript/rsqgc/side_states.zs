	static State Panel(int fam, int hi)
	{
		let d = GetDefaultByType("RSQGC_SideStates");
		switch (hi * 4 + fam)
		{
		case 0: return d.FindState("P00");
		case 1: return d.FindState("P01");
		case 2: return d.FindState("P02");
		case 3: return d.FindState("P03");
		case 4: return d.FindState("P10");
		case 5: return d.FindState("P11");
		case 6: return d.FindState("P12");
		case 7: return d.FindState("P13");
		case 8: return d.FindState("P20");
		case 9: return d.FindState("P21");
		case 10: return d.FindState("P22");
		case 11: return d.FindState("P23");
		case 12: return d.FindState("P30");
		case 13: return d.FindState("P31");
		case 14: return d.FindState("P32");
		case 15: return d.FindState("P33");
		case 16: return d.FindState("P40");
		case 17: return d.FindState("P41");
		case 18: return d.FindState("P42");
		case 19: return d.FindState("P43");
		}
		return null;
	}
