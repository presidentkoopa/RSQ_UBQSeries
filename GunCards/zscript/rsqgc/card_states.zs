	// The first state of a piece. kind 0 panel, 1 label, 2 big digit, 3 small digit; slot for digits.
	// (FindState wants a constant label, hence the table.)
	static State Piece(int kind, bool mirrored, int slot = 0)
	{
		let d = GetDefaultByType("RSQGC_CardStates");
		int k = kind * 100 + (mirrored ? 10 : 0) + slot;
		switch (k)
		{
		case 0: return d.FindState("PN");
		case 100: return d.FindState("LN");
		case 200: return d.FindState("BN0");
		case 201: return d.FindState("BN1");
		case 202: return d.FindState("BN2");
		case 300: return d.FindState("SN0");
		case 301: return d.FindState("SN1");
		case 302: return d.FindState("SN2");
		case 10: return d.FindState("PM");
		case 110: return d.FindState("LM");
		case 210: return d.FindState("BM0");
		case 211: return d.FindState("BM1");
		case 212: return d.FindState("BM2");
		case 310: return d.FindState("SM0");
		case 311: return d.FindState("SM1");
		case 312: return d.FindState("SM2");
		}
		return null;
	}
