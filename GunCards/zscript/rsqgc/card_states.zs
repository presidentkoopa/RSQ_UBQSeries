		Q8S4 L -1 Bright;
		Q8S4 M -1 Bright;
		Stop;
	SM28:
		Q8S5 A -1 Bright;
		Q8S5 B -1 Bright;
		Q8S5 C -1 Bright;
		Q8S5 D -1 Bright;
		Q8S5 E -1 Bright;
		Q8S5 F -1 Bright;
		Q8S5 G -1 Bright;
		Q8S5 H -1 Bright;
		Q8S5 I -1 Bright;
		Q8S5 J -1 Bright;
		Q8S5 K -1 Bright;
		Q8S5 L -1 Bright;
		Q8S5 M -1 Bright;
		Stop;
	}

	// The first state of a piece. kind 0 panel, 1 label, 2 big digit, 3 small digit; slot for digits.
	// (FindState wants a constant label, hence the table.)
	// depth: which of the baked DEPTHS (rsqgc_in), 0..8, 4 is where the owner placed it.
	const DEPTHS = 9;
	const DEPTH_STEP = 1.5;   // cm between them
	static State Piece(int kind, bool mirrored, int slot = 0, int depth = 4)
	{
		let d = GetDefaultByType("RSQGC_CardStates");
		int k = depth * 1000 + kind * 100 + (mirrored ? 10 : 0) + slot;
