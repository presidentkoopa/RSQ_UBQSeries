	// The first state of a piece. kind 0 panel, 1 label (JFO q * 3 + word, Ermac 6 + word), 2 big digit, 3 small digit
	// (JFO, q * GLYPHS + glyph), 4 RELOAD (JFO q, Ermac 2), 5 / 6 Ermac big / small digit, 7 the short panel, 8 RELOAD on it
	// (no word); slot for digits.
	const ERMAC_LABEL = 6;
	const ERMAC_RELOAD = 2;
	// (FindState wants a constant label, hence the table.)
	// depth: which of the baked DEPTHS (rsqgc_in), 0..12, 6 is where the owner placed it.
	const DEPTHS = 13;
	const DEPTH_STEP = 2;   // cm between them
	static State Piece(int kind, bool mirrored, int slot = 0, int depth = 6)
	{
		let d = GetDefaultByType("RSQGC_CardStates");
		int k = depth * 1000 + kind * 100 + (mirrored ? 10 : 0) + slot;
		switch (k)
		{
		case 0: return d.FindState("PN0");
		case 700: return d.FindState("TN0");
		case 100: return d.FindState("LN0");
