		r.Push("||BRING A HAND NEAR A HOLSTER||LHIP RHIP CHEST LSH RSH|||DO:~BRING A HAND NEAR A HOLSTER: A HIP, EITHER SIDE OF THE CHEST, OVER A SHOULDER~GET:~A WIRE RING SHOWS THERE IF A GRIP BY THAT HAND WOULD DO SOMETHING. THE NEAREST SUCH RING IS BRIGHT, THE OTHERS FAINT. WITH THE HAND INSIDE, THE RING CHANGES COLOUR AND GROWS, AND THAT HAND TICKS ONCE~NEEDS:~HOLSTER RINGS: ON (DEFAULT)");
		r.Push("||HOLD A GUN IN THE MAIN HAND INSIDE AN EMPTY HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE||LHIP RHIP CHEST LSH RSH MAIN|holster||DO:~HOLD A GUN IN THE MAIN HAND INSIDE AN EMPTY HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE~GET:~THE GUN GOES IN AND THE HOLSTER BECOMES THAT GUN'S OWN (THE FIRST TIME, THE RING FLASHES AND THE GUN'S PICTURE SHOWS OVER IT). THE HAND GOES TO ITS FIST. ONE PULSE AND A HOLSTER SOUND~NEEDS:~GRIP HOLSTERS: ON (DEFAULT) FOR THE GRIP, USE HOLSTERS: ON (DEFAULT) FOR USE; THE HAND MUST HAVE BEEN INSIDE 3 TICS (PRESS DELAY)");
		r.Push("||PUT THE EMPTY MAIN HAND IN A FULL HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE||LHIP RHIP CHEST LSH RSH MAIN|draw||DO:~PUT THE EMPTY MAIN HAND IN A FULL HOLSTER AND SQUEEZE ITS GRIP, OR PRESS USE~GET:~THAT GUN IS DRAWN INTO THE MAIN HAND. ONE PULSE AND A DRAW SOUND~NEEDS:~GRIP HOLSTERS: ON, USE HOLSTERS: ON (DEFAULTS)");
		r.Push("||SQUEEZE THE OFF HAND'S GRIP IN A HOLSTER||LHIP RHIP CHEST LSH RSH OFF|offdraw||DO:~SQUEEZE THE OFF HAND'S GRIP IN A HOLSTER~GET:~THE OFF HAND DOES THE SAME FOR ITSELF: A GUN IT HOLDS GOES IN, AN EMPTY OFF HAND DRAWS THE HOLSTER'S GUN INTO THE OFF HAND. HOLSTER WITH ONE HAND AND DRAW WITH THE OTHER TO MOVE A GUN ACROSS~NEEDS:~GRIP HOLSTERS: ON (DEFAULT)");
		r.Push("||PRESS USE WITH ONLY THE OFF HAND IN A PLACE||OFF|||DO:~PRESS USE WITH ONLY THE OFF HAND IN A PLACE~GET:~THE PRESS IS THE OFF HAND'S. WITH THE MAIN HAND IN ANY PLACE, USE IS THE MAIN HAND'S AND THE OFF HAND'S PLACE IS NOT PRESSED~NEEDS:~USE HOLSTERS: ON (DEFAULT)");
		r.Push("||SQUEEZE A GRIP WITH THAT HAND IN NO PLACE|||||DO:~SQUEEZE A GRIP WITH THAT HAND IN NO PLACE~GET:~NOTHING FROM THE RIG. THE RIG NEVER EATS THE GRIP KEY, SO THE GAME KEEPS WHATEVER ELSE THE GRIP DOES");
		r.Push("||PUT A GUN THAT HAS ITS OWN HOLSTER INTO ANOTHER GUN'S FULL HOLSTER|||||DO:~PUT A GUN THAT HAS ITS OWN HOLSTER INTO ANOTHER GUN'S FULL HOLSTER~GET:~AT ONCE, YOUR GUN GOES HOME TO ITS OWN HOLSTER (A STREAK OF LIGHT RUNS TO IT) AND THE GUN THAT WAS IN THIS HOLSTER COMES TO YOUR HAND~NEEDS:~QUICK SWAP: ON (DEFAULT) SKIPS THE PRESS DELAY");
		r.Push("||PUT A GUN THAT HAS NO HOLSTER INTO ANOTHER GUN'S FULL HOLSTER|||||DO:~PUT A GUN THAT HAS NO HOLSTER INTO ANOTHER GUN'S FULL HOLSTER~GET:~AT ONCE, THAT HOLSTER'S GUN COMES TO YOUR HAND. YOUR GUN LEAVES THE HAND AND STAYS CARRIED, IN NO HOLSTER~NEEDS:~SWAP AT HOLSTER: TO WHEEL (DEFAULT); QUICK SWAP: ON (DEFAULT)");
		r.Push("||PUT A GUN THAT HAS ITS OWN HOLSTER INTO A DIFFERENT, EMPTY HOLSTER|||||DO:~PUT A GUN THAT HAS ITS OWN HOLSTER INTO A DIFFERENT, EMPTY HOLSTER~GET:~IT GOES HOME TO ITS OWN HOLSTER (THE STREAK OF LIGHT) AND THE HAND GOES TO ITS FIST");
		r.Push("||PUT A GUN THAT HAS NO HOLSTER INTO AN EMPTY HOLSTER THAT BELONGS TO ANOTHER GUN|||||DO:~PUT A GUN THAT HAS NO HOLSTER INTO AN EMPTY HOLSTER THAT BELONGS TO ANOTHER GUN~GET:~IT TAKES THAT HOLSTER OVER: THE HOLSTER IS NOW THIS GUN'S, THE RING FLASHES AND SHOWS ITS PICTURE, AND THE OTHER GUN HAS NO HOLSTER");
		r.Push("||SQUEEZE A GRIP WITH AN EMPTY HAND IN AN EMPTY HOLSTER|||||DO:~SQUEEZE A GRIP WITH AN EMPTY HAND IN AN EMPTY HOLSTER~GET:~REFUSED: A DOUBLE PULSE AND DOOM'S \"USE FAILED\" SOUND. NOTHING IS DRAWN");
		r.Push("||SWITCH AWAY FROM A GUN THAT HAS A HOLSTER SO IT IS IN NEITHER HAND|||||DO:~SWITCH AWAY FROM A GUN THAT HAS A HOLSTER (A KEY, A WHEEL, NEXT WEAPON) SO IT IS IN NEITHER HAND~GET:~AFTER 10 TICS IT IS BACK IN ITS OWN HOLSTER, IF THAT HOLSTER IS EMPTY");
		r.Push("||TAKE A HOLSTERED GUN INTO A HAND SOME OTHER WAY|||||DO:~TAKE A HOLSTERED GUN INTO A HAND SOME OTHER WAY (A KEY, A WHEEL)~GET:~AFTER 3 TICS THE HOLSTER SHOWS EMPTY. IT IS STILL THAT GUN'S");
		r.Push("||SQUEEZE A GRIP JUST AFTER YOUR HAND SLIPPED OUT OF A SHOULDER HOLSTER||LSH RSH|||DO:~SQUEEZE A GRIP JUST AFTER YOUR HAND SLIPPED OUT OF A SHOULDER HOLSTER (WITHIN 10 TICS)~GET:~THE PRESS STILL COUNTS AT THAT SHOULDER");
		r.Push("||BRING A HAND NEAR A FULL HOLSTER - AMMO LIGHT: ON|||||DO:~BRING A HAND NEAR A FULL HOLSTER~GET:~A SMALL LIGHT SITS IN THE RING: GREEN WITH HALF A MAGAZINE OR MORE, YELLOW WHEN LOW OR NEEDING A RELOAD, RED AND PULSING WHEN EMPTY. AN ARC ROUND IT SHOWS HOW FULL THE GUN IS~NEEDS:~AMMO LIGHT: ON (DEFAULT); THE RING MUST BE SHOWING");
		r.Push("||LOOK AT A HOLSTER WITH A GUN IN IT|||||DO:~LOOK AT A HOLSTER WITH A GUN IN IT~GET:~THE GUN HANGS THERE: MUZZLE DOWN AT THE HIPS, ACROSS THE CHEST, ON YOUR BACK OVER THE SHOULDERS~NEEDS:~SHOW STORED GUNS: ON (DEFAULT); A GUN THE RIG HAS MEASURED");
		r.Push("||SQUEEZE EITHER HAND'S GRIP, OR PRESS USE, AT THE BELT BUCKLE||BELT|nade||DO:~SQUEEZE EITHER HAND'S GRIP, OR PRESS USE, AT THE BELT BUCKLE (THE GRENADE SPOT)~GET:~THE HAND GRENADE COMES TO THE MAIN HAND, WHICHEVER HAND PRESSED. WITH NONE LEFT: REFUSED. A GRENADE HANGS AT THE BUCKLE WHILE YOU HAVE ONE, WITH A LIGHT: GREEN TWO OR MORE, YELLOW ONE, RED NONE~NEEDS:~GRENADE SPOT: ON (DEFAULT); A HAND GRENADE WEAPON LOADED (BRUTAL DOOM'S, OR RSQ GRENADE'S)");
		r.Push("||SQUEEZE A GRIP AT THE GRENADE SPOT WITH THE GRENADE IN THE MAIN HAND||BELT MAIN|||DO:~SQUEEZE A GRIP AT THE GRENADE SPOT WITH THE GRENADE IN THE MAIN HAND~GET:~THE GUN YOU HELD BEFORE COMES BACK~NEEDS:~GRENADE SPOT: ON (DEFAULT)");
		r.Push("||LOOK DOWN AT YOUR BELT, TO THE OFF HAND'S SIDE OF THE BUCKLE||BELT|||DO:~LOOK DOWN AT YOUR BELT, TO THE OFF HAND'S SIDE OF THE BUCKLE~GET:~THE KEYS YOU CARRY HANG ON A STEEL RING THERE, UP TO EIGHT, AND SWAY AS YOU MOVE~NEEDS:~KEYRING: ON (DEFAULT)");
		r.Push("||SQUEEZE THE MAIN HAND'S GRIP, OR PRESS USE, AT THE POCKET JUST LEFT OF YOUR BREASTBONE, 30 CM UNDER YOUR EYES||CHEST|cig||DO:~SQUEEZE THE MAIN HAND'S GRIP, OR PRESS USE, AT THE POCKET JUST LEFT OF YOUR BREASTBONE, 30 CM UNDER YOUR EYES (JUST RIGHT OF IT FOR A LEFT-HANDED LAYOUT)~GET:~A CIGARETTE IS IN THE MAIN HAND AND A ZIPPO IN THE OFF HAND. THE POCKET HOLDS ONE FEWER. WITH NONE LEFT: A WEAK TICK~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||SQUEEZE THE MAIN GRIP AT THE POCKET WITH THE CIGARETTE IN THAT HAND||CHEST|||DO:~SQUEEZE THE MAIN GRIP AT THE POCKET WITH THE CIGARETTE IN THAT HAND~GET:~IT GOES BACK IN THE POCKET AND BOTH HANDS GET BACK WHAT THEY HELD~NEEDS:~CIGARETTES: ON (DEFAULT)");
		r.Push("||PRESS USE WITH THE CIGARETTE AT YOUR LIPS, OR WITHIN A THIRD OF A SECOND OF LEAVING THERE||MOUTH|mouth||DO:~PRESS USE WITH THE CIGARETTE AT YOUR LIPS (FROM THE LIPS TO JUST UNDER THE CHIN), OR WITHIN A THIRD OF A SECOND OF LEAVING THERE~GET:~IT GOES IN YOUR MOUTH AND STAYS, AND THE MAIN HAND HAS ITS GUN BACK. COMING INTO REACH GIVES A GLOW AT THE TIP, A TICK AND A SOFT SOUND~NEEDS:~CIGARETTES: ON (DEFAULT)");
