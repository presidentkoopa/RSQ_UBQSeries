// What Doom textures are made of, for RS enhanced ballistics (zscript/rsq/ballistics.zs).
// surface name { walls = "PATTERN", ...  flats = ...  any = ... }; * any run, ? one character.
// A later rule or a later SURFACES lump wins; textures nothing names count as concrete.

surface metal
{
	walls = "METAL*", "SUPPORT*", "SW1MET*", "SW2MET*", "DOOR*", "BIGDOOR1", "BIGDOOR2", "BIGDOOR3", "BIGDOOR4"
	walls = "EXITDOOR", "PLAT1", "SILVER*", "SHAWN*", "TEK*", "COMP*", "SPACEW*", "PIPE*", "*GRATE*"
	flats = "FLAT23", "STEP1", "STEP2", "*GRATE*"
}
surface wood
{
	walls = "WOOD*", "BIGDOOR5", "BIGDOOR6", "BIGDOOR7", "PANEL*", "CRATE*", "CRATINY", "CRATELIT", "CRATWIDE"
	flats = "FLAT5_1", "FLAT5_2", "CRATOP*"
}
surface glass
{
	walls = "*GLASS*", "LITE*"
}
surface liquid
{
	walls = "SFALL*", "BFALL*"
	flats = "FWATER*", "BLOOD*"
}
surface slime
{
	flats = "NUKAGE*", "SLIME*"
}
surface lava
{
	walls = "FIRELAV*", "FIREMAG*"
	flats = "LAVA*"
}
surface dirt
{
	walls = "ASHWALL*", "ROCK*", "SP_ROCK*"
	flats = "GRASS*", "RROCK*", "FLAT10"
}
surface brick
{
	walls = "BRICK*", "BIGBRIK*", "BRNBIG*", "BRNSMAL*", "BRNPOIS*", "ZZWOLF*", "SW?BRIK"
	flats = "FLAT8", "RROCK14"
}
surface marble
{
	walls = "MARBLE*", "MARBFAC*", "MARBFACE", "MARBGRAY", "MARBLOD1", "GSTONE*", "GSTFONT*", "GSTGARG"
	walls = "GSTLION", "GSTSATYR", "GSTVINE*", "SW?MARB", "SW?GSTON", "SW?GARG", "SW?LION", "SW?SATYR"
	flats = "DEM1_*", "FLOOR7_2", "GATE1", "GATE2", "GATE3"
}
surface tile
{
	flats = "FLAT20", "FLAT5", "FLOOR5_*", "FLAT9", "FLAT18"
}
surface pipe
{
	walls = "PIPE1", "PIPE2", "PIPE4", "PIPE6", "PIPES", "PIPEWAL*", "BROWNPIP", "SW?PIPE"
}
surface tech
{
	walls = "COMP2", "COMPBLUE", "COMPOHSO", "COMPSPAN", "COMPTILE", "TEKWALL*", "TEKGREN*", "TEKBRON*"
	walls = "SPACEW*", "MIDSPACE", "SW?BRCOM", "SW?COMM", "SW?COMP", "SW?TEK", "SW?BLUE"
	flats = "COMP01"
}
surface screen
{
	walls = "COMPSTA1", "COMPSTA2", "COMPTALL", "COMPUTE*", "COMPWERD", "PLANET1", "EXITSIGN", "SW?EXIT"
	flats = "CONS1_1", "CONS1_5", "CONS1_7"
}
surface light
{
	walls = "LITE2", "LITE3", "LITE4", "LITE5", "LITE96", "LITEBLU*", "LITEMET", "LITERED"
	walls = "LITESTON", "TEKLITE", "TEKLITE2", "BRICKLIT"
	flats = "TLITE6_1", "TLITE6_4", "TLITE6_5", "TLITE6_6", "FLOOR1_7", "FLAT2", "FLAT17", "FLAT22"
	flats = "CEIL1_2", "CEIL1_3", "CEIL3_4", "CEIL3_6", "GRNLITE1"
}
