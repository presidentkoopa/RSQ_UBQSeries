// from BD22 VR's MODELDEF.rsq (RS_Brutal22WeaponsQ), by tools/port/mdl.py: the gun class names are this pack's

Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQGS A 0 2	// Ermac hand.md3 frame 6
	FrameIndex RQGS B 0 3	// Ermac hand.md3 frame 19
	FrameIndex RQGS C 0 5	// Ermac hand.md3 frame 30
	FrameIndex RQGS D 0 6	// Ermac hand.md3 frame 47
	FrameIndex RQGS E 0 7	// Ermac hand.md3 frame 95
	FrameIndex RQGS F 0 8	// Ermac hand.md3 frame 106
	FrameIndex RQGS G 0 9	// Ermac hand.md3 frame 113
	FrameIndex RQGS H 0 4	// Ermac hand.md3 frame 29
	FrameIndex RQGT A 0 10	// index finger on the trigger
	FrameIndex RQGU A 0 11	// trigger squeezed
	FrameIndex RQGT B 0 12	// index finger on the trigger
	FrameIndex RQGU B 0 13	// trigger squeezed
	FrameIndex RQGT C 0 14	// index finger on the trigger
	FrameIndex RQGU C 0 15	// trigger squeezed
	FrameIndex RQGT D 0 16	// index finger on the trigger
	FrameIndex RQGU D 0 17	// trigger squeezed
	FrameIndex RQGT E 0 18	// index finger on the trigger
	FrameIndex RQGU E 0 19	// trigger squeezed
	FrameIndex RQGT F 0 20	// index finger on the trigger
	FrameIndex RQGU F 0 21	// trigger squeezed
	FrameIndex RQGT G 0 22	// index finger on the trigger
	FrameIndex RQGU G 0 23	// trigger squeezed
	FrameIndex RQGT H 0 24	// index finger on the trigger
	FrameIndex RQGU H 0 25	// trigger squeezed
	FrameIndex RQGT I 0 26	// index finger on the trigger
	FrameIndex RQGU I 0 27	// trigger squeezed
	FrameIndex RQGT J 0 28	// index finger on the trigger
	FrameIndex RQGU J 0 29	// trigger squeezed
	FrameIndex RQGT K 0 30	// index finger on the trigger
	FrameIndex RQGU K 0 31	// trigger squeezed
	FrameIndex RQGT L 0 32	// index finger on the trigger
	FrameIndex RQGU L 0 33	// trigger squeezed
	FrameIndex RQGT M 0 34	// index finger on the trigger
	FrameIndex RQGU M 0 35	// trigger squeezed
	FrameIndex RQGT N 0 36	// index finger on the trigger
	FrameIndex RQGU N 0 37	// trigger squeezed
	FrameIndex RQGT O 0 38	// index finger on the trigger
	FrameIndex RQGU O 0 39	// trigger squeezed
	FrameIndex RQGT P 0 40	// index finger on the trigger
	FrameIndex RQGU P 0 41	// trigger squeezed
	FrameIndex RQGT Q 0 42	// index finger on the trigger
	FrameIndex RQGU Q 0 43	// trigger squeezed
	FrameIndex RQGT R 0 44	// index finger on the trigger
	FrameIndex RQGU R 0 45	// trigger squeezed
}

