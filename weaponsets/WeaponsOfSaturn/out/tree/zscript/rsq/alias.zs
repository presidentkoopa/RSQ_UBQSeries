// GENERATED by tools/build.py: which BD22 gun each RSQWS_ gun stands for. BD22 VR's tables (hands, muzzle, recoil
// follow, reload geometry) are keyed by BD22's class names; this is the one place the two meet.
class RSQ_Alias abstract
{
	clearscope static Name BD(Weapon w)
	{
		if (!w)
			return 'None';
		Name n = w.GetClassName();
		if (n == 'RSQWS_Beretta' || n == 'RSQ_Off_RSQWS_Beretta')	return 'BrutalPistol';
		if (n == 'RSQWS_1911' || n == 'RSQ_Off_RSQWS_1911')	return 'BrutalPistol';
		return 'None';
	}

	// by exact class: an off-hand version is BD22 VR's off-hand version, not the gun
	clearscope static Name Exact(Weapon w)
	{
		if (!w)
			return 'None';
		Name n = w.GetClassName();
		if (n == 'RSQ_Off_RSQWS_Beretta')	return 'RSQ_Off_BrutalPistol';
		if (n == 'RSQ_Off_RSQWS_1911')	return 'RSQ_Off_BrutalPistol';
		return BD(w);
	}
}

// Start With Pistol and Shotgun (rsq_start_shotgun): the shotgun at the start, once a life
class RSQ_Started : Inventory { Default { Inventory.MaxAmount 1; +INVENTORY.UNDROPPABLE } }
class RSQ_Start : EventHandler
{
	override void PlayerEntered(PlayerEvent e)
	{
		let mo = players[e.PlayerNumber].mo;
		if (!mo || mo.CountInv('RSQ_Started') > 0)
			return;
		mo.GiveInventory('RSQ_Started', 1);
		let cv = CVar.FindCVar('rsq_start_shotgun');
		if (!cv || !cv.GetBool())
			return;
		Name sn = 'RSQWS_Riotgun';
		class<Inventory> c = sn;
		if (c && mo.CountInv(c) <= 0)
			mo.GiveInventory(c, 1);
	}
}

