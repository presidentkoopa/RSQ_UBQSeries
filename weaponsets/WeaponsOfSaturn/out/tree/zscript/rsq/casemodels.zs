// casemodels.zs (1.99, F7) -- GENERATED by tools/bd22_plus.py casemodels. Do not edit by hand.
//
// THE REAL CASING, LENT TO BRUTAL DOOM'S OWN ACTOR.
//
// F6 put the brass out of the right port, at the right size, and it was still Brutal Doom's
// sprite -- one `EmptyBrass` doing duty for 5.56, 7.62 and 7.92. RS_Ballistics has the actual
// measured casings: casing_9mm.md3 at 19.2 mm, casing_rifle.md3 at 44.7, shell_12ga.md3 at
// 70.06, each with its brass, its inner wall and its primer skinned separately.
//
// WHY IT IS A LEND AND NOT A REPLACEMENT. BD22's spawners name "PistolCasing", "EmptyBrass" and
// "ShotgunCasing" as string literals, so a subclass is never reached; replacing the classes
// outright means owning actors/MISC/Casing.dec, which also defines 20mmBrass, 40mmBrass, five
// EmptyClip variants, UnderwaterEmptyBrass, EnemyMinigunBrass and nine spawners, with ACS
// janitor hooks hanging off them. And it could not be switched off.
//
// `A_ChangeModel` lends another class's MODELDEF to a live actor and gives it back, which is
// stock (actor.zs, p_actionfunctions.cpp) and which this pack already does twice -- voxels.zs
// lends voxel holders, and RSQ_Debris draws RS meshes the same way. The holder's FrameIndex rows
// name BD22'S OWN SPRITE, so the engine resolves (borrowed class, the actor's live sprite, the
// actor's live frame) and the casing tumbles through BD's own animation wearing our mesh.
//
// ONE CLASS, FOUR CARTRIDGES. `EmptyBrass` is thrown by the Rifle (5.56), the Minigun (5.56), the
// Machinegun (7.62) and the MG42 (7.92). A MODELDEF block written straight onto EmptyBrass could
// only ever be one of them, and would fire whether the option was on or off. Lending per INSTANCE
// is the only way to give the same class four different casings, and it is why this route is the
// right one rather than merely the clever one.
//
// SCALE. models.cpp multiplies the actor's own Scale into the MODELDEF's, so a lent model must be
// drawn on an actor at scale 1. F6's per-cartridge SPRITE sizing was a stand-in for not having
// real meshes; where a mesh is lent it is superseded and the actor goes to 1.0. Where none is
// lent -- MGLinks, or the option off -- F6's sizing still applies.
//
// `rsq_casing_size` is a multiplier on top, default 1.0 = true size. A real 9mm case is 19.2 mm,
// which at vr_vunits_per_meter is about 0.63 map units: correct, and possibly too small to see at
// arm's length. Raising it keeps every cartridge's proportion to every other.

// a mount point: it draws nothing of its own, it exists so MODELDEF has a class to hang
// casing_9mm.md3 on and A_ChangeModel has something to name.
class RSQ_Case9mm : Actor
{
	Default { +NOINTERACTION; +NOBLOCKMAP; RenderStyle "None"; }
	States { Spawn: TNT1 A -1; Stop; }
}

// a mount point: it draws nothing of its own, it exists so MODELDEF has a class to hang
// casing_rifle.md3 on and A_ChangeModel has something to name.
class RSQ_Case556 : Actor
{
	Default { +NOINTERACTION; +NOBLOCKMAP; RenderStyle "None"; }
	States { Spawn: TNT1 A -1; Stop; }
}

// a mount point: it draws nothing of its own, it exists so MODELDEF has a class to hang
// casing_rifle.md3 on and A_ChangeModel has something to name.
class RSQ_Case762 : Actor
{
	Default { +NOINTERACTION; +NOBLOCKMAP; RenderStyle "None"; }
	States { Spawn: TNT1 A -1; Stop; }
}

// a mount point: it draws nothing of its own, it exists so MODELDEF has a class to hang
// shell_12ga.md3 on and A_ChangeModel has something to name.
class RSQ_Hull12ga : Actor
{
	Default { +NOINTERACTION; +NOBLOCKMAP; RenderStyle "None"; }
	States { Spawn: TNT1 A -1; Stop; }
}

class RSQ_CaseModels abstract play
{
	// which mesh this gun's brass really is. '' = none, and BD22's own sprite is left alone.
	static Name Holder(Name gun, Name casing)
	{
		if (gun == 'BrutalPistol' && casing == 'PistolCasing')
			return 'RSQ_Case9mm';
		if (gun == 'BrutalSMG' && casing == 'PistolCasing')
			return 'RSQ_Case9mm';
		if (gun == 'MP40' && casing == 'PistolCasing')
			return 'RSQ_Case9mm';
		if (gun == 'Rifle' && casing == 'EmptyBrass')
			return 'RSQ_Case556';
		if (gun == 'Minigun' && casing == 'EmptyBrass')
			return 'RSQ_Case556';
		if (gun == 'Machinegun' && casing == 'EmptyBrass')
			return 'RSQ_Case762';
		if (gun == 'MG42' && casing == 'EmptyBrass')
			return 'RSQ_Case762';
		if (gun == 'Shot_Gun' && casing == 'ShotgunCasing')
			return 'RSQ_Hull12ga';
		if (gun == 'AssaultShotgun' && casing == 'ShotgunCasing')
			return 'RSQ_Hull12ga';
		if (gun == 'SSG' && casing == 'ShotgunCasing')
			return 'RSQ_Hull12ga';
		if (gun == 'Revolver' && casing == 'ShotgunCasing')
			return 'RSQ_Hull12ga';
		return 'None';
	}

	static bool Lend(Actor c, Name gun, Name casing)
	{
		if (!c)
			return false;
		Name h = Holder(gun, casing);
		if (h == 'None')
			return false;
		let cv = CVar.FindCVar('rsq_casing_models');
		if (cv && cv.GetInt() == 0)
			return false;
		// F11: the voxel casings option wins (voxels.zs lends the voxel next, at the actor's scale)
		let vc = consoleplayer >= 0 && consoleplayer < MAXPLAYERS ? CVar.GetCVar('rsq_vox_casings', players[consoleplayer]) : null;
		if (vc && vc.GetBool())
			return false;
		c.A_ChangeModel(h);
		// the actor's Scale multiplies the MODELDEF's, so a real-sized mesh needs 1.0 here --
		// and F6's per-cartridge sprite sizing is superseded for this casing.
		double k = 1.0;
		let sz = CVar.FindCVar('rsq_casing_size');
		if (sz)
			k = clamp(sz.GetFloat(), 0.25, 4.0);
		c.A_SetScale(k, k);
		return true;
	}
}
