// handtone.zs (BD 2.0, owner 2026-10-27 20:05 / 21:2x): "Hand Skin Tone", 18 steps, on EVERY FBX hand.
//
// THE TONES are pre-tinted copies of models/rsq/fbx/fbx_hand.png, made by tools/handtones.py (Lab
// recolour against the texture's own mean, so the shading survives; never hand-painted):
// models/rsq/fbx/tones/fbx_hand_tNN.png. Step 0 is the texture as drawn.
//
// HOW THEY ARE WORN (measured on the 17.3 rig): A_ChangeModel's skin override re-skins a HUD model
// (RenderHUDModel reads the psprite caller's modelData), but per ACTOR and per MODEL SLOT. One actor
// often draws an FBX hand next to a gun (dual-wield RSQ_Off_*, the rsqdual and Purist weapons) or next
// to Ermac's hands (RSQ_GunSide, RSQ_Hands), all in slot 0. So the build (tools/handtone_build.py)
// moves every FBX-hand MODELDEF block to model slot 7, which nothing else uses. The tone is then the
// skin override of slot 7 on every actor that has such a block: only FBX hands change; the guns and
// Ermac's hands (slot 0) never do.
//
// WHICH ACTORS: read at startup from the loaded MODELDEF lumps (every block with Skin 7
// "fbx_hand.png"), so the hand rows other lanes edit need nothing regenerated by hand. Each tic the
// player's inventory and the callers of the player's psprites are matched against that list, and
// A_ChangeModel is called only when what an actor wears changes.
//
// rsq_hand_tone is a user cvar (your own hands); the hands are off in multiplayer (hands.zs).

class RSQ_HandTone : EventHandler
{
	const TONES = 18;		// 0 as drawn, 1..17 (tools/handtones.py TONES)
	const SLOT = 7;			// tools/handtone_build.py HAND_SLOT

	Array<Name> fbxClass;	// every actor class with an FBX-hand block
	bool parsed;

	Array<Actor> worn;
	Array<int> wornTone;

	override void OnRegister()
	{
		SetOrder(1001);
	}

	// ---------------------------------------------------------------- which classes, from MODELDEF
	void Parse()
	{
		parsed = true;
		int lump = -1;
		while ((lump = Wads.FindLump("MODELDEF", lump + 1, Wads.AnyNamespace)) != -1)
			ParseLump(Wads.ReadLump(lump));
	}

	static String StripComments(String s)
	{
		String o = "";
		int i = 0, n = s.Length();
		while (i < n)
		{
			int c = s.ByteAt(i);
			if (c == 0x2F && i + 1 < n && s.ByteAt(i + 1) == 0x2F)
			{
				while (i < n && s.ByteAt(i) != 0x0A)
					i++;
				continue;
			}
			if (c == 0x2F && i + 1 < n && s.ByteAt(i + 1) == 0x2A)
			{
				int e = s.IndexOf("*/", i + 2);
				i = e < 0 ? n : e + 2;
				continue;
			}
			o.AppendCharacter(c);
			i++;
		}
		return o;
	}

	void ParseLump(String raw)
	{
		String t = StripComments(raw);
		t.ToLower();
		t.Replace("\t", " ");
		t.Replace("\r", " ");
		t.Replace("\n", " ");
		String want = String.Format("skin %d \"fbx_hand.png\"", SLOT);
		String wantDir = String.Format("skin %d \"fbx/fbx_hand.png\"", SLOT);	// 2.0.2: the M203 round hold (MODELDEF.rsm)
		int at = 0;
		while (true)
		{
			int m = t.IndexOf("model ", at);
			if (m < 0)
				break;
			int ob = t.IndexOf("{", m);
			if (ob < 0)
				break;
			int cb = t.IndexOf("}", ob);
			if (cb < 0)
				break;
			at = cb + 1;
			String body = t.Mid(ob + 1, cb - ob - 1);
			if (body.IndexOf(want) < 0 && body.IndexOf(wantDir) < 0)
				continue;
			String head = t.Mid(m + 6, ob - m - 6);
			head.Replace(" ", "");
			Name cn = head;
			if (fbxClass.Find(cn) == fbxClass.Size())
				fbxClass.Push(cn);
		}
	}

	bool HasFbx(Actor a)
	{
		return a && fbxClass.Find(a.GetClassName()) < fbxClass.Size();
	}

	// ---------------------------------------------------------------- per tic
	override void WorldTick()
	{
		if (multiplayer)
			return;
		let pl = players[consoleplayer];
		if (!pl.mo)
			return;
		if (!parsed)
			Parse();
		let cv = CVar.GetCVar('rsq_hand_tone', pl);
		int tone = cv ? clamp(cv.GetInt(), 0, TONES - 1) : 0;
		for (let it = pl.mo.Inv; it; it = it.Inv)
			if (HasFbx(it))
				Wear(it, tone);
		for (let p = pl.psprites; p; p = p.Next)
			if (HasFbx(p.Caller))
				Wear(p.Caller, tone);
	}

	// skin 'None' / path "" = back to MODELDEF's own fbx_hand.png
	void Wear(Actor a, int tone)
	{
		int k = worn.Find(a);
		if (k < worn.Size() && wornTone[k] == tone)
			return;
		if (tone > 0)
			a.A_ChangeModel('None', SLOT, "", 'None', SLOT, "models/rsq/fbx/tones/", Name(String.Format("fbx_hand_t%02d.png", tone)));
		else if (k < worn.Size())
			a.A_ChangeModel('None', SLOT, "", 'None', SLOT, "", 'None');
		if (k < worn.Size())
			wornTone[k] = tone;
		else
		{
			worn.Push(a);
			wornTone.Push(tone);
		}
	}
}
