// generated by tools/gen_pump.py (RSR-PUMP) -- do not edit by hand
// Hand-loaded shells and a hand-worked pump: per gun. Positions cm in the weapon controller's
// frame (F, L, U); hooks are ModifyBobLayer3D translations for the gun's own MODELDEF placement.

class RSP_Guns abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		Name n = RSQ_Alias.Exact(w);
		if (n == 'Shot_Gun')	return 1;
		if (n == 'VR_Shotgun')	return 2;
		return 0;
	}

	clearscope static Vector3 Grab(int i)
	{
		switch (i)
		{
		case 1:	return (44.203, 8.748, -2.605);	// shotguns: moved with the gun to the FBX hand (was (40.100, 0.000, -2.800))
		case 2:	return (34.500, -0.000, 1.300);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Pull(int i)
	{
		switch (i)
		{
		case 1:	return (-0.996, -0.067, -0.061);	// shotguns: moved with the gun to the FBX hand (was (-1.000, 0.000, -0.002))
		case 2:	return (-1.000, -0.000, 0.002);
		}
		return (0, 0, 0);
	}

	clearscope static double Travel(int i)
	{
		switch (i)
		{
		case 1:	return 6.400;
		case 2:	return 10.200;
		}
		return 0;
	}

	clearscope static Vector3 PumpHook(int i)
	{
		switch (i)
		{
		case 1:	return (-0.067, -0.061, 0.996);	// shotguns: moved with the gun to the FBX hand (was (0.000, -0.002, 1.000))
		case 2:	return (0.000, 0.001, 0.741);
		}
		return (0, 0, 0);
	}

	clearscope static double BoltRatio(int i)
	{
		switch (i)
		{
		case 1:	return 1.000;
		case 2:	return 0.000;
		}
		return 0;
	}

	clearscope static Vector3 SupportHook(int i)
	{
		switch (i)
		{
		case 1:	return (-0.067, -0.061, 0.996);	// shotguns: moved with the gun to the FBX hand (was (0.000, -0.002, 1.000))
		case 2:	return (-0.000, 0.002, 1.000);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Port(int i)
	{
		switch (i)
		{
		case 1:	return (23.187, 7.333, -3.842);	// shotguns: moved with the gun to the FBX hand (was (19.000, 0.000, -2.800))
		case 2:	return (12.500, -0.500, 3.300);
		}
		return (0, 0, 0);
