		switch (i)
		{
		case 1:	return (0.996, 0.067, 0.059);	// shotguns: moved with the gun to the FBX hand (was (1.000, 0.000, 0.000))
		case 2:	return (0.892, 0.429, -0.140);
		}
		return (0, 0, 0);
	}

	clearscope static double Depth(int i)
