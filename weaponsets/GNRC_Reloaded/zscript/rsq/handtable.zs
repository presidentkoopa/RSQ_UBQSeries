// generated by rsq_hands_gen_melee.py (rsq_hands_gen.py + axe / chainsaw) from fits_bd22_v9.json -- do not edit by hand
// Per gun: gun-hand frame (one hand, two hands), its hook and rotation, support frame, its hook
// and rotation (ModifyBobLayer3D units), and where the support hand holds the gun
// (metres in the gun hand's frame: forward, left, up).

// 1.30 (owner): the rifle (index 18) is held by the M203 tube: support pose C, fitted under the
// tube clear of the barrel (kitbash/supsearch3.py, supview.py).
class RSQ_HandTable abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		if (RSQ_Alias.BD(w) == 'AssaultShotgun')	return 1;
		if (RSQ_Alias.BD(w) == 'BFG10k')	return 2;
		if (RSQ_Alias.BD(w) == 'BIG_FUCKING_GUN')	return 3;
		if (RSQ_Alias.BD(w) == 'BrutalPistol')	return 4;
		if (RSQ_Alias.BD(w) == 'BrutalSMG')	return 5;
		if (RSQ_Alias.BD(w) == 'Devastator')	return 6;
		if (RSQ_Alias.BD(w) == 'Flamethrower2')	return 7;
		if (RSQ_Alias.BD(w) == 'GrenadeLauncher')	return 8;
		if (RSQ_Alias.BD(w) == 'HellishMissileLauncher')	return 9;
		if (RSQ_Alias.BD(w) == 'IncendiaryLauncher')	return 10;
		if (RSQ_Alias.BD(w) == 'MG42')	return 11;
		if (RSQ_Alias.BD(w) == 'MP40')	return 12;
		if (RSQ_Alias.BD(w) == 'Minigun')	return 13;
		if (RSQ_Alias.BD(w) == 'NukeLauncher')	return 14;
		if (RSQ_Alias.BD(w) == 'Plasma_Gun')	return 15;
		if (RSQ_Alias.BD(w) == 'RailGun')	return 16;
		if (RSQ_Alias.BD(w) == 'Revolver')	return 17;
		if (RSQ_Alias.BD(w) == 'BrutalRevolver')	return 17;	// r5: the Moonlight sits in this fit: the Depot hand-fitted it to the same palm (rig, reference/moonlight)
		if (RSQ_Alias.BD(w) == 'Rifle')	return 18;
		if (RSQ_Alias.BD(w) == 'Rocket_Launcher')	return 19;
		if (RSQ_Alias.BD(w) == 'SSG')	return 20;
		if (RSQ_Alias.BD(w) == 'Shot_Gun')	return 21;
		if (RSQ_Alias.BD(w) == 'Sniper')	return 22;
		if (RSQ_Alias.BD(w) == 'Unmaker')	return 23;
		if (RSQ_Alias.BD(w) == 'BrutalAxe')	return 24;
		if (RSQ_Alias.BD(w) == 'Chain_saw')	return 25;
		if (RSQ_Alias.BD(w) == 'DSweap')	return 26;
		if (RSQ_Alias.BD(w) == 'Machinegun')	return 27;	// 1.97: the BD21 Machinegun (c2q/bd22_mg.py: kit ICP on the REMA card's palm / supportat)	// 2026-10-23: the Dragonslayer, two-handed (work/ds_fit.py)
		if (RSQ_Alias.BD(w) == 'FlameCannon')	return 28;	// r12 port: the arm-worn FlameCannon (owner item 21): no gun hand, its support hand only
		return 0;
	}

