// bullet.zs (1.97, F6) -- GENERATED by tools/bd22_plus.py bullet. Do not edit by hand.
//
// The round you can see. F5 built this and could never fire it: it was written to RIDE a player
// projectile, and every cartridge gun in Brutal Doom is HITSCAN -- there is no projectile to ride.
// It shipped as dead code. It now flies the shot itself, from the muzzle to the point the hitscan
// actually landed, which WorldHitscanFired hands us as e.AttackPos and e.DamagePosition.
//
// RS_Ballistics' own btracer.obj at the size its cartridge calls for. Purely a look: it never
// collides, never damages, never blocks. It turns to face its own velocity, which is what
// USEACTORPITCH / USEACTORROLL in the MODELDEF are for -- the tube lies along the flight instead
// of wherever the gun pointed when it spawned.
//
// SPEED IS THE AUTHORED ONE AND THAT MEANS IT IS FAST. `ballistics.speed` is metres per second --
// 340 for a 9mm, 900 for 5.56 -- which at vr_vunits_per_meter is 330 to 874 MAP UNITS PER TIC. A
// round crosses an ordinary room in about one tic, so what you see is a streak, not a dart. That
// is what a real tracer looks like and it is what the data says, so it is not quietly slowed
// here. `rsq_round_speed` is the slider if you want to read it in the headset: 1.0 is the data,
// lower is slower. It does not touch where anything lands -- the hitscan has already hit.
//
// Eleven guns name a model to draw. The rockets, the plasma and both BFGs say `look = none` in
// their roundlook and correctly get nothing: they are projectiles and already have their own.
//
// Rides rsq_ballistics like the rest of the pack's effects.

class RSQ_Bullet : Actor
{
	Default
	{
		+NOINTERACTION;
		+NOBLOCKMAP;
		+NOGRAVITY;
		+DONTSPLASH;
		RenderStyle "Normal";
	}

	Vector3 step;
	int ttl;

	// point it along a velocity, so the tube lies on the flight
	void FaceVel(Vector3 v)
	{
		double sp = v.Length();
		if (sp <= 0)
			return;
		angle = VectorAngle(v.x, v.y);
		pitch = -asin(clamp(v.z / sp, -1, 1));
	}

	// +NOINTERACTION means nothing moves this actor for us, which is the point: it must not
	// collide with anything on the way. So it is walked by hand and retired on arrival.
	override void Tick()
	{
		if (ttl <= 0)
		{
			Destroy();
			return;
		}
		ttl--;
		SetOrigin(pos + step, true);
	}

	// per gun: the frame its roundlook names, and the speed its ballistics give in map units a tic
	static int FrameOf(Name gun)
	{
		if (gun == 'BrutalPistol')
			return 0;	// RSBMA
		if (gun == 'Revolver')
			return 0;	// RSBMA
		if (gun == 'Shot_Gun')
			return 5;	// RSBMF
		if (gun == 'SSG')
			return 5;	// RSBMF
		if (gun == 'MP40')
			return 1;	// RSBMB
		if (gun == 'MG42')
			return 3;	// RSBMD
		if (gun == 'AssaultShotgun')
			return 5;	// RSBMF
		if (gun == 'BrutalSMG')
			return 1;	// RSBMB
		if (gun == 'Machinegun')
			return 3;	// RSBMD
		if (gun == 'Minigun')
			return 2;	// RSBMC
		if (gun == 'Rifle')
			return 2;	// RSBMC
		return -1;
	}

	static double SpeedOf(Name gun)
	{
		if (gun == 'BrutalPistol')
			return 330.3;	// 340 m/s
		if (gun == 'Revolver')
			return 388.6;	// 400 m/s
		if (gun == 'Shot_Gun')
			return 369.1;	// 380 m/s
		if (gun == 'SSG')
			return 369.1;	// 380 m/s
		if (gun == 'MP40')
			return 330.3;	// 340 m/s
		if (gun == 'MG42')
			return 777.1;	// 800 m/s
		if (gun == 'AssaultShotgun')
			return 369.1;	// 380 m/s
		if (gun == 'BrutalSMG')
			return 330.3;	// 340 m/s
		if (gun == 'Machinegun')
			return 777.1;	// 800 m/s
		if (gun == 'Minigun')
			return 874.3;	// 900 m/s
		if (gun == 'Rifle')
			return 874.3;	// 900 m/s
		return 0;
	}

	static void Fire(Actor src, Vector3 from, Vector3 to, Name gun)
	{
		int fr = FrameOf(gun);
		double sp = SpeedOf(gun);
		if (!src || fr < 0 || sp <= 0)
			return;
		Vector3 d = level.Vec3Diff(from, to);
		double dist = d.Length();
		if (dist < 1)
			return;
		let cv = CVar.FindCVar('rsq_round_speed');
		double k = cv ? clamp(cv.GetFloat(), 0.02, 1.0) : 1.0;
		sp *= k;
		let b = RSQ_Bullet(Actor.Spawn('RSQ_Bullet', from));
		if (!b)
			return;
		b.frame = fr;
		// Step by dist/ttl, NOT by the raw speed. At 777 units a tic a 400-unit shot has ttl 1,
		// and a raw step would fly it 777 units -- clean past the wall it just hit. Dividing the
		// distance by the whole tics instead lands it exactly on the impact; the only tic that is
		// slower than the authored speed is the last one.
		b.ttl = max(1, int(ceil(dist / sp)));
		b.step = d / b.ttl;
		b.FaceVel(b.step);
	}

	States
	{
	Spawn:
		RSBM A -1;		// the frame is set by Fire(); RSBM draws nothing on its own
		Stop;
	}
}
