// GENERATED by tools/build.py: this pack's dual wield table (BD22 VR's RSQ_DualTable, its guns)
class RSQ_DualTable play
{
	const COUNT = 5;
	const AXE = 99;	// no dual axe here
	clearscope static Name Gun(int i)
	{
		static const Name v[] = { 'RSQGW_Beretta', 'RSQGW_ARifle', 'RSQGW_PlasRifle', 'RSQGW_Riotgun', 'RSQGW_DoubleSG' };
		return v[i];
	}
	clearscope static Name Copy(int i)
	{
		static const Name v[] = { 'RSQ_Off_RSQGW_Beretta', 'RSQ_Off_RSQGW_ARifle', 'RSQ_Off_RSQGW_PlasRifle', 'RSQ_Off_RSQGW_Riotgun', 'RSQ_Off_RSQGW_DoubleSG' };
		return v[i];
	}
	static Name Mag(int i)
	{
		static const Name v[] = { 'RSQGW_PistolMagOff', 'RSQGW_RifleMagOff', 'RSQGW_PlasmaMagOff', 'RSQGW_ShotgunMagOff', 'RSQGW_DBSGMagOff' };
		return v[i];
	}
	static int MagMax(int i)
	{
		static const int v[] = { 11, 31, 60, 8, 2 };
		return v[i];
	}
	static Name CVarName(int i)
	{
		static const Name v[] = { 'rsq_dual_0', 'rsq_dual_1', 'rsq_dual_2', 'rsq_dual_3', 'rsq_dual_4' };
		return v[i];
	}
	static String Nice(int i)
	{
		static const String v[] = { "Pistol", "Assault Rifle", "Plasma Rifle", "Riot Shotgun", "Double-Barrel Shotgun" };
		return v[i];
	}
	// a second one of a gun picked up: the pickup is the gun itself
	static int PickupGun(Name n)
	{
		if (n == 'RSQGW_Beretta') return 0;
		if (n == 'RSQGW_ARifle') return 1;
		if (n == 'RSQGW_PlasRifle') return 2;
		if (n == 'RSQGW_Riotgun') return 3;
		if (n == 'RSQGW_DoubleSG') return 4;
		return -1;
	}
}

// the Dual Wield key (KEYCONF: netevent rsq_dual): the held gun's off-hand version into the off hand, or the hands back
class RSQ_DualKey : EventHandler
{
	override void NetworkProcess(ConsoleEvent e)
	{
		if (!(e.Name ~== "rsq_dual") || e.Player < 0 || e.Player >= MAXPLAYERS || !playeringame[e.Player] || !players[e.Player].mo)
			return;
		RSQ_Dual.Toggle(players[e.Player].mo);
	}
}
