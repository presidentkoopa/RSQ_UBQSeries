// from BD22 VR's MODELDEF.rsm (RS_Brutal22WeaponsQ), by tools/port/mdl.py: the gun class names are this pack's

Model RSQGW_ARifle
{
	Path "models/bd/Rifle"
	Model 0 "Rifle.md3"
	Skin 0 "Rifle.png"
	Model 1 "M203.md3"
	SurfaceSkin 1 0 "M203.png"
	SurfaceSkin 1 1 "M203.png"
	SurfaceSkin 1 2 "M203.png"
	SurfaceSkin 1 3 "rsr_clear.png"
	Scale -1.0 1.0 1.0
	Offset 0.348 -5.912 0.0
	ZOffset -1.812
	AngleOffset 3.854
	PitchOffset 3.363
	RollOffset 10.974	// batch 4 (lane B): gun to the FBX hand fitted from 1.92
	NoInterpolation
	FrameIndex RQ2T A 0 3
	FrameIndex RQ2T A 1 3
}

