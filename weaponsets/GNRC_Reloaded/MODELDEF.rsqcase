// 1.99 F7: RS_Ballistics' measured casings, lent to BD22's own casing actors at run
// time by RSQ_CaseModels. Each FrameIndex names BD22'S sprite, because A_ChangeModel
// resolves (borrowed class, the actor's live sprite, the actor's live frame).

Model RSQ_Case9mm	// 9x19, 19.2 mm
{
	Path "models/rsq/casings"
	Model 0 "casing_9mm.md3"
	SurfaceSkin 0 0 "casing_brass.png"
	SurfaceSkin 0 1 "casing_inner.png"
	SurfaceSkin 0 2 "casing_primer.png"
	Scale 0.03279 0.03279 0.03279
	USEACTORPITCH
	USEACTORROLL
	FrameIndex CAS1 A 0 0
	FrameIndex CAS1 B 0 0
	FrameIndex CAS1 C 0 0
	FrameIndex CAS1 D 0 0
	FrameIndex CAS1 E 0 0
	FrameIndex CAS1 F 0 0
	FrameIndex CAS1 G 0 0
	FrameIndex CAS1 H 0 0
	FrameIndex CAS1 I 0 0
	FrameIndex CAS1 J 0 0
	FrameIndex CAS1 K 0 0
	FrameIndex CAS1 L 0 0
	FrameIndex CAS1 M 0 0
	FrameIndex CAS1 N 0 0
}

