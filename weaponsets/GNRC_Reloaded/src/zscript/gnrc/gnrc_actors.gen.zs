// from ammo.txt: ACTOR ShellSpawner
class RSQGW_ShellSpawner : Actor replaces Shell
{
	Default
	{
		-COUNTITEM;
	}
	States
	{
	Spawn:
		TNT1 A 0 A_JumpIf(1==1, 2);
		TNT1 A 0 A_JumpIf(1==0, "FourSpawn");
		TNT1 A 0 A_SpawnItemEx("RSQGW_SingleShell", frandom(-16,16), frandom(-16,16), 0, velx, vely, velz, 0, SXF_NOCHECKPOSITION);
		TNT1 A 0 A_SpawnItemEx("RSQGW_SingleShell2", frandom(-16,16), frandom(-16,16), 0, velx, vely, velz, 0, SXF_NOCHECKPOSITION);
		TNT1 A 0 A_SpawnItemEx("RSQGW_SingleShell3", frandom(-16,16), frandom(-16,16), 0, velx, vely, velz, 0, SXF_NOCHECKPOSITION);
		TNT1 A 0 A_SpawnItemEx("RSQGW_SingleShell4", frandom(-16,16), frandom(-16,16), 0, velx, vely, velz, 0, SXF_NOCHECKPOSITION);
		Stop;
	FourSpawn:
		TNT1 A 0 A_SpawnItemEx("RSQGW_FourShells", 0, 0, 0, velx, vely, velz);
		Stop;
	}
}

