class RSQGW_GunSmoke : Actor
{
	Default
	{
		+NOGRAVITY;
		+NOBLOCKMAP;
		+FLOORCLIP;
		+FORCEXYBILLBOARD;
		+NOINTERACTION;
		+DONTSPLASH;
		+INTERPOLATEANGLES;
		+MISSILE;
		Speed 1;
		VSpeed 0.25;
		RenderStyle "Add";
		Alpha 0.06;
		+CLIENTSIDEONLY;
		Radius 0;
		Height 0;
		Scale 0.5;
	}
	States
	{
	Spawn:
		TNT1 A 1;
		TNT1 A 0 A_JumpIf(1==0, 12);
		SMKE ABCDEFGHIJK 1 A_FadeOut(0.005);
		TNT1 A 0;
		Stop;
	}
}

// }
