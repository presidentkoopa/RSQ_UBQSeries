// from ammo.txt: ACTOR ActualAmmoBox
class RSQGW_ActualAmmoBox : CustomInventory
{
	Default
	{
		Inventory.PickupSound "items/clipb";
		Inventory.PickupMessage "Picked up a box of ammo.";
	}
	States
	{
	Spawn:
		AMMO A -1;
		Stop;
	Pickup:
		TNT1 A 0 A_GiveInventory("RSQGW_RifleAmmo", 30);
		TNT1 A 0 A_GiveInventory("RSQGW_Nato", 75);
		TNT1 A 0 A_GiveInventory("RSQGW_PistolAmmo", 45);
		Stop;
	}
}

