// from projectiles.txt: ACTOR Rocket2
class RSQGW_Rocket2 : Actor
{
	Default
	{
		Radius 10;
		Height 8;
		Speed 45;
		Damage 20;
		Decal "Scorch";
		Projectile;
		Gravity 1.0;
		SeeSound "none";
		//DeathSound "weapons/launcher/hit"
		Obituary "$OB_MPROCKET";
		+FORCEXYBILLBOARD;
	}
	States
	{
	Spawn:
		MSLE A 1 Bright;
		Loop;
	Death:
		TNT1 A 0 A_Explode;
		TNT1 A 0 A_StartSound("barrel/explode", CHAN_AUTO, 0, 1, 0.6);
		TNT1 A 0 Radius_Quake(2, 8, 0, 7, 0);
		FLXP ABCDEFGH 1 Bright;
		TNT1 A 0 A_StartSound("rocket/distexp", 6, 0, 0.75, ATTN_NONE);
		FLXP IJKLMNOPQRSTUVWXYZ 1 Bright;
		Stop;
	}
}

