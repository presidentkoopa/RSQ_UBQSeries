	{
		Scale 0.185;
	}
}

// from smoke.txt: ACTOR ShotSmoke
class RSQGW_ShotSmoke : Actor
{
	Default
	{
		+NOGRAVITY;
		+NOBLOCKMAP;
		+FLOORCLIP;
		+FORCEXYBILLBOARD;
		+CLIENTSIDEONLY;
		+NOINTERACTION;
		+DONTSPLASH;
		+INTERPOLATEANGLES;
		+MISSILE;
		RenderStyle "Add";
		Scale 0.25;
		Alpha 0.115;
		Radius 0;
		Height 0;
		Speed 1;
	}
	States
	{
	Spawn:
		TNT1 A 1 A_SetTranslucent(0.1);
		TNT1 A 0 A_JumpIf(1==0, 19);
		SMOK ABCDEFGHIJKLMNOPQR 1 A_FadeOut(0.005);
		TNT1 A 0;
		Stop;
	}
}

