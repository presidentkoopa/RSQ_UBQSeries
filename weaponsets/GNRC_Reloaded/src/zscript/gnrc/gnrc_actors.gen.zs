// from chainsaw.txt: ACTOR ChainsawPuff
class RSQGW_ChainsawPuff : Actor
{
	Default
	{
		+DONTSPLASH;
		Scale 0.15;
		Alpha 0.6;
		SeeSound "saw/flesh";
	}
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_SpawnItemEx("RSQGW_RicochetSaw", 0, 0, 0);
		PUFF ABCD 1 bright;
		TNT1 A 0;
		Stop;
	}
}

// }
// from chainsaw.txt: ACTOR RicochetSaw
class RSQGW_RicochetSaw : Actor
{
	Default
	{
		+DONTSPLASH;
	}
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_StartSound("weapons/chainsaw/hitwall", CHAN_BODY);
		TNT1 AAAAAAAA 0 A_SpawnProjectile("RSQGW_RicochetSpark", 0, 0, random(0,360), 2, random(10,60));
		Stop;
	}
}

// }
// from chainsaw.txt: ACTOR RicochetSpark
class RSQGW_RicochetSpark : Actor
{
	Default
	{
		BounceType "None";
		-NOGRAVITY;
		+DONTSPLASH;
		RenderStyle "ADD";
		Alpha 1.0;
		Speed 10;
		Radius 3;
		Height 3;
		Scale .03;
		Gravity 1.0;
	}
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 Thing_ChangeTID(0,390);
		SPRK ABCD 1 bright A_FadeOut(0.05);
		Loop;
	}
}

