// from ammo.txt: ACTOR Backpack2
class RSQGW_Backpack2 : CustomInventory
{
	Default
	{
		Inventory.PickupSound "items/bpack";
		Inventory.PickupMessage "$GOTBACKPACK";
		+INVENTORY.NOSCREENFLASH;
	}
	States
	{
	Spawn:
		BPAK A -1;
		Stop;
	Pickup:
		TNT1 A 0 A_GiveInventory("Backpack", 1);
		TNT1 A 0 A_SetBlend("Yellow", 0.30, 35);
		Stop;
	}
}

