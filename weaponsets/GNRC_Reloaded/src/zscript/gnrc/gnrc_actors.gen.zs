// from chainsaw.txt: ACTOR ChainsawPuffSpawner
class RSQGW_ChainsawPuffSpawner : Actor
{
	Default
	{
		+DONTSPLASH;
		+NOGRAVITY;
		+NOINTERACTION;
		Decal "ChainsawMark";
		DamageType "Saw";
	}
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_SpawnItemEx("RSQGW_ChainsawPuff", 0, 0, -14);
		Stop;
	}
}

