// from BD22 VR's MODELDEF.rsr (RS_Brutal22WeaponsQ), by tools/port/mdl.py: the gun class names are this pack's

Model RSQWS_MachineRifle
{
	Path "models/bd/Rifle"
	Model 0 "Rifle.md3"
	SurfaceSkin 0 0 "Rifle.png"
	SurfaceSkin 0 1 "Rifle.png"
	SurfaceSkin 0 2 "Rifle.png"
	SurfaceSkin 0 3 "rsr_clear.png"
	SurfaceSkin 0 4 "Rifle.png"
	SurfaceSkin 0 5 "Rifle.png"
	Model 1 "M203.md3"	// 1.30: the M203 stays on the gun while the hand reloads it
	SurfaceSkin 1 0 "M203.png"
	SurfaceSkin 1 1 "M203.png"
	SurfaceSkin 1 2 "M203.png"
	SurfaceSkin 1 3 "M203.png"
	Scale -1.0000 1.0000 1.0000
	Offset 0.348 -5.912 0.0
	ZOffset -1.812
	AngleOffset 3.854
	PitchOffset 3.363
	RollOffset 10.974	// batch 4 (lane B): gun to the FBX hand fitted from 1.92
	NoInterpolation
	FrameIndex RQRM A 0 3
	FrameIndex RQRM A 1 3
}

