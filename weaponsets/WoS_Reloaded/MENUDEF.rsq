// RS VR hands and real reload (zscript/rsq, zscript/rsr), in BD22 VR's menu style: a list of options, no help text.
// Only options that do something in this build are listed.
AddOptionMenu "OptionsMenu"
{
	Submenu "Weapons of Saturn VR", "RSQ_Options"
}

OptionValue "RSR_ReloadMode"
{
	1, "VR"
	0, "Stock"
}

OptionValue "RSR_GrabWith"
{
	0, "Off-hand trigger"
	1, "Off-hand grip"
	2, "Use key"
}

OptionValue "RSR_Pouch"
{
	0, "Anywhere, 20 cm from the gun"
	1, "Low, 40 cm below the eyes"
	2, "Tactical Rig's pouch"
}

OptionValue "RSR_ShellCredit"
{
	1, "1"
	2, "2"
	3, "3"
	4, "4"
}

OptionValue "RSQ_Ballistics"
{
	0, "Stock (WoS)"
	1, "Low"
	2, "Max"
}

OptionValue "RSQ_PumpSpread"
{
	0, "Stock"
	1, "Enhanced"
}

OptionValue "RSM_Ammo"
{
	1, "RSQ Grenades"
	0, "Rockets"
}

OptionValue "RSQ_HandTone"
{
	0, "As drawn"
	1, "Porcelain"
	2, "Fair"
	3, "Light"
	4, "Olive"
	5, "Tan"
	6, "Medium brown"
	7, "Brown"
	8, "Dark brown"
	9, "Deep brown"
	10, "Ebony"
	11, "Undead grey"
	12, "Green"
	13, "Blue"
	14, "Purple"
	15, "Demon red"
	16, "Gold"
	17, "Black glove"
}

OptionMenu "RSQ_Options"
{
	Title "WEAPONS OF SATURN VR"
	Option "VR Hands", "rsq_hands", "OnOff"
	Option "Hand Skin Tone", "rsq_hand_tone", "RSQ_HandTone"
	Option "Punches (jab, hook, uppercut)", "rsqb_punch", "OnOff"
	Option "Reloading", "rsr_reload", "RSR_ReloadMode"
	Option "Grab ammo with", "rsr_grab_with", "RSR_GrabWith"
	Option "New magazine from", "rsr_pouch", "RSR_Pouch"
	Option "Shotgun Shells Per Insert", "rsr_shell_credit", "RSR_ShellCredit"
	Slider "Reload assist", "rsr_assist", 0.5, 3.0, 0.1
	Option "Pistol Semi Auto", "rsa_pistol_semi", "OnOff"
	Option "Pump Shotgun Spread", "rsq_pump_spread", "RSQ_PumpSpread"
	Option "Shotgun Slugshot Alt Fire", "rsa_sg_slug", "OnOff"
	Option "Rifle Underbarrel Ammo", "rsm_ammo", "RSM_Ammo"
	Option "Ballistics", "rsq_ballistics", "RSQ_Ballistics"
	Option "True Bullets", "sv_rsq_true_bullets", "OnOff"
	Slider "True Bullet Speed", "sv_rsq_round_speed", 20, 900, 10, 0
	Slider "Two-Hand Spread", "sv_rsq_twohand_spread", 0.0, 1.0, 0.05, 2
	Option "Two-Hand Tightens Shotguns", "sv_rsq_twohand_shotguns", "OnOff"
	Option "Two-Hand Grip (engine)", "vr_two_handed_weapons", "OnOff"
	Submenu "Dual Options", "RSQ_DualOptions"
	Option "Remove HUD Health and Armor", "rsq_hud_nohp", "OnOff"
	Option "Real Casing Models", "rsq_casing_models", "OnOff"
	Slider "Casing Size", "rsq_casing_size", 0.5, 2.5, 0.1, 1
	StaticText " "
	Submenu "Reload: tuning and debug", "RSR_Debug"
}

OptionMenu "RSR_Debug"
{
	Title "RELOAD: TUNING AND DEBUG"
	Option "Show the capture zones", "rsr_assist_debug", "OnOff"
	Option "Print each reload step", "rsr_debug", "OnOff"
}

OptionMenu "RSQ_DualOptions"
{
	Title "DUAL OPTIONS"
	Option "Start With Two Pistols", "rsq_dual_start", "OnOff"
	Option "Handgun", "rsq_dual_0", "OnOff"
	Option "1911", "rsq_dual_1", "OnOff"
	Option "MP40", "rsq_dual_2", "OnOff"
	Option "Maschine Rifle", "rsq_dual_3", "OnOff"
	Option "Nova Rifle", "rsq_dual_4", "OnOff"
	Option "Riot Gun", "rsq_dual_5", "OnOff"
	Option "Coach Gun", "rsq_dual_6", "OnOff"
}
