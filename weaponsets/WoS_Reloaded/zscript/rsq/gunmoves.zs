		for (int k = 0; k < spr.Size(); k++)
		{
			if (key[2 * k] == i && spr[k].IndexOf(f, 4) >= 0 && Actor.GetSpriteIndex(spr[k].Left(4)) == sprite)
			{
				int b = key[2 * k + 1] * 6;
				return (v[b], v[b + 1], v[b + 2]), (v[b + 3], v[b + 4], v[b + 5]);
