// GENERATED by tools/build.py: which BD22 gun each RSQWS_ gun stands for. BD22 VR's tables (hands, muzzle, recoil
// follow, reload geometry) are keyed by BD22's class names; this is the one place the two meet.
class RSQ_Alias abstract
{
	clearscope static Name BD(Weapon w)
	{
		if (!w)
			return 'None';
		Name n = w.GetClassName();
		if (n == 'RSQWS_Knuckles' || n == 'RSQ_Off_RSQWS_Knuckles')	return 'Melee_Attacks';
		if (n == 'RSQWS_Motorsaw' || n == 'RSQ_Off_RSQWS_Motorsaw')	return 'Chain_saw';
		if (n == 'RSQWS_Beretta' || n == 'RSQ_Off_RSQWS_Beretta')	return 'BrutalPistol';
		if (n == 'RSQWS_1911' || n == 'RSQ_Off_RSQWS_1911')	return 'BrutalPistol';
		if (n == 'RSQWS_MP40' || n == 'RSQ_Off_RSQWS_MP40')	return 'MP40';
		if (n == 'RSQWS_Riotgun' || n == 'RSQ_Off_RSQWS_Riotgun')	return 'Shot_Gun';
		if (n == 'RSQWS_Coachgun' || n == 'RSQ_Off_RSQWS_Coachgun')	return 'SSG';
		if (n == 'RSQWS_MachineRifle' || n == 'RSQ_Off_RSQWS_MachineRifle')	return 'Rifle';
		if (n == 'RSQWS_Minigun' || n == 'RSQ_Off_RSQWS_Minigun')	return 'Minigun';
		if (n == 'RSQWS_SaturnV' || n == 'RSQ_Off_RSQWS_SaturnV')	return 'Rocket_Launcher';
		if (n == 'RSQWS_NovaRifle' || n == 'RSQ_Off_RSQWS_NovaRifle')	return 'RailGun';
		if (n == 'RSQWS_TITAN' || n == 'RSQ_Off_RSQWS_TITAN')	return 'NukeLauncher';
		return 'None';
	}

	// by exact class: an off-hand version is BD22 VR's off-hand version, not the gun
	clearscope static Name Exact(Weapon w)
	{
		if (!w)
			return 'None';
		Name n = w.GetClassName();
		if (n == 'RSQ_Off_RSQWS_Beretta')	return 'RSQ_Off_BrutalPistol';
		if (n == 'RSQ_Off_RSQWS_1911')	return 'RSQ_Off_BrutalPistol';
		if (n == 'RSQ_Off_RSQWS_MP40')	return 'RSQ_Off_MP40';
		if (n == 'RSQ_Off_RSQWS_MachineRifle')	return 'RSQ_Off_Rifle';
		if (n == 'RSQ_Off_RSQWS_NovaRifle')	return 'RSQ_Off_RailGun';
		if (n == 'RSQ_Off_RSQWS_Riotgun')	return 'RSQ_Off_Shot_Gun';
		if (n == 'RSQ_Off_RSQWS_Coachgun')	return 'RSQ_Off_SSG';
		return BD(w);
	}
}

// the underbarrel's ammo at the start (owner: "ensure player starts with 3 missiles if RSQ Grenade not loaded"): without
// RSQ Grenade the underbarrel fires rockets (rsr_m203.zs AmmoClass, this pack), so each life starts with three
class RSQ_Started : Inventory { Default { Inventory.MaxAmount 1; +INVENTORY.UNDROPPABLE } }
class RSQ_Start : EventHandler
{
	override void PlayerEntered(PlayerEvent e)
	{
		let mo = players[e.PlayerNumber].mo;
		if (!mo || mo.CountInv('RSQ_Started') > 0)
			return;
		mo.GiveInventory('RSQ_Started', 1);
		Name gn = 'RSQGN_Ammo';
		class<Inventory> g = gn;
		if (!g)
			mo.GiveInventory('RocketAmmo', 3);
	}
}

