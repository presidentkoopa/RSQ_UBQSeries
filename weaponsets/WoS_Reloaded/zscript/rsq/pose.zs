// pose.zs (1.97, F7) -- GENERATED by tools/bd22_plus.py pose. Do not edit by hand.
// (2.0.3s: edited here, not regenerated: the body is RSVR_HandSync.Body, the hand RSVR_VRHand.HandPos/OffPos,
// which now correct a frame that lagged the tics -- rsvr/vrhand.zs. Carry this into the generator.)
//
// THE SPINE. `VR_MELEE_ON_QUESTZDOOM_2026-10-24.md` Part Two section 9 calls this "the single
// highest-leverage thing in the three codebases": a per-player pose history, fed once a tic by a
// netevent from the console player, read ONLY from the history by everyone INCLUDING THE SENDER.
//
// WHY IT HAS TO EXIST. Stock QuestZDoom writes AttackPos / OffhandPos and their three angles on
// the CONSOLE PLAYER'S PAWN ONLY, from the renderer (hw_vrmodes.cpp:432-446), and never sends
// them. For every other player on this machine those fields hold class defaults -- zero -- and
// OverrideAttackPosDir is false. So anything the simulation decides from the hand is decided from
// data only one machine has, and the moment a second player swings, the two machines disagree.
// melee.zs has been reading RSVR_VRHand.HandPos directly since 1.11. That is correct for one
// player and wrong for two.
//
// AND IT IS NOT ONLY ABOUT NETPLAY. Reading from a stamped history also makes the arithmetic
// dt-correct -- a velocity is a difference over the gap the stamps actually record, not over an
// assumed single tic -- and it DELETES the snap-turn and teleport special cases instead of tuning
// them, because the hand is differenced in the body's frame and a turn of the body with the arm
// still reads as nothing. melee.zs carries a hand-tuned patch for exactly that:
//     if (havePrev && (abs(deltaangle(lastAngle, mo.angle)) > 12 || (mo.pos - prevPos).Length() > 64))
//         settle = 2;
// The document's own trap table records an 8-deg/tic snap-turn flush failing in the saber because
// "a smooth-turn player above 280 deg/s trips it every tic, killing swings ... and below it, the
// turn is not subtracted at all". A threshold is the wrong shape of answer; this is the right one.
//
// CREDIT AND SHAPE. This is RS_ShieldSawQ's SSQ_Pose, which the document names as the thing to
// copy, adapted to carry BOTH hands because this pack swings the gun hand (melee.zs) and the off
// hand (fists, dual). Its hard-won details are kept and so are the reasons:
//
//   - THE AXES ARE BUILT IN PLACE, not returned. A function returning three Vector3s comes back
//     all zeros on QZD 17.3's VM (SHIELD found this 2026-10-22, same fault as `out Vector3`).
//   - Array<Vector3> is not allowed by this VM either, so the ring is fixed-size arrays.
//   - The sender runs in WorldTick, NOT UiTick. SSQ_Pose's own header says UiTick and its
//     shipping code does not: HandDir / OffhandDir are play scope and cannot be called from ui.
//   - Z IS NOT METRIC. OffhandPos.Z is divided by pixelstretch where X and Y are not
//     (hw_openxrdevice.cpp:606-608), so the same real swing measures ~20% slower straight up than
//     straight out. Vel() returns Doom space, correct in DIRECTION; Speed() puts pixelstretch back
//     into the MAGNITUDE only, which is the number a threshold should be compared against.
class RSQ_Pose play
{
	const N = 8;
	const MAIN = 0;
	const OFF = 1;

	Vector3 pos[8];		// newest first, absolute map units
	Vector3 bod[8];		// where the BODY was for that sample
	double byaw[8];		// and which way it faced
	int stamp[8];		// Level.maptime when it arrived, 0 = none
	Vector3 F, L, U;	// the controller's forward / left / up, unit, map space
	bool left;			// the sender plays left-handed (vr_control_scheme >= 10)
	int buttons;		// the sender's button bits for this sample
	int count;

	void Push(Vector3 p, Vector3 body, double bodyYaw, double yaw, double pitch, double roll,
		int btn, int now)
	{
		for (int k = N - 1; k > 0; k--)
		{
			pos[k] = pos[k - 1];
			stamp[k] = stamp[k - 1];
			bod[k] = bod[k - 1];
			byaw[k] = byaw[k - 1];
		}
		pos[0] = p;
		stamp[0] = now;
		bod[0] = body;
		byaw[0] = bodyYaw;
		// built HERE, in place: three Vector3 returns come back zeroed on this VM
		double cp = cos(pitch);
		F.x = cp * cos(yaw); F.y = cp * sin(yaw); F.z = sin(pitch);
		double l0x = cos(yaw + 90), l0y = sin(yaw + 90), l0z = 0;
		double u0x = F.y * l0z - F.z * l0y;
		double u0y = F.z * l0x - F.x * l0z;
		double u0z = F.x * l0y - F.y * l0x;
		double cr = cos(roll), sr = sin(roll);
		L.x = l0x * cr + u0x * sr; L.y = l0y * cr + u0y * sr; L.z = l0z * cr + u0z * sr;
		U.x = u0x * cr - l0x * sr; U.y = u0y * cr - l0y * sr; U.z = u0z * cr - l0z * sr;
		buttons = btn;
		if (count < N)
			count++;
	}

	// three tics of slack: a sender that stops sending (stowed, out of VR, menu) goes stale
	// rather than leaving the last pose to be read as live
	clearscope bool Fresh(int now) const
	{
		return count > 0 && now - stamp[0] <= 3;
	}

	// THE ARM'S OWN MOTION, NOT THE BODY'S. pos[] is absolute, so a difference taken off it
	// carries the player's travel and his turn as well. Doom run speed is about 583 units/sec,
	// which is many times any swing threshold -- walking forward with the gun out would read as
	// a permanent swing, and a snap turn is worse: the hand is ~20 units off the body axis, so
	// 45 degrees in one tic is 15 units, about 525 units/sec, out of nothing.
	Vector3 Rel(int k) const
	{
		Vector3 d = pos[k] - bod[k];
		double c = cos(byaw[k]), s = sin(byaw[k]);
		return (d.x * c + d.y * s, d.y * c - d.x * s, d.z);
	}

	// ...and back into the frame the player faces NOW, because callers compare against world
	// directions. A turn of the body with the arm still reads as nothing, which is what it is.
	Vector3 Turn(Vector3 v) const
	{
		double c = cos(byaw[0]), s = sin(byaw[0]);
		return (v.x * c - v.y * s, v.x * s + v.y * c, v.z);
	}

	// map units per tic, over the gap the STAMPS record -- not an assumed single tic
	Vector3 Vel() const
	{
		if (count < 2 || stamp[0] == stamp[1])
			return (0, 0, 0);
		return Turn(Rel(0) - Rel(1)) / (stamp[0] - stamp[1]);
	}

	// the same over a 2-sample window starting k back; zero if the history is not that deep
	Vector3 VelAt(int k) const
	{
		if (k + 2 >= count || stamp[k] == stamp[k + 2])
			return (0, 0, 0);
		return Turn(Rel(k) - Rel(k + 2)) / (stamp[k] - stamp[k + 2]);
	}

	// the TRUE speed of a velocity: pixelstretch back into the magnitude only, because the
	// direction is already right in Doom space. This is what a threshold compares against.
	clearscope double Speed(Vector3 v, double ps) const
	{
		double zt = v.z * ps;
		return sqrt(v.x * v.x + v.y * v.y + zt * zt);
	}

	// the fastest 2-sample window in the last six: a swing's peak, not wherever it happened to
	// be on the tic somebody asked. The release of a throw is already the slowing-down part.
	Vector3 PeakVel(double ps) const
	{
		Vector3 best = (0, 0, 0);
		double bl = 0;
		for (int k = 0; k < 6; k++)
		{
			Vector3 v = VelAt(k);
			double l = Speed(v, ps);
			if (l > bl)
			{
				bl = l;
				best = v;
			}
		}
		return best;
	}
}

// The packing, and the engine reads. Three ints is what SendNetworkEvent carries, so one event
// per hand per tic: arg0 position, arg1 angles + buttons, arg2 the hand index and handedness.
class RSQ_PoseNet abstract play
{
	static clearscope int ClampI(int v, int lo, int hi)
	{
		return v < lo ? lo : (v > hi ? hi : v);
	}

	// x, y relative to the pawn in quarter units (11 bits signed each), z in quarter units
	// (10 bits signed). +-256 units of reach horizontally, +-128 vertically, at 0.25 resolution.
	static clearscope int PackPos(Vector3 rel)
	{
		int x = ClampI(int(round(rel.x * 4)), -1024, 1023) & 0x7FF;
		int y = ClampI(int(round(rel.y * 4)), -1024, 1023) & 0x7FF;
		int z = ClampI(int(round(rel.z * 4)), -512, 511) & 0x3FF;
		return x | (y << 11) | (z << 22);
	}

	static clearscope Vector3 UnpackPos(int a)
	{
		int x = a & 0x7FF;
		if (x >= 1024)
			x -= 2048;
		int y = (a >> 11) & 0x7FF;
		if (y >= 1024)
			y -= 2048;
		int z = (a >> 22) & 0x3FF;
		if (z >= 512)
			z -= 1024;
		return (x / 4.0, y / 4.0, z / 4.0);
	}

	// yaw 10 bits over 360, pitch 10 bits over -90..90, roll 10 bits over -180..180, then two
	// button bits: attack and altattack, which is what a melee gate ever asks about.
	static clearscope int PackAng(double yaw, double pitch, double roll, int btn)
	{
		int iy = ClampI(int(round((yaw % 360.0 + 360.0) % 360.0 / 360.0 * 1023.0)), 0, 1023);
		int ip = ClampI(int(round((pitch + 90.0) / 180.0 * 1023.0)), 0, 1023);
		int ir = ClampI(int(round(((roll + 180.0) % 360.0 + 360.0) % 360.0 / 360.0 * 1023.0)), 0, 1023);
		return iy | (ip << 10) | (ir << 20) | ((btn & 3) << 30);
	}

	static clearscope double, double, double, int UnpackAng(int a)
	{
		double yaw = (a & 0x3FF) / 1023.0 * 360.0;
		double pitch = ((a >> 10) & 0x3FF) / 1023.0 * 180.0 - 90.0;
		double roll = ((a >> 20) & 0x3FF) / 1023.0 * 360.0 - 180.0;
		int btn = (a >> 30) & 3;
		return yaw, pitch, roll, btn;
	}

	// the roll of the controller's real left axis about F, measured against the horizontal left,
	// so the receiver's Push() rebuilds exactly the L and U the sender had
	static clearscope double RollOf(Vector3 F, Vector3 Lreal)
	{
		double yaw = atan2(F.y, F.x);
		Vector3 L0 = (cos(yaw + 90), sin(yaw + 90), 0);
		Vector3 U0 = (F.y * L0.z - F.z * L0.y, F.z * L0.x - F.x * L0.z, F.x * L0.y - F.y * L0.x);
		return atan2(Lreal dot U0, Lreal dot L0);
	}
}

class RSQ_PoseHandler : EventHandler
{
	RSQ_Pose main[MAXPLAYERS];
	RSQ_Pose off[MAXPLAYERS];

	static clearscope RSQ_PoseHandler Get()
	{
		return RSQ_PoseHandler(EventHandler.Find('RSQ_PoseHandler'));
	}

	// what everything downstream should call, instead of RSVR_VRHand.HandPos
	static clearscope RSQ_Pose Of(PlayerPawn mo, int hand)
	{
		let h = Get();
		if (!h || !mo || !mo.player)
			return null;
		int i = mo.PlayerNumber();
		if (i < 0 || i >= MAXPLAYERS)
			return null;
		return hand == RSQ_Pose.OFF ? h.off[i] : h.main[i];
	}

	override void OnRegister()
	{
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			main[i] = new('RSQ_Pose');
			off[i] = new('RSQ_Pose');
		}
	}

	// EVERY PEER RUNS THIS, including the sender. That is the whole point: one code path, one
	// set of numbers, and the machine that owns the controller is not a special case.
	override void NetworkProcess(ConsoleEvent e)
	{
		if (e.Name != "rsq-pose")
			return;
		int i = e.Player;
		if (i < 0 || i >= MAXPLAYERS || !playeringame[i] || !players[i].mo)
			return;
		let mo = players[i].mo;
		double yaw, pitch, roll;
		int btn;
		[yaw, pitch, roll, btn] = RSQ_PoseNet.UnpackAng(e.Args[1]);
		int hand = e.Args[2] & 1;
		let p = hand == RSQ_Pose.OFF ? off[i] : main[i];
		if (!p)
			return;
		// 2.0.3s: the body is the pawn's X/Y and the VIEW's height (RSVR_HandSync.Body: the engine moves the view
		// against the pawn on stairs and landings, and the hands hang off the view)
		Vector3 bodyNow = RSVR_HandSync.Body(mo);
		p.Push(bodyNow + RSQ_PoseNet.UnpackPos(e.Args[0]), bodyNow, mo.angle,
			yaw, pitch, roll, btn, Level.maptime);
		p.left = (e.Args[2] & 2) != 0;
	}

	// The sender, in WorldTick, for THIS machine's console player only. Not UiTick: HandDir and
	// OffDir are play scope and a ui hook cannot call them. (SSQ_Pose's own header says UiTick
	// and its shipping code does not -- the code is right.)
	override void WorldTick()
	{
		if (consoleplayer < 0 || consoleplayer >= MAXPLAYERS || !playeringame[consoleplayer])
			return;
		let p = players[consoleplayer];
		if (!p)
			return;
		let mo = PlayerPawn(p.mo);
		if (!mo || !RSVR_VRHand.InVR(mo))
			return;
		double ps = mo.Level.pixelstretch;
		if (ps <= 0)
			ps = 1.2;
		int btn = ((p.cmd.buttons & BT_ATTACK) != 0 ? 1 : 0)
			| ((p.cmd.buttons & BT_ALTATTACK) != 0 ? 2 : 0);
		int lh = LeftHanded() ? 2 : 0;
		Send(mo, RSVR_VRHand.HandPos(mo), RSVR_VRHand.HandDir(mo, 0, 0, ps),
			RSVR_VRHand.HandDir(mo, 90, 0, ps), btn, RSQ_Pose.MAIN | lh);
		Send(mo, RSVR_VRHand.OffPos(mo), RSVR_VRHand.OffDir(mo, 0, 0, ps),
			RSVR_VRHand.OffDir(mo, 90, 0, ps), btn, RSQ_Pose.OFF | lh);
	}

	static clearscope bool LeftHanded()
	{
		let cv = CVar.FindCVar('vr_control_scheme');
		return cv && cv.GetInt() >= 10;
	}

	void Send(PlayerPawn mo, Vector3 hand, Vector3 F, Vector3 Lreal, int btn, int flags)
	{
		double yaw = atan2(F.y, F.x);
		double pitch = asin(clamp(F.z, -1, 1));
		double roll = RSQ_PoseNet.RollOf(F, Lreal);
		EventHandler.SendNetworkEvent("rsq-pose", RSQ_PoseNet.PackPos(hand - RSVR_HandSync.Body(mo)),
			RSQ_PoseNet.PackAng(yaw, pitch, roll, btn), flags);
	}
}
