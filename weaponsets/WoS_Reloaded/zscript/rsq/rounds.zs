// rounds.zs (1.97, F5) -- GENERATED by tools/bd22_plus.py impacts. Do not edit by hand.
//
// How hard each gun's round hits a WALL, so a 9mm and a 12-gauge do not throw the same chips.
// Derived, not typed: RS_Ballistics' `ballistics <roundprofile>` blocks carry the round's mass in
// grains and its speed, and impact energy goes as mass x speed^2. Raw energy spans more than ten
// to one across these guns, which would be absurd as a particle count, so the scale is the CUBE
// ROOT of the energy ratio against the 9mm -- 9mm 1.00, buckshot 1.66, 7.62 2.21 -- and clamped.
//
// A gun whose round has no ballistics block (rockets, plasma, the BFG, the Unmaker) gets 1.0: they
// are not cartridges and their own explosions already carry the hit.
//
// RS_Ballistics' real impact blocks could not come: they name bursts, and a burst resolves a
// PARTICLEDEFS particle, which is a REMA RENDERER feature (hw_gpuparticlebuffer, hw_meshparticles)
// that stock QuestZDoom does not have. What crosses is the judgement, not the particle system.

class RSQ_Rounds abstract
{
	static double Scale(Name cls)
	{
		switch (cls)
		{
		case 'BrutalPistol':	return 0.900;	// pistol_9mm -> impact pistol_9mm
		case 'Revolver':	return 1.300;	// revolver_357 -> impact magnum
		case 'Shot_Gun':	return 0.450;	// buckshot -> impact buckshot
		case 'SSG':	return 0.600;	// buckshot_magnum -> impact buckshot_magnum
		case 'MP40':	return 0.800;	// smg_9mm -> impact pistol
		case 'GrenadeLauncher':	return 1.000;	// rocket -> impact rocket
		case 'HellishMissileLauncher':	return 1.000;	// rocket -> impact rocket
		case 'MG42':	return 1.600;	// rifle_762 -> impact rifle
		case 'AssaultShotgun':	return 0.450;	// buckshot -> impact buckshot
		case 'BIG_FUCKING_GUN':	return 1.000;	// bfg_ball -> impact bfg
		case 'BFG10k':	return 1.400;	// bfg_heavy -> impact bfg_heavy
		case 'BrutalSMG':	return 0.800;	// smg_9mm -> impact pistol
		case 'Machinegun':	return 1.250;	// machinegun_762 -> impact machinegun_762
		case 'Minigun':	return 0.800;	// chaingun_556 -> impact chaingun_556
		case 'Plasma_Gun':	return 1.000;	// plasma_ball -> impact plasma
		case 'Rocket_Launcher':	return 1.250;	// rocket_rpg -> impact rocket_rpg
		case 'Rifle':	return 1.600;	// rifle_556 -> impact rifle
		}
		return 1.0;
	}
}
