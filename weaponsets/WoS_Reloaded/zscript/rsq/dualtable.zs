// GENERATED by tools/build.py: this pack's dual wield table (BD22 VR's RSQ_DualTable, its guns)
class RSQ_DualTable play
{
	const COUNT = 7;
	const AXE = 99;	// no dual axe here
	clearscope static Name Gun(int i)
	{
		static const Name v[] = { 'RSQWS_Beretta', 'RSQWS_1911', 'RSQWS_MP40', 'RSQWS_MachineRifle', 'RSQWS_NovaRifle', 'RSQWS_Riotgun', 'RSQWS_Coachgun' };
		return v[i];
	}
	clearscope static Name Copy(int i)
	{
		static const Name v[] = { 'RSQ_Off_RSQWS_Beretta', 'RSQ_Off_RSQWS_1911', 'RSQ_Off_RSQWS_MP40', 'RSQ_Off_RSQWS_MachineRifle', 'RSQ_Off_RSQWS_NovaRifle', 'RSQ_Off_RSQWS_Riotgun', 'RSQ_Off_RSQWS_Coachgun' };
		return v[i];
	}
	static Name Mag(int i)
	{
		static const Name v[] = { 'RSQWS_9mmOff', 'RSQWS_ACPOff', 'RSQWS_MP40AmmoOff', 'RSQWS_MagazineOff', 'RSQWS_CellpakOff', 'RSQWS_LoadedShellOff', 'RSQWS_LoadedShellsOff' };
		return v[i];
	}
	static int MagMax(int i)
	{
		static const int v[] = { 11, 8, 32, 31, 60, 9, 2 };
		return v[i];
	}
	static Name CVarName(int i)
	{
		static const Name v[] = { 'rsq_dual_0', 'rsq_dual_1', 'rsq_dual_2', 'rsq_dual_3', 'rsq_dual_4', 'rsq_dual_5', 'rsq_dual_6' };
		return v[i];
	}
	static String Nice(int i)
	{
		static const String v[] = { "Handgun", "1911", "MP40", "Maschine Rifle", "Nova Rifle", "Riot Gun", "Coach Gun" };
		return v[i];
	}
	// a second one of a gun picked up: the pickup is the gun itself
	static int PickupGun(Name n)
	{
		if (n == 'RSQWS_Beretta') return 0;
		if (n == 'RSQWS_1911') return 1;
		if (n == 'RSQWS_MP40') return 2;
		if (n == 'RSQWS_MachineRifle') return 3;
		if (n == 'RSQWS_NovaRifle') return 4;
		if (n == 'RSQWS_Riotgun') return 5;
		if (n == 'RSQWS_Coachgun') return 6;
		return -1;
	}
}

// the Dual Wield key (KEYCONF: netevent rsq_dual): the held gun's off-hand version into the off hand, or the hands back
class RSQ_DualKey : EventHandler
{
	override void NetworkProcess(ConsoleEvent e)
	{
		if (!(e.Name ~== "rsq_dual") || e.Player < 0 || e.Player >= MAXPLAYERS || !playeringame[e.Player] || !players[e.Player].mo)
			return;
		RSQ_Dual.Toggle(players[e.Player].mo);
	}
}
