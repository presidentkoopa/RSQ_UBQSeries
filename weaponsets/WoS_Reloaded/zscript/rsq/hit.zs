// hit.zs (1.97, F6) -- GENERATED by tools/bd22_plus.py hits. Do not edit by hand.
//
// What a round does when it ARRIVES: the sound, the ricochet and the light. Until this file the
// pack had none of the three -- every gun's impact differed by one multiplier on three particle
// counts and nothing else. The numbers are RS_Ballistics' own `impact` blocks, reached by
// roundprofile -> round.roundlook -> roundlook.impact, and only the keys stock GZDoom can make
// good on are carried.
//
// SOUND IS PER MATERIAL. Every one of the eight bullet bases our guns resolve to names the same
// sound for a given material, so this is one table and not eight. RICOCHET AND LIGHT ARE PER
// GUN, and that is where a gun's character at the far end actually lives.
//
// THE SHOTGUNS ARE ABSENT FROM RICOCHET AND LIGHT ON PURPOSE. WorldHitscanFired is raised once
// per pellet and BD22's shotguns throw nine, so a per-pellet ricochet would be nine ricochets
// off one trigger pull. RSBDEFS says the same in words -- buckshot carries "no ricochet sound or
// light per pellet" -- and its buckshot blocks carry no `glance` and no `light`.
//
// Rides rsq_ballistics, the same dial as the rest of the pack's effects: at Stock it is silent
// and dark, because Stock means Brutal Doom's own and nothing of ours.
class RSQ_ImpactLight : Actor
{
	Default
	{
		+NOINTERACTION;
		+NOBLOCKMAP;
		+NOGRAVITY;
		+DONTSPLASH;
		RenderStyle "None";
	}
	States
	{
	Spawn:
		TNT1 A 1;
		Stop;
	}
}

// `play`, not the default data scope: At() spawns the light actor, and Spawn is a play
// function. The pack's own RSM is declared the same way for the same reason.
class RSQ_Hit abstract play
{
	// per MATERIAL. "" means the data says `sound = none` -- liquid and slime, where the
	// splash is the sound.
	static String SoundFor(Name s)
	{
		if (s == 'concrete' || s == 'dirt' || s == 'brick' || s == 'marble' || s == 'tile')
			return "rsb/impact/concrete";
		if (s == 'metal')
			return "rsb/impact/metal";
		if (s == 'wood')
			return "rsb/impact/wood";
		if (s == 'glass' || s == 'screen' || s == 'light')
			return "rsb/glass";
		if (s == 'tech')
			return "rsb/impact/electric";
		if (s == 'pipe')
			return "rsb/impact/pipe";
		if (s == 'lava')
			return "rsb/flame/hiss";
		if (s == 'liquid' || s == 'slime')
			return "";
		return "rsb/impact/concrete";
	}

	// degrees of grazing angle inside which the round skips off instead of biting, per gun.
	// 0 = this gun never ricochets.
	static double Glance(Name gun, Name s)
	{
		bool hard = s == 'metal' || s == 'pipe' || s == 'tech';
		if (gun == 'BrutalPistol')
			return hard ? 25 : 18;	// impact pistol_9mm
		if (gun == 'Revolver')
			return hard ? 25 : 20;	// impact magnum
		if (gun == 'MP40')
			return hard ? 25 : 18;	// impact pistol
		if (gun == 'MG42')
			return hard ? 20 : 14;	// impact rifle
		if (gun == 'BrutalSMG')
			return hard ? 25 : 18;	// impact pistol
		if (gun == 'Machinegun')
			return hard ? 20 : 14;	// impact machinegun_762
		if (gun == 'Minigun')
			return hard ? 20 : 14;	// impact chaingun_556
		if (gun == 'Rifle')
			return hard ? 20 : 14;	// impact rifle
		return 0;
	}

	// radius, and the tics it lives, of the flash a round strikes off a surface. Only the hot
	// surfaces are lit, which is RSBDEFS' own choice and keeps this cheap on a Quest.
	static int LightRadius(Name gun, Name s)
	{
		if (gun == 'BrutalPistol' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 55;	// impact pistol_9mm.metal
		if (gun == 'Revolver' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 70;	// impact magnum.metal
		if (gun == 'MP40' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 50;	// impact pistol.metal
		if (gun == 'GrenadeLauncher' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 400;	// impact rocket.metal
		if (gun == 'HellishMissileLauncher' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 400;	// impact rocket.metal
		if (gun == 'MG42' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 80;	// impact rifle.metal
		if (gun == 'BIG_FUCKING_GUN' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 500;	// impact bfg.metal
		if (gun == 'BFG10k' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 640;	// impact bfg_heavy.metal
		if (gun == 'BrutalSMG' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 50;	// impact pistol.metal
		if (gun == 'Machinegun' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 60;	// impact machinegun_762.metal
		if (gun == 'Minigun' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 40;	// impact chaingun_556.metal
		if (gun == 'Rocket_Launcher' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 400;	// impact rocket_rpg.metal
		if (gun == 'Rifle' && (s == 'metal' || s == 'pipe' || s == 'tech'))
			return 80;	// impact rifle.metal
		if (s == 'tech')
			return 60;	// every gun, on tech
		if (s == 'screen')
			return 50;	// every gun, on screen
		if (s == 'light')
			return 90;	// every gun, on light
		if (s == 'lava')
			return 80;	// every gun, on lava
		return 0;
	}

	static int LightTics(Name s)
	{
		if (s == 'tech')
			return 3;
		if (s == 'screen')
			return 2;
		if (s == 'light')
			return 2;
		if (s == 'lava')
			return 5;
		return 3;
	}

	static Color LightTint(Name s)
	{
		if (s == 'tech')
			return Color(170, 200, 255);
		if (s == 'screen')
			return Color(150, 220, 200);
		if (s == 'light')
			return Color(255, 245, 220);
		if (s == 'lava')
			return Color(255, 140, 55);
		return Color(255, 190, 120);
	}

	static void At(Actor src, Vector3 pos, Vector3 n, Vector3 dir, Name s, Name gun)
	{
		if (!src)
			return;
		let l = Actor.Spawn('RSQ_ImpactLight', pos);
		if (!l)
			return;

		// the ricochet first: it decides which sound this hit makes. The test is RS_Ballistics'
		// own -- the shallower the angle onto the surface, the more likely the round skips --
		// and dir dot n is the cosine of the angle off the surface's face.
		double g = Glance(gun, s);
		bool ric = g > 0 && abs(dir dot n) < sin(g);
		String snd = ric ? "rsb/ricochet" : SoundFor(s);
		if (snd != "")
			l.A_StartSound(snd, CHAN_AUTO, CHANF_OVERLAP, 1.0);

		int rad = LightRadius(gun, s);
		if (rad > 0)
		{
			l.A_AttachLight('rsqhit', DynamicLight.PointLight, LightTint(s), rad, 0,
				DynamicLight.LF_ATTENUATE);
			l.tics = LightTics(s);
		}
		else
			l.tics = 1;
	}
}
