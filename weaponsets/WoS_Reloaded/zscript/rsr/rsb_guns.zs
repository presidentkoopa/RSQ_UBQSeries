// generated by tools/gen_rsb.py (RSR-BREAK) -- do not edit by hand
// PATCHED BY HAND 2026-10-13 (reload assist): BD22's Revolver (index 3) is now loaded with a
// speedloader -- all five of its own rounds pushed in as one piece, down the cylinder's axis,
// instead of five separate rounds into five 1.4 cm targets. Its chamber count, Loader flag,
// seat (Base/Tip/Bore 3,0), LoaderDepth, Casing and the hold (HandBase/HandTip) were changed,
// and LoaderEmptyInHand was added. The five per-chamber rows (cases 25..28) are left in place
// but unused. Re-apply after any gen_rsb.py run.
// PATCHED BY HAND 2026-10-27 (lane B moon-reload): BrutalRevolver rows 10 (speedloader) and 11 (a round
// at a time), numbers from reference/moonlight/bake_reload.py (bake_reload.txt). Re-apply after gen_rsb.py.
// PATCHED BY HAND 2026-10-27 (lane rev-unmaker, owner r3 item 20): BD21's Revolver2 is gone from the pack.
// Rows 8 / 9 (its speedloader / per-round rows) are RETIRED: Index() never returns them and Cls() is 'None'.
// Their numbers stay so rows 10 / 11 keep their index. Re-apply after gen_rsb.py.
// PATCHED BY HAND 2026-10-28 (owner 06:46, Moonlight on pistol ammo): rows 10 / 11 reserve is BD22's Brutal
// Pistol's Clip1 (Pistol.dec:3) and ReservePer() was added: reserve items one loaded round costs (3 for the
// Moonlight, 1 for every other row). Re-apply after gen_rsb.py.
// Real VR reload, break-open guns and revolvers: per gun. Positions cm in the weapon
// controller's frame (F, L, U); turns right-handed about the axis, opening positive.

class RSB_Guns abstract
{
	// 1.97: Shot/Revolver Reload (rsb_revolver_feed) -- 0 the speedloader, 1 a round at a time.
	// Server, not user: Index() is clearscope static with no player to read a user cvar against.
	clearscope static bool PerRound()
	{
		let cv = CVar.FindCVar('rsb_revolver_feed');
		return cv && cv.GetInt() != 0;
	}

	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		Name n = RSQ_Alias.Exact(w);
		if (n == 'SSG')	return 1;
		if (n == 'GrenadeLauncher')	return 2;
		if (n == 'Revolver')	return PerRound() ? 7 : 3;
		if (n == 'BrutalRevolver')	return PerRound() ? 11 : 10;	// the Moonlight six-shooter (moon-reload)
		if (n == 'VR_SuperShotgun')	return 4;
		if (n == 'VR_Revolver')	return 5;
		if (n == 'VR_Revolver2')	return 6;
		return 0;
	}

	// a point of the hinge axis
	clearscope static Vector3 Hinge(int i)
	{
		switch (i)
		{
		case 1:	return (14.6238, 7.0597, -7.8095);	// r11 port: moved with the gun to the FBX hand (was (10.7185, 0.0346, -2.4812))
