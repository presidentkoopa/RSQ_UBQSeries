		case 3:	return 6;
		case 4:	return 2;
		case 5:	return 6;
		case 6:	return 6;
		case 7:	return 6;
		case 8:	return 6;
		case 9:	return 6;
		case 10:	return 6;
		case 11:	return 6;
		}
		return 0;
	}

	// spent rounds: the set's own casing actors (weapon state RSB_Eject), or the set's own round thrown (RSB_Casing)
	clearscope static bool WorldEject(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return false;
		case 4:	return true;
		case 5:	return true;
		case 6:	return true;
		case 7:	return false;
		case 8:	return false;
		case 9:	return false;
		case 10:	return true;		// the mesh's own rounds thrown (its frames 24-29 throw them)
		case 11:	return true;
		}
		return false;
	}

	// where the thrown round's centre sits in its chamber
	clearscope static Vector3 Casing(int i)
	{
		switch (i)
		{
		case 1:	return (0.0000, 0.0000, 0.0000);
		case 2:	return (0.0000, 0.0000, 0.0000);
		case 3:	return (8.8371, 1.7191, 4.3952);	// batch 4: moved with the gun to the FBX hand (was 3.5636, -0.0215, 0.2363)		// the cylinder's rear face
		case 4:	return (8.0289, -1.2745, 3.4838);
		case 5:	return (4.4599, 0.0046, -0.2405);
		case 6:	return (4.4599, 0.0046, -0.2405);
		case 7:	return (8.8371, 1.7191, 4.3952);	// batch 4: moved with the gun to the FBX hand (was 3.5636, -0.0215, 0.2363)
		case 8:	return (8.8371, 1.7191, 4.3952);	// batch 4: moved with the gun to the FBX hand (was 3.5636, -0.0215, 0.2363)
		case 9:	return (8.8371, 1.7191, 4.3952);	// batch 4: moved with the gun to the FBX hand (was 3.5636, -0.0215, 0.2363)
		case 10:	return (12.1113, 2.1927, 4.7250);	// batch 4: moved with the gun to the FBX hand (was 4.0840, -0.0097, 2.1278)		// the six rounds' centre, seated
		case 11:	return (12.1113, 2.1927, 4.7250);	// batch 4: moved with the gun to the FBX hand (was 4.0840, -0.0097, 2.1278)
		}
		return (0, 0, 0);
	}

	clearscope static Name Cls(int i)
	{
		switch (i)
		{
		case 1:	return 'SSG';
		case 2:	return 'GrenadeLauncher';
		case 3:	return 'Revolver';
		case 4:	return 'VR_SuperShotgun';
		case 5:	return 'VR_Revolver';
		case 6:	return 'VR_Revolver2';
		case 7:	return 'Revolver';
		case 8:	return 'None';		// retired 2026-10-27 (was BD21's Revolver2, removed: owner r3 item 20)
		case 9:	return 'None';		// retired, as 8
		case 10:	return 'BrutalRevolver';
		case 11:	return 'BrutalRevolver';
		}
		return 'None';
	}

	// the set's "nothing in the chambers" (no casings) item
	clearscope static String Unloaded(int i)
	{
		switch (i)
		{
		case 1:	return "";
		case 2:	return "GLReloadToken";
		case 3:	return "HasUnloadedRevolver";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		case 7:	return "HasUnloadedRevolver";
		case 8:	return "HasUnloadedRevolver";
		case 9:	return "HasUnloadedRevolver";
		case 10:	return "";
		case 11:	return "";
		}
		return "";
	}

	// the reserve still counts the loaded rounds (V+ super shotgun: firing takes them)
	// after the loader is home: is there an empty loader left in the hand? A cage, yes; five
	// loose rounds pushed in as one piece, no.
	clearscope static bool LoaderEmptyInHand(int i)
	{
		switch (i)
		{
		case 5:	return true;		// Vanilla VR Plus VR_Revolver: its own speedloader mesh
		case 6:	return true;		// Vanilla VR Plus VR_Revolver2
		case 10:	return true;		// BrutalRevolver: the Moonlight's cage (rev_rsb.md3 frame 2) stays in the hand
		}
		return false;
	}

	// 2026-10-28 (owner 06:46, by hand): reserve items one loaded round costs. The Moonlight takes 3 of BD22's
	// pistol rounds (Clip1) per shot in its cylinder; every other row 1.
	clearscope static int ReservePer(int i)
	{
		return (i == 10 || i == 11) ? 3 : 1;
	}

	clearscope static bool ReserveHoldsLoaded(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return false;
		case 4:	return true;
		case 5:	return false;
		case 6:	return false;
		case 7:	return false;
		case 8:	return false;
		case 9:	return false;
		case 10:	return false;
		case 11:	return false;
		}
		return false;
	}

	// what the off hand's reload button gives (BD22: its ACS reload token)
	clearscope static String ReloadToken(int i)
	{
		switch (i)
		{
		case 1:	return "";
		case 2:	return "Reloading";
		case 3:	return "Reloading";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		case 7:	return "Reloading";
		case 8:	return "Reloading";
		case 9:	return "Reloading";
		case 10:	return "Reloading";
		case 11:	return "Reloading";
		}
		return "";
	}

	// the speedloader's rounds in the cylinder (cm)
	clearscope static double LoaderDepth(int i)
	{
		switch (i)
		{
		case 1:	return 0.0000;
		case 2:	return 0.0000;
		case 3:	return 7.0000;		// BD22 Revolver: of the round's 9.6 cm, what the hand pushes
		case 4:	return 0.0000;
		case 5:	return 6.1658;
		case 6:	return 6.1658;
		case 7:	return 7.0000;
		case 8:	return 7.0000;
		case 9:	return 7.0000;
		case 10:	return 6.2300;		// Moonlight: the loader's rounds, front 8.08 to the cylinder face 1.85
		case 11:	return 0.0000;
		}
		return 0;
	}

	// the off hand pushing it shut: angle 0, the hinged part's extent
	clearscope static Vector3 PushRef(int i)
	{
		switch (i)
		{
		case 1:	return (0.9777, 0.0368, 0.2071);	// r11 port: moved with the gun to the FBX hand (was (0.9884, 0.0000, 0.1522))
		case 2:	return (0.9626, 0.0235, 0.2698);	// r9 port: moved with the gun to the FBX hand (was (0.9762, 0.0000, 0.2169))
		case 3:	return (0.0000, 0.0050, 1.0000);
		case 4:	return (0.9895, 0.0000, 0.1448);
		case 5:	return (0.9667, 0.0000, 0.2559);
		case 6:	return (0.9667, 0.0000, 0.2559);
		case 7:	return (0.0000, 0.0050, 1.0000);
		case 8:	return (0.0000, 0.0050, 1.0000);
		case 9:	return (0.0000, 0.0050, 1.0000);
		case 10:	return (0.9667, 0.0000, 0.2559);		// = VR_Revolver (5): the same mesh at the same placement
		case 11:	return (0.9667, 0.0000, 0.2559);
		}
		return (0, 0, 0);
	}

