// GENERATED by tools/lib/basics.py: the weapon sets' basics, their own small parts

// ---- the punch (BD22 VR's fists.zs lands this): Doom's fist, 2-20, berserk x10 ----------------------------------------
class RSQB_Punch : Actor
{
	Default
	{
		Projectile;
		Radius 8;
		Height 8;
		Speed 16;
		DamageFunction (2 * random(1, 10));
		DamageType "Melee";
		+NOGRAVITY
		+BLOODSPLATTER
		+NOEXTREMEDEATH
		RenderStyle "None";
		Obituary "%o was punched out by %k.";
	}
	States
	{
	Spawn:
		TNT1 A 2;
		Stop;
	XDeath:
		TNT1 A 0 A_StartSound("*fist", CHAN_AUTO);
		Stop;
	Death:
		TNT1 A 0;
		Stop;
	}

	static bool IsBarrel(Actor b)
	{
		if (b is 'ExplosiveBarrel') return true;
		String cn = b.GetClassName();
		return cn.IndexOf("Barrel") >= 0;
	}

	// a hand on a door face or lifting a door (the basics' lift, or Distance Grab's, asked by name) does not punch
	static bool HandOnDoor(PlayerPawn mo, int h)
	{
		if (!mo || mo.PlayerNumber() != consoleplayer) return false;
		let dr = RSQB_DG_Door.Get();
		if (dr && !RSQB_DG_Door.DGLoaded() && (dr.Holding(h) || dr.Touching(h))) return true;
		let it = ServiceIterator.Find("RSQDG_DoorService");
		Service s = it.Next();
		return s && s.GetInt("door.holding", "", h) == 1;
	}

	// the blow's kind from its direction in the body frame (forward, left, up): 1 jab, 2 hook, 3 uppercut, 0 none
	static int Kind(Vector3 d, double fwd)
	{
		if (d.z >= 0.6) return 3;
		if (abs(d.y) >= 0.6) return 2;
		if (d.x >= fwd) return 1;
		return 0;
	}

	// UPPERCUT KICKS BARRELS (RSQ Melee's numbers, gloves.zs KickBarrel): no damage, up 5 + 4 x power map units a tic
	// and as fast forward, away from you; you are its target, so its blast is yours
	static bool KickBarrel(PlayerPawn mo, Vector3 hand, Vector3 dir, double mps)
	{
		Actor best = null;
		double bestD = 40;
		let it = BlockThingsIterator.CreateFromPos(hand.x, hand.y, hand.z - 64, 128, 48, false);
		while (it.Next())
		{
			Actor b = it.thing;
			if (!b || !b.bShootable || b.health <= 0 || !RSQB_Punch.IsBarrel(b)) continue;
			Vector3 c = b.pos + (0, 0, b.height * 0.5);
			double d = (c - hand).Length();
			if (d < bestD) { bestD = d; best = b; }
		}
		if (!best) return false;
		double power = clamp((mps - 2.0) / 5.0, 0.0, 1.0);
		double up = 5.0 + 4.0 * power;
		Vector2 toB = best.pos.xy - mo.pos.xy;
		double tl = toB.Length();
		toB = tl > 0.5 ? toB / tl : (cos(mo.angle), sin(mo.angle));
		best.vel.z = max(best.vel.z, up);
		best.vel.xy += toB * up;
		best.target = mo;
		mo.A_StartSound("*fist", CHAN_AUTO);
		if (RSQ.PlayerInt(mo, 'rsq_switch_log', 0) > 0)
			Console.Printf("RSQB uppercut kicks %s: up %.1f, no damage (health %d)", best.GetClassName(), up, best.health);
		return true;
	}
}
class RSQB_PunchBerserk : RSQB_Punch { Default { DamageFunction (20 * random(1, 10)); } }

// ---- the grenade: the frag only (owner: no kinds, no alt fires), Doom's explosion, barrels twice ---------------------
class RSQB_GN_Kind play
{
	enum EKind { FRAG = 0, IMPACT, INCENDIARY, FREEZE, STUN, SMOKE, FLASH, CHARM, INFIGHT, COUNT }
	static String Node(int k) { return ""; }
	static Name HeldSprite(int k) { return 'QGNH'; }
	static Name ThrownSprite(int k) { return 'QGNT'; }
	static bool Owns(Actor who, int k) { return k == FRAG; }
	static int Next(Actor who, int k) { return FRAG; }
	static double DamageShare(Actor by, int k) { return 1.0; }
	static int Colour(int k) { return -1; }
	static void Effect(Actor at, Actor by, int k, double r) {}
	// the look: Doom's own rocket explosion (owner: "a regular doom explosion graphic")
	static void Look(Actor at, int k, Actor by = null)
	{
		at.A_AlertMonsters();
		Actor.Spawn('RSQB_GN_DoomBoom', at.pos, ALLOW_REPLACE);
	}
	// x2 barrel damage (owner): the blast's damage dealt to every barrel in reach a second time, falling off as
	// A_Explode's does (full at the centre, none at the radius)
	static void Barrels(Actor at, int dmg, int rad)
	{
		if (!at || dmg <= 0 || rad <= 0) return;
		let src = at.target ? at.target : at;
		let it = BlockThingsIterator.Create(at, rad);
		while (it.Next())
		{
			Actor b = it.thing;
			if (!b || !b.bShootable || b.health <= 0 || !RSQB_Punch.IsBarrel(b)) continue;
			double d = max(0.0, at.Distance3D(b) - b.radius);
			int hurt = int(dmg * (1.0 - d / rad));
			if (hurt > 0 && at.CheckSight(b)) b.DamageMobj(at, src, hurt, 'None');
		}
	}
}
class RSQB_GN_DoomBoom : Actor
{
	Default
	{
		+NOBLOCKMAP +NOGRAVITY +NOINTERACTION +DONTSPLASH
		RenderStyle "Add";
		Alpha 1.0;
	}
	States
	{
	Spawn:
		MISL B 8 Bright NoDelay A_StartSound("weapons/rocklx", CHAN_AUTO);
		MISL C 6 Bright;
		MISL D 4 Bright;
		Stop;
	}
}
// the grenade's other looks, reduced to Doom's explosion (only the Gun Bonsai VR patch's Cluster ever throws bomblets)
class RSQB_GN_SmallBlast : RSQB_GN_DoomBoom { Default { Scale 0.5; } }
class RSQB_GN_BlastKaboom : RSQB_GN_DoomBoom {}
class RSQB_GN_Blast : RSQB_GN_DoomBoom {}
class RSQB_GN_Fx play { static bool NewGrenade() { return false; } static int ColourMode() { return 0; } }

// ---- the door lift's helpers (Distance Grab's reach.zs / feel.zs / near.zs / hold.zs / grab.zs, the parts it asks) ---
class RSQB_DG_Reach play
{
	static Vector3 Palm(PlayerPawn pmo, int hand) { return hand == 0 ? pmo.AttackPos : pmo.OffhandPos; }
	static double Num(String n, PlayerInfo p, double d) { let c = CVar.GetCVar(n, p); return c ? c.GetFloat() : d; }
	static bool Flag(String n, PlayerInfo p, bool d) { let c = CVar.GetCVar(n, p); return c ? c.GetBool() : d; }
}
class RSQB_DG_A11y play { static double Wide(double v) { return v; } }
class RSQB_DG_Near play { static bool IsGripDown(int h) { return false; } }	// no grip reader here: Use or the palm takes hold
class RSQB_DG_Grab play
{
	static RSQB_DG_Grab Get() { return null; }
	bool Held(int h) { return false; }
}
class RSQB_DG_Hold play
{
	static RSQB_DG_Hold Get() { return new('RSQB_DG_Hold'); }
	// a hand with a gun in it is full: only a free fist presses a switch with its palm
	bool HandIsFull(int h)
	{
		let p = players[consoleplayer];
		if (!p || !p.mo) return true;
		if (h == 0) return !(p.ReadyWeapon is 'Fist');
		return p.OffhandWeapon && !(p.OffhandWeapon is 'RSQ_Hands');
	}
}
class RSQB_DG_Feel play
{
	const PRI_RAMP = 1;
	const PRI_LOCK = 2;
	const PRI_CATCH = 4;
	static RSQB_DG_Feel Get() { return null; }
	void Pulse(int h, int pri) {}
}
