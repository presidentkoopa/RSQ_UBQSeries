// GENERATED by tools/lib/basics.py from RSQ Grenade's zscript/rsqgn/scatter.zs (the weapon sets' basic grenade)
// RSQ Grenade -- GRENADES SCATTERED THROUGH EACH MAP, the UAC Survival Pack's way (randomuac.acs
// UAC_RandomItemSpawner, parsed): once per map, beside every item lying in the level, one roll of random(0, 125):
// 6-10 drops a single grenade (5 in 126), 18-20 a pack of three (3 in 126), 15 units to the item's south (the pack's
// y - 15), up to a cap a map (the pack's uac_grenamt 4 and uac_grenpkamt 2: rsqb_gn_singles, rsqb_gn_packs).
// The pack's other rolls (its flares, pipe bombs, satchels) are not ours and roll nothing here.
//
// Differences from the ACS, on purpose: it runs when the map is loaded (the pack waited 5 tics after a player
// entered, then gave every item a token that ran the script); it does not skip an item standing at x, y or z = 0
// (the ACS's "no position" test also skipped every item on a floor at height 0); a drop that would land in a wall is
// put on the item instead.
//
// Deterministic in netplay: every machine loads the same map, walks the same items in the same order and draws from
// the same synced random table (random[RSQB_GN_Scatter]). Not on a saved game or a hub map revisited.
class RSQB_GN_Scatter : EventHandler
{
	override void WorldLoaded(WorldEvent e)
	{
		if (e.IsSaveGame || e.IsReopen) return;
		if (!RSQB_GN_Handler.Active()) return;
		let on = CVar.FindCVar("rsqb_gn_scatter");
		if (on && !on.GetBool()) return;
		int capS, capP, winS, winP, sv;
		[capS, capP, winS, winP, sv] = Plan();

		Array<Inventory> items;
		let it = ThinkerIterator.Create("Inventory");
		Inventory i;
		while (i = Inventory(it.Next()))
			// a pickup lying in the level (bSpecial: it can be touched); not what a player carries, nor the unowned
			// armour and ammo objects the engine keeps at the map's origin (seen on the rig: HexenArmor, BasicArmor)
			if (!i.Owner && i.bSpecial && !(i is "RSQB_GN_Ammo")) items.Push(i);

		int s = 0, kp = 0;
		for (int j = 0; j < items.Size(); j++)
		{
			int r = random[RSQB_GN_Scatter](0, 125);
			if (sv > 0)
			{
				// Scavenger's wider windows (the same 126 rolls): singles below winS, packs in the winP after 13
				if (r < winS && s < capS) { if (Drop("RSQB_GN_Ammo", items[j])) s++; }
				else if (r >= 13 && r < 13 + winP && kp < capP) { if (Drop("RSQB_GN_Pack", items[j])) kp++; }
			}
			else if (r > 5 && r <= 10 && s < capS) { if (Drop("RSQB_GN_Ammo", items[j])) s++; }
			else if (r > 17 && r <= 20 && kp < capP) { if (Drop("RSQB_GN_Pack", items[j])) kp++; }
		}
		if (players[consoleplayer].mo && RSQB_GN_Handler.Debug(players[consoleplayer]))
			Console.Printf("RSQGN scatter %s: %d items rolled, %d single grenades (cap %d), %d packs (cap %d)%s", level.MapName, items.Size(), s, capS, kp, capP, sv > 0 ? String.Format(", Scavenger %d", sv) : "");
	}

	// how many a map and the roll windows: the rows' caps; SCAVENGER (Gun Bonsai VR patch), the best level among the
	// players, raises the caps and the odds by half a level (4 + 2 -> 6 + 3, 8 + 4, 10 + 5)
	static int, int, int, int, int Plan()
	{
		int capS = clamp(int(RSQB_GN_Handler.SNum("rsqb_gn_singles", 4)), 0, 16);
		int capP = clamp(int(RSQB_GN_Handler.SNum("rsqb_gn_packs", 2)), 0, 16);
		int sv = 0;
		for (int n = 0; n < MAXPLAYERS; n++) if (playeringame[n] && players[n].mo) sv = max(sv, RSQB_GN_Upg.Lv(players[n].mo, "Scavenger"));
		double k = sv > 0 ? RSQB_GN_Upg.Num("Scavenger.share", sv, 1.0) : 1.0;
		if (sv > 0) { capS = int(capS * k + 0.5); capP = int(capP * k + 0.5); }
		return capS, capP, int(5 * k + 0.5), int(3 * k + 0.5), sv;
	}

	static bool Drop(class<Actor> c, Actor by)
	{
		let a = Actor.Spawn(c, by.pos + (0, -15, 0), ALLOW_REPLACE);
		if (!a) return false;
		if (!a.TestMobjLocation()) a.SetOrigin(by.pos, false);
		return true;
	}
}
