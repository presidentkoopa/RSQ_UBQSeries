    frame PLZSB { light PLASMABALL }

    frame PLZEA { light PLASMA_X1 }
    frame PLZEB { light PLASMA_X2 }
    frame PLZEC { light PLASMA_X2 }
    frame PLZED { light PLASMA_X3 }
    frame PLZEE { light PLASMA_X4 }
}

