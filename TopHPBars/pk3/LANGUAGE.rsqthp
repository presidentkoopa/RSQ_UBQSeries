// RSQ HP Bars -- Damage Numbers: colours by damage type, from damnums by Xaser Acheron (MIT), renamed.
// Another mod can add RSQTHP_DMG_TYPECOLOR_<type> = "RSQTHP_Dam<colour>"; damnums' own DAMNUM_TYPECOLOR_<type> = "Dam<colour>" is read too.

[enu default]

RSQTHP_DMG_TYPECOLOR_STEEL        = "RSQTHP_DamWhite";
RSQTHP_DMG_TYPECOLOR_BLOOD        = "RSQTHP_DamRed";
RSQTHP_DMG_TYPECOLOR_ICE          = "RSQTHP_DamLightBlue";
RSQTHP_DMG_TYPECOLOR_FIRE         = "RSQTHP_DamOrange";
RSQTHP_DMG_TYPECOLOR_EARTH        = "RSQTHP_DamBrown";
RSQTHP_DMG_TYPECOLOR_QUAKE        = "RSQTHP_DamBrown";
RSQTHP_DMG_TYPECOLOR_ELECTRIC     = "RSQTHP_DamYellow";
RSQTHP_DMG_TYPECOLOR_LIGHTNING    = "RSQTHP_DamYellow";
RSQTHP_DMG_TYPECOLOR_GRAVITY      = "RSQTHP_DamPurple";
RSQTHP_DMG_TYPECOLOR_POISON       = "RSQTHP_DamPurple";
RSQTHP_DMG_TYPECOLOR_POISONCLOUD  = "RSQTHP_DamPurple";
RSQTHP_DMG_TYPECOLOR_DARK         = "RSQTHP_DamBlack";
RSQTHP_DMG_TYPECOLOR_ROCKET       = "RSQTHP_DamGold";
RSQTHP_DMG_TYPECOLOR_EXPLODE      = "RSQTHP_DamGold";
RSQTHP_DMG_TYPECOLOR_EXPLOSIVE    = "RSQTHP_DamGold";
RSQTHP_DMG_TYPECOLOR_EXPLOSION    = "RSQTHP_DamGold";
RSQTHP_DMG_TYPECOLOR_PLASMA       = "RSQTHP_DamCyan";
RSQTHP_DMG_TYPECOLOR_DISINTEGRATE = "RSQTHP_DamGreen";
RSQTHP_DMG_TYPECOLOR_BFG          = "RSQTHP_DamGreen";
RSQTHP_DMG_TYPECOLOR_BFGSPLASH    = "RSQTHP_DamGreen";
