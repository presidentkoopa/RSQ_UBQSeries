[en default]
// Gun Bonsai VR patch -- the melee upgrades.
RSQ_GLOVE_TAG = "Boxing Gloves";
RSQ_GLOVE_PICKUP = "You put on the boxing gloves!";
RSQ_GLOVE_OB = "%o was knocked out by %k.";

RSQ_Upgrade_Haymaker_Name = "Haymaker";
RSQ_Upgrade_Haymaker_Desc = "Glove: the harder you swing, the more it hurts.";
RSQ_Upgrade_Haymaker_TT = "Punch damage @soft for the slowest punch that counts, up to @hard for a full-speed one.";
RSQ_Upgrade_OneTwo_Name = "One-Two";
RSQ_Upgrade_OneTwo_Desc = "Glove: alternate left and right to chain.";
RSQ_Upgrade_OneTwo_TT = "Each hit with the other hand within half a second adds @step, up to @max. A miss or a pause breaks the chain.";
RSQ_Upgrade_StarPunch_Name = "Star Punch";
RSQ_Upgrade_StarPunch_Desc = "Glove: clean hits bank stars; trigger + uppercut spends one.";
RSQ_Upgrade_StarPunch_TT = "Counters and steady landed punches bank stars (up to 3). Throw an uppercut with that hand's trigger held to spend one: @mult damage and the target is launched.";
RSQ_Upgrade_Counterpunch_Name = "Counterpunch";
RSQ_Upgrade_Counterpunch_Desc = "Glove: hit them as they wind up to attack.";
RSQ_Upgrade_Counterpunch_TT = "A punch that lands during an enemy's attack wind-up does @mult and staggers it for @time.";
RSQ_Upgrade_BodyBlow_Name = "Body Blow";
RSQ_Upgrade_BodyBlow_Desc = "Glove: hits below the chest wind them.";
RSQ_Upgrade_BodyBlow_TT = "A punch to the body slows everything the enemy does (about @slow) for @time.";
RSQ_Upgrade_Knockdown_Name = "Knockdown";
RSQ_Upgrade_Knockdown_Desc = "Glove: enough punishment puts them down for a count.";
RSQ_Upgrade_Knockdown_TT = "Punches worth @share of an enemy's health within two seconds put it on the floor for a count of @count.";

RSQ_Upgrade_Lunge_Name = "Lunge";
RSQ_Upgrade_Lunge_Desc = "Melee: step into the blow.";
RSQ_Upgrade_Lunge_TT = "Melee damage @per for every metre per second your head is travelling, up to @max.";
RSQ_Upgrade_Executioner_Name = "Executioner";
RSQ_Upgrade_Executioner_Desc = "Melee: a staggered enemy near death dies to one hit.";
RSQ_Upgrade_Executioner_TT = "Any melee hit kills a staggered enemy below @share health.";
RSQ_Upgrade_Adrenaline_Name = "Adrenaline";
RSQ_Upgrade_Adrenaline_Desc = "Melee: big moments slow the world (RSQ SlowMo).";
RSQ_Upgrade_Adrenaline_TT = "Three melee kills in three seconds, a big monster, or an execution fires a @time slow-motion pulse. Needs RSQ SlowMo.";

RSQ_Upgrade_Momentum_Name = "Momentum";
RSQ_Upgrade_Momentum_Desc = "Saber: keep the blade moving and it cuts harder.";
RSQ_Upgrade_Momentum_TT = "@step damage for every half second the blade keeps moving, up to @max. It resets when the blade stops.";
RSQ_Upgrade_RiposteEdge_Name = "Riposte Edge";
RSQ_Upgrade_RiposteEdge_Desc = "Saber: a block primes the next cut.";
RSQ_Upgrade_RiposteEdge_TT = "After a block or a deflect, the next cut within @time does @mult damage.";
RSQ_Upgrade_PiercingReturn_Name = "Piercing Return";
RSQ_Upgrade_PiercingReturn_Desc = "Saber: returned bolts go through bodies.";
RSQ_Upgrade_PiercingReturn_TT = "A returned bolt passes through @n bodies, hurting each, before it stops.";
RSQ_Upgrade_SaberThrow_Name = "Saber Throw";
RSQ_Upgrade_SaberThrow_Desc = "Saber: the thrown saber hunts more targets.";
RSQ_Upgrade_SaberThrow_TT = "When its route is done, the thrown saber flies on to @n more enemies near it.";
RSQ_Upgrade_ChainChoke_Name = "Chain Choke";
RSQ_Upgrade_ChainChoke_Desc = "Saber: a choke kill jumps the grip.";
RSQ_Upgrade_ChainChoke_TT = "When a Force choke kills, the grip jumps to the nearest enemy within @r while you hold it.";
RSQ_Upgrade_DualHarmony_Name = "Dual Harmony";
RSQ_Upgrade_DualHarmony_Desc = "Saber: alternate the two blades to stack damage.";
RSQ_Upgrade_DualHarmony_TT = "Each cut with the other saber within three quarters of a second adds @step, up to @max.";
RSQ_Upgrade_ForcePush_Name = "Force Push";
RSQ_Upgrade_ForcePush_Desc = "Saber: a stronger push; a wider cone; then a shockwave.";
RSQ_Upgrade_ForcePush_TT = "Push at @pwr. Level 2 opens the cone; level 3 adds a shockwave all round you.";
RSQ_Upgrade_ForcePull_Name = "Force Pull";
RSQ_Upgrade_ForcePull_Desc = "Saber: a stronger pull that stuns, then disarms.";
RSQ_Upgrade_ForcePull_TT = "Pull at @pwr. Level 2 stuns what arrives; level 3 yanks its weapon away (no ranged attacks).";
RSQ_Upgrade_ForceChoke_Name = "Force Choke";
RSQ_Upgrade_ForceChoke_Desc = "Saber: a choke that lifts, crushes, then holds several.";
RSQ_Upgrade_ForceChoke_TT = "Choke at @pwr. Level 2 lifts and crushes harder the longer you hold; level 3 and up holds @n.";
RSQ_Upgrade_ForceJump_Name = "Force Jump";
RSQ_Upgrade_ForceJump_Desc = "Saber: a higher jump; then a slam when you land.";
RSQ_Upgrade_ForceJump_TT = "Jump at @pwr. Level 2 and up: landing from a Force jump slams everything around you.";

RSQ_Upgrade_Ricochet_Name = "Ricochet";
RSQ_Upgrade_Ricochet_Desc = "ShieldSaw: the disc bounces off walls into new targets.";
RSQ_Upgrade_Ricochet_TT = "A thrown disc that hits a wall turns toward a new enemy instead of coming home, @n times.";
RSQ_Upgrade_MeatGrinder_Name = "Meat Grinder";
RSQ_Upgrade_MeatGrinder_Desc = "ShieldSaw: an embedded kill frees the disc at full speed.";
RSQ_Upgrade_MeatGrinder_TT = "Kill what the disc is stuck in and it flies straight to the next lock at full speed. Grind damage @grind.";
RSQ_Upgrade_HuntersReturn_Name = "Hunter's Return";
RSQ_Upgrade_HuntersReturn_Desc = "ShieldSaw: the way home swerves through enemies.";
RSQ_Upgrade_HuntersReturn_TT = "On its way back the disc swerves into up to @n enemies within @r of its path.";
RSQ_Upgrade_Bulwark_Name = "Bulwark";
RSQ_Upgrade_Bulwark_Desc = "ShieldSaw: perfect blocks are easier.";
RSQ_Upgrade_Bulwark_TT = "A perfect block needs only @need of the usual plate speed.";
RSQ_Upgrade_Rebound_Name = "Rebound";
RSQ_Upgrade_Rebound_Desc = "ShieldSaw: turned shots hit harder.";
RSQ_Upgrade_Rebound_TT = "Shots the shield turns or sends back do @mult damage.";
RSQ_Upgrade_BatteringRam_Name = "Battering Ram";
RSQ_Upgrade_BatteringRam_Desc = "ShieldSaw: bash them into each other.";
RSQ_Upgrade_BatteringRam_TT = "A bashed enemy flies further, and whatever it hits takes @dmg damage, and so does it.";

RSQ_MENU_TITLE = "RSQ Melee Upgrades";
RSQ_MENU_SLAPPERS = "Slappers Only";
RSQ_MENU_SLAPPERS_TT = "Your guns are taken at each level start and gun pickups are gone. You keep the gloves, sabers, ShieldSaw, and Brutal Doom's fists, axe and sword.";
RSQ_MENU_GLOVES = "Start with boxing gloves";
RSQ_MENU_ADV = "Advanced";
RSQ_MENU_FORCE_START = "Force strength before upgrades";
RSQ_MENU_PUNCH_MIN = "Slowest punch that counts (m/s)";
RSQ_MENU_PUNCH_FULL = "Full-power punch (m/s)";
RSQ_MENU_PUNCH_DMG = "Punch damage";
RSQ_MENU_STAR_FIRST = "Star after this many hits";
RSQ_MENU_STAR_EVERY = "Then a star every";
