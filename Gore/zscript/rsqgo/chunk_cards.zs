// RSQ Gore phase 3 classes -- GENERATED by Gore/tools/chunk_gen.py from 1.00_brutal22test6.pk3 and 1.3-XMVE_MonsterExpansion1.3.1-BD22.pk3. Never hand-edit.
//
// One class per Brutal Doom / XMVE meat, guts, limb, head, half and casing class: BD's own properties and states
// (the chain flattened, only what is reachable), run by the engine, with the phase 3 changes listed in the
// generator's docstring (trails as particles, parking instead of the corpse queue, one actor that flies and then
// becomes the landed limb, BD's ACS checks done natively). The runtime is chunks.zs; why each class is what it is:
// generated/chunk_summary.txt. Labels R<n>_<k> / B<n>_<k> are generated; F_ labels are a flier's own (see
// RSQGO_DeathEntry). RSQGO_GB_<BD base> classes hold the states a BD base class shares (never spawned, not taken
// over): the classes under it inherit them as BD's do, so they are compiled once.

// ---- shared bases: states BD keeps in a base class, inherited instead of copied (chunk_gen.py Gen.share)

// shared states of BD's BaronHeadPiece (5 classes)
class RSQGO_GB_BaronHeadPiece : RSQGO_Chunk
{
	States
	{
	B0_0:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "death");
		XHE5 I 4;
		XHE5 J 4;
		XHE5 K 4;
		XHE5 L 4;
		goto B0_0;
	B0_1:
		XHE5 I 1;
		TNT1 A 0;
		TNT1 A 0 RSQGO_Janitor();
	B0_2:
		XHE5 I 800 { RSQGO_LongRest(); }
		TNT1 A 0 RSQGO_JumpIfLowGfx(1, "donothing");
		goto B0_2;
	B0_3:
		TNT1 A 0;
		stop;
	}
}

