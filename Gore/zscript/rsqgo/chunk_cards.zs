// shared states of BD's Guts (8 classes)
class RSQGO_GB_Guts : RSQGO_Chunk
{
	States
	{
	spawn:
		GUTS A 1;
		TNT1 A 0 A_Jump(255, "spawn1", "spawn2", "spawn3", "spawn4");
	spawn1:
		TNT1 A 0;
		TNT1 A 0 A_SetScale(0.9, 0.8);
		goto B7_0;
	spawn2:
		TNT1 A 0;
		TNT1 A 0 A_SetScale(-1.0, 1.0);
		goto B7_0;
	spawn3:
		TNT1 A 0;
		TNT1 A 0 A_SetScale(1.2, 1.0);
		goto B7_0;
	spawn4:
		TNT1 A 0;
		TNT1 A 0 A_SetScale(-0.6, 1.0);
	B7_0:
		GUTS A 3 A_JumpIf(waterlevel > 1, "water");
		GUTS B 3 A_JumpIf(waterlevel > 1, "water");
		GUTS C 3 A_JumpIf(waterlevel > 1, "water");
		GUTS D 3 A_JumpIf(waterlevel > 1, "water");
		GUTS E 3 A_JumpIf(waterlevel > 1, "water");
		GUTS F 3 A_JumpIf(waterlevel > 1, "water");
		GUTS G 3 A_JumpIf(waterlevel > 1, "water");
		GUTS H 3 A_JumpIf(waterlevel > 1, "water");
		GUTS H -1;
		goto B7_0;
	death:
		TNT1 A 0;
		TNT1 A 0 A_SetScale(1.0, 1.0);
		TNT1 A 0 A_JumpIf(waterlevel > 1, "water");
		TNT1 A 0;
		TNT1 A 0;
		TNT1 A 0;
		TNT1 A 0 A_Jump(255, "rest1", "rest2");
	rest1:
		GUTS K 1;
		GUTS K -1;
		stop;
	rest2:
		GUTS L 1;
		GUTS L -1;
		stop;
	water:
	B7_1:
		GUTS G 10;
		GUTS H 10;
		GUTS I 10;
		GUTS H 10;
		goto B7_1;
	}
}

