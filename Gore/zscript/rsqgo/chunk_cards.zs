		TNT1 A 0 A_StartSound("FOOTWALL", 3, 0, 1, ATTN_NORM);
		TNT1 A 20;
		stop;
	pain:
		TNT1 A 0;
		TNT1 A 0 ThrustThingZ(0, 20, 0, 1);
		XHE4 A 2;
		XHE4 B 2;
		XHE4 C 2;
		XHE4 D 2;
		XHE4 E 2;
		XHE4 F 2;
		XHE4 G 2;
		XHE4 H 2;
		goto R267_0;
	death.explosiveimpact:
		TNT1 A 0;
		TNT1 A 0 A_ChangeLinkFlags(0);
		TNT1 A 0 ThrustThingZ(0, 50, 0, 1);
		XHE4 A 3;
		XHE4 B 3;
		XHE4 C 3;
		XHE4 D 3;
		XHE4 E 3;
		XHE4 F 3;
		XHE4 G 3;
		XHE4 H 3;
		XDT5 I 0 RSQGO_Become(0, false, false);
		stop;
	death.trample:
		goto B79_5;
	crush:
		goto B79_7;
	death.plasma:
