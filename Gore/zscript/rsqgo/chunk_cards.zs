		XDT1 I 3;
		XDT1 J 3;
		XDT1 K 3;
		XDT1 L 3;
		stop;
	underwater:
	R58_0:
		BLUD C 0 ThrustThingZ(0, 35, 1, 0);
		XDT1 A 3 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		XDT1 B 3 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		BLUD C 0 ThrustThingZ(0, 35, 1, 0);
		XDT1 C 3 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		XDT1 D 3 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		goto R58_0;
	isoverliquid:
		TNT1 A 1;
		TNT1 A 0 A_CheckFloor("spawnonwater");
	spawnonwater:
		TNT1 A 1;
		TNT1 A 0 RSQGO_Item('AlienWaterBloodSpot', 5, 0, false);
		stop;
	}
}

