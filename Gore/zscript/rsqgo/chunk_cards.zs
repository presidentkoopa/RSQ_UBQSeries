		stop;
	death.kick:
	death.melee:
	death.superpunch:
		QARM X 1 A_FaceTarget();
		QARM X 1 A_FaceTarget();
		TNT1 A 0 RSQGO_Missile('XDeathHFQSZArm1Kicked', 5, 0, random(170, 190), 2, random(20, 40), true);
		stop;
	pain:
		TNT1 A 0;
		TNT1 A 0 ThrustThingZ(0, 20, 0, 1);
		QARM A 3;
		QARM B 3;
		QARM C 3;
		QARM D 3;
		QARM E 3;
		QARM F 3;
		QARM G 3;
		QARM H 3;
		goto R232_0;
	death.explosiveimpact:
		TNT1 A 0;
		TNT1 A 0 A_ChangeLinkFlags(0);
		TNT1 A 0 ThrustThingZ(0, 50, 0, 1);
		QARM G 3;
		QARM H 3;
		QARM A 3 A_CheckFloor("landz");
