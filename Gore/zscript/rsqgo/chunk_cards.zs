		stop;
	death.kick:
	death.melee:
	death.superpunch:
		XHE4 E 1 A_FaceTarget();
		XHE4 E 1 A_FaceTarget();
		TNT1 A 0 RSQGO_Missile('XDeathImpHead', 5, 0, random(170, 190), 2, random(20, 40), true);
		TNT1 A 0 A_StartSound("misc/xdeath5", 1, 0, 1, ATTN_NORM);
		TNT1 A 0 A_StartSound("FOOTWALL", 3, 0, 1, ATTN_NORM);
		TNT1 A 20;
		stop;
	death.headkick:
		TNT1 A 0;
		TNT1 A 0 A_NoBlocking();
		XHE2 E 0 A_FaceTarget();
		XHE2 E 0 A_FaceTarget();
		TNT1 A 0 RSQGO_Missile('XDeathImpHead2', 5, 0, random(170, 190), 2, random(20, 30), true);
