		bBOUNCEAUTOOFF = false;
		bBOUNCEONCEILINGS = false;
		bBOUNCEONFLOORS = false;
		bBOUNCEONWALLS = false;
		A_ChangeLinkFlags(0, 0);
	}
	override Name RSQGO_FlyBlood(int type)
	{
		if (type == 0) return 'Blood';
		if (type == 1) return 'BloodSplatter';
		if (type == 2) return 'AxeBlood';
		return 'None';
	}
	override void RSQGO_ToFlier()
	{
		CopyBloodColor(GetDefaultByType('Actor'));      // BD's flier has no blood colour
	}
	States
	{
	spawn:
	R324_0:
		TNT1 A 0 RSQGO_Item('Alien_BloodSpot', 0, 1, false);
		TNT1 A 0 A_JumpIf(waterlevel > 1, "F_death");
		"9AAG" A 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"9AAG" B 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
