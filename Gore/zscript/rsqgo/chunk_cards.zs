class RSQGO_G_AlienArm : RSQGO_G_AlienArm1
{
	Default
	{
		Radius 8;
		Height 8;
		Speed 8;
		Mass 1;
		Health 1000;
		Bouncefactor 0.2;
		Wallbouncefactor 0.2;
		Bouncecount 3;
		Gravity 0.5;
		Scale 1.1;
		DeathSound "bloood";
		SeeSound "bloood";
		DamageType "Limb";
		Decal "BrutalBloodSplat";
		PainChance 0;
		BounceType "DoomCompat";
		RSQGO_Chunk.GibOf "RSQGO_G_AlienArm1";
		+DONTSPLASH;
		-FLOORCLIP;
		+FORCEXYBILLBOARD;
		-GHOST;
		+MISSILE;
		+MOVEWITHSECTOR;
		+NOBLOCKMAP;
		-NOBLOCKMONST;
		-NOTAUTOAIMED;
		+NOTELEPORT;
		-SHOOTABLE;
		+SKYEXPLODE;
		-SLIDESONWALLS;
		-SOLID;
		-THRUACTORS;
	}
	override void RSQGO_ToGib()
	{
		bCORPSE = false;
		bDONTSPLASH = true;
		bDROPOFF = false;
		bFLOAT = false;
		bFLOORCLIP = true;
		bFORCEXYBILLBOARD = true;
		bGHOST = true;
		bJUSTHIT = false;
		bKILLED = false;
		bMISSILE = false;
		bMOVEWITHSECTOR = true;
		bNOBLOCKMONST = true;
		bNOCLIP = false;
		bNOGRAVITY = false;
		bNOTAUTOAIMED = true;
		bNOTELEPORT = true;
		bSHOOTABLE = true;
		bSKULLFLY = false;
		bSKYEXPLODE = false;
		bSLIDESONWALLS = true;
		bSOLID = false;
		bTHRUACTORS = true;
		bALLOWBOUNCEONACTORS = false;
		bBOUNCEAUTOOFF = false;
		bBOUNCEONCEILINGS = false;
		bBOUNCEONFLOORS = false;
		bBOUNCEONWALLS = false;
		A_ChangeLinkFlags(0, 0);
	}
	override Name RSQGO_FlyBlood(int type)
	{
		if (type == 0) return 'Blood';
		if (type == 1) return 'BloodSplatter';
		if (type == 2) return 'AxeBlood';
		return 'None';
	}
	override void RSQGO_ToFlier()
	{
		CopyBloodColor(GetDefaultByType('Actor'));      // BD's flier has no blood colour
	}
	States
	{
	spawn:
	R130_0:
		TNT1 A 0 RSQGO_Item('Alien_BloodSpot', 0, 1, false);
		TNT1 A 0 A_JumpIf(waterlevel > 1, "F_death");
		"10AG" A 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" E 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" B 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" C 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" F 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" D 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" G 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		"10AG" H 5 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		goto R130_0;
	F_death:
		"10AG" I 1;
		"10AG" A 0 RSQGO_Become(0, false, false);
		stop;
	Death:
		TNT1 A 0 RSQGO_DeathEntry;
		stop;
	}
}

