		TNT1 A 0 RSQGO_Missile('GenericHKGib2', 2, 0, random(0, 360), 2, random(10, 90), true);
		stop;
	death.explosiveimpact:
	death.kick:
	death.melee:
	death.superpunches:
		TNT1 A 0 A_ChangeLinkFlags(0);
		TNT1 A 0;
		TNT1 A 0 ThrustThingZ(0, 40, 0, 1);
		ZDM2 A 5;
		ZDM2 A 5 A_CheckFloor("landz");
		ZDM2 B 5 A_CheckFloor("landz");
		ZDM2 C 5 A_CheckFloor("landz");
		ZDM2 D 5 A_CheckFloor("landz");
