	R267_0:
		TNT1 A 0;
		TNT1 A 0;
		TNT1 A 0 RSQGO_Item('Brutal_BloodSpot', 0, 0, false);
		TNT1 A 0 A_Jump(256, "spawn1", "spawn2", "spawn3");
