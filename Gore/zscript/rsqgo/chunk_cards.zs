		+LOOKALLAROUND;
		+MOVEWITHSECTOR;
		-NOBLOCKMAP;
		+NOBLOCKMONST;
		+NOTAUTOAIMED;
		+NOTELEPORT;
		+SHOOTABLE;
		+SLIDESONWALLS;
		-SOLID;
		-THRUACTORS;
	}
	override void RSQGO_ToGib()
	{
		bCORPSE = false;
		bCOUNTKILL = false;
		bDONTSPLASH = true;
		bDROPOFF = false;
		bFLOAT = false;
		bFLOORCLIP = true;
		bFORCEXYBILLBOARD = true;
		bGHOST = true;
		bJUSTHIT = false;
		bKILLED = false;
		bLOOKALLAROUND = true;
		bMOVEWITHSECTOR = true;
		bNOBLOCKMONST = true;
		bNOCLIP = false;
		bNOGRAVITY = false;
		bNOTAUTOAIMED = true;
		bNOTELEPORT = true;
		bSHOOTABLE = true;
		bSKULLFLY = false;
		bSLIDESONWALLS = true;
		bSOLID = false;
		bTHRUACTORS = false;
		A_ChangeLinkFlags(0, 0);
	}
	States
	{
	spawn:
	R469_0:
		TNT1 A 0;
		TNT1 A 0;
		TNT1 A 0;
		TNT1 A 0 RSQGO_Item('Brutal_BloodSpot', 0, 0, false);
		ZHE2 E 1;
		ZHE2 E -1;
		stop;
	death:
		TNT1 A 0;
		TNT1 A 0 RSQGO_Item('ShotgunguyHeadExplode', 0, 0, false);
		stop;
	death.kick:
	death.melee:
	death.superpunch:
		ZHE2 E 1 A_FaceTarget();
		ZHE2 E 1 A_FaceTarget();
		TNT1 A 0 RSQGO_ItemEx('Blood', 0, 0, 10, 0, 0, 0, 0, 0, 0);
		TNT1 A 0 RSQGO_ItemEx('Blood', 0, 0, 10, 0, 0, 0, 0, 0, 0);
		TNT1 A 0 RSQGO_ItemEx('Blood', 0, 0, 10, 0, 0, 0, 0, 0, 0);
		TNT1 A 0 RSQGO_ItemEx('Blood', 0, 0, 10, 0, 0, 0, 0, 0, 0);
		TNT1 A 0 RSQGO_Missile('XDeathZSpecOpsHead', 5, 0, random(170, 190), 2, random(20, 40), true);
		TNT1 A 0 A_StartSound("misc/xdeath4", 1, 0, 1, ATTN_NORM);
		TNT1 A 0 A_StartSound("player/cyborg/fist", 3, 0, 1, ATTN_NORM);
		TNT1 A 20;
		stop;
	pain:
		TNT1 A 0;
		TNT1 A 0 ThrustThingZ(0, 20, 0, 1);
		ZHE2 A 2;
		ZHE2 B 2;
		ZHE2 C 2;
		ZHE2 D 2;
		goto R469_0;
	death.explosiveimpact:
		TNT1 A 0;
		TNT1 A 0 A_ChangeLinkFlags(0);
		TNT1 A 0 ThrustThingZ(0, 50, 0, 1);
		ZHE2 A 3;
		ZHE2 B 3;
		ZHE2 C 3;
		ZHE2 D 3;
		ZHE2 E 3;
		ZHE2 F 3;
		ZHE2 G 3;
		ZHE2 H 3;
		TNT1 A 0 RSQGO_Become(0, false, false);
		stop;
	death.headkick:
		goto B79_11;
	death.trample:
		goto B79_5;
	crush:
		goto B79_7;
	death.plasma:
		goto B79_8;
	}
}

