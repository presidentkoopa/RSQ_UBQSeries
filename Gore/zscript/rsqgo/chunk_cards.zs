		TNT1 A 0 { bSHOOTABLE = true; }
		XHE1 C 3;
		XHE1 D 3;
		XHE1 E 3;
		XHE1 F 3;
		XHE1 G 3;
		XHE1 H 3;
		goto B101_0;
	F_death:
		XHE1 E 1 { bTHRUACTORS = true; }
		TNT1 A 0 A_JumpIfHealthLower(0, "F_death2");
		XHE1 E 1 RSQGO_Become(0, false, true);
		stop;
	F_death2:
		TNT1 A 0;
		TNT1 A 0 RSQGO_Item('ShotgunguyHeadExplode', 0, 0, false);
		stop;
	}
}

