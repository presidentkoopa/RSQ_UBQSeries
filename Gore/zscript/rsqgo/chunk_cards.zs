		XMT1 H 2 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 360), 2, random(0, 360), true);
		goto B60_0;
	death:
		TNT1 A 0 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 180), 2, random(0, 180), true);
		TNT1 A 0 RSQGO_Missile('Alien_FlyingBloodTrail', 0, 0, random(0, 180), 2, random(0, 180), true);
