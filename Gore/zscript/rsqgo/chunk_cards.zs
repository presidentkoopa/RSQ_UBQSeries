		goto B27_0;
	B27_1:
		TNT1 A 0 RSQGO_Missile('Brutal_FlyingBloodFaster', 0, 0, random(0, 360), 2, random(40, 90), true);
		TNT1 A 0 RSQGO_Missile('Brutal_FlyingBloodFaster', 0, 0, random(0, 360), 2, random(40, 90), true);
