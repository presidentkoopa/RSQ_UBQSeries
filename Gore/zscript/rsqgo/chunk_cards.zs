		ZDM2 C 5 A_CheckFloor("landz");
		ZDM2 D 5 A_CheckFloor("landz");
		ZDM2 E 5 A_CheckFloor("landz");
		ZDM2 F 5 A_CheckFloor("landz");
		ZDM2 G 5 A_CheckFloor("landz");
		ZDM2 H 5 A_CheckFloor("landz");
	landz:
		XDT5 I 0 RSQGO_Become(0, false, false);
		stop;
	death.plasma:
		goto B2_3;
	death.desintegrate:
	death.superpunch:
		goto B55_1;
	donothing:
