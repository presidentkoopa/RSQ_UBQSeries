	States
	{
	spawn:
	R232_0:
		QARM X 1900 { RSQGO_Item('brutal_BloodSpot', 0, 0, true); RSQGO_Hold(); }
		goto R232_0;
	death.burn:
	death.flames:
	death.plasma:
