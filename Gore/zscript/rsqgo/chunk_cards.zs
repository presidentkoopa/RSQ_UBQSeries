		BLOD A 1 RSQGO_Item('Alien_LiquidBloodTrail', 0, 0, false);
		stop;
	death:
		TNT1 A 0 RSQGO_ItemEx('Alien_BloodSpot', 0, 0, 1, 0, 0, 0, 0, 0, 0);
		TNT1 A 0 RSQGO_LiquidCheck();
		XDT1 E 3;
		XDT1 F 3;
		TNT1 A 0 RSQGO_JumpIfLiquid(4, "isoverliquid");
		TNT1 A 0 RSQGO_JumpIfLiquid(3, "isoverliquid");
