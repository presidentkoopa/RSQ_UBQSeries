extend class RSQGO_Gibs
{
	const NLIQUID = 5;

	// BD class -> our class (the takeover; RSQGO_Gibs.Lookup)
	void BuildTable()
	{
		Add('AlienBrainPiece', 'RSQGO_G_AlienBrainPiece');
		Add('AlienGuts', 'RSQGO_G_AlienGuts');
		Add('AlienGuts2', 'RSQGO_G_AlienGuts2');
		Add('BlueGuts', 'RSQGO_G_BlueGuts');
