		TNT1 A 0 A_JumpIf(vel.z == 0, "F_death");
		VILP C 3;
		VILP D 3;
		TNT1 A 0 { bTHRUSPECIES = false; }
		VILP E 3;
		VILP F 3;
		VILP G 3;
		VILP H 3;
		VILP I 3;
		VILP J 3;
