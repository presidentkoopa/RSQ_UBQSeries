	// BD_CheckIfOverLiquid (SPLASH.acs): the floors that give each liquid token, in RSQGO_JumpIfLiquid's order
	void BuildLiquids()
	{
		AddLiquid(0, "BLOOD1 BLOOD2 BLOOD3 BLOOD4");	// isoverblood
		AddLiquid(1, "SLIME09 SLIME10 SLIME11 SLIME12 LAVA1 LAVA2 LAVA3 LAVA4");	// isoverlava
		AddLiquid(2, "NUKAGE1 NUKAGE2 NUKAGE3 NUKAGE4");	// isovernukage
		AddLiquid(3, "SLIME01 SLIME02 SLIME03 SLIME04 SLIME05 SLIME06 SLIME07 SLIME08");	// isoverslime
		AddLiquid(4, "FWATER1 FWATER2 FWATER3 FWATER4");	// isoverwater
	}
}
