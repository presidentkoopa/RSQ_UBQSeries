// ============================================================
// RSQ Wheel -- KEYCONF (REMA's RS_WeaponSelectionSystem)
// ============================================================
//
// One key section, named for the mod. The wheel originally shipped two
// ("RSVR HUD" and "RSVR HUD - gun placement") and was folded down to one when
// it was merged into RS_VR_Unified; it stays one here, because MENUDEF's
// Control rows bind the ALIAS name ("wr_toggle_off", "wr_place", ...) and never
// the section, so the split was only ever grouping in the controls list.
//
// Every alias here is wr_*, and every netevent it fires is wr_*, so nothing
// collides with a package using rs_* / rr_* / hs_*.

addkeysection "RSQ Wheel" RSQWheel

// -- the ring itself.
//
// THE ONLY DEFAULT BINDS IN THIS PACKAGE, and they are inherited rather than
// chosen -- everything above is deliberately unbound. They are kept because
// dropping them would silently change the wheel's out-of-box behaviour during
// what is meant to be a packaging change.
//
// THEY COLLIDE, and it is worth knowing exactly how. UZDXREMA's own
// engine/commonbinds.txt binds '[' to invprev and ']' to invnext, so on a
// desktop profile these two lines do nothing at all: FKeyBindings::DefaultBind
// refuses a key that is already bound and prints "Key already bound" rather
// than overwriting it. On the VR profiles (engine/vr/commonbinds.txt,
// vr/defbind0.txt, vr/defbind3.txt) inventory prev/next live on pgup/pgdn,
// mwheel and the dpad, the brackets are free, and these DO take. So the wheel
// opens on [ and ] in VR and appears unbound on a desktop config -- which is
// the right way round for a VR mod, but is not obvious from the file.
// RSQ: HOLD, POINT, RELEASE. One button: hold it, point either hand at a card, let go to take it;
// tap it to leave the ring up; tap twice to go back to the last gun. Left thumbstick click by
// default (nothing in brutal22test6, BD22 VR-Reloaded 2.0.3h or its hotfix binds it; a key
// already bound is never overwritten).
alias +wr_wheel "netevent wr_press 1"
alias -wr_wheel "netevent wr_press 0"
addmenukey "Wheel: hold, point, release" +wr_wheel
defaultbind LThumb +wr_wheel

// RSQ: one button for the ring both hands pick from (wr_either_hand), tap to open, tap to close.
alias wr_toggle_any  "netevent wr_toggle_any"
addmenukey "Wheel: open"  wr_toggle_any
alias wr_toggle_off  "netevent wr_toggle_off"
alias wr_toggle_main "netevent wr_toggle_main"
addmenukey "Wheel: off hand"  wr_toggle_off
addmenukey "Wheel: main hand" wr_toggle_main
defaultbind ] wr_toggle_off
defaultbind [ wr_toggle_main

// Legacy spelling, kept so an already-written config that binds wr_toggle
// still works. It fires wr_toggle_off, exactly as it did in the source file --
// which makes it a synonym for the off-hand bind and NOT a general toggle,
// despite the name. Bind one or the other, not both.
alias wr_toggle      "netevent wr_toggle_off"

// -- ModelSwapper model cycle. Ours, not a compat guess, so it earns a real
// key rather than a gesture. No default bind: a model swap mid-fight from a
// fat-fingered key would be worse than not having the feature.
alias wr_ms_cycle_main "netevent wr_ms_cycle_main"
alias wr_ms_cycle_off  "netevent wr_ms_cycle_off"
addmenukey "Wheel: cycle main-hand model" wr_ms_cycle_main
addmenukey "Wheel: cycle off-hand model"  wr_ms_cycle_off

// -- gun readout placement. A calibration tool for whoever is measuring a
// weapon set, not a normal-play control, so no default binds -- none of these
// can fire by accident during a fight because none is on a key until you put
// it there.
//
// Bindable FROM THE MENU, not console-only: this is used in VR, where there is
// no reachable console, so an alias with no menu row is not "advanced", it is
// unreachable. The four verbs below are the whole workflow. The sixteen nudge
// aliases stay config-only -- eight axes times two directions would bury the
// key list, and anyone binding all sixteen is editing a config file anyway.

// Reset All (generated from CVARINFO by tools/gen_reset.py; wr_cfgver is not a setting)
alias wr_reset "resetcvar wr_wheel_mode wr_either_hand wr_hold_tics wr_palette wr_weight_feel wr_follow wr_slowmo_cancel wr_own_freeze wr_watch wr_twohand_compare wr_pull_speed wr_throw_speed wr_watch_dwell wr_watch_scale wr_fontset wr_doubletap wr_centre_held wr_level_stats wr_panel_w wr_panel_h wr_radius wr_rise wr_constellation wr_star_stagger wr_stars wr_stars_alpha wr_tilt wr_touch wr_autoopen wr_roll wr_pop wr_locktics wr_warn_tics wr_toggle_prefer_hand wr_recenter_window wr_flash wr_lowammo_frac wr_lowammo_pulse wr_scale wr_bullettime wr_stickdead wr_pulse wr_forward wr_sound wr_volume wr_haptics wr_growtics wr_ammo wr_debug wr_vbeam wr_vbeam_inner wr_vbeam_outer wr_vbeam_density wr_vbeam_dust wr_sweep wr_sweep_reach wr_sweep_bright wr_fog wr_fog_rise wr_fog_scatter wr_sdf wr_plate_radius wr_plate_border wr_floor wr_floor_kind wr_floor_count wr_floor_space wr_floor_spin wr_floor_thick wr_floor_bright wr_floor_seam wr_canvas wr_canvas_bleed wr_canvas_shadow wr_canvas_scan wr_glow wr_shimmer wr_sparks wr_sparks_speed wr_spark_color wr_flip wr_wave wr_wave_len wr_wave_speed wr_wave_sharp wr_dim wr_light wr_light_size wr_light_grace wr_marker wr_readout wr_subcards_max wr_subcards_grace wr_models wr_model_scale wr_model_lift wr_model_spin wr_shadow wr_shadow_offset wr_slotnum wr_facing wr_idle wr_idle_speed wr_parallax wr_scan_crawl wr_sheet wr_sheet_scale wr_sheet_stats wr_sheet_bonsai wr_tier_color wr_ld_compat wr_ld_effects wr_drla_compat wr_drla_mods wr_dbl_compat wr_pand_compat wr_gc_compat wr_meta_compat wr_bd_compat wr_di_compat wr_ca_compat wr_fd_compat wr_suppress_native_wheel wr_ms_compat wr_lith_compat wr_lith_acs wr_inspect wr_inspect_dwell wr_inspect_delta wr_stats_track wr_ring_art"
