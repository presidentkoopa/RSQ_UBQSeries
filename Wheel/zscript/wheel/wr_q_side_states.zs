	static State Panel(bool mirrored, int hi, int side = 0)
	{
		let d = GetDefaultByType("wr_SideStates");
		switch ((hi * 2 + (mirrored ? 1 : 0)) * 2 + side)
		{
		case 0: return d.FindState("P000");
		case 2: return d.FindState("P010");
		case 1: return d.FindState("P001");
		case 3: return d.FindState("P011");
		case 4: return d.FindState("P100");
		case 6: return d.FindState("P110");
