	private static State Walk(State s, int n)
	{
		for (int i = 0; i < n && s; i++) s = s.NextState;
		return s;
	}

	// kind K_TOP/K_MID/K_BOTTOM/K_RULE: index = style 0..STYLES-1, width W_*; a ROLLED wide piece comes in
	// two halves (half 0 left, 1 right: draw both, each placed with PlaceWide). K_MISC: index = M_*.
	static State Piece(int kind, bool mirrored, bool rolled, int index, int width = W_FULL, int half = 0)
	{
		let d = GetDefaultByType("wr_DetailStates");
		int fam = (rolled ? 2 : 0) + (mirrored ? 1 : 0);
		if (kind == K_MISC)
		{
			switch (fam)
			{
			case 0: return Walk(d.FindState("XN"), index);
			case 1: return Walk(d.FindState("XM"), index);
			case 2: return Walk(d.FindState("XR"), index);
			case 3: return Walk(d.FindState("XL"), index);
			}
			return null;
		}
		if (index < 0 || index >= STYLES || width < 0 || width > 2) return null;
		int k = ((kind * 3 + width) * 4 + fam) * 2 + (rolled && half == 1 ? 1 : 0);
		switch (k)
		{
		case 0: return Walk(d.FindState("T0N"), index);
		case 2: return Walk(d.FindState("T0M"), index);
		case 4: return Walk(d.FindState("T0R"), index);
		case 5: return Walk(d.FindState("T0RH"), index);
		case 6: return Walk(d.FindState("T0L"), index);
		case 7: return Walk(d.FindState("T0LH"), index);
		case 8: return Walk(d.FindState("T1N"), index);
		case 10: return Walk(d.FindState("T1M"), index);
		case 12: return Walk(d.FindState("T1R"), index);
		case 13: return Walk(d.FindState("T1RH"), index);
		case 14: return Walk(d.FindState("T1L"), index);
		case 15: return Walk(d.FindState("T1LH"), index);
		case 16: return Walk(d.FindState("T2N"), index);
		case 18: return Walk(d.FindState("T2M"), index);
		case 20: return Walk(d.FindState("T2R"), index);
		case 21: return Walk(d.FindState("T2RH"), index);
		case 22: return Walk(d.FindState("T2L"), index);
		case 23: return Walk(d.FindState("T2LH"), index);
		case 24: return Walk(d.FindState("M0N"), index);
		case 26: return Walk(d.FindState("M0M"), index);
		case 28: return Walk(d.FindState("M0R"), index);
		case 29: return Walk(d.FindState("M0RH"), index);
		case 30: return Walk(d.FindState("M0L"), index);
		case 31: return Walk(d.FindState("M0LH"), index);
		case 32: return Walk(d.FindState("M1N"), index);
		case 34: return Walk(d.FindState("M1M"), index);
		case 36: return Walk(d.FindState("M1R"), index);
		case 37: return Walk(d.FindState("M1RH"), index);
		case 38: return Walk(d.FindState("M1L"), index);
		case 39: return Walk(d.FindState("M1LH"), index);
		case 40: return Walk(d.FindState("M2N"), index);
		case 42: return Walk(d.FindState("M2M"), index);
		case 44: return Walk(d.FindState("M2R"), index);
		case 45: return Walk(d.FindState("M2RH"), index);
		case 46: return Walk(d.FindState("M2L"), index);
		case 47: return Walk(d.FindState("M2LH"), index);
		case 48: return Walk(d.FindState("B0N"), index);
		case 50: return Walk(d.FindState("B0M"), index);
		case 52: return Walk(d.FindState("B0R"), index);
		case 53: return Walk(d.FindState("B0RH"), index);
		case 54: return Walk(d.FindState("B0L"), index);
		case 55: return Walk(d.FindState("B0LH"), index);
		case 56: return Walk(d.FindState("B1N"), index);
		case 58: return Walk(d.FindState("B1M"), index);
		case 60: return Walk(d.FindState("B1R"), index);
		case 61: return Walk(d.FindState("B1RH"), index);
		case 62: return Walk(d.FindState("B1L"), index);
		case 63: return Walk(d.FindState("B1LH"), index);
		case 64: return Walk(d.FindState("B2N"), index);
		case 66: return Walk(d.FindState("B2M"), index);
		case 68: return Walk(d.FindState("B2R"), index);
		case 69: return Walk(d.FindState("B2RH"), index);
		case 70: return Walk(d.FindState("B2L"), index);
		case 71: return Walk(d.FindState("B2LH"), index);
		case 72: return Walk(d.FindState("R0N"), index);
		case 74: return Walk(d.FindState("R0M"), index);
		case 76: return Walk(d.FindState("R0R"), index);
		case 77: return Walk(d.FindState("R0RH"), index);
		case 78: return Walk(d.FindState("R0L"), index);
		case 79: return Walk(d.FindState("R0LH"), index);
		case 80: return Walk(d.FindState("R1N"), index);
		case 82: return Walk(d.FindState("R1M"), index);
		case 84: return Walk(d.FindState("R1R"), index);
		case 85: return Walk(d.FindState("R1RH"), index);
		case 86: return Walk(d.FindState("R1L"), index);
		case 87: return Walk(d.FindState("R1LH"), index);
		case 88: return Walk(d.FindState("R2N"), index);
		case 90: return Walk(d.FindState("R2M"), index);
		case 92: return Walk(d.FindState("R2R"), index);
		case 93: return Walk(d.FindState("R2RH"), index);
		case 94: return Walk(d.FindState("R2L"), index);
		case 95: return Walk(d.FindState("R2LH"), index);
		}
		return null;
	}

	// font F_*, size S_TEXT/S_SMALL, code 33..95 (lower case folds up). Null for a space or a missing glyph.
	static State Glyph(int font, int size, bool mirrored, bool rolled, int code)
	{
		if (code >= 97 && code <= 122) code -= 32;
		if (font < 0 || font >= FONTS || code < 33 || code > 95 || !wr_DetailStates.GLYPH_HAS[font * 64 + code - 32]) return null;
		let d = GetDefaultByType("wr_DetailStates");
		int k = ((font * 2 + size) * 4) + (rolled ? 2 : 0) + (mirrored ? 1 : 0);
		switch (k)
		{
		case 0: return Walk(d.FindState("G0TN"), code - 33);
		case 1: return Walk(d.FindState("G0TM"), code - 33);
		case 2: return Walk(d.FindState("G0TR"), code - 33);
		case 3: return Walk(d.FindState("G0TL"), code - 33);
		case 4: return Walk(d.FindState("G0SN"), code - 33);
		case 5: return Walk(d.FindState("G0SM"), code - 33);
		case 6: return Walk(d.FindState("G0SR"), code - 33);
		case 7: return Walk(d.FindState("G0SL"), code - 33);
		case 8: return Walk(d.FindState("G1TN"), code - 33);
		case 9: return Walk(d.FindState("G1TM"), code - 33);
		case 10: return Walk(d.FindState("G1TR"), code - 33);
		case 11: return Walk(d.FindState("G1TL"), code - 33);
		case 12: return Walk(d.FindState("G1SN"), code - 33);
		case 13: return Walk(d.FindState("G1SM"), code - 33);
		case 14: return Walk(d.FindState("G1SR"), code - 33);
		case 15: return Walk(d.FindState("G1SL"), code - 33);
		}
		return null;
	}

	// layout px a glyph moves the pen (space included), at that size
	static double Advance(int font, int size, int code)
	{
		if (code >= 97 && code <= 122) code -= 32;
		if (font < 0 || font >= FONTS || code < 32 || code > 95) return 0;
		return wr_DetailStates.GLYPH_ADV[font * 64 + code - 32] * (size == S_SMALL ? SMALL_SCALE : 1.0);
	}
	static double TextWidth(int font, int size, String s)
	{
		double w = 0;
		for (int i = 0; i < s.Length(); i++) w += Advance(font, size, s.ByteAt(i));
		return w;
	}

	// layout px on a card cardW wide, in a family -> model cm (the point the generator baked there)
	static Vector3 CardPoint(double x, double y, bool mirrored, bool rolled, double cardW)
	{
		if (rolled)
		{
			double r = mirrored ? -ROLL_DEG : ROLL_DEG;
			double c = cos(r), s = sin(r);
			double x2 = x * c - y * s; y = x * s + y * c; x = x2;
		}
		if (mirrored) x = cardW - x;
		double t = -x * HUPP * 0.25, b = y * VUPP * 0.25;
		double X = AX * cos(t) - AY * sin(t), Y = AX * sin(t) + AY * cos(t);
		return (X, Y * cos(b) - AZ * sin(b), Y * sin(b) + AZ * cos(b));
	}

	// The layer (x, y) that puts a glyph-like piece pw x ph layout px with its top-left on card layout px
	// (x, y) of a card cardW wide (solved at the piece centre). For the mirrored family the layer x
	// returned is already the mirrored hand's. Add a side nudge to x afterwards if you use one.
	static Vector2 Place(double x, double y, bool mirrored, bool rolled, double cardW, double pw, double ph)
	{
		return Solve(CardPoint(pw / 2, ph / 2, mirrored, rolled, wr_DetailStates.WIDTH_PX[W_FULL]),
			CardPoint(x + pw / 2, y + ph / 2, mirrored, rolled, cardW));
	}
	// The same for a wide piece (K_TOP/K_MID/K_BOTTOM/K_RULE of width W_*) with its top edge at card y.
	static Vector2 PlaceWide(int kind, double y, bool mirrored, bool rolled, int width, int half = 0)
	{
		int W = wr_DetailStates.WIDTH_PX[width];
		double a = kind == K_RULE ? 4 : 0, b = kind == K_RULE ? W - 4 : W;
		if (rolled) { if (half == 1) a = W / 2; else b = W / 2; }
		double cx = (a + b) / 2, cy = wr_DetailStates.SLICE_PX[min(kind, 3)] / 2.;
		return Solve(CardPoint(cx, cy, mirrored, rolled, W), CardPoint(cx, y + cy, mirrored, rolled, W));
	}
	// the turn (yaw about Z after pitch about X) that carries baked point p0 onto card point tg
	static Vector2 Solve(Vector3 p0, Vector3 tg)
	{
		double rho = sqrt(p0.y * p0.y + p0.z * p0.z);
		double b = (180 - asin(clamp(tg.z / rho, -1, 1))) - atan2(p0.z, p0.y);
		while (b > 180) b -= 360;
		while (b < -180) b += 360;
		double y1 = p0.y * cos(b) - p0.z * sin(b);
		double t = atan2(p0.x * tg.y - y1 * tg.x, p0.x * tg.x + y1 * tg.y);
		return (t * 4, 32 + b * 4);
	}
}
