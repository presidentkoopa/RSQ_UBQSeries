// wr_q_gunlook.zs -- RSQ Wheel: the Colour by Gun look (owner's pick 2026-11-02, mock-ups A + B + C together).
//
//   A  each card washed in its gun's colour -- the colour RSQ Gun Cards gives that gun, so the two mods agree --
//      with a bright rim, slot stripe and boxed slot number in it; ammo counts in the ammo type's colour.
//   B  a halo in its colour behind the hovered card (it breathes only with wr_breathe, off by default), the beam's
//      tip wears the series' lock-on mark, a spark sweeps round each card's edge.
//      (2026-11-02, owner's headset: "some kind of hexagon wire around it and the whole thing changes size when i
//      hover". The wire was a light drawn round the ring in straight strips, card to card: removed. The halo behind
//      the ring no longer brightens or recolours on hover: nothing that spans the whole ring reacts to the hover.)
//   C  the plates lit warm from the top in the gun's colour and cool toward the bottom, the data sheet's header
//      a filled band in the hovered gun's colour, a soft halo behind the ring.
//
// Every colour is chosen when the ring opens (or the hover changes); per tic only brightness and position move,
// on quads the ring places every tic anyway. wr_look2 0 is the ring as it was. The parts are drawn in
// zscript.zs (marked "RSQ GL:"); this file holds the colours and the series' settings they read.
//
// COLOUR BLIND MODE (RSQ_Accessibility's rsqa_colorblind, through wr_CB, read when the ring opens): the cards go
// neutral (the series' IDLE grey) and only the hovered card is coloured, in the series' COULD colour. Motion and
// brightness stay. PHOTOSENSITIVE MODE (wr_A11y.Photo): the breathing and the sweep at 40% strength, the sweep at
// half speed.
class wr_GunLook play
{
	// >>> GUNCARDS COLOURS
	// generated by tools/gen_glow_art.py: Gun Cards' SLOT_STYLE [2, 2, 4, 3, 1, 5, 16, 17, 12, 19], each panel's colour measured from
	// GunCards/tools/card_art/ammo_bg<N>.png; PICK_COL as Gun Cards' card.zs has it
	static const int SLOT_COL[] = { 0x707070, 0x707070, 0xFFE070, 0xFE6C6C, 0xFFFFFF, 0x78FF7F, 0x85ECFB, 0x6E75FF, 0xFFFFFF, 0xE48BFF };
	static const int PICK_COL[] = { 0, 0xE8E8E8, 0x8A8A8A, 0xE04040, 0xE0B040, 0x50D050, 0x5080F0, 0x50D0D0, 0xB060E0, 0xF08030, 0xF070B0 };
	// <<< GUNCARDS COLOURS

	const AMMO_NEUTRAL = 0xC8CED8;   // the count's colour when the ammo has no colour (colour-blind, no ammo type)

	static bool On()
	{
		let c = CVar.FindCVar("wr_look2");
		return !c || c.GetBool();
	}
	static int CBMode() { return wr_CB.Mode(); }
	static color CBIdle()  { return color(255, (wr_CB.Rgb(wr_CB.CB_IDLE,  CBMode()) >> 16) & 255, (wr_CB.Rgb(wr_CB.CB_IDLE,  CBMode()) >> 8) & 255, wr_CB.Rgb(wr_CB.CB_IDLE,  CBMode()) & 255); }
	static color CBCould() { return color(255, (wr_CB.Rgb(wr_CB.CB_COULD, CBMode()) >> 16) & 255, (wr_CB.Rgb(wr_CB.CB_COULD, CBMode()) >> 8) & 255, wr_CB.Rgb(wr_CB.CB_COULD, CBMode()) & 255); }

	static color Rgb(int v) { return color(255, (v >> 16) & 255, (v >> 8) & 255, v & 255); }

	// The colour RSQ Gun Cards gives this gun: its Card Colour setting (rsqgc_color, read by name: 0 without Gun
	// Cards) -- 0 each gun its own by its slot, 1..10 one colour for every card, 11 by ammo type.
	static color GunColour(Weapon w, int slot)
	{
		let c = CVar.FindCVar("rsqgc_color");
		int pick = c ? c.GetInt() : 0;
		if (pick == 11) { int a = AmmoColour(w); if (a >= 0) return Rgb(a); }
		if (pick > 0 && pick < wr_GunLook.PICK_COL.Size()) return Rgb(wr_GunLook.PICK_COL[pick]);
		return Rgb(wr_GunLook.SLOT_COL[clamp(slot, 0, 9)]);
	}

	// What the gun eats, as Gun Cards colours it (GunCards card.zs AmmoColour, the same rule): bullets gold, shells
	// red, rockets and grenades orange, cells and plasma cyan, fuel green, souls purple, any other pile a colour of
	// its own from Gun Cards' list. -1: a gun with no ammo.
	static int AmmoColour(Weapon w)
	{
		if (!w || !w.Ammo1) return -1;
		let a = w.Ammo1;
		string n = a.GetClassName();
		class<Ammo> par = a.GetParentAmmo();
		if (par) n = n .. " " .. par.GetClassName();
		n = n.MakeLower();
		if (n.IndexOf("shell") >= 0) return 0xE04040;
		if (n.IndexOf("rocket") >= 0 || n.IndexOf("grenade") >= 0 || n.IndexOf("glammo") >= 0 || n.IndexOf("missile") >= 0 || n.IndexOf("nuke") >= 0 || n.IndexOf("mortar") >= 0) return 0xF08030;
		if (n.IndexOf("cell") >= 0 || n.IndexOf("plasma") >= 0 || n.IndexOf("rail") >= 0 || n.IndexOf("laser") >= 0) return 0x50D0D0;
		if (n.IndexOf("gas") >= 0 || n.IndexOf("fuel") >= 0 || n.IndexOf("flame") >= 0) return 0x50D050;
		if (n.IndexOf("soul") >= 0 || n.IndexOf("hell") >= 0) return 0xB060E0;
		if (n.IndexOf("clip") >= 0 || n.IndexOf("pistol") >= 0 || n.IndexOf("smg") >= 0 || n.IndexOf("mp40") >= 0 || n.IndexOf("mauser") >= 0
			|| n.IndexOf("sniper") >= 0 || n.IndexOf("bullet") >= 0 || n.IndexOf("rifle") >= 0 || n.IndexOf("machinegun") >= 0 || n.IndexOf("9mm") >= 0) return 0xE0B040;
		int h = 0;
		for (int i = 0; i < int(n.Length()); i++) h = (h * 31 + n.ByteAt(i)) & 0xFFFF;
		return wr_GunLook.PICK_COL[1 + h % 10];
	}

	static color Scale(color c, double k)
	{
		return color(255, int(clamp(c.r * k, 0, 255)), int(clamp(c.g * k, 0, 255)), int(clamp(c.b * k, 0, 255)));
	}
	static color Rest(color c)   { return Scale(c, 0.40); }   // a resting card's wash (mock-up A)
	static color Hover(color c)  { return Scale(c, 0.72); }   // the hovered card's plate
	static color Bright(color c) { return color(255, min(255, int(c.r * 1.15 + 20)), min(255, int(c.g * 1.15 + 20)), min(255, int(c.b * 1.15 + 20))); }
}

//==========================================================================
// The ring's side of the look: the parts it adds and how they move. Called from zscript.zs at the places
// marked "RSQ GL:". Everything here is skipped when the look is off for this ring (mGL false), except the
// colour-blind colours, which also apply to the classic look.
//==========================================================================
extend class wr_Rig
{
	bool mGL;                 // the look, for this ring (read when it opens)
	int  mGLCB;               // Colour Blind Mode for this ring, 0 off
	bool mGLBreathe, mGLSweep, mGLPhoto;
	double mGLShimmer;
	Array<int> mGLChips;      // per card: the slot number's box
	Array<int> mGLSparks;     // per card: the spark that sweeps round its edge
	Array<int> mGLHalos;      // per card: wr_shimmer's soft idle halo (only made when wr_shimmer > 0)
	int mGLHover;             // the hovered card's halo
	int mGLRingHalo;          // the halo behind the ring (steady: never reacts to the hover)
	int mGLMarkRing, mGLMarkCent;   // the lock-on mark at the beam's tip
	int mGLSheetShadow;       // the data sheet name's shadow on its band
	int mGLLitCard;           // the card the halo / mark were last set up for (-1 none)

	// ---- colours ---------------------------------------------------------------------------------------
	// The resting plate, the lit plate, the bright tone (rim, stripe, number) and the hovered hue (halo, mark,
	// sheet band) for a card whose colour is gc.
	color glRest(color gc)  { return (mGL && !mGLCB) ? wr_GunLook.Rest(gc) : color(COLOR_IDLE); }
	color glLit(color gc)
	{
		if (mGLCB) return wr_GunLook.CBCould();
		return mGL ? wr_GunLook.Hover(gc) : color(COLOR_HOVER);
	}
	color glTone(color gc)  { return mGLCB ? wr_GunLook.CBIdle() : wr_GunLook.Bright(gc); }
	color glHue(color gc)   { return mGLCB ? wr_GunLook.CBCould() : wr_GunLook.Bright(gc); }
	// a card's ammo count: the ammo type's colour (A); a dry gun stays dry red
	color glAmmo(Weapon w, int rounds)
	{
		if (rounds <= 0) return COLOR_AMMO_DRY;
		if (!mGL) return COLOR_AMMO;
		if (mGLCB) return wr_GunLook.AMMO_NEUTRAL;
		int a = wr_GunLook.AmmoColour(w);
		return a >= 0 ? wr_GunLook.Rgb(a) : color(wr_GunLook.AMMO_NEUTRAL);
	}

	// The slot a gun sits in for this player (the weapon slots, as Gun Cards reads them); the class default
	// SlotNumber where the slots do not know it.
	int glSlotOf(Weapon w)
	{
		if (!w) return 0;
		bool found; int sl, idx;
		[found, sl, idx] = players[consoleplayer].weapons.LocateWeapon(w.GetClass());
		return found ? sl : slotOf(w);
	}

	// ---- building ---------------------------------------------------------------------------------------
	void glBegin()
	{
		glClear();
		mGL = wr_GunLook.On();
		mGLCB = wr_GunLook.CBMode();
		mGLBreathe = cvBool("wr_breathe", false);
		mGLSweep = cvBool("wr_edge_sweep", true);
		mGLPhoto = wr_A11y.Photo();
		mGLShimmer = clamp(cv("wr_shimmer", 0.0), 0.0, 1.0);
		mGLLitCard = -1;
	}

	private int glQuad(string skin, color col, bool glow)
	{
		int id = wr_BB.AddBillboardPersistent((0, 0, 0), 1, 1, 0, 0, wr_BB.BBF_FIXED, wr_BB.BB_SKIN, 0, col,
			wr_BB.BBFL_NOHIT | (glow ? wr_BB.BBFL_SHADED : 0), 0, skin);
		if (glow) wr_BB.SetBillboardAlpha(id, 0);
		return id;
	}

	// Card i's own parts, made with the card (spawnPanels); grp is its group, nid its slot number.
	void glCardParts(int i, int grp, int nid, int plate)
	{
		int chip = 0, spark = 0, halo = 0;
		if (mGL)
		{
			color gc = i < mCardColor.Size() ? color(mCardColor[i]) : color(COLOR_IDLE);
			if (nid)
			{
				chip = glQuad("WRECHIP", glTone(gc), false);
				wr_BB.SetBillboardGroup(chip, grp);
				wr_BB.SetBillboardLayerFrom(chip, plate, 5);   // in front of the plate, behind the number
				wr_BB.SetBillboardLayerFrom(nid, plate, 7);
			}
			if (mGLSweep)
			{
				spark = glQuad("WRESPARK", 0xFFF4DC, true);
				wr_BB.SetBillboardGroup(spark, grp);
				wr_BB.SetBillboardLayerFrom(spark, plate, 3);
			}
			if (mGLShimmer > 0)
			{
				halo = glQuad("WREHALO", mGLCB ? wr_GunLook.CBIdle() : gc, true);
				wr_BB.SetBillboardGroup(halo, grp);
				wr_BB.SetBillboardLayerFrom(halo, plate, -8);
			}
		}
		mGLChips.Push(chip); mGLSparks.Push(spark); mGLHalos.Push(halo);
	}

	// The ring's own parts, made once the cards are (spawnPanels' end).
	void glRingParts()
	{
		if (!mGL) return;
		mGLHover = glQuad("WREHALO", COLOR_HOVER, true);
		mGLRingHalo = glQuad("WREDISC", COLOR_BEAM_IDLE, true);
		wr_BB.SetBillboardLayer(mGLRingHalo, 0);
		mGLMarkRing = glQuad("WRLKRB", COLOR_HOVER, true);
		mGLMarkCent = glQuad("WRLKCB", 0xFFFFFF, true);
	}

	void glClear()
	{
		for (int i = 0; i < mGLChips.Size(); i++)  if (mGLChips[i])  wr_BB.RemoveBillboard(mGLChips[i]);
		for (int i = 0; i < mGLSparks.Size(); i++) if (mGLSparks[i]) wr_BB.RemoveBillboard(mGLSparks[i]);
		for (int i = 0; i < mGLHalos.Size(); i++)  if (mGLHalos[i])  wr_BB.RemoveBillboard(mGLHalos[i]);
		mGLChips.Clear(); mGLSparks.Clear(); mGLHalos.Clear();
		if (mGLHover)    wr_BB.RemoveBillboard(mGLHover);
		if (mGLRingHalo) wr_BB.RemoveBillboard(mGLRingHalo);
		if (mGLMarkRing) wr_BB.RemoveBillboard(mGLMarkRing);
		if (mGLMarkCent) wr_BB.RemoveBillboard(mGLMarkCent);
		mGLHover = mGLRingHalo = mGLMarkRing = mGLMarkCent = 0;
		mGLLitCard = -1;
	}

	// The ring is folding away: the parts outside the cards' groups go dark at once.
	void glFold()
	{
		fade(mGLHover, 0); fade(mGLRingHalo, 0); fade(mGLMarkRing, 0); fade(mGLMarkCent, 0);
	}

	// ---- per tic: brightness and position only ------------------------------------------------------------
	// How strong a breathing thing is this tic: 1 +- amp, on the hover pulse's clock (PULSE_SPEED, 14 degrees a
	// tic, 1.4 a second). Photosensitive Mode: 40% of the swing; Hover Halo Breathes off: no swing.
	double glBreath(double amp)
	{
		if (!mGLBreathe) return 1.0;
		if (mGLPhoto) amp *= wr_A11y.DIM_K;
		return 1.0 + amp * sin(mHoverTics * PULSE_SPEED);
	}

	// Card i's parts, after layout() has placed the card (pos, facing faceYaw, tilted, rolled) this tic.
	void glCard(int i, Vector3 pos, Vector3 viewRight, double faceYaw, double tilt, double roll, Vector3 lift,
	            double panelW, double panelH, double pulse, bool lit, double cardAlpha)
	{
		if (!mGL) return;
		if (i < mGLChips.Size() && mGLChips[i])
		{
			int chip = mGLChips[i];
			wr_BB.MoveBillboard(chip, pos + lift * 0.8 - viewRight * (panelW * 0.40 * pulse) + (0, 0, panelH * 0.34 * pulse));
			wr_BB.ResizeBillboard(chip, panelW * 0.17 * pulse, panelH * 0.23 * pulse);
			wr_BB.OrientBillboard(chip, faceYaw, tilt, wr_BB.BBF_FIXED);
			wr_BB.RollBillboard(chip, roll);
			fade(chip, cardAlpha);
		}
		// the card's plane: right and up as its billboard has them (wr_q_shim.zs, BillboardBasis)
		double cy = cos(faceYaw), sy = sin(faceYaw), ct = cos(tilt), st = sin(tilt);
		Vector3 cR = (-sy, cy, 0), cU = (-cy * st, -sy * st, ct);
		if (i < mGLSparks.Size() && mGLSparks[i])
		{
			// once round the edge every 36 tics (10 degrees a tic), each card on its own phase; Photosensitive
			// Mode half the speed and 40% as bright
			int spark = mGLSparks[i];
			double speed = mGLPhoto ? 5.0 : 10.0;
			double th = mOpenTics * speed + i * 51.0;
			double c = cos(th), s = sin(th);
			double hw = panelW * pulse * 0.5, hh = panelH * pulse * 0.5;
			double k = 1.0 / max(abs(c) / hw, abs(s) / hh);
			wr_BB.MoveBillboard(spark, pos + lift * 1.2 + cR * (c * k) + cU * (s * k));
			double sz = panelH * (lit ? 0.62 : 0.46);
			wr_BB.ResizeBillboard(spark, sz, sz);
			wr_BB.OrientBillboard(spark, faceYaw, tilt, wr_BB.BBF_FIXED);
			double a = (lit ? 1.0 : 0.7 * cardAlpha) * (mGLPhoto ? wr_A11y.DIM_K : 1.0);
			fade(spark, a);
		}
		if (i < mGLHalos.Size() && mGLHalos[i])
		{
			int halo = mGLHalos[i];
			Vector3 back = (-cos(faceYaw), -sin(faceYaw), 0);
			wr_BB.MoveBillboard(halo, pos + back * 1.6);
			wr_BB.ResizeBillboard(halo, panelW * 1.6 * pulse, panelH * 1.75 * pulse);
			wr_BB.OrientBillboard(halo, faceYaw, tilt, wr_BB.BBF_FIXED);
			double f = 0.5 + 0.5 * sin(level.maptime * SHIMMER_SPEED + i * SHIMMER_PHASE);
			fade(halo, lit ? 0 : mGLShimmer * (0.25 + 0.35 * f) * (mGLPhoto ? wr_A11y.DIM_K : 1.0));
		}
	}

	// The ring's parts, after every card is placed this tic: centre is the ring's middle, the ring faces back
	// along viewYaw, its cards sit at bearingForIndex(i) + roll round radius ringR (grown by grow).
	void glRing(Vector3 centre, Vector3 viewRight, double viewYaw, double ringR, int n, double roll,
	            double panelW, double panelH, double grow, Vector3 eye)
	{
		if (!mGL || n <= 0) return;
		Vector3 back = (cos(viewYaw), sin(viewYaw), 0);   // away from the viewer
		int hc = cardIndexOf(mHovered);
		double r = ringR * grow;

		// the hovered card's halo in its colour; steady unless Hover Halo Breathes (wr_breathe, off by default)
		if (mGLHover)
		{
			if (hc >= 0)
			{
				Vector3 p = cardPos(hc);
				Vector3 toMe = eye - p;
				double fy = toMe.Length() > 0.01 ? atan2(toMe.y, toMe.x) : viewYaw + 180;
				double b = glBreath(0.6);
				double s = 1.0 + (b - 1.0) * 0.07;
				wr_BB.MoveBillboard(mGLHover, p - (cos(fy), sin(fy), 0) * 1.8);
				wr_BB.ResizeBillboard(mGLHover, panelW * 1.95 * s, panelH * 2.15 * s);
				wr_BB.OrientBillboard(mGLHover, fy, cv("wr_tilt", 12.0), wr_BB.BBF_FIXED);
				fade(mGLHover, clamp(0.62 * b, 0.0, 1.0));
			}
			else fade(mGLHover, 0);
		}

		// the halo behind the ring: steady, the same size, colour and strength whatever is hovered (the ring's own
		// size never changes on a hover)
		if (mGLRingHalo)
		{
			double d = (r + panelW * 1.1) * 2.0;
			wr_BB.MoveBillboard(mGLRingHalo, centre + back * 4.0);
			wr_BB.ResizeBillboard(mGLRingHalo, d, d);
			wr_BB.OrientBillboard(mGLRingHalo, viewYaw + 180, 0, wr_BB.BBF_FIXED);
			fade(mGLRingHalo, 0.20 * grow);
		}
	}

	// The lock-on mark at the beam's tip, while the beam is on a card: the series' mark, white centre, ring in the
	// gun's colour. tipAt is where the beam meets the card.
	void glMark(bool onCard, Vector3 tipAt, Vector3 dir)
	{
		if (!mGL || !mGLMarkRing) return;
		int hc = cardIndexOf(mHovered);
		if (!onCard || hc < 0) { fade(mGLMarkRing, 0); fade(mGLMarkCent, 0); return; }
		double b = glBreath(0.10);
		double s = panelHNow() * 0.42 * b;
		Vector3 at = tipAt - dir * 0.8;
		for (int k = 0; k < 2; k++)
		{
			int id = k ? mGLMarkCent : mGLMarkRing;
			wr_BB.MoveBillboard(id, at);
			wr_BB.ResizeBillboard(id, s, s);
			wr_BB.OrientBillboard(id, 0, 0, wr_BB.BBF_CAMERA);
			fade(id, 1.0);
		}
	}

	// The hover moved onto card hc (-1: off the ring): the card's halo and the mark take its colour, and sit behind /
	// in front of that card. Once per change, never per tic. The halo behind the ring stays as it is.
	void glHoverChanged(int hc)
	{
		if (!mGL || hc == mGLLitCard) return;
		mGLLitCard = hc;
		if (hc < 0 || hc >= mCardColor.Size()) return;
		color hue = glHue(mCardColor[hc]);
		if (mGLHover)    { wr_BB.UpdateBillboard(mGLHover, 0, hue); if (hc < mPlates.Size()) wr_BB.SetBillboardLayerFrom(mGLHover, mPlates[hc], -10); }
		if (mGLMarkRing) { wr_BB.UpdateBillboard(mGLMarkRing, 0, hue); if (hc < mPlates.Size()) { wr_BB.SetBillboardLayerFrom(mGLMarkRing, mPlates[hc], 14); wr_BB.SetBillboardLayerFrom(mGLMarkCent, mPlates[hc], 15); } }
	}
}
