	static clearscope int Row(Weapon w)
	{
		if (!w) return -1;
		String n = w.GetClassName();
		for (int i = 0; i < RSQLS_Sets.ALIAS.Size(); i += 5) if (RSQLS_Sets.ALIAS[i] ~== n) return i;
