// THE BEAM LAYER'S STATES, on an item the player carries. The layer is MADE with this item as
// its caller, so the first state's action passes the VM's invoker check (an action of class X
// refuses an invoker that is not an X) and sets the layer additive -- A_Overlay* only work from
// a psprite action. beam.zs then hands the layer to the GUN (PSprite.Caller), which the
// renderer reads for the controller and the turn; the -1 state never runs an action again.
// Its sprite and frame are written per tic to pick the rod. The Rods states exist so every
// rod sprite name exists (VOXELDEF only takes a sprite some state names).
class RSQLS_BeamLayer : Inventory
{
	Default { Inventory.MaxAmount 1; +INVENTORY.UNDROPPABLE +INVENTORY.UNTOSSABLE +INVENTORY.QUIET }
	// an ACTION function (self: the player, invoker: this item), called with no arguments so
	// the state calls it directly -- an anonymous block here would take the item as self.
	action void A_RSQLSAdditive() { A_OverlayFlags(0, PSPF_RENDERSTYLE | PSPF_FORCESTYLE, true); A_OverlayRenderStyle(0, STYLE_Add); }
	States
	{
	Spawn: TNT1 A -1; Stop;
	Beam:
		TNT1 A 0 A_RSQLSAdditive;
		LZ00 A -1 Bright;
		Stop;
	Rods:
		LZ00 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ01 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ02 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ03 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ04 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ05 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ06 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ07 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
		LZ08 ABCDEFGHIJKLMNOPQRSTUVWXYZ -1;
