// Brutal Doom VR 2.0's shot line: muzzle F L U cm in the controller frame, the bore as yaw left / pitch up.
class RSQLS_BDBore play
{
	const BORE_YAW = 3.8541;
	const BORE_PITCH = 3.3629;

	// (found, F, L, U): the checks in Brutal Doom's own order
	static bool, double, double, double Muzzle(Weapon w)
	{
		if (!w) return false, 0, 0, 0;
		Name n = w.GetClassName();
		if (KindOf(w, 'FlameCannon')) return false, 0, 0, 0;   // no bore: aimed its own way
		if (n == 'Sniper') return true, 68.38, 6.31, 9.77;
		if (KindOf(w, 'BrutalPistol')) return true, 23.3, 2.2, 6.3;
		if (KindOf(w, 'BrutalSMG')) return true, 39.6, 4.4, 0.8;
		if (n == 'BrutalRevolver') return true, 35.03, 3.24, 8.51;
		if (KindOf(w, 'Rifle')) return true, 71.18, 6.06, 11.42;
		if (KindOf(w, 'AssaultShotgun')) return true, 67.36, 11.02, -2.66;
		if (KindOf(w, 'Revolver')) return true, 26.67, 2.61, 7.04;
		if (KindOf(w, 'Shot_Gun')) return true, 69.20, 9.87, 1.83;
		if (KindOf(w, 'GrenadeLauncher')) return true, 50.66, 9.86, -3.40;
		if (KindOf(w, 'Rocket_Launcher')) return true, 55.59, 3.74, 17.94;
		if (KindOf(w, 'RailGun')) return true, 116.02, 10.31, 12.14;
		if (KindOf(w, 'Plasma_Gun')) return true, 76.10, 8.12, 9.61;
		if (KindOf(w, 'Minigun')) return true, 100.86, 11.49, 2.74;
		if (KindOf(w, 'MG42')) return true, 102.78, 8.98, 14.00;
		if (KindOf(w, 'Machinegun')) return true, 72.13, 6.28, 13.43;
		if (KindOf(w, 'NukeLauncher')) return true, 55.76, 6.04, 11.54;
		if (KindOf(w, 'BFG10k')) return true, 90.36, 9.53, 7.73;
		if (KindOf(w, 'BIG_FUCKING_GUN')) return true, 86.71, 5.85, 21.97;
		if (KindOf(w, 'IncendiaryLauncher')) return true, 61.12, 11.16, 1.79;
		if (KindOf(w, 'Devastator')) return true, 66.55, 4.36, 21.68;
		if (KindOf(w, 'SSG')) return true, 40.48, 8.12, -2.75;
		if (KindOf(w, 'Unmaker')) return true, 72.53, 3.94, 17.03;
		if (KindOf(w, 'HellishMissileLauncher')) return true, 77.12, 1.68, 22.32;
		if (KindOf(w, 'FlameCannon')) return true, 61.92, -5.02, -14.53;
		if (KindOf(w, 'MP40')) return true, 66.36, 6.54, 11.39;
		return false, 0, 0, 0;
	}

	// `w is X` by name: X may not exist without Brutal Doom loaded
	static bool KindOf(Weapon w, String c)
	{
		class<Actor> k = c;
		return k && (w is k);
	}

	// Brutal Doom's own: is its muzzle handler running (BD22 VR Reloaded 2.0 and later)?
	static bool Active()
	{
		return EventHandler.Find("RSQ_Muzzle") != null;
	}

	// A direction in the hand's own frame (yaw 0 pitch 0 forward, yaw 90 left, pitch 90 up), as Brutal Doom's
	// RSVR_VRHand.HandDir / OffDir build it: (angle, Doom pitch) from the engine, and its map vector with the hand
	// transform's 1/pixelstretch taken back out (for placing the muzzle).
	static Vector2 Angles(PlayerPawn mo, int h, double yaw, double pitch)
	{
		if (!mo.OverrideAttackPosDir) return (mo.angle + yaw, mo.pitch + pitch);
		Vector3 ap = (h == 0) ? mo.AttackDir(mo, mo.angle + yaw, mo.pitch + pitch) : mo.OffhandDir(mo, mo.angle + yaw, mo.pitch + pitch);
		return ap.xy;
	}
	static Vector3 Axis(PlayerPawn mo, int h, double yaw, double pitch, double ps)
	{
		Vector2 ap = Angles(mo, h, yaw, pitch);
		double cp = cos(ap.y);
		Vector3 v = (cp * cos(ap.x), cp * sin(ap.x), -sin(ap.y) * ps);
		double l = v.Length();
		return l > 0 ? v / l : (1, 0, 0);
	}

	// THE SHOT LINE Brutal Doom fires a bored gun down (muzzle.zs Where / WorldHitscanPreFired): from the muzzle (the
	// controller itself when a wall is between them), at the attack's angles plus the bore's. Returns the start and the
	// unit direction (Doom map space, the angles the engine's own LineAttack takes).
	static bool, Vector3, Vector3 Line(PlayerPawn mo, int h, Weapon w)
	{
		bool got; double f, l, u;
		[got, f, l, u] = Muzzle(w);
		if (!got || !mo || !mo.OverrideAttackPosDir) return false, (0, 0, 0), (0, 0, 0);
		double ps = mo.Level.pixelstretch;
		if (ps <= 0) ps = 1.2;
		let cv = CVar.FindCVar("vr_vunits_per_meter");
		double vu = cv ? cv.GetFloat() : 34;
		if (vu <= 0) vu = 34;
		Vector3 hp = (h == 0) ? mo.AttackPos : mo.OffhandPos;
		Vector3 w3 = (Axis(mo, h, 0, 0, ps) * f + Axis(mo, h, 90, 0, ps) * l + Axis(mo, h, 0, 90, ps) * u) * (vu / 100.0);
		w3.z /= ps;
		Vector3 at = hp + w3;
		double len = w3.Length();
		if (len > 0)
		{
			FLineTraceData tr;
			mo.LineTrace(VectorAngle(w3.x, w3.y), len, -asin(clamp(w3.z / len, -1, 1)), TRF_ABSPOSITION | TRF_THRUACTORS, hp.z, hp.x, hp.y, tr);
			if (tr.HitType != TRACE_HitNone) at = hp;
		}
		Vector2 sa = Angles(mo, h, BORE_YAW, BORE_PITCH);
		double cp = cos(sa.y);
		return true, at, (cp * cos(sa.x), cp * sin(sa.x), -sin(sa.y));
	}
}
