// NOTE 2026-08-07: SCAVBLOODLIGHT and SCAVSTEELLIGHT are defined here and
// referenced by NOTHING in the mod. Left in place rather than deleted --
// an unreferenced pulselight costs nothing at runtime, and the SCAV
// prefix suggests they were authored for something intended rather than
// abandoned. If you know they are dead, they are two blocks to remove.

pulselight SCAVBLOODLIGHT
{
    color 1.0 0.25 0.25
    size 2
    secondarySize 12
    offset 0 2 0
    interval 1.0
    dontlightself 1
    dontlightactors 1
}

pulselight SCAVSTEELLIGHT
{
    color 0.25 0.25 1.0
    size 2
    secondarySize 12
    offset 0 2 0
    interval 1.0
    dontlightself 1
    dontlightactors 1
}
