TFLV_Upgrade_RS_BrandFire_Name = "Brand: Fire";
TFLV_Upgrade_RS_BrandFire_Desc = "your hits plant fire where they land";
TFLV_Upgrade_RS_BrandFire_TT = "Hits have a growing chance to leave a fire payload at the impact. What actually gets planted is drawn live from the FX registry, so it is never quite the same twice and it grows on its own as fire effects are added to the mod -- import a weapon set, tag its parts, and every Fire card gets deeper without a line of code. Mastery: it plants the headline version, the big one.";

TFLV_Upgrade_RS_AttuneFire_Name = "Attune: Fire";
TFLV_Upgrade_RS_AttuneFire_Desc = "your gun works a fire beat into its firing cycle";
TFLV_Upgrade_RS_AttuneFire_TT = "Locks an extra beat into the weapon's firing rotation built entirely from fire parts -- projectile, muzzle, smoke, sparks, trail and impact all drawn from that theme together, so it arrives as a coherent shot rather than a recolour. Levels tighten the rotation from every fifth shot down to every second. Mastery: a second, independently rolled fire beat joins the same cycle, so the theme shows up two different ways.";

TFLV_Upgrade_RS_SurgeFire_Name = "Surge: Fire";
TFLV_Upgrade_RS_SurgeFire_Desc = "kills burst into fire";
TFLV_Upgrade_RS_SurgeFire_TT = "A kill has a chance to throw the biggest fire effect the registry holds. Purely on death, so it never interferes with your shot, and it scales with whatever fire content the mod has loaded. Mastery: three at once, thrown apart.";

TFLV_Upgrade_RS_BrandIce_Name = "Brand: Ice";
TFLV_Upgrade_RS_BrandIce_Desc = "your hits plant ice where they land";
TFLV_Upgrade_RS_BrandIce_TT = "Hits have a growing chance to leave a ice payload at the impact. What actually gets planted is drawn live from the FX registry, so it is never quite the same twice and it grows on its own as ice effects are added to the mod -- import a weapon set, tag its parts, and every Ice card gets deeper without a line of code. Mastery: it plants the headline version, the big one.";

