// =====================================================================
// RS unified UI + designed affix slate strings.
// GunBonsai convention: <ClassName>_Name / _Desc looked up by
// BaseUpgrade.GetName()/GetDesc(); _TT is the tooltip body.
// =====================================================================
[en default]

RS_UI_SHEET_TITLE = "";

// Arcade score readout. Drawn in RSScore_White, immediately followed by
// the number in RSScore_Gold -- the trailing space is part of the string.
RS_SCORE_LABEL = "Score: ";

// --- The affix slate (docs/rs_09_affix_slate.txt) --------------------

TFLV_Upgrade_RS_Splitter_Name = "Splitter";
TFLV_Upgrade_RS_Splitter_Desc = "your shot divides -- more fragments, same total damage";
TFLV_Upgrade_RS_Splitter_TT = "Each level splits every shot into more, weaker fragments. Exact wash: coverage, not power. Mastery: the fragments form a fixed, even fan instead of random scatter.";

TFLV_Upgrade_RS_Slugger_Name = "Slugger";
TFLV_Upgrade_RS_Slugger_Desc = "the volley collapses into one heavy round";
TFLV_Upgrade_RS_Slugger_TT = "All pellets become a single slug: more damage per pull is traded for one precise round that grows with every level. Mastery: the slug punches through bodies.";

TFLV_Upgrade_RS_Overcharged_Name = "Overcharged";
TFLV_Upgrade_RS_Overcharged_Desc = "more damage, more spread -- the sloppiness is the price";
TFLV_Upgrade_RS_Overcharged_TT = "Damage and spread climb together, level by level. Mastery (Focus): the first shot after a deliberate pause pays no spread penalty.";

TFLV_Upgrade_RS_Giant_Name = "Giant";
TFLV_Upgrade_RS_Giant_Desc = "your rounds grow -- sprite and hitbox both";
TFLV_Upgrade_RS_Giant_TT = "Projectile scale climbs to comical sizes; the hitbox follows the art. Mastery (Wrecking Ball): rounds carry real kickback.";

TFLV_Upgrade_RS_Seeker_Name = "Seeker";
TFLV_Upgrade_RS_Seeker_Desc = "rounds hunt -- levels let them cycle victims";
TFLV_Upgrade_RS_Seeker_TT = "Homes true from level 1 -- and tracking authority scales with this gun's rolled Accuracy: a precise gun hunts hard. Each level lets the round retarget one more victim when its target dies. Costs 5% damage per level. Mastery: unlimited cycling, curves around corners.";

TFLV_Upgrade_RS_Ghost_Name = "Ghost Rounds";
TFLV_Upgrade_RS_Ghost_Desc = "rounds punch through bodies";
TFLV_Upgrade_RS_Ghost_TT = "Pierce 1/2/3/4/all victims, keeping 70-90% damage per punch-through -- and a fast gun punches deeper: retention scales with rolled Velocity. Mastery (the stitch): a piercing kill whips the round toward its next victim.";

TFLV_Upgrade_RS_Cacospit_Name = "Cacospit";
TFLV_Upgrade_RS_Cacospit_Desc = "your rounds become the Cacodemon's bile";
TFLV_Upgrade_RS_Cacospit_TT = "The Cacodemon's own ammunition in your gun. Rolled once when taken: the classic bile ball or the hell-wisp -- that's this gun's spit forever. +3% damage per level. Mastery: impacts leave burning bile.";

TFLV_Upgrade_RS_Bonecaller_Name = "Bonecaller";
TFLV_Upgrade_RS_Bonecaller_Desc = "your rounds become revenant bone tracers";
TFLV_Upgrade_RS_Bonecaller_TT = "The skeleton's own tracers, weapon-grade. Levels give each pellet a growing chance to hunt (25/50/75/100%). Mastery (twin-fire): every round doubles into a straight+seeking pair at half damage each.";

TFLV_Upgrade_RS_PainOrb_Name = "Pain Orb";
TFLV_Upgrade_RS_PainOrb_Desc = "the Pain Elemental's bouncing orb -- heavier, fewer chambered";
TFLV_Upgrade_RS_PainOrb_TT = "The Pain Elemental's own ice orb as your round -- it BOUNCES, from level 1, because that's what it is. +6% damage per level, -1 capacity per 2 levels. Mastery: bigger, six bounces, shatters into a shard spray.";

TFLV_Upgrade_RS_Echo_Name = "Echo";
TFLV_Upgrade_RS_Echo_Desc = "every Nth pull, your own shot -- doubled";
TFLV_Upgrade_RS_Echo_TT = "Adds an echo beat to the trigger rotation: every 7th (down to 3rd) pull fires YOUR OWN round twice, at double ammo cost -- your roll, amplified, paid for from your magazine. Mastery: every 2nd.";

// --- Stat cards (green) ----------------------------------------------

TFLV_Upgrade_RS_CardDamage_Name = "Damage Up";
TFLV_Upgrade_RS_CardDamage_Desc = "permanent damage, capped by the promotion ceiling";
TFLV_Upgrade_RS_CardDamage_TT = "Permanent +damage (bigger on promoted guns). Cannot exceed the damage ceiling -- promote to raise it.";

TFLV_Upgrade_RS_CardAccuracy_Name = "Accuracy Up";
TFLV_Upgrade_RS_CardAccuracy_Desc = "permanent +2 accuracy";
TFLV_Upgrade_RS_CardAccuracy_TT = "Permanent +2 Accuracy, to a maximum of 98.";

TFLV_Upgrade_RS_CardCapacity_Name = "Capacity Up";
TFLV_Upgrade_RS_CardCapacity_Desc = "permanent +1 magazine";
TFLV_Upgrade_RS_CardCapacity_TT = "Permanent +1 magazine capacity.";

TFLV_Upgrade_RS_CardCrit_Name = "Crit Up";
TFLV_Upgrade_RS_CardCrit_Desc = "permanent +0.5% critical chance";
TFLV_Upgrade_RS_CardCrit_TT = "Permanent +0.5% chance of a x2 critical volley.";

TFLV_Upgrade_RS_CardChoke_Name = "Choke Up";
TFLV_Upgrade_RS_CardChoke_Desc = "tighter pellet cone (shotgun family)";
TFLV_Upgrade_RS_CardChoke_TT = "Permanent +0.05 Choke -- a tighter cone. Shotgun-family exclusive.";

TFLV_Upgrade_RS_CardReload_Name = "Reload Tune";
TFLV_Upgrade_RS_CardReload_Desc = "smoother reloads, bonus rounds";
TFLV_Upgrade_RS_CardReload_TT = "Permanent +0.05 Reload Speed. High reload speed chambers bonus rounds on every reload.";

// --- Combo cards (purple; promoted / high-tier guns) -----------------

TFLV_Upgrade_RS_ComboMarksman_Name = "Marksman's Package";
TFLV_Upgrade_RS_ComboMarksman_Desc = "+3 accuracy AND +0.75% crit";
TFLV_Upgrade_RS_ComboMarksman_TT = "Two related gains, one card. Offered to promoted or Advanced+ guns.";

TFLV_Upgrade_RS_ComboChamber_Name = "Extended Chamber";
TFLV_Upgrade_RS_ComboChamber_Desc = "+2 capacity AND +0.05 reload";
TFLV_Upgrade_RS_ComboChamber_TT = "Two related gains, one card. Offered to promoted or Advanced+ guns.";

TFLV_Upgrade_RS_ComboHotLoads_Name = "Hot Loads";
TFLV_Upgrade_RS_ComboHotLoads_Desc = "+damage; shotguns tighten, others kick";
TFLV_Upgrade_RS_ComboHotLoads_TT = "Ceiling-capped damage plus a family-flavored side: shotguns gain choke, everything else loses a little accuracy -- hot loads kick.";

TFLV_Upgrade_RS_ComboWinterKit_Name = "Winter Kit";
TFLV_Upgrade_RS_ComboWinterKit_Desc = "Pain Orb +1 level AND +1 capacity";
TFLV_Upgrade_RS_ComboWinterKit_TT = "Deepens a held Pain Orb one level and offsets its capacity price a step. Never grants the Mastery -- that pick is always yours to make.";

TFLV_Upgrade_RS_ComboTwinDiscipline_Name = "Twin Discipline";
TFLV_Upgrade_RS_ComboTwinDiscipline_Desc = "Splitter +1 level AND +2 accuracy";
TFLV_Upgrade_RS_ComboTwinDiscipline_TT = "Deepens a held Splitter affix one level and steadies the spray. Never grants the Mastery -- that pick is always yours to make.";

// --- Wave D1: monster signatures (docs/rs_13) ------------------------

TFLV_Upgrade_RS_ArachPlasma_Name = "Arach-Plasma";
TFLV_Upgrade_RS_ArachPlasma_Desc = "your rounds become the Arachnotron's bolt";
TFLV_Upgrade_RS_ArachPlasma_TT = "The spider's own relentless plasma in your gun. A light, fast round -- its identity is how quickly it speaks, so the damage ramp is small (+2% per level). Mastery: the plasma burns through two bodies.";

TFLV_Upgrade_RS_Swarm_Name = "Swarm";
TFLV_Upgrade_RS_Swarm_Desc = "your rounds shed a cloud of hunting motes";
TFLV_Upgrade_RS_Swarm_TT = "The Overlord's bee carrier. Your round still lands its own full damage -- what levels buy is the SWARM, 2 to 6 motes peeling off in flight to find their own targets. Mastery: eight motes, and they hunt precisely.";

TFLV_Upgrade_RS_Nova_Name = "Nova";
TFLV_Upgrade_RS_Nova_Desc = "your rounds detonate into a plasma ring";
TFLV_Upgrade_RS_Nova_TT = "The Cyberdemon's swoosh shell -- a heavy round that bursts into a ring of plasma beads on impact. Levels buy both weight (+4% damage) and beads (4 to 12). Mastery: sixteen beads, and they seek.";

// --- Wave D2: general lane (docs/rs_11 candidate pool) ---------------

TFLV_Upgrade_RS_PainTrain_Name = "Pain Train";
TFLV_Upgrade_RS_PainTrain_Desc = "your rounds stagger what they hit";
TFLV_Upgrade_RS_PainTrain_TT = "Each pellet has a growing chance (15% to 75%) to force a flinch regardless of how tough the target is -- and high-tier monsters are exactly the ones that stop flinching on their own. Mastery: every round, every time.";

TFLV_Upgrade_RS_Momentum_Name = "Momentum";
TFLV_Upgrade_RS_Momentum_Desc = "crits chain -- each one makes the next likelier";
TFLV_Upgrade_RS_Momentum_TT = "Every consecutive critical raises the odds of the next, up to four links (eight at Mastery). Built on this gun's own rolled Crit Chance, so a high-crit weapon chains constantly and a low-crit one rarely does. The streak breaks the moment a shot doesn't crit.";

TFLV_Upgrade_RS_Overkill_Name = "Overkill";
TFLV_Upgrade_RS_Overkill_Desc = "damage past a kill detonates on the corpse";
TFLV_Upgrade_RS_Overkill_TT = "Whatever damage was wasted killing something comes back as a blast on the body -- 20% of it per level, in a growing radius. The harder this gun hits, the more waste there is to spend. Mastery: the full excess, uncapped by level.";

TFLV_Upgrade_RS_Salvage_Name = "Salvage";
TFLV_Upgrade_RS_Salvage_Desc = "your gun works a captured monster round into its cycle";
TFLV_Upgrade_RS_Salvage_TT = "Salvaged ordnance. A round pulled off something you killed gets fed into your firing rotation -- it keeps its own damage, speed and impact, while your gun supplies the bang, the brass and the flash. Levels buy frequency first (every 4th shot, then 3rd, then 2nd) and then breadth: at 5 a second, different round joins the cycle. Mastery: the salvage is re-rolled every time you raise the weapon, so it is never quite the same gun twice. What you can draw depends on what you are holding -- a flamethrower only ever salvages fire, a railgun only coherent energy, but a bullet gun can pull anything in the bestiary.";

TFLV_Upgrade_RS_Scavenger_Name = "Scavenger";
TFLV_Upgrade_RS_Scavenger_Desc = "kills on a dry magazine give rounds back";
TFLV_Upgrade_RS_Scavenger_TT = "Kill something while your magazine is in its bottom quarter and you recover rounds -- 10% of capacity per level. A big magazine makes the window rarer but the refund larger. Mastery: the whole magazine, instantly.";


// --- RS_Grenade ---
TAG_RS_GRENADE = "Frag Grenade";
AMMO_RS_GRENADE = "Frag Grenades";
PICKUP_RS_GRENADE = "Picked up a frag grenade.";
PICKUP_RS_GRENADEAMMO = "Picked up a frag grenade.";
OB_RS_GRENADE = "%o was popped by %k's grenade.";

// --- Elite food scatter ---
TAG_RS_FOOD = "Rations";
PICKUP_RS_FOOD = "Rations.";

// --- Catalog affixes. Content is looked up in RS_MinionCatalog /
// --- RS_FXRegistry rather than hardcoded, so these three grow as the
// --- catalogs grow. See zscript/GunBonsai/rs_upgrades/RS_Upgrade_Catalog.zsc
TFLV_Upgrade_RS_Conscript_Name = "Conscript";
TFLV_Upgrade_RS_Conscript_Desc = "what you kill sometimes gets back up on your side";
TFLV_Upgrade_RS_Conscript_TT = "Kills have a chance to raise the dead as yours. It prefers the victim's own kind, so a room of imps builds an imp squad rather than a random menagerie. Levels raise both the chance (10/20/30/40/50%) and the budget, and the budget decides what you can afford -- early on that is lost souls and zombies, later revenants and worse. A minion is friendly to you and hostile to everything else, and every point of damage it deals feeds the gun that raised it for as long as it lives, even after you have switched to something else. Mastery: the budget doubles and they come up in pairs.";

TFLV_Upgrade_RS_Smokescreen_Name = "Smokescreen";
TFLV_Upgrade_RS_Smokescreen_Desc = "kills leave a cloud; what stands in it cannot shoot straight";
TFLV_Upgrade_RS_Smokescreen_TT = "A killed body vents a cloud of smoke. Monsters inside take a real aim penalty -- their shots go wide by a growing margin, hitscan and missiles alike -- and it does nothing to you or your minions. Levels widen the cloud, lengthen it, and increase the error. The smoke is drawn from the FX registry, so it uses whatever smoke the mod has loaded and picks up new smoke automatically. Mastery: the cloud also blinds, and things inside lose track of you entirely.";

TFLV_Upgrade_RS_Turncoat_Name = "Turncoat";
TFLV_Upgrade_RS_Turncoat_Desc = "kills turn an enemy effect loose on your behalf";
TFLV_Upgrade_RS_Turncoat_TT = "The FX registry marks certain effects as enemy-side -- the ones that hurt or raise monsters, which every other system in the mod deliberately keeps out of your gun. Turncoat is the exception: on a kill it pulls one of those and spawns it under your flag, hostile to them, harmless to you, credited to the weapon that made the kill. What can appear depends entirely on what the registry has tagged, so it grows as the mod grows. Mastery: it also draws the effects that spawn further effects, which is how one kill becomes a small riot.";

// --- THE CATALOG CARD SET (105). Behaviour lives in
// --- RS_Upgrade_CatalogBases.zsc; each card names only a bestiary
// --- family, a registry theme, or a PACK axis.
TFLV_Upgrade_RS_LevyPinky_Name = "Levy: pinkies";
TFLV_Upgrade_RS_LevyPinky_Desc = "kills raise a pinkies to fight for you";
TFLV_Upgrade_RS_LevyPinky_TT = "A chance on every kill to raise one good pinkies on your side, whatever you actually killed. The budget climbs with level and buys further up that family's own roster, so late levels field the dangerous members rather than more of the cheap ones. Yours are friendly to you and hostile to everything else, and every point of damage they deal feeds the gun that raised them for as long as they live -- including after you have switched weapons. Mastery: the budget reaches the top of the family.";

TFLV_Upgrade_RS_HordePinky_Name = "Horde: pinkies";
TFLV_Upgrade_RS_HordePinky_Desc = "kills raise several cheap pinkies at once";
TFLV_Upgrade_RS_HordePinky_TT = "The other way to spend a kill: instead of one good body, a ring of cheap ones. Levels buy more of them rather than better ones, and they come up spread around the corpse so they do not crowd each other out. Same rules as any minion -- friendly to you, hostile to everything else, and paying XP to the gun that raised them for life. Mastery: five at a time.";

TFLV_Upgrade_RS_BanePinky_Name = "Bane: pinkies";
TFLV_Upgrade_RS_BanePinky_Desc = "you hit pinkies noticeably harder";
TFLV_Upgrade_RS_BanePinky_TT = "A flat percentage bonus against that family, landing as a separate second hit so it shows on the feed and cannot be eaten by the first hit's resistances. It reads the same bestiary the Levy cards do, so it recognizes every colour variant of the family and not just the base monster. Stacks with everything.";

TFLV_Upgrade_RS_TithePinky_Name = "Tithe: pinkies";
TFLV_Upgrade_RS_TithePinky_Desc = "killing pinkies puts you back together";
TFLV_Upgrade_RS_TithePinky_TT = "Every pinkies you kill heals you, scaled to how dangerous the bestiary rates that particular one -- so the big members of the family are worth more than the chaff without a hand-written table saying so. It can carry you above your normal maximum. Mastery: they drop ammunition as well.";

TFLV_Upgrade_RS_CullPinky_Name = "Cull: pinkies";
TFLV_Upgrade_RS_CullPinky_Desc = "wounded pinkies do not get to limp away";
TFLV_Upgrade_RS_CullPinky_TT = "Once a pinkies drops below a share of its own maximum health, your next hit finishes it outright. Because the threshold is a share rather than a flat number, it is worth the same against the biggest member of the family as the smallest. Levels raise the threshold.";

TFLV_Upgrade_RS_LevyChaingunner_Name = "Levy: chaingunners";
TFLV_Upgrade_RS_LevyChaingunner_Desc = "kills raise a chaingunners to fight for you";
TFLV_Upgrade_RS_LevyChaingunner_TT = "A chance on every kill to raise one good chaingunners on your side, whatever you actually killed. The budget climbs with level and buys further up that family's own roster, so late levels field the dangerous members rather than more of the cheap ones. Yours are friendly to you and hostile to everything else, and every point of damage they deal feeds the gun that raised them for as long as they live -- including after you have switched weapons. Mastery: the budget reaches the top of the family.";

TFLV_Upgrade_RS_HordeChaingunner_Name = "Horde: chaingunners";
