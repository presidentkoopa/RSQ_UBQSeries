TFLV_Upgrade_RS_BrandPsychic_Name = "Brand: Psychic";
TFLV_Upgrade_RS_BrandPsychic_Desc = "your hits plant psychic where they land";
TFLV_Upgrade_RS_BrandPsychic_TT = "Hits have a growing chance to leave a psychic payload at the impact. What actually gets planted is drawn live from the FX registry, so it is never quite the same twice and it grows on its own as psychic effects are added to the mod -- import a weapon set, tag its parts, and every Psychic card gets deeper without a line of code. Mastery: it plants the headline version, the big one.";

TFLV_Upgrade_RS_AttunePsychic_Name = "Attune: Psychic";
TFLV_Upgrade_RS_AttunePsychic_Desc = "your gun works a psychic beat into its firing cycle";
TFLV_Upgrade_RS_AttunePsychic_TT = "Locks an extra beat into the weapon's firing rotation built entirely from psychic parts -- projectile, muzzle, smoke, sparks, trail and impact all drawn from that theme together, so it arrives as a coherent shot rather than a recolour. Levels tighten the rotation from every fifth shot down to every second. Mastery: a second, independently rolled psychic beat joins the same cycle, so the theme shows up two different ways.";

TFLV_Upgrade_RS_SurgePsychic_Name = "Surge: Psychic";
TFLV_Upgrade_RS_SurgePsychic_Desc = "kills burst into psychic";
TFLV_Upgrade_RS_SurgePsychic_TT = "A kill has a chance to throw the biggest psychic effect the registry holds. Purely on death, so it never interferes with your shot, and it scales with whatever psychic content the mod has loaded. Mastery: three at once, thrown apart.";

TFLV_Upgrade_RS_BrandVoid_Name = "Brand: Void";
TFLV_Upgrade_RS_BrandVoid_Desc = "your hits plant void where they land";
TFLV_Upgrade_RS_BrandVoid_TT = "Hits have a growing chance to leave a void payload at the impact. What actually gets planted is drawn live from the FX registry, so it is never quite the same twice and it grows on its own as void effects are added to the mod -- import a weapon set, tag its parts, and every Void card gets deeper without a line of code. Mastery: it plants the headline version, the big one.";

