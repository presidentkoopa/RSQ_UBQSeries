// CVARINFO.plusex -- Colourful Hell Plus R3.0.1's boss choices (zscript/monsters/plus/RS_PlusEX.zs), 2026-11-16.
// The EX share of the six new EX bosses is the existing rs_ch_exboss (CVARINFO.txt), unchanged.
// White Arachnotron boss (CHP's CH_OldWSpid): 1 = 1.04's White Spider (this pack's body before 11-16, default),
// 2 = Old (1.04's dormant WhiteSP11Old), 3 = Fusion (CHP), 4 = CHP's New.
server int rs_chp_whitespider = 1;
// Black Lost Soul boss (CHP's CH_OldBSoul): 1 = 1.04's Queen Bee (default), 2 = Old (1.04's dormant BlackLSoulOld3).
server int rs_chp_blacksoul = 1;
// White Mastermind boss: 1 = 1.04's Heavily Armed Spidey only, 2 = CHP's Everlasting White Spidey only,
// 3 = either, half and half (default).
server int rs_chp_whitemind = 3;
