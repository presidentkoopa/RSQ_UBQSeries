class RS_LetterJ : RS_LetterA   // CHP MISC/letters:2221 (LetterJ_C)
{
	Default
	{
	}
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Playsound("rsplus/letterc", 0, 1, 0, 1.6);
		LETR JJJJJJJJJJ 1 Bright A_FadeIn(0.075);
		LETR J -1 Bright;
		Stop;
	}
}

