class RS_HSFlameBlast : FastProjectile   // CHP 17/17_KX:9036 (HSFlameBlast_C)
{
	Default
	{
		Radius 8;
		Height 12;
		Speed 72;
		DamageFunction (random(20,40));   // CHP: Damage (random(20,40))
		Scale 1.5;
		Projectile;
		RENDERSTYLE "ADD";
		DamageType "Fire";
		ALPHA 0.95;
		SeeSound "weapons/hellfi";
		DeathSound "weapons/firbfi";
		DONTHURTSHOOTER;
		Decal "Scorch";
		+THRUGHOST
	}
	States
	{
	Spawn:
		CFFX N 1 Bright A_SpawnItemEx("RS_HSFlameBlastTrail", -10, 0, 0, 0, 0, 0, 0, 128);
		Loop;
	Death:
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 0, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 45, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 90, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 135, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 180, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 225, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 270, 2, 0);
		CFFX A 0 A_CustomMissile("RS_DFlare", 8, 0, 315, 2, 0);
	XDeath:
		CFFX A 3 Bright;
		CFFX BCDEFGHIJK 3 Bright A_Explode(random(5,15), 32, 0);
		CFFX LM 3 Bright;
		Stop;
	}
}

class RS_HSFlameBlastTrail : Actor   // CHP 17/17_KX:9570 (HSFlameBlastTrail_C)
{
	Default
	{
		RenderStyle "Add";
		Alpha 0.5;
	}
	States
	{
	Spawn:
		CFFX NOP 2;
		Stop;
	}
}

class RS_WHITESPIDERWEBSHOT : FastProjectile   // CHP 12/12_W:3467 (WHITESPIDERWEBSHOT_C)
{
	Default
	{
		Radius 3;
		Height 3;
		Speed 35;
		DamageFunction (random(1,5));   // CHP: Damage (random(1,5))
		Scale 0.75;
		Projectile;
		SeeSound "phantom/bomb";
		DeathSound "phantom/explode";
		DamageType "Melee";
		Translation "192:207=80:95";
	}
	States
	{
	Spawn:
		PLSE A 3 Bright a_spawnitemex("RS_WhiteSPWebTrail", cos(pitch)*1, 0, 0-(sin(pitch)*1), cos(pitch)*1, 0, -sin(pitch)*1);
		Loop;
	Death:
		TNT1 A 0 A_RadiusGive("RS_WHITESPSlowdownNew", 64, RGF_PLAYERS|RGF_CUBE, 1);
		TNT1 AA 0 A_spawnitemex("RS_WhiteSPWebWeb", random(-26,26), random(-26,26), random(-8,16));
		TNT1 AA 0 A_spawnitemex("RS_WhiteSPWebWeb", random(-48,48), random(-48,48), random(-8,16));
		PLSE BCDE 1 Bright;
		Stop;
	}
}

class RS_WHITESPSlowdownNew : PowerSpeed   // CHP 12/12_W:3794 (WHITESPSlowdownNew)
{
	Default
	{
		Powerup.Duration 30;
		Speed 0.2;
		+Inventory.AUTOACTIVATE
		-Inventory.INVBAR
	}
}

class RS_ESZapZap : Actor   // CHP 16/16_W:14027 (ESZapZap_C)
{
	Default
	{
		Species "MMind";
		RenderStyle "Add";
		Alpha 0.90;
		Translation "0:255=%[0.21,0.29,0.68]:[1.07,2.00,2.00]";
		+NOCLIP
		+NOBLOCKMAP
		+NOGRAVITY
		+mthruspecies
		+DONTHARMSPECIES   // CHP: +donthurtspecies (its deprecated name)
	}
	States
	{
	Spawn:
		LITN BCDEFGOP 2 Bright;
		Stop;
	}
}
