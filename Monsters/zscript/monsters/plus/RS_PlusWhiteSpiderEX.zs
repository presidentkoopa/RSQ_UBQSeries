class RS_WhiteSPEX : Actor   // CHP 12/12_WX:1 (CommonWhiteSpiderEX2)
{
	override void PostBeginPlay() { Super.PostBeginPlay(); RS_Zom.SetTier(self, 13); }
	override void Tick() { Super.Tick(); RS_PlusEX.Icon(self, 13); }
	Default
	{
		BloodColor "FF 89 4D";
		Health 9500;
		Radius 56;
		Height 64;
		Mass 1000;
		Speed 22;
		PainChance 32;
		MeleeRange 112;
		XScale 1.35;
		YScale 1.62;
		Species "WhiteSP";
