		+dontmorph
		+NOFEAR
		+noicedeath
		+THRUSPECIES
		MissileChanceMult 0.5;   // CHP: +MISSILEMORE
	}
	States
	{
	Spawn:
		WSPX A 0 NoDelay;
		WSPX A 0;
		Goto Scripted;
	Scripted:
		WSPX A 0;
		WSPX A 0 A_Log("A chill runs down your spine");
		Goto Idle;
	Idle:
		WSPX AB 10 A_Look;
		Loop;
	See:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_Chase;
		WSPX A 0 A_Jump(25, "Dodger");
		Loop;
	Dodger:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_Jump(100, "Jumpy");
		Goto See;
	Jumpy:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX A 2 A_fastchase;
		WSPX B 1 thrustthingz(0, 80, 0, 0);
		WSPX B 1 ThrustThing(int(angle-randompick(130,180,230)), 40, 0, 0);
		WSPX C 2;
		WSPX D 1 thrustthingz(0, 40, 0, 0);
		WSPX D 1 ThrustThing(int(angle), 40, 0, 0);
		Goto see;
	Melee:
	Missile:
		WSPX C 0 A_Playsound("rsplus/wspexatk");
		WSPX C 0 A_JumpIfCloser(250, "CloseShot");
		WSPX C 0 A_JumpIfCloser(2000, "Midrange");
		Goto FarShot;
	Midrange:
		WSPX C 0 A_Jump(96, "Basic");
		WSPX C 0 A_Jump(64, "Spiders");
		WSPX C 0 A_Jump(256, "Flares", "FireBombs", "FlameBlast", "Spiders", "Webs", "KRAKATOA");
		Goto See;
	CloseShot:
		WSPX C 0 A_Jump(150, "Webs");
		Goto Midrange;
	FarShot:
		WSPX C 0 A_Jump(150, "FlameBlast", "Flares");
		WSPX C 0 A_Jump(256, "Spiders", "KRAKATOA");
	Getdown:
		WSPX C 0 { bFLOAT = false; }
		WSPX C 0 { bNOGRAVITY = false; }
		WSPX C 12 Bright { bNOPAIN = false; }
		WSPX C 0 A_jump(96, "Spiders");
		Goto See;
	Basic:
		WSPX C 2 Bright A_FaceTarget;
		WSPX C 0 { bFLOAT = true; }
		WSPX C 0 { bNOGRAVITY = true; }
		WSPX C 0 { bNOPAIN = true; }
		WSPX C 1 Bright ThrustThingZ(0, 40, 0, 0);
		WSPX C 1 Bright ThrustThing(int(angle), 32, 0, 0);
		WSPX CF 8 Bright A_FaceTarget;
		WSPX F 0 A_Jump(256, "Basic1", "Basic2", "Basic4");
	Basic1:
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-1,1));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-12,12));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(3,12));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-3,3));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-3,-12));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-3,3));
		WSPX CC 8 Bright a_facetarget;
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-1,1));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-12,12));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(3,12));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-3,3));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-3,-12));
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, random(-3,3));
		WSPX F 0 A_jump(160, "Basic2", "Basic3", "Basic4");
		Goto Getdown;
	Basic2:
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 23, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -23, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 12, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -12, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 5, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -5, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 0, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 23, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -23, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 12, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -12, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 5, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -5, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 0, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 29);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -29);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 15);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -15);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, 6);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 0, -6);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 0);
		WSPX F 0 A_jump(160, "Basic3");
		Goto Getdown;
	Basic3:
		WSPX CC 8 Bright a_facetarget;
		WSPX F 0 A_Checksight("Getdown");
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 22, 10, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 22, -10, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 62, 10, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 62, -10, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, 20, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 42, -20, 0);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 0);
		Goto Getdown;
	Basic4B:
		WSPX AA 8 Bright a_facetarget;
	Basic4:
		WSPX F 0 A_Checksight("Getdown");
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -15);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -11);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -7);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -3);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -1);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 1);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 3);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 7);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 11);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 15);
		WSPX F 0 A_jump(160, "Basic5");
		Goto Getdown;
	Basic5:
		WSPX CC 8 Bright a_facetarget;
		WSPX F 0 A_Checksight("Getdown");
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 15);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 11);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 7);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 3);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, 1);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -1);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -3);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -7);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -11);
		WSPX F 1 Bright A_Custommissile("RS_BoilBoltL9", 42, 0, -15);
		WSPX F 0 A_jump(96, "Basic4B");
