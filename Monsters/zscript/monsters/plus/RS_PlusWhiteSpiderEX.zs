		WSPX C 0 { bNOPAIN = true; }
		WSPX C 0 A_Playsound("rsplus/wspexatk", 0, 255, 0, 0);
		WSPX C 10 A_FaceTarget;
		LMWX A 0 A_Playsound("rsplus/spmding", CHAN_5, 255, 0, 0);
		LMWX A 0 A_SpawnitemEx("RS_SuperEye02", 4, 0, 28, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		LMWX A 0 A_SpawnitemEx("RS_SuperEye02", 4, -8, 28, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		WSPX CCCF 10 A_FaceTarget;
		WSPX FFFFF 2 Bright A_Custommissile("RS_KrakatoaL9", 42, 0, 0);
		WSPX F 0 A_FaceTarget;
		WSPX FFFFF 2 Bright A_Custommissile("RS_KrakatoaL9", 42, 0, 0);
		WSPX F 0 A_FaceTarget;
		WSPX FFFFF 2 Bright A_Custommissile("RS_KrakatoaL9", 42, 0, 0);
		WSPX F 0 A_FaceTarget;
		WSPX FFFFF 2 Bright A_Custommissile("RS_KrakatoaL9", 42, 0, 0);
		WSPX FC 10 A_FaceTarget;
		WSPX C 0 { bNOPAIN = false; }
		Goto See;
	Pain:
		WSPX C 3;
		WSPX C 3 A_Pain;
		WSPX C 0 A_Jump(88, "woa");
		Goto See;
	Pain.Fire:
		WSPX C 3 A_playsound("ResistCH", 7);
		Goto See;
	woa:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireAL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_Jump(100, "Jumpy");
		Goto See;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TNT1 A 0 A_SetScale(1.62, 1.125);
		WSPX G 20 Bright A_Scream;
		WSPX H 5 A_Explode(50, 200);
		WSPX IJKL 5 Bright A_Explode(50, 200);
		WSPX MN 5 A_NoBlocking(0);
		WSPX OOOO 8 A_SpawnItemEx("RS_BigBadFire1", random(-120,120), random(-120,120));
		WSPX OOO 0 A_SpawnItemEx("RS_WhiteSPEXSplit", 0, 0, random(8,56), random(0,3), random(0,3), random(0,3), random(0,64), SXF_NOCHECKPOSITION);
		WSPX O 0 A_SpawnItemEx("RS_RandomLetterSpawner", 0, 0, 0, frandom(-7500,7500) / 1000, frandom(-7500,7500) / 1000, 0, 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION, 184);
		WSPX O 0 A_NoBlocking;
		WSPX O -1;
		Stop;
	}
}

class RS_FireBombL9 : Actor   // CHP 12/12_WX:12686 (FireBombL9_C)
{
	Default
	{
		Radius 13;
		Height 11;
		Speed 18;
		DamageFunction (random(20,50));   // CHP: Damage (random(20,50))
		DamageType "Fire";
		Projectile;
		RenderStyle "Add";
		Alpha 1.0;
		Gravity 0.15;
		SeeSound "weapons/firex4";
		DeathSound "shadowbeast/pr1death";
		-NOGRAVITY
	}
	States
	{
	Spawn:
		SBA2 ABC 4 Bright;
		Loop;
	Death:
		SBA2 DDD 0 A_spawnitemex("RS_Firespe1", random(-64,64), random(-64,64), 0, 0, 0, 0, 0, 0, 128);
		SBA2 DE 4 Bright A_Explode(random(10,40), 102);
		SBA2 FGH 3 Bright A_Explode(random(10,30), 88);
		Stop;
	}
}

