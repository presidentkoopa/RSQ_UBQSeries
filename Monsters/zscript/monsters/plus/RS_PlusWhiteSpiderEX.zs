class RS_MiniSpiderL9 : Actor   // CHP 12/12_WX:10528 (MiniSpiderL9_C)
{
	Default
	{
		BloodColor "FF 89 4D";
		Species "WhiteSP";
		Health 15;
		Radius 16;
		Height 25;
		Mass 100;
		Speed 28;
		PainChance 128;
		XScale 0.18;
		YScale 0.216;
		RadiusDamageFactor 0.25;
		DamageFactor "fire", 0.1;
		Monster;
		SeeSound "rsplus/wspexatk";
		PainSound "rsplus/wspexpai";
		DeathSound "rsplus/wspexdt2";
		//ActiveSound "rsplus/wspexact"
		DropItem "HealthBonus", 80;
		DropItem "RS_implyingclip", 70;
		DropItem "RS_CH_Shell", 52;
		DropItem "RS_CH_RocketAmmo", 40;
		DropItem "RS_CH_Cell", 15;
		Obituary "%o was eaten by white hot tiny spider";
		Tag "Tiny White Hot Spider";
		Translation "0:0=0:0";
		+FLOORCLIP
		+DONTHARMSPECIES
		+THRUSPECIES
		-COUNTKILL
		MissileChanceMult 0.0625;   // CHP: +MISSILEMORE +MISSILEEVENMORE
	}
	States
	{
	Spawn:
		WSPX AB 10 A_Look;
		Loop;
	See:
		WSPX A 20;
		WSPX AABB 3 A_Chase("Melee", null, CHF_STOPIFBLOCKED);
		WSPX C 0 { bNOCLIP = false; }
		WSPX C 0 a_checkblock("IStuck", CBF_DROPOFF);
		WSPX CCDD 3 A_Chase("Melee", null, CHF_STOPIFBLOCKED);
		WSPX D 0 a_checkblock("IStuck", CBF_DROPOFF);
		Goto See+1;
	IStuck:
		WSPX A 1;
		WSPX A 1 { bNOCLIP = true; }
		WSPX ABC 1 A_wander;
		Goto see+1;
	Melee:
		WSPX C 4 Bright A_FaceTarget;
		WSPX E 22 Bright A_Custommeleeattack(random(3,12), "misc/gibbed/c", "None");
		Goto See+1;
	Pain:
		WSPX C 3;
		WSPX C 3 A_Pain;
		Goto See+1;
	Death.Ice:
	Death:
		WSPX C 8 A_Screamandunblock;
		MISL XYZ 10 A_Explode(random(1,9), 32);
		Stop;
	}
}

