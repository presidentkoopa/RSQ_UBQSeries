		WSPX H 5 A_Explode(20, 200);
		WSPX IJKL 5 Bright A_Explode(20, 200);
		WSPX MN 5 A_NoBlocking(0);
		WSPX O 8 A_SpawnItemEx("RS_Firespe1", random(-32,32), random(-32,32));
		WSPX O 0 A_Burst("RS_MiniSpiderL9");
		WSPX O -1;
		Stop;
	}
}

