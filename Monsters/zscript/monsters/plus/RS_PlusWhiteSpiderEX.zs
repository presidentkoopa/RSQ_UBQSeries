class RS_WhiteSPEXSplit : RS_WhiteSPEX   // CHP 12/12_WX:4653 (CommonWhiteSpiderEX3)
{
	override void PostBeginPlay() { Super.PostBeginPlay(); RS_Zom.SetTier(self, 13); }
	override void Tick() { Super.Tick(); RS_PlusEX.Icon(self, 13); }
	Default
	{
		Health 2200;
		Radius 32;
		Height 37;
		Speed 22;
		MeleeRange 64;
		XScale 0.78;
		YScale 0.935;
		DropItem "RS_BackPackBundle";
		DropItem "RS_BackPackBundle", 128;
		DropItem "Soulsphere", 64;
		DropItem "BlueArmor", 64;
		Obituary "%o became a toasted marshmallow from a 1/3 of the white hot spider.";
		MissileChanceMult 1.0;   // CHP: -MISSILEMORE
	}
	States
	{
	Spawn:
		WSPX A 0 NoDelay;
		WSPX A 0;
		Goto Spawn2;
	Spawn2:
		WSPX AB 10 A_Look;
		Loop;
	See:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_Chase;
		WSPX A 0 A_Jump(25, "Dodger");
		Loop;
	Dodger:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCD 2 A_FastChase;
		WSPX A 0 A_Jump(50, "Jumpy");
		Goto See;
	Jumpy:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX A 2 A_fastchase;
		WSPX B 1 thrustthingz(0, 80, 0, 0);
		WSPX B 1 ThrustThing(int(angle-randompick(130,180,230)), 40, 0, 0);
		WSPX C 2;
		WSPX D 1 thrustthingz(0, 40, 0, 0);
		WSPX D 1 ThrustThing(int(angle), 40, 0, 0);
		Goto see;
	Melee:
	Missile:
		WSPX C 0 A_Playsound("rsplus/wspexatk");
		WSPX C 0 A_JumpIfCloser(250, "CloseShot");
		WSPX C 0 A_JumpIfCloser(2000, "Midrange");
		Goto FarShot;
	Midrange:
		WSPX C 0 A_Jump(96, "Basic");
		WSPX C 0 A_Jump(64, "Spiders");
		WSPX C 0 A_Jump(256, "FireBombs", "Spiders", "Webs");
		Goto See;
	CloseShot:
		WSPX C 0 A_Jump(150, "Webs");
		Goto Midrange;
	FarShot:
		WSPX C 0 A_Jump(256, "Spiders", "Webs");
	Getdown:
		WSPX C 0 { bFLOAT = false; }
		WSPX C 0 { bNOGRAVITY = false; }
		WSPX C 12 Bright { bNOPAIN = false; }
		WSPX C 0 A_jump(96, "Spiders");
		Goto See;
	Basic:
		WSPX C 2 Bright A_FaceTarget;
		WSPX C 0 { bFLOAT = true; }
		WSPX C 0 { bNOGRAVITY = true; }
		WSPX C 0 { bNOPAIN = true; }
		WSPX C 1 Bright ThrustThingZ(0, 40, 0, 0);
		WSPX C 1 Bright ThrustThing(int(angle), 32, 0, 0);
		WSPX CF 8 Bright A_FaceTarget;
		WSPX F 0 A_Jump(256, "Basic1", "Basic2", "Basic4");
	Basic1:
		WSPX F 4 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, random(-1,1));
		WSPX F 4 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, random(3,12));
		WSPX F 4 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, random(-12,-3));
		WSPX CC 8 Bright a_facetarget;
		WSPX F 4 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, random(-1,1));
		WSPX F 4 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, random(3,12));
		WSPX F 4 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, random(-12,-3));
		WSPX F 0 A_jump(160, "Basic2", "Basic3", "Basic4");
		Goto Getdown;
	Basic2:
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 24, 0, 5, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 24, 0, -5, 32, 2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 24, 0, 5, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 24, 0, -5, 32, -2);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 24, 0, 6);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 24, 0, -6);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 0);
		WSPX F 0 A_jump(160, "Basic3");
		Goto Getdown;
	Basic3:
		WSPX CC 8 Bright a_facetarget;
		WSPX F 0 A_Checksight("Getdown");
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 18, 6, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 18, -6, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 30, 6, 0);
		WSPX F 0 A_Custommissile("RS_BoilBoltL9", 30, -6, 0);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 0);
		Goto Getdown;
	Basic4B:
		WSPX AA 8 Bright a_facetarget;
	Basic4:
		WSPX F 0 A_Checksight("Getdown");
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, -15);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, -7);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 0);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 7);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 15);
		WSPX F 0 A_jump(160, "Basic5");
		Goto Getdown;
	Basic5:
		WSPX CC 8 Bright a_facetarget;
		WSPX F 0 A_Checksight("Getdown");
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 15);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 7);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, 0);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, -7);
		WSPX F 2 Bright A_Custommissile("RS_BoilBoltL9", 24, 0, -15);
		WSPX F 0 A_jump(96, "Basic4B");
		Goto Getdown;
	FireBombs:
		WSPX C 8 Bright A_FaceTarget;
		WSPX E 0 A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-9,9), 32, random(-4,28));
		WSPX E 4 Bright A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-30,30), 32, random(-4,28));
		WSPX C 4 Bright A_FaceTarget;
		WSPX EE 0 A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-9,9), 32, random(-4,28));
		WSPX E 4 Bright A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-30,30), 32, random(-4,28));
		WSPX E 0 A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-9,9), 32, random(-4,28));
		WSPX E 4 Bright A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-30,30), 32, random(-4,28));
		WSPX C 4 Bright A_FaceTarget;
		WSPX EE 0 A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-9,9), 32, random(-4,28));
		WSPX E 4 Bright A_CustomMissile("RS_FireBombL9", random(18,30), random(-14,14), random(-30,30), 32, random(-4,28));
		WSPX C 8 Bright A_FaceTarget;
		WSPX C 0 A_jumpifcloser(2000, 1);
		Goto FarShot;
		WSPX C 0 A_jump(32, "Webs");
		WSPX C 0 A_SpidRefire;
		Goto FireBombs+1;
	Spiders:
		WSPX C 8 Bright A_FaceTarget;
		WSPX E 5 Bright A_FaceTarget;
		WSPX F 5 Bright A_Custommissile("RS_SPWHIL9", 24, 0, random(-1,1));
		WSPX F 0 A_Custommissile("RS_SPWHIL9", 24, 0, random(8,24));
		WSPX F 0 A_Custommissile("RS_SPWHIL9", 24, 0, random(-24,-8));
		WSPX F 0 A_jump(96, "Webs");
		Goto See;
	Webs:
		WSPX C 2 Bright A_FaceTarget;
		WSPX E 5 Bright A_FaceTarget;
		WSPX E 6 Bright A_Custommissile("RS_WHITESPIDERWEBSHOT", 24, 0, random(-1,1));
		WSPX E 5 Bright A_FaceTarget;
		WSPX E 6 Bright A_Custommissile("RS_WHITESPIDERWEBSHOT", 24, 0, random(-20,20));
		WSPX E 5 Bright A_FaceTarget;
		WSPX E 6 Bright A_Custommissile("RS_WHITESPIDERWEBSHOT", 24, 0, randompick(-18,-12,12,18));
		WSPX FC 6 Bright;
		WSPX C 0 A_jump(192, "Midrange");
		Goto See;
	Pain:
		WSPX C 3;
		WSPX C 3 A_Pain;
		WSPX C 0 A_Jump(88, "woa");
		Goto See;
	Pain.Fire:
		WSPX C 3 A_playsound("ResistCH", 7);
		Goto See;
	woa:
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_SpawnItemEx("RS_FlaminFireBL9", 0, 0, 0, 0, 0, 0, 0, 32);
		WSPX ABCDABCD 1 A_Wander;
		WSPX A 0 A_Jump(50, "Jumpy");
		Goto See;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TNT1 A 0 A_SetScale(0.935, 0.65);
		WSPX G 20 Bright A_Scream;
		WSPX H 5 A_Explode(30, 200);
		WSPX IJKL 5 Bright A_Explode(30, 200);
		WSPX MN 5 A_NoBlocking(0);
		WSPX O 8 A_SpawnItemEx("RS_BigBadFire1", random(-32,32), random(-32,32));
		WSPX OOO 0 A_SpawnItemEx("RS_WhiteSPEXSplit2", 0, 0, random(8,56), random(0,3), random(0,3), random(0,3), random(0,64), SXF_NOCHECKPOSITION);
		WSPX O 0 A_NoBlocking;
		WSPX O -1;
		Stop;
	}
}

