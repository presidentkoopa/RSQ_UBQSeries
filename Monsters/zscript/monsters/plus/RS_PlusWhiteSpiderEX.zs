	Flares:
		WSPX C 8 Bright A_FaceTarget;
		WSPX E 2 Bright A_CustomMissile("RS_WhiteHotFlareL9", 42, random(-24,24), random(-1,1));
		WSPX EE 1 Bright A_CustomMissile("RS_WhiteHotFlareL9", 42, random(-24,24), random(-8,8));
