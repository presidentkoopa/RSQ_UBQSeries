class RS_WhiteCybieEXCore : RS_WhiteCybieEX   // CHP 17/17_WX:25441 (CommonWhiteCybieEX3)
{
	override void PostBeginPlay() { Super.PostBeginPlay(); RS_Zom.SetTier(self, 13); }
	override void Tick() { Super.Tick(); RS_PlusEX.Icon(self, 13); }
	Default
	{
		Species "Daikatana";
		Radius 24;
		Height 88;
		Health 3000;
		Speed 8;
		Painchance 32;
		Scale 0.75;
		Mass 99999;
		Seesound "rsplus/truromro";
		PainSound "brain/pain";
		DeathSound "brain/death";
		Activesound "rsplus/truromro";
		Monster;
		Obituary "You see %o,Daikatana will be the greatest game of all time.";
		tag "The one behind it all";
		+LAXTELEFRAGDMG
		+THRUACTORS
		+FLOORCLIP
		+BOSS
		-NOTARGET
		+DontHarmClass
		+Quicktoretaliate
		+thruspecies
		+Noicedeath
		+dontmorph
		-NORADIUSDMG
		+NOFEAR
	}
	States
	{
	Spawn:
		ROMR A 0 NoDelay;
		ROMR A 0;
		Goto Idle;
	Idle:
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.75, 0.85);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.8207, 0.8207);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.85, 0.75);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.8207, 0.6793);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.75, 0.65);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.6793, 0.6793);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.65, 0.75);
		ROMR A 1 A_Look;
		ROMR A 0 A_SetScale(0.6793, 0.8207);
		Loop;
	See:
		ROMR A 0 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_NOCHECKPOSITION);
		ROMR A 100 A_SpawnItemEx("RS_TeleportFog", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
	See2:
		ROMR A 0 { bFLOAT = false; }
		ROMR A 0 { bNOGRAVITY = false; }
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.75, 0.85);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.8207, 0.8207);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.85, 0.75);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.8207, 0.6793);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.75, 0.65);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.6793, 0.6793);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.65, 0.75);
		ROMR A 1 A_Chase;
		ROMR A 0 A_SetScale(0.6793, 0.8207);
		Loop;
	Missile:
		ROMR A 0 A_CheckFloor(1);
		Goto See2;
		ROMR A 0 A_Jump(128, "SuperBFG");
		ROMR A 0 A_TakeInventory("RS_DewzanToken", 99999);
		ROMR A 0 ThrustThingZ(0, 40, 0, 0);
		ROMR A 0 { bFLOAT = true; }
		ROMR A 0 { bNOGRAVITY = true; }
		ROMR A 10 Bright A_FaceTarget;
		ROMR A 0 A_JumpIfHealthLower(1000, "EvenMoreBFGS");
		ROMR A 0 A_JumpIfHealthLower(2000, "MoreBFGS");
	BFGS:
		ROMR A 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 0 A_GiveInventory("RS_DewzanToken", 1);
		ROMR A 0 A_JumpIfInventory("RS_DewzanToken", 4, "StopIt");
		Loop;
	MoreBFGS:
		ROMR AAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR AAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR AAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR AAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 0 A_GiveInventory("RS_DewzanToken", 1);
		ROMR A 0 A_JumpIfInventory("RS_DewzanToken", 5, "StopIt");
		Loop;
	EvenMoreBFGS:
		ROMR AAAAAAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR AAAAAAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR AAAAAAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR AAAAAAA 0 A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 5 Bright A_CustomMissile("RS_SpamShotsCguy", 32, 0, random(0,360), 32, random(-10,10));
		ROMR A 0 A_GiveInventory("RS_DewzanToken", 1);
		ROMR A 0 A_JumpIfInventory("RS_DewzanToken", 6, "StopIt");
		Loop;
	StopIt:
		ROMR A 0 { bFLOAT = false; }
		ROMR A 10 Bright { bNOGRAVITY = false; }
		Goto See2;
	SuperBFG:
		ROMR A 0 ThrustThingZ(0, 40, 0, 0);
		ROMR A 0 { bFLOAT = true; }
		ROMR A 0 { bNOGRAVITY = true; }
		ROMR AA 10 Bright A_FaceTarget;
		ROMR A 5 Bright A_CustomMissile("RS_ROMEROEXREALBFG", 32, 0, random(-10,10), 32, random(-10,10));
		ROMR A 0 { bFLOAT = false; }
		ROMR A 10 Bright { bNOGRAVITY = false; }
		Goto See2;
	Pain:
		ROMR B 2;
		ROMR B 2 A_Pain;
		Goto See2;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		ROMR B 4 Bright A_Scream;
		ROMR BBBBBBBBBBBBBBBBBBBBBBBBBBBBB 3 Bright A_CustomMissile("RS_HKRedDeath", random(20,70), random(-30,30), 0, CMF_AIMOFFSET, -10);
		ROMR BBBBBBBBBBBBBBBBBBBBBBBBBBBBB 1 Bright A_CustomMissile("RS_HKRedDeath", random(20,70), random(-30,30), 0, CMF_AIMOFFSET, -10);
		ROMR B 0 A_NoBlocking;
		ROMR B 0 A_BossDeath;
		ROMR B 0 A_SetTranslucent(1.0);
		ROMR B 0 A_SetScale(2, 2);
		MISL X 0 A_Playsound("weapons/rocklx", CHAN_5);
		MISL XYZ 4 Bright;
		MISL X 0 A_Playsound("weapons/rocklx", CHAN_5);
		MISL XYZ 4 Bright;
		MISL X 0 A_Playsound("weapons/rocklx", CHAN_5);
		MISL XYZ 4 Bright;
		TNT1 A 0 A_SpawnItemEx("RS_RandomLetterSpawner", 0, 0, 0, frandom(-7500,7500) / 1000, frandom(-7500,7500) / 1000, 0, 0, SXF_ABSOLUTEMOMENTUM| SXF_NOCHECKPOSITION, 184);
		TNT1 A -1;
		Stop;
	}
}

