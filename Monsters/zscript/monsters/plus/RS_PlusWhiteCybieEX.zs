class RS_ROMEROEXSpamShots : RS_SpamShotsRomeroCH   // CHP 17/17_WX:31508 (ROMEROEXSpamShots_C)
{
	Default
	{
		Speed 30;
		Projectile;
		species "Daikatana";
		SeeSound "weapons/bfgf";
		DeathSound "weapons/bfgx";
		Translation "0:148=176:176","160:167=112:112","224:231=231:231";
		+RANDOMIZE
		+Seekermissile
		+dontharmclass
		+Thruspecies
		+mthruspecies
		+dontharmspecies
	}
	States
	{
	Spawn:
		TNT1 A 0;
	Fly:
		BFS1 A 0 A_SetScale(frandom(0.1,2.0), frandom(0.1,2.0));
		BFS1 A 2 Bright a_spawnitemex("RS_ROMEROEXSpamShotsTrail", cos(pitch)*1, 0, 0-(sin(pitch)*1), cos(pitch)*1, 0, -sin(pitch)*1, SXF_NOCHECKPOSITION);
		BFS1 B 2 Bright a_seekermissile(6, 7);
		BFS1 A 0 A_Jump(32, 1);
		Loop;
		BFS1 A 0 A_custommissile("RS_ROMEROEXGlitchShot", 0, 0, random(0,360), 32, random(0,360));
		Loop;
	Death:
		BFE1 AB 8 Bright A_SetScale(frandom(0.1,4.0), frandom(0.1,4.0));
		BFE1 C 8 Bright A_Explode(random(25,80), 152);
		TNT1 A 0 A_screamandunblock;
		BFE1 DEF 8 Bright;
		Stop;
	}
}

