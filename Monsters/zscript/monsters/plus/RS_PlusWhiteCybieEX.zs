class RS_GlitchBaron : RS_CommonBaron   // CHP 17/17_WX:27727 (GlitchBaron_C)
{
	Default
	{
		Species "Daikatana";
		Speed 16;
		tag "baronbaronbaronbaronbaron";
		Obituary "%o was made into Romero's glitch.";
		+notrigger
		+noclip
		+dontharmclass
		+dontharmspecies
		+noinfighting
	}
	States
	{
	Spawn:
		BOS9 A 0 NoDelay;
		BOS9 AA 0 A_spawnitemex("RS_ROMEROEXGlitch2", random(-20,20), random(-20,20), random(0,64), 0, 0, 0, 0, SXF_SETMASTER);
	Idle:
		BOS9 AA 10 A_Look;
		Loop;
	See:
		BOS9 AAAAAAAA 3 A_Chase;
		Loop;
	Pain:
		BOS9 A 2;
		BOS9 A 2 A_Pain;
		Goto See;
	Melee:
	Missile:
		BOS9 AA 8 A_FaceTarget;
		BOS9 A 8 A_CustomComboAttack("RS_ROMEROEXGlitchShot", 32, 10 * random(1,8), "baron/melee");
		BOS9 AA 8 A_FaceTarget;
		BOS9 A 8 A_CustomComboAttack("RS_ROMEROEXGlitchShot", 32, 10 * random(1,8), "baron/melee");
		Loop;
	Tickles:
		Goto Death+1;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TNT1 A 0 A_GivetoChildren("RS_DewzanToken", 1);
		BOS9 A 8;
		BOS9 A 8 A_Scream;
		BOS9 A 8;
		BOS9 A 8 A_NoBlocking;
		BOS9 AA 8;
		BOS9 O -1 A_BossDeath;
		Stop;
	XDeath:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TNT1 A 0 A_GivetoChildren("RS_DewzanToken", 1);
		BOS9 A 0 A_Spawnitemex("RS_HKSplashDed", 0, 2, 47, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR);
		BOS9 A 0 a_stop;
		BOS9 A 8;
		TNT1 AAAAAAAAAAAAAAAA 0 A_Spawnparticle("Green", SPF_FULLBRIGHT | SPF_RELATIVE, random(27,74), random(1,13), frandom(0,360), 0, 0, 32, frandom(0.1,11.0), frandom(-0.15,0.25), frandom(-6.9,6.9), 0, 0, -0.1, 0.98, -1);
		TNT1 AAAAA 0;   // CHP: A_SpawnItemEx ("CHRandom_GibGenerator",0,0,18,VelX,VelY,VelZ,0,SXF_ABSOLUTEMOMENTUM | SXF_USEBLOODCOLOR | SXF_NOCHECKPOSITION) -- gore chain stripped (standing order), the frame stays
		HKGB B 0 A_Screamandunblock;
		HKGB B -1;
		Stop;
	Raise:
		BOS9 A 5 A_JumpIfInventory("RS_GrowRaisin", 1, "Grow");
		BOS9 AAAAAA 5;
		BOS9 I 0;
		BOS9 II 0 A_spawnitemex("RS_ROMEROEXGlitch2", random(-20,20), random(-20,20), random(0,64), 0, 0, 0, 0, SXF_SETMASTER);
		Goto See;
	Grow:
		Stop;
	}
}

