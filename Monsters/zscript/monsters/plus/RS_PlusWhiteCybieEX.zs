class RS_ROMEROEXShield : Actor   // CHP 17/17_WX:33144 (ROMEROEXShield_C)
{
	int user_angle;
	Default
	{
		Radius 88;
		Height 110;
		Speed 18;
		Species "Daikatana";
		health 999;
		Monster;
		RenderStyle "Add";
		Alpha 1.75;
		Scale 1.5;
		Translation "0:255=%[0.00,2.00,0.00]:[2.00,0.00,2.00]";
		+NOTRIGGER
		+NOTARGET
		+DONTTHRUST
		+nogravity
		+invulnerable
		+REFLECTIVE
		+deflect
		+shieldreflect
		+thruspecies
		+mthruspecies
		-countkill
	}
	States
	{
	Spawn:
		TNT1 A 0;
	Fly:
		TNT1 A 0 { user_angle = user_angle + 9; }
		CHSW Z 1 Bright A_Warp(AAPTR_MASTER, 128, 0, 8, user_angle + 9, WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE);
		TNT1 A 0 A_jumpIf(user_angle >= 3600, "Death");
		Loop;
	Death:
		TNT1 A 0 a_takeinventory("RS_RomeroCHProtect2", 1, 0, AAPTR_MASTER);
		CHSW Z 2 Bright A_NoBlocking;
		CHSW Z 2 Bright A_SetScale(1);
		CHSW Z 2 Bright A_SetScale(0.7);
		CHSW Z 2 Bright A_SetScale(0.4);
		TNT1 A 0 A_die;
		Stop;
	}
}

