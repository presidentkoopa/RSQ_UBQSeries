// RS_PlusSpectreEX.zs -- Colourful Hell Plus R3.0.1, ported to RSQ Monsters (2026-11-16). See RS_PlusEX.zs for the bodies,
// the naming, the conversion rules and what is stubbed. Generated by Monsters/tools/plus_ex/ (conv.py, drive.py, handfix.py), then edited by hand.

class RS_BlackSpectreEX : Actor   // CHP 07/07_KX:1 (CommonBlackSpectreEX2)
{
	int user_hm;
	override void PostBeginPlay() { Super.PostBeginPlay(); RS_Zom.SetTier(self, 12); }
	override void Tick() { Super.Tick(); RS_PlusEX.Icon(self, 12); }
	Default
	{
		Health 7250;
		Radius 20;
		Height 56;
		Mass 500;
		RenderStyle "Translucent";
		Alpha 0.45;
		Speed 20;
		PainChance 30;
		XScale 1.2;
		YScale 0.85;
		Monster;
		RadiusDamageFactor 0.5;
		DamageFactor "Melee", 2.5;
		DamageFactor "Heroic", 3.0;
		DamageFactor "DIMp", 0;
		PainChance "DIMp", 0;
		PainSound "Shadow/pain";
		DeathSound "Shadow/death";
		ActiveSound "Shadow/active";
		MeleeRange 64;
		MeleeThresHold 200;
		Obituary "%o was silenced by Black Spectre EX";
		Tag "THE BACKSTABBER UNSILENCED";
		+FLOORCLIP
		+dontmorph
		+Quicktoretaliate
		+LOOKALLAROUND
		+Boss
		-NORADIUSDMG
		+NOFEAR
	}
	States
	{
	Spawn:
		GKEX A 0 NoDelay;
		GKEX A 0;
		Goto Scripted;
	Scripted:
		GKEX A 0;
		GKEX A 0 A_Log("A chill runs down your spine");
		Goto Idle;
	Idle:
		GKEX AA 1 A_Look;
		Loop;
	Switch:
		GKEX A 0 A_JumpIfInventory("RS_DewzanToken", 1, "GotoMode1");
		Goto GotoMode2;
	GotoMode1:
		GKEX A 0 A_TakeInventory("RS_DewzanToken", 99999);
		Goto SeeMode1;
	GotoMode2:
		GKEX A 0 A_GiveInventory("RS_DewzanToken", 1);
		Goto SeeMode2;
	See:
		GKEX E 0 A_JumpIfInventory("RS_DewzanToken", 1, "SeeMode2");
		Goto SeeMode1;
	SeeMode1:
		GKEX A 0 A_SetTranslucent(0.45);
		GKEX A 0 A_SetSpeed(20);
		GKEX A 0 { bNOCLIP = false; }
		GKEX A 8 A_GivetoChildren("RS_GoAway", 1);
		GKEX A 0;
		GKEX A 0;
	SeeMode1B:
		GKEX BBB 1 A_Chase("Melee", "Missile", CHF_NOPLAYACTIVE);
		GKEX B 0 A_SpawnItemEx("RS_ShadowGhostEXB", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		GKEX CCC 1 A_Chase("Melee", "Missile", CHF_NOPLAYACTIVE);
		GKEX C 0 A_SpawnItemEx("RS_ShadowGhostEXC", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		GKEX DDD 1 A_Chase("Melee", "Missile", CHF_NOPLAYACTIVE);
		GKEX D 0 A_SpawnItemEx("RS_ShadowGhostEXD", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		GKEX EEE 1 A_Chase("Melee", "Missile");
		GKEX E 0 A_SpawnItemEx("RS_ShadowGhostEXE", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		GKEX E 0 A_Jump(8, "HMM");
		GKEX E 0 A_Jump(3, "Switch");
		Loop;
	SeeMode2:
		GKEX A 0 A_SetTranslucent(0.12);
		GKEX A 0 A_SetSpeed(12);
		GKEX A 0 { bNOCLIP = true; }
		GKEX A 8 A_GivetoChildren("RS_GoAway", 1);
	SeeMode2B:
		GKEX BBBCCCDDD 2 A_Chase("Melee", "Charge", CHF_NOPLAYACTIVE);
		GKEX EEE 2 A_Chase("Melee", "Charge");
		GKEX E 0 A_Jump(16, "HMM");
		GKEX E 0 A_Jump(6, "Switch");
		Loop;
	HMM:
		GKEX A 0 A_JumpIfCloser(1000, "See");
		GKEX A 0 A_jumpIf(user_hm>=10, "GETTO");
		GKEX A 0 { user_hm = user_hm+2; }
		Goto See;
	GETTO:
		GKEX A 20 A_Playsound("Shadow/pain", 7, 2, false, ATTN_NONE);
		GKEX A 0 A_warp(AAPTR_TARGET, -38, 0, 16, 0, WARPF_INTERPOLATE, "BACKSTABBUU");
		GKEX A 0 A_warp(AAPTR_TARGET, 0, -38, 16, 0, WARPF_INTERPOLATE, "BACKSTABBUU");
		GKEX A 0 A_warp(AAPTR_TARGET, 0, 38, 16, 0, WARPF_INTERPOLATE, "BACKSTABBUU");
		GKEX A 0 A_warp(AAPTR_TARGET, -38, 0, 16, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION, "GotoMode2");
		Goto See;
	BACKSTABBUU:
		GKEX A 5 Bright a_Facetarget;
		TNT1 AAAAAAAAAAA 0 A_Spawnparticle("Red", SPF_FULLBRIGHT|SPF_RELATIVE, random(27,74), random(1,13), frandom(0,360), 0, 0, 0, frandom(0.1,11.0), frandom(-0.15,0.25), frandom(-6.9,6.9), 0, 0, -0.1, 0.98, -1);
		GKEX F 15 Bright a_facetarget;
		GKEX G 5 A_CustomMeleeAttack(random(40,99), "Butcher/Melee", "none");
		GKEX F 5 Bright a_facetarget;
		GKEX G 5 A_CustomMeleeAttack(random(40,99), "Butcher/Melee", "none");
		GKEX G 0 { user_hm = user_hm+6; }
		Goto GetBackhere;
	Warp:
		GKEX A 8 { bNOPAIN = true; }
		GKEX A 0 { bNOCLIP = false; }
		GKEX A 0 A_SpawnItemEx("RS_ShadowWarpGhostEX", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_TRANSFERALPHA);
		GKEX A 0 { user_hm = user_hm+3; }
		TNT1 A 1 A_SetSpeed(99);
		TNT1 AAAAAAAAAAAAAAAA 0 A_Wander;
		TNT1 A 1 { bNOPAIN = false; }
		TNT1 A 0 A_Jump(128, "Switch");
		Goto See;
	Charge:
		GKEX A 0 A_JumpIfCloser(800, 1);
		Goto Missile;
		GKEX AA 8 A_FaceTarget;
		GKEX A 6 A_FaceTarget;
		GKEX A 2 A_ScaleVelocity(0.01);
		GKEX A 0 A_Playsound("Ice/Fly");
		GKEX A 0 A_Recoil(-48);
		GKEX A 0 ThrustThingZ(0, 30, 0, 0);
		Goto Melee;
	Melee:
		GKEX A 0 A_GivetoChildren("RS_GoAway", 1);
		GKEX A 0;
		GKEX A 0;
		GKEX A 0 A_SetTranslucent(0.45);
		GKEX FG 3 A_FaceTarget;
		GKEX H 2 A_CustomMeleeAttack(random(40,99), "Obsidian/Melee", "none");
	GetBackhere:
		GKEX H 0 A_Jump(64, 1);
		Goto See;
		GKEX H 0 A_JumpIfCloser(200, "Missile");
		GKEX H 0 A_JumpIfCloser(500, "Charge");
		Goto Missile;
	Missile:
		SHDW A 0 A_Jump(200, "Standard", "Charge");
		Goto DarkBeam;
	Standard:
		GKEX A 6 A_FaceTarget;
		GKEX F 4 A_FaceTarget;
		GKEX GGGGGGGG 2 Bright A_CustomMissile("RS_ShadowBallEX1", 32, 0, random(-30,30));
		GKEX F 4 A_FaceTarget;
		GKEX A 0 A_Jump(82, "BigOne");
		GKEX A 0 A_Jump(64, "Warp");
		Goto See;
	BigOne:
		GKEX A 6 A_FaceTarget;
		GKEX F 4 A_FaceTarget;
		GKEX G 8 Bright A_CustomMissile("RS_ShadowSpiralEX", 32, 0, random(-30,30));
		GKEX F 8 A_FaceTarget;
		GKEX A 0 A_Jump(64, "Warp");
		Goto See;
	DarkBeam:
		GKEX A 6 A_FaceTarget;
		GKEX F 4 A_FaceTarget;
		GKEX GGGGGGGG 1 Bright A_CustomMissile("RS_ShadowDarkBeamEX", 32);
		GKEX G 0 A_FaceTarget;
		GKEX GGGGGGGG 1 Bright A_CustomMissile("RS_ShadowDarkBeamEX", 32);
		GKEX G 0 A_FaceTarget;
		GKEX GGGGGGGG 1 Bright A_CustomMissile("RS_ShadowDarkBeamEX", 32);
		GKEX G 0 A_FaceTarget;
		GKEX GGGGGGGG 1 Bright A_CustomMissile("RS_ShadowDarkBeamEX", 32);
		GKEX F 8 A_FaceTarget;
		GKEX A 0 A_Jump(64, "Warp");
		Goto See;
	Pain:
		GKEX H 4;
		GKEX H 4 A_Pain;
		GKEX H 0 A_Jump(88, "Warp");
		Goto See;
	Death.Ice:
	Death:
		GKEX N 0 A_GivetoChildren("RS_GoAway", 1);
		GKEX NNNNNNNNNNNNNNNN 0 A_SpawnItemEX("RS_ShadowDeathGhostEX", 0, 0, 4, frandom(-3,3), frandom(-3,3), 1, 0, SXF_NOCHECKPOSITION);
		GKEX N 12;
		GKEX O 12 A_Scream;
		GKEX P 13;
		GKEX Q 13 A_Fall;
		GKEX RS 13;
		TNT1 A 0 A_SpawnItemEx("RS_RandomLetterSpawner", 0, 0, 0, frandom(-7500,7500) / 1000, frandom(-7500,7500) / 1000, 0, 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION, 220);
		GKEX T -1;
		Stop;
	Raise:
		Stop;
	}
}

