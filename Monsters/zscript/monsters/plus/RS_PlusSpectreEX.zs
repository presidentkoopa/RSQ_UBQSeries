// STUBBED (owner 2026-11-16: no Abyss-style screen darkening). CHP 07/07_KX:4982 (DarknessTokenBlackSpectreEX) is a Powerup
// with Powerup.Color "00 00 00",0.5 and A_Light(-20/-30/-25) on pickup: it darkens the player's screen.
// Here it is an item no one can hold (MaxAmount 0): every give is refused, every take finds nothing.
class RS_DarknessTokenBlackSpectreEX : Inventory
{
	Default
	{
		Inventory.MaxAmount 0;
		+INVENTORY.UNDROPPABLE
	}
}

