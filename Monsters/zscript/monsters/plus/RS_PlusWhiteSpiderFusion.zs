		TNT1 A 0 A_setspeed(28);
		TNT1 A 0 { bNOPAIN = false; }
		Goto See;
	Pain:
		TRIT F 3;
		TRIT F 6 A_Pain;
		Goto See;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TRIT G 12 A_Screamandunblock;
		TRIT HIJ 10;
		TRIT H 0 A_BossDeath;
		MISL XYZ 10;
