		LMWX QRSTUQRSTUQRSTU 4 Bright A_VileTarget("RS_TIMESTEALMOT");
		LMWX U 0 { RS_PlusEX.WVileTimer(self); }
		LMWX U 40 Bright { RS_PlusEX.WVileTimer2(self); }
		LMWX A 0 { user_hoho = 1; }
		LMWX E 2 { user_courage = user_courage-150; }
		LMWX A 0 { bNOPAIN = false; }
		Goto CloneofTime;
	TIMESUP:
		LMWX A 0 A_GiveInventory("RS_TimeSlowMOT2", 1);
		LMWX A 0 A_GiveInventory("RS_TimeSlowMOT3", 1, AAPTR_TARGET);
		LMWX A 0 A_ScaleVelocity(0, AAPTR_TARGET);
		LMWX A 0 A_playsound("Forgotten/Attack", 0, 255, 0, 0);
		LMWX A 0 { bNOPAIN = true; }
		LMWX A 0 { bVISIBILITYPULSE = false; }
		LMWX A 0 A_GivetoChildren("RS_GoAway", 1);
		LMWX A 1 Bright A_SetTranslucent(0.75, 1);
		LMWX A 1 Bright A_SetTranslucent(0.5, 1);
		LMWX A 1 Bright A_SetTranslucent(0.25, 1);
		LMWX A 1 Bright A_SetTranslucent(0.25, 1);
		LMWX A 10 Bright A_SetTranslucent(0.01, 1);
		LMWX A 10 Bright A_Warp(AAPTR_TARGET, -80, 0, 0, random(0,360), WARPF_NOCHECKPOSITION);
		LMWX A 0 { bVISIBILITYPULSE = true; }
		LMWX A 0 A_GivetoChildren("RS_GoAway", 1);
		LMWX A 0;
		LMWX A 0;
		LMWX A 0 A_SpawnitemEx("RS_FaceMOT", 4, 4, 84, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX A 0 A_SpawnitemEx("RS_EffectMOT", 4, 4, 80, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX A 1 Bright A_SetTranslucent(0.25, 1);
		LMWX A 1 Bright A_SetTranslucent(0.5, 1);
		LMWX A 1 Bright A_SetTranslucent(0.75, 1);
		LMWX A 1 Bright A_SetTranslucent(1, 1);
		LMWX A 0 A_SpawnItemEX("RS_OldTimeyMOT", 0, 0, 16, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
		LMWX A 0 A_Playsound("rsplus/time02");
		LMWX A 5 Bright A_FaceTarget;
		LMWX A 0 A_Playsound("rsplus/puzslv");
	TIMESUP2:
		LMWX AAAA 2 Bright A_CustomMissile("RS_TimeShockMOT", 42, 0, random(-10,10));
		LMWX A 0 A_GiveInventory("RS_TimeSlowMOT2", 1);
		LMWX A 0 A_GiveInventory("RS_TimeSlowMOT3", 1, AAPTR_TARGET);
		LMWX A 0 A_CheckFlag("CORPSE", "Idle", AAPTR_TARGET);
		Loop;
	Pain:
		LMWX A 0 { bVISIBILITYPULSE = true; }
		LMWX A 0 A_GivetoChildren("RS_GoAway", 1);
		LMWX A 0;
		LMWX A 0;
		LMWX A 0 A_SpawnitemEx("RS_FaceMOT", 4, 4, 84, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX A 0 A_SpawnitemEx("RS_EffectMOT", 4, 4, 80, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX I 3 A_SetTranslucent(1, 1);
		LMWX E 0 { user_courage = user_courage+5; }
		LMWX I 5 A_Pain;
		Goto Whatthe;
	whatthe:
		LMWX F 1 { bVISIBILITYPULSE = false; }
		LMWX A 0 A_GivetoChildren("RS_GoAway", 1);
		LMWX F 1 A_SetTranslucent(0.66, 1);
		LMWX F 1 A_SetTranslucent(0.33, 1);
		LMWX F 1 A_SetTranslucent(0.01, 1);
		LMWX EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 1 A_wander;
		LMWX A 0 { bVISIBILITYPULSE = true; }
		LMWX A 0 A_GivetoChildren("RS_GoAway", 1);
		LMWX A 0;
		LMWX A 0;
		LMWX A 0 A_SpawnitemEx("RS_FaceMOT", 4, 4, 84, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX A 0 A_SpawnitemEx("RS_EffectMOT", 4, 4, 80, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX F 1 A_SetTranslucent(0.5, 1);
		LMWX F 1 A_SetTranslucent(1, 1);
		LMWX E 0 { user_courage = user_courage-15; }
		LMWX F 4 A_stop;
		Goto Clippy;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
