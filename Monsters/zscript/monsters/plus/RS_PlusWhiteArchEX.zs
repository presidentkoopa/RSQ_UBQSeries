class RS_WhiteArchEXClone : RS_WhiteArchEX   // CHP 14/14_WX:6934 (CommonWhiteArchEX3)
{
	override void PostBeginPlay() { Super.PostBeginPlay(); RS_Zom.SetTier(self, 13); }
	override void Tick() { Super.Tick(); RS_PlusEX.Icon(self, 13); }
	Default
	{
		Health 500;
		Deathsound "wizard/death";
		DropItem "RS_CH_Berserk";
		DropItem "BackPack";
		DropItem "RS_BackPackBundle";
		-BOSS
		MissileChanceMult 1.0;   // CHP: -MISSILEMORE
	}
	States
	{
	Spawn:
		LMWX E 0 NoDelay;
		LMWX E 0;
		LMWX E 0 A_SpawnitemEx("RS_FaceMOT", 4, 4, 84, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX E 0 A_SpawnitemEx("RS_EffectMOT", 4, 4, 80, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		Goto Scripted;
	Scripted:
		LMWX E 0 A_SetSize(20, 80, 1);
		Goto Idle;
	Missile:
		LMWX A 0 { bVISIBILITYPULSE = true; }
		LMWX A 0 A_GivetoChildren("RS_GoAway", 1);
		LMWX A 0;
		LMWX A 0;
		LMWX A 0 A_SpawnitemEx("RS_FaceMOT", 4, 4, 84, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX A 0 A_SpawnitemEx("RS_EffectMOT", 4, 4, 80, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER);
		LMWX A 0 A_SetTranslucent(1, 1);
		LMWX E 0 A_JumpIf(user_hoho>=1, "EyeofTime2");
	Choices:
		LMWX A 0 A_JumpifCloser(1000, "Choices2", true);
		LMWX A 0 A_Jump(256, "Choices1");
		Goto Clippy;
	Choices1:
		LMWX A 0 A_Jump(256, "ScreamofTime", "RailofTime");
		Goto Clippy;
	Choices2:
		LMWX A 0 A_Jump(256, "BoltsofTime", "RingsofTime", "EyeofTime");
		Goto Clippy;
	CloneofTime:
	ShouldI:
	ENDOFTIME:
	TIMESUP:
	TIMESUP2:
		Goto Clippy;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TNT1 A 0 A_radiusgive("RS_GoAway", 320, RGF_MISSILES|RGF_NOSIGHT, 100);
		TNT1 A 0 { bVISIBILITYPULSE = false; }
		LMWX J 6 A_Scream;
		TNT1 A 0 a_killchildren("extreme", KILS_FOILINVUL|KILS_KILLMISSILES);
		LMWX K 6 A_NoBlocking;
		LMWX LMNO 6;
		LMWX P -1;
		Stop;
	}
}

