		W5PD AABBCCDD 1 A_wander;
		Goto see+5;
	See3:
		W5PD A 0 A_JumpIf(user_everlasting>0, "Camoflosh");
		W5PD AABBCCDD 1 A_wander;
		Goto Flying+6;
	Camoflosh:
