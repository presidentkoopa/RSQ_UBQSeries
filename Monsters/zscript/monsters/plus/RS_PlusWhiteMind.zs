class RS_OrbOfChaos : Actor   // CHP 16/16_W:15292 (OrbOfChaos_C)
{
	int user_devilorb;
	Default
	{
		Health 2000;
		DamageFactor "Heroic",3.0;
		DamageFactor "DIMp",0;
		Radius 40;
		Height 80;
		Mass 0x7FFFFFFF;
		Species "MMind";
		PainChance 96;
		PainSound "rsplus/spmfx1";
		DeathSound "monster/hadexp";
		XScale 1.25;
		YScale 0.001;
		Monster;
		Tag "Everlasting Machine";
		-COUNTKILL
		+FLOORCLIP
		+DONTHARMSPECIES   // CHP: +DONTHURTSPECIES (its deprecated name)
		+LOOKALLAROUND
		+Thruspecies
		+NOTARGET
		+NOBLOOD
		-Noradiusdmg
		MissileChanceMult 0.125;   // CHP: +MISSILEEVENMORE
	}
	States
	{
	Spawn:
		CHA0 A 3 Bright;
		CHA0 A 0 { user_devilorb = 2800; }
		CHA0 A 0 A_Playsound("SYNTPORT", 0, 255, 0, 0);
		CHA0 A 3 Bright A_SetScale(1.25, 0.125);
		CHA0 A 3 Bright A_SetScale(1.25, 0.375);
		CHA0 A 3 Bright A_SetScale(1.25, 0.625);
		CHA0 A 3 Bright A_SetScale(1.25, 0.875);
		CHA0 A 3 Bright A_SetScale(1.25, 1.125);
		CHA0 A 3 Bright A_SetScale(1.25, 1.25);
		Goto Stay;
	Stay:
		CHA0 A 0 A_JumpIf(user_devilorb>=3150, "Summon");
		CHA0 AAAABBBBCCCCDDDDCCCCBBBBAAAA 2 Bright { user_devilorb = user_devilorb+1; }
		Loop;
	Summon:
		CHA0 A 0 { bNOPAIN = true; }
		CHA0 A 0 A_Playsound("rsplus/spmsummn", 0, 255, 0, 0);
		CHA0 ABCDCB 5 Bright;
		CHA0 ABCDCB 3 Bright;
		CHA0 ABCDCB 2 Bright;
		CHA0 ABCDCBABCDCBABCDCB 1 Bright;
		CHA0 A 0 A_SpawnItemEx("RS_ChaosSummons", random(-24,24), random(-24,24), 6, 0, 0, 0, 0, 128);
		CHA0 A 0 { user_devilorb = 0; }
		CHA0 A 0 { bNOPAIN = false; }
		Goto Stay;
	Pain:
		CHA0 A 0 A_SetScale(1.25, 1.25);
		CHA0 E 2 Bright A_Pain;
		Goto Stay;
	Death:
		CHA0 A 0 A_SetScale(1.25, 1.25);
		CHA0 EFGH 6 Bright;
		CHA0 I 6 A_Scream;
		CHA0 JKL 6 Bright;
		CHA0 A 0 A_NoBlocking;
		CHA0 M 99;
		Goto FadeOut;
	FadeOut:
		CHA0 M 20 A_FadeOut(0.2);
		Loop;
	}
}

