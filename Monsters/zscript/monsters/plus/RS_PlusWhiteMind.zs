	States
	{
	Spawn:
		W5PD A 0 NoDelay;
		W5PD A 0 A_Playsound("rsplus/reactor1", CHAN_7, 1, 1);
		Goto Scripted;
	Scripted:
		W5PD A 0;
		Goto Idle;
	Idle:
		W5PD AB 10 A_Look;
		Loop;
	See:
		TNT1 A 0 A_GivetoChildren("RS_NoMoreFlight", 1);
		W5PD F 0 A_StopSound(CHAN_6);
		W5PD F 0 A_TakeInventory("RS_FlightToken", 1);
		W5PD F 0 { bFLOAT = false; }
		W5PD F 15 { bNOGRAVITY = false; }
		W5PD AABBCCDD 2 A_Chase;
		W5PD A 0 HealThing(4, 20000);
		TNT1 A 0 A_jump(40, "Dodge1");
		TNT1 A 0 A_jump(40, "FlyingCheck", "See2");
		Goto See+5;
	FlyingCheck:
		W5PD A 0 A_JumpIfHealthLower(13000, "Flying");
		Goto See+5;
	Flying:
		W5PD F 0 A_GiveInventory("RS_FlightToken", 1);
		W5PD F 0 ThrustThingZ(0, 42, 0, 1);
		W5PD F 0 { bFLOAT = true; }
		W5PD F 15 { bNOGRAVITY = true; }
