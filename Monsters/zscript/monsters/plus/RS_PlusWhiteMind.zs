		RED9 AAAABBBB 1 Bright A_SpawnItemEx("RS_WhiteSpidChaosTrail", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_TRANSFERSTENCILCOL);
		Loop;
	Death:
		BLL9 A 0 A_SetScale(3, 3);
		BLL9 CDE 6 Bright;
		TNT1 A 0 A_SpawnItemEx("RS_OrbOfChaos", 0, 0, 0, 0, 0, 0, 0, 128);
		Stop;
	}
}

