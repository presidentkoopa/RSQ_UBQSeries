		W5PD EE 0 A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, 24, random(-64,64), 32, random(-5,5));
		W5PD E 0 A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, -24, random(-64,64), 32, random(-5,5));
		W5PD E 2 Bright A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, -24, random(-64,64), 32, random(-5,5));
		W5PD FF 0 A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, 24, random(-64,64), 32, random(-5,5));
		W5PD F 0 A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, -24, random(-64,64), 32, random(-5,5));
		W5PD F 2 Bright A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, -24, random(-64,64), 32, random(-5,5));
		W5PD EE 0 A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, 24, random(-64,64), 32, random(-5,5));
		W5PD E 0 A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, -24, random(-64,64), 32, random(-5,5));
		W5PD E 2 Bright A_CustomMissile("RS_WHITEMINDWEBSHOT", 40, -24, random(-64,64), 32, random(-5,5));
		Goto Check;
	CHAOSCHAOS:
		W5PD F 0 A_JumpIf(user_chaotic>0, "Missile");
		W5PD F 0 A_JumpIf(2 == 2, 1);
		Goto Missile;
		W5PD F 0 A_Playsound("WMINDAGR", CHAN_5);
		W5PD FE 8 Bright A_facetarget;
		W5PD F 0 { user_chaotic = user_chaotic+12; }
		W5PD F 0 A_CustomMissile("RS_WhiteSpidChaosBall", 40, 0, random(0,360), 2, 12);
		W5PD FFFFEEEE 2 A_SetAngle(45+angle);
		Goto Check;
	IAMEVERLASTING:
		W5PD F 9 Bright Radius_Quake(180, 90, 0, 900, 0);
		W5PD E 12 Bright A_Playsound("rsplus/wmindrag", 0, 255, 0, 0);
		W5PD F 3 Bright { user_everlasting = 1; }
		W5PD E 3;   //A_Setuservar("user_camo",user_camo=0)
		W5PD F 3 Bright A_SetSpeed(36);
		W5PD EF 3 Bright;
		W5PD F 0 A_JumpIfInventory("RS_FlightToken", 1, "EyeBeam");
		Goto FloorCrack;
	Death.Ice:
	Death:
		TNT1 A 0 A_GivetoChildren("RS_GoAway", 1);
		TNT1 A 0 A_GivetoChildren("RS_NoMoreFlight", 1);
		W5PD F 0 { bFLOAT = false; }
		W5PD F 0 { bNOGRAVITY = false; }
		W5PD F 0 A_StopSound(CHAN_6);
		W5PD F 10 A_NoBlocking;
		W5PD FABDF 10 Bright A_CustomMissile("RS_HKRedDeath", random(20,100), random(-60,60), 0, CMF_AIMOFFSET, -10);
		W5PD AFDCF 8 Bright A_CustomMissile("RS_HKRedDeath", random(20,100), random(-60,60), 0, CMF_AIMOFFSET, -10);
		W5PD BFDCD 3 Bright A_CustomMissile("RS_HKRedDeath", random(20,100), random(-60,60), 0, CMF_AIMOFFSET, -10);
		W5PD FFFFFFFFFFF 1 Bright A_CustomMissile("RS_HKRedDeath", random(20,100), random(-60,60), 0, CMF_AIMOFFSET, -10);
		W5PD F 0 A_StopSound(CHAN_7);
		W5PD F 20 A_Scream;
		W5PD F 0 A_killmaster("extreme", KILS_FOILINVUL|KILS_KILLMISSILES);
		W5PD F 1 A_BossDeath;
		W5PD F 0 A_SetTranslucent(1.0);
		W5PD F 0 A_SetScale(2, 2);
		W5PD F 0 A_Playsound("weapons/rocklx", CHAN_5);
		MISL XYZ 4 Bright;
		MISL X 0 A_Playsound("weapons/rocklx", CHAN_5);
		MISL XYZ 4 Bright;
		MISL X 0 A_Playsound("weapons/rocklx", CHAN_5);
		MISL XYZ 4 Bright;
		TNT1 A 0 A_SpawnItemEx("RS_RandomLetterSpawner", 0, 0, 0, frandom(-7500,7500) / 1000, frandom(-7500,7500) / 1000, 0, 0, SXF_ABSOLUTEMOMENTUM| SXF_NOCHECKPOSITION, 220);
		TNT1 A -1;
		Stop;
	}
}

class RS_ESPlasmaRocket : Actor   // CHP 16/16_W:12667 (ESPlasmaRocket_C)
{
	Default
	{
		Radius 13;
		Height 9;
		Speed 1;
		DamageFunction (random(20,200));   // CHP: Damage (random(20,200))
		DamageType "Plasma";
		Projectile;
		Species "MMind";
		xscale 1.3;
		yscale 0.85;
		SeeSound "weapons/hominglaunch";
		DeathSound "weapons/rocklx";
		Translation "48:159=%[0.00,0.00,0.00]:[1.01,1.01,1.01]","0:15=%[0.00,0.00,0.00]:[1.01,1.01,1.01]","16:47=%[0.00,0.19,0.25]:[0.50,1.63,2.00]","160:255=%[0.00,0.19,0.25]:[0.50,1.63,2.00]";
		+RANDOMIZE
		+DEHEXPLOSION
		+mthruspecies
	}
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_ScaleVelocity(random(20,60));
	Fly:
		MISL A 1 Bright a_spawnitemex("RS_ESPlasmaRocketTrail", cos(pitch)*1, 0, 0-(sin(pitch)*1), cos(pitch)*1, 0, -sin(pitch)*1, SXF_NOCHECKPOSITION);
		MISL AA 1 Bright A_Weave(3, 0, 3, 0);
		Loop;
	Death:
		MISL B 0 A_SetTranslucent(0.75, 1);
		MISL BBBBBBBB 0 A_SpawnItemEx("RS_ESFlyParticle", 0, 0, 0, frandom(-7,7), frandom(-7,7), frandom(-7,7), 0, 128);
		MISL B 4 Bright A_Explode(random(80,180), 88);
		MISL CD 4 Bright;
		Stop;
	}
}

