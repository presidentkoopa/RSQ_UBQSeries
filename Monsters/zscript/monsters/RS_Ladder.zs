// ============================================================================
// RS_Ladder -- the ladder system (design/LADDER_SYSTEM.md, test branch
// wip/2026-11-13-ladder-system). Everything here is behind ONE switch,
// rsq_mon_ladder (default off): with it off nothing below runs and the game
// plays as main does.
//
// What it does for ColorfulHell's monsters (Select Monster Set = ColorfulHell):
//   point 1  the spawn mix is the SLIDING WINDOW around the world tier
//            (rsq_mon_worldtier): the centre colour weighs 1, colours below
//            0.55 a step, colours above 0.30 a step, Black / White / EX x0.15
//            until the centre reaches them. Every colour, extras included.
//   point 2  Black and White are boss-grade: 1.25x and 1.5x the family's Abyss.
//   point 3  EX is its own rung (14) above White; an EX body is never swapped
//            down to the plain White (RS_Retier.Swap).
//   point 5  ladder health: the family's running maximum x1.05 a step, two
//            steps kept (the Gray Lost Soul hive; the Cyan zombie trio, which
//            the window spawns as three bodies like ColorfulHell's own gate).
//   point 7  the tier's own colour wins over Champions' and Universal
//            Entropy's tints for the monster's first two seconds (RS_LadderTint).
// Numbers: RS_LadderData.zs, generated by design/tiering/tools/gen_ladder_zs.py.
// Family numbers here are RS_RosterHandler.FamilyId's (ZombieMan 0 ...); the
// class table RS_TierLadder.ClassFor has its own order, mapped by the dial.
// ============================================================================

class RS_Ladder play
{
	static bool On()
	{
		let cv = CVar.FindCVar('rsq_mon_ladder');
		return cv && cv.GetBool();
	}

	static int WorldTier()
	{
		let cv = CVar.FindCVar('rsq_mon_worldtier');
		return cv ? clamp(cv.GetInt(), 1, 40) : 1;
	}

	// RS_RosterHandler family -> RS_TierLadder family (same dial)
	static int TLFam(int fam)
	{
		Name d = RS_RosterHandler.CHDial(fam);
		for (int g = 0; g < RS_TierLadder.FamilyCount(); g++)
			if (RS_TierLadder.DialOf(g) == d) return g;
		return -1;
	}

	static bool HasEX(int fam) { return RS_LadderData.EXClass(fam) != 'None'; }

	// The class for a rung: 1-13 the ladder's class, 14 the family's EX build (White where it has none).
	static Name ClassForRung(int fam, int rung)
	{
		if (rung >= 14)
		{
			if (HasEX(fam)) return RS_LadderData.EXClass(fam);
			rung = 13;
		}
		int g = TLFam(fam);
		return g < 0 ? 'None' : RS_TierLadder.ClassFor(g, clamp(rung, 1, 13));
	}

	// Point 1: the sliding window. Weights x1000 so the roll is an integer.
	static int WindowWeight(int centre, int rung)
	{
		double w = 1.0;
		if (rung < centre) w = 0.55 ** (centre - rung);
		else if (rung > centre) w = 0.30 ** (rung - centre);
		if (rung >= 12 && centre < rung) w *= 0.15;
		return int(w * 1000000.0);
	}

	static int Roll(int fam)
	{
		int top = HasEX(fam) ? 14 : 13;
		int c = clamp(WorldTier(), 1, top);
		int total = 0;
		for (int r = 1; r <= top; r++) total += WindowWeight(c, r);
		int roll = random[RSLadder](0, max(0, total - 1));
		for (int r = 1; r <= top; r++)
		{
			roll -= WindowWeight(c, r);
			if (roll < 0) return r;
		}
		return c;
	}

	static RS_LadderHandler H() { return RS_LadderHandler(EventHandler.Find('RS_LadderHandler')); }
}

// Point 7: holds the tier's own colour against tints laid on after the spawn (Universal Entropy's random recolour
// at spawn, Champions' on its first tic). Two seconds, then it leaves. Steps aside while a tier change flashes.
class RS_LadderTint : Inventory
{
	int left;
	bool haveWant;
	TranslationID want;

	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
	}

	override void DoEffect()
	{
		super.DoEffect();
		let o = owner;
		if (!o || o.health <= 0 || --left <= 0) { Destroy(); return; }
		if (RS_Retier.JobFor(o)) return;                 // a tier flash owns the colour
		if (!haveWant)
		{
			// a Brutal Doom / XMVE monster on the ladder: its kit's tint; anything else: its class's own look
			let k = RS_BDKit.Of(o);
			if (k && k.rung > k.entry) o.A_SetTranslation(RS_BDKit.TintName(k.Tier()));
			else o.Translation = GetDefaultByType(o.GetClass()).Translation;
			want = o.Translation;
			haveWant = true;
			return;
		}
		if (o.Translation != want) o.Translation = want;
	}
}

class RS_LadderTrioMark : Inventory
{
	Default { Inventory.MaxAmount 1; +INVENTORY.UNDROPPABLE +INVENTORY.UNTOSSABLE }
}

class RS_LadderHandler : EventHandler
{
	bool swapping;              // RS_Retier.Swap is spawning a new body: not a map spawn (no trio)
	private Array<Name> cName;
	private Array<int>  cVal;   // fam * 100 + rung; -1 not a ColorfulHell ladder class

	override void OnRegister() { SetOrder(1000); }   // after the other handlers' WorldThingSpawned (Universal Entropy)

	private int Lookup(Name n)
	{
		int i = cName.Find(n);
		if (i < cName.Size()) return cVal[i];
		int v = -1;
		for (int f = 0; f < 17 && v < 0; f++)
		{
			if (RS_LadderData.EXClass(f) == n) { v = f * 100 + 14; break; }
			int g = RS_Ladder.TLFam(f);
			if (g < 0) continue;
			for (int t = 1; t <= 13; t++)
				if (RS_TierLadder.ClassFor(g, t) == n) { v = f * 100 + t; break; }
		}
		cName.Push(n);
		cVal.Push(v);
		return v;
	}

	override void WorldThingSpawned(WorldEvent e)
	{
		let a = e.Thing;
		if (!a || !a.bISMONSTER || !RS_Ladder.On()) return;

		// point 7, every monster on the ladder (ColorfulHell, and Brutal Doom / XMVE ones carrying a kit)
		let v = Lookup(a.GetClassName());
		if (v >= 0 || RS_BDKit.Of(a))
		{
			let tn = RS_LadderTint(a.GiveInventoryType('RS_LadderTint'));
			if (tn) tn.left = 70;
		}
		if (v < 0) return;
		int fam = v / 100, rung = v % 100;

		// points 2, 3, 5: the ladder's health for this rung, as a ratio so other mods' own changes stay
		int lh = RS_LadderData.HP(fam, rung);
		int def = GetDefaultByType(a.GetClass()).health;
		if (lh > 0 && def > 0 && lh != def)
		{
			a.StartHealth = lh;
			a.health = max(1, int(a.health * double(lh) / double(def)));
		}

		// point 5, the kept Cyan zombie step: the window spawns the trio, like ColorfulHell's own gate
		// (RS_CyanZombie, RS_Zombieman.zs:90-92). Not for a tier change's new body.
		// The two it adds carry RS_LadderTrioMark so they never add two more (WorldThingSpawned may come after the spawn
		// returns, so a depth counter alone is not enough: the first rig run of this multiplied without end).
		if (fam == 0 && rung == 5 && !swapping && !a.FindInventory('RS_LadderTrioMark'))
		{
			a.GiveInventoryType('RS_LadderTrioMark');
			for (int i = 0; i < 2; i++)
			{
				bool ok; Actor b;
				[ok, b] = a.A_SpawnItemEx(a.GetClassName(), 0, 0, 0, 2, 0, 1, i == 0 ? 90 : 180, SXF_NOCHECKPOSITION | SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG);
				if (b) b.GiveInventoryType('RS_LadderTrioMark');
			}
		}
	}

	// rs_ladder_count: every monster on the map by family and rung (the rig's evidence)
	override void NetworkProcess(ConsoleEvent e)
	{
		if (e.Name != 'rs_ladder_count') return;
		int n[255];
		for (int i = 0; i < 255; i++) n[i] = 0;
		int other = 0, total = 0;
		let it = ThinkerIterator.Create('Actor');
		Actor a;
		while (a = Actor(it.Next()))
		{
			if (!a.bISMONSTER || a.health <= 0) continue;
			int v = Lookup(a.GetClassName());
			if (v < 0) { if (a.bCOUNTKILL) other++; continue; }
			n[(v / 100) * 15 + v % 100]++;
			total++;
		}
		Console.Printf("LADDER: on %d world %d ladder monsters %d other counted %d", RS_Ladder.On(), RS_Ladder.WorldTier(), total, other);
		String row = "LADDER: rungs";
		for (int r = 1; r <= 14; r++)
		{
			int s = 0;
			for (int f = 0; f < 17; f++) s += n[f * 15 + r];
			row = row .. String.Format(" %d:%d", r, s);
		}
		Console.Printf("%s", row);
		it = ThinkerIterator.Create('Actor');
		while (a = Actor(it.Next()))
		{
			if (!a.bISMONSTER || a.health <= 0) continue;
			int v = Lookup(a.GetClassName());
			if (v < 0) continue;
			Console.Printf("LADDER: %s fam %d rung %d hp %d/%d start %d def %d look %s", a.GetClassName(), v / 100, v % 100,
				a.health, a.GetSpawnHealth(), a.StartHealth, GetDefaultByType(a.GetClass()).health,
				a.Translation == GetDefaultByType(a.GetClass()).Translation ? "own" : "other");
		}
	}
}
