// Every sprite name above, in a state, so the engine registers it (sprites are only loaded for names a state uses;
// RSQ Grenade's RSQGN_BarrelSprites and bar.zs do the same). Never spawned.
class RSQVR_BeamSprites : Actor
{
	States
	{
	Spawn:
		QVBM A 0; QVR1 A 0; QVR2 A 0; QVR3 A 0; QVDS A 0; QVSP A 0; QVLK A 0; QVFL A 0; QVZD A 0; QVC2 A 0; QVC1 A 0; QVC0 A 0; QVSK A 0;
		Stop;
	}
}
