// RSQ FnF -- THE FLASHLIGHT's models (tools/gen_torch.py; zscript/rsqff/torch.zs). A lump of its own beside MODELDEF.txt.

// IN THE OFF HAND (RSQFF_Torch): the flashlight baked in Brutal Doom 22 VR Reloaded's shotgun pump / forend support hand
// (fbx_s192_L.md3 frame 1, moved so its gripped cylinder sits where the flare's hold grips; tools/gen_torch.py), in MODEL
// SLOT 7 with Skin 7 "fbx_hand.png" so BD22 VR's Hand Skin Tone tones it. Scale / Offset are BD22 VR's own off-hand block's
// (its RSQ_Hands draws this same mesh with them), as the flare's are. Surfaces of torch_h.md3: 0 body, 1 lens, 2 glow.
// A in the hand
Model RSQFF_Torch
{
	Path "models/rsqff"
	Model 0 "torch_h.md3"
	SurfaceSkin 0 0 "torch.png"
	SurfaceSkin 0 1 "torchlens.png"
	SurfaceSkin 0 2 "clear.png"
	Model 7 "rsqff_pumphand.md3"
	Skin 7 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex QFFT A 0 0
	FrameIndex QFFT A 7 0
}
// C no hand drawn (Show Hand off)
Model RSQFF_Torch
{
	Path "models/rsqff"
	Model 0 "torch_h.md3"
	SurfaceSkin 0 0 "torch.png"
	SurfaceSkin 0 1 "torchlens.png"
	SurfaceSkin 0 2 "clear.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex QFFT C 0 0
}
// D the glowing lens alone, the overlay layer drawn full bright while it is on
Model RSQFF_Torch
{
	Path "models/rsqff"
	Model 0 "torch_h.md3"
	SurfaceSkin 0 0 "clear.png"
	SurfaceSkin 0 1 "clear.png"
	SurfaceSkin 0 2 "torchglow.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex QFFT D 0 0
}

// THE BATTERY METER (owner 2026-11-06; battery.zs; tools/gen_torch.py --meter): a thin panel on top of the body in the same
// placement as the flashlight in the hand, the overlay layer RSQFF_Torch.METER, drawn full bright. QFFM A..K = 0..10 segments
// lit (meter0..10.png, our own art after Ermac's 10-step meter; A is also the dark half of the blink at step 1).
Model RSQFF_Torch
{
	Path "models/rsqff"
	Model 0 "torch_meter.md3"
	Skin 0 "meter0.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex QFFM A 0 0
}
