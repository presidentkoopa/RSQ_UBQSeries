// THE VISIBLE BEAM (RSQFF_TorchCone): along model +Z, turned by the actor's pitch (pitch + 90), drawn in real proportions
// (CORRECTPIXELSTRETCH: the beam's real direction), both faces (seen from inside too). Frame = length (A-Z). QFFC: the Quest
// cone (one layer); QFFK: two layers (PCVR, High). Skin: white with the fade in its alpha; the actor's AddStencil shade is
// the colour.
Model RSQFF_TorchCone
{
	Path "models/rsqff"
	Model 0 "cone_lo.md3"
	Skin 0 "cone.png"
	Scale 1.0 1.0 1.0
	USEACTORPITCH
	DONTCULLBACKFACES
	CORRECTPIXELSTRETCH
	FrameIndex QFFC A 0 0
	FrameIndex QFFC B 0 1
	FrameIndex QFFC C 0 2
	FrameIndex QFFC D 0 3
	FrameIndex QFFC E 0 4
	FrameIndex QFFC F 0 5
	FrameIndex QFFC G 0 6
	FrameIndex QFFC H 0 7
	FrameIndex QFFC I 0 8
	FrameIndex QFFC J 0 9
	FrameIndex QFFC K 0 10
	FrameIndex QFFC L 0 11
	FrameIndex QFFC M 0 12
	FrameIndex QFFC N 0 13
	FrameIndex QFFC O 0 14
	FrameIndex QFFC P 0 15
	FrameIndex QFFC Q 0 16
	FrameIndex QFFC R 0 17
	FrameIndex QFFC S 0 18
	FrameIndex QFFC T 0 19
	FrameIndex QFFC U 0 20
	FrameIndex QFFC V 0 21
	FrameIndex QFFC W 0 22
	FrameIndex QFFC X 0 23
	FrameIndex QFFC Y 0 24
	FrameIndex QFFC Z 0 25
}
Model RSQFF_TorchCone
{
	Path "models/rsqff"
	Model 0 "cone_hi.md3"
	Skin 0 "cone.png"
	Scale 1.0 1.0 1.0
	USEACTORPITCH
	DONTCULLBACKFACES
	CORRECTPIXELSTRETCH
	FrameIndex QFFK A 0 0
	FrameIndex QFFK B 0 1
	FrameIndex QFFK C 0 2
	FrameIndex QFFK D 0 3
	FrameIndex QFFK E 0 4
	FrameIndex QFFK F 0 5
	FrameIndex QFFK G 0 6
	FrameIndex QFFK H 0 7
	FrameIndex QFFK I 0 8
	FrameIndex QFFK J 0 9
	FrameIndex QFFK K 0 10
	FrameIndex QFFK L 0 11
	FrameIndex QFFK M 0 12
	FrameIndex QFFK N 0 13
	FrameIndex QFFK O 0 14
	FrameIndex QFFK P 0 15
	FrameIndex QFFK Q 0 16
	FrameIndex QFFK R 0 17
	FrameIndex QFFK S 0 18
	FrameIndex QFFK T 0 19
	FrameIndex QFFK U 0 20
	FrameIndex QFFK V 0 21
	FrameIndex QFFK W 0 22
	FrameIndex QFFK X 0 23
	FrameIndex QFFK Y 0 24
	FrameIndex QFFK Z 0 25
}
// (11-05 06:02, owner: "the flashlight hides enemy sprites when over them?") The beam is a world actor again, not an overlay
// layer of the hand: in VR QuestZDoom 17.3 draws every HUD model after the opaque scene and before the translucent pass,
// with depth writes on and its depth squeezed to the near 0.3 (hw_drawinfo.cpp DrawScene, hw_models.cpp
// BeginDrawHUDModel), so a beam drawn with the hand hid every sprite behind it. As an actor it is drawn in the translucent
// pass, sorted, with no depth writes. torch.zs moves it a tic ahead (its interpolation lands on the hand).

// ON ITS CLIP (RSQFF_TorchStowed, Show Flashlight; zscript/rsqff/stowed.zs turns it lens up): torch.md3, the flashlight
// alone (tools/gen_torch.py --stowed: x -9.75 .. 9.75, the lens +x, centred, measured), the held light's skins (glow off),
// at the flare's 0.34 (cm to map units: 19.5 cm long), turned by the actor's pitch.
Model RSQFF_TorchStowed
{
	Path "models/rsqff"
	Model 0 "torch.md3"
	SurfaceSkin 0 0 "torch.png"
	SurfaceSkin 0 1 "torchlens.png"
	Scale 0.34 0.34 0.34
	USEACTORPITCH
	USEACTORROLL
	FrameIndex QFFT E 0 0
}
