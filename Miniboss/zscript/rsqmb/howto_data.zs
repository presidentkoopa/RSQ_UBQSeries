		r.Push("||DEAL ANY DAMAGE|||||DO:~DEAL ANY DAMAGE~GET:~YOUR DAMAGE IS +10% FOR EACH WORLD TIER COLOUR ABOVE COMMON (X1.9 AT RED)~NEEDS:~YOUR DAMAGE A COLOUR (DEFAULT 0.1); RSQ MONSTERS");
		r.Push("||KILL, FIGHT ON UNHURT; OR TAKE HEAVY DAMAGE, GO DOWN, LOSE A SCORE LIFE, DIE|||||DO:~KILL, FIGHT ON UNHURT; OR TAKE HEAVY DAMAGE, GO DOWN, LOSE A SCORE LIFE, DIE~GET:~RANK (0 TO 100) MOVES (A LOST SCORE LIFE: RANK DOWN PER LIFE, 8, ONCE); EVERY 8 POINTS IS THE NEXT WORLD TIER COLOUR, INSIDE A WINDOW THE MAP SETS (COMMON ON THE FIRST MAP UP TO RED ON THE SECOND-TO-LAST). RANK NN UNDER THE METER~NEEDS:~RANK DIFFICULTY AND RANK CEILING: ON (DEFAULT); RSQ MONSTERS");
		r.Push("||HIT A MELEE STRIKE ON A KNOCKED-DOWN OR DAZED MONSTER OUTSIDE A BOSS FIGHT|||||DO:~HIT A MELEE STRIKE ON A KNOCKED-DOWN OR DAZED MONSTER OUTSIDE A BOSS FIGHT~GET:~VR FINISHER: IT IS GIBBED, BD22'S TWO FATALITY BONUS ITEMS DROP, 100 SCORE POINTS, A 1 S SLOW. NOT OVER 1000 SPAWN HEALTH, NOT A BOSS~NEEDS:~VR FINISHER: ON (DEFAULT); BD22 (KNOCKED DOWN) OR GUN BONSAI VR (DAZED)");
		r.Push("||DO A BD22 FATALITY, STEALTH KILL OR EXECUTION|||||DO:~DO A BD22 FATALITY, STEALTH KILL OR EXECUTION~GET:~NO SCENE: THE MONSTER'S BODY IS GIBBED WHERE IT STOOD AND THE FINISHER IS PAID~NEEDS:~NO BD22 FATALITIES: ON (DEFAULT); BRUTAL DOOM 22");
		r.Push("||BRING A LEGENDARY MONSTER UNDER HALF ITS HEALTH|||||DO:~BRING A LEGENDARY MONSTER (3X HEALTH) UNDER HALF ITS HEALTH~GET:~IT TRANSFORMS: FULL HEALTH AGAIN, A STAT BOOST AND X2 DAMAGE; KILLED, IT DROPS LOOT BY ITS HEALTH~NEEDS:~LEGENDOOM LITE (STANDS DOWN WHILE LEGENDOOM IS LOADED)");
		r.Push("||KILL A CHAMPION|||||DO:~KILL A CHAMPION~GET:~CHAMPIONS' COLOUR POWERS AND ITS ITEM BUNDLE (ABOUT HALF THE MONSTERS AT ULTRA-VIOLENCE: CHAMPION CHANCE, DIFFICULTY BASED)~NEEDS:~CHAMPIONS (BUILT IN)");
		r.Push("||CALL A FIGHT WITH ARRIVAL: CLASSIC|||||DO:~CALL A FIGHT WITH ARRIVAL: CLASSIC~GET:~EVERY THRALL LANDS IN FRONT, THEN THE BOSS; ALL ARE HELD AND CANNOT BE HURT UNTIL A 5 S COUNT ENDS~NEEDS:~ARRIVAL: CLASSIC (DEFAULT AROUND YOU)");
		r.Push("||PRESS USE ON THE START FIGHT CARD|||||DO:~PRESS USE ON THE START FIGHT CARD~GET:~NOTHING: THE CARD STAYS GREY AND THE FIGHT ONLY COMES BY ITSELF~NEEDS:~CALL IT IN: OFF (DEFAULT ON)");
		r.Push("||CALL A FIGHT THAT WOULD WAIT|||||DO:~CALL A FIGHT THAT WOULD WAIT~GET:~IT COMES ANYWAY (ONLY THE MAP LIMIT AND COOLDOWN STILL HOLD IT); WITH NO ROOM, THE SPOT IS TAKEN ANYWHERE IT FITS~NEEDS:~IGNORE SPAWN RESTRICTIONS: ON (DEFAULT OFF)");
		r.Push("||CALL A FIGHT WITH GRAVES RISE ON|||||DO:~CALL A FIGHT WITH GRAVES RISE ON~GET:~NOW AND THEN (30 FIGHTS IN 100, ROLLED AS IT LANDS, WITH NO SIGN WHICH), RSQ GRAVEYARDS' TOMBSTONES RAISE LEGION OF BONES UNDEAD AS IT LANDS (ONE A STONE, OR ONE PER THRALL A STONE; THE MAP OR A RADIUS). THE OTHER FIGHTS WAKE NO GRAVE~NEEDS:~GRAVES RISE: ON (DEFAULT OFF); GRAVES RISE CHANCE (DEFAULT 30); LEGION OF BONES AND RSQ GRAVEYARDS");
