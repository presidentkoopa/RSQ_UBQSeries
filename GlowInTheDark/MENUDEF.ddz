// Altered for RSQ Glow In The Dark (2026-11-09): DarkDoomZ's own Options entry removed (its settings are reached from
//   Options > Radiant Silvergun Options > RSQ Glow In The Dark); menus, option lists and the
//   menu class renamed DarkDoomZ_* / Nice_* -> RSQGD_DDZ_* so nothing can clash; titles and a few labels in plainer
//   words ("Darkness Mode", "Darkness Level"); the "-- OpenGL only --" line dropped (QuestZDoom 17.3 is GL); its
//   flashlight settings page removed with the flashlight. Every other setting, value and range is DarkDoomZ's own.
// Altered 2026-11-24 (the series' menu standard, design/MENU_STANDARD.md): DarkDoomZ's three pages (Settings, Advanced,
//   Fog) folded into GlowInTheDark/MENUDEF.txt: Darkness Mode and Darkness Level on RSQ Glow In The Dark's front page,
//   the rest under "Darkness (DarkDoomZ)" on its Test and Debug page; their help lines became the rows' tips. Only the
//   option lists stay here. (The pages' RSQGD_DDZ_OptionMenu class, which kept the menu undimmed, is no longer used.)
// Original: DarkDoomZ (C) 2018 Sterling Parker (Caligari87), zlib licence (DarkDoomZ/license.md in this pk3).

OptionValue "RSQGD_DDZ_Modes" {
	0, "Disable"
	1, "Subtract"
	2, "Compress"
	3, "Clamp"
	4, "Crush"
	10, "DarkDoom Lite"
	11, "DarkDoom Classic"
	12, "DarkDoom Black"
}

OptionValue "RSQGD_DDZ_Levels" {
	0, "Disable"
	1, "Dim"
	2, "Murky"
	3, "Dismal"
	4, "Oppressive"
	5, "Inky"
	6, "Stygian"
	7, "Pitch"
	8, "Pure"
}

OptionValue "RSQGD_DDZ_Sector_Effects" {
	0, "Remove"
	1, "Keep"
}
